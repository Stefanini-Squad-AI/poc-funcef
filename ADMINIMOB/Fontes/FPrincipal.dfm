  object qryIntegraContab: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  P.MASCARA, C.PLANO, C.PACESTORNA'
      'FROM '
      '  PLANO P, PARAMCONTAB C'
      'WHERE '
      '  ( C.IDPESSOA =:EMPRESAPROP ) AND'
      '  ( P.PLANO=C.PLANO )'
      ' ')
    ValidateWithMask = True
    Left = 192
    Top = 296
    ParamData = <
      item
        DataType = ftInteger
        Name = 'EMPRESAPROP'
        ParamType = ptUnknown
      end>
