#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = AdminImob.exe CMImobiliarioObj50.bpl CMIndicadoresObj50.bpl \
  Alienacao.exe Indicadores.exe InvestImob.exe CMCAFObj50.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------


AdminImob.exe: Fontes\AdminImob.dpr
  $(DCC)

CMImobiliarioObj50.bpl: ..\CMImobiliarioObj50\Packages\CMImobiliarioObj50.dpk
  $(DCC)

CMIndicadoresObj50.bpl: ..\CMIndicadoresObj50\Packages\CMIndicadoresObj50.dpk
  $(DCC)

Alienacao.exe: ..\ALIENACAO\Fontes\Alienacao.dpr
  $(DCC)

Indicadores.exe: ..\Indicadores\Fontes\Indicadores.dpr
  $(DCC)

InvestImob.exe: ..\InvestImob\Fontes\InvestImob.dpr
  $(DCC)

CMCAFObj50.bpl: ..\CMCAFOBJ50\Package\CMCAFObj50.dpk
  $(DCC)


