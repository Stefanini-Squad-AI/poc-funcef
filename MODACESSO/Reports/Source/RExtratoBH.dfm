  object sqlExtratoBH: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  RPAD('#39'1'#39',13,'#39'1'#39') AS MATRICULA,'
      '  RPAD('#39'1'#39',60,'#39'1'#39') AS NOME,'
      '  RPAD('#39'1'#39',40,'#39'1'#39') AS CARGO,'
      '  RPAD('#39'1'#39',30,'#39'1'#39') AS DATABH,'
      '  0 AS CREDITO,'
      '  0 AS DEBITO,'
      '  RPAD('#39'1'#39',60,'#39'1'#39') AS EMPRESA,'
      '  0 AS NUMEMPREGADO,'
      '  0 AS SALDO,'
      '  0 AS SALDOANTERIOR,'
      '  0 AS VALOR'
      'FROM'
      '  DUAL'
      'WHERE'
      '  (1 = 2)')
    ClientDataSet = CdsExtratoBH
    Left = 210
    Top = 199
  end
