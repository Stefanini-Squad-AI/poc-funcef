  object dtsHistMov: TwwDataSource
    DataSet = qryHistMov
    Left = 544
    Top = 12
  end
  object qryHistMov: TwwQuery
    CachedUpdates = True
    AfterScroll = qryHistMovAfterScroll
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  '#39'0'#39' AS FLGESCOLHA,'
      ''
      '   HME.IDHISTMOVEMPTMO,'
      ''
      '   IRC.ITEDESCRICAO,'
      ''
      
        '   cast(TO_CHAR(HME.HMEMESCOMPETENCIA, '#39'00'#39') || '#39'/'#39' || HME.HMEAN' +
        'OCOMPETENCIA as varchar2(7)) AS ANOMES,'
      ''
      
        '   HME.HMEANOCOMPETENCIA, HME.HMEMESCOMPETENCIA, HME.HMESEQCOBRA' +
        'NCA,'
      
        '   HME.HMETIPOMOV       , HME.IDCONTRATOEMPTMO , HME.IDITEMEMPTM' +
        'O  ,  HME.FLGBAIXADO,'
      
        '   HME.HMEDATAPREVISTA  , HME.HMEVLRPREVISTO   , HME.HMESALDODEV' +
        '   ,  HME.PLNCODIGO,'
      '   HME.HMETXJUROS,'
      ''
      '   HME.HMEPARCELA,'
      '   HME.HMEPARCELAALT,'
      '   HME.HMENUMPARCELAS,'
      ''
      '   HME.HMEDATAATUALIZA,'
      
        '   HME.HMEDATAEFETIVA   , HME.HMEVLREFETIVO    , HME.HMERECPAG, ' +
        '      HME.IDITEMCENTRALIZA,'
      
        '   HME.IDREGRA          , HME.HMEORIGEM        , HME.HMEPRIORIDA' +
        'DE,'
      ''
      '   DECODE(HME.HMETIPOMOV,'
      '          0, '#39'Concessão/Renovação'#39','
      '          1, '#39'Prestação '#39','
      '          2, '#39'Amortização/Refinanciamento'#39','
      '          3, '#39'Quitação'#39','
      '          4, '#39'Atualização de Débito'#39','
      '          5, '#39'Atualização de Saldo (Diária)'#39' ,'
      '          6, '#39'Importação/Migração'#39','
      '          7, '#39'Ajustes (Cobrança/Devolução)'#39','
      '          8, '#39'Ajustes (Saldo Devedor)'#39
      '         ) AS EVENTO,'
      ''
      '   HME.HMEFORMACOBRANCA,'
      '   HME.IDRUBRICA,'
      '   CON.IDPATRO,'
      ''
      '   HME.CODDOCUMENTO,'
      ''
      '   HME.HMECENTRALIZA,'
      '   HME.HMEDESTACADO,'
      '   HME.HMEANOCOBRANCA,'
      '   HME.HMEMESCOBRANCA,'
      '   HME.HMEDATAVENCTO, HME.FLGENVIO,'
      ''
      '   HME.FLGBAIXAMANUAL,'
      '   HME.FLGSUSPENSAO,'
      ''
      
        '   DECODE(HME.HMEFORMACOBRANCA,'#39'F'#39','#39'Folha'#39', '#39'C'#39','#39'Financeiro'#39') AS' +
        ' FORMACOBRANCA,'
      
        '   DECODE(HME.FLGBAIXAMANUAL, 1, '#39'Baixa Manual'#39', DECODE(HME.FLGS' +
        'USPENSAO, 1, '#39'Suspenso'#39', NULL)) AS STATUS,'
      ''
      '   TSE.TSEDESCRICAO, TSE.FLGATUALSALDOPARC'
      ''
      'FROM'
      '   HISTMOVEMPTMO  HME,'
      '   CONTRATOEMPTMO CON,'
      '   TIPOSUSPEMPTMO TSE,'
      '   ITEMXTIPOCONTR IRT,'
      '   ITEMEMPTMO     IRC'
      ''
      'WHERE'
      '       HME.IDCONTRATOEMPTMO     =:PIDCONTRATOEMPTMO'
      '   AND IRT.IDTIPOCONTREMPTMO    =:PIDTIPOCONTREMPTMO'
      ''
      '   AND ( HME.HMECENTRALIZA      = 1  )'
      ''
      '--   AND HME.HMETIPOMOV           IN (1, 2, 3, 4, 7)'
      '   AND HME.HMETIPOMOV           = 1'
      ''
      '   AND NVL(HME.FLGESTORNADO, 0) = 0'
      '   AND NVL(HME.FLGABONADO, 0)   = 0'
      '   AND NVL(HME.FLGQUITADO, 0)   = 0'
      ''
      
        '   AND ( NVL(:PBAIXADO, 0)      = 0 OR (:PBAIXADO        = 1 AND' +
        ' HME.FLGBAIXADO     IS NULL) )'
      
        '   AND ( NVL(:PABERTO, 0)       = 0 OR (:PABERTO         = 1 AND' +
        ' HME.FLGBAIXADO     = 0) )'
      ''
      '   AND HME.IDITEMEMPTMO         = IRT.IDITEMEMPTMO'
      '   AND IRT.IDITEMEMPTMO         = IRC.IDITEMEMPTMO'
      '   AND CON.IDCONTRATOEMPTMO     = HME.IDCONTRATOEMPTMO'
      ''
      '   AND ('
      '       NVL(HME.FLGSUSPENSAO, 0)  = 0  OR'
      
        '       (NVL(HME.FLGSUSPENSAO, 0) <> 0 AND NVL(TSE.FLGEMABERTO, 0' +
        ') = 1 AND TSE.FLGATUALSALDOPARC = 0) '
      '       )'
      ''
      '   AND HME.IDTIPOSUSPEMPTMO     = TSE.IDTIPOSUSPEMPTMO(+)'
      ''
      'ORDER BY'
      '   HME.HMEPARCELA,'
      '   HME.HMEANOCOMPETENCIA, HME.HMEMESCOMPETENCIA,'
      '   HME.HMETIPOMOV, HME.HMESEQCOBRANCA'
      ' '
      ' ')
    UpdateObject = updHistMov
    ControlType.Strings = (
      'FLGESCOLHA;CheckBox;1;0')
    ValidateWithMask = True
    Left = 544
    ParamData = <
      item
        DataType = ftFloat
        Name = 'PIDCONTRATOEMPTMO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PIDTIPOCONTREMPTMO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PBAIXADO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PBAIXADO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PABERTO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PABERTO'
