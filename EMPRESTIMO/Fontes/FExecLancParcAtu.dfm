  object qryAbonaItem: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'UPDATE'
      '   HISTMOVEMPTMO HME'
      'SET'
      '   HME.FLGABONADO                = 1,'
      '   HME.HMEDATAQUITABONO          =:PHMEDATAQUITABONO,'
      '   HME.FLGTIPODIVERG             = NULL,'
      '   HME.FLGENVIO                  = NULL,'
      
        '   HME.HMEOBSERVACAO             = HMEOBSERVACAO || '#39' Abono (lan' +
        'camento de prestacoes atualizadas) '#39
      'WHERE'
      '       Idcontratoemptmo          = :pIdcontratoemptmo'
      '   and hme.hmedestacado          = 0'
      '   and hme.hmeparcela            = :phmeparcela'
      ''
      '   AND HME.FLGBAIXADO            = 0'
      '   AND HME.HMEDATAEFETIVA        IS NULL'
      '   AND HME.HMEVLREFETIVO         IS NULL'
      ''
      '   AND NVL(HME.FLGESTORNADO, 0)  = 0'
      '   AND NVL(HME.FLGABONADO, 0)    = 0'
      '   AND NVL(HME.FLGQUITADO, 0)    = 0'
      '   AND NVL(HME.FLGSUSPENSAO, 0)  = 0'
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 320
    Top = 22
    ParamData = <
      item
        DataType = ftDate
        Name = 'PHMEDATAQUITABONO'
        ParamType = ptInput
      end
      item
        DataType = ftUnknown
        Name = 'pIdcontratoemptmo'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'phmeparcela'
        ParamType = ptUnknown
      end>
  end
