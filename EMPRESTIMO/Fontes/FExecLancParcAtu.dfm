  object qryBuscaItens: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   ITC.IDITEMEMPTMO,'
      '   ITC.ITCRECPAG,'
      '   ITC.IDREGRACALC,'
      '   ITC.ITCPRIORIDADE,'
      '   ITC.IDPROVENTON,'
      
        '   DECODE(ITC.ITCEVENTO, -2, -2, -1, -1, 0, 0, 1, 2, 2, 6, 3, 9,' +
        ' 4, 7, 5, 1, 6, 3, 7, 4, 8, 5, 8) AS ORDENACAO,'
      '   ITC.ITCEVENTO,'
      '   ITC.ITCSEQCALCULO,'
      '   ITC.ITCTRATASALDODEV,'
      ''
      '   ITC.FLGCENTRALIZA,'
      '   ITC.FLGDESTACADO,'
      '   ITC.FLGGRAVAZERO,'
      ''
      '   TOTALGRUPO.IDITEMEMPTMO AS IDITEMCENTRALIZA,'
      ''
      '   ITE.ITEDESCRICAO'
      ''
      'FROM'
      '   ITEMXTIPOCONTR ITC,'
      '   ITEMEMPTMO     ITE,'
      ''
      '   ('
      '   SELECT'
      '      IDITEMEMPTMO, ITCEVENTO'
      '   FROM'
      '      ITEMXTIPOCONTR'
      '   WHERE'
      '          ( IDTIPOCONTREMPTMO =:PIDTIPOCONTREMPTMO )'
      '      AND ( FLGCENTRALIZA     = 1 )'
      '   ) TOTALGRUPO'
      ''
      'WHERE'
      '       ( ITC.IDTIPOCONTREMPTMO =:PIDTIPOCONTREMPTMO )'
      '   AND ( ITC.ITCEVENTO         = TOTALGRUPO.ITCEVENTO(+) )'
      '   AND ITE.IDITEMEMPTMO        =:PIDITEMEMPTMO'
      '   AND'
      '   ('
      
        '   ((:PEVENTO = 0) AND ((ITC.ITCEVENTO =:PEVENTO) OR (ITC.ITCEVE' +
        'NTO = 1 AND ITC.FLGCENTRALIZA = 1)))'
      '   OR'
      '   ((:PEVENTO <> 0) AND (ITC.ITCEVENTO =:PEVENTO))'
      '   )'
      '   AND ITE.IDITEMEMPTMO > 0'
      ''
      '   AND ( ITC.IDITEMEMPTMO      = ITE.IDITEMEMPTMO )'
      ''
      'ORDER BY'
      '   ITC.ITCSEQCALCULO, ITC.ITCSEQCALCULO')
    ValidateWithMask = True
    Left = 280
    Top = 56
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDTIPOCONTREMPTMO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PIDTIPOCONTREMPTMO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PIDITEMEMPTMO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PEVENTO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PEVENTO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PEVENTO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PEVENTO'
        ParamType = ptInput
      end>
