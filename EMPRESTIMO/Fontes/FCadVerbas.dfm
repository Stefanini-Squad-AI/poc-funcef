  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update VERBAEMPTMO'
      'set'
      '  IDFILIAL = :IDFILIAL,'
      '  IDPATRO = :IDPATRO,'
      '  IDTIPOEMPTMO = :IDTIPOEMPTMO,'
      '  IDEMPRESAPROP = :IDEMPRESAPROP,'
      '  VLRSALDO = :VLRSALDO,'
      '  PERCDISTRIBUICAO = :PERCDISTRIBUICAO,'
      '  TRGDTINCLUSAO = :TRGDTINCLUSAO,'
      '  TRGUSERINCLUSAO = :TRGUSERINCLUSAO'
      'where'
      '  IDVERBA = :OLD_IDVERBA')
    InsertSQL.Strings = (
      'insert into VERBAEMPTMO'
      '  (IDVERBA, IDFILIAL, IDPATRO, IDTIPOEMPTMO, IDEMPRESAPROP, '
      'VLRSALDO, PERCDISTRIBUICAO, '
      '   TRGDTINCLUSAO, TRGUSERINCLUSAO)'
      'values'
      
        '  (:IDVERBA, :IDFILIAL, :IDPATRO, :IDTIPOEMPTMO, :IDEMPRESAPROP,' +
        ' '
      ':VLRSALDO, '
      '   :PERCDISTRIBUICAO, :TRGDTINCLUSAO, :TRGUSERINCLUSAO)')
    DeleteSQL.Strings = (
      'delete from VERBAEMPTMO'
      'where'
      '  IDVERBA = :OLD_IDVERBA')
    Left = 600
    Top = 64
  end
