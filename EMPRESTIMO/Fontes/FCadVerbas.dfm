  object qryFilial: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'select p.idpessoa, p.nome, f.idfilialpessoa'
      'from filialpessoa f, pessoa p'
      'where f.idfilialpessoa = p.idpessoa'
      'and p.idgrupo = :idpessoa')
    ValidateWithMask = True
    Left = 25
    Top = 107
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDPESSOA'
        ParamType = ptUnknown
