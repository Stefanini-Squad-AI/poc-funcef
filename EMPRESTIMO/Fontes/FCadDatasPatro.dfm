  object qryDatas: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '
      #9'IDPESSJUR, IDPLANOPREV, SITFUNDACAO,'
      #9'DIACOBN,FLGUTILN,FLGMESCOBN,FLGDIAPOSANTN,'
      #9'DIACOBA,FLGUTILA,FLGMESCOBA,FLGDIAPOSANTA,'
      #9'DIACOBD,FLGUTILD,FLGMESCOBD,FLGDIAPOSANTD,'
      #9'DIACOBC,FLGUTILC,FLGMESCOBC,FLGDIAPOSANTC,'
      #9'DIASAPOSD,DIASAPOSC'
      'FROM DATASPATROEMPTMO'
      'WHERE IDPESSJUR      = :IDPESSJUR AND '
      '              IDPLANOPREV = :IDPLANOPREV AND'
      '              SITFUNDACAO = :IDSITPART'
      '')
    ValidateWithMask = True
    Left = 64
    Top = 152
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'IDSITPART'
        ParamType = ptUnknown
      end>
  end
  object qryAux: TwwQuery
    DatabaseName = 'BaseDados'
    ValidateWithMask = True
    Left = 128
    Top = 104
  end
  object qryPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT P.IDPESSOA, P.NOME, P.FLGPATROCINADORA'
      'FROM PESSOA  P, PATRO PT'
      'WHERE P.IDPESSOA = PT.IDPESSOA'
      'ORDER BY NOME'
      ' ')
    ValidateWithMask = True
    Left = 192
    Top = 104
    object qryPatroNOME: TStringField
      DisplayWidth = 60
      FieldName = 'NOME'
      Origin = 'BASEDADOS.PESSOA.NOME'
      Size = 60
    end
    object qryPatroIDPESSOA: TFloatField
      FieldName = 'IDPESSOA'
      Origin = 'BASEDADOS.PESSOA.IDPESSOA'
      Visible = False
    end
    object qryPatroFLGPATROCINADORA: TFloatField
      FieldName = 'FLGPATROCINADORA'
      Origin = 'BASEDADOS.PESSOA.FLGPATROCINADORA'
      Visible = False
    end
  end
