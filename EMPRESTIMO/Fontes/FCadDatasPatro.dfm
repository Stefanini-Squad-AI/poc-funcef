  object qryPlanPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  PL.IDPLANOPREV,'
      '  PL.NOME'
      'FROM'
      '  PLANPREV      PL,'
      '  PLANPREVPATRO PP'
      'WHERE'
      '      PP.IDPESSJUR   =:PIDPESSJUR'
      '  AND PP.IDPLANOPREV = PL.IDPLANOPREV')
    ValidateWithMask = True
    Left = 64
    Top = 104
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDPESSJUR'
        ParamType = ptInput
      end>
    object qryPlanPatroIDPLANOPREV: TFloatField
      FieldName = 'IDPLANOPREV'
      Origin = 'BASEDADOS.PLANPREV.IDPLANOPREV'
    end
    object qryPlanPatroNOME: TStringField
      FieldName = 'NOME'
      Origin = 'BASEDADOS.PLANPREV.NOME'
      Size = 50
    end
  end
