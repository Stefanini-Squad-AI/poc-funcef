  object qryGeraArquivo: TQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '
      
        '       '#39'TRUE'#39' AS FLGENVIA,hst.HMEDATAPREVISTA as DATACONTRATACAO' +
        ', --teste renato'
      '       c.idcontratoemptmo AS NUMCONTRATO,'
      '       d.matricula,'
      '       p.numdocumento AS CPF,'
      '       p.nome,'
      '       '#39'09/09/2009'#39' as DataQuitacao,'
      '       (SELECT h.hmesaldodev'
      
        '          FROM histmovemptmo h, contratoemptmo c1, itemxtipocont' +
        'r itc'
      '         WHERE h.idcontratoemptmo = c.idcontratoemptmo'
      '           AND h.idcontratoemptmo = c1.idcontratoemptmo'
      '           AND c1.idtipocontremptmo = itc.idtipocontremptmo'
      '           AND itc.iditememptmo = h.iditememptmo'
      '           AND nvl(h.flgestornado, 0) = 0'
      
        '           AND h.hmedataprevista >= to_date('#39'09/09/2009'#39', '#39'DD/MM' +
        '/YYYY'#39')'
      '           AND itc.itcordemextrato ='
      '               (SELECT MAX(i.itcordemextrato)'
      '                  FROM itemxtipocontr i'
      '                 WHERE i.iditememptmo IN'
      '                       (SELECT iditememptmo'
      '                          FROM histmovemptmo hme'
      
        '                         WHERE hme.idcontratoemptmo = c.idcontra' +
        'toemptmo'
      '                           AND hme.hmedataprevista ='
      
        '                               to_date('#39'09/09/2009'#39', '#39'DD/MM/YYYY' +
        #39')'
      
        '                           AND nvl(hme.flgestornado, 0) = 0))) A' +
        'S SALDODEVEDOR,'
      '       (SELECT H1.HMEVLRPREVISTO'
      '          FROM HISTMOVEMPTMO H1'
      '         WHERE H1.IDCONTRATOEMPTMO = C.IDCONTRATOEMPTMO'
      '           AND H1.IDITEMEMPTMO = '#39'22'#39
      '           AND NVL(HMECENTRALIZA,0)=0'
      
        '           and h1.hmedataprevista =  hst.hmedataprevista --teste' +
        ' renato'
      '           ) as VALORBRUTO'
      ''
      '  FROM contratoemptmo   c,'
      '       pessoa           p,'
      '       depentit         d,'
      '       Planprevcontabil ppc,'
      '       histmovemptmo    hst'
      '       '
      ' WHERE c.flgsituacao IN ('#39'A'#39', '#39'E'#39')'
      '   AND c.idtipocontremptmo IN (23)'
      '   AND c.idbenef = p.idpessoa'
      '   AND c.idbenef = d.idpessoa'
      '   AND c.idpessoa = d.idtitular'
      '   AND c.idplanoorigem = ppc.idplanoprev'
      '    '
      '   and hst.Idcontratoemptmo = c.IdContratoEmptmo'
      '   and hst.hmeCentraliza = 1'
      
        '   and ((hst.hmedataprevista >= to_date('#39'26/12/2007'#39', '#39'DD/MM/YYY' +
        'Y'#39')) '
      
        '   and (hst.hmedataprevista <= to_date('#39'26/12/2007'#39', '#39'DD/MM/YYYY' +
        #39')))'
      '   '
      ''
      '   '
      '   '
      '   ')
    UpdateObject = upd
    Left = 104
    Top = 284
