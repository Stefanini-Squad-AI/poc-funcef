  object qryBuscaHistorico: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '    DEP.MATRICULA,'
      '    NUMPARCELA,'
      '    COBRANCA,'
      '    REFERENCIA,'
      '    DATAVENCTO,'
      '    NVL(VLRPARCELAPG,0)      AS VLRPARCELAPG,'
      '    NVL(MULTAEPPG,0)         AS MULTAEPPG,'
      '    NVL(JUROSEPPG,0)         AS JUROSEPPG,'
      '    NVL(CORRECAOEPPG,0)      AS CORRECAOEPPG,'
      '    NVL(SALDODEVEPPG,0)      AS SALDODEVEPPG,'
      '    NVL(SEGUROEPPG,0)        AS SEGUROEPPG,'
      '    NVL(MULTASEGEPPG,0)      AS MULTASEGEPPG,'
      '    NVL(JUROSSEGEPPG,0)      AS JUROSSEGEPPG,'
      '    NVL(CORRECAOSEGEPPG,0)   AS CORRECAOSEGEPPG,'
      '    NVL(DESCONTOEPPG,0)      AS DESCONTOEPPG,'
      '    NVL(MULTAQUITPG,0)       AS MULTAQUITPG,'
      '    NVL(JUROSQUITPG,0)       AS JUROSQUITPG,'
      '    NVL(CORRECAOQUITPG,0)    AS CORRECAOQUITPG,'
      '    NVL(SALDODEVQUITPG,0)    AS SALDODEVQUITPG,'
      '    NVL(SEGUROQUITPG,0)      AS SEGUROQUITPG,'
      '    NVL(MULTASEGQUITPG,0)    AS MULTASEGQUITPG,'
      '    NVL(JUROSSEGQUITPG,0)    AS JUROSSEGQUITPG,'
      '    NVL(CORRECAOSEGQUITPG,0) AS CORRECAOSEGQUITPG,'
      '    NVL(DESCONTOQUITPG,0)    AS DESCONTOQUITPG,'
      '    NVL(PLNCODIGO,0)         AS PLNCODIGO,'
      '    DATAATUALIZA             AS DATAPAGAMENTO,'
      '    IDMODULO,'
      '    NOMEMODULO,'
      '    CODDOCUMENTO,'
      '    DATAATUALIZA,'
      
        '    DECODE(DATACANC,NULL,'#39'          '#39',TO_CHAR('#39'DD/MM/YYYY'#39',DATAC' +
        'ANC)) AS DATACANC'
      'FROM'
      '    EPHISTSIAFI EHS, VWPARTICIPDEPEN DEP'
      'WHERE'
      '    DATAATUALIZA >= :PDATAINI'
      'AND DATAATUALIZA <= :PDATAFIM'
      'AND EHS.IDPESSOA = DEP.IDPESSOA'
      ''
      ''
      ''
      ''
      ' ')
    ValidateWithMask = True
    Left = 288
    Top = 16
    ParamData = <
      item
        DataType = ftDate
        Name = 'PDATAINI'
        ParamType = ptInput
      end
      item
        DataType = ftDate
        Name = 'PDATAFIM'
        ParamType = ptInput
      end>
