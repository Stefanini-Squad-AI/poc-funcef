  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update EPUNDPLANTIPCONT'
      'set'
      '  IDPLANOPREV = :IDPLANOPREV,'
      '  IDTIPOCONTREMPTMO = :IDTIPOCONTREMPTMO,'
      '  IDUNIDCENTR = :IDUNIDCENTR,'
      '  PERCENTUAL = :PERCENTUAL,'
      '  VALORRATEADO = :VALORRATEADO'
      'where'
      '  IDPLANOPREV = :OLD_IDPLANOPREV and'
      '  IDTIPOCONTREMPTMO = :OLD_IDTIPOCONTREMPTMO and'
      '  IDUNIDCENTR = :OLD_IDUNIDCENTR')
    Left = 432
    Top = 288
  end
  inherited qry: TwwQuery
    OnCalcFields = qryCalcFields
    SQL.Strings = (
      'SELECT'
      '   IDPLANOPREV,'
      '   IDTIPOCONTREMPTMO,'
      '   IDUNIDCENTR,'
      '   PERCENTUAL,'
      '   VALORRATEADO,'
      '   VALORUTILIZADO'
      'FROM'
      '   EPUNDPLANTIPCONT'
      'WHERE'
      '    IDPLANOPREV       = :PIDPLANOPREV'
      'AND IDTIPOCONTREMPTMO = :PIDTIPOCONTREMPTMO'
      'AND IDUNIDCENTR       = :PIDUNIDCENTR'
      ' ')
    UpdateObject = upd
    Left = 592
    Top = 264
