  object qryPlano: TwwQuery
    DatabaseName = 'BaseDados'
    Constrained = True
    SQL.Strings = (
      'SELECT DISTINCT'
      '    PLP.NOME,'
      '    VPL.IDPLANOPREV,'
      '    100 AS PERCENTUAL,'
      '    SUBSTR(ANOMES,5,2)||'#39'/'#39'||SUBSTR(ANOMES,1,4) AS ANOMES,'
      '    SUM(VPL.VALOR) AS VALORRATEADO'
      'FROM'
      '    EPVERBAPLANO VPL,'
      '    PLANPREV     PLP'
      'WHERE'
      
        '    ((:PIDPLANOPREV IS NULL) OR (VPL.IDPLANOPREV = :PIDPLANOPREV' +
        '))'
      'AND PLP.IDPLANOPREV = VPL.IDPLANOPREV'
      'GROUP BY'
      '    PLP.NOME,'
      '    VPL.IDPLANOPREV,'
      '   ANOMES'
      'ORDER BY'
      '    PLP.NOME')
    ValidateWithMask = True
    Left = 49
    Top = 24
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDPLANOPREV'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PIDPLANOPREV'
        ParamType = ptInput
      end>
    object qryPlanoNOME: TStringField
      FieldName = 'NOME'
      Origin = 'BASEDADOS.PLANPREV.NOME'
      Size = 50
    end
    object qryPlanoIDPLANOPREV: TFloatField
      FieldName = 'IDPLANOPREV'
      Origin = 'BASEDADOS.EPVERBAPLANO.IDPLANOPREV'
    end
    object qryPlanoVALORRATEADO: TFloatField
      FieldName = 'VALORRATEADO'
      Origin = 'BASEDADOS.EPVERBAPLANO.VALOR'
      DisplayFormat = ',0.00'
      EditFormat = ',0.00'
    end
    object qryPlanoPERCENTUAL: TFloatField
      FieldName = 'PERCENTUAL'
      DisplayFormat = ',0.00'
      EditFormat = ',0.00'
    end
    object qryPlanoANOMES: TStringField
      FieldName = 'ANOMES'
      Size = 7
    end
  end
  object qryTipoContr: TwwQuery
    OnCalcFields = qryCalcFields
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   PTC.IDPLANOPREV,'
      '   PTC.IDTIPOCONTREMPTMO,'
      '   PTC.PERCENTUAL,'
      '   PTC.VALORRATEADO,'
      '   PTC.VALORUTILIZADO,'
      '   TCE.TCEDESCRICAO'
      ''
      'FROM'
      '   EPPLANTIPCONT PTC,'
      '   TIPOCONTREMPTMO TCE'
      ''
      'WHERE'
      
        '    ((:PIDPLANOPREV IS NULL) OR (PTC.IDPLANOPREV = :PIDPLANOPREV' +
        '))'
      
        'AND ((:PIDTIPOCONTREMPTMO IS NULL) OR (PTC.IDTIPOCONTREMPTMO = :' +
        'PIDTIPOCONTREMPTMO))'
      'AND TCE.IDTIPOCONTREMPTMO = PTC.IDTIPOCONTREMPTMO'
      'ORDER BY'
      '    TCE.TCEDESCRICAO'
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 53
    Top = 88
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDPLANOPREV'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
