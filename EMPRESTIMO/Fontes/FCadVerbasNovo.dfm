  object qryUnidade: TwwQuery
    OnCalcFields = qryCalcFields
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT'
      '    UPTC.IDUNIDCENTR,'
      '    UPTC.PERCENTUAL,'
      '    UPTC.VALORRATEADO,'
      '    UPTC.VALORUTILIZADO,'
      '    PES.NOME'
      'FROM'
