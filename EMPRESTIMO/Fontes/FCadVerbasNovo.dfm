      '                              WHERE  DATA <= SYSDATE'
      
        '                              AND    IDPLANOPREV       = :PIDPLA' +
        'NOPREV'
      '                             )'
      'AND EVP.IDPLANOPREV        = UPTC.IDPLANOPREV'
      'AND PES.IDPESSOA           = UPTC.IDUNIDCENTR'
      'ORDER BY'
      '    PES.NOME'
      ''
      ' '
      ' ')
