  inherited qry: TwwQuery
    AutoRefresh = True
    SQL.Strings = (
      'select CE.IDCONTRATOEMPTMO,'
      '       PE.NOME,'
      '       DP.MATRICULA'
      'from CONTRATOEMPTMO CE,'
      '     PESSOA PE,'
      '     DEPENTIT DP'
      'where CE.IDCONTRATOEMPTMO= :PIDCONTRATOEMPTMO'
      'and   CE.idpessoa = PE.idpessoa  '
      'and    CE.idpessoa = DP.idpessoa  ')
    Left = 265
    Top = 138
    ParamData = <
      item
        DataType = ftString
        Name = 'PIDCONTRATOEMPTMO'
        ParamType = ptUnknown
      end>
  end
