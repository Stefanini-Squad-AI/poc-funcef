    BeforeConfirma = CmeDetalheBeforeConfirma
    Left = 380
    Top = 210
  end
  object qryDet: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'select IDCONTRATOEMPTMO,'
      '       IDSEQUENCIA,'
      '       IDMODULO,'
      '       DESCRICAO,'
      '       SUBSTR(descricao,1,100) MENSAGEM,'
      '       DATAEXPIRAMSG,'
      '       FLGEXIBEMSG,'
      '       CASE'
      '        WHEN FLGEXIBEMSG = 1 THEN '#39'SIM'#39
      '        ELSE '#39'NÃO'#39
      '       END EXIBE'
      'from CONTRATOEMPTMOMSG CM'
      'where '
      'CM.IDCONTRATOEMPTMO = :PIDCONTRATOEMPTMO '
      'order by CM.IDSEQUENCIA')
    UpdateObject = updDet
    ValidateWithMask = True
    Left = 240
    Top = 208
    ParamData = <
      item
        DataType = ftString
        Name = 'PIDCONTRATOEMPTMO'
        ParamType = ptUnknown
      end>
    object qryDetIDCONTRATOEMPTMO: TFloatField
      FieldName = 'IDCONTRATOEMPTMO'
      Visible = False
    end
    object qryDetIDSEQUENCIA: TFloatField
      FieldName = 'IDSEQUENCIA'
      Visible = False
    end
    object qryDetIDMODULO: TFloatField
      FieldName = 'IDMODULO'
      Visible = False
    end
    object qryDetMENSAGEM: TStringField
      DisplayWidth = 70
      FieldName = 'MENSAGEM'
      Size = 100
    end
    object qryDetDATAEXPIRAMSG: TDateTimeField
      FieldName = 'DATAEXPIRAMSG'
    end
    object qryDetEXIBE: TStringField
      DisplayWidth = 6
      FieldName = 'EXIBE'
      Size = 10
    end
    object qryDetDESCRICAO: TMemoField
      FieldName = 'DESCRICAO'
      Visible = False
      BlobType = ftMemo
    end
    object qryDetFLGEXIBEMSG: TFloatField
      FieldName = 'FLGEXIBEMSG'
      Visible = False
    end
  end
  object updDet: TUpdateSQL
    ModifySQL.Strings = (
      'update CONTRATOEMPTMOMSG'
      'set'
      '  DESCRICAO = :DESCRICAO,'
      '  DATAEXPIRAMSG = :DATAEXPIRAMSG,'
      ' FLGEXIBEMSG = :FLGEXIBEMSG'
      'where'
      '  IDCONTRATOEMPTMO = :OLD_IDCONTRATOEMPTMO and'
      '  IDSEQUENCIA = :OLD_IDSEQUENCIA ')
    InsertSQL.Strings = (
      'insert into CONTRATOEMPTMOMSG'
      
        '  (IDCONTRATOEMPTMO,IDSEQUENCIA,IDMODULO,DESCRICAO,DATAEXPIRAMSG' +
        ',FLGEXIBEMSG)'
      'values'
      
        '  (:IDCONTRATOEMPTMO,:IDSEQUENCIA,:IDMODULO,:DESCRICAO,:DATAEXPI' +
        'RAMSG,:FLGEXIBEMSG)')
    DeleteSQL.Strings = (
      'delete from CONTRATOEMPTMOMSG'
      'where'
      '   IDCONTRATOEMPTMO = :OLD_IDCONTRATOEMPTMO and'
      '  IDSEQUENCIA= :OLD_IDSEQUENCIA')
    Left = 320
    Top = 208
  end
