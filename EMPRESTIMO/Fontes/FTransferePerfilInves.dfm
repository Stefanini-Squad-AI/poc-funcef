  object udpHME: TUpdateSQL
    InsertSQL.Strings = (
      'insert into HISTMOVEMPTMO ('
      '     IDHISTMOVEMPTMO,'
      '     IDCONTRATOEMPTMO,'
      '     IDITEMEMPTMO,'
      '     HMETIPOMOV,'
      '     HMEORIGEM,'
      '     HMEDATAATUALIZA,'
      '     HMECENTRALIZA,'
      '     HMEDESTACADO,'
      '     FLGENTRADAMANUAL,'
      '     VERSAO,'
      '     HMERECPAG,'
      '     HMEVLRPREVISTO,'
      '     FLGENVIO,'
      '     FLGBAIXADO,'
      '     HMEVLREFETIVO,'
      '     HMEDATAEFETIVA,'
      '     HMEDATAPREVISTA,'
      '     HMESALDODEV,'
      '     HMESEQCOBRANCA'
      ') VALUES ('
      '     :IDHISTMOVEMPTMO,'
      '     :IDCONTRATOEMPTMO,'
      '     :IDITEMEMPTMO,'
      '     :HMETIPOMOV,'
      '     :HMEORIGEM,'
      '     :HMEDATAATUALIZA,'
      '     :HMECENTRALIZA,'
      '     :HMEDESTACADO,'
      '     :FLGENTRADAMANUAL,'
      '     :VERSAO,'
      '     :HMERECPAG,'
      '     :HMEVLRPREVISTO,'
      '     :FLGENVIO,'
      '     :FLGBAIXADO,'
      '     :HMEVLREFETIVO,'
      '     :HMEDATAEFETIVA,'
      '     :HMEDATAPREVISTA,'
      '     :HMESALDODEV,'
      '     :HMESEQCOBRANCA'
      ')'
      ''
      ' '
      ' '
      ' '
      ' ')
    DeleteSQL.Strings = (
      'delete from HISTMOVEMPTMO'
      'where'
      '  IDHISTMOVEMPTMO = :OLD_IDHISTMOVEMPTMO')
    Left = 720
    Top = 416
  end
  object qryDesfaz: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT ITC.FLGTRANSPERFIL, ITC.FLGTIPOITEM, CON.IDPLANOPREV, CON' +
        '.IDPLANOORIGEM,'
      '       ITC.FLGCENTRALIZA, ITC.FLGDESTACADO, ITC.IDITEMEMPTMO'
      '   FROM CONTRATOEMPTMO  CON  '
      
        '   JOIN TIPOCONTREMPTMO TCE ON CON.IDTIPOCONTREMPTMO = TCE.IDTIP' +
        'OCONTREMPTMO '
      
        '   JOIN ITEMXTIPOCONTR  ITC ON ITC.IDTIPOCONTREMPTMO = CON.IDTIP' +
        'OCONTREMPTMO '
      '                           AND ITC.FLGTRANSPERFIL IS NOT NULL  '
      
        '   JOIN TRANSPERFILINVEST TP ON TP.IDCONTRATOEMPTMO = CON.IDCONT' +
        'RATOEMPTMO'
      '                            AND TP.MESANOCOMPET = :MESANOCOMPET'
      '  WHERE CON.TP.IDCONTRATOEMPTMO = :IDCONTRATO')
    ValidateWithMask = True
    Left = 608
    Top = 376
    ParamData = <
      item
        DataType = ftString
        Name = 'MESANOCOMPET'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDCONTRATO'
        ParamType = ptUnknown
      end>
  end
