  object qryTransfDados: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT 1 AS FLGESCOLHA,'
      '       PE.NOME AS MUTUARIO,    '
      '       D.MATRICULA,            '
      
        '       DECODE(PE.NUMDOCUMENTO,NULL,NULL,TRANSLATE(TO_CHAR(PE.NUM' +
        'DOCUMENTO/100,'#39'000,000,000.00'#39'),'#39',.'#39','#39'.-'#39')) AS CPF_MASCARA, '
      '       PE.NUMDOCUMENTO AS CPF, '
      '       PP.NOME AS  PLANONOME,  '
      '       PXE.NOMEPERFIL_SAIDA,   '
      '       PXE.NOMEPERFIL_ENTRADA, '
      '       PXE.PLANOCONTAB_SAI,    '
      '       PXE.PLANOCONTAB_ENTRA,  '
      '       PXE.IDPERFIL_SAIDA,     '
      '       PXE.IDPERFIL_ENTRADA,'
      '       CON.IDCONTRATOEMPTMO AS CONTRATO,  '
      '       TCE.TCEDESCRICAO AS MODALIDADE,  '
      '       DECODE(CON.FLGSITUACAO, '#39'A'#39', '#39'ATIVO'#39',        '
      '                               '#39'C'#39', '#39'Cancelado'#39',    '
      '                               '#39'E'#39', '#39'Encerrado'#39',    '
      '                               '#39'Q'#39', '#39'Quitado'#39',      '
      '                               '#39'R'#39', '#39'Refinanciado'#39', '
      '                               '#39'S'#39', '#39'Suspenso'#39',     '
      '                               '#39'P'#39', '#39'Pendente de Liberação'#39',  '
      
        '                               '#39'K'#39', '#39'Pendente de Quitação'#39', '#39#39') ' +
        'AS SITUACAO,'
      '       0.00 AS SALDOTRANSF,   '
      '       0.00 AS SALDOINAD,     '
      '       0.00 AS SALDO_PROV_PERDA,'
      '       0.00 AS SALDOTOTAL, '
      '       0 AS NUMPARCVENCE,'
      '       NVL(CON.VLRPARCATRASO,0) AS VLRPARCVENCE,   '
      '       PXE.DTFIM,           '
      '       CON.DATACREDITO, '
      '       0 AS IDTRANSPERFILINVEST,    '
      '       '#39'S'#39' AS TRANSFERIDO '
      'FROM CONTRATOEMPTMO CON '
      '     JOIN PESSOA PE ON PE.IDPESSOA = CON.IDPESSOA  '
      '     JOIN DEPENTIT D ON D.IDTITULAR = CON.IDPESSOA '
      '                    AND D.IDPESSOA = CON.IDBENEF   '
      '     JOIN PLANPREV PP ON PP.IDPLANOPREV = CON.IDPLANOPREV '
      '     JOIN (SELECT TF.PLANOCONTAB_ENTRA,'
      '                  TF.PLANOCONTAB_SAI,'
      '                  TF.NOMEPERFIL_ENTRADA,'
      '                  TF.NOMEPERFIL_SAIDA,'
      '                  TF.IDPERFIL_ENTRADA,'
      '                  TF.IDPERFIL_SAIDA,'
      '                  TF.DTFIM,'
      '                  TF.IDPESSOA,'
      '                  TF.IDPLANOPREV,'
      '                  TF.IDPESSJUR'
      '           FROM CM.VW_EMP_TRANSFPERFIL TF  '
      
        '           WHERE TO_CHAR(TF.DTFIM, '#39'YYYY/MM'#39') = '#39'2017/11'#39') PXE o' +
        'n PXE.IDPESSOA    = CON.IDPESSOA  '
      
        '                                                              AN' +
        'D PXE.IDPLANOPREV = CON.IDPLANOPREV  '
      
        '                                                              AN' +
        'D PXE.IDPESSJUR   = CON.IDPATRO '
      
        '     JOIN TIPOCONTREMPTMO TCE ON TCE.IDTIPOCONTREMPTMO = CON.IDT' +
        'IPOCONTREMPTMO '
      '     JOIN TIPOEMPTMO TEP ON TEP.IDTIPOEMPTMO = TCE.IDTIPOEMPTMO '
      '     '
      '  WHERE TEP.IDEMPRESAPROP = 1  '
      '  AND CON.DATACREDITO <= PXE.DTFIM  '
      '  AND CON.IDPATRO      IN (91008, 994886, 1, 1117723) '
      '  AND CON.IDPLANOPREV  IN (74, 110, 66, 79, 19, 2) '
      '  AND CON.FLGSITUACAO <> '#39'C'#39
      '  AND (CON.FLGSITUACAO IN ('#39'A'#39','#39'K'#39','#39'E'#39') OR'
      '       (CON.FLGSITUACAO = '#39'Q'#39' AND'
      
        '        TO_CHAR(PXE.DTFIM, '#39'YYYY/MM'#39') < (SELECT TO_CHAR(MAX(HME.' +
        'DATAPREVISTA),'#39'YYYY/MM'#39')'
      '                                         FROM HMEQUITACAO HME'
      
        '                                         WHERE NVL(HME.FLGESTORN' +
        'ADO,0) = 0 AND'
      
        '                                               HME.NATUREZAITEM ' +
        '= 2 AND'
      
        '                                               HME.IDCONTRATOEMP' +
        'TMO = CON.IDCONTRATOEMPTMO)))'
      '  AND EXISTS (SELECT 1'
      '              FROM PERFILINVXELEG PIE'
      '              WHERE TO_CHAR(PIE.DTFIM,'#39'YYYY/MM'#39') = '#39'2017/11'#39
      '                AND PIE.IDPESSOA    = CON.IDPESSOA  '
      '                AND PIE.IDPLANOPREV = CON.IDPLANOPREV  '
      '                AND PIE.IDPESSJUR   = CON.IDPATRO)'
      '  AND EXISTS (SELECT 1  '
      '              FROM ITEMXTIPOCONTR  ITC  '
      
        '              WHERE ITC.IDTIPOCONTREMPTMO = CON.IDTIPOCONTREMPTM' +
        'O '
      '                AND ITC.FLGTRANSPERFIL IS NOT NULL)'
      'ORDER BY PE.NOME'
      ' ')
    ControlType.Strings = (
      'FLGESCOLHA;CheckBox;1;0')
    ValidateWithMask = True
    Left = 124
    Top = 432
