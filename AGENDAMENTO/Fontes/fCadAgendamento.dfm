  inherited MontaSelect: TMontaSelect
    Caption = 'Seleciona Agendamento...'
    Colunas.Strings = (
      'DECODE( PESSOA.NOME, '#39#39', AGENDAMENTO.NOMESOLIC, PESSOA.NOME )'
      'AGENDAMENTO.DATA'
      'SUBSTR( HORA, 1, 2 ) || '#39':'#39' || SUBSTR( HORA, 3, 2 ) as HORA'
      'ASSUNTOAGENDA.DESCRICAO'
      'P2.NOME'
      'AGENDAMENTO.TELEFONE'
      
        'DECODE( AGENDAMENTO.FLGSITUACAO, 1, '#39'Agendado'#39', 2, '#39'Efetivado'#39', ' +
        '3, '#39'Cancelado'#39' )'
      'trunc( AGENDAMENTO.DATAALTERACAO ) as DATAALTERACAO'
      'AGENDAMENTO.IDATEND'
      'PARTPREVPLAN.INSCRICAONUMERO'
      'ELEGPATRO.MATRICULA')
