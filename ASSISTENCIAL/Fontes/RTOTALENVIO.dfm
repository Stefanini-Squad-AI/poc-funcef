  object QryRptCM: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  '#39'2002/09'#39' AS MESCOBRANCA, '#39' '#39' AS NOME,'
      '  1 AS TOTAL,'
      '  1 AS TOTALVALOR'
      'FROM  DUAL'
      '')
