  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT P.IDPESSOA, P.IDIMAGEM, P.NOME, P.TIPO,  P.RAZAOSOCIAL,'
      ' P.NUMDOCUMENTO, P.IDDOCUMENTO, P.EMAIL, P.IDGRUPO,'
      ' P.IDENDCOMERCIAL, P.IDENDRESIDENCIAL, P.IDENDENTREGA,'
      ' P.IDENDCOBRANCA, P.IDENDCORRESP, G.NOME NOMEGRUPO'
      'FROM PESSOA p, PESSOA g'
      'WHERE'
      ' (P.IDPESSOA =:IdPessoa )  AND'
      ' (G.IDPESSOA(+) = P.IDGRUPO)')
  end
  inherited MontaSelect: TMontaSelect
    Colunas.Strings = (
      'PESSOA.NOME')
    TipodeDado.Strings = (
      'C')
    Descricao.Strings = (
      'Nome do Fornecedor')
    Tabelas.Strings = (
      'FORNSERV'
      'PESSOA')
    CamposChave.Strings = (
      'FORNSERV.IDPESSOA')
  end
  inherited updSubTipo: TUpdateSQL
    ModifySQL.Strings = (
      'update FORNSERV'
      'set'
      '  IDPESSOA = :IDPESSOA,'
      '  FLGASS = 1'
      'where'
      '  IDPESSOA = :OLD_IDPESSOA')
    InsertSQL.Strings = (
      'insert into FORNSERV'
      '  (IDPESSOA, FLGASS)'
      'values'
      '  (:IDPESSOA, 1)')
    DeleteSQL.Strings = (
      'delete from FORNSERV'
      'where'
      '  IDPESSOA = :OLD_IDPESSOA')
  end
  inherited qrySubTipo: TwwQuery
    BeforePost = qrySubTipoBeforePost
    SQL.Strings = (
      'SELECT IDPESSOA, FLGASS'
      'FROM  FORNSERV'
      'WHERE (IDPESSOA = :IdPessoa)')
  end
