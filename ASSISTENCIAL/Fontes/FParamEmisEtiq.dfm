  object qryPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDPESSOA,NOME'
      'FROM PESSOA '
      'WHERE IDPESSOA IN (SELECT IDPESSOA FROM PATRO)'
      'ORDER BY NOME')
    ValidateWithMask = True
    Left = 141
    Top = 235
  end
