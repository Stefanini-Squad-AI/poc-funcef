  end
  object QryEtiqParticip: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  DISTINCT'
      '        P.NOME, '
      '        E.LOGRADOURO, '
      '        E.NUMERO, '
      '        E.COMPLEMENTO, '
      '        E.BAIRRO, '
      '        E.CEP, '
      '        C.NOME AS CIDADE, '
      '        ES.CODESTADO, '
      '        PA.NOMEPAIS '
      
        'FROM CIDADES C,ESTADO ES, ELEGPATRO EL, PARTASS, PESSOA P, PLANA' +
        'SS, SITPLANOASS, '
      'PESSOA P2, PLANPREV PR, PARTPREVPLAN PREV, ENDPESS E, PAIS PA  '
      'WHERE (PARTASS.IDPESSJUR = P2.IDPESSOA)'
      'AND   (P2.IDPESSOA = EL.IDPESSJUR) '
      'AND   (EL.IDPESSJUR = PARTASS.IDPESSJUR) '
      'AND   (EL.IDPESSOA = P.IDPESSOA) '
      'AND   (PLANASS.IDPLANASS = PARTASS.IDPLANASS) '
      'AND   (SITPLANOASS.IDSITPLANOASS = PARTASS.IDSITPART) '
      'AND   (PARTASS.IDPLANOPREV = PR.IDPLANOPREV) '
      'AND   (PARTASS.IDPESSOA = EL.IDPESSOA) '
      'AND   (P.IDPESSOA = E.IDPESSOA) '
      'AND   (PREV.IDPESSOA = PARTASS.IDPESSOA) '
      'AND   (PREV.IDPESSJUR = PARTASS.IDPESSJUR) '
      'AND   (E.IDCIDADES=C.IDCIDADES) '
      'AND   (C.IDESTADO=ES.IDESTADO) '
      'AND   (ES.IDPAIS=PA.IDPAIS) '
      'AND   (PREV.IDPLANOPREV = PARTASS.IDPLANOPREV) '
      ''
      '')
    ValidateWithMask = True
    Left = 478
    Top = 72
  end
