  object qryrecforn: TwwQuery
    BeforeOpen = qryrecfornBeforeOpen
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'select histrec.* , planass.nome , motivo.descricao  '
      '                from histrec, planass , motivo '
      'where '
      'histrec.idplanass = planass.idplanass and '
      'histrec.idmotivo =  motivo.idmotivo  '
      '    ')
    ValidateWithMask = True
    Left = 278
    Top = 165
  end
