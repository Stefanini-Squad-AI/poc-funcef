              '             A '#9'                      Data de Movimentação (Data' +
              ': DD/MM/YYYY)'
            
              '             B '#9'                      Placa de Tombamento (NUMÉR' +
              'ICO)'
            
              '             C '#9'                      Movimentação ('#39'A'#39' - Acrésc' +
              'imo ou '#39'D'#39' - Decréscimo)'
            '             D '#9'                      Tipo de Movimentação (ID)'
            '             E '#9'                      Valor (NÚMERICO)'
            
              '             F '#9'                      Descrição do Fato Gerador ' +
              'da Movimentação (TEXTO)'
            ''
            ' '
            ' '
            ' '
            ' '
            ' ')
          ParentFont = False
          ReadOnly = True
          TabOrder = 0
        end
      end
