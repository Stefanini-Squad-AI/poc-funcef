        object mmoLayout: TMemo
          Left = 0
          Top = 0
          Width = 817
          Height = 260
          Align = alClient
          Font.Charset = ANSI_CHARSET
          Font.Color = clWindowText
          Font.Height = -13
          Font.Name = 'Verdana'
          Font.Style = [fsBold]
          Lines.Strings = (
            ''
            '             COLUNA           CAMPO'
            
              '             ------------'#9'    ----------------------------------' +
