  object sqlGerBens: TCMSqlParams
    SQL.Strings = (
      'SELECT B.IDBEM,'
      '       B.PLACA,'
      '       B.DESBEM,'
      '       B.IDCONJUNTO,'
      '       C.DESCCONJUNTO,'
      '       B.IDGRUPO,'
      '       G.CLASSE,'
      '       G.NOME,'
      '       (0.0000) AS PROPORCAO'
      'FROM BEM B,'
      '     CONJUNTO C,'
      '     GRUPO G'
      'WHERE B.IDBEM = -2'
      '  AND B.IDCONJUNTO = C.IDCONJUNTO'
      '  AND B.IDGRUPO    = G.IDGRUPO'
      '')
    ClientDataSet = cdsGerBens
    Left = 308
    Top = 301
  end
