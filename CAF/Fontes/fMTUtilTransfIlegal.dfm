  object sqlTransfIlegal: TCMSqlParams
    SQL.Strings = (
      'SELECT B.PLACA, SUBSTR(B.DESBEM,1,30) AS DESCBEM,'
      
        '       G.IDGRUPO AS IDGRUPOANT, G.CLASSE AS CLASSEANT, G.NOME AS' +
        ' NOMEANT,'
      
        '       G.IDGRUPO AS IDGRUPOATU, G.CLASSE AS CLASSEATU, G.NOME AS' +
        ' NOMEATU'
      'FROM BEM B,'
      '     GRUPO G'
      'WHERE B.IDBEM = -9'
      '  AND G.IDGRUPO = -9'
      '  AND B.IDGRUPO = G.IDGRUPO'
      'ORDER BY 1, 4, 7'
      '')
    ClientDataSet = cdsTransfIlegal
    Left = 585
    Top = 52
  end
