  object cdsCadBens: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 296
    Top = 80
  end
  object sqlCadBens: TCMSqlParams
    SQL.Strings = (
      
        'SELECT B.IDBEM, B.IDPESSOA, '#39'1'#39' AS NATUREZA, '#39' '#39' AS PLACAPRINCIP' +
        'AL,'
      
        '       SUBSTR(RTRIM(B.DESBEM),1,45) AS DESCBEM, CCC.CONTACUSTO, ' +
        'CCD.CONTADEPREC,'
      '       B.DTAINCLUSAO, '#39'NF'#39' AS TIPODOC, B.COMPLNOTA, B.IDNOTA,'
      '       B.VALHISTORICO, B.PLACA, B.DATAINICIODEP, DAA.DEPACUMANT,'
      '       DAP.DEPACUMPER, DB.DATABAIXA,'
      '       BM.VALORG, BD.TAXADEP'
      ''
      'FROM BEM B, GRUPO G, BEMXMOEDA BM, BEMXDEP BD,'
      '     (SELECT IDPESSOA, IDGRUPO, PLACONTA AS CONTACUSTO'
      '      FROM CONTASTIPOSMOVIMENTOGRUPOS CTMG'
      '      WHERE (IDTIPOMOVIMENTACAO = 01)'
      '        AND (TIPOLANCAMENTO = '#39'D'#39')'
      '        AND (IDPESSOA = :IDPESSOA)) CCC,'
      ''
      '     (SELECT IDPESSOA, IDGRUPO, PLACONTA AS CONTADEPREC'
      '      FROM CONTASTIPOSMOVIMENTOGRUPOS CTMG'
      '      WHERE (IDTIPOMOVIMENTACAO = 14)'
      '        AND (TIPOLANCAMENTO = '#39'C'#39')'
      '        AND (IDPESSOA = :IDPESSOA)) CCD,'
      ''
      
        '     (SELECT HM.IDBEM, HM.IDPESSOA, SUM(NVL(VM.VALOR,0)) AS DEPA' +
        'CUMANT'
      '      FROM HISTORICOMOVIMENTACAO HM,'
      '           VLRHISTMOVBEM VM'
      '      WHERE (HM.DATAMOVIMENTACAO < :DATAMOVINI)'
      
        '        AND ((HM.IDTIPOMOVIMENTACAO = 14) OR (HM.IDTIPOMOVIMENTA' +
        'CAO = 17))'
      '        AND (HM.IDPESSOA = :IDPESSOA)'
      '        AND (VM.MOECODIGO = :MOECODIGO)'
      '        AND (VM.IDTAXADEP = :IDTAXADEP)'
      '        AND (HM.IDMOVIMENTACAO = VM.IDMOVIMENTACAO(+))'
      '      GROUP BY HM.IDBEM, HM.IDPESSOA) DAA,'
      ''
      
        '     (SELECT HM.IDBEM, HM.IDPESSOA, SUM(NVL(VM.VALOR,0)) AS DEPA' +
        'CUMPER'
      '      FROM HISTORICOMOVIMENTACAO HM,'
      '           VLRHISTMOVBEM VM'
      '      WHERE (HM.DATAMOVIMENTACAO >= :DATAMOVINI)'
      '        AND (HM.DATAMOVIMENTACAO <= :DATAMOVFIM)'
      
        '        AND ((HM.IDTIPOMOVIMENTACAO = 14) OR (HM.IDTIPOMOVIMENTA' +
        'CAO = 17))'
      '        AND (HM.IDPESSOA = :IDPESSOA)'
      '        AND (VM.MOECODIGO = :MOECODIGO)'
      '        AND (VM.IDTAXADEP = :IDTAXADEP)'
      '        AND (HM.IDMOVIMENTACAO = VM.IDMOVIMENTACAO(+))'
      '      GROUP BY HM.IDBEM, HM.IDPESSOA) DAP,'
      ''
      '     (SELECT IDBEM, IDPESSOA, DATAMOVIMENTACAO AS DATABAIXA'
      '      FROM HISTORICOMOVIMENTACAO'
      '      WHERE (IDTIPOMOVIMENTACAO = 06)'
      '        AND (DATAMOVIMENTACAO >= :DATAMOVINI)'
      '        AND (DATAMOVIMENTACAO <= :DATAMOVFIM)'
      '        AND (IDPESSOA = :IDPESSOA)) DB'
      ''
      'WHERE (B.IDPESSOA = :IDPESSOA)'
      '  AND (B.DATAINICIODEP <= :DATAMOVFIM)'
      '  AND (B.CONTROLE = '#39'T'#39')'
      '  AND (G.FLGIMOVEL = 0)'
      '  AND (BM.MOECODIGO = :MOECODIGO)'
      '  AND (BD.IDBEMXDEP = :IDTAXADEP)'
      '  AND (B.IDGRUPO = G.IDGRUPO)'
      '  AND (B.IDBEM = BM.IDBEM)'
      '  AND (B.IDPESSOA = BM.IDPESSOA)'
      '  AND (BM.IDBEM = BD.IDBEM)'
      '  AND (BM.IDPESSOA = BD.IDPESSOA)'
      '  AND (BM.MOECODIGO = BD.MOECODIGO)'
      '  AND (B.IDGRUPO  = CCC.IDGRUPO(+))'
      '  AND (B.IDPESSOA = CCC.IDPESSOA(+))'
      '  AND (B.IDGRUPO  = CCD.IDGRUPO(+))'
      '  AND (B.IDPESSOA = CCD.IDPESSOA(+))'
      '  AND (B.IDBEM    = DAA.IDBEM(+))'
      '  AND (B.IDPESSOA = DAA.IDPESSOA(+))'
      '  AND (B.IDBEM    = DAP.IDBEM(+))'
      '  AND (B.IDPESSOA = DAP.IDPESSOA(+))'
      '  AND (B.IDBEM    = DB.IDBEM(+))'
      '  AND (B.IDPESSOA = DB.IDPESSOA(+))'
      'ORDER BY B.PLACA'
      '')
    ClientDataSet = cdsCadBens
    Left = 296
    Top = 66
  end
end
