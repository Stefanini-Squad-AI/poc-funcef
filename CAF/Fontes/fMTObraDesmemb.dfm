  object sqlDet: TCMSqlParams
    SQL.Strings = (
      'SELECT O.IDCAFOBRA,'
      '       O.IDPESSOA,'
      '       O.DESCCAFOBRA,'
      '       '#39' '#39' AS TIPOPROPORCAO,'
      '       (0.0000) AS PROPORCAO'
      'FROM CAFOBRA O'
      'WHERE O.IDCAFOBRA <= -1')
