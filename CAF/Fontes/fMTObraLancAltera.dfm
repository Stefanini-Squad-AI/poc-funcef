  object sqlLancObra: TCMSqlParams
    SQL.Strings = (
      
        'SELECT L.IDOBRALANC, L.IDCAFOBRA, L.IDPESSOA, L.IDMODULO, L.IDOB' +
        'RATIPOETAPA,'
      
        '       EO.DESCOBRATIPOETAPA, L.PLNCODIGO, L.DTANOTA, L.NUMNOTA, ' +
        'L.COMPLNOTA,'
      
        '       L.DTALANCAMENTO, L.VALOFI, L.VALFIS, L.VALGER, L.VALGERB,' +
        ' G.NOME AS DESCGRUPO,'
      '       L.IDFORNECEDOR, L.DESCLANCOBRA, P.NOME AS NOMEFORN'
      'FROM   CAFOBRALANC L,'
      '       CAFOBRATIPOETAPA EO,'
      '       GRUPO G,'
      '       PESSOA P'
      'WHERE L.IDCAFOBRA = :IDCAFOBRA'
      '  AND L.IDPESSOA = :IDPESSOA'
      '  AND L.IDOBRATIPOETAPA = EO.IDOBRATIPOETAPA'
      '  AND L.IDGRUPO = G.IDGRUPO'
      '  AND L.IDFORNECEDOR = P.IDPESSOA(+)'
      'ORDER BY L.DTALANCAMENTO, L.IDGRUPO, L.IDOBRATIPOETAPA'
      '')
    Left = 377
    Top = 76
  end
