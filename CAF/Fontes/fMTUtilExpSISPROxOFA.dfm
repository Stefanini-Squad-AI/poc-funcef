  object cdsMovTrf: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 240
    Top = 224
  end
  object sqlMovTrf: TCMSqlParams
    SQL.Strings = (
      'SELECT PG.CODSISPROXOFA AS CODEMPRESA,'
      '       HM.IDPESSOA,'
      '       SB.IDGRUPO,'
      '       HM.IDTIPOMOVIMENTACAO,'
      '       TO_CHAR(HM.DATAMOVIMENTACAO,'#39'YYYYMM'#39') AS PERIODO,'
      '       M.MOESIGLA,'
      
        '       NVL(HM.TRFVALORG,0) AS TRFVALORG, NVL(HM.TRFCMBEM,0) AS T' +
        'RFCMBEM,'
      
        '       NVL(HM.TRFDEPLANC,0) AS TRFDEPLANC, NVL(HM.TRFCMDEP,0) AS' +
        ' TRFCMDEP'
      'FROM HISTORICOMOVIMENTACAO HM,'
      '     SALDOCONTABBEM SB,'
      '     MOEDA M,'
      '     PARAMGLOBAL PG'
      
        'WHERE HM.DATAMOVIMENTACAO >= :DATAINI AND HM.DATAMOVIMENTACAO <=' +
        ' :DATAFIM'
      '  AND (HM.IDTIPOMOVIMENTACAO = 11 OR HM.IDTIPOMOVIMENTACAO = 12)'
      '  AND SB.MOECODIGO = :MOECODIGO'
      '  AND HM.IDBEM = SB.IDBEM'
      '  AND HM.IDPESSOA = SB.IDPESSOA'
      '  AND HM.DATAMOVIMENTACAO = SB.DATASLDBEM'
      '  AND SB.MOECODIGO = M.MOECODIGO'
      
        'ORDER BY HM.IDPESSOA, SB.IDGRUPO, HM.IDTIPOMOVIMENTACAO, HM.DATA' +
        'MOVIMENTACAO'
      '')
    ClientDataSet = cdsMovTrf
    Left = 240
    Top = 208
  end
  object cdsContaContabil: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 120
    Top = 160
  end
  object sqlContaContabil: TCMSqlParams
    SQL.Strings = (
      'SELECT PLACONTA '
      'FROM CONTASTIPOSMOVIMENTOGRUPOS '
      'WHERE (IDGRUPO = :IDGRUPO)'
      '  AND (IDTIPOMOVIMENTACAO = :IDTIPOMOVIMENTACAO)'
      '  AND (TIPOLANCAMENTO = :TIPOLANCAMENTO)'
      '  AND (IDPESSOA = :IDPESSOA)'
      '  AND (PLANO = :PLANO)')
    ClientDataSet = cdsContaContabil
    Left = 120
    Top = 144
  end
  object cdsMovCaf: TCMClientDataSet
    Aggregates = <>
    FieldDefs = <>
    IndexDefs = <>
    Params = <>
    StoreDefs = True
    Left = 240
    Top = 160
  end
  object sqlMovCaf: TCMSqlParams
    SQL.Strings = (
      'SELECT PG.CODSISPROXOFA AS CODEMPRESA,'
      '       HM.IDPESSOA, HM.IDBEM,'
      '       ('#39'                  '#39') AS PLACONTA,'
      '       SB.IDGRUPO,'
      '       HM.IDTIPOMOVIMENTACAO,'
      '       TO_CHAR(HM.DATAMOVIMENTACAO,'#39'YYYYMM'#39') AS PERIODO,'
      '       VM.MOECODIGO,'
      '       M.MOESIGLA,'
      '       (0) AS NCODSISPROXOFA,'
      '       MB.CODSISPROXOFA,'
      '       NVL(VM.VALOR, 0.00) AS VALOR'
      'FROM HISTORICOMOVIMENTACAO HM,'
      '     VLRHISTMOVBEM VM,'
      '     SALDOCONTABBEM SB,'
      '     PARAMGLOBAL PG,'
      '     MOTIVOBAIXA MB,'
      '     MOEDA M'
      'WHERE HM.DATAMOVIMENTACAO >= :DATAINI'
      '  AND HM.DATAMOVIMENTACAO <= :DATAFIM'
      '  AND HM.IDTIPOMOVIMENTACAO NOT IN (03,05,08,09,11,12)'
      '  AND NVL(VM.VALOR, 0.00) <> 0'
      '  AND SB.MOECODIGO = :MOECODIGO'
      '  AND VM.MOECODIGO = :MOECODIGO'
      '  AND (VM.IDTAXADEP = 0 or VM.IDTAXADEP = :IDTAXADEP)'
      '  AND HM.IDPESSOA = PG.IDPESSOA'
      '  AND HM.IDBEM = SB.IDBEM'
      '  AND HM.IDPESSOA = SB.IDPESSOA'
      '  AND HM.DATAMOVIMENTACAO = SB.DATASLDBEM'
      '  AND HM.IDMOVIMENTACAO = VM.IDMOVIMENTACAO(+)'
      '  AND VM.MOECODIGO = M.MOECODIGO(+)'
      '  AND HM.IDMOTIVOBAIXA = MB.IDMOTIVOBAIXA(+)'
      
        'ORDER BY HM.IDPESSOA, SB.IDGRUPO, HM.IDTIPOMOVIMENTACAO, HM.DATA' +
        'MOVIMENTACAO, VM.MOECODIGO'
      '')
    ClientDataSet = cdsMovCaf
    Left = 240
    Top = 144
  end
  object cdsSISPROxOFA: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 312
    Top = 32
  end
  object sqlSISPROxOFA: TCMSqlParams
    SQL.Strings = (
      'SELECT ('#39'     '#39') AS CODEMPRESA,'
      '       ('#39'                    '#39') AS PLACONTA,'
      '       ('#39'      '#39') AS PERIODO,'
