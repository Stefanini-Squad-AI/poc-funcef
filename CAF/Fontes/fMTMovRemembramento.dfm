    SQL.Strings = (
      'SELECT B.IDBEM,'
      '       B.PLACA,'
      '       B.DESBEM,'
      '       B.IDCLASSEBEM,'
      '       B.IDSITUACAO,'
      '       B.IDCONJUNTO,'
      '       C.DESCCONJUNTO,'
      '       C.IDLOCALIZACAO,'
      '       L.NOME AS DESCLOCAL,'
      '       B.IDGRUPO,'
      '       G.NOME AS DESCGRUPO'
      'FROM BEM B,'
      '     CONJUNTO C,'
      '     LOCALIZACAO L,'
      '     PLANOGRUPO PG,'
      '     GRUPO G'
      'WHERE B.IDBEM = -1'
      '  AND B.IDPESSOA = :IDPESSOA'
      '  AND C.IDPESSOA = :IDPESSOA'
      '  AND L.IDPESSOA = :IDPESSOA'
      '  AND PG.IDPESSOA = :IDPESSOA'
      '  AND B.IDCONJUNTO = C.IDCONJUNTO'
      '  AND B.IDPESSOA = C.IDPESSOA'
      '  AND C.IDLOCALIZACAO = L.IDLOCALIZACAO'
      '  AND C.IDPESSOA = L.IDPESSOA'
      '  AND B.IDGRUPO = PG.IDGRUPO'
      '')
    ClientDataSet = cdsSelBens
    Left = 380
    Top = 77
  end
