  object sqlBalPat: TCMSqlParams
    SQL.Strings = (
      'SELECT G.IDGRUPO,'
      '       G.CLASSE,'
      '       G.NOME AS DESCGRUPO,'
      '       G.TIPO AS S_A,'
      '       (0.00) AS VALORG,'
      '       (0.00) AS CMBEM,'
      '       (0.00) AS DEPLANC,'
      '       (0.00) AS CMDEP,'
      '       (0.00) AS VALCTB'
      'FROM GRUPO G,'
      '     PLANOGRUPO PG'
      'WHERE PG.IDPESSOA = :IDPESSOA'
      '  AND G.IDGRUPO = PG.IDGRUPO'
      'ORDER BY G.CLASSE'
      ''
      ''
      '')
    ClientDataSet = cdsBalPat
    Left = 552
    Top = 272
  end
  object cdsBalPatGrp: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 656
    Top = 142
  end
  object sqlBalPatGrp: TCMSqlParams
    SQL.Strings = (
      'SELECT IDGRUPO,'
      '       CLASSE,'
      '       NOME AS DESCGRUPO,'
      '       TIPO AS S_A,'
      '       (0.00)  AS VALORG,'
      '       (0.00)  AS CMBEM,'
      '       (0.00)  AS DEPLANC,'
      '       (0.00)  AS CMDEP,'
      '       (0.00)  AS VALCTB'
      'FROM GRUPO'
      'WHERE IDGRUPO IS NULL'
      'ORDER BY CLASSE'
      '')
    ClientDataSet = cdsBalPatGrp
    Left = 656
    Top = 128
  end
  object cdsGrpAnaliticos: TCMClientDataSet
