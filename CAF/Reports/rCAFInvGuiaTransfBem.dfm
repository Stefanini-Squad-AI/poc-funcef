  object sqlGuiaTransfBem: TCMSqlParams
    SQL.Strings = (
      'SELECT (TO_CHAR(SBB.IDSELBAIXA, '#39'0999999999'#39')||'
      '        TO_CHAR(SBB.IDCONJATUAL,'#39'0999999999'#39')||'
      
        '        TO_CHAR(SBB.IDCONJUNTO, '#39'0999999999'#39')) AS TERMOCONJGRUPO' +
        ','
      '       SB.SBXTERMO,        SBB.IDSELBAIXA,'
      '       SB.SBXDATA,         SBB.IDCONJATUAL,'
      '       SB.SBXDTAEXECUTADO, SBB.IDCONJUNTO,'
      '       LO.NOME     AS NOMELOCORIG,'
      '       LO.ENDERECO AS ENDELOCORIG,'
      '       RO.NOME     AS NOMERSPORIG,'
      '       LD.NOME     AS NOMELOCDEST,'
      '       LD.ENDERECO AS ENDELOCDEST,'
      '       RD.NOME     AS NOMERSPDEST,'
      '       B.PLACA,'
      '       B.DESBEM,'
      '       B.VALORG'
      'FROM SELBAIXA     SB,'
      '     SELBAIXABENS SBB,'
      '     BEM          B,'
      '     CONJUNTO     CO,'
      '     CONJUNTO     CD,'
      '     LOCALIZACAO  LO,'
      '     LOCALIZACAO  LD,'
      '     PESSOA       RO,'
      '     PESSOA       RD'
      'WHERE SB.SBTIPOMOV = 1'
      '  AND SB.SBXDATA >= :DATAMOVINI'
      '  AND SB.SBXDATA <= :DATAMOVFIM'
      '  AND SB.IDPESSOA = :IDPESSOA'
      ''
      ''
      ''
      ''
      ''
      '  AND SB.IDSELBAIXA = SBB.IDSELBAIXA'
      '  AND SB.IDPESSOA = SBB.IDPESSOA'
      '  AND SBB.IDBEM = B.IDBEM'
      '  AND SBB.IDPESSOA = B.IDPESSOA'
      '  AND SBB.IDCONJATUAL = CO.IDCONJUNTO(+)'
      '  AND SBB.IDPESSOA = CO.IDPESSOA(+)'
      '  AND SBB.IDLOCALATUAL = LO.IDLOCALIZACAO(+)'
      '  AND SBB.IDPESSOA = LO.IDPESSOA(+)'
      '  AND SBB.IDRESPATUAL = RO.IDPESSOA(+)'
      '  AND SBB.IDCONJUNTO = CD.IDCONJUNTO(+)'
      '  AND SBB.IDPESSOA = CD.IDPESSOA(+)'
      '  AND SBB.IDLOCALIZACAO = LD.IDLOCALIZACAO(+)'
      '  AND SBB.IDPESSOA = LD.IDPESSOA(+)'
      '  AND SBB.IDRESPONSAVEL = RD.IDPESSOA(+)'
      'ORDER BY 1, B.PLACA'
      ''
      ' ')
    ClientDataSet = cdsGuiaTransfBem
    Left = 233
    Top = 61
  end
