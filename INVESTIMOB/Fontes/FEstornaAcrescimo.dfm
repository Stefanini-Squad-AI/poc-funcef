  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT'
      '   OP.VLROPERACAOOM, OP.VLROPERACAO, OP.MOECODIGO,'
      '   OP.DATAVENCOPER, OP.DATAOPERACAO,'
      '   OP.OBSERVACAO,'
      ''
      '   I.IMONOME AS NOME_IMOVEL,'
      '   IM.IMONOME AS NOME_MESTRE,'
      ''
      '   TP.DESCTIPOOPERACAO,'
      ''
      '   P.RAZAOSOCIAL, P.NOME,'
      ''
      '   M.MOESIGLA'
      'FROM'
      '   PESSOA P, IMOVEL I, IMOVEL IM,'
      '   MOEDA M,'
      '   OPERACAOINVEST OP, TIPOOPERACAO TP'
      'WHERE'
      '   ( OP.IDOPERACAOINVEST =:OPERACAO )'
      '   AND ( I.FLGTIPOIMOVEL = 1 )'
      '   AND ( IM.FLGTIPOIMOVEL = 0 )'
      '   AND ( OP.IDTIPOINVEST = 3 )'
      '   AND ( TP.NATUREZAOPERACAO = '#39'M'#39' )'
      '   AND ( OP.IDINVESTIMENTO = I.IDIMOVEL )'
      '   AND ( I.IDIMOVELMESTRE = IM.IDIMOVEL )'
      '   AND ( OP.IDTIPOOPERACAO = TP.IDTIPOOPERACAO )'
      '   AND ( OP.IDFORCLI = P.IDPESSOA )'
      '   AND ( OP.MOECODIGO = M.MOECODIGO(+) )')
    Left = 279
    Top = 0
    ParamData = <
      item
        DataType = ftInteger
        Name = 'OPERACAO'
        ParamType = ptUnknown
      end>
