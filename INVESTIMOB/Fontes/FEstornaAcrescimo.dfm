  object qryOperXAcresc: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   B.PLACA, B.DESBEM,'
      '   A.VALORG, A.DATAACRESCIMO,'
      '   A.IDBEM, A.IDMOVIMENTACAO,'
      '   A.IDACRESCIMO'
      'FROM'
      '   ACRESCIMOVALOR A, BEM B,'
      '   OPERXACRESC X'
      'WHERE'
      '   ( X.IDOPERACAOINVEST =:OPERACAO )'
      '   AND ( X.IDACRESCIMO = A.IDACRESCIMO )'
      '   AND ( A.IDBEM = B.IDBEM )'
      'ORDER BY'
      '   B.DESBEM')
    ValidateWithMask = True
    Left = 440
    Top = 12
    ParamData = <
      item
        DataType = ftInteger
        Name = 'OPERACAO'
        ParamType = ptUnknown
      end>
