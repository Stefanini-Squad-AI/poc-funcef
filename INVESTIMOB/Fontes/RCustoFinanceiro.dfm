  object qryCustoFinanceiro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   TO_CHAR(DATA_BAIXA, '#39'YYYYMM'#39') AS ANOMESBAIXA,'
      
        '   SUM(DECODE (RECPAG, '#39'R'#39', VLRLANCRECEB * TOT_RECEBIDO / TOT_RE' +
        'CEBER, VLRLANCPAGAR * TOT_PAGO / TOT_PAGAR * (-1))) AS TOT_LANC'
      'FROM'
      '   VWLANCAMENTO'
      'WHERE'
      
        '   ( (:PIDIMOVELMESTRE IS NULL) OR (IDIMOVELMESTRE = :PIDIMOVELM' +
        'ESTRE) )'
      '   AND ( (:PIDIMOVEL IS NULL) OR (IDIMOVEL = :PIDIMOVEL) )'
      '   AND ( DATA_BAIXA BETWEEN :PDATAINI AND :PDATAFIM )'
      '   AND ( IDMODULO = 64 )'
      'GROUP BY'
      '   TO_CHAR(DATA_BAIXA, '#39'YYYYMM'#39')'
      'ORDER BY'
      '   TO_CHAR(DATA_BAIXA, '#39'YYYYMM'#39')'
      ''
      ' ')
    ValidateWithMask = True
    Left = 649
    Top = 211
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDIMOVELMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'PIDIMOVELMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'PIDIMOVEL'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'PIDIMOVEL'
        ParamType = ptUnknown
      end
      item
        DataType = ftDateTime
        Name = 'PDATAINI'
        ParamType = ptUnknown
      end
      item
        DataType = ftDateTime
        Name = 'PDATAFIM'
        ParamType = ptUnknown
      end>
    object qryCustoFinanceiroANOMESBAIXA: TStringField
      FieldName = 'ANOMESBAIXA'
      Size = 6
    end
    object qryCustoFinanceiroTOT_LANC: TFloatField
      FieldName = 'TOT_LANC'
    end
  end
