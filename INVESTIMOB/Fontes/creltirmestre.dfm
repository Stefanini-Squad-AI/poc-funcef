  object qryHistoricoCarteira: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   SUM(H.VLRMOVCARTINV) AS TOT_MOVIMENTO'
      'FROM'
      '   HISTCARTINV H'
      'WHERE'
      '   ( H.IDEMPRESAPROP =:EMPRESAPROP ) AND'
      '   ( H.IDTIPOINVEST = 3 ) AND'
      '   ( H.DATAMOVCARTINV =:DATA ) AND'
      '   ( H.IDMODULO = 64 ) AND'
      ''
      '   ( H.IDINVESTIMENTO IN'
      '      ('
      '      SELECT'
      '         IDIMOVEL'
      '      FROM'
      '         IMOVEL'
      '      WHERE'
      '         IDIMOVELMESTRE =:MESTRE'
      '      )'
      '')
    ValidateWithMask = True
    Left = 280
    Top = 216
    ParamData = <
      item
        DataType = ftInteger
        Name = 'EMPRESAPROP'
        ParamType = ptUnknown
      end
      item
        DataType = ftDateTime
        Name = 'DATA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MESTRE'
        ParamType = ptUnknown
      end>
  end
  object qryTirEfetiva: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      
        '   DECODE(RTRIM(LD.OPERACAO), '#39'5'#39', DECODE(D.RECPAG, '#39'R'#39', LD.VALO' +
        'R, 0), 0) AS TOT_RECEB,'
      
        '   DECODE(RTRIM(LD.OPERACAO), '#39'5'#39', DECODE(D.RECPAG, '#39'P'#39', LD.VALO' +
        'R, 0), 0) AS TOT_PAG'
      'FROM'
      '   HISTCARTINV H, DOCUMENTO D, LANCTODOCUM LD'
      'WHERE'
      '   ('
      '   ( H.IDEMPRESAPROP =:EMPRESAPROP )'
      '   AND ( H.IDTIPOINVEST = 3 )'
      '   AND ( H.IDMODULO = 64 )'
      '   AND ( LD.DATALANCTO =:DATA )'
      '   AND ( H.IDINVESTIMENTO IN'
      '         ('
      '         SELECT'
      '            IDIMOVEL'
      '         FROM'
      '            IMOVEL'
      '         WHERE'
      '            IDIMOVELMESTRE =:MESTRE'
      '         )'
      '       )'
      '   )'
      '   AND'
      '   ('
      '   ( H.CODDOCUMENTO = D.CODDOCUMENTO )'
      '   AND ( D.CODDOCUMENTO = LD.CODDOCUMENTO )'
      '   )')
    ValidateWithMask = True
    Left = 112
    Top = 256
    ParamData = <
      item
        DataType = ftInteger
        Name = 'EMPRESAPROP'
        ParamType = ptUnknown
      end
      item
        DataType = ftDateTime
        Name = 'DATA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MESTRE'
        ParamType = ptUnknown
      end>
    object qryTirEfetivaTOT_RECEB: TFloatField
      FieldName = 'TOT_RECEB'
    end
    object qryTirEfetivaTOT_PAG: TFloatField
      FieldName = 'TOT_PAG'
    end
  end
  object qryTirPrevista: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      
        '   SUM(DECODE(H.RECPAG, '#39'R'#39', ABS(H.VLRMOVCARTINV), 0) ) AS TOT_R' +
        'ECEB,'
      
        '   SUM(DECODE(H.RECPAG, '#39'P'#39', ABS(H.VLRMOVCARTINV), 0) ) AS TOT_P' +
        'AG'
      'FROM'
      '   HISTCARTINV H'
