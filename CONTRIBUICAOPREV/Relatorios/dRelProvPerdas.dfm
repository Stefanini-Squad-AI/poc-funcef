  object dsRelProvPerdas: TwwDataSource
    DataSet = qryRelProvPerdas
    Left = 240
    Top = 160
  end
  object qryRelProvPerdas: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT TO_CHAR(PROV.IDPROVPERDASCONTRIB) AS IDPROVPERDASCONTRIB,'
      '       EL.MATRICULA,'
      '       TO_CHAR(IDPESSOA) AS IDPESSOA,'
      '       P.NOME AS NOMEPESSOA,'
      '       TO_CHAR(PROV.IDPLANOPREVCONTAB) AS IDPLANOPREVCONTAB,'
      '       PLPREVC.NOME AS NOMEPLANOPREVCONTAB,'
      '       PROV.MESREFERENCIA,'
      '       PROV.VALORINADIMPLENCIA AS VALORINADIMPLENCIA,'
      '       PROV.DATAPRIMEIRAINADIMPLENCIA,'
      '       PROV.PERCENTUALPROVISAO,'
      
        '       CASE WHEN PROV.FLGREVERSAO = 1 THEN (PROV.VALORPROVISAO *' +
        ' -1) ELSE PROV.VALORPROVISAO END AS VALORPROVISAO,'
      '       TO_CHAR(PROV.QTDEDIASATRASO) AS QTDEDIASATRASO,'
      '       TO_CHAR(PROV.IDCONTRIBUICAO) AS IDCONTRIBUICAO,'
      '       CONTRIB.NOME AS NOMECONTRIBUICAO,'
      '       TO_CHAR(EL.IDSITFUNC) AS IDSITFUNC,'
      '       SITF.DESCRICAO AS DESCSITFUNC,'
      '       TO_CHAR(PROV.PLNCODIGO) AS PLNCODIGO,'
      '       SUM('
      
        '           CASE WHEN FLGREVERSAO = 1 THEN 0 ELSE  PROV.VALORINAD' +
        'IMPLENCIA END'
      '       ) OVER() AS VALORTOTINAD,'
      '       SUM('
      
        '           CASE WHEN FLGREVERSAO = 1 THEN 0 ELSE  PROV.VALORPROV' +
        'ISAO END'
      '       ) OVER() AS VALORTOTPROV,'
      '       TO_CHAR(PROV.TRGDTINCLUSAO, '#39'DD/MM/YYYY'#39') AS DATAPROVISAO'
      ''
      '  FROM PROVISAOPERDASCONTRIBUICAO PROV'
      ''
      '  LEFT JOIN ELEGPATRO EL'
      '    ON EL.IDPESSOA = PROV.IDPESSOA'
      '   AND EL.IDPESSJUR = PROV.IDPESSJUR'
      ''
      ' INNER JOIN PESSOA P'
      '    ON P.IDPESSOA = PROV.IDPESSOA'
      ''
      ' INNER JOIN PLANPREVCONTABIL PLPREVC'
      '    ON PLPREVC.IDPLANOPREV = PROV.IDPLANOPREVCONTAB'
      ''
      ' INNER JOIN CONTRIBUICAO CONTRIB'
      '    ON CONTRIB.IDCONTRIBUICAO = PROV.IDCONTRIBUICAO'
      ''
      '  LEFT JOIN SITFUNC SITF'
      '    ON SITF.IDSITFUNC = EL.IDSITFUNC'
      'WHERE 1 = 2')
    UpdateObject = UpdateRel
    ValidateWithMask = True
    Left = 240
    Top = 104
