    Left = 408
    Top = 108
  end
  object qryDet: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT C.IDCONTRIBUICAO, C.NOME, CN.DATAINICIO, CN.DATAFINAL, CN' +
        '.FLGCOBRA, CN.ULTMESPREPARO,'
      '               CN.IDNUCLEOFAMILIAR,'
      '              0 AS IDPLANPREVCONTAB,'
      '              0 AS IDPESSOA,'
      '              0 AS PLANO,'
      '              0 AS IDPLANOPREV,'
      '              0 AS IDBENEFICIO,'
      '              0 AS NUMEROPROCESSO,'
      '              0 AS IDPESSJUR,'
      '              0 AS IDTITULAR,'
      '              0 AS IDPLANOORIGEM,'
      '              0 AS SEQPROPOSTA'
      'FROM CONTRIBUICAO C, CONTRIBPREVNUCLEO CN'
      'WHERE CN.IDNUCLEOFAMILIAR = :IDNUCLEOFAMILIAR'
      
        '     AND (CN.IDPLANOPREV = :IDPLANOPREV OR CN.IDPLANOPREV IS NUL' +
        'L)'
      'AND CN.IDCONTRIBUICAO = C.IDCONTRIBUICAO')
    UpdateObject = updDet
    ControlType.Strings = (
      'FLGCOBRA;CheckBox;1;0')
    ValidateWithMask = True
    Left = 470
    Top = 4
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDNUCLEOFAMILIAR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end>
  end
  object updDet: TUpdateSQL
    ModifySQL.Strings = (
      'update CONTRIBPREVNUCLEO'
      'set'
      '  DATAINICIO = :DATAINICIO,'
      '  DATAFINAL = :DATAFINAL,'
      '  ULTMESPREPARO = :ULTMESPREPARO,'
      '  FLGCOBRA = :FLGCOBRA'
      'where'
      '  IDCONTRIBUICAO = :OLD_IDCONTRIBUICAO and'
      '  IDNUCLEOFAMILIAR = :OLD_IDNUCLEOFAMILIAR')
    InsertSQL.Strings = (
      'insert into CONTRIBPREVNUCLEO'
      '  (IDCONTRIBUICAO, IDNUCLEOFAMILIAR, DATAINICIO, DATAFINAL, '
      'ULTMESPREPARO, '
      '   FLGCOBRA,'
      'IDPLANPREVCONTAB, IDPESSOA, PLANO, IDPLANOPREV, IDBENEFICIO, '
      
        'NUMEROPROCESSO, IDPESSJUR, IDTITULAR, IDPLANOORIGEM, SEQPROPOSTA' +
        ')'
      'values'
      '  (:IDCONTRIBUICAO, :IDNUCLEOFAMILIAR, :DATAINICIO, :DATAFINAL, '
      ':ULTMESPREPARO, '
      '   :FLGCOBRA,'
      
        ':IDPLANPREVCONTAB, :IDPESSOA, :PLANO, :IDPLANOPREV, :IDBENEFICIO' +
        ', '
      
        ':NUMEROPROCESSO, :IDPESSJUR, :IDTITULAR, :IDPLANOORIGEM, :SEQPRO' +
        'POSTA)')
    DeleteSQL.Strings = (
      'delete from CONTRIBPREVNUCLEO'
      'where'
      '  IDCONTRIBUICAO = :OLD_IDCONTRIBUICAO and'
      '  IDNUCLEOFAMILIAR = :OLD_IDNUCLEOFAMILIAR')
    Left = 528
    Top = 4
  end
  object qryContribInserir: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT * FROM'
      '(SELECT BT.IDCONTRIBUICAO, -- V_IDNUCLEOFAMILIAR,'
      '       C.NOME AS NOMECONTRIBUICAO,'
      
        '       GREATEST(BF.DATAINICIO, NVL(CP.DATAINICIOPADRAO, BF.DATAI' +
        'NICIO)) DATAINICIO,'
      '       BF.DATAINICIO AS DATAINICIOBENEFBCIARIO,'
      '       NVL(C.IDTPCONTRIBUICAO, 0) AS IDTPCONTRIBUICAO,'
      
        '       LEAST(NVL(BF.DATAFINAL,CP.DATAFIMPADRAO), NVL(CP.DATAFIMP' +
        'ADRAO, BF.DATAFINAL)) DATAFINAL,'
      '       NULL ULTMESPREPARO,'
      '       0 FLGCOBRA,'
      '       BF.IDPLANPREVCONTAB,'
      '       BF.IDPESSOA,'
      '       CP.PLANO,'
      '       BF.IDPLANOPREV,'
      '       BF.IDBENEFICIO,'
      '       BF.NUMEROPROCESSO,'
      '       BF.IDPESSJUR,'
      '       BF.IDTITULAR,'
      '       BF.IDPLANOORIGEM,'
      '       BF.SEQPROPOSTA,'
      '       BF.IDSITBENEFICIO'
      '  FROM BENEFBFCIARIO BF'
      '  JOIN BENEFXTAXA BT'
      '    ON BF.IDBENEFICIO = BT.IDBENEFICIO'
      '  JOIN CONTRIBUICAO C'
      '    ON BT.IDCONTRIBUICAO = C.IDCONTRIBUICAO'
      '  JOIN CONTPREV CP'
      '    ON CP.IDCONTRIBUICAO = BT.IDCONTRIBUICAO'
      '   AND CP.IDPLANOPREV = BF.IDPLANOPREV'
      '  JOIN BFCIARIOTITPLAN BFTITP'
      '    ON BFTITP.IDPLANOPREV = BF.IDPLANOPREV'
      '   AND BFTITP.IDPESSJUR = BF.IDPESSJUR'
      '   AND BFTITP.IDTITULAR = BF.IDTITULAR'
      '   AND BFTITP.IDPLANOORIGEM = BF.IDPLANOORIGEM'
      '   AND BFTITP.IDPESSOA = BF.IDPESSOA'
      '   AND BFTITP.SEQPROPOSTA = BF.SEQPROPOSTA'
      '   AND BFTITP.IDBENEFICIO = BF.IDBENEFICIO'
      ' WHERE BF.IDPLANOPREV = :IDPLANOPREV'
      '   AND BF.IDPESSJUR = :IDPESSJUR'
      '   AND BF.IDTITULAR = :IDTITULAR'
      '   AND BF.IDPLANOORIGEM = :IDPLANOORIGEM'
      '   AND BF.IDPESSOA = :IDPESSOA'
      '   AND BF.SEQPROPOSTA = :SEQPROPOSTA'
      '   AND BF.FONTEPAGADORA = 1'
      '   AND NOT EXISTS (SELECT 1 FROM CONTRIBPREVNUCLEO CN'
      '                  WHERE CN.IDCONTRIBUICAO = CP.IDCONTRIBUICAO'
      
        '                    AND CN.IDNUCLEOFAMILIAR = BFTITP.IDNUCLEOFAM' +
        'ILIAR))'
      '                    '
      
        'WHERE ((IDTPCONTRIBUICAO = 1 AND IDSITBENEFICIO IN (1,2) AND SYS' +
        'DATE < DATAFINAL)'
      
        '  OR (IDTPCONTRIBUICAO = 1 AND IDSITBENEFICIO = 3 AND DATAFINAL ' +
        '> SYSDATE)'
      '  OR IDTPCONTRIBUICAO <> 1)'
      '')
    ControlType.Strings = (
      'FLGCOBRA;CheckBox;1;0')
    ValidateWithMask = True
    Left = 470
    Top = 308
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDTITULAR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPLANOORIGEM'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'SEQPROPOSTA'
        ParamType = ptUnknown
      end>
