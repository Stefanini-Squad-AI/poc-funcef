  inherited qry: TwwQuery
    SQL.Strings = (
      
        'SELECT DISTINCT N.IDRESPNUCLEO, PRESP.NOME AS RESPONSAVEL, PPART' +
        '.NOME AS PARTICIPANTE,'
      
        '                EL.MATRICULA, PP.INSCRICAONUMERO, PL.NOME, PPATR' +
        'O.NOME AS PATROCINADORA,'
      
        '                BF.IDPLANOPREV, BF.IDPESSJUR, BF.IDTITULAR, BF.I' +
        'DPLANOORIGEM, BF.IDPESSOA,'
      '                BF.SEQPROPOSTA'
      
        'FROM  NUCLEOFAMILIAR N, PESSOA PRESP, PESSOA PPART, PESSOA PPATR' +
        'O, PLANPREV PL,'
      '      ELEGPATRO EL, PARTPREVPLAN PP, BFCIARIOTITPLAN BF'
      'WHERE BF.IDPESSJUR      = :IDPESSJUR'
      'AND   BF.IDPLANOPREV  = :IDPLANOPREV'
      'AND   BF.IDTITULAR      = :IDTITULAR'
      'AND   BF.SEQPROPOSTA    = :SEQPROPOSTA'
      'AND   BF.IDNUCLEOFAMILIAR = :IDNUCLEOFAMILIAR'
      'AND   BF.IDPESSJUR      = PP.IDPESSJUR'
      'AND   BF.IDPLANOORIGEM  = PP.IDPLANOPREV'
      'AND   BF.IDTITULAR      = PP.IDPESSOA'
      'AND   BF.SEQPROPOSTA    = PP.SEQPROPOSTA'
      'AND   EL.IDPESSJUR      = PP.IDPESSJUR'
      'AND   EL.IDPESSOA       = PP.IDPESSOA'
      'AND   N.IDNUCLEOFAMILIAR = BF.IDNUCLEOFAMILIAR'
      'AND   PRESP.IDPESSOA    = N.IDRESPNUCLEO'
      'AND   PPART.IDPESSOA    = EL.IDPESSOA'
      'AND   PPATRO.IDPESSOA   = EL.IDPESSJUR'
      'AND   PL.IDPLANOPREV    = BF.IDPLANOPREV'
      ''
      ' ')
    Left = 331
    Top = 2
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDTITULAR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'SEQPROPOSTA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDNUCLEOFAMILIAR'
        ParamType = ptUnknown
      end>
  end
