  object qryTpResgate: TQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'with'
      'tab1 as ('
      
        'select 0 as seqresgate, sysdate as datainicio, -1 as idbeneficio' +
        ', '#39'Valor Retido'#39' as descricao, 1 as existe'
      'from dual) ,'
      'tab2 as ('
      'SELECT P.SEQRESGATE, BF.DATAINICIO,'
      '       bf.idbeneficio,'
      
        '       DECODE(COALESCE(P.SEQRESGATE,1), 1, '#39'Resgate das Contribu' +
        'ições'#39','
      
        '                                           '#39'Resgate Complementar' +
        #39') || '#39' - '#39'|| TO_CHAR(BF.DATAINICIO, '#39'DD/MM/YYYY'#39') AS DESCRICAO'
      '       , 1 as existe'
      '  FROM BENEFBFCIARIO BF'
      '  JOIN BENEFICIO B ON B.IDBENEFICIO = BF.IDBENEFICIO'
      '  JOIN PROCESSOBENEF P ON P.NUMEROPROCESSO = BF.NUMEROPROCESSO'
      '                      AND P.SEQRESGATE IS NOT NULL'
      ' WHERE BF.IDPESSOA    = :IDPESSOA'
      '   AND BF.IDPLANOPREV = :IDPLANOPREV'
      '   AND BF.IDPESSJUR   = :IDPESSJUR'
      '   group by P.SEQRESGATE, BF.DATAINICIO, bf.idbeneficio'
      'union'
      
        'select h.SEQRESGATE, MAX(h.DATARECEBIMENTO) AS DATAINICIO, -1 as' +
        ' idbeneficio , '#39'Resgate Judicial'#39' as descricao, 1 as existe'
      '  from histmovreserva h'
      ' WHERE h.IDPESSOA    = :IDPESSOA'
      '   AND h.IDPLANOPREV = :IDPLANOPREV'
      '   AND h.IDPESSJUR   = :IDPESSJUR'
      '   AND h.idcontribuicao in (729,730)'
      '   AND h.seqresgate is not null'
      ' GROUP BY h.seqresgate, idbeneficio'
      ')'
      
        'select * from tab1 where exists (select * from tab2 where  tab1.' +
        'existe = tab2.existe)'
      'union'
      'select * from tab2'
      ''
      ' '
      ' '
      ' ')
    Left = 972
    Top = 64
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end>
  end
