  object qryTmpDesc: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT TMP.MESREFERENCIA,TMP.IDPESSJUR,TMP.IDPLANOPREV,TMP.IDPES' +
        'SOA,'
      
        '              TMP.SEQPROPOSTA,TMP.MATRICULA,TMP.IDDESCONTO,TMP.I' +
        'DPROVENTO,'
      
        '              TMP.IDMOTIVO,TMP.VALOR,TMP.VALORRECEBIDO,TMP.CODPR' +
        'OVDESC,'
      
        '              TMP.DESCRICAO,TMP.DATARECEBIMENTO,TMP.MESCOBRANCA,' +
        'PAT.FLGACEITANAOID'
      'FROM   TMPDESC TMP, PATRO PAT'
      'WHERE  TMP.MESCOBRANCA = :SMESREF'
      'AND TMP.MESREFERENCIA = :SMESREF1'
      'AND PAT.IDFUNDACAO = :IDFUNDACAO'
      'AND TMP.IDPESSOA IS NULL'
      'AND TMP.IDPLANOPREV IS NULL'
      'AND PAT.IDPESSOA=TMP.IDPESSJUR'
      'AND PAT.FLGACEITANAOID=1'
      'AND TMP.SITENVIO IN ('#39'1'#39','#39'2'#39')'
      'ORDER BY TMP.MATRICULA'
      ' '
      ' ')
    UpdateObject = UpdateSQL2
    ValidateWithMask = True
    Left = 432
    Top = 24
    ParamData = <
      item
        DataType = ftString
        Name = 'SMESREF'
        ParamType = ptUnknown
        Value = '-1'
      end
      item
        DataType = ftString
        Name = 'SMESREF1'
        ParamType = ptUnknown
        Value = '-1'
      end
      item
        DataType = ftInteger
        Name = 'IDFUNDACAO'
        ParamType = ptUnknown
      end>
  end
  object dsTmpDesc: TwwDataSource
    DataSet = qryTmpDesc
    Left = 464
    Top = 24
  end
  object qryIncons: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  I.ANOMESREF,I.ANOMESCOB,I.TIPOOP,I.FLGTIPODESC,'
      '        I.IDPESSJUR,I.IDPLANOPREV,I.IDPESSOA,I.SEQPROPOSTA,'
      '        I.MATRICULA,I.IDDESCONTO,I.IDPROVENTO,I.CODPROVDESC,'
      '        I.IDMOTIVO,I.VALORESPERADO,I.VALORRECEBIDO'
      '        ,'#39'                                       '#39' AS DESCRICAO'
      'FROM    INCONSISTINTERF I, PATRO PT'
      'WHERE   PT.IDFUNDACAO = :IDFUNDACAO'
      'AND     PT.IDPESSOA = I.IDPESSJUR'
      'ORDER BY I.MATRICULA'
      ' ')
    UpdateObject = UpdateSQL1
    ValidateWithMask = True
    Left = 320
    Top = 24
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDFUNDACAO'
        ParamType = ptUnknown
      end>
  end
  object dsIncons: TwwDataSource
    DataSet = qryIncons
    Left = 352
    Top = 24
  end
