  object UpdateSQL1: TUpdateSQL
    ModifySQL.Strings = (
      'update INCONSISTINTERF'
      'set'
      '  ANOMESREF = :ANOMESREF,'
      '  ANOMESCOB = :ANOMESCOB,'
      '  TIPOOP = :TIPOOP,'
      '  FLGTIPODESC = :FLGTIPODESC,'
      '  IDPESSJUR = :IDPESSJUR,'
      '  IDPLANOPREV = :IDPLANOPREV,'
      '  IDPESSOA = :IDPESSOA,'
      '  SEQPROPOSTA = :SEQPROPOSTA,'
      '  MATRICULA = :MATRICULA,'
      '  IDDESCONTO = :IDDESCONTO,'
      '  IDPROVENTO = :IDPROVENTO,'
      '  CODPROVDESC = :CODPROVDESC,'
      '  IDMOTIVO = :IDMOTIVO,'
      '  VALORESPERADO = :VALORESPERADO,'
      '  VALORRECEBIDO = :VALORRECEBIDO')
    InsertSQL.Strings = (
      'insert into INCONSISTINTERF'
      '  (ANOMESREF, ANOMESCOB, TIPOOP, FLGTIPODESC, IDPESSJUR, '
      'IDPLANOPREV, IDPESSOA, '
      '   SEQPROPOSTA, MATRICULA, IDDESCONTO, IDPROVENTO, CODPROVDESC, '
      'IDMOTIVO, '
      '   VALORESPERADO, VALORRECEBIDO)'
      'values'
      '  (:ANOMESREF, :ANOMESCOB, :TIPOOP, :FLGTIPODESC, :IDPESSJUR, '
      ':IDPLANOPREV, '
      
        '   :IDPESSOA, :SEQPROPOSTA, :MATRICULA, :IDDESCONTO, :IDPROVENTO' +
        ', '
      ':CODPROVDESC, '
      '   :IDMOTIVO, :VALORESPERADO, :VALORRECEBIDO)')
    DeleteSQL.Strings = (
      'delete from INCONSISTINTERF'
      '')
    Left = 384
    Top = 24
  end
  object UpdateSQL2: TUpdateSQL
    Left = 496
    Top = 24
  end
