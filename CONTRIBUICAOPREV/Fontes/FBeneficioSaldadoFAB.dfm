  object qryHistorico: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'SELECT H.IDPESSOA, H.IDTITULAR,'
      
        '   Decode(H.TIPO,'#39'A'#39','#39'Alteração'#39','#39'E'#39','#39'Exclusão'#39','#39'R'#39','#39'EXCLUSÃO - ' +
        'REPROCESSAMENTO'#39') TIPO, '
      '       H.CAMPO, H.VALORANTERIOR, '
      '     H.VALORALTERADO, H.MESREFERENCIA, H.TRIGGERDTINCLUSAO,'
      '      H.TRIGGERUSERINCLUSAO,  P.NOME, D.MATRICULA'
      '  FROM HSTALTBENEFSALDFAB H, DEPENTIT D, PESSOA P'
      ' WHERE  H.IDPESSOA = :IDPESSOA'
      '    AND H.IDTITULAR = :IDTITULAR'
      '    AND P.IDPESSOA = H.IDPESSOA'
      '    AND D.IDPESSOA = H.IDPESSOA'
      '    AND D.IDTITULAR = H.IDTITULAR'
      'ORDER BY TRIGGERDTINCLUSAO ASC'
      '')
    UpdateObject = updHistorico
    ValidateWithMask = True
    Left = 425
    Top = 256
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDTITULAR'
        ParamType = ptUnknown
      end>
