  object qryBS_FAB2: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'SELECT'
      '  P.NOME, '
      '  E.MATRICULA, '
      ' cm.pck_benefsaldfab.fn_TipoEleg(c.idpessoa) TipoElege,'
      '  cm.pck_benefsaldfab.fn_DataEleg(c.idpessoa) DataElege,'
      
        '  (select distinct first_value(b.saldofab) over (order by b.mesr' +
        'eferencia desc, b.idbenefsaldfab desc)'
      '    from benefsaldfab b '
      '    where b.idpessoa = c.idpessoa'
      '          and b.idtitular = c.idtitular) saldoatual,'
      '  C.SALPART SALPART,'
      '  C.BENEFICIOSALDADO BFSALD2006,'
      
        '  (select distinct first_value(b.benefsaldado) over (order by b.' +
        'mesreferencia desc, b.idbenefsaldfab desc)'
      '   from benefsaldfab b '
      '   where b.idpessoa = c.idpessoa'
      '         and b.idtitular = c.idtitular) SALDOATUALIZADO'
      'FROM CARGABENEFSALDFAB C'
      'inner join PESSOA P on p.idpessoa = c.idpessoa '
      'inner join ELEGPATRO E on e.idpessoa = c.idpessoa'
      'WHERE C.IDPESSOA = :idpessoa and'
      '      C.IDTitular = :idtitular'
      ' ')
    ValidateWithMask = True
    Left = 907
    Top = 352
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDTITULAR'
        ParamType = ptInput
      end>
