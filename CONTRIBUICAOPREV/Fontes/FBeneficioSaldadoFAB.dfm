  object qryBenefSaldado: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'SELECT '
      '  b.mesreferencia,   '
      '  b.valorindice,'
      '  b.indice Referencia_indice,'
      '  b.indiceacumulado,'
      '  b.benefsaldado,'
      '  b.saldofab  '
      'from benefsaldfab b'
      ' WHERE b.idpessoa = :IDPESSOA'
      'and b.idtitular = :IDTITULAR'
      'order by b.mesreferencia, b.indice desc, b.idbenefsaldfab')
