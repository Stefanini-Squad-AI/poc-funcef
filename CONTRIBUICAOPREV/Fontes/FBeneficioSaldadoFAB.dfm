  object qryRelDemosSald: TwwQuery
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'SELECT C.IDCARGABENEFSALDFAB,'
      '       C.IDCARGAARQUIVO,'
      '       C.IDPESSOA,'
      '       C.IDTITULAR,'
      '       C.DATASALDAMENTO,'
      '       C.DATAIMPORTACAO,'
      '       C.PCS,'
      '       C.NOMECARGO,'
      '       C.VALORCARGO,'
      '       C.PERCENTATS,'
      '       C.VALORATS,'
      '       C.VPGRATSEMADICTEMPSERV,'
      '       C.VPGIPTEMPOSERV,'
      '       C.VPGIPSEMSALCOMFUNC,'
      '       C.VPEXBH,'
      '       C.ADICCOMP,'
      '       C.ADICINCORP,'
      '       C.ADICNOTURNO,'
      '       C.ADICINSALU,'
      '       C.ADICPERI,'
      '       C.INCORPJUD,'
      '       C.COMPSALPADRAO,     '
      '       C.NOMECARGOCOMIS,'
      '       C.VALORCARGOCOMIS,'
      '  C.CODCARGOCOMIS,       '
      
        '       CM.pck_benefsaldfab.fn_SalPartCorrigido(c.IdPessoa) SalPa' +
        'rt,'
      
        '       CM.pck_benefsaldfab.fn_CalculaBS(c.IdPessoa) BENEFICIOSAL' +
        'DADO,'
      '       C.PERCENTPBE,'
      '       CM.pck_benefsaldfab.fn_BINSS(c.idpessoa) BINSS,       '
      '       C.ULTIMOMESPROC,'
      '       C.DATAELEGIBILIDADE,'
      '       C.TRIGGERUSERINCLUSAO,'
      '       C.TRIGGERDTINCLUSAO,'
      '       P.NOME,'
      '       E.MATRICULA,'
      '       PP.NOME PLANO,'
      '       PF.DATANASC,'
      '       CM.pck_benefsaldfab.fn_IdadeIniContrib(c.IdPessoa) IDADE,'
      '       BF.DATAINICIOFUND,'
      '       BF.IDBENEFICIO,'
      '       CM.pck_benefsaldfab.fn_IDC(c.idpessoa) IDADESALD,'
      '       CM.pck_benefsaldfab.fn_TS(c.idpessoa) TS,'
      '       CM.pck_benefsaldfab.fn_I(c.idpessoa) I,'
      
        '       CM.pck_benefsaldfab.fn_PercCorrecaoSalPart PercCorrecaoSa' +
        'lPart,'
      '       CM.pck_benefsaldfab.fn_PercCorrecaoBS PercCorrecaoBS,'
      '       C.SALPART SALPART2006,'
      '       BENEFSLD.BENEFSALDADOINSS,'
      '       BENEFSLD.SALDOFABINSS'
      '       '
      ''
      '  FROM CARGABENEFSALDFAB C'
      ' inner join PESSOA P'
      '    on p.idpessoa = c.idpessoa'
      ' inner join ELEGPATRO E'
      '    on e.idpessoa = c.idpessoa'
      ' inner join PESSOAFISICA PF'
      '    on pf.idpessoa = p.idpessoa'
      ' inner join PARTPREVPLAN PT'
      '    on pt.idpessoa = e.idpessoa'
      '   and pt.idpessjur = e.idpessjur'
      ' inner join PLANPREV PP'
      '    on pp.idplanoprev = pt.idplanoprev'
      '  left join BENEFBFCIARIO BF'
      '    on BF.FONTEPAGADORA = 2'
      '   AND BF.IDSITBENEFICIO = 1'
      '   and BF.IDPESSOA = e.IDPESSOA'
      
        ' LEFT JOIN (SELECT B.IDPESSOA,B.IDTITULAR,B.BENEFSALDADOINSS,B.S' +
        'ALDOFABINSS,B.MESREFERENCIA '
      '  from BENEFSALDFAB B where B.IDPESSOA = :IDPESSOA '
      '  and B.IDTITULAR = :IDTITULAR'
      
        '  and B.IDBENEFSALDFAB = (SELECT MAX(BM.IDBENEFSALDFAB) FROM BEN' +
        'EFSALDFAB BM'
      
        '  WHERE BM.IDPESSOA = B.IDPESSOA AND BM.IDTITULAR = B.IDTITULAR ' +
        'AND BM.MESREFERENCIA ='
      '  (SELECT MAX(BM.MESREFERENCIA) FROM BENEFSALDFAB BMA'
      
        '  WHERE BMA.IDPESSOA = BM.IDPESSOA AND BMA.IDTITULAR = BM.IDTITU' +
        'LAR))) BENEFSLD '
      
        '  ON BENEFSLD.IDPESSOA = C.IDPESSOA AND BENEFSLD.IDTITULAR = C.I' +
        'DTITULAR'
      ' WHERE c.idpessoa = :idpessoa'
      '   and c.IDTitular = :idtitular'
      '   and pt.idplanoprev = 2')
    ValidateWithMask = True
    Left = 655
    Top = 321
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDTITULAR'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'idpessoa'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'idtitular'
        ParamType = ptInput
      end>
