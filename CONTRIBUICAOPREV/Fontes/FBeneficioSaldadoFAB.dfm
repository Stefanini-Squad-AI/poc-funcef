  object qryDesfazer: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      '  SELECT B.IDTITULAR, B.IDPESSOA,  C.IDCARGAARQUIVO'
      '  FROM CARGABENEFSALDFAB C, BENEFSALDFAB B'
      '  WHERE C.IDCARGAARQUIVO = B.IDCARGAARQUIVO'
      '  AND B.IDPESSOA  =  C.IDPESSOA '
      '  AND B.IDTITULAR =  C.IDTITULAR'
      '    AND C.IDPESSOA = :IDPESSOA'
      '    AND C.IDTITULAR = :IDTITULAR'
      ' group by  B.IDTITULAR, B.IDPESSOA,  C.IDCARGAARQUIVO')
    ValidateWithMask = True
    Left = 312
    Top = 273
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDTITULAR'
        ParamType = ptUnknown
      end>
    object qryDesfazerIDTITULAR: TFloatField
      FieldName = 'IDTITULAR'
      Origin = 'BASEDADOS.BENEFSALDFAB.IDTITULAR'
    end
    object qryDesfazerIDPESSOA: TFloatField
      FieldName = 'IDPESSOA'
      Origin = 'BASEDADOS.BENEFSALDFAB.IDPESSOA'
    end
    object qryDesfazerIDCARGAARQUIVO: TFloatField
      FieldName = 'IDCARGAARQUIVO'
      Origin = 'BASEDADOS.CARGABENEFSALDFAB.IDCARGAARQUIVO'
    end
  end
  object updHistorico: TUpdateSQL
    InsertSQL.Strings = (
      'insert into CM.HSTALTBENEFSALDFAB'
      '  (IDHSTALTBENEFSALDFAB, IDPESSOA, IDTITULAR, TIPO, CAMPO, '
      'VALORANTERIOR, '
      '   VALORALTERADO, MESREFERENCIA)'
      'values'
      '  (SEQHSTALTBENEFSALDFAB.NEXTVAL, :IDPESSOA, :IDTITULAR, :TIPO, '
      ':CAMPO, :VALORANTERIOR, '
      '   :VALORALTERADO, :MESREFERENCIA)')
    Left = 424
    Top = 368
  end
  object qryCalculoIndiceIdadeSald: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      ''
      'SELECT 1 as Linha, -- Andre Imakawa - SIG 22419'
      '      CASE'
      '         WHEN IDADECOMPARATIVA > 18 THEN'
      '           18'
      '         ELSE'
      '           TMP2.IDADECOMPARATIVA'
      '       END IDADEDIBINSS,'
      '       TMP2.COMPLEMENTAIDADE TS,'
      '       MATRICULA,'
      ''
      '       -- SIG 23223 INICIO'
      '       CASE'
      '         WHEN (IDADECOMPARATIVA) < 18 THEN'
      
        '            DECODE(SIGN(TMP2.COMPLEMENTAIDADE - (TMP2.IDADESALDA' +
        'MENTOSEXO - TMP2.IDADECOMPARATIVA)), -1, 1,'
      
        '                        TMP2.COMPLEMENTAIDADE - (TMP2.IDADESALDA' +
        'MENTOSEXO - TMP2.IDADECOMPARATIVA))'
      '         ELSE'
      
        '            DECODE(SIGN(DECODE(TMP2.SEXO, '#39'M'#39', 53, 48) - IDADESA' +
        'LDAMENTOSEXO), -1, 1,'
      
        '                        DECODE(TMP2.SEXO, '#39'M'#39', 53, 48) - IDADESA' +
        'LDAMENTOSEXO)'
      '       END  INDICE,'
      ''
      ''
      '       -- SIG 21889 INICIO'
      
        '       /*DECODE(SIGN(TMP2.COMPLEMENTAIDADE - (TMP2.IDADESALDAMEN' +
        'TOSEXO - TMP2.IDADECOMPARATIVA)), -1, 1,'
      
        '                   TMP2.COMPLEMENTAIDADE - (TMP2.IDADESALDAMENTO' +
        'SEXO - TMP2.IDADECOMPARATIVA)) AS INDICE,  */'
      '       -- SIG 23223 FIM'
      ''
      '       /*CASE'
      
        '         WHEN (TMP2.APOSENTADOINSS > 0) AND (IDADECOMPARATIVA) <' +
        ' 18 THEN'
      
        '              DECODE(SIGN(IDADECOMPARATIVA + TMP2.COMPLEMENTAIDA' +
        'DE - DECODE(TMP2.SEXO,'#39'M'#39',TMP2.IDADESALDAMENTOHOMEM,TMP2.IDADESA' +
        'LDAMENTOMULHER)), -1, 0,'
      
        '                          IDADECOMPARATIVA + TMP2.COMPLEMENTAIDA' +
        'DE - DECODE(TMP2.SEXO,'#39'M'#39',TMP2.IDADESALDAMENTOHOMEM,TMP2.IDADESA' +
        'LDAMENTOMULHER))'
      '         ELSE'
      
        '            DECODE(SIGN(DECODE(TMP2.SEXO, '#39'M'#39', 53, 48) - DECODE(' +
        'TMP2.SEXO,'#39'M'#39',TMP2.IDADESALDAMENTOHOMEM,TMP2.IDADESALDAMENTOMULH' +
        'ER)), -1, 0,'
      
        '                        DECODE(TMP2.SEXO, '#39'M'#39', 53, 48) - DECODE(' +
        'TMP2.SEXO,'#39'M'#39',TMP2.IDADESALDAMENTOHOMEM,TMP2.IDADESALDAMENTOMULH' +
        'ER))'
      '       END  INDICE, */'
      '       -- SIG 21889 FIM'
      ''
      ''
      '       TMP2.IDADESALDAMENTO,'
      
        '       DECODE(TMP2.TEMPOCONTRIBANOS,0,DECODE(TMP2.SEXO, '#39'M'#39', 53,' +
        ' 48),TMP2.TEMPOCONTRIBANOS) AS TEMPOCONTRIBANOS,'
      '       TMP2.SEXO,'
      '       TMP2.IDSITBENEFICIO'
      'FROM ('
      'SELECT MATRICULA,TMP.IDTITULAR,'
      '       TMP.FONTEPAGADORA ,'
      '       -- SIG 21889 INICIO'
      '       CASE'
      
        '         WHEN (TMP.SEXO = '#39'M'#39') AND (TMP.IDADESALDAMENTO > 53) TH' +
        'EN 53'
      
        '         WHEN (TMP.SEXO = '#39'F'#39') AND (TMP.IDADESALDAMENTO > 48) TH' +
        'EN 48'
      '         ELSE TMP.IDADESALDAMENTO'
      '       END IDADESALDAMENTOSEXO,     '
      '       /*END IDADESALDAMENTOHOMEM,'
      '       CASE'
      '            48'
      '         ELSE'
      '            TMP.IDADESALDAMENTO'
      '       END IDADESALDAMENTOMULHER, */'
      '       -- SIG 21889 FIM'
      
        '       NVL(TMP.IDADEDIBINSS - TMP.TEMPOCONTRIBANOS, 18) IDADECOM' +
        'PARATIVA,    -- Andre Imakawa - SIG 22419'
      '       TMP.APOSENTADOINSS,'
      '       TMP.SEXO,'
      '       TMP.IDEVENTOGERADOR,'
      '       TMP.IDADEDIBINSS,'
      '       TMP.IDADESALDAMENTO,'
      '       TMP.COMPLEMENTAIDADE,'
      '       TMP.TEMPOCONTRIBANOS,'
      '       TMP.IDSITBENEFICIO'
      'FROM'
      '( SELECT E.MATRICULA,'
      '--SOL 270929'
      
        '/*         TRUNC(((NVL(EV.DATAEVENTO, BFB.DATAINICIOFUND) - PF.D' +
        'ATANASC) / 365.2518),4) AS IDADEDIBINSS, */'
      
        '            TRUNC(((1900 + (extract(year from NVL(EV.DATAEVENTO,' +
        ' BFB.DATAINICIOFUND)) - 1900) +'
      
        '                          ((extract(month from NVL(EV.DATAEVENTO' +
        ', BFB.DATAINICIOFUND))- 1)/12) +'
      
        '                           (extract(day from NVL(EV.DATAEVENTO, ' +
        'BFB.DATAINICIOFUND))/365))'
      
        '                -  (1900 + (extract(year from PF.DATANASC)-1900)' +
        ' +'
      
        '                          ((extract(month from PF.DATANASC)- 1)/' +
        '12) +'
      '                           (extract(day from PF.DATANASC)/365))'
      '                   ),4)  AS IDADEDIBINSS,'
      '         --SOL 270929'
      '         /*'
      
        '         TRUNC(((NVL(DECODE(BFB.FONTEPAGADORA,2,EV.DATAEVENTO,NU' +
        'LL),DECODE(BFB.FONTEPAGADORA,2,BFB.DATAINICIOFUND,NULL)) - PF.DA' +
        'TANASC) / 365),4) AS IDADEDIBINSS,'
      
        '         TRUNC(((TO_DATE('#39'31/08/2006'#39','#39'DD/MM/YYYY'#39') - PF.DATANAS' +
        'C)/365),4) AS IDADESALDAMENTO,'
      
        '         round((2006.668 - (1900 + (extract(year from PF.DATANAS' +
        'C)-1900) + ((extract(month from PF.DATANASC)- 1)/12) + (extract(' +
        'day from PF.DATANASC)/365))),4) AS IDADESALDAMENTO,'
      '         */'
      '         --SOL 270929'
      '         round(( (2006 + (8-1)/12 + 31/365) - (1900 + '
      '                  (extract(year from PF.DATANASC)-1900) + '
      '                 ((extract(month from PF.DATANASC)- 1)/12) + '
      
        '                  (extract(day from PF.DATANASC)/365))),4) AS ID' +
        'ADESALDAMENTO,'
      '         --SOL 270929'
      '         '
      '         DECODE(PF.SEXO, '#39'M'#39', 35, 30) AS COMPLEMENTAIDADE,'
      '         /*'
      
        '         TRUNC(((((NVL(BFB.TEMPOSERVICOANOS, NVL(E.TEMPOSERVTOTA' +
        'L,0))* 365)) +'
      
        '         (NVL(BFB.TEMPOSERVICOMES, NVL(E.TEMPOSERVTOTMES,0))* 30' +
        ') +'
      
        '         NVL(BFB.TEMPOSERVICODIAS, NVL(E.TEMPOSERVTOTDIA,0)))/36' +
        '5),4) AS TEMPOCONTRIBANOS,'
      '        */'
      '        --SOL 270929'
      '        TRUNC(('
      '         (NVL(BFB.TEMPOSERVICOANOS, NVL(E.TEMPOSERVTOTAL,0))) +'
      
        '         (NVL(BFB.TEMPOSERVICOMES, NVL(E.TEMPOSERVTOTMES,0)) / 1' +
        '2) +'
      
        '         (NVL(BFB.TEMPOSERVICODIAS, NVL(E.TEMPOSERVTOTDIA,0)) / ' +
        '365)),4) AS TEMPOCONTRIBANOS,'
      '        --SOL 270929'
      '        '
      '         PF.SEXO,'
      '         BFB.IDTITULAR,'
      '         BFB.FONTEPAGADORA,'
      '         BFB.IDPLANOPREV,'
      '         BFB.IDPESSOA,'
      
        '         DECODE(BFB.FONTEPAGADORA,2,BFB.IDBENEFICIO,0) APOSENTAD' +
        'OINSS,'
      '         EV.DATAEVENTO,BFB.DATAINICIOFUND,PF.DATANASC ,'
      
        '         NVL(DECODE(BFB.FONTEPAGADORA,2,EV.DATAEVENTO,NULL),DECO' +
        'DE(BFB.FONTEPAGADORA,2,BFB.DATAINICIOFUND,NULL)) DataAposentador' +
        'ia,'
      
        '         DECODE(BFB.FONTEPAGADORA,2, EV.IDEVENTOGERADOR,0) AS ID' +
        'EVENTOGERADOR , BFB.IDSITBENEFICIO'
      '    FROM ELEGPATRO E'
      '         JOIN PESSOAFISICA PF ON PF.IDPESSOA = E.IDPESSOA'
      ''
      
        '         LEFT JOIN (SELECT EVP.IDPESSOA,/* EVP.IDPLANOPREV,*/ EV' +
        'P.IDEVENTOGERADOR, MAX(EVP.DATAEVENTO) DATAEVENTO -- Andre Imaka' +
        'wa - SIG 22419'
      '                 FROM EVENTOSPREV EVP'
      '                WHERE EVP.IDEVENTOGERADOR = 129'
      '                  AND EVP.DATAVOLTA IS NULL'
      
        '                GROUP BY EVP.IDPESSOA,/* EVP.IDPLANOPREV,*/ EVP.' +
        'IDEVENTOGERADOR -- Andre Imakawa - SIG 22419'
      '              ) EV ON EV.IDPESSOA = E.IDPESSOA'
      ''
      '         LEFT JOIN (SELECT BF.*'
      '                      FROM BENEFBFCIARIO BF'
      '                     WHERE EXISTS (SELECT 1  --B.IDTITULAR'
      '                                     FROM BENEFSALDFAB BSF1'
      
        '                                    WHERE BSF1.IDTITULAR = BF.ID' +
        'TITULAR'
      
        '                                      AND BSF1.MESREFERENCIA = '#39 +
        '2006/08'#39
      
        '                                      AND EXISTS (SELECT 1  -- I' +
        'DPESSOA'
      
        '                                                    FROM EVENTOS' +
        'PREV EVP'
      
        '                                                   WHERE EVP.IDP' +
        'ESSOA = BSF1.IDPESSOA'
      
        '                                                     AND EVP.IDP' +
        'ESSOA = BSF1.IDPESSOA'
      
        '                                                     AND (EVP.ID' +
        'EVENTOGERADOR IN (338,339))'
      
        '                                                     and exists ' +
        '(SELECT 1'
      
        '                                                                ' +
        '   FROM EVENTOSPREV EVP1'
      
        '                                                                ' +
        '  WHERE EVP1.IDPESSOA = EVP.IDPESSOA'
      
        '                                                                ' +
        '    AND EVP1.IDPESSJUR = EVP.IDPESSJUR  -- AJUSTE PERFORMANCE SI' +
        'G 19027'
      
        '                                                                ' +
        '    and EVP1.DATAVOLTA IS NULL'
      
        '                                                                ' +
        '    and EVP1.IDEVENTOGERADOR = 129 )'
      '                                                 )'
      '                                  )'
      '                       AND BF.IDSITBENEFICIO IN (1,2,3)'
      '                       AND BF.FONTEPAGADORA = 2'
      '                       AND BF.IDPLANOPREV   = 2'
      '                       AND BF.IDBENEFICIO   = 148'
      '                       AND BF.IDPESSOA = BF.IDTITULAR'
      '                       AND BF.DATAFINAL IS NULL'
      '                   ) BFB ON BFB.IDTITULAR = E.IDPESSOA'
      '                        AND BFB.IDPESSOA = EV.IDPESSOA'
      
        '                       -- AND BFB.IDPLANOPREV = EV.IDPLANOPREV -' +
        '- Andre Imakawa - SIG 22419'
      
        '                        AND BFB.IDPESSJUR = E.IDPESSJUR -- AJUST' +
        'E PERFORMANCE SIG 19027 -- AJUSTE PERFORMANCE SIG 19027'
      ''
      ''
      '  WHERE E.MATRICULA    = :MATRICULA'
      '  ) TMP'
      '  ) TMP2'
      ''
      'UNION ALL'
      ''
      'SELECT  2 as Linha, -- Andre Imakawa - SIG 22419'
      '         18 IDADEDIBINSS,'
      '       TMP2.COMPLEMENTAIDADE TS,'
      '       MATRICULA,'
      ''
      '       -- SIG 23223 INICIO'
      
        '       DECODE(SIGN(DECODE(TMP2.SEXO, '#39'M'#39', 53, 48) - IDADESALDAME' +
        'NTOSEXO), -1, 1,'
      
        '                   DECODE(TMP2.SEXO, '#39'M'#39', 53, 48) - IDADESALDAME' +
        'NTOSEXO) AS INDICE,'
      ''
      '       -- SIG 21889 INICIO'
      
        '       /*DECODE(SIGN(TMP2.COMPLEMENTAIDADE - (TMP2.IDADESALDAMEN' +
        'TOSEXO - TMP2.IDADECOMPARATIVA)), -1, 1,'
      
        '                   TMP2.COMPLEMENTAIDADE - (TMP2.IDADESALDAMENTO' +
        'SEXO - TMP2.IDADECOMPARATIVA)) AS INDICE,  */'
      '       -- SIG 23223 FIM'
      ''
      ''
      
        '       /*DECODE(SIGN(DECODE(TMP2.SEXO, '#39'M'#39', 53, 48) - DECODE(TMP' +
        '2.SEXO,'#39'M'#39',TMP2.IDADESALDAMENTOHOMEM,TMP2.IDADESALDAMENTOMULHER)' +
        '), -1, 0,'
      
        '                   DECODE(TMP2.SEXO, '#39'M'#39', 53, 48) - DECODE(TMP2.' +
        'SEXO,'#39'M'#39',TMP2.IDADESALDAMENTOHOMEM,TMP2.IDADESALDAMENTOMULHER)) ' +
        'AS INDICE, */'
      '       -- SIG 21889 FIM'
      ''
      '       TMP2.IDADESALDAMENTO,'
      
        '       DECODE(TMP2.TEMPOCONTRIBANOS,0,DECODE(TMP2.SEXO, '#39'M'#39', 53,' +
        ' 48),TMP2.TEMPOCONTRIBANOS) AS TEMPOCONTRIBANOS,'
      '       TMP2.SEXO,'
      '       0 IDSITBENEFICIO        '
      '      '
      'FROM ('
      'SELECT MATRICULA,TMP.IDTITULAR,'
      '       -- SIG 21889 INICIO'
      '       CASE'
      
        '         WHEN (TMP.SEXO = '#39'M'#39') AND (TMP.IDADESALDAMENTO > 53) TH' +
        'EN 53'
      
        '         WHEN (TMP.SEXO = '#39'F'#39') AND (TMP.IDADESALDAMENTO > 48) TH' +
        'EN 48'
      '         ELSE TMP.IDADESALDAMENTO'
      '       END IDADESALDAMENTOSEXO,'
      '       /*CASE'
      
        '         WHEN (TMP.SEXO = '#39'M'#39') AND (TMP.IDADESALDAMENTO > 53) TH' +
        'EN'
      '            53'
      '         ELSE'
      '            TMP.IDADESALDAMENTO'
      '       END IDADESALDAMENTOHOMEM,'
      '       CASE'
      
        '         WHEN (TMP.SEXO = '#39'F'#39') AND (TMP.IDADESALDAMENTO > 48) TH' +
        'EN'
      '            48'
      '         ELSE'
      '            TMP.IDADESALDAMENTO'
      '       END IDADESALDAMENTOMULHER,  */'
      '       -- SIG 21889 FIM'
      ''
      
        '       (TMP.IDADEDIBINSS - TMP.TEMPOCONTRIBANOS) IDADECOMPARATIV' +
        'A,'
      '       TMP.APOSENTADOINSS,'
      '       TMP.SEXO,'
      '       TMP.IDEVENTOGERADOR,'
      '       TMP.IDADEDIBINSS,'
      '       TMP.IDADESALDAMENTO,'
      '       TMP.COMPLEMENTAIDADE,'
      '       TMP.TEMPOCONTRIBANOS,'
      '       TMP.IDSITBENEFICIO            '
      'FROM ( '
      ' SELECT E.MATRICULA,'
      ''
      '       --SOL 270929'
      
        '    --     TRUNC(((EV.DATAEVENTO - PF.DATANASC) / 365),4) AS IDA' +
        'DEDIBINSS,'
      
        '            NVL(TRUNC(((1900 + (extract(year from EV.DATAEVENTO)' +
        ' - 1900) + '
      
        '                          ((extract(month from EV.DATAEVENTO)- 1' +
        ')/12) + '
      
        '                           (extract(day from EV.DATAEVENTO)/365)' +
        ')'
      
        '                -  (1900 + (extract(year from PF.DATANASC)-1900)' +
        ' + '
      
        '                          ((extract(month from PF.DATANASC)- 1)/' +
        '12) + '
      '                           (extract(day from PF.DATANASC)/365))'
      
        '                   ),4),18)  AS IDADEDIBINSS,   -- Andre Imakawa' +
        ' - SIG 22419'
      '      --SOL 270929 '
      
        '       /*TRUNC(((TO_DATE('#39'31/08/2006'#39','#39'DD/MM/YYYY'#39') - PF.DATANAS' +
        'C)/365),4) AS IDADESALDAMENTO, */'
      '      --SOL 270929'
      
        '       /*round((2006.668 - (1900 + (extract(year from PF.DATANAS' +
        'C)-1900) + ((extract(month from PF.DATANASC)- 1)/12) + (extract(' +
        'day from PF.DATANASC)/365))),4) AS IDADESALDAMENTO, */'
      '       round(( (2006 + (8-1)/12 + 31/365) - '
      '       (1900 + (extract(year from PF.DATANASC)-1900) + '
      '              ((extract(month from PF.DATANASC)- 1)/12) + '
      
        '               (extract(day from PF.DATANASC)/365))),4) AS IDADE' +
        'SALDAMENTO,'
      '       --SOL 270929 '
      '        DECODE(PF.SEXO, '#39'M'#39', 35, 30) AS COMPLEMENTAIDADE,'
      '        --SOL 270929'
      '      /* TRUNC((NVL(E.TEMPOSERVTOTAL,0)* 365) +'
      '             (NVL(E.TEMPOSERVTOTMES,0)* 30) +'
      
        '             (NVL(E.TEMPOSERVTOTDIA,0)/365),4) / 365 AS TEMPOCON' +
        'TRIBANOS, */'
      '         TRUNC(('
      '         (NVL(E.TEMPOSERVTOTAL,0) +'
      '         (NVL(E.TEMPOSERVTOTMES,0) / 12) +'
      
        '         (NVL(E.TEMPOSERVTOTDIA,0) / 365))),4) AS TEMPOCONTRIBAN' +
        'OS,'
      '        --SOL 270929      '
      '             '
      '       PF.SEXO,'
      '       B.IDTITULAR,'
      '       EV.IDPLANOPREV, '
      '       B.IDPESSOA, '
      '       0 APOSENTADOINSS,'
      '       EV.DATAEVENTO, PF.DATANASC ,'
      '       EV.DATAEVENTO AS  DataAposentadoria,'
      '       EV.IDEVENTOGERADOR , EV.IDBENEFICIO,'
      '       0 IDSITBENEFICIO'
      '  FROM ELEGPATRO E,  '
      '       PESSOAFISICA PF, EVENTOSPREV EV, BENEFSALDFAB B   '
      '  WHERE PF.IDPESSOA    = E.IDPESSOA '
      '  AND   B.IDTITULAR  IN ('
      '                            SELECT B.IDTITULAR'
      '                              FROM BENEFSALDFAB B'
      '                             WHERE B.MESREFERENCIA = '#39'2006/08'#39
      '                               AND B.IDTITULAR IN'
      '                                   (SELECT IDPESSOA'
      '                                      FROM EVENTOSPREV EVP'
      
        '                                     WHERE EVP.IDPESSOA = B.IDPE' +
        'SSOA'
      
        '                                       AND EVP.IDPESSJUR = E.IDP' +
        'ESSJUR -- AJUSTE PERFORMANCE SIG 19027      '
      
        '                                       AND (EVP.IDEVENTOGERADOR ' +
        'IN (338,339)) '
      '                                       and not exists (SELECT 1'
      
        '                                                     FROM EVENTO' +
        'SPREV EVP1'
      
        '                                                    WHERE EVP1.I' +
        'DPESSOA = EVP.IDPESSOA '
      
        '                                                      AND EVP1.I' +
        'DPESSJUR = EVP.IDPESSJUR  -- AJUSTE PERFORMANCE SIG 19027       ' +
        '                                    '
      
        '                                                      and EVP1.I' +
        'DEVENTOGERADOR = 129 )                                          ' +
        '                                                   '
      '                                       '
      '                                       '
      '                                    )    '
      '                           )  '
      '  AND   B.MESREFERENCIA = '#39'2006/08'#39'  '
      '  AND   B.IDTITULAR    = E.IDPESSOA'
      '  AND   B.IDPESSOA   = EV.IDPESSOA '
      '  AND   EV.IDEVENTOGERADOR IN (338,339)'
      '  AND   EV.IDPESSOA    = E.IDPESSOA'
      
        '  AND   EV.IDPESSJUR   = E.IDPESSJUR -- AJUSTE PERFORMANCE SIG 1' +
        '9027'
      '  AND   E.IDPESSOA = :IDPESSOA'
      '  ) TMP  ) TMP2'
      ' '
      'ORDER BY  LINHA   -- Andre Imakawa - SIG 22429'
      '  '
      ' ')
    ValidateWithMask = True
    Left = 217
    Top = 457
    ParamData = <
      item
        DataType = ftString
        Name = 'MATRICULA'
        ParamType = ptInput
      end
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
  end
  object qryInformacoes: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'SELECT '
      '  P.NOME, '
      '  EL.MATRICULA, '
      '  PATRO.NOME PATRO,'
      '  SF.DESCRICAO SITUACAO_PATRO,'
      '  PP.NOME NOMEPLANO,'
      '  SPP.DESCRICAO SITUACAO_PLANO,'
      '  SP.DESCRICAO SITUACAO_FUNDACAO,'
      
        '  (C.VPGRATSEMADICTEMPSERV + C.VPGIPTEMPOSERV + C.VPGIPSEMSALCOM' +
        'FUNC + C.VPEXBH + C.ADICCOMP +'
      
        '    C.ADICINCORP + C.ADICNOTURNO + C.ADICINSALU + C.ADICPERI + C' +
        '.INCORPJUD + C.COMPSALPADRAO) ADICIONAIS,'
      '  C.NOMECARGO,'
      '  C.VALORATS,'
      '  C.VALORCARGOCOMIS,'
      '  C.SALPART SALPART_2006,'
      '  C.BENEFICIOSALDADO BENEFSALD_2006,'
      '  BENEFSLD.BENEFSALDADOINSS,'
      '  BENEFSLD.SALDOFABINSS'
      'FROM CARGABENEFSALDFAB C'
      'INNER JOIN PESSOA P ON P.IDPESSOA = C.IDPESSOA '
      'INNER JOIN ELEGPATRO EL ON EL.IDPESSOA = C.IDPESSOA'
      'INNER JOIN PARTPREVPLAN PPP ON EL.IDPESSOA = PPP.IDPESSOA AND'
      '                               EL.IDPESSJUR = PPP.IDPESSJUR AND'
      '                               PPP.IDPLANOPREV = 2'
      'INNER JOIN PESSOA PATRO ON PATRO.IDPESSOA = EL.IDPESSJUR'
      'INNER JOIN PLANPREV PP ON PPP.IDPLANOPREV = PP.IDPLANOPREV'
      'INNER JOIN SITFUNC SF ON EL.IDSITFUNC = SF.IDSITFUNC'
      'INNER JOIN SITPART SP ON PPP.IDSITPART = SP.IDSITPART'
      
        'INNER JOIN SITPLANOPREV SPP ON PPP.IDSITPLANOPREV = SPP.IDSITPLA' +
        'NOPREV'
      
        'LEFT JOIN (SELECT B.IDPESSOA,B.IDTITULAR,B.BENEFSALDADOINSS,B.SA' +
        'LDOFABINSS,B.MESREFERENCIA '
      '  from BENEFSALDFAB B where B.IDPESSOA = :IDPESSOA '
      '  and B.IDTITULAR = :IDTITULAR'
      
        '  and B.IDBENEFSALDFAB = (SELECT MAX(BM.IDBENEFSALDFAB) FROM BEN' +
        'EFSALDFAB BM'
      
        '  WHERE BM.IDPESSOA = B.IDPESSOA AND BM.IDTITULAR = B.IDTITULAR ' +
        'AND BM.MESREFERENCIA ='
      '  (SELECT MAX(BM.MESREFERENCIA) FROM BENEFSALDFAB BMA'
      
        '  WHERE BMA.IDPESSOA = BM.IDPESSOA AND BMA.IDTITULAR = BM.IDTITU' +
        'LAR))) BENEFSLD '
      
        '  ON BENEFSLD.IDPESSOA = C.IDPESSOA AND BENEFSLD.IDTITULAR = C.I' +
        'DTITULAR'
      'WHERE  C.IDPESSOA = :IDPESSOA '
      'AND    C.IDTITULAR = :IDTITULAR')
    ValidateWithMask = True
    Left = 51
    Top = 312
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDTITULAR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDTITULAR'
        ParamType = ptUnknown
      end>
