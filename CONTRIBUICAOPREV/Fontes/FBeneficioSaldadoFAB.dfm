  object qryFundacao: TwwQuery
    DatabaseName = 'basedados'
    SQL.Strings = (
      'SELECT P.RAZAOSOCIAL,'
      
        '      ('#39'SCN, Quadra 2 Bloco A Edifício Corporate Financial Cente' +
        'r 12º e 13º Andares'#39') AS ENDERECO,'
      
        '       (initcap(TRIM(C.NOME)) || '#39' '#39' || TRIM(C.CODESTADO) || '#39' C' +
        'EP '#39' || TRIM(E.CEP) || '#39' ('#39' ||'
      '       TRIM(T.DDD) || '#39') '#39' || SUBSTR(T.NUMERO, 1, 4) || '#39'-'#39' ||'
      
        '       SUBSTR(T.NUMERO, 5, 8) || '#39' - '#39' || P.HOMEPAGE) AS COMPLEM' +
        'ENTO,'
      '       I.IMAGEM'
      '  FROM PESSOA P, ENDPESS E, IMAGENS I, CIDADES C, TELENDPESS T'
      ' WHERE (P.IDPESSOA = 1)'
      '   AND (P.IDPESSOA = E.IDPESSOA(+))'
      '   AND (E.IDCIDADES = C.IDCIDADES(+))'
      '   AND (P.IDIMAGEM = I.IDIMAGEM(+))'
      '   AND (E.IDENDERECO = T.IDENDERECO)'
      '   AND T.TIPO = '#39'C'#39)
    ValidateWithMask = True
    Left = 1061
    Top = 343
  end
