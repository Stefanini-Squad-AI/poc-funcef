  object qryRelDemosSald2: TwwQuery
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'SELECT C.*, P.NOME, E.MATRICULA, PP.NOME PLANO, PF.DATANASC,'
      
        '       ROUND(DECODE(BF.IDBENEFICIO, NULL, 18, ((BF.DATAINICIOFUN' +
        'D - PF.DATANASC)/365)'
      '       ),2)  AS IDADE,'
      '       BF.DATAINICIOFUND,'
      '       BF.IDBENEFICIO,  '
      
        '       DECODE(BF.IDBENEFICIO, NULL, TRUNC((MONTHS_BETWEEN('#39'01/09' +
        '/2006'#39', PF.DATANASC)) / 12, 4),'
      '       ('
      '          CASE'
      
        '            WHEN BF.DATAINICIOFUND > TO_DATE('#39'01/09/2006'#39','#39'DD/MM' +
        '/YYYY'#39') THEN'
      
        '               TRUNC((MONTHS_BETWEEN('#39'01/09/2006'#39', PF.DATANASC))' +
        ' / 12, 4)'
      '            ELSE'
      
        '               TRUNC((MONTHS_BETWEEN(BF.DATAINICIOFUND, PF.DATAN' +
        'ASC)) / 12, 4)'
      '          END'
      '       )) AS IDADESALD,'
      '       DECODE(PF.SEXO,'#39'M'#39',35,'#39'F'#39',30) TS'
      
        '  FROM CARGABENEFSALDFAB C, ELEGPATRO E, PESSOA P, PESSOAFISICA ' +
        'PF,'
      '       PARTPREVPLAN PT, PLANPREV PP,'
      '       (SELECT B1.IDPESSOA, B1.IDBENEFICIO, B1.DATAINICIOFUND'
      '          FROM BENEFBFCIARIO B1'
      '         WHERE B1.FONTEPAGADORA = 2'
      '           AND B1.IDSITBENEFICIO = 1'
      '           AND B1.IDPESSOA = :IDPESSOA) BF'
      ' WHERE'
      '   C.IDPESSOA = :IDPESSOA'
      ''
      '   AND C.IDPESSOA = P.IDPESSOA  '
      '   AND P.IDPESSOA = E.IDPESSOA'
      '   AND P.IDPESSOA = PF.IDPESSOA'
      '   AND BF.IDPESSOA(+) = E.IDPESSOA '
      '   AND E.IDPESSOA = PT.IDPESSOA'
      '   AND E.IDPESSJUR = PT.IDPESSJUR'
      '   AND PT.IDPLANOPREV = PP.IDPLANOPREV   '
      '   AND PT.IDPLANOPREV = 2 '
      '   AND ROWNUM = 1'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 567
    Top = 313
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptInput
      end>
