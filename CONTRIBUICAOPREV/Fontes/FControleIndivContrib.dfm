  object UpdateSalAux: TUpdateSQL
    ModifySQL.Strings = (
      'update DUAL'
      'set'
      '  MES = :MES,'
      '  MESCOBRANCA = :MESCOBRANCA,'
      '  VALORPROVENTO = :VALORPROVENTO'
      'where'
      '  MES = :OLD_MES and'
      '  MESCOBRANCA = :OLD_MESCOBRANCA and'
      '  VALORPROVENTO = :OLD_VALORPROVENTO')
    InsertSQL.Strings = (
      'insert into DUAL'
      '  (MES, MESCOBRANCA, VALORPROVENTO)'
      'values'
      '  (:MES, :MESCOBRANCA, :VALORPROVENTO)')
    DeleteSQL.Strings = (
      'delete from DUAL'
      'where'
      '  MES = :OLD_MES and'
      '  MESCOBRANCA = :OLD_MESCOBRANCA and'
      '  VALORPROVENTO = :OLD_VALORPROVENTO')
    Left = 77
    Top = 357
  end
