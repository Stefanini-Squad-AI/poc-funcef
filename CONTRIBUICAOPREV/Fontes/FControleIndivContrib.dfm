  object qrySalarios: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  H.MES, H.MESCOBRANCA, H.VALORPROVENTO'
      'FROM   HISTRUBSAL H, PATRO PT'
      'WHERE  H.IDPESSOA  = :IDPESSOA'
      'AND    H.IDPESSJUR = :IDPESSJUR'
      'AND    PT.IDPESSOA = :IDPESSJUR'
      'AND    H.IDRUBRICA = :IDRUBRICA'
      'AND    H.VALORPROVENTO IS NOT NULL'
      'ORDER BY H.MES DESC')
    ValidateWithMask = True
    Left = 14
    Top = 309
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDRUBRICA'
        ParamType = ptUnknown
      end>
    object qrySalariosMES: TStringField
      FieldName = 'MES'
      Origin = 'BASEDADOS.HISTRUBSAL.MES'
      FixedChar = True
      Size = 7
    end
