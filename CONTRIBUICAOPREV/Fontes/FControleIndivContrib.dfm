  object qryTipoAlterador: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT CODALTERADOR, DESCRICAO'
      'FROM TIPOALTERADOR'
      'WHERE RECPAG = :RECPAG'
      'AND EXISTS (SELECT 1 FROM ALTERADORXCONTRIB'
