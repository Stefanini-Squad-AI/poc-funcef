  object ds: TwwDataSource
    DataSet = qryProcesso
    Left = 17
    Top = 354
  end
  object qryAdvog1: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select IDPESSOA, NOME from PESSOA '
      'where IDPESSOA in '
      '          (Select distinct IDADVOGRECDA from PROCESSOTRAB '
      '           Where IDADVOGRECDA is Not Null'
      '           AND   INDMATERIA > 3)'
      'order by upper(NOME)')
    ValidateWithMask = True
    Left = 202
    Top = 361
  end
  object qryTRT: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select distinct V.IDVARAJUSTICA, V.DESCRICAO '
      'from VARAJUSTICA V, PROCESSOTRAB P'
      'where V.IDVARAJUSTICA = P.IDVARAJUSTICA'
      'and    P.INDMATERIA > 3'
      'order by upper(V.DESCRICAO)')
    ValidateWithMask = True
    Left = 403
    Top = 360
  end
  object qryProcesso: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT PESSOA.NOME, PESSOA.IDPESSOA, PROCESSOTRAB.*,'
      '               VARAJUSTICA.DESCRICAO AS NOMEVARA'
      'FROM PESSOA, PROCESSOTRAB, VARAJUSTICA'
      'WHERE PESSOA.IDPESSOA = PROCESSOTRAB.IDRECLAMANTE'
      
        'AND       PROCESSOTRAB.IDVARAJUSTICA = VARAJUSTICA.IDVARAJUSTICA' +
        '(+)'
      '')
    ValidateWithMask = True
    Left = 17
    Top = 344
  end
  object qryAdvog2: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select IDPESSOA, NOME from PESSOA '
      'where IDPESSOA in '
      '          (Select distinct IDADVOGRECTE from PROCESSOTRAB '
      '           Where IDADVOGRECTE is Not Null'
      '           AND   INDMATERIA > 3)'
      'order by upper(NOME)')
    ValidateWithMask = True
