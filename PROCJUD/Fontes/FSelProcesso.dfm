  object tblPessoal: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT PESSOA.NOME,PESSOA.TIPO,PESSOA.NUMDOCUMENTO,'
      'PESSOA.FLGFUNCIONARIO,PESSOA.FLGCANDIDATO,PESSOAFISICA.*,'
      'FUNCIONARIO.MATRICULA,PESSOA.IDPESSOA '
      'FROM PESSOA,PESSOAFISICA,FUNCIONARIO'
      'WHERE FUNCIONARIO.IDPESSOA(+) = PESSOA.IDPESSOA '
      'AND PESSOAFISICA.IDPESSOA = PESSOA.IDPESSOA '
      'AND (PESSOA.FLGCANDIDATO=1 OR PESSOA.FLGFUNCIONARIO=1)'
      'ORDER BY FUNCIONARIO.MATRICULA,PESSOA.IDPESSOA')
