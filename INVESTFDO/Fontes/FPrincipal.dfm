  object qryInsTipoOperacao: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'INSERT INTO TIPOOPERACAO'
      
        '(IDTIPOINVEST,IDTIPOOPERACAO,IDMERCADO,CODTIPDOC,DESCTIPOOPERACA' +
        'O,NATUREZAOPERACAO,TIPOCUSTODIA,'
      
        ' VENCIMENTO,FLGGERACONTAB,FLGGERACAPCAR,RECPAG,TIPCREDOR,FLGGERA' +
        'CAF,FLGTRANSF,FLGCORRET,'
      
        ' TRGDTINCLUSAO, TRGUSERINCLUSAO, FLGORDMOVINV, IDMOTIVOBLOQUEIO,' +
        ' FLGOPDIREITO, FLGAGE,'
      
        ' FLGDATAEX, FLGDATACOM, FLGINVORIGEM, FLGPERC, FLGPARIDADE, FLGP' +
        'RZBOLSA, FLGPRZEMP,'
      
        ' FLGATADEC, FLGFORMAPAGREC, FLGDIVACAO, FLGINIPAG, FLGJUROS, MOT' +
        'BLOQCARTORIG, MOTBLOQCARTDEST,'
      
        ' TIPSALDOCARTORIG, TIPSALDOCARTDEST, FLGTRATAIR, SIGLATIPOOPER, ' +
        'FLGISENTOIR, FLGGRAVAIRLITIGIO,'
      ' FLGOPGERENC, TIPOMOVTO, STAATIVO, FLGRENTABILIDADE)'
      'VALUES'
      
