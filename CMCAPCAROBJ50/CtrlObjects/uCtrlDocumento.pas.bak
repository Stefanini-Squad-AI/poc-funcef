function TCtrlDocumento.ContabilizaPlanilhaSintetica(var pPlanilhaBaixa : Integer) : Boolean;
var iCount : Integer;
    oGrupo : TSingleGrupo;
begin
  For iCount := 0 to PlanilhaSintetica.Count -1 do
  begin
    oGrupo := PlanilhaSintetica.Grupos[iCount];
    if _LancaContab.InsereLancaContab(oGrupo.TipoLancto,
                                      Sistema.IdEmpresa,
                                      Sistema.IdModulo,
                                      Sistema.IdUsuario,
                                      1,
                                      oGrupo.Integrar.UnidadeNegocio,
                                      oGrupo.Integrar.SubContaDebito,
                                      oGrupo.Integrar.SubContaCredito,
                                      oGrupo.Integrar.Plano,
                                      oGrupo.Integrar.Patro,
                                      PlanilhaSintetica.Planilha,
                                      0,
                                      DateToStr(PlanilhaSintetica.DataPlanilha),
                                      '',
                                      'CONTABILIZACAO DA BAIXA AUTOMATICA',
                                      '',
                                      '',
                                      '',
                                      '',
                                      '03',
                                      oGrupo.Integrar.CCustoDebito,
                                      oGrupo.Integrar.ContaDebito,
                                      oGrupo.Integrar.CCustoCredito,
                                      oGrupo.Integrar.ContaCredito,
                                      '',
                                      oGrupo.ValorTotalLancamentos,
                                      false,
                                      UsaPlanoPatro,
                                      oGrupo.Integrar.IdSegregacao,
                                      PlanilhaSintetica.DataPlanilha,
                                      -1,
                                      true,
                                      0) Then
    Begin
      Result := True;
      pPlanilhaBaixa := Trunc(_LancaContab.RetornoPlnCodigo);
      PlanilhaSintetica.Planilha := pPlanilhaBaixa;
    End
    Else
    Begin
      Result := False;
      MessageInfo := _LancaContab.MessageInfo;
      Exit;
    End;
  end;
  If Result then
    If PlanilhaSintetica.AjustaCodigoPlanilha then
      PlanilhaSintetica.GravarLog
    else
      Result := False;
end;

function TCtrlDocumento.ArredondaRateio(Value: Double; const bArred5 : boolean): Double;  // Edilaine - SOL 124845-14262 / KTN 1977287
begin
  RESULT := _LancaContab.RoundNExtend(VALUE, 2, bArred5 );   // Edilaine - SOL 124845-14262 / KTN 1977287

  {// Edilaine - SOL 124845-14262 / KTN 1977287 - comentado
  Result := StrToFloat(FloatToStr(Value * 1000));
  Result := Trunc(Result);
  Result := Result / 10;
  Result := Trunc(Result);
  Result := Result / 100;
  } // Edilaine - SOL 124845-14262 / KTN 1977287 - fim
end;

