procedure TLanctoDocum.SetValues(dDatalancto: TDateTime;
                                 liCoddocumento,
                                 liNumlancto: LongInt;
                                 rVlrliquido,
                                 rValorOM,
                                 rValor: Double;
                                 liUnidnegoc,
                                 liPlncodigo,
                                 liNumlotemanual,
                                 liIdusuarioinclusao,
                                 liIdpessoa,
                                 liIdnflivro,
                                 liEstorno,
                                 liCodtipdoc,
                                 liCoddocinss,
                                 liCodalterador: LongInt;
                                 sOperacao,
                                 sNumrecibo,
                                 sNumnf,
                                 sNumfatura,
                                 sHistoricocompl,
                                 sFlgtipofatura,
                                 sFlgrecebeunf,
                                 sFlgfatemitida,
                                 sDebcre: String;
                                 liIdModulo: LongInt;
                                 liPlanoConta: LongInt;
                                 bUsaPlanoPatro: Boolean;
                                 bContabiliza: Boolean = False;
                                 iCodPortForma: Integer = 0;
                                 iDiasFloat: Integer = 0;
                                 sContaBaixa: String = '';
                                 liSubContaBaixa: Integer = 0;
                                 IDDespesaOrc   : Double  = 0;//Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
                                 IDRateioDocum  : Double  = 0//Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
                                 );
Var
   iNovoItem: Integer;
Begin

   If (Trim(sDebCre) <> 'C') And (Trim(sDebCre) <> 'D') Then
   begin
      TCtrlDocumento(Owner).MessageInfo := 'DebCre inválido para o CodDocumento: ' + IntToStr(liCoddocumento) + ' e NumLancto: ' + IntToStr(liNumlancto);
      Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
   end;

   iNovoItem := TCtrlDocumento(fOwner)._LstLanctoDocum.Add(TDbLanctodocum.Create(fOwner));
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).DataBaseName := DataBaseName;

   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Contabiliza := bContabiliza;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).CodPortForna := iCodPortForma;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).DiasFloat := iDiasFloat;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).IdModulo := liIdModulo;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).PlanoConta := liPlanoConta;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).UsaPlanoPatro := bUsaPlanoPatro;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).ContaBaixa := sContaBaixa;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).SubContaBaixa := liSubContaBaixa;

   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Datalancto.AsDateTime := dDatalancto;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Coddocumento.AsFloat := liCoddocumento;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Numlancto.AsFloat := liNumlancto;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Vlrliquido.AsFloat := TCtrlDocumento.RoundCMLocal(rVlrliquido,2);
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Valoroutramoeda.AsFloat := TCtrlDocumento.RoundCMLocal(rValorOM,2);
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Valor.AsFloat := rValor;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Idusuarioinclusao.AsFloat := liIdusuarioinclusao;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Idpessoa.AsFloat := liIdpessoa;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Operacao.AsString := IntToStr(Integer(TCtrlDocumento(fOwner)._OperacaoDocLanc));
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Historicocompl.AsString := Copy(Trim(sHistoricocompl),1,100);
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Debcre.AsString := Trim(sDebcre);
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Numrecibo.AsString := Trim(sNumrecibo);
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Numnf.AsString := Trim(sNumnf);
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Numfatura.AsString := Trim(sNumfatura);
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Flgtipofatura.AsString := Trim(sFlgtipofatura);
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Flgrecebeunf.AsString := Trim(sFlgrecebeunf);
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Flgfatemitida.AsString := Trim(sFlgfatemitida);

   //Inicio - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).IDDespesaOrc.AsFloat  := IDDespesaOrc;
   TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).IDRateioDocum.AsFloat := IDRateioDocum;
   //Fim    - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662

   If (liUnidnegoc = 0) Or (liUnidnegoc < -1) Then
     TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Unidnegoc.Clear
   Else
     TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Unidnegoc.AsFloat := liUnidnegoc;

   TCtrlDocumento(fOwner).SetFieldValue(TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Plncodigo, liPlncodigo);
   TCtrlDocumento(fOwner).SetFieldValue(TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Numlotemanual, liNumlotemanual);
   TCtrlDocumento(fOwner).SetFieldValue(TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Idnflivro, liIdnflivro);
   TCtrlDocumento(fOwner).SetFieldValue(TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Estorno, liEstorno);
   TCtrlDocumento(fOwner).SetFieldValue(TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Codtipdoc, liCodtipdoc);
   TCtrlDocumento(fOwner).SetFieldValue(TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Coddocinss, liCoddocinss);
   TCtrlDocumento(fOwner).SetFieldValue(TDbLanctodocum(TCtrlDocumento(fOwner)._LstLanctoDocum[iNovoItem]).Codalterador, liCodalterador);
end;

{ TRateioDocum }


procedure TRateioDocum.SetValues(rValor, rValorOM,
  rVlrresorcamen: Double; liIdrateiodocum, liIdpessoa, liCoddocumento,
  liUnidnegoc, liMoecodigo, liIdusuarioinclusao, liIdreservaorcamen,
  liPlano, liIdplanoprev, liIdpatro, liIdprograma, liIdprocesso,
  liIdempresa: LongInt; sCodtiprecdes, sRecpag, sCodcentrorespon,
  sCodcentrocusto, sNumimovel: String;
  // 30/09/04 Alex 17193 - segregação na origem.
  // Nas integrações com sistemas de origem esta propriedade sermpre deverá ser passada como true
  const bSegregaOrigem: boolean = true;
 //início - andre tavares - pendência 22278 - 19/08/2006
  const IdPlanoVirtual: integer = 0;
  const IdSegregaContr: integer = 0;
 //fim - andre tavares - pendência 22278 - 19/08/2006

  //Inicio - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
  //AIDDESPESAORC   : Double = 0;
  ACdsDocumento   : TClientDataSet = Nil;
  ACdsRateio      : TClientDataSet = Nil;
  ACdsAlteradores : TClientDataSet = Nil
  //Fim    - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662


  );
Var
   iNovoItem: Integer;

   recPlanoPatro: TDadosFinanceiro;

   //
   //temp : integer;

   //***************************************************************************
   // gerar o rateio da rateio docum na origem (Segregação Virtual na Origem)
   //***************************************************************************
   function SegregaRateioDocumOrigem: boolean;
   var bSegregaLanctoOrigem: boolean;
       salvaIdSegregaContr : integer;

       _CdsDtSegrega : TClientDataSet;

   begin

     //Marcus Oliveira 26464 27/09/2007
     _CdsDtSegrega := TClientDataSet.Create(nil);
     try
       _CdsDtSegrega.data := TCtrlDocumento(Owner).GetDataPacket('SELECT DTSEGREGAVIRTUAL FROM PARAMGLOBAL');


       Result := false;  // caso o result seja true o lançamento foi interceptado

       bSegregaLanctoOrigem := (liIdplanoprev = TCtrlDocumento(fOwner)._Segregacao.PlanoPrevComum) and
                               (liIdpatro     = TCtrlDocumento(fOwner)._Segregacao.PatroComum)and
                               (TCtrlDocumento(fOwner)._Segregacao.SegregaOrComum) and
                               (TCtrlDocumento(fOwner)._Documento.IdSegregaCriter.AsInteger > 0);

       if (not bSegregaLanctoOrigem) and (TCtrlDocumento(fOwner)._Segregacao.PlanoPrevAdm > 0) then
          bSegregaLanctoOrigem := (liIdplanoprev = TCtrlDocumento(fOwner)._Segregacao.PlanoPrevAdm) and
                               (liIdpatro     = TCtrlDocumento(fOwner)._Segregacao.PatroComum)and
                               (TCtrlDocumento(fOwner)._Segregacao.SegregaOrAdm) and
                               (TCtrlDocumento(fOwner)._Documento.IdSegregaCriter.AsInteger > 0);

       //Marcus Oliveira 26464 27/09/2007
       if ( bSegregaLanctoOrigem ) and
          ( Trunc ( TCtrlDocumento(fOwner)._Documento.Dataemissao.asdatetime ) >=
            Trunc ( _CdsDtSegrega.FieldByName('DTSEGREGAVIRTUAL').AsDateTime ) )  then begin

         if not TCtrlDocumento(fOwner)._Segregacao.RateiaValor( rValor,
                                    TCtrlDocumento(fOwner)._Documento.IdSegregaCriter.AsInteger,
                                    TCtrlDocumento(fOwner)._Documento.Dataemissao.asdatetime) then

         //Início - Rodolpho da Silva - 04/05/2006
         Begin
           TCtrlDocumento(fOwner).MessageInfo := TCtrlDocumento(fOwner)._Segregacao.Messageinfo;
           raise exception.create (TCtrlDocumento(fOwner)._Segregacao.MessageInfo);
         end;
         //Fim - Rodolpho da Silva - 04/05/2006

         // fazer o rateio aqui;
         TCtrlDocumento(fOwner)._Segregacao.CdsRateio.first;

         //****** início - andre tavares - pendência 22278 - 19/08/2006
         salvaIdSegregaContr := TCtrlDocumento(fOwner)._Segregacao.GetSegregaCtrl;
         //****** fim - andre tavares - pendência 22278 - 19/08/2006

         while not TCtrlDocumento(fOwner)._Segregacao.CdsRateio.eof do begin

           SetValues(TCtrlDocumento(fOwner)._Segregacao.CdsRateio.FieldByName('VALOR').AsFloat,
             rValorOM, rVlrresorcamen, liIdrateiodocum, liIdpessoa, liCoddocumento,
             liUnidnegoc, liMoecodigo, liIdusuarioinclusao, liIdreservaorcamen, liPlano,
             TCtrlDocumento(fOwner)._Segregacao.CdsRateio.FieldByName('IDPLANOPREV').AsInteger,
             TCtrlDocumento(fOwner)._Segregacao.CdsRateio.FieldByName('IDPATRO').AsInteger,
             liIdprograma, liIdprocesso, liIdempresa, sCodtiprecdes, sRecpag, sCodcentrorespon,
             sCodcentrocusto, sNumimovel, false,
             liIdplanoprev, salvaIdSegregaContr,
             //Inicio - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
             ACdsDocumento,
             ACdsRateio,
             ACdsAlteradores
             //FIM    - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
             );

           TCtrlDocumento(fOwner)._Segregacao.CdsRateio.next;
           Result := true;

         end;

       end;
     finally
       // 14/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
       _CdsDtSegrega.Close;

       //27/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
       //Marcus Oliveira 26464 27/09/2007
       //_CdsDtSegrega.Free;
       FreeAndNil(_CdsDtSegrega);
     end;

   end;

begin
   If (Trim(sCodcentrocusto) <> '') And (liIdempresa <= 0) Then
   begin
      TCtrlDocumento(Owner).MessageInfo := 'IdEmpresa não informado. É obrigatório pois o Centro de Custo esta preenchido';
      Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
   end;

   //  Rodolpho da Silva - P: 18599 - 01/02/2005
   if Trim(sCodcentrorespon) = '' then
   sCodcentrorespon := '9999999999';


   // Alex 30/09/2004 17193 segregação virtual na origem
   // ratear a rateiodocum e a ccbaixasxdocum pelo método de segregação
   if not TCtrlDocumento(fOwner)._Segregacao.Active then
     TCtrlDocumento(fOwner)._Segregacao.GetParams(liIdPessoa);

   // Alex 30/09/2004 17193
   if (bSegregaOrigem) and (TCtrlDocumento(fOwner)._Segregacao.SegregaVirtual) then begin
     if SegregaRateioDocumOrigem then exit;  // o lançamento foi interceptado pela segregação e já foi feito.
   end;

   // 20/09/04 Alex 17621 verificar relacionamentos inválidos entre plano x patro
   if not TCtrlDocumento(fOwner)._PlanPrevContabPatro.ValidaPlanoPatro ( liIdpatro, liIdplanoprev ) then
   begin
      TCtrlDocumento(Owner).MessageInfo := 'Não existe relacionamento entre Patrocinadora e Plano escolhidos!';
      Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
   end;

   iNovoItem := TCtrlDocumento(fOwner)._LstRateioDocum.Add(TDbRateiodocum.Create(fOwner));
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).DataBaseName := DataBaseName;

   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Valor.AsFloat := TCtrlDocumento.RoundCMLocal(rValor,2);
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Valoroutramoeda.AsFloat := TCtrlDocumento.RoundCMLocal(rValorOM,2);
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Vlrresorcamen.AsFloat := TCtrlDocumento.RoundCMLocal(rVlrresorcamen,2);
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Idpessoa.AsFloat := liIdpessoa;
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Coddocumento.AsFloat := liCoddocumento;
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Idusuarioinclusao.AsFloat := liIdusuarioinclusao;
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Idrateiodocum.AsFloat := liIdrateiodocum;

   If (liUnidnegoc = 0) Or (liUnidnegoc < -1) Then
     TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Unidnegoc.Clear
   Else
     TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Unidnegoc.AsFloat := liUnidnegoc;

   TCtrlDocumento(fOwner).SetFieldValue(TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Moecodigo, liMoecodigo);
   TCtrlDocumento(fOwner).SetFieldValue(TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Idreservaorcamen, liIdreservaorcamen);
   TCtrlDocumento(fOwner).SetFieldValue(TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Plano, liPlano);
   TCtrlDocumento(fOwner).SetFieldValue(TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Idplanoprev, liIdplanoprev);
   TCtrlDocumento(fOwner).SetFieldValue(TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Idpatro, liIdpatro);
   TCtrlDocumento(fOwner).SetFieldValue(TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Idprograma, liIdprograma);
   TCtrlDocumento(fOwner).SetFieldValue(TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Idprocesso, liIdprocesso);
   TCtrlDocumento(fOwner).SetFieldValue(TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Idempresa, liIdempresa);

   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Codtiprecdes.AsString := Trim(sCodtiprecdes);
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Recpag.AsString := Trim(sRecpag);
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Codcentrorespon.AsString := Trim(sCodcentrorespon);
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Codcentrocusto.AsString := Trim(sCodcentrocusto);
   TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).Numimovel.AsString := Trim(sNumimovel);

   //Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
   //TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).IDDespesaOrc.ASFloat := AIDDESPESAORC;
   //

   if IdPlanoVirtual > 0 then
   begin
     TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).IdPlanoVirtual.asInteger := IdPlanoVirtual;
     TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).IdSegregaContr.asInteger := IdSegregaContr;
   end
   else
   begin
     TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).IdPlanoVirtual.Clear;
     TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).IdSegregaContr.Clear;
   end;

   // Ricardo A. SOL 122623 KTN 603580
   recPlanoPatro := TCtrlDocumento( Owner ).LocalizaPlanoPatroFinanceiro(
        TDbRateiodocum( TCtrlDocumento( fOwner )._LstRateioDocum[ iNovoItem ] ).Idempresa.AsInteger,
        TCtrlDocumento( fOwner ).CodPortForma,
        TCtrlDocumento( fOwner ).IdForCli,
        TDbRateiodocum( TCtrlDocumento( fOwner )._LstRateioDocum[ iNovoItem ] ).Idpatro.AsInteger,
        TDbRateiodocum( TCtrlDocumento( fOwner )._LstRateioDocum[ iNovoItem ]).IdplanoPrev.AsInteger,
        TDbRateiodocum( TCtrlDocumento( fOwner )._LstRateioDocum[ iNovoItem ]).Idprograma.AsInteger,
        sRecPag,
        TDbRateiodocum( TCtrlDocumento( fOwner )._LstRateioDocum[ iNovoItem ]).Codcentrocusto.AsString,
        TDbRateiodocum( TCtrlDocumento( fOwner )._LstRateioDocum[ iNovoItem ]).Codtiprecdes.AsString
        );



   //INICIO - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
   if (ACdsDocumento          <> Nil) And
      (ACdsRateio             <> Nil) And
      (AcdsRateio.Fields.Count >   0) Then//AcdsRateio.Fields.Count -> O dataset está criado mas não possui dados
   Begin
      //BRUNO AZEVEDO SOL 172384-12682 KINTANA 1867600
      //If (IntegraOrcamento) and (TCtrlDocumento(Owner).IdModulo in [3, 12, 21, 113]) Then
      If (IntegraOrcamento) and (Sistema.IdModulo in [3, 12, 21, 113]) and
      TCtrlDocumento(Owner).ValidaDesembolso(Trim(sCodcentrocusto), Trim(sCodtiprecdes)) Then
      //BRUNO AZEVEDO SOL 172384-12682 KINTANA 1867600
         Try
            // SOL 200778 KTN 1953121 Otacilio ** Inicio **
            //   if (Sistema.IdModulo = 12) then

            if (Sistema.IdModulo in [3, 12, 21, 113]) then // SOL 202782 KTN 1959852 Xavier
            begin
              ACdsRateio.Edit;
              ACdsRateio.FieldByName('TipoDespesa').AsString := Copy(Trim(sTipoDespesa), 4, 1);
              ACdsRateio.Post;
            end
            // SOL 200778 KTN 1953121 Otacilio ** Fim **
            else
            begin
              ACdsRateio.Edit;
              if recPlanoPatro.ReceitaDespesaAdministrativa Then
                 ACdsRateio.FieldByName('TipoDespesa').AsInteger := 1
              Else
                 ACdsRateio.FieldByName('TipoDespesa').AsInteger := 2;
              ACdsRateio.Post;
            end;
           TCtrlDocumento(fOwner).Orcamento.Operacao := TCtrlDocumento(fOwner).Rateiodocum.FOperacao; // SOL 230863 e 230956 PPM 374049 e 362016
           TCtrlDocumento(fOwner).Orcamento.FDO(ACdsDocumento, ACdsRateio, ACdsAlteradores);
         Except
           RAISE;
         End;
      //

      // Thiago Melo - SOL 202785 KTN 1959851 INI
      //if AcdsRateio.fieldByName('IDDESPESAORC').AsFloat > -1 then       // Edilaine - SOL 195755 / KTN 1871968
      if (AcdsRateio.fieldByName('IDDESPESAORC').AsFloat = 0) or (AcdsRateio.fieldByName('IDDESPESAORC').IsNull) then begin
        TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).IDDespesaOrc.AsFloat    := -1;
      end
      else begin
        TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).IDDespesaOrc.AsFloat    := AcdsRateio.fieldByName('IDDESPESAORC').AsFloat;
      end;
      // Thiago Melo - SOL 202785 KTN 1959851 FIM

    //MARCIO SANCHES SPINOSA - EDILAINE FERRARESI - 172384/9603 - INICIO
      IF (TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).IDReservaOrcamen.AsFloat = 0) THEN
        TDbRateiodocum(TCtrlDocumento(fOwner)._LstRateioDocum[iNovoItem]).IDReservaOrcamen.AsFloat := AcdsRateio.fieldByName('IDRESERVAORCAMEN').AsFloat;
    //MARCIO SANCHES SPINOSA - EDILAINE FERRARESI - 172384/9603 - FIM
   End;
   //FIM    - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662

   TCtrlDocumento( fOwner ).SetFieldValue( TDbRateiodocum(
        TCtrlDocumento( fOwner )._LstRateioDocum[ iNovoItem ] ).Idplanoprev, recPlanoPatro.IdPlanoFinanceiro );
   TCtrlDocumento( fOwner ).SetFieldValue( TDbRateiodocum(
        TCtrlDocumento( fOwner )._LstRateioDocum[ iNovoItem ] ).Idpatro, recPlanoPatro.IdPatroFinanceiro );
   TCtrlDocumento( fOwner ).SetFieldValue( TDbRateiodocum(
        TCtrlDocumento( fOwner )._LstRateioDocum[ iNovoItem ] ).IdPlanoOrigem, recPlanoPatro.IdPlanoOrigem );
   TCtrlDocumento( fOwner ).SetFieldValue( TDbRateiodocum(
        TCtrlDocumento( fOwner )._LstRateioDocum[ iNovoItem ] ).IdPatroOrigem, recPlanoPatro.IdPatroOrigem );

end;

{ TCCBaixasxDocum }

// 23/12/03 alex 5342
procedure TCCBaixasxDocum.SetValues(rValor: Double; liIdCcBaixasxDocum,
  liIdpessoa, liCodDocumento, liUnidNegoc, liPlano, liIdplanoPrev,
  liIdPatro, liIdSegregaCriter: Integer; sPlaConta: String);
Var
   iNovoItem: Integer;
begin
   // 20/09/04 Alex 17621 verificar relacionamentos inválidos entre plano x patro
   if not TCtrlDocumento(fOwner)._PlanPrevContabPatro.ValidaPlanoPatro ( liIdpatro, liIdplanoprev ) then
   begin
     TCtrlDocumento(Owner).MessageInfo := 'Não existe relacionamento entre Patrocinadora e Plano escolhidos!';
     Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
   end;

   // Alex 26/10/2004 não permitir múltiplas contas de baixa para o plano que possuir segregação na origem;
   if not TCtrlDocumento(fOwner)._Segregacao.Active then
     TCtrlDocumento(fOwner)._Segregacao.GetParams(liIdPessoa);

   // Alex 26/10/2004 17193
   if (TCtrlDocumento(fOwner)._Segregacao.SegregaVirtual) then begin
      if liIdplanoprev = TCtrlDocumento(fOwner)._Segregacao.PlanoPrevComum then begin  // PLANO COMUM
        if TCtrlDocumento(fOwner)._Segregacao.SegregaOrComum then begin  // segregado na origem
           TCtrlDocumento(Owner).MessageInfo := 'Para lançamentos no plano "COMUM", que é segregado na origem, não pode haver múltiplas contas de baixa!';
           Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
        end;
      end else if liIdplanoprev = TCtrlDocumento(fOwner)._Segregacao.PlanoPrevAdm then begin  // PLANO ADMINISTRATIVO
        if TCtrlDocumento(fOwner)._Segregacao.SegregaOrAdm then begin  // segregado na origem
           TCtrlDocumento(Owner).MessageInfo := 'Para lançamentos no plano "ADMINISTRATIVO", que é segregado na origem, não pode haver múltiplas contas de baixa!';
           Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
        end;
      end;
   end;

   iNovoItem := TCtrlDocumento(fOwner)._LstCcBaixasxDocum.Add(TDbCcBaixasxDocum.Create(fOwner));
   TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).DataBaseName := DataBaseName;

   TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Valor.AsFloat := TCtrlDocumento.RoundCMLocal(rValor,2);
   TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).IdCcBaixasxDocum.AsFloat := liIdCcBaixasxDocum;
   TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Idpessoa.AsFloat := liIdpessoa;
   TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Coddocumento.AsFloat := liCoddocumento;

   If (liUnidnegoc = 0) Or (liUnidnegoc < -1) Then
     TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Unidnegoc.Clear
   Else
     TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Unidnegoc.AsFloat := liUnidnegoc;

   TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Plano.AsInteger := liPlano;
   TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Idplanoprev.AsInteger := liIdplanoprev;
   TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Idpatro.AsInteger := liIdpatro;
   TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Placonta.AsString := sPlaconta;

   // propositalmente foi declarado como -1 para os desenvolvedores utilizarem a função contábil
   if liIdsegregacriter = -1 then begin
     TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Idsegregacriter.Clear;
   end else begin
     TDbCcBaixasxDocum(TCtrlDocumento(fOwner)._LstCcBaixasxDocum[iNovoItem]).Idsegregacriter.AsInteger := liIdsegregacriter;
   end;

end;
// FIm 23/12/03 alex 5342


{ TSaldo }

procedure TSaldo.CalculaSaldo(iCodDocumento: Double;
  dDataLimite: TDateTime);
Var
  sFiltroData: String;
begin
  fValor := 0.00;
  fValorOM := 0.00;

  If dDataLimite = 0 Then
    sFiltroData := ''
  Else
    sFiltroData := ' AND LANC.DATALANCTO <= TO_DATE(''' + DateToStr(dDataLimite) + ''',''DD/MM/YYYY'') ';

  _Cds.Data := TCtrlDocumento(Owner).GetDataPacket(' SELECT ' +
                             '  SUM(DECODE(LANC.DEBCRE,''D'',DECODE(DOC.RECPAG,''R'',LANC.VALOR,LANC.VALOR * -1),DECODE(DOC.RECPAG,''R'',LANC.VALOR * -1,LANC.VALOR))) AS VALOR, ' +
                             '  SUM(DECODE(LANC.DEBCRE,''D'',DECODE(DOC.RECPAG,''R'',LANC.VALOROUTRAMOEDA,LANC.VALOROUTRAMOEDA * -1),DECODE(DOC.RECPAG,''R'',LANC.VALOROUTRAMOEDA * -1,LANC.VALOROUTRAMOEDA))) AS VALOROUTRAMOEDA ' +
                             ' FROM ' +
                             '  LANCTODOCUM LANC, DOCUMENTO DOC ' +
                             ' WHERE ' +
                             '    DOC.CODDOCUMENTO = ' + FloatToStr(iCodDocumento) + sFiltroData +
                             ' AND DOC.CODDOCUMENTO = LANC.CODDOCUMENTO ');

  If Not _Cds.IsEmpty Then
  Begin
    fValor := _Cds.Fields[0].AsFloat;
    fValorOM := _Cds.Fields[1].AsFloat;
  End;

  If _Cds.Active Then _Cds.Close;
end;




procedure TSaldo.Clear;
begin
  inherited;
  fValor := 0;
  fValorOM  := 0;
  fValorBruto := 0;
end;


//andre tavares - pendência 22005 - 19/04/2006
procedure TSaldo.GetValorBruto(iCodDocumento: Double);
begin
  _Cds.Data := TCtrlDocumento(Owner).GetDataPacket(' SELECT LANC.VALOR ' +
                                                   ' FROM LANCTODOCUM LANC, DOCUMENTO DOC ' +
                                                   ' WHERE DOC.CODDOCUMENTO = ' + FloatToStr(iCodDocumento) + ' AND ' +
                                                   '       DOC.OPERACAO = LANC.OPERACAO AND '+
                                                   '       DOC.CODDOCUMENTO = LANC.CODDOCUMENTO ');
  If Not _Cds.IsEmpty Then
    fValorBruto := _Cds.Fields[0].AsFloat;
end;

procedure TSaldo.SetValorBruto(const Value: Double);
begin
  FValorBruto := Value;
end;

{ TForCli }



constructor TForCli.Create(Aowner: TCmControlObject);
begin
   inherited;
   _DbEmpresaForn    := TDbEmpresaForn.Create(Aowner);
   _DbFornServ       := TDbFornServ.Create(Aowner);
   _DbEmpresaCliente := TDbEmpresaCliente.Create(Aowner);
   _DbClientePess    := TDbClientePess.Create(Aowner);
   _DbFornXRamo      := TDbFornXRamo.Create(Aowner);
   _DbPessoa         := TDbPessoa.Create(Aowner);
end;



procedure TForCli.CriaCliente(liIdpessoa, liIdEmpresa, liCodsubconta,
  liPlano, liIdTipocli: LongInt; sCcusto, sContacadianto, sContacCliente,
  sContacdespesa: string);
begin
  CriaClientepess(liIdpessoa, liIdTipocli);

  CriaEmpresaCli(liIdpessoa, liIdEmpresa, liPlano, liCodsubconta, sCcusto,
                 sContacadianto, sContacdespesa, sContacCliente);
end;




procedure TForCli.CriaClientepess(liIdpessoa, liIdTipoCli: LongInt);
begin
  _DbClientePess.Clear;
  _DbClientePess.Idpessoa.AsFloat := liIdpessoa;

  If Not _DbClientePess.LoadFromDb Then
  Begin
    _DbClientePess.Clear;
    _DbClientePess.Idpessoa.AsFloat := liIdpessoa;
    _DbClientePess.Idtipocliente.AsFloat := liIdTipoCli;

    If Not _DbClientePess.Insert Then Raise EdataBaseError.Create(_DbClientePess.MessageInfo);
  End;

  If _Cds.Active Then _Cds.Close;
end;



procedure TForCli.CriaEmpresaCli(liIdpessoa, liIdEmpresa, liPlano,
  liCodsubconta: LongInt; sCcusto, sContacadianto, sContacReceita,
  sContacCliente: string);
begin
  _DbEmpresaCliente.Clear;
  _DbEmpresaCliente.Idforcli.AsFloat := liIdPessoa;
  _DbEmpresaCliente.Idpessoa.AsFloat := liIdempresa;

  If Not _DbEmpresaCliente.LoadFromDb Then
  Begin
    _DbEmpresaCliente.Clear;

    _DbEmpresaCliente.Idforcli.AsFloat := liIdPessoa;
    _DbEmpresaCliente.Idpessoa.AsFloat := liIdempresa;

    If (Trim(sCcusto) <> '') Then
    Begin
      _DbEmpresaCliente.Idempresa.AsFloat := liIdempresa;
      _DbEmpresaCliente.Codcentrocusto.AsString := Trim(sCcusto);
    End
    Else
    Begin
      _DbEmpresaCliente.Idempresa.Clear;
      _DbEmpresaCliente.Codcentrocusto.Clear;
    End;

    If (liPlano > 0) Then
    Begin
      _DbEmpresaCliente.Plano.AsFloat := liPlano;
      _DbEmpresaCliente.Contaccliente.AsString := Trim(sContacCliente);
      _DbEmpresaCliente.Contacreceita.AsString := Trim(sContacReceita);
      _DbEmpresaCliente.Contacadiantamento.AsString := Trim(sContacadianto);
      TCtrlDocumento(fOwner).SetFieldValue(_DbEmpresaCliente.Codsubconta, liCodSubConta);
    End
    Else
    Begin
      _DbEmpresaCliente.Plano.Clear;
      _DbEmpresaCliente.Contaccliente.Clear;
      _DbEmpresaCliente.Contacreceita.Clear;
      _DbEmpresaCliente.Contacadiantamento.Clear;
      _DbEmpresaCliente.Codsubconta.Clear;
    End;

    If Not _DbEmpresaCliente.Insert Then Raise EdataBaseError.Create(_DbEmpresaCliente.MessageInfo);
  End;

  If _Cds.Active Then _Cds.Close;
end;




procedure TForCli.CriaEmpresaForn(liIdPessoa, liIdempresa, liPlano,
  liCodSubConta: LongInt; sCcusto, sContacadianto, sContacdespesa,
  sContacforn: string);
begin
   _DbEmpresaForn.Clear;
   _DbEmpresaForn.Idforcli.AsFloat := liIdPessoa;
   _DbEmpresaForn.Idpessoa.AsFloat := liIdempresa;

  If Not _DbEmpresaForn.LoadFromDb Then
  Begin
    _DbEmpresaForn.Clear;
    _DbEmpresaForn.Idforcli.AsFloat := liIdPessoa;
    _DbEmpresaForn.Idpessoa.AsFloat := liIdempresa;

    If (Trim(sCcusto) <> '') Then
    Begin
      _DbEmpresaForn.Idempresa.AsFloat := liIdempresa;
      _DbEmpresaForn.Codcentrocusto.AsString := Trim(sCcusto);
    End
    Else
    Begin
      _DbEmpresaForn.Idempresa.Clear;
      _DbEmpresaForn.Codcentrocusto.Clear;
    End;

    If (liPlano > 0) Then
    Begin
      _DbEmpresaForn.Plano.AsFloat := liPlano;
      _DbEmpresaForn.Contacforn.AsString := Trim(sContacforn);
      _DbEmpresaForn.Contacdespesa.AsString := Trim(sContacdespesa);
      _DbEmpresaForn.Contacadiantamento.AsString := Trim(sContacadianto);
      TCtrlDocumento(fOwner).SetFieldValue(_DbEmpresaForn.Codsubconta, liCodSubConta);
    End
    Else
    Begin
      // André Pontes - 14/07/2003 - estava "_DbEmpresaForn.Clear"
      _DbEmpresaForn.Plano.Clear;
      _DbEmpresaForn.Contacforn.Clear;
      _DbEmpresaForn.Contacdespesa.Clear;
      _DbEmpresaForn.Contacadiantamento.Clear;
      _DbEmpresaForn.Codsubconta.Clear;
      // FIM André Pontes - 14/07/2003
    End;

    If Not _DbEmpresaForn.Insert Then Raise EdataBaseError.Create(_DbEmpresaForn.MessageInfo);
  End;

  If _Cds.Active Then _Cds.Close;
end;



procedure TForCli.CriaFornecedor(liIdPessoa, liIdEmpresa, liCodsubconta,
  liPlano, liIdRamoForne: LongInt; sCcusto, sContacadianto, sContacforn,
  sContacdespesa: String);
begin
  CriaFornserv(liIdPessoa);

  CriaEmpresaForn(liIdPessoa, liIdEmpresa, liPlano, liCodsubconta, sCcusto,
                  sContacadianto, sContacdespesa, sContacforn);

  If (liIdRamoForne > 0) then
     InsereRamoXForn(liIdpessoa, liIdRamoForne);
end;




procedure TForCli.CriaFornserv(liIdpessoa: LongInt);
begin
  _DbFornServ.Clear;
  _DbFornServ.Idpessoa.AsFloat := liIdpessoa;

  If Not _DbFornServ.LoadFromDb Then
  Begin
      _DbFornServ.Clear;
      _DbFornServ.Idpessoa.AsFloat := liIdpessoa;
      _DbFornServ.Flgass.AsFloat := 0;

      If Not _DbFornServ.Insert Then Raise EdataBaseError.Create(_DbFornServ.MessageInfo);
  End;

  If _Cds.Active Then _Cds.Close;
end;




function TForCli.CriaPessoa(sNome, sRazaoSocial, sDocumento: String;
  TipoPessoa: TTipoPessoa): Double;
begin
  _DbPessoa.Clear;
  _DbPessoa.Nome.AsString := sNome;
  _DbPessoa.Razaosocial.AsString := sRazaoSocial;
  _DbPessoa.Numdocumento.AsString := sDocumento;

  Case TipoPessoa of
    tpJuridica: _DbPessoa.Tipo.AsString := 'J';
    tpFisica: _DbPessoa.Tipo.AsString := 'F';
  End;

  If _DbPessoa.Insert Then
     Result := _DbPessoa.Idpessoa.AsFloat
  Else
  Begin
     Result := -1;
     TCtrlDocumento(Owner).MessageInfo := _DbFornServ.MessageInfo
  End;
end;




destructor TForCli.Destroy;
begin
   //27/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
   {
  _DbEmpresaForn.Free;
  _DbFornServ.Free;
  _DbEmpresaCliente.Free;
  _DbClientePess.Free;
  _DbFornXRamo.Free;
  _DbPessoa.Free;
  }
  FreeAndNil(_DbEmpresaForn);
  FreeAndNil(_DbFornServ);
  FreeAndNil(_DbEmpresaCliente);
  FreeAndNil(_DbClientePess);
  FreeAndNil(_DbFornXRamo);
  FreeAndNil(_DbPessoa);
  inherited;
end;




procedure TForCli.InsereRamoXForn(liIdpessoa, liIdRamoForn: LongInt);
begin
  _DbFornXRamo.Clear;
  _DbFornXRamo.Idpessoa.AsFloat := liIdpessoa;
  _DbFornXRamo.Idramofornecedor.AsFloat := liIdRamoForn;

  If Not _DbFornXRamo.LoadFromDb Then
  Begin
     _DbFornXRamo.Clear;
     _DbFornXRamo.Idpessoa.AsFloat := liIdpessoa;
     _DbFornXRamo.Idramofornecedor.AsFloat := liIdRamoForn;

     If Not _DbFornXRamo.Insert Then Raise EdataBaseError.Create(_DbFornXRamo.MessageInfo);
  End;

  If _Cds.Active Then _Cds.Close;
end;




function TForCli.Inserir(liIdPessoa, liIdEmpresa, liCodsubconta, liPlano,
  liIdRamoTipocli: LongInt; sCcusto, sContacadianto, sContacForCli,
  sContacdespesa: String; TipoForCli: TTipoForCli): Boolean;
Begin
   Result := False;

   _DbPessoa.Idpessoa.AsFloat := liIdPessoa;

   If _DbPessoa.LoadFromDb Then
   Begin
      Case TipoForCli of
      tfcFornecedor:
         CriaFornecedor(liIdPessoa, liIdEmpresa, liCodsubconta, liPlano,
                        liIdRamoTipocli, sCcusto, sContacadianto, sContacForCli,
                        sContacdespesa);
      tfcCliente:
         CriaCliente(liIdPessoa, liIdEmpresa, liCodsubconta, liPlano,
                     liIdRamoTipocli, sCcusto, sContacadianto, sContacForCli,
                     sContacdespesa);
      End;

      If (_DbPessoa.RazaoSocial.IsNull) And (Not _DbPessoa.Nome.IsNull) Then
      Begin
         _DbPessoa.RazaoSocial.AsString := _DbPessoa.Nome.AsString;
         If Not _DbPessoa.Update Then Raise EdataBaseError.Create(_DbPessoa.MessageInfo);
      End;

      If (Not _DbPessoa.RazaoSocial.IsNull) And (_DbPessoa.Nome.IsNull) Then
      Begin
         _DbPessoa.Nome.AsString := _DbPessoa.RazaoSocial.AsString ;
         If Not _DbPessoa.Update Then Raise EdataBaseError.Create(_DbPessoa.MessageInfo);
      End;

      Result := True;
   End
   Else
     TCtrlDocumento(Owner).MessageInfo := 'O pessoa referente ao IDPessoa ' + IntToStr(liIdPessoa) + ' não existe no banco';
end;




procedure TForCli.SetDataBaseName(const Value: String);
begin
  inherited;
  _DbEmpresaForn.DataBaseName := Value;
  _DbFornServ.DataBaseName := Value;
  _DbEmpresaCliente.DataBaseName := Value;
  _DbClientePess.DataBaseName := Value;
  _DbFornXRamo.DataBaseName := Value;
  _DbPessoa.DataBaseName := Value;
end;




{ TLote }

function TLote.BaixaDoc(licodocumento, liNumlote: LongInt): Boolean;
begin
   If liNumlote > 0 Then
      Result := TCtrlDocumento(Owner).ExecSql('UPDATE LOTEXDOCUM SET FLGBAIXA= ''B'' WHERE CODDOCUMENTO = '  + InttoStr(licodocumento) + ' AND NUMLOTE = ' + InttoStr(liNumlote))
   Else
      Result := TCtrlDocumento(Owner).ExecSql('UPDATE LOTEXDOCUM SET FLGBAIXA= ''B'' WHERE CODDOCUMENTO = '  + InttoStr(licodocumento));
end;




function TLote.BaixaLote(liNumlote: LongInt): Boolean;
begin
   Result := TCtrlDocumento(Owner).ExecSql('UPDATE LOTEPAGTO SET FLAGCANCEL = ''B'' WHERE NUMLOTE = '+ IntToStr(liNumlote)) And
             TCtrlDocumento(Owner).ExecSql('UPDATE LOTEXDOCUM SET FLGBAIXA= ''B'' WHERE  NUMLOTE = ' + InttoStr(liNumlote));
end;




procedure TLote.CalculaSaldo(liNumLote: LongInt);
begin
   _Cds.Data := TCtrlDocumento(Owner).GetDataPacket('SELECT SUM(LX.VALOR)AS VALORTOTAL  ' +
                              ' FROM LOTEXDOCUM LX, LOTEPAGTO LP ' +
                              ' WHERE (LX.NUMLOTE = ' + IntToStr(liNumLote) + ') AND (LP.FLAGCANCEL IS NULL) AND ' +
                              '       (LX.FLGBAIXA IS NULL) AND (LX.NUMLOTE = LP.NUMLOTE)');
   If _Cds.IsEmpty Then
     fSaldo := 0
   Else
     fSaldo := _Cds.Fields[0].Asfloat;

   If _Cds.Active Then _Cds.Close;

   _Cds.Data := TCtrlDocumento(Owner).GetDataPacket('SELECT SUM(VALOR) FROM LOTEXDOCUM WHERE NUMLOTE = '+ IntToStr(liNumLote));

   If _Cds.IsEmpty Then
      fValor := 0
   Else
      fValor := _Cds.Fields[0].Asfloat;

   If _Cds.Active Then _Cds.Close;
end;




procedure TLote.Clear;
begin
  inherited;                                                 
  fSaldo := 0;
  fValor := 0;
  fNumLote := 0;
  fCodPortForma := 0;
end;




function TLote.GetNumLote(liCodDocumento: LongInt): Boolean;
begin
   _Cds.Data := TCtrlDocumento(Owner).GetDataPacket('SELECT LX.NUMLOTE, LP.CODPORTFORMA ' +
                                                    ' FROM LOTEXDOCUM LX, LOTEPAGTO LP ' +
                                                    ' WHERE (LX.CODDOCUMENTO = ' + IntToStr(liCodDocumento) + ') AND (LP.FLAGCANCEL IS NULL) AND ' +
                                                    '       (LX.FLGBAIXA IS NULL) AND (LX.NUMLOTE = LP.NUMLOTE)');

   If Not _Cds.IsEmpty Then
   Begin
     fCodPortForma := _Cds.FieldByName('CODPORTFORMA').AsInteger;
     fNumLote      := _Cds.FieldByName('NUMLOTE').AsInteger;
     Result        := True;
   End
   Else
   Begin
     fCodPortForma := 0;
     fNumLote      := 0;
     Result        := False;
   End;

   If _Cds.Active Then _Cds.Close;
end;




function TLote.LiberaEmissao(liNumLote: LongInt;
  bExcluiLote: Boolean): Boolean;
begin
   If bExcluiLote Then
     Result := TCtrlDocumento(Owner).ExecSql('DELETE LOTEXDOCUM WHERE NUMLOTE = '+ IntToStr(liNumLote)) And
               TCtrlDocumento(Owner).ExecSql('DELETE LOTEPAGTO WHERE NUMLOTE = '+ IntToStr(liNumLote))
   Else
     Result := TCtrlDocumento(Owner).ExecSql('UPDATE LOTEPAGTO SET FLAGCANCEL = NULL, FLAGEMISSAO = NULL WHERE NUMLOTE = '+ IntToStr(liNumLote)) And
               TCtrlDocumento(Owner).ExecSql('UPDATE LOTEXDOCUM SET FLGBAIXA = NULL WHERE NUMLOTE = '+ IntToStr(liNumLote));
end;




