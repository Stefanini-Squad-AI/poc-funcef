function TCtrlDocumento.GetMaiorCR(sListaCodDocs: string): string;
var
  sSQL: string;
  cdsLocal: TCmClientDataSet;
begin
  cdsLocal := TCmClientDataSet.Create(nil);
  try

    Result := '';


    sSQL :=
      'SELECT CODCENTRORESPON, '           +
      '       NVL(SUM(VALOR),0) AS VALOR ' +
      'FROM   RATEIODOCUM '                +
      'WHERE  CODDOCUMENTO IN (' + sListaCodDocs + ') '  +
      'GROUP BY CODCENTRORESPON    '       +
      'ORDER BY VALOR DESC '               ;

    cdsLocal.Data := GetDataPacket(sSQL);

    Result := cdsLocal.FieldByName('CODCENTRORESPON').AsString;

  finally
    // 14/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
    cdsLocal.Close;

    FreeAndNil(cdsLocal);
  end;
end;

