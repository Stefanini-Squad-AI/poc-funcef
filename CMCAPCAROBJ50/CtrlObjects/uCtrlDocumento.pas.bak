function TCtrlDocumento.AcertaDifRateio(iNumdoc: Integer): Boolean;
  var qryRat,qryLanc, qryAlt  : TwwQuery;
      NumLanc,NumBordero : string;
begin


  if sistema.IdModulo <> 4 then
     Exit;

  try

    qryRat := TwwQuery.Create(Nil);
    qryLanc := TwwQuery.Create(Nil);
    qryAlt := TwwQuery.Create(Nil);

    qryRat.DatabaseName  := 'BaseDados';
    qryLanc.DatabaseName := 'BaseDados';
    qryAlt.DatabaseName  := 'BaseDados';


    NumLanc := '';
    NumBordero := '';

    qryLanc.Close;
    qryLanc.SQL.Text := ' SELECT L.LACNUMDOC FROM LANCAMENTO L WHERE L.CODDOCUMENTO = ' + IntToStr(iNumDoc);
    qryLanc.Open;

    qryLanc.First;

    if qryLanc.IsEmpty then
       Exit;

    qryLanc.Last;

    NumBordero := qryLanc.FieldByName('LACNUMDOC').AsString;


    qryLanc.Close;
    qryLanc.SQL.Text := 'SELECT M.CODLANCFINANC FROM MOVIMFINANC M WHERE M.NUMCHQBORDERO = ' + QuotedStr(NumBordero);
    qryLanc.Open;

    if qryLanc.IsEmpty then
       Exit;

    qryLanc.First;
    NumLanc := qryLanc.FieldByName('CODLANCFINANC').AsString;

{
    qryRat.Close;
    qryRat.SQL.Text := ' SELECT SUM(RA.VALOR) AS VALOR ' +
                       ' FROM RATEIOFINANC RA ' +
                       ' WHERE RA.CODLANCFINANC IN (' + NumLanc + ' )';
    qryRat.Open;
    qryRat.First;

    if qryRat.IsEmpty then
       Exit;

    qryLanc.Close;
    qryLanc.SQL.Text := ' SELECT SUM(L.LACVALOR) AS VALOR ' +
                        ' FROM   LANCAMENTO L, LANCTODOCUM LC '+
                        ' WHERE  L.LACNUMDOC = ' +  QuotedStr( NumBordero ) +
                        '        AND L.LACDEBCRE = ' +  QuotedStr('C') +
                        '        AND LC.Coddocumento = L.Coddocumento ' +
                        '        AND LC.OPERACAO = 5 ' +
                        '        AND L.LACNUMDOC = LC.Numrecibo';
    qryLanc.Open;
    qryLanc.First;

    if qryLanc.IsEmpty then
       Exit;

    if qryLanc.FieldByName('VALOR').AsFloat = qryRat.FieldByName('VALOR').AsFloat then
       Exit;
}

    qryRat.Close;
    qryRat.SQL.Text := ' SELECT RA.IDPLANOPREV as IDPLANOPREV, RA.VALOR AS VALOR ' +
                       ' FROM RATEIOFINANC RA ' +
                       ' WHERE RA.CODLANCFINANC IN (' + NumLanc + ' )';
    qryRat.Open;

    if qryRat.IsEmpty then
       Exit;

//    qryLanc.Close;
//    qryLanc.SQL.Text := ' SELECT L.IDPLANOPREV AS IDPLANOPREV, SUM(L.LACVALOR) AS VALOR ' +
//                        ' FROM   LANCAMENTO L, LANCTODOCUM LC '+
//                        ' WHERE  L.LACNUMDOC = ' +  QuotedStr( NumBordero ) +
//                        '        AND L.LACDEBCRE = ' +  QuotedStr('C') +
//                        '        AND LC.Coddocumento = L.Coddocumento ' +
//                        '        AND LC.OPERACAO = 5 ' +
//                        '        AND L.LACNUMDOC = LC.Numrecibo group by L.IDPLANOPREV ';
//    qryLanc.Open;
//    qryLanc.First;
//
//    if qryLanc.IsEmpty then
//       Exit;

    qryRat.First;
    while not qryRat.Eof do
    begin
       qryLanc.Close;
       {
       qryLanc.SQL.Text := ' SELECT L.IDPLANOPREV AS IDPLANOPREV, SUM(L.LACVALOR) AS VALOR ' +
                           ' FROM   LANCAMENTO L, LANCTODOCUM LC ' +
                           ' WHERE  L.LACNUMDOC = ' + QuotedStr(NumBordero) +
                           '        AND L.LACDEBCRE = ' + QuotedStr('C') +
                           '        AND LC.Coddocumento = L.Coddocumento ' +
                           '        AND LC.OPERACAO = 5 ' +
                           '        AND L.IDPLANOPREV = ' +  qryRat.FieldByName('IDPLANOPREV').AsString +
                           '        AND L.LACNUMDOC = LC.Numrecibo group by L.IDPLANOPREV ';
       }

       qryLanc.SQL.Text := ' SELECT L.IDPLANOPREV AS IDPLANOPREV, SUM(L.LACVALOR) AS VALOR ' +
                           ' FROM LANCAMENTO L ' +
                           ' WHERE L.PLNCODIGO IN ' +
                           '       (SELECT PLNCODIGO ' +
                           '          FROM LANCTODOCUM ' +
                           '         WHERE OPERACAO = 5 ' +
                           '           AND CODDOCUMENTO IN ' +
                           '               (SELECT CODDOCUMENTO ' +
                           '                  FROM RECBTOPAGTO R ' +
                           '                 WHERE R.CODLANCFINANC = ' + NumLanc + ' )) ' +
                           '   AND L.LACDEBCRE = ' + QuotedStr('C') +
                           '   AND L.IDPLANOPREV = ' +  qryRat.FieldByName('IDPLANOPREV').AsString + ' GROUP BY IDPLANOPREV ';

       qryLanc.Open;
       qryLanc.First;

       if qryLanc.IsEmpty then
         Exit;

       if qryLanc.FieldByName('VALOR').AsFloat <> qryRat.FieldByName('VALOR').AsFloat then
       begin
          qryAlt.Close;
          qryAlt.SQL.Text := ' UPDATE RATEIOFINANC ' +
                             ' SET VALOR = ' + StringReplace(qryLanc.FieldByName('VALOR').AsString, ',', '.', [rfReplaceAll, rfIgnoreCase]) +
                             ' WHERE CODLANCFINANC = ' + QuotedStr(NumLanc) + ' AND IDPLANOPREV = ' + qryLanc.FieldByName('IDPLANOPREV').AsString;
          qryAlt.ExecSQL;
       end;
       qryRat.Next;
    end;
  Finally
    FreeAndNil(qryRat);
    FreeAndNil(qryLanc);
    FreeAndNil(qryAlt);

  end;
end;

