function TCtrlDocumento.UpdateStatusBaixa(liCodDocumento: LongInt): Boolean;
var  sStatus: String;
begin
  Saldo.CalculaSaldo(liCodDocumento);
  sStatus := '';
  if IsFloatZero(Saldo.Valor) Or
     (_OperacaoDocLanc in [ odlLancaeBaixa ] ) then
    sStatus :='2'
  Else
  begin
    //sStatus := '0';                                     // edilaine - SOL 222006-17039 / PPM 712379 - comentado
    sStatus := IntToStr( _Documento.Status.AsInteger );   // edilaine - SOL 222006-17039 / PPM 712379
  end;

  Result := ExecSql('UPDATE DOCUMENTO SET STATUS = '''+sStatus+''' WHERE CODDOCUMENTO = '+IntToStr(liCodDocumento));
end;




function TCtrlDocumento.UpdateStatusBaixaAdianto(liCodDocumento,
  liPlnCodigo, iNumLancto: LongInt; dDataLancto: TDateTime; SistemaLancto: TSistemaLancto;
  bCancelaBaixa: Boolean = False): Boolean;
Var
   sDebCre: Char;
begin
   If Not bCancelaBaixa Then
   Begin
      Result := ExecSQL('UPDATE DOCUMENTO SET STATUS = ''0'', OPERACAO = ''15'' WHERE CODDOCUMENTO = '+ InttoStr(liCodDocumento) + ' AND OPERACAO = ''14''');

      If Result Then
      Begin
        Case SistemaLancto of
          slCar: sDebCre := 'C';
          slCap: sDebCre := 'D';
        Else
          sDebCre := ' ';
        End;

        If (Trim(sDebCre) <> 'C') And (Trim(sDebCre) <> 'D') Then
        begin
           MessageInfo := 'DebCre inválido para o CodDocumento: ' + FloatToStr(liCodDocumento);
           Raise Exception.Create(MessageInfo);
        end;


        If liPlnCodigo > 0 Then
           Result := ExecSQL('UPDATE LANCTODOCUM SET OPERACAO = ''15'', DATALANCTO = TO_DATE(''' + DateToStr(dDataLancto) + ''',''DD\MM\YYYY''), DEBCRE = ''' + sDebCre + ''', PLNCODIGO = ' + IntToStr(liPlnCodigo) + ' WHERE CODDOCUMENTO = '+ InttoStr(liCodDocumento) + ' AND OPERACAO = ''14''')
        Else
           Result := ExecSQL('UPDATE LANCTODOCUM SET OPERACAO = ''15'', DATALANCTO = TO_DATE(''' + DateToStr(dDataLancto) + ''',''DD\MM\YYYY''), DEBCRE = ''' + sDebCre + '''  WHERE CODDOCUMENTO = '+ InttoStr(liCodDocumento) + ' AND OPERACAO = ''14''');
      End;
   End
   Else
   Begin
      Case SistemaLancto of
        slCar: sDebCre := 'D';
        slCap: sDebCre := 'C';
      Else
        sDebCre := ' ';
      End;

      If (Trim(sDebCre) <> 'C') And (Trim(sDebCre) <> 'D') Then
      begin
         MessageInfo := 'DebCre inválido para o CodDocumento: ' + FloatToStr(liCodDocumento);
         Raise Exception.Create(MessageInfo);
      end;


      Result := ExecSQL('UPDATE DOCUMENTO SET STATUS = ''0'', OPERACAO = ''14'' WHERE CODDOCUMENTO = ' + InttoStr(liCodDocumento) +  ' AND OPERACAO = ''15''') And
                ExecSQL('UPDATE LANCTODOCUM SET OPERACAO = ''14'', PLNCODIGO = NULL ,DEBCRE = ''' + sDebCre + ''' WHERE CODDOCUMENTO = '+ InttoStr(liCodDocumento) + ' AND OPERACAO = ''15''') And
                ExecSQL('DELETE FROM RECBTOPAGTO WHERE CODDOCUMENTO = '+IntToStr(liCodDocumento)+' AND NUMLANCTO = '+IntToStr(iNumLancto));
   End;
end;

function TCtrlDocumento.UpdateStatusOrcamento(liCodDocumento: LongInt; sStatus: Char): Boolean;
begin
   Result := True;

   _Cds.Data := GetDataPacket(' SELECT ' +
                              '   IDRESERVAORCAMEN, VLRRESORCAMEN ' +
                              ' FROM ' +
                              '   RATEIODOCUM ' +
                              ' WHERE ' +
                              '   CODDOCUMENTO = ' + IntToStr(liCodDocumento) + ' AND ' +
                              '   IDRESERVAORCAMEN IS NOT NULL ');
   _Cds.First;

   While Not _Cds.Eof do
   Begin
      Result := ExecSQL(' UPDATE ' +
                        '   RESERVAORCAMEN ' +
                        ' SET ' +
                        '   FLGRESERVA = ' + QuotedStr(sStatus) + ', ' +
                        '   VLRCOMPROMISSO = VLRCOMPROMISSO - ' + FloatToStrCM(_Cds.FieldByName('VLRRESORCAMEN').AsFloat) +
                        ' WHERE ' +
                        '   IDRESERVAORCAMEN = ' + _Cds.FieldByName('IDRESERVAORCAMEN').AsString);

      If Not Result Then Raise Exception.Create(MessageInfo);

      _Cds.Next;
   End;

   If _Cds.ACtive Then _Cds.Close;
end;




function TCtrlDocumento.UpdateValorOrcamemto(liIdRateioDocum: LongInt;
  rValor: Double): Boolean;
begin
  Result := ExecSQL('UPDATE ' +
                    '  RATEIODOCUM ' +
                    'SET ' +
                    '  VLRRESORCAMEN = ' + FloatToStrCM(rValor) +
                    'WHERE ' +
                    '  IDRATEIODOCUM = ' + IntToStr(liIdRateioDocum));
end;




function TCtrlDocumento.RegAdiantamento(liCodDoc, liCodDocAdto,
  liIdEmpresa, liIdUsuario, liIdModulo, liPlanoConta: LongInt; sDataRegu: TDateTime; sDocumDoc, sDocumAdto,
  sNomeCliFor: String; rValor: Double; bUsaPlanoPatro: Boolean;
  SistemaLancto: TSistemaLancto): Boolean;
Var
  sDebCre :String;
Begin
  _liPlnCodigoAdianto := 0;

  sDebCre := '';

  Case SistemaLancto of
    slCap: sDebCre:='D';
    slCar: sDebCre:='C';
  End;

  If (Trim(sDebCre) <> 'C') And (Trim(sDebCre) <> 'D') Then
  begin
     MessageInfo := 'DebCre inválido para o CodDocumento: ' + FloatToStr(liCodDoc);
     Raise Exception.Create(MessageInfo);
  end;

  Prepare(OpLanctoDocum, odlRegDocumento);
  Lanctodocum.CodDocumento := liCodDoc;
  Lanctodocum.SetValues(sDataRegu, liCodDoc, 0, rValor, 0, rValor, 0, 0, 0,
  liIdUsuario, liIdEmpresa, 0, 0, 0, 0, 0, '17', '', '', '', '', '', '', '', sDebCre,
  liIdModulo, liPlanoConta, bUsaPlanoPatro, True);

  Result := Insert;

  If Result Then
  Begin
    Case SistemaLancto of
      slCap: sDebCre:='C';
      slCar: sDebCre:='D';
    End;

    If (Trim(sDebCre) <> 'C') And (Trim(sDebCre) <> 'D') Then
    begin
       MessageInfo := 'DebCre inválido para o CodDocumento: ' + FloatToStr(liCodDoc);
       Raise Exception.Create(MessageInfo);
    end;


    Prepare(OpLanctoDocum, odlRegAdiantamento);
    Lanctodocum.CodDocumento := liCodDocAdto;
    Lanctodocum.SetValues(sDataRegu, liCodDocAdto, 0, rValor, 0, rValor, 0, _liPlnCodigoAdianto, 0,
    liIdUsuario, liIdEmpresa, 0, 0, 0, 0, 0, '16', '', '', '', '', '', '', '', sDebCre,
    liIdModulo, liPlanoConta, bUsaPlanoPatro, True);

    Result := Insert;
  End;

  _liPlnCodigoAdianto := 0;
end;




function TCtrlDocumento.EstornaExcluiContab(liPlanilha, liEmpresa, liIdUsuario,
  liIdModulo: LongInt; dDataLancto: TDateTime; bUsaPlanopatro: Boolean): TTipoEstornoContab;
Begin
   If liPlanilha = 0 Then
      Result := tecExcluido
   Else
   Begin
      Result := tecErro;

      If _Periodo.RetornaPeriodoExercicioData(liEmpresa, DateToStr(dDataLancto)) Then
      Begin
         If _Periodo.TestaPeriodoBloqueado(liEmpresa, tbBloqOuInt, _Periodo.Periodo, _Periodo.Exercicio, False) Then
         Begin
            If _LancaContab.EstornaLancaContab(liIdUsuario, liPlanilha, liIdModulo, liEmpresa, bUsaPlanopatro,
               DateToStr(dDataLancto)) Then
               Result := tecEstornado
            Else
            begin
               MessageInfo := _LancaContab.MessageInfo;
               raise Exception.Create(MessageInfo);
            end
         End
         Else
          if _LancaContab.ExcluiLancaContab(liIdUsuario, liPlanilha, liIdModulo, 0, bUsaPlanopatro, True) Then
             Result := tecExcluido
          Else
          begin
             MessageInfo := _LancaContab.MessageInfo;
             raise Exception.Create(MessageInfo);
          end;
      End
      Else
      begin
        MessageInfo := _Periodo.MessageInfo;
        raise Exception.Create(MessageInfo);
      end;
   End;
end;




function TCtrlDocumento.Estornar(dData: TDateTime; liIdModulo, liIdEmpresa,
  liIdUsuario, liCodDocumento, liNumLanc, liPlanoConta: LongInt; bUsaPlanoPatro: Boolean;
  OperacaoEstorno: TOperacaoEstorno = oeSoProcessa; liCodDocumento2: LongInt = 0; liNumLanc2: LongInt = 0;
  bLancaContabEstornaAdianto: Boolean = True;
  bEstornoDocum: Boolean = false;
  AOpcaoEstornoFDO : TFDOOption = fdoEstornoBaixa): Boolean;
Var
  sEntradaSaida, sDebCre: String;
  rPlnCodigoEstorno, rCodLancFinanc, rPlnCodigo: Double;
  _LancaFinanc: TCtrlFinanc;
  DataEstorno: TDateTime;
  bEfetivaEstorno: Boolean;
  bDocumentoBaixado : Boolean;
begin
  Result := False;
  If Operacaoestorno in [oeDialogProcessa, oeAppServerProcessa] Then
  Begin
     DataEstorno := dData;

     If Operacaoestorno = oeDialogProcessa Then
        bEfetivaEstorno := InputDate('Estorno','Indique a data para estorno', DataEstorno)
     Else
        bEfetivaEstorno := True;

     If bEfetivaEstorno Then
     Begin
        If ConnectionSide = cnsclient Then
        Begin
           Result := Connection.AppServer.Estornar(DataEstorno, liIdModulo, liIdEmpresa, liIdUsuario, liCodDocumento,
                         liNumLanc, liPlanoConta, bUsaPlanoPatro, Integer(oeAppServerProcessa) );

           If Not Result Then MessageInfo := Connection.AppServer.MessageInfo;
        End
        Else
        Begin
           Try
             StartTransaction;

             Result := Estornar(DataEstorno, liIdModulo, liIdEmpresa, liIdUsuario, liCodDocumento,
                         liNumLanc, liPlanoConta, bUsaPlanoPatro//,
                         //Inicio - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
                         oeSoProcessa, 0, 0, TRUE, FALSE, AOpcaoEstornoFDO
                         //FIM - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
                         );

             if ( Result ) and ( liCodDocumento2 <> 0 ) and ( liNumLanc2 <> 0 ) then
                Result := Estornar( DataEstorno, liIdModulo, liIdEmpresa, liIdUsuario, liCodDocumento2,
                                    liNumLanc2, liPlanoConta, bUsaPlanoPatro, oeSoProcessa, 0, 0, false//,
                                    //Inicio - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
                                    FALSE, AOpcaoEstornoFDO
                                    //FIM - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
                                     );

             // início - Andrre Tavares - pendencia 17102 - 03/12/2004
             if bEstornoDocum then
               Result := result and ExecSql('UPDATE IMPOSTORETIDO SET FLGESTORNADO = ''S'' WHERE NUMLANCTO IS NULL AND CODDOCUMENTO = ' + formatFloat('0', liCodDocumento));
             // fim - Andrre Tavares - pendencia 17102 - 03/12/2004

             //início - andré tavares - péndência 25492 - 30/05/2007 - marca o imposto como estornado
               Result := result and ExecSql(' UPDATE IMPOSTORETIDO SET FLGESTORNADO = ''S'' '+
                                            ' WHERE CODDOCUMENTO = '+ intTostr(liCodDocumento) +' AND NUMLANCTO = '+ inttoStr(liNumLanc) + ' AND '+
                                            '       NUMLANCTO IN (SELECT NUMLANCTO FROM LANCTODOCUM WHERE CODDOCUMENTO = '+ intTostr(liCodDocumento) +' AND OPERACAO = ''4'' AND NUMLANCTO = '+ inttoStr(liNumLanc) +') AND '+
                                            '       CODDOCUMENTO NOT IN (SELECT CODDOCUMENTO FROM LANCIRRF WHERE CODDOCUMENTO IS NOT NULL) ');
             //fim - andré tavares - péndência 25492 - 30/05/2007 - marca o imposto como estornado

             //pendência 26790 - 23/01/2008 - se o documento está sendo estornado, seus impostos acumulados também serão e não haverá nada de impostos acumulado para o mesmo.
             // portanto devemos exclí-los da tabela DOCXIMPOSTOACUM
             result := result and ExecSql(' DELETE FROM DOCXIMPOSTOACUM WHERE CODDOCUMENTO = '+ intTostr(liCodDocumento));

            // Alex 29/11/04
            if not Result then raise exception.create(messageinfo);

            //David - Pendência 25771

            if (_OperacaoPrepare = OpLanctoDocum) then //andré tavares - pendência 26554 - 29/10/2007
              result := ExcluirRAD(liCodDocumento);//André Tavares - pendência 22005 - 17/04/2006

            If Not Result Then Raise Exception.Create(MessageInfo); //andre tavares - pendencia 21603 - 02/08/2006

            If Result Then Commit Else Rollback;
           Except
             On E:Exception Do
             Begin
               Rollback;
               MessageInfo := E.Message;
             End;
           End;
        End;
     End
     Else
        MessageInfo := 'O Estorno não foi efetivado.';
  End
  Else
  Begin
     If liNumLanc  = 0 then
     Begin
        //If Not UpdateStatusOrcamento(liCodDocumento,'A') Then Exit;

        _DtmCapCarObj.SqlLancEstornoDoc.Prepare;
        _DtmCapCarObj.SqlLancEstornoDoc.ParamByName('CODDOCUMENTO').AsFloat := liCodDocumento;
        _DtmCapCarObj.SqlLancEstornoDoc.Open;

     end
     else
     Begin
        _DtmCapCarObj.SqlLancEstornoLanc.Prepare;
        _DtmCapCarObj.SqlLancEstornoLanc.ParamByName('CODDOCUMENTO').AsFloat := liCodDocumento;
        _DtmCapCarObj.SqlLancEstornoLanc.ParamByName('NUMLANCTO').AsFloat := liNumLanc;
        _DtmCapCarObj.SqlLancEstornoLanc.Open;
     end;

     _DtmCapCarObj.CdsLancEstorno.First;
     while not _DtmCapCarObj.CdsLancEstorno.Eof do
     Begin
        If _DtmCapCarObj.CdsLancEstorno.FieldByName('ESTORNO').AsInteger > 0 Then
        begin
           MessageInfo := 'Este lançamento foi estornado, proibido estornar.';
           Raise Exception.Create(MessageInfo);
        end;

        {** Lança Estorno no Financeiro, caso exista **}
        _LancaFinanc := TCtrlFinanc.Create(liIdEmpresa, liIdModulo, liIdUsuario, bUsaPlanoPatro);
        Try
           _LancaFinanc.InitializeAs(Self);
           _LancaFinanc.OpenTransaction := false;

           if _DtmCapCarObj.CdsLancEstorno.FieldByName('CODLANCFINANC').AsInteger <> 0 then
           Begin
              _DtmCapCarObj.SQLEstornoFinanc.Prepare;
              _DtmCapCarObj.SQLEstornoFinanc.ParamByName('CODLANCFINANC').AsFloat := _DtmCapCarObj.CdsLancEstorno.FieldByName('CODLANCFINANC').AsFloat;
              _DtmCapCarObj.SQLEstornoFinanc.Open;

              If _DtmCapCarObj.CdsEstornoFinanc.FieldByName('ENTRADASAIDA').AsString = 'E' then
                 sEntradaSaida:='S'
              else
                 sEntradaSaida:='E';

              If _Cds.Active Then _Cds.Close;

              If Not _LancaFinanc.LancaFinanceiro(_Cds.Data, liIdModulo,
                           _DtmCapCarObj.CdsEstornoFinanc.FieldByName('HISTPADFINAN').AsFloat,
                           _DtmCapCarObj.CdsEstornoFinanc.FieldByName('MOECODIGO').AsInteger,
                           liIdUsuario,
                           _DtmCapCarObj.CdsEstornoFinanc.FieldByName('CODPORTADOR').AsInteger,
                           liIdEmpresa,
                           _DtmCapCarObj.CdsEstornoFinanc.FieldByName('VALORLANCFINAN').AsFloat,
                           _DtmCapCarObj.CdsEstornoFinanc.FieldByName('VALOROUTRAMOEDA').AsFloat,
                           dData,
                           _DtmCapCarObj.CdsEstornoFinanc.FieldByName('DATACONCILIACAO').AsDateTime,
                           0,
                           _DtmCapCarObj.CdsEstornoFinanc.FieldByName('NUMCHQBORDERO').AsString,
                           sEntradaSaida,
                           'ESTORNO ' + _DtmCapCarObj.CdsEstornoFinanc.FieldByName('HISTORICO').AsString,
                           _DtmCapCarObj.CdsEstornoFinanc.FieldByName('STATUSCONCILIA').AsString,
                           rCodLancFinanc, rPlnCodigo, 0,
                           (_DtmCapCarObj.CdsLancEstorno.FieldByName('PLNCODIGO').AsInteger <> 0)) Then
              Begin
                MessageInfo := _LancaFinanc.MessageInfo;
                Abort;
              End;

              _DtmCapCarObj.SQLRateioFinanc.Prepare;
              _DtmCapCarObj.SQLRateioFinanc.ParamByName('CODLANCFINANC').AsFloat := _DtmCapCarObj.CdsLancEstorno.FieldByName('CODLANCFINANC').AsFloat;
              _DtmCapCarObj.SQLRateioFinanc.Open;

              _DtmCapCarObj.CdsRateioFinanc.First;
              While (not _DtmCapCarObj.CdsRateioFinanc.EOF) do
              Begin
                 If Not _LancaFinanc.LancaRateioFinanc(
                         _DtmCapCarObj.CdsRateioFinanc.FieldByName('UNIDNEGOC').AsInteger,
                         _DtmCapCarObj.CdsRateioFinanc.FieldByName('MOECODIGO').AsInteger,
                         liIdEmpresa,
                         _DtmCapCarObj.CdsEstornoFinanc.FieldByName('CODPORTADOR').AsInteger,
                         (_DtmCapCarObj.CdsRateioFinanc.FieldByName('VALOR').AsFloat*(-1)),(_DtmCapCarObj.CdsRateioFinanc.FieldByName('VALOROUTRAMOEDA').AsFloat*(-1)),
                         _DtmCapCarObj.CdsRateioFinanc.FieldByName('CODTIPRECDES').AsString,
                         _DtmCapCarObj.CdsRateioFinanc.FieldByName('RECPAG').AsString,
                         _DtmCapCarObj.CdsRateioFinanc.FieldByName('CODCENTRORESPON').AsString,
                         dData, rCodLancFinanc, '',
                         _DtmCapCarObj.CdsRateioFinanc.FieldByName('IDPROGRAMA').AsFloat,
                         _DtmCapCarObj.CdsRateioFinanc.FieldByName('IDPATRO').AsFloat,
                         _DtmCapCarObj.CdsRateioFinanc.FieldByName('IDPLANOPREV').AsFloat,
                         _DtmCapCarObj.CdsRateioFinanc.FieldByName('CODTIPDOC').AsFloat,
                         liPlanoConta,
                         // Alex 29/10/04 17193 - Nova Estrutura RATEIOFINANC.IDSEGREGACRITER
                         _DtmCapCarObj.CdsRateioFinanc.FieldByName('IDSEGREGACRITER').AsInteger) Then
                 Begin
                   MessageInfo := _LancaFinanc.MessageInfo;
                   Abort;
                 End;

                 _DtmCapCarObj.CdsRateioFinanc.Next;
              end;
           end;

           //27/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
           //_LancaFinanc.Free;
           FreeAndNil(_LancaFinanc)
        Except
          On E:Exception Do
          Begin
            //27/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
            //_LancaFinanc.Free;
            FreeAndNil(_LancaFinanc);
            If Trim(E.Message) <> '' Then Raise;
          End;
        End;

        {** Lança estorno contábil, caso exista **}
        if ( _DtmCapCarObj.CdsLancEstorno.FieldByName('PLNCODIGO').AsInteger <> 0 ) And
           bLancaContabEstornaAdianto then
        Begin
           If Not _LancaContab.EstornaLancaContab(liIdUsuario, _DtmCapCarObj.CdsLancEstorno.FieldByName('PLNCODIGO').AsInteger,
                  liIdModulo, liIdEmpresa, bUsaPlanoPatro, DateToStr(dData)) Then
           Begin
              MessageInfo := _LancaContab.MessageInfo;
              Exit;
           End;

           rPlnCodigoEstorno := _LancaContab.RetornoPlnCodigo;
        end
        Else
           if bLancaContabEstornaAdianto then
             rPlnCodigoEstorno := 0
           else
              rPlnCodigoEstorno :=  _LancaContab.RetornoPlnCodigo;

        If _DtmCapCarObj.CdsLancEstorno.FieldByName('DEBCRE').AsString = 'D' then
           sDebCre:='C'
        else
           sDebCre:='D';

        {** Lança o Estorno do Lançamento **}
        Prepare(OpLanctoDocum, TOperacaoDocLanc(StrToIntDef(Trim((_DtmCapCarObj.CdsLancEstorno.FieldByName('OPERACAO').AsString)),0)));

        Lanctodocum.CodDocumento := liCodDocumento;
        Lanctodocum.SetValues( dData, liCodDocumento, 0,
                 _DtmCapCarObj.CdsLancEstorno.FieldByName('VALOR').AsFloat,
                 _DtmCapCarObj.CdsLancEstorno.FieldByName('VALOROUTRAMOEDA').AsFloat,
                 _DtmCapCarObj.CdsLancEstorno.FieldByName('VALOR').AsFloat,
                 0, Round(rPlnCodigoEstorno), 0, liIdUsuario, liIdEmpresa, 0, 0, 0, 0,
                 _DtmCapCarObj.CdsLancEstorno.FieldByName('CODALTERADOR').AsInteger,
                 _DtmCapCarObj.CdsLancEstorno.FieldByName('OPERACAO').AsString,
                 '', '', '',
                 'ESTORNO '+ _DtmCapCarObj.CdsLancEstorno.FieldByName('HISTORICOCOMPL').AsString,
                 '', '', '', sDebCre, liIdModulo, liPlanoConta, bUsaPlanoPatro);


        // início - Andrre Tavares - pendencia 18508 - 23/02/2005
        if bEstornoDocum then
        begin
          Result := ExecSql('UPDATE IMPOSTORETIDO SET FLGESTORNADO = ''S'' WHERE NUMLANCTO IS NULL AND CODDOCUMENTO = ' + formatFloat('0', liCodDocumento));
        end;
        // fim - Andrre Tavares - pendencia 18508 - 23/02/2005

        //início - andré tavares - péndência 25492 - 30/05/2007 - marca o imposto como estornado
        Result := ExecSql(' UPDATE IMPOSTORETIDO SET FLGESTORNADO = ''S'' '+
                          ' WHERE CODDOCUMENTO = '+ intTostr(liCodDocumento) +' AND NUMLANCTO = '+ inttoStr(liNumLanc) + ' AND '+
                          '       NUMLANCTO IN (SELECT NUMLANCTO FROM LANCTODOCUM WHERE CODDOCUMENTO = '+ intTostr(liCodDocumento) +' AND OPERACAO = ''4'' AND NUMLANCTO = '+ inttoStr(liNumLanc) +') AND '+
                          '       CODDOCUMENTO NOT IN (SELECT CODDOCUMENTO FROM LANCIRRF WHERE CODDOCUMENTO IS NOT NULL) ');
        //fim - andré tavares - péndência 25492 - 30/05/2007 - marca o imposto como estornado


        //início andre tavares - pendência 23025
          //marcar o documento como estornado em seu(s) lote(s)
        result := ExecSql('UPDATE LOTEXDOCUM SET FLGESTORNO = ''S'' WHERE CODDOCUMENTO =  '+ formatFloat('0', liCodDocumento) );
        //fim andre tavares - pendência 23025


        //David - Pendência 25771
        if _OperacaoPrepare = OpDocumento then
          result := ExcluirRAD(liCodDocumento);//André Tavares - pendência 22005 - 17/04/2006

        If Not Result Then Raise Exception.Create(MessageInfo); //andre tavares - pendencia 21603 - 02/08/2006

        If Not Insert Then Exit;

        {** Insere o RecbToPagto Referente ao Estorno **}
        if _DtmCapCarObj.CdsLancEstorno.FieldByName('CODPORTFORMA').AsInteger <> 0 then
        Begin
           If Not RecbToPagto.Inserir(liCodDocumento, Lanctodocum.NumLancto, liIdUsuario,
                               Trunc(rCodLancFinanc),
                               _DtmCapCarObj.CdsLancEstorno.FieldByName('CODPORTFORMA').AsInteger,
                               _DtmCapCarObj.CdsLancEstorno.FieldByName('NUMLOTE').AsInteger,
                               0, 0, _DtmCapCarObj.CdsLancEstorno.FieldByName('NUMCHQBORDERO').AsString,
                               DateToStr(dData), DateToStr(dData)) Then Exit;
        end;

        //Grava o Estorno do Lançamento de Origem
        _DtmCapCarObj.SQLUpdLancEstorno.Prepare;
        _DtmCapCarObj.SQLUpdLancEstorno.ParamByName('ESTORNO').AsFloat := Lanctodocum.NumLancto;
        _DtmCapCarObj.SQLUpdLancEstorno.ParamByName('CODDOCUMENTO').AsFloat := liCodDocumento;
        _DtmCapCarObj.SQLUpdLancEstorno.ParamByName('NUMLANCTO').AsFloat := _DtmCapCarObj.CdsLancEstorno.FieldByName('NUMLANCTO').AsFloat;
        If Not ExecSQL(_DtmCapCarObj.SQLUpdLancEstorno.SqlChanged) Then Exit;

        //Grava o Estorno no Lançamento do Estorno
        _DtmCapCarObj.SQLUpdLancEstorno.Prepare;
        _DtmCapCarObj.SQLUpdLancEstorno.ParamByName('ESTORNO').AsFloat := _DtmCapCarObj.CdsLancEstorno.FieldByName('NUMLANCTO').AsFloat;
        _DtmCapCarObj.SQLUpdLancEstorno.ParamByName('CODDOCUMENTO').AsFloat := liCodDocumento;
        _DtmCapCarObj.SQLUpdLancEstorno.ParamByName('NUMLANCTO').AsFloat := Lanctodocum.NumLancto;
        If Not ExecSQL(_DtmCapCarObj.SQLUpdLancEstorno.SqlChanged) Then Exit;

        _DtmCapCarObj.CdsLancEstorno.Next;
     end;

     //Inicio - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662
     if AOpcaoEstornoFDO in [fdoEstornoBaixa, fdoEstornoAP] Then
        _Orcamento.FDO(AOpcaoEstornoFDO, _DtmCapCarObj.CdsLancEstorno);
     //Fim    - Vander Campos - SOL: 172384/9603 - KINTANA: 1661662

     If Not UpdateStatusBaixa(liCodDocumento) Then Exit;

     Result := True;
  End;


end;




function TCtrlDocumento.LancaRateioContab(liCodDocumento,
                                          liCodAlterador,
                                          iCodPortForma,
                                          liPlanoConta,
                                          liUnidNegocioLancto,
                                          liIdEmpresa,
                                          liIdModulo,
                                          liIdUsuario,
                                          liPlano               : Integer;
                                          var liPlnCodigo       : Double;
                                          dDataLancto           : TDateTime;
                                          rValor,
                                          rValorOM              : currency;  // Edilaine - SOL 124845-14262 / KTN 1977287
                                          iOperacao             : Integer;
                                          sDebCre,
                                          sHistoricoCompl,
                                          sNumChqBord,
                                          sContaBaixa           : String;
                                          liSubContaBaixa       : Integer;
                                          bUsaPlanoPatro        : Boolean;
                                          var liPlnAntecipa     : Double;
                                          bContabAlteradores    : Boolean = False { Robson Andrade SOL 253577-17779 PPM 1073241 }
                                          ) : Boolean;
Var
   bRateiaD, bRateiaC, bJuntaD, bJuntaC, bLancaRateioAlterador, bUsaCCustoDoc: Boolean;

   // Alex 30/01/2007 - o bJunta passa a ser sempre true, foi criada um atributo
   // na tabela lançamento CODDOCUMENTO, para não juntar documentos distintos
   // na contabilização da conta de baixa.
   iCodDocumentoD, iCodDocumentoC: integer;

   X,i : Integer;
   liUnidNegDoc, liUnidNegD, liPlanoPrevD, liPatroD, liUnidNegC, liPlanoPrevC,
   liPatroC, liUnidNegPag, iNumRateioLancamento: LongInt;
   sOperacao, sSubContaAltPag, sHistorico, sHistoricoD, sHistoricoC,
   sDocCodCentroCusto, sDocPlaconta, sHistCompl, sDocCodSubConta,
   sDocCompl, sCliDocCompl, sCodCentroCusto, sPlaconta, sConverte,
   sCCustD, sContaD, sSubContaD, sCCustC, sContaC, sSubContaC,
   sContaAlterador, sCodCentroCustoAlterador, sSql: String;
   rValorD, rValorC, rValorOMD, rValorOMC: Double;
   // 27/12/03 Alex
   bMultiplasContasBaixa, bAntecipacao : boolean;
   dtLancamentoDoc : TDateTime;
   sPlacontaDocOriginal : string;
   // 12/01/04 Alex 14451
   iIdSegregaCriter: integer;
   dDataSegregaCriter: tDateTime;
   // 20/01/04 Alex 14451

   // Marcio Motta - 17317 - 25/04/2005
   histNumCHQBord,        {Tipos de Históricos = 1}
   histNumSLIP,           {Tipos de Históricos = 1}
   histNumLOTE,           {Tipos de Históricos = 1}
   histFornLOTE,           {Tipos de Históricos = 1} //andré tavares - pendência 24792 - 13/04/2007
   histORDEMdePAGO,       {Tipos de Históricos = 1}
   histPORTFORMA,         {Tipos de Históricos = 1}
   histPORTCONTA,         {Tipos de Históricos = 1}
   histNumRECIBOPAGTO,     {Tipos de Históricos = 1}
   histNODOCUMENTO,       {Tipos de Históricos = 1,2,3,4}
   histCOMPLDOCUMENTO,    {Tipos de Históricos = 1,2,3,4}
   histRAZAOSOCIAL,       {Tipos de Históricos = 1,2,3,4}
   histHISTORICOCOMPL,    {Tipos de Históricos = 1,2,3,4}
   histNumAP,             {Tipos de Históricos = 1,2,3,4}
   histNOMEALTERADOR,     {Tipos de Históricos =     3}
   histDATAPROGRAMADA,    {Tipos de Históricos =   2,  4}
   histTIPODOCUMENTO,     {Tipos de Históricos =   2,  4}
   histDATAVENCIMENTO, histDSCLANCAMENTO, {Tipos de Históricos =   2,  4}
   sSqlHst: String;

   bEstorno : boolean;  //andre tavares pendencia 17317

   _cdsLocal: TClientDataSet;

   oObj : TControl;

   cdsTemp: TClientDataSet;
   //Cássio
   sContaRevert : string;
   //Cássio


   //início - André Tavares - 20317 - faz a reversão da antecipação de receita
   function ReverteAtecip(sCCustC,
                          sContaC,
                          sSubContaC,
                          sCCustD,
                          sContaD,
                          sSubContaD : string;
                          rValor: extended): Double;
     var sHistorico: string;
   begin
     result := -1;

     sHistorico := 'Reversão da antecipação de receita do Doc.  ' +
       Trim(sCliDocCompl) + ' ' + trim(sHistCompl);

     sHistorico  := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                           liIdModulo,5,
                                           sHistorico,
                                           [histNODOCUMENTO,
                                           histCOMPLDOCUMENTO,
                                           histRAZAOSOCIAL,
                                           histDSCLANCAMENTO,
                                           histNumCHQBord,
                                           histNumSLIP,
                                           histHISTORICOCOMPL,
                                           histNumLote]);//andré tavares - 11/04/2007 - pendência 25018


      _LancaContab.InsereLancaContab('2',
                                      liIdEmpresa,
                                      liIdModulo,
                                      liIdUsuario,
                                      liPlanoConta,
                                      liUnidNegD,
                                      StrToIntDef(ssubcontaD,0),
                                      StrToIntDef(ssubcontaC,0),
                                      liPlanoPrevD,
                                      liPatroD,
                                      liPlnAntecipa,
                                      0,
                                      DateToStr(dtLancamentoDoc),
                                      sDocCompl,
                                      sHistorico,
                                      '',
                                      '',
                                      '',
                                      '',
                                      '03',
                                      sCCustD,
                                      sContaD,
                                      sCCustC,
                                      sContaC,
                                      '',
                                      rValor,
                                      false,
                                      busaPlanoPatro,
                                      // 12/01/04 Alex 14451
                                      iIdSegregaCriter, dDataSegregaCriter);

     result := _LancaContab.RetornoPlnCodigo;
   end;
   //fim - André Tavares - 20317 - faz a reversão da antecipação de receita

   function eEstorno: Boolean;
   var
     _cdsLanctoDocum : TclientDataset;
   begin
     _cdsLanctoDocum := tClientDataset.Create(nil);
     try
       Result := False;
       _cdsLanctoDocum.data := getDataPacket(
           ' SELECT D.STATUS, D.RECPAG, L.CODDOCUMENTO, L.ESTORNO, L.OPERACAO, L.DEBCRE '+
           ' FROM DOCUMENTO D, LANCTODOCUM L '+
           ' WHERE D.CODDOCUMENTO = '+ IntToStr(liCodDocumento)+ ' AND '+
           ' D.STATUS = ''2'' AND L.OPERACAO = ''5'' AND '+
           ' L.CODDOCUMENTO = D.CODDOCUMENTO '
           );
       _cdsLanctoDocum.First;
       Result := not _cdsLanctoDocum.IsEmpty;
     finally
       FreeAndNil(_cdsLanctoDocum);
     end;
   end;
   //fim - andre tavares - 17317


   {** Verifica se existe relacionamento de Alterador X Conta X CC **}
   Function ExisteTabelaAranhaAlterador: Boolean;
   var
     cdsLocal: TClientDataset;
   Begin
     cdsLocal := TClientDataSet.Create( nil );
     try
      cdsLocal.Data := GetDataPacket(
        'SELECT COUNT(IDALTXCCXPRGXCONTA) FROM ALTXCCXPRGXCONTA WHERE CODALTERADOR = ' +
          IntToStr(liCodAlterador)
        );
      Result := ( cdsLocal.Fields[ 0 ].AsInteger > 0 );
     finally
       FreeAndNil( cdsLocal );
     end;
   End;

   {** Faz o rateio do lançamento proporcional ao documento de origem **}
   procedure BuscaRateio;
   Var
     rVerificaTot, rVerificaTotOm, rValTot, rSaldo: currency;  // Edilaine - SOL 124845-14262 / KTN 1977287
     sNumFatura, sNodocumento: String;
     cdsLocal: TClientDataSet;

     // Edilaine - SOL 124845-14262 / KTN 1977287
     bArredonda5    : boolean;
     cdsFirstRat    : TClientDataSet;
     iPosFirstRat,x : integer;
     bBaixaFinal    : boolean;
     sSQL           : string;
     // Edilaine - SOL 124845-14262 / KTN 1977287

     //bRateioFinancDoc: Boolean; // Alterado por FHBS - SOL: 124845
     //X: Integer; // Alterado por FHBS - SOL: 124845

   Begin
      cdsLocal := TClientDataSet.Create( nil );
      cdsFirstRat := TClientDataSet.Create( nil );  // Edilaine - SOL 124845-14262 / KTN 1977287
      try
        if ( liCodAlterador > 0 )  then
        begin
           cdsLocal.Data := GetDataPacket(
             ' SELECT FLGUSACCUSTODOC FROM TIPOALTERADOR WHERE CODALTERADOR = ' +
               IntToStr(liCodAlterador)
             );
           bUsaCCustoDoc := (cdsLocal.FieldByName('FLGUSACCUSTODOC').AsString = 'S');
        end
        else
           bUsaCCustoDoc := False;

        bLancaRateioAlterador := ((liCodAlterador > 0) And (ExisteTabelaAranhaAlterador Or bUsaCCustoDoc));

        cdsLocal.Close;   // 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
        cdsLocal.Data := GetDataPacket(
          'SELECT NODOCUMENTO, OPERACAO, PLACONTA FROM DOCUMENTO WHERE CODDOCUMENTO =  ' +
            IntToStr(liCodDocumento)
          );

        sOperacao := Trim( cdsLocal.Fieldbyname( 'OPERACAO' ).AsString );
        sNodocumento := cdsLocal.fieldByName( 'NODOCUMENTO' ).asString;

        // Alex 27/12 - determinar se o documento é por múltiplas contas de baixa
        bMultiplasContasBaixa := cdsLocal.fieldbyname( 'PLACONTA' ).IsNull;

        If (not bMultiplasContasBaixa){andre tavares 18771 se for
        // parcelamento/englobamento de documentos MCCB então não entra aqui.}
        and ((sOperacao = '3') Or (sOperacao = '13')) Then
        Begin
           cdsLocal.Close;   // 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
           cdsLocal.Data := GetDataPacket(
             'SELECT NUMFATURA FROM DOCUMENTO WHERE CODDOCUMENTO =  ' +
               IntToStr(liCodDocumento)
             );

           sNumFatura := cdsLocal.fieldbyname('NUMFATURA').AsString;

           cdsLocal.Close;   // 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
           cdsLocal.Data := GetDataPacket(
             'SELECT SUM(R.VALOR) AS VALTOT ' +
             'FROM DOCUMENTO D, RATEIODOCUM R ' +
             'WHERE (D.NUMFATURA =  ' + sNumFatura + ') AND ' +
             '      (D.OPERACAO NOT IN (''3'',''13'')) AND (D.CODDOCUMENTO = R.CODDOCUMENTO)'
             );
           rValTot := cdsLocal.fieldbyname('VALTOT').AsFloat;

           cdsLocal.Close;   // 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
           If bLancaRateioAlterador Then
             cdsLocal.Data := GetDataPacket(
               'SELECT R.UNIDNEGOC, R.CODCENTROCUSTO, R.IDPROGRAMA, R.IDPLANOPREV, R.IDPATRO, SUM(R.VALOR) AS VALUNID ' +
               'FROM DOCUMENTO D, RATEIODOCUM R ' +
               'WHERE (D.NUMFATURA =  ' + sNumFatura + ') AND ' +
               '      (D.OPERACAO NOT IN (''3'',''13'')) AND (D.CODDOCUMENTO = R.CODDOCUMENTO) ' +
               'GROUP BY R.UNIDNEGOC, R.CODCENTROCUSTO, R.IDPROGRAMA, R.IDPLANOPREV, R.IDPATRO'
               )
           Else
             cdsLocal.Data := GetDataPacket(
               'SELECT R.UNIDNEGOC, R.IDPLANOPREV, R.IDPATRO, SUM(R.VALOR) AS VALUNID ' +
               'FROM DOCUMENTO D, RATEIODOCUM R ' +
               'WHERE (D.NUMFATURA =  ' + sNumFatura + ') AND ' +
               '      (D.OPERACAO NOT IN (''3'',''13'')) AND (D.CODDOCUMENTO = R.CODDOCUMENTO) '+
               'GROUP BY R.UNIDNEGOC, R.IDPLANOPREV, R.IDPATRO'
               );

        End
        Else
        Begin

           // 27/12/03 - Alex 5342 - Múltiplas contas de baixa
           if bMultiplasContasBaixa then begin
             cdsLocal.Close;   // 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
             cdsLocal.Data := GetDataPacket(
               'SELECT SUM(VALOR) AS VALTOT ' +
               ' FROM CCBAIXASXDOCUM WHERE CODDOCUMENTO =  ' +
               IntToStr(liCodDocumento)
               );
             rValTot := cdsLocal.fieldbyname('VALTOT').AsFloat;

             //início - andre tavares - 06/06/2007 - pendência 25283 - critica se o documento não contem nenhuma conta de baixa.
             if cdsLocal.IsEmpty then
             begin
               MessageInfo := 'Não foi possível identificar algum tipo de rateio neste documento: '+
                 sNodocumento +#13+
                 'Provalvelmente não possui conta(s) contábil(eis) de baixa.';
               Raise Exception.Create(MessageInfo);
             end;
             //fim - andre tavares - 06/06/2007 - pendência 25283 - critica se o documento não contem nenhuma conta de baixa.


             // Alex 30/12/03 - 5342 - Ratear Alterador pelas múltiplas contas de baixa
             // fazer join com rateiodocum para saber o centro de custo.
             sSql := '';


             { o rateio de alterador foi desabilitado para Multiplas Contas pois para contabilidade não há necessidade
               de abrir o rateio e para evitar nova duplicação de valores na tabela LANCAMENTO em função da consulta
               CCBAIXASXDOCUM x RATEIODOCUM  }
             bLancaRateioAlterador := false;   // Edilaine - SOL 208849 /  KTN 2016659

             if bLancaRateioAlterador then
             begin
               // 12/01/04 Alex 14451 - Incluído campo C.IDSEGREGACRITER
               sSql := sSql + 'SELECT C.UNIDNEGOC, R.CODCENTROCUSTO, R.IDPROGRAMA, C.IDPLANOPREV, C.IDPATRO, C.PLACONTA, C.IDSEGREGACRITER, SUM(r.VALOR) AS VALUNID ' + #13 +   // Edilaine - SOL 208849 /  KTN 2016659
                              //'      ,SUM(distinct NVL(R.VALOR,0)) + SUM(distinct NVL(R.SOMAVALOROPER,0)) - SUM(NVL(RFD.VALOR,0)) AS SALDO ' + #13 + // Alterado por FHBS - SOL: 124845
                              // Edilaine - SOL 208849 /  KTN 2016659
                              ' FROM /*CCBAIXASXDOCUM C,*/ RATEIODOCUM R, ' + #13 +
                              '   (select CODDOCUMENTO, UNIDNEGOC, IDPLANOPREV, IDPATRO, PLACONTA, IDSEGREGACRITER, sum(valor)  ' + #13 +
                              '    from CCBAIXASXDOCUM  ' + #13 +
                              '  group by CODDOCUMENTO, UNIDNEGOC, IDPLANOPREV, IDPATRO, PLACONTA, IDSEGREGACRITER ' + #13 +
                              '  ) C  ' + #13 +
                              // Edilaine - SOL 208849 /  KTN 2016659 - fim

                              //'     ,RATEIOFINANCDOC RFD ' + #13 + // Alterado por FHBS - SOL: 124845
                              ' WHERE r.CODDOCUMENTO =  ' + IntToStr(liCodDocumento) + #13 +

                              //' AND R.IDRATEIODOCUM = RFD.IDRATEIODOCUM(+) ' + #13 + // Alterado por FHBS - SOL: 124845
                              ' AND C.CODDOCUMENTO = R.CODDOCUMENTO ' + #13 +
                              ' AND C.UNIDNEGOC = R.UNIDNEGOC ' + #13 +
                              ' AND C.IDPLANOPREV = R.IDPLANOPREV ' + #13 +
                              ' AND C.IDPATRO = R.IDPATRO ' + #13;

               // alterador específico para uma conta contábil de baixa, sem rateio
               if (sContaBaixa <> '') and (_OperacaoDocLanc = odlAlterador) then
                 sSql := sSql + ' AND C.PLACONTA = ' + QuotedStr(sContaBaixa) + #13;

               // 12/01/04 Alex 14451 - Incluído campo C.IDSEGREGACRITER
               sSql := sSql + ' GROUP BY C.UNIDNEGOC, R.CODCENTROCUSTO, R.IDPROGRAMA, C.IDPLANOPREV, C.IDPATRO, C.PLACONTA, C.IDSEGREGACRITER ';

               // sSql := sSql + ' ORDER BY C.IDPLANOPREV '; // Alterado por FHBS - SOL: 124845

             end
             else
             begin

               // 12/01/04 Alex 14451 - Incluído campo IDSEGREGACRITER
               sSql := sSql + 'SELECT UNIDNEGOC, IDPLANOPREV, IDPATRO, PLACONTA, IDSEGREGACRITER, SUM(VALOR) AS VALUNID ' + #13 +
                              // Alterado por FHBS - SOL: 124845
                              {' ,(SELECT SUM(distinct NVL(RD.VALOR,0)) + SUM(distinct NVL(RD.SOMAVALOROPER,0)) - SUM(NVL(RFD.VALOR,0)) ' + #13 +
                              '    FROM RATEIOFINANCDOC RFD, RATEIODOCUM RD ' + #13 +
                              '   WHERE RFD.IDRATEIODOCUM(+) = RD.IDRATEIODOCUM ' + #13 +
                              '     AND RD.CODDOCUMENTO = '+IntToStr(liCodDocumento)+' ' + #13 +
                              '     AND RD.IDPLANOPREV = CC.IDPLANOPREV ' + #13 +
                              '     AND RD.IDPATRO = CC.IDPATRO) AS SALDO ' + #13 +}
                              // Fim - Alterado por FHBS - SOL: 124845
                              ' FROM CCBAIXASXDOCUM CC WHERE CODDOCUMENTO =  ' + IntToStr(liCodDocumento) + #13;

               // alterador específico para uma conta contábil de baixa, sem rateio
               if (sContaBaixa <> '') and (_OperacaoDocLanc = odlAlterador) then
                 sSql := sSql + ' AND PLACONTA = ' + QuotedStr(sContaBaixa) + #13;

               // 12/01/04 Alex 14451 - Incluído campo IDSEGREGACRITER
               sSql := sSql + ' GROUP BY UNIDNEGOC, IDPLANOPREV, IDPATRO, PLACONTA, IDSEGREGACRITER';

               //sSql := sSql + ' ORDER BY IDPLANOPREV '; // Alterado por FHBS - SOL: 124845
             end;

             cdsLocal.Close;   // 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
             cdsLocal.Data := GetDataPacket (sSql);

             // fim Alex 30/12/03 - 5342 - Ratear Alterador pelas múltiplas contas de baixa

           end
           else
           begin
           // fim 27/12/03 - Alex 5342 - Múltiplas contas de baixa estas cláusulas já existiam

             cdsLocal.Close;   // 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
             cdsLocal.Data := GetDataPacket(
               'SELECT SUM(VALOR) AS VALTOT ' +
               ' FROM RATEIODOCUM WHERE CODDOCUMENTO =  ' +
               IntToStr(liCodDocumento));
             rValTot := cdsLocal.fieldbyname('VALTOT').AsFloat;

             cdsLocal.Close;   // 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"

             If bLancaRateioAlterador Then
               cdsLocal.Data := GetDataPacket(
                 'SELECT RD.UNIDNEGOC, RD.CODCENTROCUSTO, RD.IDPROGRAMA, RD.IDPLANOPREV, RD.IDPATRO, SUM(RD.VALOR) AS VALUNID ' +
                 //'     ,SUM(distinct NVL(RD.VALOR,0)) + SUM(distinct NVL(RD.SOMAVALOROPER,0)) - SUM(NVL(RFD.VALOR,0)) AS SALDO ' + #13 + // Alterado por FHBS - SOL: 124845
                 '  FROM RATEIODOCUM RD ' +
                 //'      ,RATEIOFINANCDOC RFD ' + #13 + // Alterado por FHBS - SOL: 124845
                 ' WHERE RD.CODDOCUMENTO =  ' + IntToStr(liCodDocumento) +
                 //'   AND RD.IDRATEIODOCUM = RFD.IDRATEIODOCUM(+) ' + #13 + // Alterado por FHBS - SOL: 124845
                 ' GROUP BY RD.UNIDNEGOC, RD.CODCENTROCUSTO, RD.IDPROGRAMA, RD.IDPLANOPREV, RD.IDPATRO '
                 //' ORDER BY RD.IDPLANOPREV ' // Alterado por FHBS - SOL: 124845
                 )
             Else
               cdsLocal.Data := GetDataPacket(
                 'SELECT R.UNIDNEGOC, R.IDPLANOPREV, R.IDPATRO, SUM(R.VALOR) AS VALUNID ' +
                 //'     ,SUM(distinct NVL(R.VALOR,0)) + SUM(distinct NVL(R.SOMAVALOROPER,0)) - SUM(NVL(RFD.VALOR,0)) AS SALDO ' + #13 + // Alterado por FHBS - SOL: 124845
                 '  FROM RATEIODOCUM R ' +
                 //'      ,RATEIOFINANCDOC RFD ' + #13 + // Alterado por FHBS - SOL: 124845
                 ' WHERE R.CODDOCUMENTO =  ' + IntToStr(liCodDocumento) +
                 //'   AND R.IDRATEIODOCUM = RFD.IDRATEIODOCUM(+) ' + #13 + // Alterado por FHBS - SOL: 124845
                 ' GROUP BY R.UNIDNEGOC, R.IDPLANOPREV, R.IDPATRO '
                 //' ORDER BY R.IDPLANOPREV ' // Alterado por FHBS - SOL: 124845
                 );
           end;
        End;

        // procura o primeiro lançamento da rateiodocum para pegar o indice do objeto e lançar sobra, caso tenha
        cdsFirstRat.Close;
        cdsFirstRat.data := GetDataPacket('SELECT D.RECPAG, '+
                                          '       DECODE(D.RECPAG, ''R'', sum( decode(L.debcre, ''D'', L.valor, L.valor*-1)), '+
                                          '                             sum( decode(L.debcre, ''C'', L.valor, L.valor*-1))    '+
                                          '             ) as SALDOBAIXA  '+
                                          '  FROM LANCTODOCUM L, DOCUMENTO D '+
                                          ' WHERE L.CODDOCUMENTO = D.CODDOCUMENTO '+
                                          '   AND D.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
                                          ' GROUP BY D.RECPAG ');

//  if (_OperacaoDocLanc = odlAlterador) and (FOPeracaoLancto = olLancToDoc) then
    // Edilaine - SOL 124845-14262 / KTN 1977287 - comentado
        bBaixaFinal := (cdsFirstRat.Fields[1].asCurrency - rValor) = 0;

        if bBaixaFinal then
        begin
           sSQL :=

'SELECT X.UNIDNEGOC,  '+
'       X.IDPLANOPREV,  '+
'       X.IDPATRO,      '+
'       X.VALDOC,       '+
'       X.VLR_CONTABIL_BAIXA, '+
'       X.VLRACUM,            '+
'       CASE                  '+
'          WHEN (QTDALT > QTDPLN) AND (QTDPLN > 0) THEN (X.ALTERADOR_MEDIA-X.ALTERADOR_PLN)+X.ALTERADOR_PLN '+
'          WHEN (QTDALT = QTDPLN) THEN X.ALTERADOR_PLN  '+
'          ELSE X.ALTERADOR_MEDIA '+
'       END VLRALTERADOR          '+
'FROM (     '+
'SELECT R.UNIDNEGOC,              '+
'       R.IDPLANOPREV,            '+
'       R.IDPATRO,                '+
'       R.MAIORPLANO,           '+           // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190
'       A.VLRALTERADOR AS TOT_ALT,    '+     // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190
'       SUM(R.VALOR) AS VALDOC,   '+
'       VLR_CONTABIL_BAIXA,       '+
'       NVL(APLN.VLRALTERADOR, 0) ALTERADOR_PLN,                                                            '+
'       NVL(DECODE(APLN.VLRALTERADOR,                                                                       '+
'                      NULL,  ROUND((R.VALOR / A.VALOR_DOC) * NVL(A.VLRALTERADOR, 0), 2),                       '+
'                             NVL(APLN.VLRALTERADOR, 0)), 0 '+
'          ) VLRALTERADOR,    '+

'       DECODE(R.MAIORPLANO, ''N'', ROUND((R.VALOR / A.VALOR_DOC) * NVL(A.VLRALTERADOR, 0), 2),  /* -- calcula percentual    */       '+  // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190
'                                 ROUND((R.VALOR / A.VALOR_DOC) * NVL(A.VLRALTERADOR, 0), 2) +  /* -- calc percentual e calcula dif */ '+  // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190
'                                 (A.VLRALTERADOR -                                                                               '+  // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190
'                                 SUM( ROUND((R.VALOR / A.VALOR_DOC) * NVL(A.VLRALTERADOR, 0), 2) ) OVER(ORDER BY R.IDPLANOPREV)) '+  // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190
'             ) ALTERADOR_MEDIA,                                                                                                  '+  // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190

//'       ROUND((R.VALOR / A.VALOR_DOC) * NVL(A.VLRALTERADOR, 0), 2) ALTERADOR_MEDIA,                                 '+  // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190

'       0 as VLRACUM,  '+
'       ( SELECT COUNT(*)             '+
'           FROM LANCTODOCUM L2       '+
'          WHERE L2.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
'            AND L2.OPERACAO = 4 '+
'            AND L2.PLNCODIGO IS NOT NULL                   '+
'        ) QTDPLN,            '+

'       ( SELECT COUNT(*)     '+
'           FROM LANCTODOCUM L3  '+
'          WHERE L3.CODDOCUMENTO ='+FloatToStr(liCodDocumento) +
'            AND L3.OPERACAO = 4 '+
'        ) QTDALT            '+
'    FROM      '+
'        (select ra.coddocumento, sum(ra.valor) AS VALOR, ra.unidnegoc, ra.idplanoprev, ra.idpatro, '+
'                DECODE(LEAD(RA.IDPLANOPREV, 1, 0) OVER(ORDER BY RA.IDPLANOPREV),0,''S'',''N'') AS MAIORPLANO    ' + // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190
'           from RATEIODOCUM RA '+
'          where ra.coddocumento = '+FloatToStr(liCodDocumento) +
'          group by ra.coddocumento, ra.unidnegoc, ra.idplanoprev, ra.idpatro '+
'          ORDER BY RA.IDPLANOPREV  '+  // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190
'        ) R, '+

'       ( SELECT SUM(A2.VLRALTERADOR) VLRALTERADOR,         '+
'                A2.IDPLANOPREV, A2.UNIDNEGOC, A2.IDPATRO   '+
'           FROM                      '+
'       (SELECT DECODE(DC.RECPAG,     '+
'                      ''R'',           '+
'                      DECODE(DC.DEBCRE,                    '+
'                             ''D'',                          '+
'                             sum(LA.LACVALOR / 2),         '+
'                             sum(LA.LACVALOR / 2) * -1),   '+
'                      DECODE(DC.DEBCRE,      '+
'                             ''C'',            '+
'                             sum(LA.LACVALOR / 2),  '+
'                             sum(LA.LACVALOR / 2) * -1)) VLRALTERADOR,                                             '+
'               LA.IDPLANOPREV, LA.UNIDNEGOC, LA.IDPATRO  '+
'          FROM LANCAMENTO LA,                '+
'               (SELECT L.PLNCODIGO, D.RECPAG, L.DEBCRE   '+
'                  FROM LANCTODOCUM L, DOCUMENTO D        '+
'                 WHERE D.CODDOCUMENTO = L.CODDOCUMENTO   '+
'                   AND L.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
'                   AND L.OPERACAO = 4 '+
'               ) DC    '+
'         WHERE LA.PLNCODIGO = DC.PLNCODIGO               '+
'         GROUP BY DC.RECPAG, DC.DEBCRE, LA.IDPLANOPREV, LA.UNIDNEGOC, LA.IDPATRO ) A2                                                        '+
'         GROUP BY A2.IDPLANOPREV, A2.UNIDNEGOC, A2.IDPATRO '+
'       ) APLN, '+
'       (SELECT SUM(A1.VLRALTERADOR) VLRALTERADOR,      '+
'               A1.IDPLANOPREV,      '+
'               A1.VALOR_DOC,        '+
'               A1.UNIDNEGOC, A1.IDPATRO '+
'          FROM (SELECT DECODE(D.RECPAG,                '+
'                              ''R'',                     '+
'                              DECODE(LA.DEBCRE,        '+
'                                     ''D'',              '+
'                                     sum(LA.VALOR),    '+
'                                     sum(LA.VALOR) * -1),                                                          '+
'                              DECODE(LA.DEBCRE,    '+
'                                     ''C'',          '+
'                                     sum(LA.VALOR),  '+
'                                     sum(LA.VALOR) * -1)) VLRALTERADOR,                                            '+
'                       (select l1.valor            '+
'                          from lanctodocum l1      '+
'                         where L1.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
'                           and L1.operacao = 2) VALOR_DOC,                                                         '+
'                       R.IDPLANOPREV,       '+
'                       R.UNIDNEGOC, R.IDPATRO '+
'                  FROM LANCTODOCUM LA, DOCUMENTO D,                                                  '+

'                       (select ra.coddocumento, sum(ra.valor) AS VALOR, ra.unidnegoc, ra.idplanoprev, ra.idpatro '+
'                          from RATEIODOCUM RA                                                                    '+
'                         where ra.coddocumento = '+FloatToStr(liCodDocumento) +
'                         group by ra.coddocumento, ra.unidnegoc, ra.idplanoprev, ra.idpatro                      '+
'                        ) R                                                                                      '+

'                 WHERE D.CODDOCUMENTO = LA.CODDOCUMENTO         '+
'                   AND R.CODDOCUMENTO = LA.CODDOCUMENTO         '+
'                   AND LA.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
'                   AND LA.OPERACAO = 4 '+
'                 GROUP BY D.RECPAG, LA.DEBCRE, R.IDPLANOPREV, R.UNIDNEGOC, R.IDPATRO) A1                          '+
'         GROUP BY A1.IDPLANOPREV, A1.VALOR_DOC, A1.UNIDNEGOC, A1.IDPATRO '+
'       ) A,    '+
'       (SELECT sum(LA.LACVALOR / 2) VLR_CONTABIL_BAIXA, LA.IDPLANOPREV, LA.UNIDNEGOC, LA.IDPATRO                  '+
'          FROM LANCAMENTO LA   '+
'         WHERE LA.PLNCODIGO in (SELECT L.PLNCODIGO      '+
'                                  FROM LANCTODOCUM L    '+
'                                 WHERE L.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
'                                   AND L.OPERACAO = 5)  '+
'           AND LA.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +   // edilaine - SOL 237305 / PPM 483869
'         GROUP BY LA.IDPLANOPREV, LA.UNIDNEGOC, LA.IDPATRO '+
'       ) P     '+
' WHERE R.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
'   AND P.IDPLANOPREV(+) = R.IDPLANOPREV           '+
'   AND A.IDPLANOPREV(+) = R.IDPLANOPREV           '+
'   AND APLN.IDPLANOPREV(+) = R.IDPLANOPREV        '+

'   AND P.UNIDNEGOC(+) = R.UNIDNEGOC  '+
'   AND A.UNIDNEGOC(+) = R.UNIDNEGOC  '+
'   AND APLN.UNIDNEGOC(+) = R.UNIDNEGOC '+

'   AND P.IDPATRO(+) = R.IDPATRO        '+
'   AND A.IDPATRO(+) = R.IDPATRO        '+
'   AND APLN.IDPATRO(+) = R.IDPATRO     '+

' GROUP BY R.UNIDNEGOC,     '+
'          R.IDPLANOPREV,   '+
'          R.IDPATRO,       '+
'          R.MAIORPLANO,      '+ // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190
'          VLR_CONTABIL_BAIXA,                     '+
'          A.VLRALTERADOR,                         '+
'          A.VALOR_DOC,                            '+
'          R.VALOR,                                '+
'          APLN.VLRALTERADOR                       '+
' ORDER BY R.IDPLANOPREV       ' + // Edilaine Ferraresi/ Marcio Sanches Spinosa SOL 211487 KINTANA 2046190
') X       ';
{' GROUP BY x.UNIDNEGOC,   '+
'          x.IDPLANOPREV, '+
'          x.IDPATRO,     '+
'          X.VLR_CONTABIL_BAIXA, '+
'          X.VLRACUM, '+
'          X.QTDALT, '+
'          X.QTDPLN, '+
'          X.ALTERADOR_MEDIA, '+
'          X.ALTERADOR_PLN  ';
}


{
           cdsFirstRat.Data := GetDataPacket('SELECT R.UNIDNEGOC, R.IDPLANOPREV, R.IDPATRO, '+
                                             '       SUM(R.VALOR) AS VALDOC, VLR_CONTABIL_BAIXA, '+
//                                             '       NVL(A.VLRALTERADOR, 0) VLRALTERADOR,
//                                             '       ROUND((SUM(R.VALOR) / A.VALOR_DOC) * NVL(A.VLRALTERADOR,0),2) VLRALTERADOR, '+
                                             '   DECODE(APLN.VLRALTERADOR, NULL, ROUND((R.VALOR / A.VALOR_DOC) * NVL(A.VLRALTERADOR,0),2), '+
                                             '                                   NVL(APLN.VLRALTERADOR, 0)) VLRALTERADOR, '+
                                             '       0 as VLRACUM '+
                                             '  FROM RATEIODOCUM R, '+

                                             '        (SELECT  DECODE(DC.RECPAG, ''R'', DECODE(DC.DEBCRE, ''D'', sum(LA.LACVALOR / 2), sum(LA.LACVALOR / 2)*-1), '+
                                             '                                          DECODE(DC.DEBCRE, ''C'', sum(LA.LACVALOR / 2), sum(LA.LACVALOR / 2)*-1) '+
                                             '                ) VLRALTERADOR, LA.IDPLANOPREV '+
                                             '           FROM LANCAMENTO LA, '+
                                             '                (SELECT L.PLNCODIGO, D.RECPAG, L.DEBCRE '+
                                             '                   FROM LANCTODOCUM L, DOCUMENTO D '+
                                             '                  WHERE D.CODDOCUMENTO = L.CODDOCUMENTO '+
                                             '                    AND L.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
                                             '                    AND L.OPERACAO = 4 '+
                                             '                 ) DC  '+
                                             '           WHERE LA.PLNCODIGO = DC.PLNCODIGO '+
                                             '           GROUP BY DC.RECPAG,DC.DEBCRE, LA.IDPLANOPREV '+
                                             '        )  APLN, '+

                                             '       (SELECT SUM(A1.VLRALTERADOR) VLRALTERADOR, A1.IDPLANOPREV, A1.VALOR_DOC FROM ( '+
                                             '         SELECT DECODE(D.RECPAG, ''R'', DECODE(LA.DEBCRE, ''D'', sum(LA.VALOR ), sum(LA.VALOR)*-1), '+
                                             '                                        DECODE(LA.DEBCRE,''C'', sum(LA.VALOR),  sum(LA.VALOR)*-1)   '+
                                             '               ) VLRALTERADOR, '+
                                             '               (select l1.valor from lanctodocum l1 where L1.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +' and L1.operacao = 2) VALOR_DOC, '+
                                             '               R.IDPLANOPREV '+
                                             '          FROM LANCTODOCUM LA, DOCUMENTO D, RATEIODOCUM R '+
                                             '         WHERE D.CODDOCUMENTO = LA.CODDOCUMENTO '+
                                             '           AND R.CODDOCUMENTO = LA.CODDOCUMENTO '+
                                             '           AND LA.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
                                             '           AND LA.OPERACAO = 4 '+
                                             '         GROUP BY D.RECPAG,LA.DEBCRE, R.IDPLANOPREV '+
                                             '        ) A1 '+
                                             '        GROUP BY A1.IDPLANOPREV,A1.VALOR_DOC '+
                                             '       ) A, '+

{                                            '       (SELECT  DECODE(DC.RECPAG, ''R'', DECODE(DC.DEBCRE, ''D'', sum(LA.LACVALOR / 2), sum(LA.LACVALOR / 2)*-1), '+
                                             '                                         DECODE(DC.DEBCRE, ''C'', sum(LA.LACVALOR / 2), sum(LA.LACVALOR / 2)*-1)  '+
                                             '                      ) VLRALTERADOR, LA.IDPLANOPREV '+
                                             '            FROM LANCAMENTO LA, '+
                                             '                 (SELECT L.PLNCODIGO, D.RECPAG, L.DEBCRE '+
                                             '                    FROM LANCTODOCUM L, DOCUMENTO D '+
                                             '                   WHERE D.CODDOCUMENTO = L.CODDOCUMENTO '+
                                             '                     AND L.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
                                             '                     AND L.OPERACAO = 4 '+
                                             '                 ) DC '+
                                             '           WHERE LA.PLNCODIGO = DC.PLNCODIGO '+
                                             '           GROUP BY DC.RECPAG,DC.DEBCRE, LA.IDPLANOPREV '+
}
//                                             '       (SELECT sum(L4.LACVALOR / 2) VLRALTERADOR, L4.IDPLANOPREV  '+
//                                             '          FROM LANCAMENTO L4  '+
//                                             '         WHERE L4.PLNCODIGO in  '+
//                                             '               (SELECT L.PLNCODIGO '+
//                                             '                  FROM LANCTODOCUM L '+
//                                             '                 WHERE L.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
//                                             '                   AND L.OPERACAO = 4  '+
//                                             '               )  '+
//                                             '         GROUP BY L4.IDPLANOPREV '+
//                                             '       ) A, '+
{                                             '       (SELECT sum (LA.LACVALOR/2) VLR_CONTABIL_BAIXA, LA.IDPLANOPREV '+
                                             '          FROM LANCAMENTO LA '+
                                             '         WHERE LA.PLNCODIGO in (SELECT L.PLNCODIGO FROM LANCTODOCUM L '+
                                             '                                 WHERE L.CODDOCUMENTO = '+FloatToStr(liCodDocumento) +
                                             '                                   AND L.OPERACAO = 5 '+
                                             '                               ) '+
                                             '         GROUP BY LA.IDPLANOPREV ) P '+
                                             ' WHERE R.CODDOCUMENTO = '+IntToStr(liCodDocumento)+
                                             '   AND P.IDPLANOPREV(+) = R.IDPLANOPREV '+
                                             '   AND A.IDPLANOPREV(+) = R.IDPLANOPREV '+
                                             '   AND APLN.IDPLANOPREV(+) = R.IDPLANOPREV '+
                                             ' GROUP BY R.UNIDNEGOC, R.IDPLANOPREV, R.IDPATRO, '+
                                             '          VLR_CONTABIL_BAIXA, A.VLRALTERADOR, A.VALOR_DOC, R.VALOR, APLN.VLRALTERADOR '
                                            )
                                            }
        end
        else
        begin
          sSQL :=  'SELECT R.UNIDNEGOC, NVL(R.CODCENTROCUSTO, '' '') CODCENTROCUSTO, R.IDPROGRAMA, '+
                   '      R.IDPLANOPREV, R.IDPATRO '+
                   '  FROM RATEIODOCUM R '+
                   ' WHERE R.IDRATEIODOCUM = (SELECT MIN(IDRATEIODOCUM) FROM RATEIODOCUM WHERE CODDOCUMENTO = '+IntToStr(liCodDocumento)+')';

          iPosFirstRat := -1;
        end;

        cdsFirstRat.Data := GetDataPacket( sSQL );

        // Edilaine - SOL 124845-14262 / KTN 1977287 - fim

        iNumRateioLancamento := 0;
        rVerificaTot   := 0;
        rVerificaTotOm := 0;

{- andré tavares - 25/06/2008 - este código deve ficar no trecho mais acima
      //início - andre tavares - 06/06/2007 - pendência 25283 - critica se o documento não contem nenhuma conta de baixa.
      if _Cds.IsEmpty then
      begin
        MessageInfo := 'Não foi possível identificar algum tipo de rateio neste documento: '+ sNodocumento +#13+
                       'Provalvelmente não possui conta(s) contábil(eis) de baixa.';
        Raise Exception.Create(MessageInfo);
      end;
      //fim - andre tavares - 06/06/2007 - pendência 25283 - critica se o documento não contem nenhuma conta de baixa.
}

        //bRateioFinancDoc := Assigned(cdsLocal.FindField('SALDO')); // Alterado por FHBS - SOL: 124845


     bArredonda5 := _LancaContab.VerificaSobraRateio(cdsLocal, rValor, 0, 0, rValTot, 0, 0, 'VALUNID');  // Edilaine - SOL 124845-14262 / KTN 1977287


        cdsLocal.First;
        while not cdsLocal.Eof do
        begin
          iNumRateioLancamento := _LstRateioLancamento.Add(TRateioLancamento.Create);

          // 27/12/03 - Alex - 5342
          // Múltiplas contas de baixa
           if bMultiplasContasBaixa then begin
             TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).PlaConta :=
               cdsLocal.FieldByName('PLACONTA').AsString;

            // 01/12/04 Alex 14451
            // 28/01/01 Alex - se o critério for nulo, gravar -1
            if cdsLocal.FieldByName('IDSEGREGACRITER').IsNull then
              TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdSegregaCriter := -1
            else
              TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdSegregaCriter :=
                cdsLocal.FieldByName('IDSEGREGACRITER').AsInteger;
           end;

          // Alterado por FHBS - SOL: 124845
          {if bRateioFinancDoc then
          begin
            TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Saldo := cdsLocal.FieldByName('SALDO').AsFloat;
            TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).SaldoOM := cdsLocal.FieldByName('SALDO').AsFloat;
          end;    }
          // Fim - Alterado por FHBS - SOL: 124845

          If rValTot = 0 Then
          Begin
            TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).UnidNegocio :=
              cdsLocal.FieldByName('UNIDNEGOC').AsInteger;
            TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Valor   := 0;
            TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).ValorOm := 0;

            If bLancaRateioAlterador Then
            Begin
              TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).CentroCusto :=
                cdsLocal.FieldByName('CODCENTROCUSTO').AsString;
              TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPrograma :=
                cdsLocal.FieldByName('IDPROGRAMA').AsInteger;
            End
            Else
            Begin
              TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).CentroCusto := '';
              TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPrograma := 0;
            End;

            rVerificaTot  := rVerificaTot   + TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Valor;
            rVerificaTotOm:= rVerificaTotOm + TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).ValorOm;
          End
          Else
          Begin

            TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).UnidNegocio :=
              cdsLocal.FieldByName('UNIDNEGOC').AsInteger;

            TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Valor  :=
            // Eraldo Luis da Silva SOL 165317 KINTANA 1430837 INICIO
              //StrToFloat( FormatFloat( '#0.00', ( ( rValor   * cdsLocal.FieldByName('VALUNID').AsFloat ) / rValTot ) ) );
             //ArredondaRateio(( rValor   * cdsLocal.FieldByName('VALUNID').AsFloat ) / rValTot, bArredonda5);       // Edilaine - SOL 124845-14262 / KTN 1977287


            RoundCMLocal(RoundCMLocal(rValor * cdsLocal.FieldByName('VALUNID').AsFloat,2)/ rValTot,2);



            TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).ValorOm:=
              //StrToFloat( FormatFloat( '#0.00', ( ( rValorOM * cdsLocal.FieldByName('VALUNID').AsFloat ) / rValTot ) ) );
            //ArredondaRateio(( rValorOM   * cdsLocal.FieldByName('VALUNID').AsFloat ) / rValTot, bArredonda5);    // Edilaine - SOL 124845-14262 / KTN 1977287


            RoundCMLocal(RoundCMLocal(rValorOM * cdsLocal.FieldByName('VALUNID').AsFloat,2)/ rValTot,2);



             // Eraldo Luis da Silva SOL 165317 KINTANA 1430837 FIM

            // Alterado por FHBS - SOL: 124845
            {if bRateioFinancDoc then
            begin
              if TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Valor >=
                 TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Saldo then
              begin
                TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Valor :=
                               TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Saldo;
                TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Saldo := 0;
              end
              else
                TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Saldo :=
                               TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Saldo -
                               TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Valor;

              if TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).ValorOM >=
                 TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).SaldoOM then
              begin
                TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).ValorOM :=
                               TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).SaldoOM;
                TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).SaldoOM := 0;
              end
              else
                TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).SaldoOM :=
                               TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).SaldoOM -
                               TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).ValorOM;
            end;         }
            // Alterado por FHBS - SOL: 124845

            If bLancaRateioAlterador Then
            Begin
              TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).CentroCusto :=
                cdsLocal.FieldByName('CODCENTROCUSTO').AsString;
              TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPrograma :=
                cdsLocal.FieldByName('IDPROGRAMA').AsInteger;
            End
            Else
            Begin
              TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).CentroCusto := '';
              TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPrograma := 0;
            End;

            rVerificaTot  := rVerificaTot   + TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Valor;
            rVerificaTotOm:= rVerificaTotOm + TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).ValorOm;
          End;

          {**
            Inclusão do IDPLANOPREV, IDPATRO na query de contabilização de alteradores e
            da baixa. 26/04/2002
          **}
          If cdsLocal.FieldByName('IDPLANOPREV').AsInteger = 0 Then
             TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPlanoPrev := - 1
          Else
             TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPlanoPrev :=
               cdsLocal.FieldByName('IDPLANOPREV').AsInteger;

          If cdsLocal.FieldByName('IDPATRO').AsInteger = 0 Then
             TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPatrocinadora := -1
          Else
             TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPatrocinadora := cdsLocal.FieldByName('IDPATRO').AsInteger;

          // Edilaine - SOL 124845-14262 / KTN 1977287
          if (iPosFirstRat = -1) and (not bBaixaFinal) then
          begin
            // se ainda não for a baixa final, guardar o índice referente ao 1o lançamento
            // da RATEIODOCUM para lançar a diferença caso haja
            if (TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).UnidNegocio = cdsFirstRat.Fields[0].Value) and
               (TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPlanoPrev = cdsFirstRat.Fields[3].Value) then
            begin
              if (_OperacaoDocLanc = odlBaixa)  or
                 ((not bLancaRateioAlterador) and (_OperacaoDocLanc = odlAlterador)) or
                 ((bLancaRateioAlterador) and (_OperacaoDocLanc = odlAlterador) and
                 (TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).CentroCusto = Trim(cdsFirstRat.Fields[1].Value)) and
                 (TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPrograma  = cdsFirstRat.Fields[2].Value)) then
                 iPosFirstRat :=  iNumRateioLancamento
            end;
          end
          else if bBaixaFinal then
          begin
             //se for a baixa final acumular os rateios por plano
             if cdsFirstRat.Locate('UNIDNEGOC;IDPLANOPREV',
                                   VarArrayOf([TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).UnidNegocio,
                                               TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).IdPlanoPrev]), [loPartialKey]) then
             begin
               cdsFirstRat.edit;
               cdsFirstRat.FieldByName('VLRACUM').asCurrency := cdsFirstRat.FieldByName('VLRACUM').asCurrency + TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Valor;
               cdsFirstRat.Post;
             end;
          end;
          // Edilaine - SOL 124845-14262 / KTN 1977287 - fim

          cdsLocal.Next;
        end;
//***********************************************************************************

        // Edilaine - SOL 124845-14262 / KTN 1977287
        //if ( self.bFlgExecutaAcertoDifCentavos) then
        begin

          if (rVerificaTot <> rValor) and (not bBaixaFinal) then // and (bLancaRateioAlterador) and (_OperacaoDocLanc = odlAlterador)
          begin
            // verificar se houve sobra de centavos na contabilização
            rSaldo := TRateioLancamento(_LstRateioLancamento.Items[iPosFirstRat]).Valor + (rValor - rVerificaTot);

            TRateioLancamento(_LstRateioLancamento.Items[iPosFirstRat]).Valor := rSaldo;

            rSaldo := TRateioLancamento(_LstRateioLancamento.Items[iPosFirstRat]).ValorOm + (rValorOM - rVerificaTotOm);
            TRateioLancamento(_LstRateioLancamento.Items[iPosFirstRat]).ValorOm := rSaldo;
          end
          else if bBaixaFinal then
          begin
            // verificar se há diferença entre o valor apropriado por plano/patro e entre as baixas contabilizadas
            cdsFirstRat.first;
            while (not cdsFirstRat.eof) do
            begin
              rSaldo := cdsFirstRat.FieldByName('VALDOC').AsCurrency + cdsFirstRat.FieldByName('VLRALTERADOR').AsCurrency;
              rSaldo := rSaldo - (cdsFirstRat.FieldByName('VLRACUM').AsCurrency + cdsFirstRat.FieldByName('VLR_CONTABIL_BAIXA').AsCurrency);
              rSaldo := RoundCM(rSaldo,2);

              if ABS(rSaldo) > 0 then
                for x := 0 To (_LstRateioLancamento.Count - 1) do
                begin
                  if (TRateioLancamento(_LstRateioLancamento.Items[x]).UnidNegocio = cdsFirstRat.Fields[0].Value) and
                     (TRateioLancamento(_LstRateioLancamento.Items[x]).IdPlanoPrev = cdsFirstRat.Fields[1].Value) and
                     (TRateioLancamento(_LstRateioLancamento.Items[x]).Valor > 0) then
                  begin
                     TRateioLancamento(_LstRateioLancamento.Items[x]).Valor := TRateioLancamento(_LstRateioLancamento.Items[x]).Valor + rSaldo;

                     break;
                  end;
                end;

              cdsFirstRat.next;
            end;

          end;
        end;
        // Edilaine - SOL 124845-14262 / KTN 1977287 - fim

        // Alterado por FHBS - SOL: 124845
        {if bRateioFinancDoc then
        begin
          for x := 0 To (_LstRateioLancamento.Count - 1) do
          begin
            rSaldo := StrToFloat(FloatToStr(rValor)) - StrToFloat(FloatToStr(rVerificaTot));
            if (rSaldo <> 0) and (TRateioLancamento(_LstRateioLancamento.Items[x]).Saldo > 0) then
            begin
              rVerificaTot := rVerificaTot - TRateioLancamento(_LstRateioLancamento.Items[x]).Valor;

              if rSaldo >= TRateioLancamento(_LstRateioLancamento.Items[x]).Saldo then
              begin
                TRateioLancamento(_LstRateioLancamento.Items[x]).Valor :=
                          TRateioLancamento(_LstRateioLancamento.Items[x]).Valor +
                          TRateioLancamento(_LstRateioLancamento.Items[x]).Saldo;
                TRateioLancamento(_LstRateioLancamento.Items[x]).Saldo := 0;
              end
              else
              begin
                TRateioLancamento(_LstRateioLancamento.Items[x]).Valor :=
                          TRateioLancamento(_LstRateioLancamento.Items[x]).Valor + rSaldo;
                TRateioLancamento(_LstRateioLancamento.Items[x]).Saldo :=
                          TRateioLancamento(_LstRateioLancamento.Items[x]).Saldo - rSaldo;
              end;

              rVerificaTot := rVerificaTot + TRateioLancamento(_LstRateioLancamento.Items[x]).Valor;
            end;

            rSaldo := StrToFloat(FloatToStr(rValorOM)) - StrToFloat(FloatToStr(rVerificaTotOM));
            if (rSaldo <> 0) and (TRateioLancamento(_LstRateioLancamento.Items[x]).SaldoOM > 0) then
            begin
              rVerificaTotOM := rVerificaTotOM - TRateioLancamento(_LstRateioLancamento.Items[x]).ValorOM;

              if rSaldo >= TRateioLancamento(_LstRateioLancamento.Items[x]).SaldoOM then
              begin
                TRateioLancamento(_LstRateioLancamento.Items[x]).ValorOM :=
                          TRateioLancamento(_LstRateioLancamento.Items[x]).ValorOM +
                          TRateioLancamento(_LstRateioLancamento.Items[x]).SaldoOM;
                TRateioLancamento(_LstRateioLancamento.Items[x]).SaldoOM := 0;
              end
              else
              begin
                TRateioLancamento(_LstRateioLancamento.Items[x]).ValorOM :=
                          TRateioLancamento(_LstRateioLancamento.Items[x]).ValorOM + rSaldo;
                TRateioLancamento(_LstRateioLancamento.Items[x]).SaldoOM :=
                          TRateioLancamento(_LstRateioLancamento.Items[x]).SaldoOM - rSaldo;
              end;

              rVerificaTotOM := rVerificaTotOM + TRateioLancamento(_LstRateioLancamento.Items[x]).ValorOM;
            end;

          end;
        end;}
        // Fim - Alterado por FHBS - SOL: 124845

        // ERALDO LUIS DA SILVA SOL 165317 KINTANA 1430837 INICIO
        {TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Valor    :=
          TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).Valor + rSaldo;
        rSaldo := rValorOM - rVerificaTotOm;
        TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).ValorOm  :=
          TRateioLancamento(_LstRateioLancamento.Items[iNumRateioLancamento]).ValorOm + rSaldo;}

        // Edilaine - SOL 124845-14262 / KTN 1977287 - comentado
        {
        TRateioLancamento(_LstRateioLancamento.Items[0]).Valor    :=
          TRateioLancamento(_LstRateioLancamento.Items[0]).Valor + rSaldo;
        rSaldo := rValorOM - rVerificaTotOm;
        TRateioLancamento(_LstRateioLancamento.Items[0]).ValorOm  :=
          TRateioLancamento(_LstRateioLancamento.Items[0]).ValorOm + rSaldo;
        } // Edilaine - SOL 124845-14262 / KTN 1977287 - fim

      finally
        FreeAndNil( cdsLocal );
        FreeAndNil( cdsFirstRat ); // Edilaine - SOL 124845-14262 / KTN 1977287
      end;
   End;


begin
  cdsTemp := TClientDataSet.Create( nil );

  try
    try

      bAntecipacao := false; {andre tavares - antecipação de receita - pendencia 20317 - 21/03/2004}
      sPlacontaDocOriginal := '';
      bEstorno := eEstorno; //andre tavares - 17317
      Result := True;
      // Marcio Motta - 17317 - 25/04/2005
      histNumCHQBord     := '';
      histNumSLIP        := '';
      histORDEMdePAGO    := '';
      histPORTFORMA      := '';
      histPORTCONTA      := '';
      histNumRECIBOPAGTO := '';
      histNODOCUMENTO    := '';
      histCOMPLDOCUMENTO := '';
      histRAZAOSOCIAL    := '';
      histHISTORICOCOMPL := '';
      histNumAP          := '';
      histNOMEALTERADOR  := '';
      histDATAPROGRAMADA := '';
      histTIPODOCUMENTO  := '';
      histDATAVENCIMENTO := '';
      histDSCLANCAMENTO  := '';
      histNumLote        := ''; //andré tavares - 11/04/2007 - pendência 25018
      histFornLOTE       := ''; //andré tavares - 11/04/2007 - pendência 25018

      // Alex 30/01/2007 - o bJunta passa a ser sempre true, foi criada um atributo
      // na tabela lançamento CODDOCUMENTO, para não juntar documentos distintos
      // na contabilização da conta de baixa.
      bJuntaD    := True;
      bJuntaC    := True;
      iCodDocumentoD := -1;
      iCodDocumentoC := -1;

      {** Faz o rateio do lançamento proporcional ao documento de origem **}
      bLancaRateioAlterador := False;
      BuscaRateio;

      liUnidNegPag    := 0;
      sSubContaAltPag := '';
      sHistorico      := '';
      sHistoricoD     := '';
      sHistoricoC     := '';

      cdsTemp.Close;   // 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"

      {** Busca Parâmetros Contábeis do Documento **}
      cdsTemp.Data := GetDataPacket(
        ' SELECT D.NODOCUMENTO,    ' +
        ' D.COMPLDOCUMENTO, ' +
        ' D.CODSUBCONTA,    ' +
        ' D.CODDOCUMENTO,   ' +
        ' D.DATAVENCTO,     ' +
        ' D.PLACONTA,       ' +
        ' D.CODCENTROCUSTO, ' +
        ' P.RAZAOSOCIAL,    ' +
        ' L.HISTORICOCOMPL, ' +
        ' D.UNIDNEGOC,      ' +
        ' D.NUMSLIP,        ' +
        ' D.IDSEGREGACRITER, L.DATALANCTO, D.PLACONTAANT ' + //andre tavares - pendência 20316 - 31/01/2006 - inseri a coluna placontaant
        ' FROM  DOCUMENTO D,  ' +
        ' PESSOA P,     ' +
        ' LANCTODOCUM L ' +
        ' WHERE (D.CODDOCUMENTO = ' + IntToStr(liCodDocumento) + ' ) ' +
        '   AND (D.IDFORCLI = P.IDPESSOA)         ' +
        '   AND (D.CODDOCUMENTO = L.CODDOCUMENTO) ' +
        '   AND (D.OPERACAO = L.OPERACAO)'
        );

      sPlacontaDocOriginal :=
        cdsTemp.fieldByName('PLACONTA').asString; //André Tavares - 20317 - faz a reversão da antecipação de receita

      If cdsTemp.IsEmpty Then
      Begin
         Result := False;
         MessageInfo :=
           'Erro ao selecionar parâmetros contábeis para do Documento de origem do lançamento.';
         Exit;
      End;

      // 12/01/03 Alex 14451
      iIdSegregaCriter := -1;

      if not cdsTemp.FieldByName('IDSEGREGACRITER').IsNull then
        iIdSegregaCriter := cdsTemp.FieldByName('IDSEGREGACRITER').AsInteger;


      // Alex 12/04/07 - esta data deve ser passada sempre, pois caso o critério de segregação seja -1
      // a data será zerada na ctrllancamento. Caso esta data não seja passada teremos]
      // problemas com documentos com múltiplas contas de baixa.
      dDataSegregaCriter :=  cdsTemp.FieldByName('DATALANCTO').AsDateTime;
      // Fim 12/01/03 Alex 14451


      histNODOCUMENTO    := cdsTemp.FieldByName('NODOCUMENTO').AsString;
      histCOMPLDOCUMENTO := cdsTemp.FieldByName('COMPLDOCUMENTO').AsString;
      histRAZAOSOCIAL    := cdsTemp.FieldByName('RAZAOSOCIAL').AsString;
      histNumCHQBord     := sNumChqBord;
      histNumSLIP        := cdsTemp.FieldByName('NUMSLIP').AsString;
      histDATAVENCIMENTO := cdsTemp.FieldByName('DATAVENCTO').AsString;
      histHISTORICOCOMPL := cdsTemp.FieldByName('HISTORICOCOMPL').AsString + ' ' + sCtrlDocObs;  //Marcus Oliveria 23/03/2007 24309

      // Falta Buscar estes valores - Marcio Motta - 17317 - 25/04/2005
      histORDEMdePAGO    := '';
      histPORTFORMA      := '';
      histPORTCONTA      := '';
      histNumRECIBOPAGTO := '';
      histNumAP          := '';
      histNOMEALTERADOR  := '';
      histDATAPROGRAMADA := '';
      histTIPODOCUMENTO  := '';
      histNumLote        := ''; //andré tavares - 11/04/2007 - pendência 25018
      histFornLOTE       := ''; //andré tavares - 11/04/2007 - pendência 25018

      sSqlHst := '';
      // início - andre tavares - pendência 17317 - preenche as variáveis acima

      // 26/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation" - retirando o comando with
      //With TClientDataSet.Create(nil) do
      _cdsLocal := TClientDataSet.Create(nil);
      Try
        if iOperacao <> 4 then
        begin
          sSqlHst :=    ' SELECT LD.CODALTERADOR, LOTEPAGTO.NUMLOTE AS HISTNUMLOTE,        '+
                        '   LOTEPAGTO.FAVORECIDO AS FAVORECIDOLOTE,       '+ //andré tavares - pendência 25018 - 12/04/2007
                        '   PF.DESCRICAO AS HISTPORTFORMA,                '+
                        '   PC.DESCRICAO AS HISTPORTCONTA,                '+
                        '   LD.NUMRECIBO AS HISTNUMRECIBOPAGTO,           '+
                        '   DOC.NUMAPGR AS HISTNUMAP,                     '+
                        '   TA.DESCRICAO AS HISTNOMEALTERADOR,            '+
                        '   DOC.DATAPROGRAMADA AS HISTDATAPROGRAMADA,     '+
                        '   TD.DESCRICAO AS HISTTIPODOCUMENTO             '+
                        ' FROM LOTEPAGTO,                                 '+
                        '      LOTEXDOCUM LOTEX,                          '+
                        '      DOCUMENTO DOC,                             '+
                        '      PORTADORFORMA PF,                          '+
                        '      PORTADORCONTA PC,                          '+
                        '      LANCTODOCUM LD,                            '+
                        '      TIPODOCRECPAG TD,                          '+
                        '      TIPOALTERADOR TA                           '+
                        ' WHERE PF.CODPORTADOR   = PC.CODPORTADOR(+)      '+
                        ' AND DOC.CODPORTFORMA = PF.CODPORTFORMA(+)       '+
                        ' AND LOTEX.NUMLOTE    = LOTEPAGTO.NUMLOTE(+)     '+
                        ' AND DOC.CODDOCUMENTO = LOTEX.CODDOCUMENTO(+)    '+
                        ' AND LD.CODDOCUMENTO  = DOC.CODDOCUMENTO         '+
                        ' AND TD.CODTIPDOC     = DOC.CODTIPDOC            '+
                        ' AND LD.CODALTERADOR  = TA.CODALTERADOR(+)       '+
                        ' AND DOC.CODDOCUMENTO = '+ cdsTemp.FieldByName('CODDOCUMENTO').AsString +
                        ' AND LD.OPERACAO = DOC.OPERACAO ';
        end
        else
        begin
          sSqlHst :=  ' SELECT PF.DESCRICAO AS HISTPORTFORMA,            '+
                      '        PC.DESCRICAO AS HISTPORTCONTA,            '+
                      '        DOC.NUMAPGR AS HISTNUMAP,                 '+
                      '        TA.DESCRICAO AS HISTNOMEALTERADOR,        '+
                      '        DOC.DATAPROGRAMADA AS HISTDATAPROGRAMADA, '+
                      '        TD.DESCRICAO AS HISTTIPODOCUMENTO         '+
                      ' FROM DOCUMENTO DOC,                              '+
                      '      PORTADORFORMA PF,                           '+
                      '      PORTADORCONTA PC,                           '+
                      '      TIPODOCRECPAG TD,                           '+
                      '      TIPOALTERADOR TA                            '+
                      ' WHERE PF.CODPORTADOR   = PC.CODPORTADOR(+)       '+
                      '       AND DOC.CODPORTFORMA = PF.CODPORTFORMA(+)  '+
                      '       AND TD.CODTIPDOC     = DOC.CODTIPDOC       '+
                      '       AND TA.CODALTERADOR = '+ IntToStr(liCodAlterador) +
                      '       AND DOC.CODDOCUMENTO = '+ cdsTemp.FieldByName('CODDOCUMENTO').AsString;
        end;

        if not iOperacao in [4, 5] then // lancamento de baixa
          sSqlHst := sSqlHst + ' AND LD.OPERACAO = '+ intToStr(iOperacao);

        if not iOperacao in [1, 2, 3] then // se não for lancamento de de documento ou de alterador
          sSqlHst := sSqlHst + ' AND LD.CODALTERADOR  = '+ IntToStr(liCodAlterador);

        _cdsLocal.Data := GetDataPacket(sSqlHst);
        if not _cdsLocal.isEmpty then
        begin
          if iOperacao <> 4 then
          begin
            histNumRECIBOPAGTO := _cdsLocal.fieldByName('histNumRECIBOPAGTO').asString;
            histNumLOTE        := _cdsLocal.fieldByName('histNumLOTE').asString;
          end;
          histNumAP            := _cdsLocal.fieldByName('histNumAP').asString;
          histPORTFORMA        := _cdsLocal.fieldByName('histPORTFORMA').asString;
          histPORTCONTA        := _cdsLocal.fieldByName('histPORTCONTA').asString;
          histNOMEALTERADOR    := _cdsLocal.fieldByName('histNOMEALTERADOR').asString;
          histDATAPROGRAMADA   := _cdsLocal.fieldByName('histDATAPROGRAMADA').asString;
          histTIPODOCUMENTO    := _cdsLocal.fieldByName('histTIPODOCUMENTO').asString;
          //andré tavares - 11/04/2007 - pendência 25018
          if _cdsLocal.findField('FAVORECIDOLOTE') <> nil then
            histFornLOTE       := _cdsLocal.fieldByName('FAVORECIDOLOTE').asString;

        end;
      finally
         FreeAndNil(_cdsLocal);
      end;
      // fim - andre tavares - pendência 17317 - preenche as variáveis acima

      // 26/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation" - retirando o comando with
      //With TClientDataSet.Create(nil) do
      _cdsLocal := TClientDataSet.Create(nil);
      Try
        _cdsLocal.Data := GetDataPacket(
          'SELECT LP.NUMSLIP, LP.FAVORECIDO from LOTEPAGTO LP, LOTEXDOCUM LD ' + #13+
          '  WHERE LD.CODDOCUMENTO = '+ cdsTemp.FieldByName('CODDOCUMENTO').AsString+
          '  AND LP.NUMLOTE = '+  IntToStr(FLote.NumLote) +
          ' AND LP.NUMLOTE = LD.NUMLOTE'
          );
        _cdsLocal.First;
        if not _cdsLocal.Eof then
        begin
          histOrdemdePago := _cdsLocal.FieldByName('NUMSLIP').AsString;
        end;
      finally
        // 14/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
        FreeAndNil(_cdsLocal);
      end;

      sDocCodCentroCusto := cdsTemp.FieldByName('CODCENTROCUSTO').AsString;
      sDocPlaconta:= cdsTemp.FieldByName('PLACONTA').AsString;

      // se Operação 5 (BAIXA DE DOCUMENTO) - Aqui se muda a placonta de recebimento antecipado.
      if (iOperacao = 5) AND
      (_Documento.Recpag.AsString = 'R') { Baixa Antecipada de documento com placontaAnt
                                          (placonta de antecipação) só é válida para o CAR.
                                          *** Esta trava deve ser retirada se desejar fazê-lo para o CAP ***}
      then
      begin
        // 26/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation" - retirando o comando with
        //with TClientDataSet.Create(nil) do
        //begin
          _cdsLocal := TClientDataSet.Create(nil);
          try
            //pega a data de lançamento do documento
            _cdsLocal.data := getDataPacket(
              ' SELECT L.DATALANCTO FROM LANCTODOCUM L, DOCUMENTO D WHERE L.CODDOCUMENTO = '+
              cdsTemp.FieldByName('CODDOCUMENTO').AsString +
              ' AND L.CODDOCUMENTO = D.CODDOCUMENTO AND L.OPERACAO = D.OPERACAO '
              );

               //se o campo placontaAnt (placonta de recebimento antecipado estiver preechido e...
            if (trim( cdsTemp.fieldByName('PLACONTAANT').asString) <> '' ) and //placontaant
               //mes da baixa < mes de lançamento do documento
               (trunc(strToDate(formatDateTime('01/mm/yyyy', dDataLancto))) <
                 trunc(strToDate(formatDateTime('01/mm/yyyy', _cdsLocal.fieldByName('DATALANCTO').asDateTime))) )  then
            begin
              //esta será a placonta de contabilização (o campo PLACONTAANT da tabela DOCUMENTO).
              sDocPlaconta    := cdsTemp.FieldByName('PLACONTAANT').AsString;

              bAntecipacao    := true; {andre tavares - antecipação de receita - pendencia 20317 - 21/03/2004}
              dtLancamentoDoc := _cdsLocal.fieldByName('DATALANCTO').asDateTime;
            end
            else //senão a placonta de contabilização continua a mesma (o campo PLACONTA da tabela DOCUMENTO)
            begin
              sDocPlaconta := cdsTemp.FieldByName('PLACONTA').AsString;
              bAntecipacao := false; {andre tavares - antecipação de receita - pendencia 20317 - 21/03/2004}
            end;//else

          finally
            // 14/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
            FreeAndNil(_cdsLocal);
          end;//try
         //end;//with
       end;//if

      //fim - andre tavares - pendencia 20316

      sHistCompl := Trim(sHistoricoCompl) + Trim(
        cdsTemp.FieldByName('HISTORICOCOMPL').AsString );
      liUnidNegDoc := cdsTemp.FieldByName('UNIDNEGOC').AsInteger;

      if cdsTemp.FieldByName('CODSUBCONTA').IsNull Then
         sDocCodSubConta := ''
      Else
         sDocCodSubConta := cdsTemp.FieldByName('CODSUBCONTA').AsString;

      sDocCompl := cdsTemp.FieldByName('NODOCUMENTO').AsString + ' ' +
        cdsTemp.FieldByName('COMPLDOCUMENTO').AsString;
      sCliDocCompl := sDocCompl + ' ' + cdsTemp.FieldByName('RAZAOSOCIAL').AsString;


      {** Contabiliza Alteradores e regularização de adiantamento **}
      if (iOperacao = 4) or (iOperacao = 16) or (iOperacao = 17) Then
      Begin
         {** Busca Parâmetros Contábeis do Alterador **}
         cdsTemp.Close;   // 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
         cdsTemp.Data := GetDataPacket(
           ' SELECT CODCENTROCUSTO, PLACONTA, DESCRICAO, CONVERTE, CODSUBCONTA, FLGCONTABNABAIXA, FLGUSACCUSTODOC ' +
           ' FROM TIPOALTERADOR WHERE CODALTERADOR = ' +
           IntToStr(liCodAlterador));

         if (Not bContabAlteradores) and { Robson Andrade SOL 253577-17779 PPM 1073241 } 
            ( cdsTemp.FieldByName('FLGCONTABNABAIXA').AsString = 'S' ) And
            ( fOPeracaoLancto <> olsoContabiliza ) then
         begin
            liPlnCodigo := 0;
            Result := True;
            Exit;
         end
         else
            fOPeracaoLancto := olLancToDoc;

         sCodCentroCusto := cdsTemp.FieldByName('CODCENTROCUSTO').AsString;
         sPlaconta := cdsTemp.FieldByName('PLACONTA').AsString;
         sConverte := cdsTemp.FieldByName('CONVERTE').AsString;
         sHistorico := cdsTemp.FieldByName('DESCRICAO').AsString;

         If (iOperacao = 4) Then
         Begin
           sHistoricoD     := sHistorico + ' Doc. ' + trim(sCliDocCompl) + ' ' + trim(sHistCompl);
           sHistoricoC     := sHistoricoD;
         End
         Else
         Begin
            sHistoricoD     := 'Regularização de adiantamento doc. ' + sCliDocCompl;
            sHistoricoC     := sHistoricoD;
         End;

         {** Testa a obrigatoriedade da subconta para a conta do alterador caso
            a mesma não esteja preenchida no cadastro do alterador **}
         If (cdsTemp.FieldByName('CODSUBCONTA').IsNull) And (iOperacao = 4) Then
         Begin
            With _DtmCapCarObj Do
            Begin
               // início 26/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
              {
               With SQLTestaSubConta Do
               Begin
                  Prepare;
                  ParambyName('PLANO').AsFloat := liPlanoConta;
                  ParambyName('PLACONTA').AsString := Espaco(sPlaconta,18);
                  Open;
               End;
               }

               SQLTestaSubConta.Prepare;
               SQLTestaSubConta.ParambyName('PLANO').AsFloat := liPlanoConta;
               SQLTestaSubConta.ParambyName('PLACONTA').AsString := Espaco(sPlaconta,18);
               SQLTestaSubConta.Open;

               // fim 26/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"

               If CdsTestaSubConta.FieldByName('PLASUBCONTA').AsString = 'S' Then
               Begin
               // início 26/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
               {
                  With SQLSubContaDoc Do
                  Begin
                     Prepare;
                     ParambyName('CODDOCUMENTO').AsFloat := liCodDocumento;
                     Open;
                  End;
                }
                  SQLSubContaDoc.Prepare;
                  SQLSubContaDoc.ParambyName('CODDOCUMENTO').AsFloat := liCodDocumento;
                  SQLSubContaDoc.Open;
               // fim 26/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"


                  If Not CdsSubContaDoc.IsEmpty Then
                     sSubContaAltPag := CdsSubContaDoc.FieldByName('CODSUBCONTA').AsString
                  Else
                     sSubContaAltPag := '';
               End
               eLSE
                  sSubContaAltPag := '';

               If CdsTestaSubConta.Active Then CdsTestaSubConta.Close;
               If CdsSubContaDoc.Active Then CdsSubContaDoc.Close;
            End;
         End
         Else
           sSubContaAltPag := cdsTemp.FieldByName('CODSUBCONTA').AsString;

         liUnidNegPag    := 0;

        // 14/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
        cdsTemp.close;

      End;

      {** Contabilização da Baixa de Documento e Adiantamento **}
      if (iOperacao = 5) Or (iOperacao = 15) Then
      Begin
         cdsTemp.Close;  //25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"

         {** Busca parâmetros contábeis para baixa **}
         cdsTemp.Data := GetDataPacket(
           ' SELECT F.DESCRICAO, P.PLACONTA, P.CODCENTROCUSTO, P.CODSUBCONTA, P.UNIDNEGOC, P.DESCFINAN FROM ' +
           ' PORTADORFORMA P, FORMARECPAG F WHERE ' +
           ' (P.CODFORMA = F.CODFORMA) AND (P.CODPORTFORMA = ' + IntToStr(iCodPortForma) + ')'
           );

         sCodCentroCusto := cdsTemp.FieldByName('CODCENTROCUSTO').AsString;

         // alex 29/12 - esta conta é passada pela baixa de documentos.
         // normalmente será a conta banco ou a conta de não identificado
         // para regularização.
         If sContaBaixa <> '' Then
            sPlaconta := sContaBaixa
         Else
            sPlaconta := cdsTemp.FieldByName('PLACONTA').AsString;

         sConverte       := 'N';

         If liSubContaBaixa <> 0 Then
            sSubContaAltPag := IntToStr(liSubContaBaixa)
         Else
            sSubContaAltPag := cdsTemp.FieldByName('CODSUBCONTA').AsString;

         liUnidNegPag    := cdsTemp.FieldByName('UNIDNEGOC').AsInteger;

         FLote.GetNumLote(liCodDocumento); //andre tavares - pendência 22528 - 21/08/2006
         If cdsTemp.FieldByName('DESCFINAN').IsNull Then
         Begin
            If FEstornaDocumento Then
            begin
               if FLote.NumLote > 0 then //andre tavares - pendência 22528 - 21/08/2006
                 sHistorico      := 'Estorno ' + cdsTemp.FieldByName('DESCRICAO').AsString+
                   ' Nº ' + intToStr(FLote.NumLote)
               else
                 sHistorico      := 'Estorno ' + cdsTemp.FieldByName('DESCRICAO').AsString+
                   ' Nº ' + sNumChqBord;
            end
            Else
            begin
               if FLote.NumLote > 0 then //andre tavares - pendência 22528 - 21/08/2006
                 sHistorico      := cdsTemp.FieldByName('DESCRICAO').AsString+ ' Nº ' +
                   intToStr(FLote.NumLote)
               else
                 sHistorico      := cdsTemp.FieldByName('DESCRICAO').AsString+ ' Nº ' +
                   sNumChqBord;
            end;
         End
         Else
         Begin
            If FEstornaDocumento Then
            begin
               if FLote.NumLote > 0 then //andre tavares - pendência 22528 - 21/08/2006
                 sHistorico      := cdsTemp.FieldByName('DESCFINAN').AsString+ ' Nº ' +
                   intToStr(FLote.NumLote)
               else
                 sHistorico      := 'Estorno ' + cdsTemp.FieldByName('DESCFINAN').AsString +
                   ' Nº ' + sNumChqBord
            end
            Else
            begin
              if FLote.NumLote > 0 then //andre tavares - pendência 22528 - 21/08/2006
                sHistorico      := cdsTemp.FieldByName('DESCFINAN').AsString+ ' Nº ' +
                  intToStr(FLote.NumLote)
              else
                 sHistorico      := cdsTemp.FieldByName('DESCFINAN').AsString +
                   ' Nº ' + sNumChqBord;
            end;
         End;

         sDocCompl       := sNumChqBord;

         //Monta Histórico de Acordo Com o DebCre e seta se os lançamentos serão na
         //Feitos na Mesma planilha ou não
         If sDebCre = 'C' Then
         begin
             sHistoricoD := sHistorico;
             sHistoricoC :=sHistorico + ' Ref. Recebimento Doc. ' + trim(sCliDocCompl) + ' ' +
               trim(sHistCompl);
             iCodDocumentoD := -1;              // pode juntar todos os documentos - banco
             iCodDocumentoC := liCodDocumento  // não pode juntar documentos distintos - passagem
         End
         Else
         begin
             sHistoricoC := sHistorico;
             sHistoricoD := sHistorico + ' Ref. Pagamento Doc. ' +
               trim(sCliDocCompl) + ' ' + trim(sHistCompl);
             iCodDocumentoC := -1;              // pode juntar todos os documentos - banco
             iCodDocumentoD := liCodDocumento  // não pode juntar documentos distintos - passagem
         end;

        // 14/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
        cdsTemp.close;
      End;

      If sDebCre = 'C' Then
      Begin
        sCCustD    := sCodCentroCusto;
        sContaD    := sPlaconta;
        sSubContaD := sSubContaAltPag;
        sCCustC    := sDocCodCentroCusto;
        sContaC    := sDocPlaconta;        // Deverá ser trocada abaixo em múltiplas contas de baixa
        sSubContaC := sDocCodSubConta;
      End
      Else
      Begin
        sCCustC    := sCodCentroCusto;
        sContaC    := sPlaconta;
        sSubContaC := sSubContaAltPag;
        sCCustD    := sDocCodCentroCusto;
        sContaD    := sDocPlaconta;        // Deverá ser trocada abaixo em múltiplas contas de baixa
        sSubContaD := sDocCodSubConta;
      End;

      rValorD   := 0;
      rValorC   := 0;
      rValorOMD := 0;
      rValorOMC := 0;

      //Marilza Colpani - SOL 135304/1541 - KTN 803824
      //Consulta para trazer a conta que deverá receber o lançamento
      //Inicio
      cdsTemp.Data := GetDataPacket(
      ' SELECT L.PLACONTA, LC.OPERACAO, LC.DEBCRE, L.LACDEBCRE, L.IDPLANOPREV, L.IDPATRO ' +
      '   FROM LANCAMENTO L, LANCTODOCUM LC ' +
      '  WHERE ' +
      ' (LC.CODDOCUMENTO = ' + IntToStr(liCodDocumento) + ')'  +
      '  AND (LC.OPERACAO = ''2'') '  +
      '  AND (L.PLNCODIGO = LC.PLNCODIGO) ' +
      '  AND (LC.DEBCRE <> L.LACDEBCRE)'
      );
      //Fim

      For X := 0 To (_LstRateioLancamento.Count - 1)  Do
      Begin
         {** Rateio para contabilização da Baixa **}
         if (iOperacao = 5) Or (iOperacao = 15) Then
         Begin
            If sDebCre = 'C' Then
            Begin

              if (liUnidNegPag <> 0) And
                 (TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev <= 0) And
                 (TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora <= 0) then
              begin
                 liUnidNegD := liUnidNegPag;
                 rValorD    := rValorD   + TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMD  := rValorOMD + TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 liPlanoPrevD := -1;
                 liPatroD := -1;
                 bRateiaD   := False;
              end
              else
              begin
                 if liUnidNegPag <> 0 Then
                    liUnidNegD := liUnidNegPag
                 Else
                    liUnidNegD := TRateioLancamento(_LstRateioLancamento[X]).UnidNegocio;

                 rValorD    := TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMD  := TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 liPlanoPrevD := TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev;
                 liPatroD := TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora;
                 bRateiaD   := True;
              end;

              if (liUnidNegDoc <> 0) And
                 (TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev <= 0) And
                 (TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora <= 0) Then
              begin
                 liUnidNegC := liUnidNegDoc;
                 rValorC    := rValorC   + TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMC  := rValorOMC + TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 liPlanoPrevC := -1;
                 liPatroC := -1;
                 bRateiaC   := False;
              end
              else
              begin
                 if liUnidNegDoc <> 0 Then
                    liUnidNegC := liUnidNegDoc
                 Else
                    liUnidNegC := TRateioLancamento(_LstRateioLancamento[X]).UnidNegocio;

                 rValorC    := TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMC  := TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 liPlanoPrevC := TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev;
                 liPatroC := TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora;
                 bRateiaC   := True;
              end;
            End
            Else
            Begin

              if (liUnidNegPag <> 0) And
                 (TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev <= 0) And
                 (TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora <= 0) then
              begin
                 liUnidNegC := liUnidNegPag;
                 rValorC := rValorC   + TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMC := rValorOMC + TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 liPlanoPrevC := -1;
                 liPatroC := -1;
                 bRateiaC := False;
              end
              else
              begin
                 if (liUnidNegPag <> 0) Then
                    liUnidNegC := liUnidNegPag
                 Else
                    liUnidNegC := TRateioLancamento(_LstRateioLancamento[X]).UnidNegocio;

                 rValorC := TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMC := TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 liPlanoPrevC := TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev;
                 liPatroC := TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora;
                 bRateiaC := True;
              end;

              if (liUnidNegDoc <> 0) And
                 (TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev <= 0) And
                 (TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora <= 0)  Then
              begin
                 liUnidNegD := liUnidNegDoc;
                 rValorD := rValorD   + TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMD := rValorOMD + TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 liPlanoPrevD := -1;
                 liPatroD := -1;
                 bRateiaD := False;
              end
              else
              begin
                 if (liUnidNegDoc <> 0) Then
                    liUnidNegD := liUnidNegDoc
                 Else
                    liUnidNegD := TRateioLancamento(_LstRateioLancamento[X]).UnidNegocio;

                 rValorD := TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMD := TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 liPlanoPrevD := TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev;
                 liPatroD := TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora;
                 bRateiaD   := True;
              end;
            End;
         End
         Else
         Begin

              {** Rateio da contabilização de Alterador e Regularização de Adiantamento **}
              // 05/01/03 Alex, múltiplas contas de baixa deve cair no else
              if ((liUnidNegDoc <> 0) Or (liUnidNegocioLancto > 0)) and (not bLancaRateioAlterador) and (not bMultiplasContasBaixa) Then
              Begin
                 If liUnidNegocioLancto > 0 Then
                    liUnidNegD := liUnidNegocioLancto
                 Else
                    liUnidNegD := liUnidNegDoc;

                 If liUnidNegocioLancto > 0 Then
                    liUnidNegC := liUnidNegocioLancto
                 Else
                    liUnidNegC := liUnidNegDoc;

                 rValorD    := rValorD   + TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMD  := rValorOMD + TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 rValorC    := rValorC   + TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMC  := rValorOMC + TRateioLancamento(_LstRateioLancamento[X]).ValorOM;

                 (*
                   Correção no erro de constraint e no rateio por plano e patrocinadora
                   no lançamento de alteradores com indicação de atividade e projeto
                   diferente da atividade e projeto padrão
                 *)
                 if bUsaPlanoPatro then
                 begin
                   liPlanoPrevD := TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev;
                   liPatroD := TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora;
                   liPlanoPrevC := TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev;
                   liPatroC := TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora;
                 end
                 else
                 begin
                   liPlanoPrevC := -1;
                   liPatroC := -1;
                   liPlanoPrevD := -1;
                   liPatroD := -1;
                 end;

                 bRateiaD   := False;
                 bRateiaC   := False;
              End
              else
              Begin
                 liUnidNegD := TRateioLancamento(_LstRateioLancamento[X]).UnidNegocio;
                 liUnidNegC := TRateioLancamento(_LstRateioLancamento[X]).UnidNegocio;
                 rValorD    := TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMD  := TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 rValorC    := TRateioLancamento(_LstRateioLancamento[X]).Valor;
                 rValorOMC  := TRateioLancamento(_LstRateioLancamento[X]).ValorOM;
                 liPlanoPrevD := TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev;
                 liPatroD := TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora;
                 liPlanoPrevC := TRateioLancamento(_LstRateioLancamento[X]).IdPlanoPrev;
                 liPatroC := TRateioLancamento(_LstRateioLancamento[X]).IdPatrocinadora;
                 bRateiaD   := True;
                 bRateiaC   := True;
              End;
         End;

         {** Rateio da contabilização de Lançamento Rateio de Alteradores**}
         If bLancaRateioAlterador And (iOperacao = 4) Then
         Begin
            _DtmCapCarObj.SQLBuscaContaAlt.Prepare;
            _DtmCapCarObj.SQLBuscaContaAlt.ParamByName('CODALTERADOR').AsInteger := liCodAlterador;
            _DtmCapCarObj.SQLBuscaContaAlt.ParamByName('CODCENTROCUSTO').AsString := TRateioLancamento(_LstRateioLancamento[X]).CentroCusto;
            _DtmCapCarObj.SQLBuscaContaAlt.ParamByName('IDEMPRESA').AsInteger := liIdEmpresa;
            _DtmCapCarObj.SQLBuscaContaAlt.ParamByName('IDPROGRAMA').AsInteger := TRateioLancamento(_LstRateioLancamento[X]).IdPrograma;
            _DtmCapCarObj.SQLBuscaContaAlt.Open;

            If Not _DtmCapCarObj.CdsBuscaContaAlt.IsEmpty Then
            Begin
               sContaAlterador := _DtmCapCarObj.CdsBuscaContaAlt.Fields[0].AsString;

               If Trim(TRateioLancamento(_LstRateioLancamento[X]).CentroCusto) = '' Then
                  sCodCentroCustoAlterador := sCodCentroCusto
               Else
                  sCodCentroCustoAlterador := TRateioLancamento(_LstRateioLancamento[X]).CentroCusto;
            End
            Else
            Begin
               (*
                 Atribuição do centro de custo do rateio do documento caso o alterador
                 esteja com o FLAG de usa o centro de custo do rateio do documento
               *)
               If ( Trim(TRateioLancamento(_LstRateioLancamento[X]).CentroCusto) = '' ) And
                  ( Not bUsaCCustoDoc )  Then
                  sCodCentroCustoAlterador := sCodCentroCusto
               Else
                  sCodCentroCustoAlterador := TRateioLancamento(_LstRateioLancamento[X]).CentroCusto;

               sContaAlterador := sPlaconta;
            End;

            _DtmCapCarObj.CdsBuscaContaAlt.Close;

            If sDebCre = 'C' Then
            Begin
              {** Dados do Alterador, Busca na tabela aranha, caso não tenha contabiliza normalmente **}
              sCCustD    := sCodCentroCustoAlterador;
              sContaD    := sContaAlterador;
              sSubContaD := sSubContaAltPag;
              sCCustC    := sDocCodCentroCusto;
              sContaC    := sDocPlaconta;
              sSubContaC := sDocCodSubConta;
            End
            Else
            Begin
              {** Dados do Alterador, Busca na tabela aranha, caso não tenha contabiliza normalmente **}
              sCCustC    := sCodCentroCustoAlterador;
              sContaC    := sContaAlterador;
              sSubContaC := sSubContaAltPag;
              sCCustD    := sDocCodCentroCusto;
              sContaD    := sDocPlaconta;
              sSubContaD := sDocCodSubConta;
            End;

            // 14/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
            _DtmCapCarObj.CdsBuscaContaAlt.Close;
         End;

         // 05/01/04 - Alex - Múltiplas contas de baixa
         // Trocar a conta contabil do documento
         if bMultiplasContasBaixa then begin
           // 12/01/04 Alex 14451 - a data está no documento
           if TRateioLancamento(_LstRateioLancamento[X]).IdSegregaCriter <> 0 then
             iIdsegregaCriter := TRateioLancamento(_LstRateioLancamento[X]).IdSegregaCriter;

           if not bAntecipacao then
           begin
             if sDebCre = 'C' Then
             begin
               sContaC := TRateioLancamento(_LstRateioLancamento[X]).PlaConta;
             end
             else
             begin
               sContaD := TRateioLancamento(_LstRateioLancamento[X]).PlaConta;
             end;
           end;
           //Marilza Colpani - SOL 135304/1541 - KTN 803824
           sPlacontaDocOriginal :=  cdsTemp.FieldByName('PLACONTA').asString;
         end;

         {**
            Efetua lançamento contábil a débito para lançamento de alteradores,
            lançamento de baixa de adiantamento e baixa de documentos
         **}

         if ( FPartidaDobrada ) then
         begin
            if ((iOperacao = 4) or (iOperacao = 5) or (iOperacao = 15)) then
            begin
               _LancaContab.lcValHisDeb := rValoromD;

               if iOperacao = 4 then
               begin  // lancamento de alterador
                  histDSCLANCAMENTO := 'Lançamento de Aterador';
                  sHistoricoD := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                                     liIdModulo,2,
                                                     sHistoricoD,
                                                     [histNOMEALTERADOR, // andre tavares - pendencia 17317
                                                      histNODOCUMENTO,
                                                      histCOMPLDOCUMENTO,
                                                      histRAZAOSOCIAL,
                                                      histHISTORICOCOMPL,
                                                      histNumAP]) // andre tavares - pendencia 17317
               end
               // início - andre tavares pendencia 17317
               else if iOperacao = 5 then
               begin
                  if not bEstorno then // andre tavares - pendencia 17317
                  begin
                    histDSCLANCAMENTO := 'Baixa de Documento';
                    sHistoricoD := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                                       liIdModulo,0,
                                                       sHistoricoD,
                                                       [histNODOCUMENTO,
                                                        histCOMPLDOCUMENTO,
                                                        histRAZAOSOCIAL,
                                                        histDSCLANCAMENTO,
                                                        histNumCHQBord,
                                                        histNumSLIP,
                                                        histHISTORICOCOMPL,
                                                        histNumAP,
                                                        histNumLote]); //andré tavares - pendência 22867 - 12/12/2006
                  end
                  else
                  begin
                    histDSCLANCAMENTO := 'Estorno de Baixa';
                    sHistoricoD := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                                       liIdModulo,3,
                                                       sHistoricoD,
                                                       [histNODOCUMENTO,
                                                        histCOMPLDOCUMENTO,
                                                        histRAZAOSOCIAL,
                                                        histDATAVENCIMENTO,
                                                        histDATAPROGRAMADA,
                                                        histHISTORICOCOMPL,
                                                        histTIPODOCUMENTO,
                                                        histNUMAP,
                                                        histNumLote]);
                  end;
               end
               // fim - andre tavares pendencia 17317
               else if iOperacao in [1, 2] then // lancamento ou estrono de documento
               begin
                 histDSCLANCAMENTO := 'Lançamento de Documento';

                 sHistoricoD := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                                    liIdModulo,1,
                                                    sHistoricoD,
                                                    [histNODOCUMENTO,
                                                     histCOMPLDOCUMENTO,
                                                     histRAZAOSOCIAL,
                                                     histDATAVENCIMENTO,
                                                     histDATAPROGRAMADA,
                                                     histTIPODOCUMENTO,
                                                     histNumAP])
               end;
            end;

            If not SintetizaContabilizacao then
            begin
              if _LancaContab.InsereLancaContab('2',
                                                liIdEmpresa,
                                                liIdModulo,
                                                liIdUsuario,
                                                liPlanoConta,
                                                liUnidNegD,
                                                StrToIntDef(ssubcontaD,0),
                                                StrToIntDef(ssubcontaC,0),
                                                liPlanoPrevD,
                                                liPatroD,
                                                liPlnCodigo,
                                                0,
                                                DateToStr(dDataLancto),
                                                sDocCompl,
                                                sHistoricoD,
                                                '',
                                                '',
                                                '',
                                                '',
                                                '03',
                                                sCCustD,
                                                sContaD,
                                                sCCustC,
                                                sContaC,
                                                '',
                                                rValorD,
                                                false,
                                                busaPlanoPatro,
                                                iIdSegregaCriter, dDataSegregaCriter,
                                                -1, true,
                                                // Alex quando se usa partida dobrada, não importa, pode-se passar sempre o coddocumento
                                                liCodDocumento) Then
              Begin
                liPlnCodigo := _LancaContab.RetornoPlnCodigo;
                _liPlnCodigoAdianto := Trunc(liPlnCodigo);
                fPlnCodigo := Trunc(liPlnCodigo);
              End
              Else
              Begin
                Result := False;
                MessageInfo := _LancaContab.MessageInfo;
                Exit;
              End;
            end
            else
            begin
              InclueDadosPlanilha(PlanilhaSintetica,
                                  liPlnCodigo,
                                  dDataLancto,
                                  sContaC,
                                  sContaD,
                                  sCCustC,
                                  sCCustD,
                                  liPlanoPrevD,
                                  liPatroD,
                                  -1,
                                  liUnidNegD,
                                  '2',
                                  liCodDocumento,
                                  sHistoricoD,
                                  StrToIntDef(ssubcontaC,0),
                                  StrToIntDef(ssubcontaD,0),
                                  iIdSegregaCriter,
                                  rValorD);
            end;
         end
         else
         begin
            if (((iOperacao = 4) or (iOperacao = 5) or (iOperacao = 15)) or (sDebCre = 'D'))
               and ((bRateiaD) or ((not bRateiaD) and (X = iNumRateioLancamento))) then
            begin
               _LancaContab.lcValHisDeb := rValoromD;

               if iOperacao = 4 then
               begin
                  histDSCLANCAMENTO := 'Lançamento de Aterador';
                  sHistoricoD := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                            liIdModulo,2,
                                            sHistoricoD,
                                            [histNOMEALTERADOR, // andre tavares - pendencia 17317
                                            histNODOCUMENTO,
                                            histCOMPLDOCUMENTO,
                                            histRAZAOSOCIAL,
                                            histHISTORICOCOMPL,
                                            histNumAP]) // andre tavares - pendencia 17317
               end
               // início - andre tavares pendencia 17317
               else if iOperacao = 5 then
               begin
                  if not bEstorno then
                  begin
                    histDSCLANCAMENTO := 'Baixa de Documento';
                    sHistoricoD := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                              liIdModulo,0,
                                              sHistoricoD,
                                              [histNODOCUMENTO,
                                              histCOMPLDOCUMENTO,
                                              histRAZAOSOCIAL,
                                              histDSCLANCAMENTO,
                                              histNumCHQBord,
                                              histNumSLIP,
                                              histHISTORICOCOMPL,
                                              histNumAP,
                                              histNumLote //andré tavares - 11/04/2007 - pendência 25018
                                              ]); //andré tavares - pendência 22867 - 12/12/2006
                  end
                  else begin
                    histDSCLANCAMENTO := 'Estorno de Baixa';
                    sHistoricoD := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                            liIdModulo,3,
                                            sHistoricoD,
                                            [histNODOCUMENTO,
                                            histCOMPLDOCUMENTO,
                                            histRAZAOSOCIAL,
                                            histDATAVENCIMENTO,
                                            histDATAPROGRAMADA,
                                            histHISTORICOCOMPL,
                                            histTIPODOCUMENTO,
                                            histNUMAP,
                                            histNumLote //andré tavares - 11/04/2007 - pendência 25018
                                            ]);
                  end;
               // fim andre tavares - pendencia 17317
               end
               // fim - andre tavares pendencia 17317
               // lancamento ou estrono de documento
               else if iOperacao in [1, 2] then
               begin
                   histDSCLANCAMENTO := 'Lançamento de Documento';

                  // 30/01/07 A Vriável bjunta não serve mais a este fim
                  if sDebCre = 'C' then
                    sHistoricoD := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                                liIdModulo,1,
                                                sHistoricoD,
                                                [histNumCHQBord,
                                                histOrdemdePago])

                   // início andre tavares pendencia 17317
                  else
                    sHistoricoD := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                            liIdModulo,1,
                                            sHistoricoD,
                                            [histNODOCUMENTO,
                                            histCOMPLDOCUMENTO,
                                            histRAZAOSOCIAL,
                                            histDATAVENCIMENTO,
                                            histDATAPROGRAMADA,
                                            histTIPODOCUMENTO,
                                            histNumAP]);

                  // fim andre tavares pendencia 17317
               end; // else lancamento ou estorno

               if _LancaContab.InsereLancaContab('0',
                                                 liIdEmpresa,
                                                 liIdModulo,
                                                 liIdUsuario,
                                                 liPlanoConta,
                                                 liUnidNegD,
                                                 StrToIntDef(ssubcontaD,0),
                                                 0,
                                                 liPlanoPrevD,
                                                 liPatroD,
                                                 liPlnCodigo,
                                                 0,
                                                 DateToStr(dDataLancto),
                                                 sDocCompl,
                                                 sHistoricoD,
                                                 '',
                                                 '',
                                                 '',
                                                 '',
                                                 '03',
                                                 sCCustD,
                                                 sContaD,
                                                 '',
                                                 '',
                                                 '',
                                                 rValorD,
                                                 bjuntaD,
                                                 busaPlanoPatro,
                                                 iIdSegregaCriter, dDataSegregaCriter,
                                                 -1, true,
                                                 iCodDocumentoD) Then
               Begin
                  liPlnCodigo := _LancaContab.RetornoPlnCodigo;
                  _liPlnCodigoAdianto := Trunc(liPlnCodigo);
                  fPlnCodigo := Trunc(liPlnCodigo);
               End
               Else
               Begin
                  Result := False;
                  MessageInfo := _LancaContab.MessageInfo;
                  Exit;
               End;
            End;

            {**
               Efetua lançamento contábil a crédito para lançamento de alteradores,
               lançamento de baixa de adiantamento e baixa de documentos
            **}
            If (((iOperacao = 4) or (iOperacao = 5) or (iOperacao = 15)) or (sDebCre = 'C'))
               and ((bRateiaC) or ((not bRateiaC) and (X = iNumRateioLancamento))) Then
            Begin
               _LancaContab.lcValHisDeb := rValoromD;

               if iOperacao = 4 then
                  sHistoricoC := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                            liIdModulo,2,
                                            sHistoricoC,
                                            [histNOMEALTERADOR, // andre tavares - pendencia 17317
                                            histNODOCUMENTO,
                                            histCOMPLDOCUMENTO,
                                            histRAZAOSOCIAL,
                                            histHISTORICOCOMPL,
                                            histNumAP]) // andre tavares - pendencia 17317
               // início - andre tavares pendencia 17317
               else if iOperacao = 5 then
               begin
                 if not bEstorno then
                 begin
                   histDSCLANCAMENTO := 'Baixa de Documento';
                   if (sDebCre = 'D') and (trim(histNumLote) <> '') Then
                     sHistoricoC := 'Ref. Pagto do Lote Nº: '+ histNumLote + ' Fornecedor: '+ histFornLOTE
                   else
                     sHistoricoC := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                              liIdModulo,0,
                                              sHistoricoC,
                                              [histNODOCUMENTO,
                                              histCOMPLDOCUMENTO,
                                              histRAZAOSOCIAL,
                                              histDSCLANCAMENTO,
                                              histNumCHQBord,
                                              histNumSLIP,
                                              histHISTORICOCOMPL,
                                              histNumAP,
                                              histNumLote //andré tavares - 11/04/2007 - pendência 25018
                                              ]); //andré tavares - pendência 22867 - 12/12/2006
                  end
                  else
                  begin
                    histDSCLANCAMENTO := 'Estorno de Baixa';
                    sHistoricoD := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                            liIdModulo,3,
                                            sHistoricoD,
                                            [histNODOCUMENTO,
                                            histCOMPLDOCUMENTO,
                                            histRAZAOSOCIAL,
                                            histDATAVENCIMENTO,
                                            histDATAPROGRAMADA,
                                            histHISTORICOCOMPL,
                                            histTIPODOCUMENTO,
                                            histNUMAP,
                                            histNumLote //andré tavares - 11/04/2007 - pendência 25018
                                            ]);
                  end
               // fim - andre tavares pendencia 17317
               end
               else
                  // 30/01/07 A Vriável bjunta não serve mais a este fim
                  //if bJuntaC then
                  if sDebCre = 'D' then
                     sHistoricoC := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                                                liIdModulo,0,
                                                                sHistoricoC,

                                                                [histNumCHQBord,
                                                                histOrdemdePago])
                  else
                     sHistoricoC := GetHistoricoCapCar( _ModeloHist,liIdEmpresa,
                                              liIdModulo,0,
                                              sHistoricoC,
                                              [histNODOCUMENTO,
                                              histCOMPLDOCUMENTO,
                                              histRAZAOSOCIAL,
                                              histDATAVENCIMENTO,
                                              histDATAPROGRAMADA,
                                              histTIPODOCUMENTO,
                                              histNumAP,
                                              histNumLote //andré tavares - 11/04/2007 - pendência 25018
                                              ]);

               If _LancaContab.InsereLancaContab('1',
                                                 liIdEmpresa,
                                                 liIdModulo,
                                                 liIdUsuario,
                                                 liPlanoConta,
                                                 liUnidNegC,
                                                 0,
                                                 StrToIntDef(ssubcontaC,0),
                                                 liPlanoPrevC,
                                                 liPatroC,
                                                 liPlnCodigo,
                                                 0,
                                                 DateToStr(dDataLancto),
                                                 sDocCompl,
                                                 sHistoricoC,
                                                 '',
                                                 '',
                                                 '',
                                                 '',
                                                 '03',
                                                 '',
                                                 '',
                                                 sCCustC,
                                                 sContaC,
                                                 '',
                                                 rValorC,
                                                 bJuntaC,
                                                 busaPlanoPatro,
                                                 iIdSegregaCriter, dDataSegregaCriter,
                                                 -1, true,
                                                 iCodDocumentoC) Then
               Begin
                  liPlnCodigo := _LancaContab.RetornoPlnCodigo;
                  _liPlnCodigoAdianto := Trunc(liPlnCodigo);
                  fPlnCodigo := Trunc(liPlnCodigo);
               End
               Else
               Begin
                  Result := False;
                  MessageInfo := _LancaContab.MessageInfo;
                  Exit;
               End;
            End;
         End;

         //andre tavares - pendência reaberta - não está revertendo caso seja partida dobrada
         //início - André Tavares - 20317 - faz a reversão da antecipação de receita - 15/08/2006
         if bAntecipacao and (((iOperacao = 4) or (iOperacao = 5) or (iOperacao = 15)) or (sDebCre = 'C')) then
         begin

          sContaRevert := TRateioLancamento(_LstRateioLancamento[X]).PlaConta;
         // Alterado por Arnaldo V. Scarin em 07/05/2010 - SOL 135304-1541
         // Foi necessário essa modificação para que os valores que estão sendo utilizados no caso de
         // baixa antecipada, sejam revertidos corretamente.
//           liPlnAntecipa := ReverteAtecip(sCCustD,
//                                          sPlacontaDocOriginal,
//                                          sSubContaD,
//                                          sCCustC,
//                                          sContaC,
//                                          sSubContaC,
//                                          rValorD);
           liPlnAntecipa := ReverteAtecip(sCCustC,
                                          //sContaC,
                                          sContaRevert,
                                          sSubContaC,
                                          sCCustD,
                                          //sPlacontaDocOriginal,
                                          sContaC,
                                          sSubContaD,
                                          rValorD);

           if (trunc(liPlnAntecipa) = -1) then
           begin
              MessageInfo := 'Ocorreu um erro ao fazer a reversão da antecipação';
              Raise Exception.Create(MessageInfo + ' ' + _LancaContab.MessageInfo);
           end;
         end;
         //fim - André Tavares - 20317 - faz a reversão da antecipação de receita


      End; //for

      //início - 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
      cdsTemp.Close;
      For i := 0 To (_LstRateioLancamento.Count - 1) Do
      begin
//        TRateioLancamento(_LstRateioLancamento[X]).Free;
        oObj := _LstRateioLancamento[i];
        FreeAndNil(oObj);
      end;

      _LstRateioLancamento.Clear;

      //fim - 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"

    except
      on E:Exception do
      begin
         //início - 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
         For X := 0 To (_LstRateioLancamento.Count - 1) Do
         begin
//           TRateioLancamento(_LstRateioLancamento[X]).Free;
           oObj := _LstRateioLancamento[X];
           FreeAndNil(oObj);
         end;

         _LstRateioLancamento.Clear;
         //fim - 25/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"

         Result      := False;
         MessageInfo := E.Message;
      end;
    end;
  finally
    FreeAndNil( cdsTemp )
  end;
end;

procedure TCtrlDocumento.InclueDadosPlanilha(Const oPlanilha : TSinglePlanilha;
                                             Const pPlnCodigo : Double;
                                             Const pDataLancto : TDateTime;
                                             Const pContaCredito,
                                                   pContaDebito,
                                                   pCCustoCredito,
                                                   pCCustoDebito : String;
                                             Const pPlano,
                                                   pPatro,
                                                   pAtividadeProjeto,
                                                   pUnidadeNegocio : Integer;
                                             Const pTipoLancto : Char;
                                             Const pNumDocumento : Integer;
                                             Const pHistorico : String;
                                             Const pSubContaCredito,
                                                   pSubContaDebito : Double;
                                             Const pIdSegregacao : Integer;
                                             Const pValor : Double);
begin
   oPlanilha.Planilha     := Trunc(pPlnCodigo);
   oPlanilha.DataPlanilha := pDataLancto;
   // Cria um Grupo na Planilha.
   // O Grupo conterá os lancamentos de mesma Conta Credito, Conta Débito
   // Centro de Custos a Credito e a Débito, Atividade/Projeto e Unidade de Negocio
   // Quando existir um grupo com essas caracteristicas, o valor do lançamento será
   // somado, permitindo assim que seja feito um unico lançamento para esse grupo na
   // contabilidade
   oPlanilha.AdicionaOuAtualizaGrupo(pContaCredito,
                                     pContaDebito,
                                     pCCustoCredito,
                                     pCCustoDebito,
                                     pPlano,
                                     pPatro,
                                     pAtividadeProjeto,
                                     pUnidadeNegocio,
                                     pTipoLancto,
                                     pNumDocumento,
                                     pHistorico,
                                     pSubContaCredito,
                                     pSubContaDebito,
                                     pIdSegregacao,
                                     pValor);
end;




