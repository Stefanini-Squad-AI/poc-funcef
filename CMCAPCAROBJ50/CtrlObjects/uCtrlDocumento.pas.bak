function TIntBanco.GetCodGrupoCnab(liCodDocumento: LongInt): LongInt;
begin
  //27/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
  _Cds.Close;
  _Cds.Data := TCtrlDocumento(Owner).GetDataPacket('SELECT CODGRUPOCNAB FROM DOCUMENTO WHERE CODDOCUMENTO = ' + IntToStr(liCodDocumento));

  If _Cds.IsEmpty Then
     Result := -1
  Else
     Result := _Cds.Fields[0].AsInteger;

  If _Cds.Active Then _Cds.Close;
end;




function TIntBanco.SetaMensagensCNAB(liCodDocumento, lICodGrupo: LongInt;
  sMensagens: array of String; bApagaMensagens: Boolean): Boolean;
Var
  sSql: String;
  X,iMax: Integer;
//início - André Tavares - 28/08/2003 - pendência 13159
  aMensagens: Array [0..9] of String;
//fim - André Tavares - 28/08/2003 - pendência 13159
Begin

  If (liCodDocumento = -1) And (liCodGrupo = -1) Then
      Result := False
  Else
  Begin
       If bApagaMensagens Then
       Begin
         If (liCodDocumento <> -1) And (liCodGrupo <> -1) Then
             sSql := 'DELETE FROM MENSAGENSCNAB WHERE CODDOCUMENTO = '
                     + IntToStr(liCodDocumento) + ' AND CODGRUPOCNAB = '
                     + IntToStr(liCodGrupo)
         Else
            If (liCodDocumento <> -1) Then
                sSql := 'DELETE FROM MENSAGENSCNAB WHERE CODDOCUMENTO = '
                     + IntToStr(liCodDocumento)
            Else
                sSql := 'DELETE FROM MENSAGENSCNAB WHERE CODGRUPOCNAB = '
                     + IntToStr(liCodGrupo);

         If Not TCtrlDocumento(Owner).ExecSql(sSQl) Then
         begin
            TCtrlDocumento(Owner).MessageInfo := 'Erro ao deletar mensagens para o documento' + IntToStr(liCodDocumento) + '.' + (#13+#10) + TCtrlDocumento(Owner).MessageInfo;
            Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
         end;
       End;

       iMax := High(sMensagens);
//início - André Tavares - 28/08/2003 - pendência 13159
       If iMax > 9 Then iMax := 9;
//fim - André Tavares - 28/08/2003 - pendência 13159
       // Pend 17263 Tavares 28/07/04 zerar vetor
       For x:=0 to High(aMensagens) do aMensagens[x] := '';
       For X:=0 To iMax Do
           aMensagens[x] := Copy(sMensagens[x],1,69);

       sSql := ' INSERT INTO MENSAGENSCNAB (IDMENSAGENSCNAB, CODDOCUMENTO, CODGRUPOCNAB, ' +
               ' MENSAGEM1, MENSAGEM2, MENSAGEM3, MENSAGEM4, MENSAGEM5, ' +
//início - André Tavares - 28/08/2003 - pendência 13159
               ' MENSAGEM6, MENSAGEM7, MENSAGEM8, MENSAGEM9, MENSAGEM10) VALUES (' +
//fim - André Tavares - 28/08/2003 - pendência 13159
               IntToStr(TCtrlDocumento(Owner).GetSequence('MENSAGENSCNAB'));

       if liCodDocumento = -1 then
          sSql := sSql + ', NULL'
       else
          sSql := sSql + ', ' + IntToStr(liCodDocumento);

       if liCodGrupo = -1 then
          sSql := sSql + ', NULL'
       else
          sSql := sSql + ', ' + IntToStr(liCodGrupo);

       For X:=0 To High(aMensagens) Do
           sSql := sSql + ', ''' + Copy(aMensagens[X],1,69) + '''';

       sSql := sSql + ')';

       Result := TCtrlDocumento(Owner).ExecSql(sSQl);

       If Not Result Then
       begin
          TCtrlDocumento(Owner).MessageInfo := 'Erro ao inserir mensagens para o documento' + IntToStr(liCodDocumento) + '.' + (#13+#10) + TCtrlDocumento(Owner).MessageInfo;
          Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
       end;
  End;
end;




