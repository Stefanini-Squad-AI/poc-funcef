// início - andre tavares - pendência 19305 - 27/10/2005
function TIntBanco.ListDocumentos(IDCliente: Double; DataProgramada: String; PortadorForma : Integer): OLEVariant;
var sSQL : String;
begin
    sSql := ' SELECT '+
    '  '' '' AS SELECIONAR,'+
    '  D.IDFORCLI,'+
    '  D.CODDOCUMENTO,'+
    '  P.RAZAOSOCIAL,'+
    '  D.NODOCUMENTO,'+
    '  D.DATAPROGRAMADA '+
    ' FROM '+
    '  DOCUMENTO D,'+
    '  PESSOA P '+
    ' WHERE '+
    '  P.IDPESSOA = D.IDFORCLI '+
    '  AND D.DATAPROGRAMADA = TO_DATE(' + QuotedStr(DataProgramada) + ' ,''DD/MM/YYYY'')'+
    '  AND D.CODPORTFORMA = ' + IntToStr(PortadorForma)+
    '  AND ((D.EMISBLOQ = ''N'') OR D.EMISBLOQ IS NULL) '+
    '  AND D.CODGRUPOCNAB IS NULL ';
    if IDCliente <> 0 then
      sSql := sSql + ' AND D.IDFORCLI = ' + FloatToStr(IDCliente);

  Result := TCtrlDocumento(Owner).GetDataPacket(sSQL);
end;



function TIntBanco.VerificaConsistencia(dados: Olevariant): boolean;
var cds: TClientDataSet;
    idforcli : integer;
begin
  idforcli := -1;
  result := false;
  cds := TClientDataSet.Create(nil);
  try
    cds.Data := dados;
    cds.First;
    while not cds.Eof do
    begin
      if cds.fieldByName('SELECIONAR').AsString = 'S' then
      begin
        if idforcli = -1 then
          idforcli := cds.fieldByName('IDFORCLI').asInteger;

        result :=  idforcli = cds.fieldByName('IDFORCLI').asInteger;

        if not result then
          break;
      end;
      cds.Next;
    end; // while
  finally
    // 14/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
    cds.Close;
    //27/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
    //cds.free;
    FreeAndNil(cds);
  end;
end;
// fim - andre tavares - pendência 19305 - 27/10/2005

function TIntBanco.AgrupaDocCnab(CdsCnab: TClientDataSet; bInTransaction,
  bAlteraEmisBloq: Boolean; sCamposParaGrupo: array of String): Boolean;
Var iSeqGrupo, iNumCampos, X    : Integer;
    lValoresGrupo               : TStringList;
    bExisteCampo, bCamposIguais,
    bExistePortFotma            : Boolean;
    FieldGrupoDoc               :TField;
    sGrupoDoc                   :String;

    //início - andre tavares - pendência 21647 - para não permitir o grupamento de documentos emitidos para o banco ou baixados, parcelados etc...
    function VerificaStatusDoc(CodDocumento: extended): Boolean;
    var _cds : TCMClientDataSet;
    begin
       _cds := TCMClientDataSet.Create(nil);
       try
          _cds.Data := TCtrlDocumento(Owner).GetDataPacket('SELECT EMISBLOQ FROM DOCUMENTO WHERE CODDOCUMENTO = '+ floattostr(CodDocumento));
          result := (_cds.fieldbyname('emisbloq').asstring <> 'S');
       finally
          // 14/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
          _cds.Close;
          FreeAndNil(_cds);
       end;
    end;
    //fim - andre tavares

Begin
   FCodigosGrupo.Clear;

   iNumCampos := High(sCamposParaGrupo);

   lValoresGrupo := TStringList.Create;
   try

     bExisteCampo := True;

     For X:=0 To iNumCampos Do
     Begin
         bExisteCampo := (CdsCnab.FindField(sCamposParaGrupo[X]) <> nil);

         If Not bExisteCampo Then
         begin
            TCtrlDocumento(Owner).MessageInfo := 'O Campo ' + sCamposParaGrupo[X] + ' não Existe.';
            Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
         end;
     End;

     If (CdsCnab.FindField('CODDOCUMENTO') = nil) Or (Not bExisteCampo) Then
        Result := False
     Else
     Begin

        bExistePortFotma := (CdsCnab.FindField('CODPORTFORMA') <> nil);

        Try

           If Not bInTransaction Then TCtrlDocumento(Owner).StartTransaction;

           CdsCnab.First;

           // Início - Rodolpho da Silva - P: 19885 - 26/10/2005
           iSeqGrupo     := TCtrlDocumento(Owner).GetSequence('GRUPOCNAB');
           FCodigosGrupo.Add (IntToStr(iSeqGrupo));
           // Fim - Rodolpho da Silva - P: 19885 - 26/10/2005

           bCamposIguais := True;

           // Início - Rodolpho da Silva - P: 19885 - 26/10/2005
           If Not CdsCnab.IsEmpty then
              For X:=0 To iNumCampos Do lValoresGrupo.Add(CdsCnab.FieldByName(sCamposParaGrupo[X]).AsString);
           // Fim - Rodolpho da Silva - P: 19885 - 26/10/2005


           While Not CdsCnab.Eof Do
           Begin

            //início - andre tavares 09/03/2006 - pendência 21647 - para não permitir o grupamento de documentos emitidos para o banco ou baixados, parcelados etc...
             if not VerificaStatusDoc(CdsCnab.FieldByName('CODDOCUMENTO').asFloat) then
             begin
               TCtrlDocumento(Owner).MessageInfo := 'Um ou mais documentos selecionados não podem ser agrupados, pois '+#13 +
                               'já foram emitidos para cobrança.';
               Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
             end;
             //fim - andre tavares

              For X:=0 To iNumCampos Do
              Begin
                  bCamposIguais := (lValoresGrupo[x] = CdsCnab.FieldByName(sCamposParaGrupo[X]).AsString);
                  If Not bCamposIguais Then
                  begin
                     TCtrlDocumento(Owner).MessageInfo := 'Os Campo ' + sCamposParaGrupo[X] + ' está com valor diferente.';
                     Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
                  end;
              End;

              If Not bCamposIguais Then
              Begin
                 iSeqGrupo     := TCtrlDocumento(Owner).GetSequence('GRUPOCNAB');
                 bCamposIguais := True;
                 FCodigosGrupo.Add (IntToStr(iSeqGrupo));
              End;

              FieldGrupoDoc := CdsCnab.FindField('GRUPODOC');

              If FieldGrupoDoc <> nil Then
                 sGrupoDoc := Trim(FieldGrupoDoc.AsString)
              Else
                 sGrupoDoc := '';

              If (bAlteraEmisBloq) And (bExistePortFotma) And
                 (Not CdsCnab.FindField('CODPORTFORMA').IsNull) Then
              Begin
                 If Not TCtrlDocumento(Owner).ExecSql('UPDATE DOCUMENTO SET CODGRUPOCNAB = ' + IntToStr(iSeqGrupo) + ', EMISBLOQ = ''N'', GRUPODOC = ''' + sGrupoDoc + ''' ' +
                                ' WHERE CODDOCUMENTO = ' + CdsCnab.FieldByName('CODDOCUMENTO').AsString) Then
                 begin
                    TCtrlDocumento(Owner).MessageInfo := 'Erro ao marcar documento ' + CdsCnab.FieldByName('CODDOCUMENTO').AsString + ' como agrupado.' + (#13 + #10) + TCtrlDocumento(Owner).MessageInfo;
                    Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
                 end;
              End
              Else
                 If Not TCtrlDocumento(Owner).ExecSql('UPDATE DOCUMENTO SET CODGRUPOCNAB = ' + IntToStr(iSeqGrupo) +  ', GRUPODOC = ''' + sGrupoDoc + ''' ' +
                                ' WHERE CODDOCUMENTO = ' + CdsCnab.FieldByName('CODDOCUMENTO').AsString) Then
                 begin
                    TCtrlDocumento(Owner).MessageInfo := 'Erro ao marcar documento ' + CdsCnab.FieldByName('CODDOCUMENTO').AsString + ' como agrupado.' + (#13 + #10) + TCtrlDocumento(Owner).MessageInfo;
                    Raise Exception.Create(TCtrlDocumento(Owner).MessageInfo);
                 end;

              CdsCnab.Next;
           End;

           If Not bInTransaction Then TCtrlDocumento(Owner).Commit;
        Except
           If Not bInTransaction Then TCtrlDocumento(Owner).Rollback;
           //27/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
           //lValoresGrupo.Free;
           FreeAndNil(lValoresGrupo);
           Raise;
        End;

        Result := True;
     End;
   finally
     //27/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
     //lValoresGrupo.Free;
     FreeAndNil(lValoresGrupo);
   end;
end;




