//andré tavares - pendência 26760
function TCtrlDocumento.VerificaPlanosRateio: Boolean;
var
  cdsPPcor, cdsPPxPF, cdsPPpos: TClientDataset;
  bObrigaMesmoPP: boolean;
  iPlanoPrevAnt, y: integer;

  function getPlanprevContabil(idplanoPrev: integer): Olevariant;
  begin
    result := getDataPacket( 'SELECT NOME, IDPLANOPREV, IDPLANOPREVPREV,' +
      ' CODSPC FROM PLANPREVCONTABIL WHERE IDPLANOPREV = '+ intToStr(idplanoPrev)
    );
  end;

begin
  result := true;
  //se obriga mesmo planoprev e o documento tem um portadorforma, então lista os planosprev do portadorconta
  cdsPPxPF := TClientDataset.Create(nil);
  cdsPPpos := TClientDataset.Create(nil);
  cdsPPcor := TClientDataset.Create(nil);
  try
    cdsPPxPF.Data := getDataPacket('SELECT FLGOBRIGAMESMOPP FROM PARAMCAP WHERE IDPESSOA = '+ intToStr(Sistema.IdEmpresa) + ' AND RECPAG = '+ quotedStr(_Documento.Recpag.AsString) );
    bObrigaMesmoPP := cdsPPxPF.fieldByName('FLGOBRIGAMESMOPP').asString = 'S';

    if (_documento.codportforma.asInteger > 0) then
      cdsPPxPF.data := GetDataPacket(' SELECT P.IDPLANOPREV '+#13+
                                     ' FROM PORTCONTAXPLANO P, PORTADORFORMA PF '+#13+
                                     ' WHERE  P.CODPORTADOR = PF.CODPORTADOR AND '+#13+
                                     '        PF.CODPORTFORMA = '+ _documento.codportforma.asString );

    if (bObrigaMesmoPP) and ( (cdsPPxPF.IsEmpty) or (_documento.codportforma.asInteger = 0) )then
    begin
      cdsPPcor.Data :=  getPlanprevContabil(TDbRateiodocum(_LstRateioDocum[0]).Idplanoprev.asInteger);
      iPlanoPrevAnt := TDbRateiodocum(_LstRateioDocum[0]).IdPlanoVirtual.asInteger;
      for y := 0 To (_LstRateioDocum.Count - 1) do
      begin

        if (TDbRateiodocum(_LstRateioDocum[0]).Valor.asFloat > 0) then //se obriga mesmo planprevcontabil no raetio
        begin
          cdsPPpos.Data :=  getPlanprevContabil(TDbRateiodocum(_LstRateioDocum[y]).Idplanoprev.asInteger);

          if iPlanoPrevAnt = 0 then
          begin

            //verifica se os rateios estão no mesmo plano
            if not cdsPPcor.FieldByName('IDPLANOPREVPREV').isNull then
              result := cdsPPcor.FieldByName('IDPLANOPREVPREV').asInteger = cdsPPpos.FieldByName('IDPLANOPREVPREV').asInteger
            else
              result := trim(cdsPPcor.FieldByName('CODSPC').asString) = trim(cdsPPpos.FieldByName('CODSPC').asString);

          end //if
          else
          begin
            result := iPlanoPrevAnt = TDbRateiodocum(_LstRateioDocum[y]).IdPlanoVirtual.asInteger;
          end;//else

        end;//if

        if not result then
        begin
          MessageInfo := 'Rateios com Planos Diferentes não são Permitidos.';
          raise exception.Create(MessageInfo);
        end;

      end;//for
    end //if
    else
      if (_documento.codportforma.asInteger > 0) and (not cdsPPxPF.IsEmpty) then
      begin
        for y := 0 To (_LstRateioDocum.Count - 1) do
        begin
          cdsPPxPF.data := GetDataPacket(
              ' SELECT P.IDPLANOPREV '+#13+
              ' FROM PORTCONTAXPLANO P, PORTADORFORMA PF '+#13+
              ' WHERE  P.CODPORTADOR = PF.CODPORTADOR AND '+#13+
              '        PF.CODPORTFORMA = '+ _documento.codportforma.asString + ' AND '+
              '        P.IDPLANOPREV = '+ TDbRateiodocum(_LstRateioDocum[y]).Idplanoprev.asString );
          result := not cdsPPxPF.isEmpty;
          if not result then
          begin
            result := false;
            MessageInfo := 'Rateios com Planos não Relacionados a este Portador X Conta não são permitidos.';
            raise exception.create(messageInfo);
          end;
        end; //for
      end;//else

  if not result then
  begin
    MessageInfo := ' Os Planos do Rateio do Documento não Estão Relacionados ao Portador Conta.';
    Raise Exception.Create(MessageInfo);
  end;

  finally
    // 14/06/2008 - 28197 André tavares - para consertar o erro "insufficient memory for this operation"
    FreeAndNil(cdsPPxPF);
    FreeAndNil(cdsPPpos);
    FreeAndNil(cdsPPcor);
  end;
end;


// Arnaldo V. Scarin - 20/11/2009
procedure TCtrlDocumento.SetDocumentoPai(const Value: TDocumentoPai);
begin
  FDocumentoPai := Value;
end;

// Arnaldo V. Scarin - 20/11/2009
function TCtrlDocumento.ProcessaDocumentoPai: Boolean;
var oQry : TCMClientDataSet;
begin
   Result := True;

   DocumentoPai.IdDocumento := FCodDocumento;
   DocumentoPai.FlgDispFinanc := 'N';

   oQry := TCmClientDataSet.Create(Nil);
   Try
     oQry.Data := GetDataPacket('Select RECPAG'+#13+
                                'from documento'+#13+
                                'Where CodDocumento = '+FloatToStr(DocumentoPai.IDDocumentoPai));
     If _Documento.Recpag.AsString <> oQry.FieldByName('RECPAG').asString then
       DocumentoPai.FlgDispFinanc := 'S';
   finally;
     Result := False;
     oQry.Close;
     FreeAndNil(oQry);
   end;
   // Insere o Registro no Banco de Dados
   DocumentoPai.Insert;
end;



function TCtrlDocumento.LocalizaPlanoPatroFinanceiro( IdEmpresa, CodPortForma, IdForCli,
        IdPatroOrigem, IdPlanoOrigem, IdPrograma: Integer;
        RecPag, CodCentroCusto, CodTipoDesemReceb: String ): TDadosFinanceiro;
var
  cdsLocal, cdsLocalizaPatro: TCMClientDataSet;
  _CtrlPlacontasCapCar: TCtrlPlacontasCapCar;
  PlaContas: TPlacontas;
begin
  // Ricardo A. SOL 122623 KTN 603580
  // localiza a parametrização contábil predominante da conta
  Result.IdPatroOrigem := IdPatroOrigem;
  Result.IdPlanoOrigem := IdPlanoOrigem;
  Result.ReceitaDespesaAdministrativa := False;

   _CtrlPlacontasCapCar := TCtrlPlacontasCapCar.Create;
   try
     _CtrlPlacontasCapCar.InitializeAs( Self );

     if not _CtrlPlacontasCapCar.GetPlacontas (
          CodPortForma,
          IdForCli,
          IdEmpresa,
          IdPrograma,
          IdPlanoOrigem,
          CodCentroCusto,
          CodTipoDesemReceb,
          RecPag,
          opldEfetivo,
          False,
          PlaContas,
          Paramintegra.IntegraContab,
          Paramintegra.Plano
          ) then
       raise exception.create( messageinfo );

    Result.PlaConta := PlaContas.sPlaconta;

    // SOL 200778 KTN 1953121 Otacilio
    sTipoDespesa := PlaContas.sPlaconta;

    cdsLocal := TCMClientDataSet.Create( nil );
    try
      // localiza no cadastro da conta se a conta é de uso exclusivo do PGA
      cdsLocal.Data := getDataPacket( 'SELECT PLAGRUPO, FLGUSOEXCPGA' +
        ' FROM PLANOCONTA WHERE' +
        ' PLANO = ' + IntToStr( PlaContas.iPlano ) +
        ' AND PLACONTA = ' + QuotedStr( PlaContas.sPlaconta )
        );

      // se Uso exclusivo PGA e do tipo receita ou despesa então trata-se
      // de documento do tipo receita ou despesa administrativa
      if ( cdsLocal.FieldByName( 'FLGUSOEXCPGA' ).asString = 'I' ) then
      begin

        cdsLocalizaPatro := TCMClientDataSet.Create( nil );
        try
          cdsLocalizaPatro.Data := GetDataPacket( 'SELECT IDPLANOPREV FROM PLANPREVCONTABIL WHERE FLGUSOPGA = ''S'' ');
          if cdsLocalizaPatro.IsEmpty then
            raise Exception.Create( 'Não existe PGA cadastrado para o Plano Previdenciário.' + #13+#10+ messageinfo )
          else
            Result.IdPlanoFinanceiro := cdsLocalizaPatro.FieldByName( 'IDPLANOPREV' ).AsInteger;

          cdsLocalizaPatro.Close;

          cdsLocalizaPatro.Data := GetDataPacket(
            'SELECT' +
            '  PCP.IDPATRO ' +
            'FROM ' +
            '  PESSOA PES, '+
            '  PLANPREVCONTABIL PLP, ' +
            '  PLANPREVCONTABPATRO PCP ' +
            '  WHERE ' +
            '  PLP.IDPLANOPREV = PCP.IDPLANOPREV ' +
            '  AND PES.IDPESSOA = PCP.IDPATRO ' +
            '  AND PLP.ATIVO = ''S'' ' +
            '  AND PLP.IDPLANOPREV = ' + IntToStr( Result.IdPlanoFinanceiro )
            );
          if cdsLocalizaPatro.IsEmpty then
            raise Exception.Create( 'Não existe PGA cadastrado para a Patrocinadora.' + #13+#10+ messageinfo )
          else
            Result.IdPatroFinanceiro := cdsLocalizaPatro.FieldByName( 'IDPATRO' ).AsInteger;
        finally
          FreeAndNil( cdsLocalizaPatro );
        end;

        Result.ReceitaDespesaAdministrativa := ( cdsLocal.FieldByName( 'PLAGRUPO' ).asString = 'R' ) or
          ( cdsLocal.FieldByName( 'PLAGRUPO' ).asString = 'D' );


      end
      else
      begin
        // Utilizacao normal
        Result.IdPlanoFinanceiro := Result.IdPlanoOrigem;
        Result.IdPatroFinanceiro := Result.IdPatroOrigem;
      end;

      cdsLocal.Data := GetDataPacket( 'SELECT NOME FROM PLANPREVCONTABIL WHERE ' +
        'IDPLANOPREV = ' + IntToStr( Result.IdPlanoFinanceiro ) );
      Result.DescPlanoFinanceiro := cdsLocal.FieldByName( 'NOME' ).AsString;

      cdsLocal.Data := GetDataPacket( 'SELECT NOME FROM PESSOA WHERE ' +
        'IDPESSOA = ' + IntToStr( Result.IdPatroFinanceiro ) );
      Result.NomePatroFinanceiro := cdsLocal.FieldByName( 'NOME' ).AsString;
    finally
      FreeAndNil( cdsLocal );
    end;
  finally
    _CtrlPlacontasCapCar.Free;
  end;
end;

