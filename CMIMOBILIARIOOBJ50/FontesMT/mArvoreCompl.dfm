  object CMSqlParams1: TCMSqlParams
    SQL.Strings = (
      
        'SELECT OD.CODCOMPL, OD.ODODESCRICAO, OI.ODIVALOR, OI.IDIMOVEL, O' +
        'D.IDOUTRODADO, OD.ANASINT,'
      '       OD.TIPODADO, OD.OPCOES'
      'FROM OUTRODADO OD, OUTRODADOXIMOVEL OI'
      'WHERE OI.IDIMOVEL    = '#39'1227'#39
      '  AND OD.IDOUTRODADO = OI.IDOUTRODADO'
      '  AND OD.FLGORIGEM   = '#39'I'#39
      'UNION'
      
        'SELECT OD.CODCOMPL, OD.ODODESCRICAO, '#39'            '#39' AS ODIVALOR,' +
        ' 1227 AS IDIMOVEL, OD.IDOUTRODADO,'
      '       OD.ANASINT, OD.TIPODADO, OD.OPCOES '
      'FROM OUTRODADO OD '
      'WHERE OD.FLGORIGEM = '#39'I'#39' '
      '  AND OD.IDOUTRODADO NOT IN ( SELECT IDOUTRODADO '
      '                              FROM OUTRODADOXIMOVEL '
      
        '                              WHERE IDOUTRODADO = OD.IDOUTRODADO' +
        ' '
      '                                AND IDIMOVEL    = '#39'1227'#39')'
      ' ')
    ClientDataSet = Cds
    Left = 62
    Top = 225
  end
