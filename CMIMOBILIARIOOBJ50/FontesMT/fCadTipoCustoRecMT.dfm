  object wwQuery1: TwwQuery [10]
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT T.IDTIPOCUSTORECIMO,  T.DESCCUSTORECIMO, T.CODTIPDOC,'
      
        '   T.RECCUSTO,           T.IDRECEITAREEMB,  T.FLGOBRIGAORCPREST,' +
        ' '
      '   T.FLGOBRIGAORC,       T.FLGREEMBOLSO,    T.IDMODULO, '
      
        '   T.IDTIPODESPESA,      T.FLGDIARIO,       T.IDOPERCONTAB, T.FL' +
        'GRENTAB, T.FLGTIPOOPER,'
      
        '   DECODE(T.RECCUSTO,'#39'C'#39','#39'Despesa'#39','#39'R'#39','#39'Receita'#39','#39'Operação'#39') AS ' +
        'DSC_TIPO,'
      
        '   DECODE(T.FLGTIPOOPER,'#39'A'#39','#39'Acréscimo'#39','#39'D'#39','#39'Desconto'#39') AS DESC_' +
        'TIPOOPER '
      ' FROM  TIPOCUSTORECIMOV T '
      ' WHERE  1=1 '
      ' AND ( T.IDMODULO = 64 ) '
      ' ORDER BY T.DESCCUSTORECIMO '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 445
    Top = 4
  end
  object DataSetProvider1: TDataSetProvider [11]
    DataSet = wwQuery1
    Constraints = True
    Left = 453
    Top = 20
  end
