  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      'SELECT L.CONNUMERO, L.CODTIPIMOVEL, T.DESCTIPOIMOVEL,'
      '       SC.DESCRICAO AS DESCR_SITCONTR,'
      
        '       DECODE(L.CONNOME, NULL, L.NF_FORCLI, L.CONNOME) AS CONNOM' +
        'E,'
      '       L.CONDATAINICIO,'
      
        '       DECODE(L.STATUS_CONTRATO, '#39'V'#39', '#39'Vigente'#39', '#39'E'#39', '#39'Encerrado' +
        #39', '#39'R'#39', '#39'Rescindido'#39', NULL) AS STATUS_CONTRATO,'
      
        '       0 AS PERCENTUAL, 0 AS VLR_PROVISAO, '#39'                  '#39' ' +
        'AS DSC_GRUPO,'
      '       0 AS SLD_VINCENDO, 0 AS TOT_DIFERENCA,'
      '       MIN(L.DATAVENCIMENTO) AS DATAVENCIMENTO,'
      '       ROUND(SYSDATE - MIN(L.DATAVENCIMENTO), 0) AS DIAS,'
      
        '       SUM(L.TOT_RECEBER + L.TOT_ALTERADOR - L.TOT_RECEBIDO) AS ' +
        'DIFERENCA'
      
        '  FROM VWLANCAMENTO L, TIPOIMOVEL T, CONTRATOIMOVEL C, SITCONTIM' +
        'OB SC'
      ' WHERE L.CODTIPIMOVEL = T.CODTIPIMOVEL(+)'
      '   AND L.IDCONTRATOIMOVEL = C.IDCONTRATOIMOVEL (+)'
      '   AND C.IDSITCONTIMOB = SC.IDSITCONTIMOB (+)'
      '   AND L.RECPAG = '#39'R'#39
      '   AND L.DATAVENCIMENTO < SYSDATE'
      '   AND L.TOT_RECEBIDO < (L.TOT_RECEBER + L.TOT_ALTERADOR)'
      
        ' GROUP BY L.CONNUMERO, L.CODTIPIMOVEL, T.DESCTIPOIMOVEL, SC.DESC' +
        'RICAO,'
      
        '       DECODE(L.CONNOME, NULL, L.NF_FORCLI, L.CONNOME), L.CONDAT' +
        'AINICIO,'
      
        '       DECODE(L.STATUS_CONTRATO, '#39'V'#39', '#39'Vigente'#39', '#39'E'#39', '#39'Encerrado' +
        #39', '#39'R'#39', '#39'Rescindido'#39', NULL),'
      '       0, 0, '#39'                  '#39', 0, 0'
      'ORDER BY DIAS, CODTIPIMOVEL, DESCTIPOIMOVEL, CONNUMERO'
      ''
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
  end
