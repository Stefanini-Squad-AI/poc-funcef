  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   PLI.DESCPADRLANCIMO,'
      '   TI.CODTIPIMOVEL,'
      '   TI.DESCTIPOIMOVEL,'
      
        '   DECODE(I.IMONOME,NULL,NULL,IM.IMONOME || '#39' - '#39' || I.IMONOME) ' +
        '   AS IMOVEL_EXTENSO,'
      
        '   DECODE(C.CONNUMERO,NULL,NULL,C.CONNUMERO || '#39' - '#39' || C.CONNOM' +
        'E) AS CONTRATO_EXTENSO,   '
      '   TCR.DESCCUSTORECIMO,   '
      '   DECODE(PLI.FLGDIARIO,NULL,'#39'N'#39',PLI.FLGDIARIO) AS FLGDIARIO,'
      '   DECODE(PLI.RECPAG,'#39'P'#39','#39'DESPESAS'#39','#39'RECEITAS'#39') AS DSC_RECPAG,'
      
        '   DECODE(PLI.RECPAG,'#39'P'#39',PLI.CONTARESULT,PLI.CONTADEBCRE) AS CON' +
        'TADEBITO,'
      
        '   DECODE(PLI.RECPAG,'#39'P'#39',PLI.CONTADEBCRE,PLI.CONTARESULT) AS CON' +
        'TACREDITO,   '
      
        '   DECODE(PLI.RECPAG,'#39'P'#39',PCR.PLANOME,PCD.PLANOME) AS DSC_CONTADE' +
        'BITO,'
      
        '   DECODE(PLI.RECPAG,'#39'P'#39',PCD.PLANOME,PCR.PLANOME) AS DSC_CONTACR' +
        'EDITO   '
      'FROM'
      '   IMOVEL I,'
      '   IMOVEL IM,                    '
      '   CONTRATOIMOVEL C,'
      '   PADRLANCIMOVEL PLI,'
      '   TIPOIMOVEL TI,'
      '   TIPOCUSTORECIMOV TCR,'
      '   PLANOCONTA PCR,'
      '   PLANOCONTA PCD'
      'WHERE'
      '       PLI.IDIMOVEL = I.IDIMOVEL(+)'
      '   AND I.IDIMOVELMESTRE = IM.IDIMOVEL(+) '
      '   AND PLI.IDCONTRATOIMOVEL = C.IDCONTRATOIMOVEL(+) '
      '   AND PLI.CODTIPIMOVEL = TI.CODTIPIMOVEL(+) '
      '   AND PLI.IDTIPOCUSTORECIMO = TCR.IDTIPOCUSTORECIMO(+)'
      '   AND PLI.PLANO = PCR.PLANO(+)'
      '   AND PLI.CONTARESULT = PCR.PLACONTA(+)'
      '   AND PLI.PLANO = PCD.PLANO(+)'
      '   AND PLI.CONTADEBCRE = PCD.PLACONTA(+)'
      ''
      'ORDER BY PLI.RECPAG, DESCPADRLANCIMO     '
      ' '
      ' ')
    ClientDataSet = nil
  end
