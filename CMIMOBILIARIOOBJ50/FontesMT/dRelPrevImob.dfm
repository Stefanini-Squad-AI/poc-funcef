  inherited CrmRptCM: TCmRptManager
    BeforePrint = CrmRptCMBeforePrint
    Report = ppPrevImob
    LabelEmpresa = lblEmpresa
    LabelSistema = lblSistema
  end
  inherited cds: TClientDataSet
    Active = False
  end
  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      'SELECT '#39'Janeiro / 2002'#39' AS DSC_COMPETENCIA,'
      
        '       LP.CODTIPIMOVEL, LP.IDTIPOCUSTORECIMO, TC.DESCCUSTORECIMO' +
        ','
      
        '       DECODE(TC.RECCUSTO,'#39'R'#39','#39'Receita'#39','#39'Despesa'#39') AS DSC_RECPAG' +
        ','
      
        '       LP.MESCOMPETENCIA, LP.ANOCOMPETENCIA, LP.FLGAJUSTEANUAL, ' +
        'SUM(LP.VLRMES) AS VLRMES'
      '  FROM LANCPREVIMOB LP,'
      '       TIPOCUSTORECIMOV TC'
      ' WHERE LP.IDTIPOCUSTORECIMO = TC.IDTIPOCUSTORECIMO'
      '   AND LP.MESCOMPETENCIA = 1'
      '   AND LP.ANOCOMPETENCIA = 2002'
      'GROUP BY '#39'Janeiro / 2002'#39','
      
        '       LP.CODTIPIMOVEL, LP.IDTIPOCUSTORECIMO, TC.DESCCUSTORECIMO' +
        ','
      '       DECODE(TC.RECCUSTO,'#39'R'#39','#39'Receita'#39','#39'Despesa'#39'),'
      '       LP.MESCOMPETENCIA, LP.ANOCOMPETENCIA,  LP.FLGAJUSTEANUAL'
      
        'ORDER BY LP.MESCOMPETENCIA, LP.ANOCOMPETENCIA, TC.DESCCUSTORECIM' +
        'O'
      ''
      ''
      ' '
      ' '
      ' ')
  end
