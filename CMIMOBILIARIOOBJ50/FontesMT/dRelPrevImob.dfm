  object CMspMestre: TCMSqlParams
    SQL.Strings = (
      
        'SELECT P.MESCOMPETENCIA, P.ANOCOMPETENCIA, P.CODTIPIMOVEL, P.IDT' +
        'IPOCUSTORECIMO,'
      
        '       IM.IDIMOVEL AS IDMESTRE, IM.IMONOME AS DSC_MESTRE, '#39'N'#39' AS' +
        ' FLGAJUSTEANUAL, '
      '       SUM(P.VLRMES) AS VLRMES'
      '  FROM PREVIMOB P,'
      '       IMOVEL I, IMOVEL IM'
      ' WHERE I.IDIMOVELMESTRE = IM.IDIMOVEL'
      '   AND P.IDIMOVEL = I.IDIMOVEL'
      '   AND P.MESCOMPETENCIA = 1'
      '   AND P.ANOCOMPETENCIA = 2002'
      'GROUP BY P.MESCOMPETENCIA, P.ANOCOMPETENCIA, P.CODTIPIMOVEL,'
      '         P.IDTIPOCUSTORECIMO, IM.IDIMOVEL, IM.IMONOME'
      
        'ORDER BY P.MESCOMPETENCIA, P.ANOCOMPETENCIA, P.CODTIPIMOVEL, DSC' +
        '_MESTRE'
      ' ')
    ClientDataSet = cdsMestre
    Left = 331
    Top = 8
  end
