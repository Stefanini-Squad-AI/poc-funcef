  object CMSqlParams: TCMSqlParams
    SQL.Strings = (
      '/*SELECT DISTINCT LIM.CODDOCUMENTO,'
      
        '               (LIM.MESREFERENCIA ||'#39'/'#39'|| LIM.ANOREFERENCIA) AS ' +
        'COMP    '
      '  FROM LANCAMENTOSIMOVEL LIM,'
      '       PARAMCONTAB PCT,'
      '       DOCUMENTO DOC'
      ' WHERE LIM.CODDOCUMENTO = DOC.CODDOCUMENTO'
      '   AND DOC.STATUS = 0'
      '   AND LIM.DATAVENCIMENTO >= (PCT.DATAULTFECHA + 1) '
      '   AND LIM.FLGTIPOLANCAMENTO = '#39'A'#39'*/'
      ''
      'SELECT DISTINCT LIM.CODDOCUMENTO,'
      
        '              (LIM.MESREFERENCIA ||'#39'/'#39'|| LIM.ANOREFERENCIA) AS C' +
        'OMP  '
      '  FROM LANCAMENTOSIMOVEL LIM,'
      '       PARAMCONTAB PCT,'
      '       DOCUMENTO DOC'
      ' WHERE LIM.CODDOCUMENTO = DOC.CODDOCUMENTO'
      '   AND DOC.STATUS = 2'
      '   AND LIM.DATAVENCIMENTO >= (PCT.DATAULTFECHA + 1)'
      '   AND LIM.FLGTIPOLANCAMENTO = '#39'A'#39
      ' ')
    ClientDataSet = cdsDocPago
    Left = 528
    Top = 72
  end
