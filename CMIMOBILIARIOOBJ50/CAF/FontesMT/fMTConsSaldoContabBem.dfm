  object sqlAux: TCMSqlParams
    SQL.Strings = (
      
        'SELECT CP.IDCAFPAISES, CP.IDPAIS, P.NOMEPAIS, P.CODINTERNACIONAL' +
        ', '
      '       CP.MOECODIGO, M.MOEDESC '
      'FROM CAFPAISES CP,'
      '     PAIS P, '
      '     MOEDA M '
      'WHERE CP.IDPESSOA = :IDPESSOA'
      '  AND CP.IDPAIS = P.IDPAIS'
      '  AND CP.MOECODIGO = M.MOECODIGO(+)'
      'ORDER BY P.NOMEPAIS')
    Left = 208
    Top = 364
  end
