  object qrySelAtivProj: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT NOME,UNIDNEGOC, IDPESSOA,UNECODIGO'
      'FROM UNIDNEGOCIO'
      'WHERE (IDPESSOA  =  :PIDPESSOA)'
      '  AND (UNIDNEGOC = :PIDATIVPROJETO)'
      '  AND (UNETIPO = '#39'A'#39')'
      '  AND (UNIDNEGOC > 0)      '
