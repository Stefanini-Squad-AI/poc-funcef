  object qrySelBem: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT B.*,C.DESCCONJUNTO, G.NOME, G.FLGIMOVEL, S.DESCSITUACAO,'
      '       CB.DESCRICAO AS NOMECLASSE'
      'FROM BEM                   B,'
      '     HISTORICOMOVIMENTACAO HM,'
      '     CONJUNTO              C,'
      '     GRUPO                 G,'
      '     SITUACAO              S,'
      '     CLASSEDEBEM           CB'
      'WHERE (HM.IDCAFOBRA  = :IDCAFOBRA)'
      '  AND (HM.IDPESSOA   = :IDPESSOA)'
      '  AND (HM.IDBEM      = B.IDBEM(+))'
      '  AND (HM.IDPESSOA   = B.IDPESSOA(+))'
      '  AND (B.IDCONJUNTO  = C.IDCONJUNTO(+))'
      '  AND (B.IDGRUPO     = G.IDGRUPO(+))'
      '  AND (B.IDSITUACAO  = S.IDSITUACAO(+))'
      '  AND (B.IDCLASSEBEM = CB.IDCLASSEBEM(+))'
      ''
