  object qryTxt: TwwQuery
    DatabaseName = 'C:\ARQUIVOSSRH\SAIDA\'
    SQL.Strings = (
      'SELECT INSCRICAO,FATORJOIA, BANCO,AGENCIA,CCORRENTE,'
      
        '                   ADMISSAO,NASCIMENTO,NOME,SEXO,IRRF,CPF,CARGO,' +
        'NIVEL ,        '
      
        '                   NUMIDENT, UFIDENT, DTEXPIDENT, CDMUNNAT, NOME' +
        'PAI, NOMEMAE , '
      
        '                   MATRICULAC  ,QTTPTOT, QTTPNCRED,             ' +
        '               '
      '                   ESTCIVIL, TPSERVANT, NUMFILIAL, IDSITFUNC,'
      
        '                   DTDEMISSAO, TPPUBLANT, TPPRIVANT, FLGDIRETOR,' +
        ' TPSERVREAL,   '
      
        '                   FUNCAO, DTREADMIS, VINCFUNC, DATAMORTE,      ' +
        '               '
      
        '                   VALORBASE1, VALORBASE2, VALORBASE3,          ' +
        '               '
      '                   NDEPSALF, NDEPTOT'
      'FROM  TMPTXT.DBF ORDER BY MATRICULA')
    ValidateWithMask = True
    Left = 318
    Top = 358
  end
