  object qryTabRubricas: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'select '
      'pd.idprovento,'
      'rb.codprovdesc,'
      'rb.descrprovdesc,'
      'pd.flgdesconto,'
      'pd.flgcompoesalpart,'
      'pd.flgatrasodevol'
      'from '
      'rubricaxpess rb,'
      'provdesc pd'
      'where'
      '(rb.idpessoa = :idpessjur) and'
      '(rb.idrubrica = pd.idprovento)'
      'order by '
      'rb.codprovdesc')
    ValidateWithMask = True
    Left = 691
    Top = 98
    ParamData = <
      item
        DataType = ftInteger
        Name = 'idpessjur'
        ParamType = ptUnknown
        Value = 4
      end>
  end
  object qryTabCargos: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      'IDCARGOEXT,'
      'IDFAIXASALEXT,'
      'TITULO,'
      'CODIGO,'
      'DESCRICAO,'
      'IDPESSJUR'
