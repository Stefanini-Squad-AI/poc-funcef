  object qryPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT P.IDPESSOA, P.NOME'
      'FROM   PESSOA P, PATRO PT'
      'WHERE  (P.IDPESSOA = :CODPATRO) AND '
      '                (PT.IDPESSOA = P.IDPESSOA)'
      '')
    ValidateWithMask = True
    Left = 644
    Top = 337
    ParamData = <
      item
        DataType = ftInteger
        Name = 'CODPATRO'
        ParamType = ptUnknown
      end>
  end
  object qryPatroCombo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT P.IDPESSOA, P.NOME,'
      'PT.MASCMATRICULA'
      'FROM   PESSOA P, PATRO PT'
      'WHERE  (PT.IDPESSOA = P.IDPESSOA)'
      'AND    PT.IDFUNDACAO = :IDFUNDACAO'
      'ORDER BY P.NOME'
      ''
      ' ')
    ValidateWithMask = True
    Left = 233
    Top = 420
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDFUNDACAO'
        ParamType = ptUnknown
      end>
  end
  object qryLayOutArquivo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT *'
      
        'FROM   PARAMINTERF, PARAMINTERFDEP, PARAMINTERFEVOL, PARAMINTERF' +
        'FUNC'
      'WHERE  (PARAMINTERF.IDPESSJUR = :CODPATRO)'
      'AND PARAMINTERFDEP.IDPESSJUR = PARAMINTERF.IDPESSJUR'
      'AND PARAMINTERFEVOL.IDPESSJUR = PARAMINTERF.IDPESSJUR'
      'AND PARAMINTERFFUNC.IDPESSJUR = PARAMINTERF.IDPESSJUR'
      ''
      ''
      ''
      ' ')
    ValidateWithMask = True
    Left = 636
    Top = 217
    ParamData = <
      item
        DataType = ftInteger
        Name = 'CODPATRO'
        ParamType = ptUnknown
      end>
  end
