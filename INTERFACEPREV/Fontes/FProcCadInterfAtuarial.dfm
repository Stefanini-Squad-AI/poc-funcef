  object qryPlanPrev: TwwQuery
    Tag = 5
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT PL.NOME, PL.IDPLANOPREV, PL.IDRGSALMEDIOATU'
      'FROM   PLANPREV PL'
      'ORDER BY PL.NOME'
      '')
    ValidateWithMask = True
    Left = 228
    Top = 6
  end
  object qryPartAss: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT'
      '       PP.IDPESSJUR,'
      '       PP.IDPLANOPREV,'
      '       PP.IDPESSOA,'
      '       PP.SEQPROPOSTA,'
      '       PP.INSCRICAONUMERO,'
      '       EL.MATRICULA,'
      '       SP.FLGINTERNO'
      'FROM   SITPART SP, ELEGPATRO EL, PARTPREVPLAN PP'
      'WHERE  PP.IDPLANOPREV = :IDPLANOPREV'
      'AND    SP.FLGINTERNO IN ('#39'AT'#39','#39'MA'#39')'
      'AND    PP.IDPESSJUR = EL.IDPESSJUR'
      'AND    PP.IDPESSOA = EL.IDPESSOA'
      'AND    PP.SEQPROPOSTA = 1'
      'AND    PP.IDSITPART = SP.IDSITPART'
      'UNION'
      'SELECT /*+ INDEX (BENEFBFCIARIO XIF5BENEFBFCIARIO) */'
      '       DISTINCT'
      '       PP.IDPESSJUR,'
      '       PP.IDPLANOPREV,'
      '       PP.IDPESSOA,'
      '       PP.SEQPROPOSTA,'
      '       PP.INSCRICAONUMERO,'
      '       EL.MATRICULA, '#39'AS'#39' AS FLGINTERNO'
      'FROM   BENEFPLANPREV BP, PARTPREVPLAN PP, ELEGPATRO EL,'
      '       BENEFBFCIARIO BF, SITPART SP'
      'WHERE  BP.IDPLANOPREV    = :IDPLANOPREV'
      'AND    BP.FLGCALCTODOMES = 1'
      'AND    SP.FLGINTERNO = '#39'AS'#39
      'AND    PP.IDPLANOPREV    = BP.IDPLANOPREV'
      'AND    PP.IDPESSJUR      = EL.IDPESSJUR'
      'AND    PP.IDPESSOA       = EL.IDPESSOA'
      'AND    BF.IDPESSJUR      = PP.IDPESSJUR'
      'AND    BF.IDPLANOPREV    = PP.IDPLANOPREV'
      'AND    BF.IDTITULAR      = PP.IDPESSOA'
      'AND    BF.IDPESSOA       = PP.IDPESSOA'
      'AND    BF.IDBENEFICIO    = BP.IDBENEFICIO'
      'AND    BF.SEQPROPOSTA    = PP.SEQPROPOSTA'
      'AND    PP.IDSITPART = SP.IDSITPART'
      ''
      ''
      '')
    ValidateWithMask = True
    Left = 172
    Top = 6
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end>
  end
  object qryAux: TwwQuery
    DatabaseName = 'BaseDados'
    ValidateWithMask = True
    Left = 256
    Top = 6
  end
  object qryReserva: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '     RXP.FLGCONTROLE,'
      '     RXP.FLGTRANSFERENCIA,'
      '     RXP.FLGTITULARCOLET,'
      '     RP.VALORRESERVA,'
      '     RXP.INDICEREAJUSTE,'
      '     RXP.IDTIPORESERVA'
      'FROM RESERVAPART RP, RESERVAXPLANO RXP'
      'WHERE RP.IDPESSJUR = :IDPESSJUR'
      'AND   RP.IDPESSOA = :IDPESSOA'
      'AND   RP.IDPLANOPREV = :IDPLANOPREV'
      'AND   RP.SEQPROPOSTA = :SEQPROPOSTA'
      'AND   RP.IDPLANOPREV = RXP.IDPLANOPREV'
      'AND   RP.IDTIPORESERVA = RXP.IDTIPORESERVA'
      'ORDER BY'
      '     RXP.FLGCONTROLE,'
      '     RXP.FLGTRANSFERENCIA,'
      '     RXP.FLGTITULARCOLET'
      '')
    ValidateWithMask = True
    Left = 284
    Top = 6
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'SEQPROPOSTA'
        ParamType = ptUnknown
      end>
  end
  object qryGarantia: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '     RP.VALORRESERVA,'
      '     RXP.INDICEREAJUSTE'
      'FROM RESERVAPART RP, RESERVAXPLANO RXP, PLANPREV PL'
      'WHERE RP.IDPESSJUR = :IDPESSJUR'
      'AND   RP.IDPESSOA = :IDPESSOA'
      'AND   RP.IDPLANOPREV = :IDPLANOPREV'
      'AND   RP.SEQPROPOSTA = :SEQPROPOSTA'
      'AND   RP.IDPLANOPREV = PL.IDPLANOPREV'
      'AND   PL.IDPLANOPREV = RXP.IDPLANOPREV'
      'AND   PL. IDRESCONTROLEATU = RXP.IDTIPORESERVA'
      'AND   RXP.FLGCONTROLE = 1'
      ''
      ''
      '')
    ValidateWithMask = True
    Left = 200
    Top = 6
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'SEQPROPOSTA'
        ParamType = ptUnknown
      end>
  end
