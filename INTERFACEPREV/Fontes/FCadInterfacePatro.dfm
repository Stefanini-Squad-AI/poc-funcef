    ModifySQL.Strings = (
      'update PARAMINTERFDEP'
      'set'
      '  DPMATRICULATAM = :DPMATRICULATAM,'
      '  DPMATRICULAINI = :DPMATRICULAINI,'
      '  DPINSCRICAOTAM = :DPINSCRICAOTAM,'
