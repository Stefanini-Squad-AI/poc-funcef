      object Memo1: TMemo
        Left = 664
        Top = 336
        Width = 249
        Height = 297
        Lines.Strings = (
          'Como trabalhar com esta tela:'
          ''
          'Cada item da barra tipo outlook '
          'corresponde a um panel'
          'que deve ser mostrado de forma '
          'única, ou seja, Align : AlClient e'
          'BingToFront. Procure o painel '
          'posicionando painel por'
          'painel para tráz com o SendToBack '
          'até'
          'achar ...'
          ''
          'Para saber em que panel mexer olhe '
          'a descrição abaixo:'
          ''
          'Financeiro'
          '   pnlRubricas (PageControl '
          ':pgcRubricas)'
          ''
          ''
          'Cadastral'
          '   pnlDadosCad (PageControl: '
          'pgcDadosCad)'
          '   pnlLotacoes'
          '   pnlEndereco'
          '   pnlEventos'
          '   pnlDependentes'
          '   pnlEvolFunc'
          ''
          'Tabelas'
          '   pnlTabBancos'
          '   pnlTabCargo'
          '   pnlTabNivel'
          '   pnlTabOrgao'
          '   pnlTabSituacao'
          '   pnlTabLocais'
          '   pnlTabRubricas'
          ''
          'Testes'
          '   pnlTesteFinanc'
          '   pnlTesteCadastral (Page Contrl: '
          'pgctrTesteDadosCad)'
          '   pnlTesteTabelas (Page Control: '
          'pgctrTesteTabelas)')
        TabOrder = 16
        Visible = False
      end
    end
