      '  EFTPADICINI = :EFTPADICINI,'
      '  EFPCADICTAM = :EFPCADICTAM,'
      '  EFPCADICINI = :EFPCADICINI,'
      '  IDREGEVOLFUNC = :IDREGEVOLFUNC,'
      '  IDREGEVOLFUNCINI = :IDREGEVOLFUNCINI,'
      '  IDREGEVOLFUNCTAM = :IDREGEVOLFUNCTAM,'
      '  IDPARTEVOLFUNC = :IDPARTEVOLFUNC,'
      '  EFIDPESSOATAM  = :EFIDPESSOATAM  ,'
      '  EFIDPESSOAINI  = :EFIDPESSOAINI  ,'
      '  EFIDPLANOPREVTAM  = :EFIDPLANOPREVTAM  ,'
      '  EFIDPLANOPREVINI  = :EFIDPLANOPREVINI  ,'
      ' EFTIPOREGTAM = :EFTIPOREGTAM ,'
      ' EFTIPOREGINI = :EFTIPOREGINI ,'
      ' EFMODOTAM = :EFMODOTAM ,'
      ' EFMODOINI = :EFMODOINI ,'
      ' EFQTDEMINTAM = :EFQTDEMINTAM ,'
      ' EFQTDEMININI= :EFQTDEMINTAM '
      'where'
      '  IDPESSJUR = :OLD_IDPESSJUR')
    InsertSQL.Strings = (
      'insert into PARAMINTERFEVOL'
      '  (IDPESSJUR, EFMATRICULATAM, EFMATRICULAINI, EFINSCRICAOTAM, '
      'EFINSCRICAOINI, '
      '   EFCARGOINI, EFCARGOTAM, EFCARGOCONTEUDO, EFDTINICARGOTAM, '
      'EFDTINICARGOINI, '
      '   EFDTINIFORMATO, EFDTFIMCARGOINI, EFDTFIMCARGOTAM, '
      'EFDTFIMFORMATO, EFTPADICTAM, '
      '   EFTPADICINI, EFPCADICTAM, EFPCADICINI, IDREGEVOLFUNC, '
      'IDREGEVOLFUNCINI, '
      '   IDREGEVOLFUNCTAM, IDPARTEVOLFUNC, EFIDPESSOATAM ,'
      'EFIDPESSOAINI ,'
      'EFIDPLANOPREVTAM ,'
      'EFIDPLANOPREVINI,'
      'EFTIPOREGTAM ,'
      'EFTIPOREGINI ,'
      'EFMODOTAM ,'
      'EFMODOINI ,'
      'EFQTDEMINTAM ,'
      'EFQTDEMININI  )'
      'values'
      
        '  (:IDPESSJUR, :EFMATRICULATAM, :EFMATRICULAINI, :EFINSCRICAOTAM' +
        ', '
      ':EFINSCRICAOINI, '
      
        '   :EFCARGOINI, :EFCARGOTAM, :EFCARGOCONTEUDO, :EFDTINICARGOTAM,' +
        ' '
      ':EFDTINICARGOINI, '
