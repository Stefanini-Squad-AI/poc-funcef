  object qryPatroCombo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT P.IDPESSOA, P.NOME'
      'FROM   PESSOA P, PATRO PT'
      'WHERE  (PT.IDPESSOA = P.IDPESSOA)'
      'AND    PT.IDFUNDACAO = :IDFUNDACAO'
      'ORDER BY P.NOME'
      ''
      ' ')
    ValidateWithMask = True
    Left = 499
    Top = 4
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDFUNDACAO'
        ParamType = ptUnknown
      end>
  end
  object qryTipoDocPessoa: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDDOCUMENTO , NOMEDOCUMENTO'
      'FROM TIPODOCPESSOA '
      'WHERE FISICAJURIDICA = '#39'F'#39
      'ORDER BY NOMEDOCUMENTO')
    ValidateWithMask = True
    Left = 67
    Top = 4
  end
