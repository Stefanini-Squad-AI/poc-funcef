  object qryPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '
      'P.IDPESSOA,P.NOME,'
      'PI.*'
      'FROM   PESSOA P, PATRO PT, PARAMINTERF PI'
      ''
      'WHERE  '
      ''
      'P.FLGPATROCINADORA = 1'
      'AND    PT.IDPESSOA = P.IDPESSOA'
      'AND    PT.IDPESSOA = PI.IDPESSJUR'
      ''
      'ORDER BY P.NOME')
    ValidateWithMask = True
    Left = 564
    Top = 7
  end
