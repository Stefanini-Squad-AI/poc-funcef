  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT'
      '            IDRESTRICAO,'
      '            IDFORCLI,'
      '            IDPESSOA,'
      '            CODARTIGO,'
      '            DATAINI,'
      '            DATAFIM,'
      '            FLGFLEXIVEL,'
      '            MOTIVO'
      'FROM'
      '            RESTRICAO'
      'WHERE'
      '            (IDRESTRICAO = :pIDREST)')
    Left = 271
    ParamData = <
      item
        DataType = ftFloat
        Name = 'pIDREST'
        ParamType = ptUnknown
      end>
