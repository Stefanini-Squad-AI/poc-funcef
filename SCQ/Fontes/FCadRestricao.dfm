  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update RESTRICAO'
      'set'
      '  IDRESTRICAO = :IDRESTRICAO,'
      '  IDFORCLI = :IDFORCLI,'
      '  IDPESSOA = :IDPESSOA,'
      '  CODARTIGO = :CODARTIGO,'
      '  DATAINI = :DATAINI,'
      '  DATAFIM = :DATAFIM,'
      '  FLGFLEXIVEL = :FLGFLEXIVEL,'
      '  MOTIVO = :MOTIVO'
      'where'
      '  IDRESTRICAO = :OLD_IDRESTRICAO')
    InsertSQL.Strings = (
      'insert into RESTRICAO'
      
        '  (IDRESTRICAO, IDFORCLI, IDPESSOA, CODARTIGO, DATAINI, DATAFIM,' +
        ' '
      'FLGFLEXIVEL, '
      '   MOTIVO)'
      'values'
      
        '  (:IDRESTRICAO, :IDFORCLI, :IDPESSOA, :CODARTIGO, :DATAINI, :DA' +
        'TAFIM, '
      '   :FLGFLEXIVEL, :MOTIVO)')
    DeleteSQL.Strings = (
      'delete from RESTRICAO'
      'where'
      '  IDRESTRICAO = :OLD_IDRESTRICAO')
    Left = 241
  end
