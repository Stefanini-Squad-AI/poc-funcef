  object qryRubricas: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT'
      #9'PD.IDPROVENTO,'
      #9'PD.IDPROVENTO||'#39'-'#39'||PD.DESCRICAO AS DESCRICAO'
      'FROM '
      #9'PARAMAPREV PAV,'
      #9'PROVDESC PD'
      'WHERE'
      #9'PD.IDPROVENTO = PAV.IDRUBIRRF OR'
      #9'PD.IDPROVENTO = PAV.IDRUBIRRFINSS OR'
      #9'PD.IDPROVENTO = PAV.IDRUBIRRFABONO OR'
      #9'PD.IDPROVENTO = PAV.IDRUBIRRFEXT OR'
      #9'PD.IDPROVENTO = PAV.IDRUBIRRFPENSAO OR'
      #9'PD.IDPROVENTO = PAV.IDRUBIRRFPENALIM OR'
      #9'PD.IDPROVENTO = PAV.IDRUBIRRFRESG OR'
      #9'PD.IDPROVENTO = PAV.IDRUBIRRFCOMPIR'
      'ORDER BY DESCRICAO'
      ''
      ' '
      ' ')
    ValidateWithMask = True
    Left = 412
    Top = 137
  end
  object qryVersoes: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '
      #9'IDHSTFOLHABENEF,'
      #9'IDHSTFOLHABENEF||'#39' - '#39'||HISTORICO AS DESCRICAO'
      'FROM'
      #9'HSTFOLHABENEF'
      'ORDER BY IDHSTFOLHABENEF DESC'
      '')
    ValidateWithMask = True
    Left = 484
    Top = 137
  end
end
