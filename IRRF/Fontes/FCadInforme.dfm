  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update INFORME'
      'set'
      '  IDINFORME = :IDINFORME,'
      '  NOMEINFORME = :NOMEINFORME,'
      '  CODINFORME = :CODINFORME,'
      '  CODDIRF = :CODDIRF,'
      '  FLGIRRF = :FLGIRRF,'
      '  FLGBASE = :FLGBASE,'
      '  FLGNATUREZA = :FLGNATUREZA'
      'where'
      '  IDINFORME = :OLD_IDINFORME')
    InsertSQL.Strings = (
      'insert into INFORME'
      
        '  (IDINFORME, NOMEINFORME, CODINFORME, CODDIRF, FLGIRRF, FLGBASE' +
        ', FLGNATUREZA)'
      'values'
      
        '  (:IDINFORME, :NOMEINFORME, :CODINFORME, :CODDIRF, :FLGIRRF, :F' +
        'LGBASE, '
      '   :FLGNATUREZA)')
    DeleteSQL.Strings = (
      'delete from INFORME'
      'where'
      '  IDINFORME = :OLD_IDINFORME')
    Left = 411
    Top = 6
  end
