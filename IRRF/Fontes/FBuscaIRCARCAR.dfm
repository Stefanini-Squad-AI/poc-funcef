  object qryTipoDesemb: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT T.FLGCALCULAIMPOSTO FROM TIPORECEBDESEMB T, RATEIODOCUM R'
      'WHERE (R.CODDOCUMENTO = :CODDOCUMENTO) AND'
      '      (T.FLGCALCULAIMPOSTO = '#39'S'#39') AND'
      '      (T.CODTIPRECDES = R.CODTIPRECDES) AND'
      '      (T.RECPAG = R.RECPAG) AND'
      '      (T.IDPESSOA = R.IDPESSOA)')
    ValidateWithMask = True
    Left = 108
    Top = 140
    ParamData = <
      item
        DataType = ftFloat
        Name = 'CODDOCUMENTO'
        ParamType = ptUnknown
      end>
  end
  object qryRateioPlanoPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT R.IDPATRO,'
      '       R.IDPLANOPREV,'
      '       R.IDPROGRAMA,'
      '       R.CODCENTROCUSTO,'
      '       DECODE(T.TOTAL,0,0,(SUM(R.VALOR)/T.TOTAL)) AS PERC'
      'FROM  RATEIODOCUM R,'
      '     (SELECT SUM(VALOR) AS TOTAL'
      '      FROM RATEIODOCUM'
      '      WHERE CODDOCUMENTO = :CODDOCUMENTO) T'
      'WHERE (R.CODDOCUMENTO = :CODDOCUMENTO)'
      
        'GROUP BY R.IDPATRO, R.IDPLANOPREV, R.IDPROGRAMA, R.CODCENTROCUST' +
        'O, T.TOTAL'
      ' ')
    ValidateWithMask = True
    Left = 57
    Top = 71
    ParamData = <
      item
        DataType = ftFloat
        Name = 'CODDOCUMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'CODDOCUMENTO'
        ParamType = ptUnknown
      end>
    object qryRateioPlanoPatroIDPATRO: TFloatField
      FieldName = 'IDPATRO'
    end
    object qryRateioPlanoPatroIDPLANOPREV: TFloatField
      FieldName = 'IDPLANOPREV'
    end
    object qryRateioPlanoPatroIDPROGRAMA: TFloatField
      FieldName = 'IDPROGRAMA'
    end
    object qryRateioPlanoPatroPERC: TFloatField
      FieldName = 'PERC'
    end
    object qryRateioPlanoPatroCODCENTROCUSTO: TStringField
      FieldName = 'CODCENTROCUSTO'
      FixedChar = True
      Size = 10
    end
  end
