  object SQLVersoesFolha: TCMSqlParams
    SQL.Strings = (
      'SELECT * FROM ('
      
        '     SELECT 0 ORDEM, '#39'Selecione Versão da Folha'#39' AS HISTORICO, -' +
        '1 AS IDHSTFOLHABENEF, NULL DATAPREVPAGTO, '#39#39' MESREFERENCIA'
      '     FROM DUAL                    '
      '    UNION ALL                     '
      
        '     SELECT 1 ORDEM, IDHSTFOLHABENEF || '#39'-'#39' || HISTORICO AS HIST' +
        'ORICO, IDHSTFOLHABENEF, DATAPREVPAGTO, MESREFERENCIA '
      '     FROM HSTFOLHABENEF                  '
      '     WHERE DATAPREVPAGTO IS NOT NULL     '
      '           AND FLGTIPOFOLHA = '#39'0'#39
      
        '           AND TO_CHAR(DATAPREVPAGTO, '#39'YYYY'#39') >= TO_CHAR(SYSDATE' +
        ', '#39'YYYY'#39') - 1'
      '           AND IDHSTFOLHABENEF = 0  )'
      '   ORDER BY ORDEM, IDHSTFOLHABENEF DESC'
      ' '
      ' ')
    ClientDataSet = cdsVersoesFolha
    Left = 45
    Top = 286
  end
