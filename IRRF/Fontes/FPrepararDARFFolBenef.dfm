  object SQLMovSelDARF: TCMSqlParams
    SQL.Strings = (
      'SELECT '#39'S'#39' MARCADO,'
      '       H.IDHSTFOLHABENEF,'
      '       H.NUMDOCUMENTO,'
      '       H.IDRESPONSAVEL,'
      '       H.MESCOBRANCA,'
      '       H.MES,'
      '       H.IDPESSOA,'
      '       H.IDPESSJUR,'
      '       NVL(PE.RAZAOSOCIAL, PE.NOME) NOME,'
      '       H.CODIRRFDARF,'
      '       H.DATAPAGAMENTO,'
      '       H.CODPROVDESC,'
      '       H.IDMOTIVO,'
      
        '       DECODE(H.FLGDESCONTO, 1, H.VALORPROVENTO, (H.VALORPROVENT' +
        'O * -1)) AS VALORPROVENTO,'
      '       H.VALORINFO,'
      '       H.IDINFORME,'
      '       H.IDPROCJUD,'
      '       H.FONTEPAGADORA,'
      '       H.FLGTIPODESC,'
      '       H.IDPLANOCONTABIL,'
      '       PC.NOME AS NOMEPLANO,'
      '       H.IDPATRO,'
      '       PA.NOME AS NOMEPATRO,'
      
        '       DECODE(H.FLGTIPODESC, '#39'I'#39', DECODE(TRIM(RX.CODTIPRECDESFAV' +
        '), '#39#39', H.CODTIPRECDES, RX.CODTIPRECDESFAV),'
      
        '                              DECODE(TRIM(H.CODTIPRECDES), '#39#39', R' +
        'X.CODTIPRECDES, H.CODTIPRECDES)) AS CODTIPRECDES,'
      '       H.IDPLANOPREV,'
      '       DECODE(P.FLGDESCONTO, 0, NVL(H.PLACONTAD, RX.PLACONTAD),'
      
        '                                NVL(H.PLACONTAC, RX.PLACONTAC)) ' +
        'AS PLACONTAC,'
      '       M.DESCRICAO,'
      '       P.DESCRICAO DESCPROVENTO,'
      '       CR.VALORPARAM AS CODCENTROCUSTO,'
      '       H.CODCENTRORESPON,'
      '       PR.IDPROGRAMA AS IDPROGRAMA,'
      '       H.PLANO'
      '  FROM HISTRUBSAL H'
      '  JOIN PROVDESC P ON P.CODPROVDESC = H.CODPROVDESC'
      '  JOIN PESSOA PE ON PE.IDPESSOA = H.IDPESSOA '
      '  JOIN PLANPREVCONTABIL PC ON PC.IDPLANOPREV = H.IDPLANOCONTABIL'
      '  JOIN PESSOA PA ON PA.IDPESSOA = H.IDPATRO'
      '  JOIN MOTIVO M ON M.IDMOTIVO = H.IDMOTIVO'
      
        '  JOIN (SELECT VALORPARAM FROM PARAMFOLHA WHERE NOMEPARAM = '#39'COD' +
        'CCUSTOFINAN'#39') CR ON 1 = 1'
      '  JOIN PROGRAMA PR ON PR.FLGTIPOPROGRAMA = '#39'PRE'#39
      
        '  INNER JOIN RUBRICAXPLANO RX ON (H.IDPATRO = RX.IDPESSJUR) AND ' +
        '(H.IDRUBRICA = RX.IDRUBRICA) AND (H.IDPLANOPREV = RX.IDPLANOPREV' +
        ')'
      'where-- H.CODIRRFDARF = '#39'3540'#39
      '  -- and H.MESCOBRANCA = '#39'2016/10'#39
      '  -- and H.MES = '#39'2016/10'#39
      '  -- and H.FLGIRRF = 0'
      '  -- and H.FLGTIPODESC = '#39'I'#39
      '   H.IDHSTFOLHABENEF = -1'
      '   AND H.IDTITULAR = -1'
      '   AND H.IDMODULO = -1 --18'
      'order by H.IDHSTFOLHABENEF, H.NUMDOCUMENTO'
      ''
      ''
      ''
      ''
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ClientDataSet = cdsMovSelDARF
    Left = 305
    Top = 280
  end
