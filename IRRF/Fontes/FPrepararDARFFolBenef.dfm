  object updLancManual: TUpdateSQL
    ModifySQL.Strings = (
      'update IRRFFOLHABENEF'
      'set'
      '  IDLANCIRRFFOLHABENEF = :IDLANCIRRFFOLHABENEF,'
      '  IDHSTFOLHABENEF = :IDHSTFOLHABENEF,'
      '  NUMDOCUMENTO = :NUMDOCUMENTO,'
      '  IDPESSOA = :IDPESSOA,'
      '  CODNATUREZA = :CODNATUREZA,'
      '  IDPATRO = :IDPATRO,'
      '  IDPLANOPREV = :IDPLANOPREV,'
      '  IDMOTIVO = :IDMOTIVO,'
      '  IDINFORME = :IDINFORME,'
      '  IDDARF = :IDDARF,'
      '  CODDOCUMENTO = :CODDOCUMENTO,'
      '  IDPROCJUD = :IDPROCJUD,'
      '  CODTIPRECDES = :CODTIPRECDES,'
      '  CODPROVDESC = :CODPROVDESC,'
      '  FONTEPAGADORA = :FONTEPAGADORA,'
      '  PLANO = :PLANO,'
      '  PLACONTA = :PLACONTA,'
      '  MESCOBRANCA = :MESCOBRANCA,'
      '  MESREFERENCIA = :MESREFERENCIA,'
      '  DATAPAGAMENTO = :DATAPAGAMENTO,'
      '  DATAVENCIMENTO = :DATAVENCIMENTO,'
      '  VLRIMPOSTO = :VLRIMPOSTO,'
      '  VLRBASE = :VLRBASE,'
      '  FLGREGEXCLUIDO = :FLGREGEXCLUIDO,'
      '  FLGTIPOFOLHA = :FLGTIPOFOLHA,'
      '  IDPROGRAMA = :IDPROGRAMA,'
      '  CODCENTROCUSTO = :CODCENTROCUSTO,'
      '  CODCENTRORESPON = :CODCENTRORESPON,'
      '  FLGTIPOINCLUSAO = :FLGTIPOINCLUSAO'
      'where'
      '  IDLANCIRRFFOLHABENEF = :OLD_IDLANCIRRFFOLHABENEF')
    InsertSQL.Strings = (
      'insert into IRRFFOLHABENEF'
      
        '  (IDLANCIRRFFOLHABENEF, IDHSTFOLHABENEF, NUMDOCUMENTO, IDPESSOA' +
        ', CODNATUREZA, '
      
        '   IDPATRO, IDPLANOPREV, IDMOTIVO, IDINFORME, IDDARF, CODDOCUMEN' +
        'TO, IDPROCJUD, '
      
        '   CODTIPRECDES, CODPROVDESC, FONTEPAGADORA, PLANO, PLACONTA, ME' +
        'SCOBRANCA, '
      
        '   MESREFERENCIA, DATAPAGAMENTO, DATAVENCIMENTO, VLRIMPOSTO, VLR' +
        'BASE, FLGREGEXCLUIDO, '
      
        '   FLGTIPOFOLHA, IDPROGRAMA, CODCENTROCUSTO, CODCENTRORESPON, FL' +
        'GTIPOINCLUSAO)'
      'values'
      
        '  (:IDLANCIRRFFOLHABENEF, :IDHSTFOLHABENEF, :NUMDOCUMENTO, :IDPE' +
        'SSOA, :CODNATUREZA, '
      
        '   :IDPATRO, :IDPLANOPREV, :IDMOTIVO, :IDINFORME, :IDDARF, :CODD' +
        'OCUMENTO, '
      
        '   :IDPROCJUD, :CODTIPRECDES, :CODPROVDESC, :FONTEPAGADORA, :PLA' +
        'NO, :PLACONTA, '
      
        '   :MESCOBRANCA, :MESREFERENCIA, :DATAPAGAMENTO, :DATAVENCIMENTO' +
        ', :VLRIMPOSTO, '
      
        '   :VLRBASE, :FLGREGEXCLUIDO, :FLGTIPOFOLHA, :IDPROGRAMA, :CODCE' +
        'NTROCUSTO, '
      '   :CODCENTRORESPON, :FLGTIPOINCLUSAO)')
    DeleteSQL.Strings = (
      'delete from IRRFFOLHABENEF'
      'where'
      '  IDLANCIRRFFOLHABENEF = :OLD_IDLANCIRRFFOLHABENEF')
    Left = 564
    Top = 277
  end
