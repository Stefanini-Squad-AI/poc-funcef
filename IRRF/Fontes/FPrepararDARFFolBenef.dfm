  object SqlMovPrepDARF: TCMSqlParams
    SQL.Strings = (
      'SELECT I.IDLANCIRRFFOLHABENEF,'
      '       I.IDHSTFOLHABENEF,'
      '       RTRIM(I.NUMDOCUMENTO) NUMDOCUMENTO,'
      '       I.IDPESSOA,'
      '       NVL(PE.RAZAOSOCIAL, PE.NOME) NOME,'
      '       I.CODNATUREZA,'
      '       I.IDPATRO,'
      '       I.IDPLANOPREV,'
      '       I.IDMOTIVO,'
      '       I.IDINFORME,'
      '       I.IDDARF,'
      '       I.CODDOCUMENTO,'
      '       I.IDPROCJUD,'
      '       I.CODTIPRECDES,'
      '       I.CODPROVDESC,'
      '       I.FONTEPAGADORA,'
      '       I.PLANO,'
      '       I.PLACONTA,'
      '       I.MESCOBRANCA,'
      '       I.MESREFERENCIA,'
      '       I.DATAPAGAMENTO,'
      '       I.DATAVENCIMENTO,'
      '       I.VLRIMPOSTO,'
      '       I.VLRBASE,'
      '       I.FLGREGEXCLUIDO,'
      '       I.FLGTIPOFOLHA,'
      '       I.IDPROGRAMA,'
      '       I.CODCENTROCUSTO,'
      '       I.CODCENTRORESPON,'
      '       I.FLGTIPOINCLUSAO,'
      '       PC.NOME AS NOMEPLANO,'
      '       PA.NOME AS NOMEPATRO'
      '  FROM IRRFFOLHABENEF I'
      '  JOIN PESSOA PE ON PE.IDPESSOA = I.IDPESSOA'
      '  JOIN PLANPREVCONTABIL PC ON PC.IDPLANOPREV = I.PLANO'
      '  JOIN PESSOA PA ON PA.IDPESSOA = I.IDPATRO'
      ' WHERE --I.CODNATUREZA = '#39'3540'#39
      '--   and I.MESCOBRANCA = '#39'2016/10'#39
      '--   and I.MESREFERENCIA = '#39'2016/10'#39
      ' I.IDHSTFOLHABENEF = -1'
      '   AND I.IDPESSOA = -1'
      'ORDER BY I.IDHSTFOLHABENEF, I.NUMDOCUMENTO'
      ''
      ''
      ''
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ClientDataSet = cdsMovPrepDARF
    Left = 428
    Top = 279
  end
