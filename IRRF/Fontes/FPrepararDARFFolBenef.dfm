  object SQLNaturRendimento: TCMSqlParams
    SQL.Strings = (
      
        'SELECT CODNATUREZA, DESCRICAO, (DESCRICAO || '#39' - ('#39' || CODNATURE' +
        'ZA || '#39')'#39') AS DESCRICAOCOMPL'
      '    FROM NATURENDIMENTO'
      '    WHERE FLGUSADONADCTF = '#39'S'#39
      '          AND GRUPOTRIBUTO IS NOT NULL'
      '    ORDER BY CODNATUREZA'
      ' '
      ' ')
    ClientDataSet = cdsNaturRendimento
    Left = 174
    Top = 224
  end
