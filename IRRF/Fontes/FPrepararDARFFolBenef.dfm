  object qryLancManual: TwwQuery
    CachedUpdates = True
    AutoRefresh = True
    DatabaseName = 'BaseDados'
    RequestLive = True
    SQL.Strings = (
      'SELECT I.IDLANCIRRFFOLHABENEF,'
      '       I.IDHSTFOLHABENEF,'
      '       I.NUMDOCUMENTO,'
      '       I.IDPESSOA,'
      '       NVL(PE.RAZAOSOCIAL, PE.NOME) AS NOME,'
      '       I.CODNATUREZA,'
      '       I.IDPATRO,'
      '       I.IDPLANOPREV,'
      '       I.IDMOTIVO,'
      '       I.IDINFORME,'
      '       I.IDDARF,'
      '       I.CODDOCUMENTO,'
      '       I.IDPROCJUD,'
      '       I.CODTIPRECDES,'
      '       I.CODPROVDESC,'
      '       I.FONTEPAGADORA,'
      '       I.PLANO,'
      '       I.PLACONTA,'
      '       I.MESCOBRANCA,'
      '       I.MESREFERENCIA,'
      '       I.DATAPAGAMENTO,'
      '       I.DATAVENCIMENTO,'
      '       I.VLRIMPOSTO,'
      '       I.VLRBASE,'
      '       I.FLGREGEXCLUIDO,'
      '       I.FLGTIPOFOLHA,'
      '       I.IDPROGRAMA,'
      '       I.CODCENTROCUSTO,'
      '       I.CODCENTRORESPON,'
      '       I.FLGTIPOINCLUSAO,'
      '       PC.NOME AS NOMEPLANO,'
      '       PA.NOME AS NOMEPATRO'
      '  FROM IRRFFOLHABENEF I'
      '  JOIN PESSOA PE ON PE.IDPESSOA = I.IDPESSOA'
      '  JOIN PLANPREVCONTABIL PC ON PC.IDPLANOPREV = I.PLANO'
      '  JOIN PESSOA PA ON PA.IDPESSOA = I.IDPATRO'
      ' WHERE I.IDHSTFOLHABENEF = -1'
      '   AND I.IDPESSOA = -1'
      '  AND I.FLGTIPOINCLUSAO = '#39'x'#39
      'ORDER BY I.IDHSTFOLHABENEF, I.NUMDOCUMENTO'
      ''
      ''
      ''
      ' '
      ''
      ''
      ''
      ' '
      ' ')
    UpdateObject = updLancManual
    ValidateWithMask = True
    Left = 563
    Top = 162
