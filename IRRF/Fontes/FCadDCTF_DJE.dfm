  object updDJEDet: TUpdateSQL
    ModifySQL.Strings = (
      'update DCTF_DARFDETALHE'
      'set'
      '  IDDCTF = :IDDCTF,'
      '  IDDCTFCRDETALHE_DARF = :IDDCTFCRDETALHE_DARF,'
      '  IDDARFDETALHE = :IDDARFDETALHE,'
      '  IDDARF = :IDDARF,'
      '  IDLANCIRRF = :IDLANCIRRF,'
      '  IDPESSOA = :IDPESSOA,'
      '  NUMDOCUMENTO = :NUMDOCUMENTO,'
      '  NOME = :NOME,'
      '  NUMEROPROCESSO = :NUMEROPROCESSO,'
      '  NUMEROPROCJUDICIAL = :NUMEROPROCJUDICIAL,'
      '  CODVARA = :CODVARA,'
      '  NOMEVARA = :NOMEVARA,'
      '  UFVARA = :UFVARA,'
      '  IDMUNICIPIO = :IDMUNICIPIO,'
      '  FLGFAZDEPOSITO = :FLGFAZDEPOSITO,'
      '  IDMOTIVOSUSPENSAO = :IDMOTIVOSUSPENSAO,'
      '  VLRIRRF = :VLRIRRF,'
      '  FLGREGEXCLUIDO = :FLGREGEXCLUIDO,'
      '  FLGMARCADO = :FLGMARCADO'
      'where'
      '  IDDCTF = :OLD_IDDCTF and'
      '  IDDCTFCRDETALHE_DARF = :OLD_IDDCTFCRDETALHE_DARF and'
      '  IDDARFDETALHE = :OLD_IDDARFDETALHE')
    InsertSQL.Strings = (
      'insert into DCTF_DARFDETALHE'
      
        '  (IDDCTF, IDDCTFCRDETALHE_DARF, IDDARFDETALHE, IDDARF, IDLANCIR' +
        'RF, IDPESSOA, '
      
        '   NUMDOCUMENTO, NOME, NUMEROPROCESSO, NUMEROPROCJUDICIAL, CODVA' +
        'RA, NOMEVARA, '
      
        '   UFVARA, IDMUNICIPIO, FLGFAZDEPOSITO, IDMOTIVOSUSPENSAO, VLRIR' +
        'RF, FLGREGEXCLUIDO, '
      '   FLGMARCADO)'
      'values'
      
        '  (:IDDCTF, :IDDCTFCRDETALHE_DARF, :IDDARFDETALHE, :IDDARF, :IDL' +
        'ANCIRRF, '
      
        '   :IDPESSOA, :NUMDOCUMENTO, :NOME, :NUMEROPROCESSO, :NUMEROPROC' +
        'JUDICIAL, '
      
        '   :CODVARA, :NOMEVARA, :UFVARA, :IDMUNICIPIO, :FLGFAZDEPOSITO, ' +
        ':IDMOTIVOSUSPENSAO, '
      '   :VLRIRRF, :FLGREGEXCLUIDO, :FLGMARCADO)')
    DeleteSQL.Strings = (
      'delete from DCTF_DARFDETALHE'
      'where'
      '  IDDCTF = :OLD_IDDCTF and'
      '  IDDCTFCRDETALHE_DARF = :OLD_IDDCTFCRDETALHE_DARF and'
      '  IDDARFDETALHE = :OLD_IDDARFDETALHE')
    Left = 93
    Top = 441
  end
