  object qryInforme: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDINFORME, NOMEINFORME,  CODINFORME'
      'FROM INFORME'
      'ORDER BY NOMEINFORME')
    ValidateWithMask = True
    Left = 728
    Top = 104
  end
  object qryNatur: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT CODNATUREZA,DESCRICAO'
      'FROM NATURENDIMENTO'
      'ORDER BY CODNATUREZA'
      ' ')
    ValidateWithMask = True
    Left = 648
    Top = 104
  end
  object qryLancamento: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT L.CODDOCUMENTO, D.IDFORCLI, L.CODALTERADOR, LB.DATALANCTO' +
        ', P.NOME,'
      
        '       LBBASE.VALOR AS VALBASE , D.IDPESSOA, SUM(L.VALOR) AS VAL' +
        'OR'
      'FROM LANCTODOCUM L, ALTXIMPOSTO A, DOCUMENTO D, PESSOA P, '
      '     (SELECT LB.CODDOCUMENTO, LB.DATALANCTO , LB.VALOR'
      '      FROM LANCTODOCUM LB'
      '      WHERE (LB.OPERACAO = 5)'
      
        '      AND (LB.DATALANCTO BETWEEN TO_DATE('#39'01/08/2004'#39','#39'DD/MM/YYY' +
        'Y'#39') AND TO_DATE('#39'31/12/2004'#39','#39'DD/MM/YYYY'#39') ) ) LB,'
      '     (SELECT LBBASE.CODDOCUMENTO, LBBASE.VALOR'
      '      FROM LANCTODOCUM LBBASE'
      '      WHERE (LBBASE.OPERACAO = 2) ) LBBASE'
      'WHERE (L.CODALTERADOR = A.CODALTERADOR)'
      'AND (A.CODIMPOSTO = 2)'
      'AND (P.IDPESSOA = D.IDFORCLI)'
      'AND (L.CODDOCUMENTO = LB.CODDOCUMENTO)'
      'AND (L.CODDOCUMENTO = LBBASE.CODDOCUMENTO)'
      'AND (L.CODDOCUMENTO = D.CODDOCUMENTO)'
      'AND (L.CODDOCUMENTO NOT IN ('
      '     SELECT L1.CODDOCUMENTO'
      '     FROM LANCTODOCUM L1, ALTXIMPOSTO A1,'
      '          (SELECT LB1.CODDOCUMENTO, LB1.DATALANCTO'
      '           FROM LANCTODOCUM LB1'
      '           WHERE (LB1.OPERACAO = 5)'
      
        '           AND (LB1.DATALANCTO BETWEEN TO_DATE('#39'01/08/2004'#39','#39'DD/' +
        'MM/YYYY'#39') AND TO_DATE('#39'31/12/2004'#39','#39'DD/MM/YYYY'#39') ) ) LB1'
      '     WHERE (L1.CODALTERADOR = A1.CODALTERADOR)'
      '     AND (A1.CODIMPOSTO = 1)'
      '     AND L1.CODDOCUMENTO = LB1.CODDOCUMENTO))'
      
        'GROUP BY L.CODDOCUMENTO, D.IDFORCLI, L.CODALTERADOR, LB.DATALANC' +
        'TO, P.NOME,'
      '         LBBASE.VALOR, D.IDPESSOA'
      'ORDER BY L.CODDOCUMENTO'
      '')
    ValidateWithMask = True
    Left = 576
    Top = 104
  end
  object qryInsLancIRRF: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'INSERT INTO LANCIRRF ('
      '  IDLANCIRRF,'
      '  IDBENEFIRRF,'
      '  DATALANCAMENTO,'
      '  CODDOCUMENTO,'
      '  IDPESSOA,'
      '  VLRBASE,'
      '  CODNATUREZA,'
      '  VLRIRRF,'
      '  IDMODULO)'
      'VALUES ('
      '  :pIDLANCIRRF,'
      '  :pIDBENEFIRRF,'
      '  :pDATALANCAMENTO,'
      '  :pCODDOCUMENTO,'
      '  :pIDPESSOA,'
      '  :pVLRBASE,'
      '  :pCODNATUREZA,'
      '  :pVLRINSS,'
      '  3)'
      ''
      ' ')
    ValidateWithMask = True
    Left = 512
    Top = 104
    ParamData = <
      item
        DataType = ftFloat
        Name = 'pIDLANCIRRF'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'pIDBENEFIRRF'
        ParamType = ptUnknown
      end
      item
        DataType = ftDateTime
        Name = 'pDATALANCAMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'pCODDOCUMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'pIDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'pVLRBASE'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'pCODNATUREZA'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'pVLRINSS'
        ParamType = ptUnknown
      end>
  end
