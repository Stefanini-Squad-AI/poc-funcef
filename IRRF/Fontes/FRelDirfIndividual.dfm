  object qry: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT *'
      'FROM'
      
        '(SELECT A.CPF, A.NOME, A.MESCOBRANCA,  A.MESCOBRANCA MES, A.NATU' +
        'REZA,'
      
        '        A.VALOR VALOR_1, B.VALOR VALOR_2, C.VALOR VALOR_3, D.VAL' +
        'OR VALOR_4, E.VALOR VALOR_5, '
      '        F.VALOR VALOR_6, H.VALOR VALOR_7, I.VALOR VALOR_8, '
      '        J.VALOR VALOR_9, '#39'-'#39' VALOR_10'
      ''
      'FROM'
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', H.CODIRRFDARF NATUREZA, SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pInicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 4'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA,'
      '       H.CODIRRFDARF) A,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pInicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 25'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) B,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pInicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME IN (19,64)'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) C,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pInicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 148'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) D,   '
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pInicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 6'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) E,           '
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pInicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 7'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) F,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR, H.CODIRRFDARF NATUREZA'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 52'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, H.CODIRRFDARF,'
      '       H.MESCOBRANCA) H,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 10'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) I,       '
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 20'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) J'
      '       '
      'WHERE  A.CPF = B.CPF (+)'
      'AND    A.MESCOBRANCA = B.MESCOBRANCA (+) '
      'AND    A.CPF = C.CPF (+)'
      'AND    A.MESCOBRANCA = C.MESCOBRANCA (+)'
      'AND    A.CPF = D.CPF (+)'
      'AND    A.MESCOBRANCA = D.MESCOBRANCA (+)'
      'AND    A.CPF = E.CPF (+)'
      'AND    A.MESCOBRANCA = E.MESCOBRANCA (+)'
      'AND    A.CPF = F.CPF (+)'
      'AND    A.MESCOBRANCA = F.MESCOBRANCA (+)'
      'AND    A.CPF = H.CPF (+)'
      'AND    A.MESCOBRANCA = H.MESCOBRANCA (+) '
      'AND    A.CPF = I.CPF (+)'
      'AND    A.MESCOBRANCA = I.MESCOBRANCA (+)'
      'AND    A.CPF = J.CPF (+)'
      'AND    A.MESCOBRANCA = J.MESCOBRANCA (+)'
      '--ORDER BY 1,3'
      ''
      'UNION'
      ''
      
        'SELECT  A.CPF, A.NOME, '#39'TOTAL'#39' MESCOBRANCA, cast(:pDt13 as char(' +
        '7)) MES, A.NATUREZA,'
      
        '        SUM(A.VALOR) VALOR_1, SUM(B.VALOR) VALOR_2, SUM(C.VALOR)' +
        ' VALOR_3, '
      
        '        SUM(D.VALOR) VALOR_4, SUM(E.VALOR) VALOR_5, SUM(F.VALOR)' +
        ' VALOR_6,'
      '        SUM(H.VALOR) VALOR_7, SUM(I.VALOR) VALOR_8, '
      '        SUM(J.VALOR) VALOR_9, '#39'-'#39' VALOR_10'
      ''
      'FROM'
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', H.CODIRRFDARF NATUREZA, SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 4'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA,'
      '       H.CODIRRFDARF) A,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 25'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) B,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME IN (19,64)'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) C,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 148'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) D,   '
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 6'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) E,           '
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 7'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) F,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR, H.CODIRRFDARF NATUREZA'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 52'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, H.CODIRRFDARF,'
      '       H.MESCOBRANCA) H,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 10'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) I,       '
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, H.MESCOBRANCA' +
        ', SUM(H.VALORPROVENTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 20'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       H.MESCOBRANCA) J'
      '       '
      'WHERE  A.CPF = B.CPF (+)'
      'AND    A.MESCOBRANCA = B.MESCOBRANCA (+) '
      'AND    A.CPF = C.CPF (+)'
      'AND    A.MESCOBRANCA = C.MESCOBRANCA (+)'
      'AND    A.CPF = D.CPF (+)'
      'AND    A.MESCOBRANCA = D.MESCOBRANCA (+)'
      'AND    A.CPF = E.CPF (+)'
      'AND    A.MESCOBRANCA = E.MESCOBRANCA (+)'
      'AND    A.CPF = F.CPF (+)'
      'AND    A.MESCOBRANCA = F.MESCOBRANCA (+)'
      'AND    A.CPF = H.CPF (+)'
      'AND    A.MESCOBRANCA = H.MESCOBRANCA (+) '
      'AND    A.CPF = I.CPF (+)'
      'AND    A.MESCOBRANCA = I.MESCOBRANCA (+)'
      'AND    A.CPF = J.CPF (+)'
      'AND    A.MESCOBRANCA = J.MESCOBRANCA (+)'
      
        'GROUP BY A.CPF, A.NOME, '#39'TOTAL'#39', cast(:pDt13 as char(7)), A.NATU' +
        'REZA'
      'ORDER BY 2,4)'
      ''
      ''
      ''
      'UNION'
      
        'SELECT  AA.CPF, AA.NOME, cast(:pDt13 as char(7)) MESCOBRANCA, ca' +
        'st(:pDt14 as char(7)) MES, AA.NATUREZA,'
      
        '        AA.VALOR VALOR_1, BB.VALOR VALOR_2, CC.VALOR VALOR_3, DD' +
        '.VALOR VALOR_4, EE.VALOR VALOR_5, '
      '        FF.VALOR VALOR_6, 0, 0, 0, '#39'-'#39
      ''
      'FROM'
      ''
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, cast(:pDt13 a' +
        's char(7)) MESCOBRANCA, H.CODIRRFDARF NATUREZA, SUM(H.VALORPROVE' +
        'NTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 15'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       cast(:pDt13 as char(7)),'
      '       H.CODIRRFDARF) AA,'
      '     '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, cast(:pDt13 a' +
        's char(7)) MESCOBRANCA, H.CODIRRFDARF NATUREZA, SUM(H.VALORPROVE' +
        'NTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 153'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       cast(:pDt13 as char(7)),'
      '       H.CODIRRFDARF) BB,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, cast(:pDt13 a' +
        's char(7)) MESCOBRANCA, H.CODIRRFDARF NATUREZA, SUM(H.VALORPROVE' +
        'NTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 156'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       cast(:pDt13 as char(7)),'
      '       H.CODIRRFDARF) CC,'
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, cast(:pDt13 a' +
        's char(7)) MESCOBRANCA, H.CODIRRFDARF NATUREZA, SUM(H.VALORPROVE' +
        'NTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 154'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       cast(:pDt13 as char(7)),'
      '       H.CODIRRFDARF) DD,   '
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, cast(:pDt13 a' +
        's char(7)) MESCOBRANCA, H.CODIRRFDARF NATUREZA, SUM(H.VALORPROVE' +
        'NTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 155'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       cast(:pDt13 as char(7)),'
      '       H.CODIRRFDARF) EE,           '
      '       '
      
        '(SELECT DISTINCT TRIM(P.NUMDOCUMENTO) CPF, P.NOME, cast(:pDt13 a' +
        's char(7)) MESCOBRANCA, H.CODIRRFDARF NATUREZA, SUM(H.VALORPROVE' +
        'NTO) VALOR'
      'FROM   PESSOA P, HISTRUBSAL H'
      'WHERE  P.IDPESSOA = H.IDPESSOA'
      'AND    H.MESCOBRANCA BETWEEN :pinicio AND :pFinal'
      'AND    P.IDPESSOA = :pIdPessoa'
      'AND    H.IDINFORME = 22'
      'AND    H.CODIRRFDARF IN (0561,0588)'
      'GROUP  BY '
      '       TRIM(P.NUMDOCUMENTO), '
      '       P.NOME, '
      '       cast(:pDt13 as char(7)),'
      '       H.CODIRRFDARF) FF  '
      '       '
      'WHERE  AA.CPF = BB.CPF (+)'
      'AND    AA.MESCOBRANCA = BB.MESCOBRANCA (+) '
      'AND    AA.CPF = CC.CPF (+)'
      'AND    AA.MESCOBRANCA = CC.MESCOBRANCA (+)'
      'AND    AA.CPF = DD.CPF (+)'
      'AND    AA.MESCOBRANCA = DD.MESCOBRANCA (+)'
      'AND    AA.CPF = EE.CPF (+)'
      'AND    AA.MESCOBRANCA = EE.MESCOBRANCA (+)'
      'AND    AA.CPF = FF.CPF (+)'
      'AND    AA.MESCOBRANCA = FF.MESCOBRANCA (+)'
      ''
      'ORDER BY 2,4'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
