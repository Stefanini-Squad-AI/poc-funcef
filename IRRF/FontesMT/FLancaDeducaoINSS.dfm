  object qryInsertLanc: TQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'INSERT INTO LANCIRRF (IDLANCIRRF, IDBENEFIRRF, DATALANCAMENTO, C' +
        'ODDOCUMENTO, IDPESSOA,'
      '                      VLRBASE, CODNATUREZA, VLRINSS)'
      
        'VALUES (:IDLANCIRRF, :IDBENEFIRRF, :DATALANCAMENTO, :CODDOCUMENT' +
        'O, :IDPESSOA,'
      '                      :VLRBASE, :CODNATUREZA, :VLRINSS)'
      ' '
      ' ')
    Left = 304
