    object cdsDocNOME: TStringField
      FieldName = 'NOME'
      Size = 60
    end
  end
  object dtsDoc: TwwDataSource
    DataSet = cdsDoc
    Left = 314
    Top = 82
  end
  object sqlDoc: TCMSqlParams
    SQL.Strings = (
      'SELECT * FROM ( '
      'SELECT '
      '  '#39'S'#39' AS FLAG, '
      '  PES.TIPO,'
      '  ('#39'P'#39' || PES.TIPO) AS TIPO_PES,  '
      '  PES.NOME,  '
      '  SUM(LIR.VLRBASE) AS VLRBASE, '
      '  SUM(LIR.VLRINSS) AS VALOR, '
      '  LIR.CODDOCUMENTO, '
      '  DOC.NODOCUMENTO, '
      '  LIR.DATALANCAMENTO, '
      '  LIR.IDBENEFIRRF, '
      '  LIR.CODNATUREZA, '
      '  LIR.CODIGOGPS '
      'FROM '
      '  LANCIRRF  LIR, '
      '  PESSOA    PES, '
      '  DOCUMENTO DOC  '
      'WHERE '
      '      LIR.IDBENEFIRRF                       = PES.IDPESSOA '
      '  AND LIR.CODDOCUMENTO                      = DOC.CODDOCUMENTO '
      
        '  AND LIR.DATALANCAMENTO                    BETWEEN TO_DATE('#39'01/' +
        '09/2024'#39', '#39'DD/MM/YYYY'#39') AND TO_DATE('#39'30/09/2024'#39', '#39'DD/MM/YYYY'#39')'
      '  AND NVL(LIR.IDMODULORESPON, LIR.IDMODULO) = 3 '
      '  AND ROUND(LIR.VLRINSS, 2)                <> 0 '
      '  AND NVL(LIR.CODIGOGPS, 0)                <> 0 '
      '  AND PES.TIPO                              = '#39'J'#39' '
      '  '
      '--  AND DOC.STATUS                            = 0'
      ''
      'GROUP BY             '
      
        '      PES.TIPO,                                                 ' +
        '                            '
      '      PES.NOME,'
      
        '      LIR.VLRBASE,                                              ' +
        '                            '
      
        '      LIR.CODDOCUMENTO,                                         ' +
        '                            '
      
        '      DOC.NODOCUMENTO,                                          ' +
        '                            '
      
        '      LIR.DATALANCAMENTO,                                       ' +
        '                            '
      
        '      LIR.CODNATUREZA,                                          ' +
        '                            '
      
        '      LIR.CODIGOGPS,                                            ' +
        '                            '
      
        '      LIR.IDBENEFIRRF                                           ' +
        '                           '
      '  )   '
      ''
      'ORDER BY TIPO_PES, IDBENEFIRRF, DATALANCAMENTO, CODDOCUMENTO')
    ClientDataSet = cdsDoc
    Left = 316
    Top = 140
  end
end
