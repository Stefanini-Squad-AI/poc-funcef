  object sqlLancIRRF: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  '#39'S'#39' AS FLAG, '
      '  L.IDLANCIRRF, L.VLRBASE, L.VLRINSS AS VALOR, '
      '  L.DATALANCAMENTO AS DATALANCTO, '
      '  L.CODDOCUMENTO, L.IDPESSOA, L.IDBENEFIRRF AS IDFORCLI, '
      '  L.CODNATUREZA, L.PLANO, L.PLACONTA, '
      '  L.IDPLANOPREV, L.IDPATRO, L.UNIDNEGOC, L.IDPROGRAMA, '
      '  L.CODCENTROCUSTO, L.CODCENTRORESPON, '
      '  P.TIPO, '
      '  P.NOME AS RAZAOSOCIAL, L.CODIGOGPS '
      'FROM '
      '  LANCIRRF  L, '
      '  PESSOA    P  '
      'WHERE '
      
        '      L.DATALANCAMENTO                   BETWEEN TO_DATE('#39'01/01/' +
        '2006'#39', '#39'DD/MM/YYYY'#39') AND TO_DATE('#39'31/03/2007'#39', '#39'DD/MM/YYYY'#39')'
      '  AND NVL(L.IDMODULORESPON, L.IDMODULO)  = 3 '
      '  AND NVL(L.FLGFOLHA, '#39'N'#39')             = '#39'N'#39'  '
      '  AND NVL(L.FLGDARF, '#39'N'#39')              = '#39'N'#39' '
      '  AND L.IDBENEFIRRF                      = P.IDPESSOA '
      '  AND ROUND(L.VLRINSS, 2)               <> 0 '
      '  AND L.IDDOCINSS                        IS NULL '
      '  AND NVL(L.CODIGOGPS, 0)               <> 0 '
      'ORDER BY '
      '  P.TIPO, L.CODIGOGPS, L.IDBENEFIRRF')
    ClientDataSet = cdsLancIRRF
    Left = 388
    Top = 142
  end
