  end
  object qryTotalizadores: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    ParamCheck = False
    RequestLive = True
    SQL.Strings = (
      
        'SELECT '#39'S'#39' AS MARCA, idtotalizareldivergencia, DESCRICAO, ordemi' +
        'mp'
      'FROM  CM.TOTALIZARELDIVERGENCIA'
      'ORDER BY ordemimp'
      '')
    UpdateObject = UpdTotalizadores
    ControlType.Strings = (
      'MARCA;CheckBox;S;N')
    PictureMasks.Strings = (
      'VALORDESPESAADM'#9'###,###,#00.00'#9'T'#9'T'
      'VALORDESPESAAPAGAR'#9'###,###,#00.00'#9'T'#9'T')
    ValidateWithMask = False
    Left = 46
    Top = 234
    object qryTotalizadoresMARCA: TStringField
      DisplayLabel = '     '
      DisplayWidth = 1
      FieldName = 'MARCA'
      FixedChar = True
      Size = 1
    end
    object qryTotalizadoresDESCRICAO: TStringField
      DisplayLabel = 'Descrição'
      DisplayWidth = 35
      FieldName = 'DESCRICAO'
    end
    object qryTotalizadoresORDEMIMP: TFloatField
      Alignment = taCenter
      DisplayLabel = 'Ordem'
      DisplayWidth = 10
      FieldName = 'ORDEMIMP'
    end
    object qryTotalizadoresIDTOTALIZARELDIVERGENCIA: TFloatField
      FieldName = 'IDTOTALIZARELDIVERGENCIA'
      Visible = False
    end
  end
  object UpdTotalizadores: TUpdateSQL
    ModifySQL.Strings = (
      'update CM.TOTALIZARELDIVERGENCIA'
      'set'
      '  MARCA = :MARCA,'
      '  IDTOTALIZARELDIVERGENCIA = :IDTOTALIZARELDIVERGENCIA,'
      '  DESCRICAO = :DESCRICAO,'
      '  ORDEMIMP = :ORDEMIMP'
      'where'
      '  IDTOTALIZARELDIVERGENCIA = :OLD_IDTOTALIZARELDIVERGENCIA')
    InsertSQL.Strings = (
      'insert into CM.TOTALIZARELDIVERGENCIA'
      '  (MARCA, IDTOTALIZARELDIVERGENCIA, DESCRICAO, ORDEMIMP)'
      'values'
      '  (:MARCA, :IDTOTALIZARELDIVERGENCIA, :DESCRICAO, :ORDEMIMP)')
    DeleteSQL.Strings = (
      'delete from CM.TOTALIZARELDIVERGENCIA'
      'where'
      '  IDTOTALIZARELDIVERGENCIA = :OLD_IDTOTALIZARELDIVERGENCIA')
    Left = 46
    Top = 353
  end
