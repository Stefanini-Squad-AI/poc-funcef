  object sql: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      
        '  DOC.DATAEMISSAO,   DOC.DATAVENCTO,   DOC.DATAPROGRAMADA,      ' +
        '    '
      
        '  DOC.DATADISPONIB,  DOC.CODDOCUMENTO,                          ' +
        '    '
      
        '  DOC.PLACONTA,      DOC.CODTIPDOC,    DOC.NODOCUMENTO,         ' +
        '    '
      
        '  DOC.CODFORMA,                                                 ' +
        '    '
      '  DOC.NODOCUMENTO || '#39' / '#39' || DOC.COMPLDOCUMENTO AS NOCOMPLDOC,'
      ''
      
        '  PES.NOME,          PES.IDPESSOA,     BEN.NOME AS BENEF,       ' +
        '    '
      ''
      
        '  DIN.CODIGOPGTO,    DIN.CODDOCINSS,                            ' +
        '    '
      
        '  DIN.IDDOCINSS,     DIN.VLRJUROS,     DIN.VLRINSS,             ' +
        '    '
      
        '  DIN.VLRMULTA,      DIN.VLRDESCONTO,  DIN.VLRTOTAL,            ' +
        '    '
      
        '  DIN.NUMLANCJUROS,  DIN.NUMLANCMULTA, DIN.NUMLANCDESCONTO      ' +
        '    '
      ''
      
        'FROM                                                            ' +
        '    '
      
        '  DOCUMENTO   DOC,                                              ' +
        '    '
      
        '  PESSOA      PES,                                              ' +
        '    '
      
        '  PESSOA      BEN,                                              ' +
        '    '
      
        '  DOCINSS     DIN                                               ' +
        '    '
      ''
      
        'WHERE                                                           ' +
        '    '
      
        '      DOC.CODDOCUMENTO  = DIN.CODDOCINSS                        ' +
        '    '
      '  AND DOC.IDFORCLI      = PES.IDPESSOA '
      '  AND DIN.IDBENEFINSS   = BEN.IDPESSOA')
    ClientDataSet = Cds
    Left = 352
    Top = 95
  end
end
