  object sqlDoc: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  '#39'S'#39' AS FLAG,'
      '  SUM(LIR.VLRBASE) AS VLRBASE, SUM(LIR.VLRINSS) AS VALOR,'
      '  LIR.CODDOCUMENTO, DOC.NODOCUMENTO,'
      '  LIR.DATALANCAMENTO,'
      ''
      '  LIR.CODNATUREZA, LIR.CODIGOGPS,'
      ''
      '  LIR.IDBENEFIRRF,'
      '  PES.TIPO, ('#39'P'#39' || PES.TIPO) AS TIPO_PES,'
      '  PES.NOME'
      ''
      'FROM'
      '  LANCIRRF  LIR,'
      '  PESSOA    PES,'
      '  DOCUMENTO DOC'
      ''
      'WHERE'
      
        '      LIR.DATALANCAMENTO                    BETWEEN TO_DATE('#39'01/' +
        '01/2006'#39', '#39'DD/MM/YYYY'#39') AND TO_DATE('#39'31/07/2007'#39', '#39'DD/MM/YYYY'#39')'
      '  AND NVL(LIR.IDMODULORESPON, LIR.IDMODULO) = 3'
      ''
      '  AND ROUND(LIR.VLRISS, 2)                 <> 0'
      '  AND NVL(LIR.IDDOCISS, 0)                  IS NULL'
      ''
      '  AND LIR.IDBENEFIRRF                       = PES.IDPESSOA'
      '  AND LIR.CODDOCUMENTO                      = DOC.CODDOCUMENTO'
      ''
      'GROUP BY'
      '  LIR.CODDOCUMENTO, DOC.NODOCUMENTO,'
      '  LIR.DATALANCAMENTO,'
      '  LIR.CODNATUREZA, LIR.CODIGOGPS,'
      '  LIR.IDBENEFIRRF, PES.TIPO, PES.NOME'
      ''
      'ORDER BY'
      '  LIR.CODDOCUMENTO')
    ClientDataSet = cdsDoc
    Left = 360
  end
