  inherited CrmRptCM: TCmRptManager
    BeforePrint = CrmRptCMBeforePrint
    DataBaseName = 'BaseDados'
    Report = rpDarf
  end
  object sqlDarf: TCMSqlParams
    SQL.Strings = (
      '  SELECT'
      '    D.IDDARF,'
      ''
      '    LTRIM(RTRIM(A.NUMAGENCIA)) AS AGENCIA,'
      '    B.MASCARAAGENCIA,'
      '    LTRIM(RTRIM(C.CONTACORRENTE)) AS CONTACORRENTE,'
      '    B.MASCARACC,'
      '    PE.NOME AS CONTRIBUINTE, (P.UFSECAO) AS SESSAO, P.CODVARA,'
      '    NVL(P.CLASSEACAO, '#39'02.100'#39') AS ACAO_CLASSE, P.AUTORACAO,'
      '    '#39'UNIÃO FEDERAL/DELEGACIA DA RECEITA'#39' AS REU,'
      
        '    D.VLRBASECALCULO, NVL(D.PERCIRRF, 0) AS PERCIRRF, D.DATAFINA' +
        'LAPURACAO,'
      '    SUBSTR(PE.NUMDOCUMENTO, 1, 3) || '#39'.'#39' ||'
      '    SUBSTR(PE.NUMDOCUMENTO, 4, 3) || '#39'.'#39' ||'
      '    SUBSTR(PE.NUMDOCUMENTO, 7, 3) || '#39'-'#39' ||'
      '    SUBSTR(PE.NUMDOCUMENTO, 10, 2) AS NUMDOCUMENTO,'
      
        '    DT.MATRICULA, D.CODNATUREZA, P.NUMEROPROCESSO, D.DATAVENCDAR' +
        'F,'
      
        '    NVL(D.VLRIRRF, 0) AS VLRIRRF, NVL(D.VLRMULTA, 0) AS VLRMULTA' +
        ','
      
        '    NVL(D.VLRJUROS, 0) AS VLRJUROS, NVL(D.VLRTOTAL, 0) AS VLRTOT' +
        'AL, T.NUMERO AS TELEFONE'
      ''
      '  FROM'
      '    BANCO            B,'
      '    AGENCIABANCARIA  A,'
      '    CONTABANCARIA    C,'
      '    PROCJUD          P,'
      '    PESSOA           PE,'
      '    DARF             D,'
      '    LANCIRRF         L,'
      '    NATURENDIMENTO   N,'
      '    TELENDPESS       T,'
      '    DEPENTIT         DT,'
      '    ELEGPATRO        E,'
      ''
      '    ('
      '    SELECT'
      '      MAX(T.IDTELEFONE) AS IDTELEFONE'
      '    FROM'
      '      PESSOA     P,'
      '      TELENDPESS T'
      '    WHERE'
      '          (P.IDPESSOA        = 1 )'
      '      AND (P.IDENDCOMERCIAL  = T.IDENDERECO)'
      '      AND (T.TIPO            LIKE '#39'%C%'#39' )'
      '    ) TM'
      ''
      '  WHERE'
      '        (D.IDPESSOA          = 1 )'
      '    AND (D.VLRIRRF           > 0)'
      '    AND (D.CODNATUREZA       = N.CODNATUREZA)'
      '    AND (N.FLGDEPOSITOJUDIC  = '#39'S'#39')'
      '    AND (D.IDDARF            = L.IDDARF)'
      '    AND (L.IDPROCJUD         = P.IDPROCJUD)'
      '    AND (E.IDPESSOA(+)       = P.IDPESSOA)'
      '    AND (DT.IDPESSOA(+)      = P.IDPESSOA)'
      '    AND (P.IDPESSOA          = PE.IDPESSOA)'
      '    AND P.IDAGENCIABANCARIA  = A.IDPESSOA(+)'
      '    AND P.IDBANCO            = A.IDBANCO(+)'
      '    AND A.IDBANCO            = B.IDPESSOA(+)'
      
        '    AND (P.IDCBANCARIA       IS NULL OR P.IDCBANCARIA = C.IDCBAN' +
        'CARIA)'
      '    AND (P.SITPROCESSO       = 0)'
      '    AND (PE.IDENDCOMERCIAL   = T.IDENDERECO(+))'
      '    AND (T.IDTELEFONE        = TM.IDTELEFONE(+))'
      ''
      '  ORDER BY'
      '    P.AUTORACAO, CONTRIBUINTE')
    ClientDataSet = cdsDarf
    Left = 240
    Top = 64
  end
