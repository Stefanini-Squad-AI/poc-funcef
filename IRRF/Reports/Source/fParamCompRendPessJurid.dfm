  object cdsNatuRendimento: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 337
    Top = 165
  end
  object SqlNatuRendimento: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  CODNATUREZA,'
      '  CODNATUREZA||'#39' - '#39'||DESCRICAO AS DESCRICAO'
      'FROM NATURENDIMENTO '
      'ORDER BY CODNATUREZA')
    ClientDataSet = cdsNatuRendimento
    Left = 369
    Top = 165
  end
end
