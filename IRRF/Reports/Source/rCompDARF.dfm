  object sqlCompDARF: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT'
      
        '  H.MES, E.MATRICULA, H.IDTITULAR, P.NOME AS NOMETITULAR, H.IDPE' +
        'SSOA, H.IDRESPONSAVEL, PR.NOME AS NOMERECEBEDOR,'
      '  H.SEQRUBRICA, H.FLGDESCONTO, H.FLGESPECIAL,  '
      '  H.IDRUBRICA, PD.DESCRICAO,'
      '  DECODE(H.FLGESPECIAL, 0, DECODE(H.FLGDESCONTO, 0, '#39'Provento'#39','
      '                                                 1, '#39'Desconto'#39','
      
        '                                                 2, '#39'Informativo' +
        #39'),'
      '                        1, '#39'Informativo'#39','
      '                        2, '#39'Informativo'#39') AS TITULORUBRICA,'
      
        '  DECODE(H.FLGESPECIAL, 0, DECODE(H.FLGDESCONTO, 0, H.VALORPROVE' +
        'NTO,'
      
        '                                                 1, H.VALORPROVE' +
        'NTO * (-1),'
      '                                                 2, 0),'
      '                        1, 0,'
      
        '                        2, 0) AS VALORPROVENTOREAL, H.VALORPROVE' +
        'NTO, '
      '  DECODE(H.FLGESTORNO, 1, '#39'PAGTO PENDENTE'#39', '
      '                       2, '#39'PENDENTE EM PROCESSAMENTO DE PRÉVIA'#39','
      '                       3, '#39'PENDENTE PAGO NOVAMENTE'#39', '
      '                       4, '#39'ESTORNADO P/ REPROCESSAMENTO'#39','
      
        '                       9, '#39'ESTORNADO - PAGTO INDEVIDO'#39') AS SITES' +
        'TORNO,'
      '  H.IDLANCIRRF, H.IDLANCIRRFESTORNO,  L.IDDARF,'
      
        '  H.IDHSTFOLHABENEF AS VERSAOPAGTO,  HSPG.HISTORICO AS HISTPAGTO' +
        ', HSPG.DATAPREVPAGTO AS DTPREVPGTO,'
      
        '  H.IDVERSAOPAGTO AS VERSAONOVA, HSNPG.HISTORICO AS HISTPAGTONOV' +
        'O, HSNPG.DATAPREVPAGTO AS DTPREVPGTONOVO,'
      '  VPAG.IDLANCIRRF, H.DATAPAGAMENTO '
      'FROM '
      '  HISTRUBSAL H, ELEGPATRO E, PESSOA P, PESSOA PR, '
      
        '  PROVDESC PD, HSTFOLHABENEF HSPG, HSTFOLHABENEF HSNPG, LANCIRRF' +
        ' L, '
      '  ('
      '   SELECT HPAGEST.IDHSTFOLHABENEF, HPAGEST.IDLANCIRRF, '
      '          HPAGEST.IDTITULAR, HPAGEST.IDRESPONSAVEL'
      '   FROM '
      '     HISTRUBSAL HPAGEST, '
      #9' HISTRUBSAL HPAGNOVO'
      
        '   WHERE HPAGEST.DATAPAGAMENTO   >= TO_DATE('#39'25/01/2006'#39','#39'dd/mm/' +
        'yyyy'#39')'
      
        '     AND HPAGEST.DATAPAGAMENTO   <= TO_DATE('#39'25/01/2006'#39','#39'dd/mm/' +
        'yyyy'#39')'
      '     AND HPAGEST.IDMODULO        = 18 '
      #9' AND HPAGEST.FLGESTORNO      <> 0 '
      #9' AND HPAGEST.IDVERSAOPAGTO   =  HPAGNOVO.IDHSTFOLHABENEF '
      #9' AND HPAGEST.IDTITULAR       =  HPAGNOVO.IDTITULAR '
      #9' AND HPAGEST.IDRESPONSAVEL   =  HPAGNOVO.IDRESPONSAVEL  '
      '  ) VPAG'
      'WHERE H.DATAPAGAMENTO   >= TO_DATE('#39'25/01/2006'#39','#39'dd/mm/yyyy'#39')'
      '  AND H.DATAPAGAMENTO   <= TO_DATE('#39'25/01/2006'#39','#39'dd/mm/yyyy'#39')'
      '  AND H.IDMODULO        = 18 '
      '  AND H.FLGESTORNO      <> 0 '
      '  AND H.IDTITULAR       = E.IDPESSOA(+) '
      '  AND H.IDTITULAR       = P.IDPESSOA(+) '
      '  AND H.IDRESPONSAVEL   = PR.IDPESSOA(+) '
      '  AND H.IDRUBRICA       = PD.IDPROVENTO(+) '
      '  AND H.IDHSTFOLHABENEF = HSPG.IDHSTFOLHABENEF(+) '
      '  AND H.IDVERSAOPAGTO   = HSNPG.IDHSTFOLHABENEF(+) '
      '  AND H.IDLANCIRRF      = L.IDLANCIRRF(+) '
      '  AND H.IDVERSAOPAGTO   = VPAG.IDHSTFOLHABENEF(+) '
      '  AND H.IDTITULAR       = VPAG.IDTITULAR(+) '
      '  AND H.IDRESPONSAVEL   = VPAG.IDRESPONSAVEL(+) '
      'ORDER BY '
      '  E.MATRICULA, H.IDHSTFOLHABENEF, SEQRUBRICA'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    Left = 232
    Top = 8
  end
  object dsCompDARF: TwwDataSource
    DataSet = cdsCompDARF
    Left = 86
    Top = 57
  end
end
