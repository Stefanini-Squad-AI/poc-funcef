package CmAgendamentoObj50;

{$R *.RES}
{$R CMAGENDAMENTOOBJ50_RES.RES}

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Objectos Comuns do Agendamento'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CmForms50;

contains
  uCtrlAgendamento in '..\CtrlObjects\uCtrlAgendamento.pas',
  uCtrlAssuntoAgenda in '..\CtrlObjects\uCtrlAssuntoAgenda.pas',
  uCtrlAtendeAgenda in '..\CtrlObjects\uCtrlAtendeAgenda.pas',
  uCtrlAusenciaAtende in '..\CtrlObjects\uCtrlAusenciaAtende.pas',
  uCtrlGrupoAtende in '..\CtrlObjects\uCtrlGrupoAtende.pas',
  uCtrlPeriodoAgenda in '..\CtrlObjects\uCtrlPeriodoAgenda.pas',
  uDbAgendamento in '..\DbObjects\uDbAgendamento.pas',
  uDbAtendeAgenda in '..\DbObjects\uDbAtendeAgenda.pas',
  uDbAusenciaAtende in '..\DbObjects\uDbAusenciaAtende.pas',
  uDbGrupoAtende in '..\DbObjects\uDbGrupoAtende.pas',
  uDbHorarioAgenda in '..\DbObjects\uDbHorarioAgenda.pas',
  uDbPeriodoAgenda in '..\DbObjects\uDbPeriodoAgenda.pas',
  fAgendaComum in '..\Fontes\fAgendaComum.pas' {frmAgendaComum},
  uDbAssuntoAgenda in '..\DbObjects\uDbAssuntoAgenda.pas',
  fCalendarioAgenda in '..\Fontes\fCalendarioAgenda.pas' {frmCalendarioAgenda};

end.
