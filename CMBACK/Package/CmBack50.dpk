package CmBack50;

{$R *.RES}
{$R CMBACK50_RES.RES}

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Componentes de Integração com BackOffice'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  TB97_d5,
  CmCompo50,
  vcldbx50,
  CMRad50;

contains
  UPlanoContas in '..\Source\UPlanoContas.pas',
  DCmBackDocumento in '..\Source\DCmBackDocumento.pas' {DtmCmBackDocumento: TDataModule},
  DCmBackImposto in '..\Source\DCmBackImposto.pas' {DtmCmBackImposto: TDataModule},
  DDadosBancarios in '..\Source\DDadosBancarios.pas' {DtmDadosBancarios: TDataModule},
  FAvaliacao in '..\Source\FAvaliacao.pas' {FrmAvaliacao},
  FCadContas in '..\Source\FCadContas.pas' {frmCadContas},
  fCadPrograma in '..\Source\fCadPrograma.pas' {frmCadPrograma},
  FCadRamoFor in '..\Source\FCadRamoFor.pas' {frmCadRamoFor},
  FCadTipoCliente in '..\Source\FCadTipoCliente.pas' {frmCadTipoCliente},
  FCadTipoDoc in '..\Source\FCadTipoDoc.pas' {frmCadTipoDoc},
  FConfigEtiqMT in '..\SourceMT\FConfigEtiqMT.pas' {FrmConfigEtiqMT},
  FFormaRecPag in '..\Source\FFormaRecPag.pas' {frmFormaRecPag},
  FImpEtiqMT in '..\SourceMT\FImpEtiqMT.pas' {FrmImpEtiqMT},
  FImpTipoDesemb in '..\Source\FImpTipoDesemb.pas' {FrmImpTipoDesemb},
  FTipoAlteradorxCCxConta in '..\Source\FTipoAlteradorxCCxConta.pas' {FrmTipoAlteradorxCCxConta},
  FViewRestricao in '..\Source\FViewRestricao.pas' {FrmViewRestricao},
  uAvaliForn in '..\Source\uAvaliForn.pas',
  UDocumento in '..\Source\UDocumento.pas',
  uEtiquetaCM in '..\Source\uEtiquetaCM.pas',
  UFuncoesdeImpressao in '..\Source\UFuncoesdeImpressao.pas',
  uImpostoRetido in '..\Source\uImpostoRetido.pas',
  uIntegraBack in '..\Source\uIntegraBack.pas',
  uJurosCorrecao in '..\Source\uJurosCorrecao.pas',
  ULancContab in '..\Source\ULancContab.pas',
  ULancFinanc in '..\Source\ULancFinanc.pas',
  UOrcamento in '..\Source\UOrcamento.pas',
  DCmBack in '..\Source\DCmBack.pas' {DtmCmBack: TDataModule},
  uModeloRelatCM in '..\Source\uModeloRelatCM.Pas',
  FCadTipoDesemb in '..\Source\FCadTipoDesemb.pas' {frmCadTipoDesemb},
  fCadRecDesXAgreg in '..\Source\fCadRecDesXAgreg.pas' {frmCadRecDesXAgreg},
  FTrdxCCxConta in '..\Source\FTrdxCCxConta.pas' {FrmTrdxCCxConta},
  uCtrlTalaoCheque in '..\SourceMT\uCtrlTalaoCheque.pas',
  uCtrlConfigEtiq in '..\SourceMT\uCtrlConfigEtiq.pas',
  uDbEtiqueta in '..\SourceMT\uDbEtiqueta.pas';

end.
