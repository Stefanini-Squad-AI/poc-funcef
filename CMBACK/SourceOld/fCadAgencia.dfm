  inherited updSubTipo: TUpdateSQL
    ModifySQL.Strings = (
      'update AGENCIABANCARIA'
      'set'
      '  IDBANCO = :IDBANCO,'
      '  NUMAGENCIA = :NUMAGENCIA,'
      '  FLGATIVO = :FLGATIVO,'
      '  FLGTIPO = :FLGTIPO'
      'where'
      '  IDPESSOA = :OLD_IDPESSOA')
    InsertSQL.Strings = (
      'insert into AGENCIABANCARIA'
      '  (IDPESSOA, IDBANCO, NUMAGENCIA, FLGATIVO, FLGTIPO)'
      'values'
      '  (:IDPESSOA, :IDBANCO, :NUMAGENCIA, :FLGATIVO, :FLGTIPO)')
    DeleteSQL.Strings = (
      'delete from AGENCIABANCARIA'
      'where'
      '  IDPESSOA = :OLD_IDPESSOA')
  end
