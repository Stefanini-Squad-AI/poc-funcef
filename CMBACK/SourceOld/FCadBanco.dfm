  inherited updSubTipo: TUpdateSQL
    ModifySQL.Strings = (
      'update BANCO'
      'set'
      '  NUMBANCO = :NUMBANCO,'
      '  MASCARACC = :MASCARACC,'
      '  MASCARAAGENCIA = :MASCARAAGENCIA,'
      '  FLGVALIDACC = :FLGVALIDACC'
      'where'
      '  IDPESSOA = :OLD_IDPESSOA')
    InsertSQL.Strings = (
      'insert into BANCO'
      '  (IDPESSOA, NUMBANCO, MASCARACC, MASCARAAGENCIA, FLGVALIDACC)'
      'values'
      
        '  (:IDPESSOA, :NUMBANCO, :MASCARACC, :MASCARAAGENCIA, :FLGVALIDA' +
        'CC)')
    DeleteSQL.Strings = (
      'delete from BANCO'
      'where'
      '  IDPESSOA = :OLD_IDPESSOA')
    Left = 483
    Top = 121
  end
