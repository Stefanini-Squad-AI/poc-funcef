uses FEventoTransfPlanoNOVO, FEventoTransfPlanoFCRT;

{$R *.DFM}

procedure TdtmRelTransfPlanoFCRT.ppTitleBand2BeforePrint(Sender: TObject);
begin
  inherited;
  pplblOpcao2.Caption := frmEventoTransfPlanoFCRT.edOpcao.Text;
end;

procedure TdtmRelTransfPlanoFCRT.rpDemonstrativoBeforePrint(Sender: TObject);
begin
  inherited;
  if (frmEventoTransfPlanoFCRT.QRYPARTICIPANTEORIGEM.FieldByName('SITUACAO').AsString = 'AT') OR
     (frmEventoTransfPlanoFCRT.QRYPARTICIPANTEORIGEM.FieldByName('SITUACAO').AsString = 'MA')
  then ppSumarioObs1.NewPage := True
  else ppSumarioObs1.NewPage := False;

  if frmEventoTransfPlanoFCRT.sIdEventoGerador = '62'
  then lblTituloRelatorio.Caption := 'Simulador de Migração de Plano - 2o. Período'
  else lblTituloRelatorio.Caption := 'Simulador de Migração de Plano - 1o. Período';
end;

procedure TdtmRelTransfPlanoFCRT.ppFooterBand2BeforePrint(Sender: TObject);
begin
  ppLblMens.Visible := False;
  ppLine22.Visible  := False;
  If (qryDemonstrativo.FieldByName('IDPESSJUR').AsInteger = 50028) and
     (StrToDate(qryDemonstrativo.FieldByName('DATADADOS').AsString) <= StrToDate('31/08/2003') ) 
  Then Begin
    ppLblMens.Visible := True;
    ppLine22.Visible  := True;
  End;
  inherited;
end;

end.
