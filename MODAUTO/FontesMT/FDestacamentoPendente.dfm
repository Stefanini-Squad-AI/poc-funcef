  object sqlIntegraFolha: TQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT * FROM ('
      'SELECT '#39'A'#39' AS ORDEM,'
      '    D.IDDESTACAMENTO,'
      '    D.DATALANCAMENTO,'
      '    T.DATAINI,'
      '    '#39'Adiantamento'#39' AS TIPOINTEGRA,'
      '    D.FLGLANCAFOLHA,'
      '    D.ANOMESREFADIANT AS MESREFAD,'
      '    D.ANOMESREFACERTO AS MESREFAC,'
      '    --D.FLGINTEGRARFOLHA,'
      '    '#39'S'#39' FLGINTEGRARFOLHA,'
      '    DECODE(F.TIPOCONTRATO,'#39'E'#39', '#39'Empregados FUNCEF'#39','
      '                          '#39'P'#39', '#39'Empregados Cedidos'#39','
      '                          '#39'3'#39', '#39'Empregados Cedidos'#39','
      
        '                          '#39'A'#39', '#39'Conselheiros FUNCEF'#39','#39#39') TIPOCON' +
        'TRATO,'
      '    V.TOTAL,'
      '    D.TIPOMOTIVONAOINTEGRACAO,'
      '    D.CODCENTROCUSTO,'
      '    D.IDPESSOA,'
      '    P.NOME AS NOMEDESTACADO,'
      '    F.TIPOCONTRATO as CODCONTRATO'
      ' FROM'
      '    DESTACAMENTO D,'
      '    DSTTRECHO T,'
      '    PESSOA P,'
      '    FUNCIONARIO F,'
      '    (SELECT IDDESTACAMENTO, SUM(VLRITEM) AS TOTAL'
      '       FROM DESTACAMENTOXITEMDESPESA'
      '      WHERE TIPOQUALIFICACAO = '#39'A'#39
      '      GROUP BY IDDESTACAMENTO) V'
      ' WHERE'
      '     F.IDPESSOA = D.IDPESSOA  AND'
      '     P.IDPESSOA = D.IDPESSOA  AND'
      '     V.IDDESTACAMENTO = D.IDDESTACAMENTO AND'
      '     D.IDDESTACAMENTO = T.IDDESTACAMENTO AND'
      '     NVL(D.FLGLANCAFOLHA, 0) = 0 AND'
      
        '     T.DATAINI = (SELECT MIN(T1.DATAINI) FROM DSTTRECHO T1 WHERE' +
        ' T.IDDESTACAMENTO = T1.IDDESTACAMENTO )'
      ''
      ' UNION'
      ''
      'SELECT '#39'B'#39' AS ORDEM,'
      '    D.IDDESTACAMENTO,'
      '    D.DATALANCAMENTO,'
      '    T.DATAINI,'
      '    '#39'Acerto de Contas'#39' AS TIPOINTEGRA,'
      '    D.FLGLANCAFOLHA,'
      '    D.ANOMESREFADIANT AS MESREFAD,'
      '    D.ANOMESREFACERTO AS MESREFAC,'
      '    --D.FLGINTEGRARFOLHA,'
      '    '#39'S'#39' FLGINTEGRARFOLHA,'
      '    DECODE(F.TIPOCONTRATO,'#39'E'#39', '#39'Empregados FUNCEF'#39','
      '                          '#39'P'#39', '#39'Empregados Cedidos'#39','
      '                          '#39'3'#39', '#39'Empregados Cedidos'#39','
      
        '                          '#39'A'#39', '#39'Conselheiros FUNCEF'#39','#39#39') TIPOCON' +
        'TRATO,'
      '    V.TOTAL,'
      '    D.TIPOMOTIVONAOINTEGRACAO,'
      '    D.CODCENTROCUSTO,'
      '    D.IDPESSOA,'
      '    P.NOME AS NOMEDESTACADO,'
      '    F.TIPOCONTRATO  as CODCONTRATO'
      ' FROM'
      '    DESTACAMENTO D,'
      '    DSTTRECHO T,'
      '    PESSOA P,'
      '    FUNCIONARIO F,'
      '    (SELECT IDDESTACAMENTO, SUM(VLRITEM) AS TOTAL'
      '       FROM DESTACAMENTOXITEMDESPESA'
      '      WHERE TIPOQUALIFICACAO = '#39'A'#39
      '      GROUP BY IDDESTACAMENTO) V'
      ' WHERE'
      '     F.IDPESSOA = D.IDPESSOA AND'
      '     P.IDPESSOA = D.IDPESSOA AND'
      '     V.IDDESTACAMENTO = D.IDDESTACAMENTO AND'
      '     D.IDDESTACAMENTO = T.IDDESTACAMENTO AND'
      '     NVL(D.FLGLANCAFOLHA, 0) <> 0 AND'
      '     NVL(D.FLGLANCAFOLHAACERTO, 0) = 0 AND'
      '     D.DATAPAGTOACERTO IS NOT NULL AND'
      
        '     (DECODE(D.FLGACERTOCONTASPR1, '#39'C'#39', D.VLRACERTOCONTAS1, D.VL' +
        'RACERTOCONTAS1 * -1) +'
      
        '      DECODE(D.FLGACERTOCONTASPR2, '#39'C'#39', D.VLRACERTOCONTAS2, D.VL' +
        'RACERTOCONTAS2 * -1) +'
      
        '      DECODE(D.FLGACERTOCONTASPR3, '#39'C'#39', D.VLRACERTOCONTAS3, D.VL' +
        'RACERTOCONTAS3 * -1) +'
      
        '      DECODE(D.FLGACERTOCONTASPR4, '#39'C'#39', D.VLRACERTOCONTAS4, D.VL' +
        'RACERTOCONTAS4 * -1) <> 0) AND'
      
        '     T.DATAINI = (SELECT MIN(T1.DATAINI) FROM DSTTRECHO T1 WHERE' +
        ' T.IDDESTACAMENTO = T1.IDDESTACAMENTO )'
      ')'
      'ORDER BY ORDEM, DATALANCAMENTO'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    Left = 320
    Top = 307
  end
