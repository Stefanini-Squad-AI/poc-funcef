  object qryResumoValores: TwwQuery
    DatabaseName = 'BaseDados'
    DataSource = dsDestacamento
    SQL.Strings = (
      'SELECT * FROM ('
      'SELECT X.IDDSTITEMDESPESA AS IDITEM,'
      '       S.DESCRICAO AS DSCITEM,'
      '       S.SEQAPRESRESUMO,'
      '       S.TIPOQUALIFICACAO,'
      '       SUM(NVL(X.VLRITEM,0)) AS VLRITEM'
      
        'FROM DESTACAMENTO D, DESTACAMENTOXITEMDESPESA X, DSTITEMDESPESA ' +
        'S'
      'WHERE D.IDDESTACAMENTO =:IDDESTACAMENTO'
      '   AND D.IDDESTACAMENTO = X.IDDESTACAMENTO'
      '   AND X.IDDSTITEMDESPESA = S.IDDSTITEMDESPESA'
      '   AND S.FLGATIVA = '#39'S'#39
      'GROUP BY  X.IDDSTITEMDESPESA,'
      '       S.DESCRICAO,'
      '       S.SEQAPRESRESUMO,'
      '       S.TIPOQUALIFICACAO'
      ''
      'UNION'
      ''
      'SELECT S.IDDSTITEMDESPESA AS IDITEM,'
      '       S.DESCRICAO AS DSCITEM,'
      '       S.SEQAPRESRESUMO,'
      '       S.TIPOQUALIFICACAO,'
      
        '       (SELECT NVL(SUM(T.VLRITEM),0) FROM DESTACAMENTOXITEMDESPE' +
        'SA T WHERE T.IDDESTACAMENTO =:IDDESTACAMENTO AND T.TIPOQUALIFICA' +
        'CAO = '#39'A'#39') AS VLRITEM'
      'FROM DSTITEMDESPESA S'
      'WHERE S.IDDSTITEMDESPESA = -1'
      ''
      'UNION'
      ''
      'SELECT S.IDDSTITEMDESPESA AS IDITEM,'
      '       S.DESCRICAO AS DSCITEM,'
      '       S.SEQAPRESRESUMO,'
      '       S.TIPOQUALIFICACAO,'
      
        '       ((SELECT NVL(SUM(T.VLRITEM),0) FROM DESTACAMENTOXITEMDESP' +
        'ESA T WHERE T.IDDESTACAMENTO =:IDDESTACAMENTO AND T.TIPOQUALIFIC' +
        'ACAO = '#39'A'#39') +'
      
        '       (SELECT NVL(SUM(T.VLRITEM),0) FROM DESTACAMENTOXITEMDESPE' +
        'SA T WHERE T.IDDESTACAMENTO =:IDDESTACAMENTO AND T.TIPOQUALIFICA' +
        'CAO = '#39'C'#39')) AS VLRITEM'
      'FROM DSTITEMDESPESA S'
      'WHERE S.IDDSTITEMDESPESA = -2'
      ')'
      'WHERE VLRITEM <> 0'
      'ORDER BY SEQAPRESRESUMO'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      '')
    ValidateWithMask = True
    Left = 706
    Top = 74
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDDESTACAMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'IDDESTACAMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'IDDESTACAMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'IDDESTACAMENTO'
        ParamType = ptUnknown
      end>
    object qryResumoValoresIDITEM: TFloatField
      FieldName = 'IDITEM'
      Origin = 'BASEDADOS.DSTRESUMOVALORES.IDITEM'
    end
    object qryResumoValoresDSCITEM: TStringField
      FieldName = 'DSCITEM'
      Origin = 'BASEDADOS.DSTRESUMOVALORES.DSCITEM'
      Size = 30
    end
    object qryResumoValoresVLRITEM: TFloatField
      FieldName = 'VLRITEM'
      Origin = 'BASEDADOS.DSTRESUMOVALORES.VLRITEM'
      DisplayFormat = '###,##0.00'
    end
