        DataType = ftUnknown
        Name = 'p6'
        ParamType = ptUnknown
      end>
  end
  object qryCentroRespon: TwwQuery
    AutoRefresh = True
    DatabaseName = 'BaseDados'
    DataSource = dsDestacamento
    SQL.Strings = (
      'SELECT C.NOME, C.CODCENTRORESPON  FROM CENTRESPON C'
      'WHERE C.ANALITICOSINTET = '#39'A'#39' AND C.ATIVO = '#39'S'#39
      'AND C.CODCENTRORESPON =:CODCENTRORESPON'
      'ORDER BY C.NOME'
      ' '
      ' ')
    ValidateWithMask = True
    Left = 230
    Top = 452
    ParamData = <
