  object qryInserirDestacamentoXItemDespesa: TQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'INSERT INTO DESTACAMENTOXITEMDESPESA'
      
        '(IDDESTACAMENTOXITEMDESPESA, IDDESTACAMENTO, IDDSTITEMDESPESA, I' +
        'NDOBJETIVO, TIPOQUALIFICACAO, VLRITEM)'
      'VALUES (:p1, :p2, :p3, :p4, :p5, :p6)'
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
