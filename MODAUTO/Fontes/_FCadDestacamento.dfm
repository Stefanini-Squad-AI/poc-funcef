  object qryValorDiariaCargo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT D1.DESCRICAO,'
      '       D2.IDCARGO,'
      '       D5.MOECODIGO,'
      '       D5.MOESIGLA,'
      '       D3.VLRDST,'
      '       D3.IDDSTVALORES'
      'FROM DSTTARIFA D1,'
      '     DSTTARIFAXCARGO D2,'
      '     DSTVALORES D3,'
      '     MOEDA D5'
      'WHERE D1.INDTIPO = 1 -- Tipo Diaria'
      '      AND D2.IDCARGO =:pIDCARGO'
      '      AND D3.TIPOLOCAL =:pTIPOLOCAL'
      '      AND D1.IDDSTTARIFA = D2.IDDSTTARIFA'
      '      AND D1.IDDSTTARIFA = D3.IDDSTTARIFA'
      '      AND D3.MOECODIGO = D5.MOECODIGO'
      '      AND D3.DATADSTVALORES >= (SELECT MAX(D4.DATADSTVALORES)'
      '                               FROM DSTVALORES D4'
      
        '                               WHERE D4.IDDSTTARIFA = D1.IDDSTTA' +
        'RIFA'
      
        '                                     AND D4.DATADSTVALORES <=:pD' +
        'ATAINI )'
      ''
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 844
    Top = 76
    ParamData = <
      item
        DataType = ftInteger
        Name = 'pIDCARGO'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'pTIPOLOCAL'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'pDATAINI'
        ParamType = ptUnknown
      end>
    object qryValorDiariaCargoMOESIGLA: TStringField
      Alignment = taRightJustify
      DisplayLabel = 'Sigla'
      DisplayWidth = 10
      FieldName = 'MOESIGLA'
      Size = 10
