  object qryCargoLotacao: TwwQuery
    DatabaseName = 'BaseDados'
    DataSource = dsDestacamento
    ParamCheck = False
    SQL.Strings = (
      'SELECT P.NOME, F.MATRICULA, F.CODCENTROCUSTO, F.TIPOCONTRATO,'
      
        'DECODE(F.TIPOCONTRATO, '#39'E'#39', '#39'Efetivo'#39', DECODE(F.TIPOCONTRATO, '#39'S' +
        #39', '#39'LEF'#39', DECODE(F.TIPOCONTRATO, '#39'T'#39', '#39'Terceirizado'#39','
      
        'DECODE(F.TIPOCONTRATO, '#39'G'#39', '#39'Estagiário'#39', DECODE(F.TIPOCONTRATO,' +
        ' '#39'3'#39', '#39'Cessão'#39','
      
        'DECODE(F.TIPOCONTRATO, '#39'P'#39', '#39'Prop/Dir s/Vinc'#39', '#39'Autônomo'#39')))))) ' +
        'AS DSCTIPOCONTRATO,'
      
        '      DECODE(F.IDFUNCAO, NULL, F.IDCARGO, F.IDFUNCAO) as IDCARGO' +
        'FUN,'
      '       C.TITULO CARGO, CC.NOME LOTACAO, CC.IDPROGRAMA'
      'FROM CARGO C, CENTCUST CC, FUNCIONARIO F, PESSOA P'
      'WHERE  (F.IDPESSOA   =:IDPESSOA)'
      '    AND (F.IDPESSOA   = P.IDPESSOA)'
      
        '    AND (DECODE(F.IDFUNCAO, NULL, F.IDCARGO, F.IDFUNCAO) = C.IDC' +
        'ARGO)'
      '    AND (F.IDEMPRESA = CC.IDEMPRESA)'
      '    AND (F.CODCENTROCUSTO = CC.CODCENTROCUSTO)'
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    PictureMasks.Strings = (
      'VALORDESPESAADM'#9'###,###,#00.00'#9'T'#9'T'
      'VALORDESPESAAPAGAR'#9'###,###,#00.00'#9'T'#9'T')
    ValidateWithMask = False
    Left = 357
    Top = 60
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
    object qryCargoLotacaoNOME: TStringField
      FieldName = 'NOME'
      Size = 60
    end
