  object qryLkpContasBanco: TwwQuery
    AutoRefresh = True
    DatabaseName = 'BaseDados'
    DataSource = dsDestacamento
    SQL.Strings = (
      'SELECT DECODE(C.TIPOCONTA,'#39'1'#39','#39'Conta Corrente'#39','
      
        '       DECODE(C.TIPOCONTA,'#39'3'#39','#39'Conta Poupança'#39','#39#39')) AS DESCTIPOC' +
        'ONTA,'
      
        '       (TRIM(B.NUMBANCO) || '#39' / '#39' || TRIM(A.NUMAGENCIA) || '#39' / '#39 +
        ' || TRIM(C.CONTACORRENTE) || '#39' / '#39' || DECODE(C.FLGCONTAPREF,1, '#39 +
        'P..'#39','#39'...'#39')) AS CONTACORRENTE,'
      
        '       C.IDCBANCARIA, DECODE(C.FLGCONTAPREF, 1, '#39'Sim'#39', '#39'Não'#39') as' +
        ' CONTAPREF'
      
        'FROM PESSOA PA, PESSOA PB, CONTABANCARIA C, AGENCIABANCARIA A, B' +
        'ANCO B'
      'WHERE (C.IDPESSOA =:IDPESSOA)  AND'
      '      (C.IDAGENCIA = A.IDPESSOA) AND'
      '      (C.TIPOCONTA <> '#39'2'#39') AND'
      '      (A.IDBANCO   = B.IDPESSOA) AND'
      '      (A.IDPESSOA = PA.IDPESSOA) AND'
      '      (B.IDPESSOA = PB.IDPESSOA)'
      ''
      ''
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 76
    Top = 482
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
    object qryLkpContasBancoCONTACORRENTE: TStringField
      DisplayLabel = 'Conta Corrente'
      DisplayWidth = 40
      FieldName = 'CONTACORRENTE'
      Size = 46
    end
