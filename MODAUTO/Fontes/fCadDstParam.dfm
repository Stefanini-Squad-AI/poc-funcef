  object qryLkpRubrica: TwwQuery
    DatabaseName = 'BaseDados'
    Constrained = True
    SQL.Strings = (
      
        'SELECT PD.IDPROVENTO, RP.DESCRPROVDESC AS DESCRICAO, PD.FLGDESCO' +
        'NTO,'
      '  CASE'
      '     WHEN PD.FLGDESCONTO = 0 THEN'
      '         '#39'Provento'#39
      '     WHEN PD.FLGDESCONTO = 1 THEN'
      '         '#39'Desconto'#39
      '     WHEN PD.FLGDESCONTO = 2 THEN'
      '         '#39'Especial'#39
      '  END AS TIPOPROVENTO'
      'FROM RUBRICAXPESS RP, PROVDESC PD'
      'WHERE (PD.IDPROVENTO = RP.IDRUBRICA)'
      '      AND (RP.IDPESSOA = 1)'
      '      AND (PD.FLGTPRUBRICA LIKE '#39'%F%'#39')'
      'ORDER BY DESCRICAO'
      ''
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 395
    Top = 126
    object qryLkpRubricaIDPROVENTO: TFloatField
      FieldName = 'IDPROVENTO'
    end
    object qryLkpRubricaDESCRICAO: TStringField
      FieldName = 'DESCRICAO'
      Size = 130
    end
    object qryLkpRubricaTIPOPROVENTO: TStringField
      FieldName = 'TIPOPROVENTO'
      FixedChar = True
      Size = 8
    end
    object qryLkpRubricaFLGDESCONTO: TFloatField
      FieldName = 'FLGDESCONTO'
    end
  end
  object qryParamFi: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    Constrained = True
    RequestLive = True
    SQL.Strings = (
      
        'SELECT P.*, T1.DESCRICAO, DECODE(P.RECPAG, '#39'P'#39','#39'Pagamento'#39', '#39'Rec' +
        'ebimento'#39') AS DSCPAGREC,'
      
        'DECODE(P.TIPOVIAGEM, 0, '#39'Institucional'#39', DECODE(P.TIPOVIAGEM, 1,' +
        ' '#39'Treinamento'#39', '#39'Audiência'#39')) AS DSCTIPOVIAGEM,'
      
        'DECODE(P.TIPOCONTRATO, '#39'E'#39', '#39'Efetivo'#39', DECODE(P.TIPOCONTRATO, '#39'S' +
        #39', '#39'LEF'#39', DECODE(P.TIPOCONTRATO, '#39'T'#39', '#39'Terceirizado'#39', DECODE(P.T' +
        'IPOCONTRATO, '#39'G'#39', '#39'Estagiário'#39', DECODE(P.TIPOCONTRATO, '#39'3'#39', '#39'Ces' +
        'são'#39', DECODE(P.TIPOCONTRATO, '#39'P'#39', '#39'Prop/Dir s/Vinc'#39', '#39'Autônomo'#39')' +
        '))))) AS DSCTIPOCONTRATO'
      'FROM DSTPARAMINTEGRACAO P, TIPORECEBDESEMB T1'
      'WHERE P.IDPESSOA = T1.IDPESSOA'
      'AND P.RECPAG = T1.RECPAG'
      'AND P.CODTIPRECDES = T1.CODTIPRECDES'
      'AND P.IDDSTPARAMINTEGRACAO <> 999999999999999'
      'ORDER BY P.INDTIPO, P.TIPOVIAGEM, P.TIPOCONTRATO, P.RECPAG')
    UpdateObject = updParamFi
    ValidateWithMask = True
    Left = 181
    Top = 82
