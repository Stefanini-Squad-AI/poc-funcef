  object qryParamFo: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    Constrained = True
    RequestLive = True
    SQL.Strings = (
      'SELECT P.*,'
      '       RP.DESCRPROVDESC,'
      '       DECODE(P.TIPOVIAGEM,'
      '              0, '#39'Institucional'#39','
      
        '              DECODE(P.TIPOVIAGEM, 1, '#39'Treinamento'#39', '#39'Audiência'#39 +
        ')'
      '       ) AS DSCTIPOVIAGEM,'
      '       DECODE(P.TIPOCONTRATO,'
      '              '#39'E'#39', '#39'Efetivo'#39','
      
        '              DECODE(P.TIPOCONTRATO, '#39'S'#39', '#39'LEF'#39', DECODE(P.TIPOCO' +
        'NTRATO, '#39'T'#39', '#39'Terceirizado'#39', DECODE(P.TIPOCONTRATO, '#39'G'#39', '#39'Estagi' +
        'ário'#39', DECODE(P.TIPOCONTRATO, '#39'3'#39', '#39'Cessão'#39', DECODE(P.TIPOCONTRA' +
        'TO, '#39'P'#39', '#39'Prop/Dir s/Vinc'#39', '#39'Autônomo'#39')))))'
      '       ) AS DSCTIPOCONTRATO'
      'FROM DSTPARAMINTEGRACAO P,'
      '     RUBRICAXPESS RP,'
      '     DSTITEMDESPESA DI'
      'WHERE P.IDPROVENTO = RP.IDRUBRICA'
      'AND DI.IDDSTITEMDESPESA = P.INDTIPO'
      'AND   IDDSTPARAMINTEGRACAO <> 999999999999999'
      
        'ORDER BY DI.TIPOQUALIFICACAO, DI.DESCRICAO, P.TIPOCONTRATO, P.TI' +
        'POVIAGEM')
    UpdateObject = updParamFo
    ValidateWithMask = True
    Left = 277
    Top = 82
