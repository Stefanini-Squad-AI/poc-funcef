  object updParamFo: TUpdateSQL
    ModifySQL.Strings = (
      'update DSTPARAMINTEGRACAO'
      'set'
      '  IDDSTPARAMINTEGRACAO = :IDDSTPARAMINTEGRACAO,'
      '  IDPROVENTO = :IDPROVENTO,'
      '  INDTIPO = :INDTIPO,'
      '  IDPESSOA = :IDPESSOA,'
      '  RECPAG = :RECPAG,'
      '  CODTIPRECDES = :CODTIPRECDES,'
      '  TIPOCONTRATO = :TIPOCONTRATO,'
      '  TIPOVIAGEM = :TIPOVIAGEM,'
      '  FLGDESCONTO = :FLGDESCONTO'
      'where'
      '  IDDSTPARAMINTEGRACAO = :OLD_IDDSTPARAMINTEGRACAO')
    InsertSQL.Strings = (
      'insert into DSTPARAMINTEGRACAO'
      
        '  (IDDSTPARAMINTEGRACAO, IDPROVENTO, INDTIPO, IDPESSOA, RECPAG, ' +
        'CODTIPRECDES, '
      '   TIPOCONTRATO, TIPOVIAGEM, FLGDESCONTO)'
      'values'
      
        '  (:IDDSTPARAMINTEGRACAO, :IDPROVENTO, :INDTIPO, :IDPESSOA, :REC' +
        'PAG, :CODTIPRECDES, '
      '   :TIPOCONTRATO, :TIPOVIAGEM, :FLGDESCONTO)')
    DeleteSQL.Strings = (
      'delete from DSTPARAMINTEGRACAO'
      'where'
      '  IDDSTPARAMINTEGRACAO = :OLD_IDDSTPARAMINTEGRACAO')
    Left = 280
    Top = 191
  end
