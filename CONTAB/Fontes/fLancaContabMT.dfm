  object CMSqlParams1: TCMSqlParams
    SQL.Strings = (
      
        'SELECT '#39'N'#39' AS MARCA, U.PLNCODIGO, U.LACNUMLAN, U.UNIDNEGOC, U.ID' +
        'PLANOPREV,'
      
        '       U.IDSEGREGACRITER, U.DATASEGREGACRITER, U.DESCSEGREGACRIT' +
        'ER,'
      '       U.IDSEGREGACONTR,'
      '       U.IDPATRO, U.IDELEMDEMONSTRAT, U.HITCODHIST, U.IDPESSOA,'
      '       U.IDMODULO, U.IDUSUARIOINCLUSAO, U.LACVALOR,'
      
        '       U.TIPCODIGO, MAX(U.SUBCONTADEB) AS SUBCONTADEB, MAX(U.SUB' +
        'CONTACRE) AS SUBCONTACRE,'
      '       MAX(U.CCUSTDEB) AS CCUSTDEB, MAX(U.CCUSTCRE) AS CCUSTCRE,'
      
        '       MAX(U.PLACONTAD) AS PLACONTAD, MAX(U.PLACONTAC) AS PLACON' +
        'TAC,'
      
        '       MAX(U.PLACONCORRESPD) AS PLACONCORRESPD, MAX(U.PLACONCORR' +
        'ESPC) AS PLACONCORRESPC,'
      
        '       DECODE(MAX(U.PLAREDUZD),0,NULL,TO_CHAR(MAX(U.PLAREDUZD)))' +
        ' AS PLAREDUZD, DECODE(MAX(U.PLAREDUZC),0,NULL,TO_CHAR(MAX(U.PLAR' +
        'EDUZC))) AS PLAREDUZC,'
      '       U.PLANO, U.LACTIPO, U.LACNUMDOC, U.LACHIST1,'
      '       U.LACHIST2, U.LACHIST3, U.LACHIST4, U.LACHIST5,'
      '       U.NOMEPATRO,U.NOMEPLANOPREV,'
      
        '       MAX(U.TIPCONVOFIDEB) AS TIPCONVOFIDEB, MAX(U.TIPCONVGERDE' +
        'B) AS TIPCONVGERDEB,'
      
        '       MAX(U.TIPCONVGE1DEB) AS TIPCONVGE1DEB, MAX(U.TIPCONVGE2DE' +
        'B) AS TIPCONVGE2DEB,'
      
        '       MAX(U.TIPCONVOFICRE) AS TIPCONVOFICRE, MAX(U.TIPCONVGERCR' +
        'E) AS TIPCONVGERCRE,'
      
        '       MAX(U.TIPCONVGE1CRE) AS TIPCONVGE1CRE, MAX(U.TIPCONVGE2CR' +
        'E) AS TIPCONVGE2CRE,'
      
        '       SUM(U.VALOFIDEB) AS VALOFIDEB, SUM(U.VALGERDEB) AS VALGER' +
        'DEB,'
      
        '       SUM(U.VALGE1DEB) AS VALGE1DEB, SUM(U.VALGE2DEB) AS VALGE2' +
        'DEB,'
      
        '       SUM(U.VALOFICRE) AS VALOFICRE, SUM(U.VALGERCRE) AS VALGER' +
        'CRE,'
      
        '       SUM(U.VALGE1CRE) AS VALGE1CRE, SUM(U.VALGE2CRE) AS VALGE2' +
        'CRE,'
      
        '       MAX(U.ORIAPLDEB) AS ORIAPLDEB, MAX(U.ORIAPLCRE) AS ORIAPL' +
        'CRE,'
      
        '       SUM(U.VALHISDEB) AS VALHISDEB, SUM(U.VALHISCRE) AS VALHIS' +
        'CRE,'
      
        '       MAX(U.NOMECONTAD) AS NOMECONTAD, MAX(U.NOMECONTAC) AS NOM' +
        'ECONTAC, U.NOMEATIVPROJ, U.UNECODIGO,'
      
        '       MAX(U.NOMESUBCONTAD) AS NOMESUBCONTAD,MAX(U.NOMESUBCONTAC' +
        ') AS NOMESUBCONTAC,'
      
        '       MAX(U.NOMECCUSTOD) AS NOMECCUSTOD, MAX(U.NOMECCUSTOC) AS ' +
        'NOMECCUSTOC'
      'FROM'
      '(SELECT L.PLNCODIGO, L.LACNUMLAN, L.UNIDNEGOC, L.IDPLANOPREV,'
      
        '        L.IDSEGREGACRITER, L.DATASEGREGACRITER, S.DESCRICAO AS D' +
        'ESCSEGREGACRITER,'
      '        L.IDSEGREGACONTR,'
      '        L.IDPATRO, L.IDELEMDEMONSTRAT, L.HITCODHIST, L.IDPESSOA,'
      '        L.IDMODULO, L.IDUSUARIOINCLUSAO, L.LACVALOR,'
      
        '        L.TIPCODIGO, L.CODSUBCONTA AS SUBCONTADEB, (0) AS SUBCON' +
        'TACRE,'
      '        L.CODCENTROCUSTO AS CCUSTDEB, ('#39#39') AS CCUSTCRE,'
      '        L.PLACONTA AS PLACONTAD, ('#39#39') AS PLACONTAC,'
      
        '        C.PLACONCORRESP AS PLACONCORRESPD, ('#39#39') AS PLACONCORRESP' +
        'C,'
      '        C.PLAREDUZ AS PLAREDUZD, (0) AS PLAREDUZC,'
      '        L.PLANO, L.LACTIPO, L.LACNUMDOC, L.LACHIST1,'
      '        L.LACHIST2, L.LACHIST3, L.LACHIST4, L.LACHIST5,'
      
        '        L.LACTIPCONVOFICIAL AS TIPCONVOFIDEB, L.LACTIPCONVGER AS' +
        ' TIPCONVGERDEB,'
      
        '        L.LACTIPCONVGEREN1 AS TIPCONVGE1DEB, L.LACTIPCONVGEREN2 ' +
        'AS TIPCONVGE2DEB,'
      '        ('#39#39') AS TIPCONVOFICRE, ('#39#39') AS TIPCONVGERCRE,'
      '        ('#39#39') AS TIPCONVGE1CRE,('#39#39') AS TIPCONVGE2CRE,'
      
        '        L.LACVALOFICIAL AS VALOFIDEB, L.LACVALGERENCIAL AS VALGE' +
        'RDEB,'
      
        '        L.LACVALGEREN1 AS VALGE1DEB, L.LACVALGEREN2 AS VALGE2DEB' +
        ','
      
        '        (0) AS VALOFICRE, (0) AS VALGERCRE, (0) AS VALGE1CRE, (0' +
        ') AS VALGE2CRE,'
      
        '        L.LACORIGEMAPLIC AS ORIAPLDEB, ('#39#39') AS ORIAPLCRE, L.LACV' +
        'ALHIST AS VALHISDEB, (0) AS VALHISCRE,'
      
        '        C.PLANOME AS NOMECONTAD, ('#39#39') AS NOMECONTAC, UN.NOME AS ' +
        'NOMEATIVPROJ, UN.UNECODIGO,'
      
        '        SC.NOMESUBCONTA AS NOMESUBCONTAD,('#39#39') AS NOMESUBCONTAC, ' +
        'CC.NOME AS NOMECCUSTOD, ('#39#39') AS NOMECCUSTOC,'
      '        PE.NOME AS NOMEPATRO,PP.NOME AS NOMEPLANOPREV'
      
        ' FROM LANCAMENTO L, PLANOCONTA C, UNIDNEGOCIO UN, SUBCONTA SC, C' +
        'ENTCUST CC,PESSOA PE, PLANPREVCONTABIL PP, SEGREGACRITER S'
      ' WHERE (L.PLNCODIGO = 184571)'
      '   AND (L.PLANO = C.PLANO)'
      '   AND (L.LACDEBCRE = '#39'D'#39')'
      '   AND (L.PLACONTA = C.PLACONTA)'
      '   AND (L.IDPESSOA = UN.IDPESSOA(+))'
      '   AND (L.UNIDNEGOC = UN.UNIDNEGOC(+))'
      '   AND (L.IDPESSOA = SC.IDPESSOA(+))'
      '   AND (L.CODSUBCONTA = SC.CODSUBCONTA(+))'
      '   AND (L.IDEMPRESA = CC.IDEMPRESA(+))'
      '   AND (L.CODCENTROCUSTO = CC.CODCENTROCUSTO(+))'
      '   AND (L.IDPATRO        = PE.IDPESSOA(+))'
      '   AND (L.IDPLANOPREV    = PP.IDPLANOPREV(+))'
      '   AND (L.IDSEGREGACRITER = S.IDSEGREGACRITER(+))'
      'UNION'
      ' SELECT L.PLNCODIGO, L.LACNUMLAN, L.UNIDNEGOC, L.IDPLANOPREV,'
      
        '        L.IDSEGREGACRITER, L.DATASEGREGACRITER, S.DESCRICAO AS D' +
        'ESCSEGREGACRITER,'
      '        L.IDSEGREGACONTR,'
      '        L.IDPATRO, L.IDELEMDEMONSTRAT, L.HITCODHIST, L.IDPESSOA,'
      '        L.IDMODULO, L.IDUSUARIOINCLUSAO, L.LACVALOR,'
      
        '        L.TIPCODIGO, (0) AS SUBCONTADEB, L.CODSUBCONTA AS SUBCON' +
        'TACRE,'
      '        ('#39#39') AS CCUSTDEB, L.CODCENTROCUSTO AS CCUSTCRE,'
      '        ('#39#39') AS PLACONTAD, L.PLACONTA AS PLACONTAC,'
      
        '        ('#39#39') AS PLACONCORRESPD, C.PLACONCORRESP AS PLACONCORRESP' +
        'C,'
      '        (0) AS PLAREDUZD, C.PLAREDUZ AS PLAREDUZC,'
      '        L.PLANO, L.LACTIPO, L.LACNUMDOC, L.LACHIST1,'
      '        L.LACHIST2, L.LACHIST3, L.LACHIST4, L.LACHIST5,'
      '        ('#39#39') AS TIPCONVOFIDEB, ('#39#39') AS TIPCONVGERDEB,'
      '        ('#39#39') AS TIPCONVGE1DEB,('#39#39') AS TIPCONVGE2DEB,'
      
        '        L.LACTIPCONVOFICIAL AS TIPCONVOFICRE, L.LACTIPCONVGER AS' +
        ' TIPCONVGERCRE,'
      
        '        L.LACTIPCONVGEREN1 AS TIPCONVGE1CRE, L.LACTIPCONVGEREN2 ' +
        'AS TIPCONVGE2CRE,'
      
        '        (0) AS VALOFIDEB, (0) AS VALGERDEB, (0) AS VALGE1DEB, (0' +
        ') AS VALGE2DEB,'
      
        '        L.LACVALOFICIAL AS VALOFICRE, L.LACVALGERENCIAL AS VALGE' +
        'RCRE,'
      
        '        L.LACVALGEREN1 AS VALGE1CRE, L.LACVALGEREN2 AS VALGE2CRE' +
        ','
      
        '        ('#39#39') AS ORIAPLDEB, L.LACORIGEMAPLIC AS ORIAPLCRE, (0) AS' +
        ' VALHISDEB, L.LACVALHIST AS VALHISCRE,'
      
        '        ('#39#39') AS NOMECONTAD, C.PLANOME AS NOMECONTAC, UN.NOME AS ' +
        'NOMEATIVPROJ, UN.UNECODIGO,'
      
        '        ('#39#39') AS NOMESUBCONTAD, SC.NOMESUBCONTA AS NOMESUBCONTAC,' +
        ' ('#39#39') AS NOMECCUSTOD, CC.NOME AS NOMECCUSTOC,'
      '        PE.NOME AS NOMEPATRO,PP.NOME AS NOMEPLANOPREV'
      
        ' FROM LANCAMENTO L, PLANOCONTA C, UNIDNEGOCIO UN, SUBCONTA SC, C' +
        'ENTCUST CC,PESSOA PE, PLANPREVCONTABIL PP, SEGREGACRITER S'
      ' WHERE (L.PLNCODIGO      = 0)'
      '   AND (L.PLANO          = C.PLANO)'
      '   AND (L.LACDEBCRE      = '#39'C'#39')'
      '   AND (L.PLACONTA       = C.PLACONTA)'
      '   AND (L.IDPESSOA       = UN.IDPESSOA(+))'
      '   AND (L.UNIDNEGOC      = UN.UNIDNEGOC(+))'
      '   AND (L.IDPESSOA       = SC.IDPESSOA(+))'
      '   AND (L.CODSUBCONTA    = SC.CODSUBCONTA(+))'
      '   AND (L.IDEMPRESA      = CC.IDEMPRESA(+))'
      '   AND (L.CODCENTROCUSTO = CC.CODCENTROCUSTO(+))'
      '   AND (L.IDPATRO        = PE.IDPESSOA(+))'
      '   AND (L.IDPLANOPREV    = PP.IDPLANOPREV(+)) '
      '   AND (L.IDSEGREGACRITER = S.IDSEGREGACRITER(+)) ) U'
      'GROUP BY U.PLNCODIGO, U.LACNUMLAN, U.UNIDNEGOC, U.IDPLANOPREV,'
      '         U.IDSEGREGACRITER, U.DATASEGREGACRITER,'
      '         U.IDSEGREGACONTR,'
      
        '         U.IDPATRO, U.IDELEMDEMONSTRAT, U.HITCODHIST, U.IDPESSOA' +
        ','
      '         U.IDMODULO, U.IDUSUARIOINCLUSAO, U.LACVALOR,'
      '         U.PLANO, U.LACTIPO, U.LACNUMDOC, U.LACHIST1,'
      '         U.LACHIST2, U.LACHIST3, U.LACHIST4, U.LACHIST5,'
      '         U.TIPCODIGO,U.NOMEATIVPROJ, U.UNECODIGO,'
      '         U.NOMEPATRO,U.NOMEPLANOPREV, U.DESCSEGREGACRITER'
      'ORDER BY U.PLNCODIGO, U.LACNUMLAN'
      ''
      ' ')
    ClientDataSet = cdsDet
    Left = 549
    Top = 367
  end
