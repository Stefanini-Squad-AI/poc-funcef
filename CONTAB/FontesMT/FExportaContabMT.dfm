  object sqlModulos: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  IDMODULO, NOMEMODULO '
      'FROM MODULO '
      'ORDER BY NOMEMODULO'
      '')
    ClientDataSet = cdsModulos
    Left = 152
    Top = 128
  end
  object sqlContab: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  PL.IDMODULO AS COD_PROCESSO, '
      '  LC.IDEMPRESA AS COD_EMPRESA, '
      '  TO_CHAR(SYSDATE, '#39'YYYYMMDD'#39') AS DATA_PROCESSAMENTO, '
      '  LACNUMLAN AS SEQ_MOVIMENTO, '
      '  LC.PLANO AS COD_PLANO_CONTAS, '
      '  LC.PLACONTA AS COD_CONTA_CONTABIL,'
      '  LC.LACDEBCRE AS DEBITO_CREDITO,'
      '  LC.LACVALOR AS VAL_LANCAMENTO,'
      '  D.NODOCUMENTO AS NUM_DOCUMENTO,'
      
        '  LC.LACHIST1 || LC.LACHIST2 || LC.LACHIST3 || LC.LACHIST4 || LC' +
        '.LACHIST5 AS COMPLEMENTO_HISTORICO,'
      '  TO_CHAR(PL.PLNDATDIA, '#39'YYYYMMDD'#39') AS DATA_CONTABILIZACAO,'
      '  CC.CODEXTERNO AS COD_CENTRO_CUSTO,'
      '  P.MASCARA'
      
        'FROM DOCUMENTO D, LANCTODOCUM LD, PLANILHA PL, LANCAMENTO LC, CE' +
        'NTCUST CC, PLANO P'
      'WHERE D.CODDOCUMENTO = 182050 AND'
      '      D.CODDOCUMENTO = LD.CODDOCUMENTO AND'
      '      LD.PLNCODIGO = PL.PLNCODIGO AND'
      '      PL.PLNCODIGO = LC.PLNCODIGO AND'
      '      LC.CODCENTROCUSTO = CC.CODCENTROCUSTO(+) AND'
      '      LC.PLANO = P.PLANO(+)'
      '')
    ClientDataSet = cdsContab
    Left = 312
    Top = 144
  end
