  object cdsBalanco: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 32
    Top = 88
  end
  object sqlBalanco: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   C.PLACONTA, C.PLAGRAU, C.PLATIPO, C.PLACONCORRESP,'
      '   SUBSTR(C.PLACONTA, 1, 1) AS GRAU,'
      '   C.PLANOMEOUTLING AS CONTA, C.PLANOME, C.PLANOMEOUTLING,'
      
        '   '#39' '#39' AS NOMEINDENTADO,  '#39' '#39' AS DEBCRESALDO, '#39' '#39' AS DEBCRESALDO' +
        'ANT,'
      '   (0) AS SALDOABS,'
      '   (0) AS SALDOANTABS,'
      '   SS.SALDO,'
      '   SA.SALDOANT'
      'FROM'
      '   PLANOSALDO S, PLANOCONTA C,'
      '   (SELECT'
      
        '       PLACONTA, SUM(DECODE(PLSDEBITOCORRENTE, NULL, 0, PLSDEBIT' +
        'OCORRENTE)'
      
        '                   - DECODE(PLSCREDITOCOR, NULL, 0, PLSCREDITOCO' +
        'R)) AS SALDO'
      '    FROM PLANOSALDO'
      '    WHERE (1 = 2)'
      '    GROUP BY PLACONTA ) SS,'
      ''
      '   (SELECT'
      
        '       PLACONTA, SUM(DECODE(PLSDEBITOCORRENTE, NULL, 0, PLSDEBIT' +
        'OCORRENTE)'
      
        '                   - DECODE(PLSCREDITOCOR, NULL, 0, PLSCREDITOCO' +
        'R)) AS SALDOANT'
      '    FROM PLANOSALDO'
      '    WHERE (1 = 2)'
      '    GROUP BY PLACONTA ) SA'
      ''
      'WHERE'
      '    ((S.PLANO(+) = C.PLANO) AND'
      '    (S.PLACONTA(+) = C.PLACONTA)) AND'
      '    (SS.PLACONTA(+) = C.PLACONTA) AND'
      '    (SA.PLACONTA(+) = C.PLACONTA) AND'
      '    ( 1 = 2 )'
      'GROUP BY'
      '    C.PLACONTA, SS.SALDO,SA.SALDOANT,'
      '    C.PLAGRAU, C.PLATIPO,'
      '    C.PLANOMEOUTLING, C.PLANOME, C.PLACONCORRESP'
      ''
      ''
      ''
      ' '
      ' ')
    ClientDataSet = cdsBalanco
    Left = 32
    Top = 144
  end
  object cdsTitulos: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 336
    Top = 16
  end
  object sqlTitulos: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   PERNUMERO'
      'FROM '
      '   PERIODO '
      'WHERE'
      '   (IDPESSOA =:IDPESSOA) AND '
      '   (PEREXERCICIO=:PEREXERCICIO)  AND'
      '   (PERNUMERO=:PERNUMERO) AND'
      '   ((PERBLOQUE IS NULL) OR (PERBLOQUE = '#39'N'#39'))'
      'ORDER BY '
      '   PERNUMERO'
      ''
      ' ')
    ClientDataSet = cdsTitulos
    Left = 400
    Top = 16
  end
