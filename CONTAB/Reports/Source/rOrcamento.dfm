  object cdsOrcamento: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 240
    Top = 80
  end
  object sqlOrcamento: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   C.PLACONTA, C.PLAGRAU, C.PLATIPO, C.PLACONCORRESP,'
      '   SUBSTR(C.PLACONTA, 1, 7) AS GRAU,'
      '   (DECODE(SUM(S.PLSDEBITOCORRENTE - S.PLSCREDITOCOR), NULL'#39','
      '   (DECODE(SUM(S.PLSORCADODEBITO - S.PLSORCADOCREDITO), NULL,'
      '   (DECODE(SA.SALDOREAL,NULL,'
      '   (DECODE(SA.SALDOORC,NULL,'#39'0'#39','#39'1'#39')),'
      '   '#39'1'#39')),'#39'1'#39')),'#39'1'#39')) AS VERSALDO,'
      '   C.PLANOME AS CONTA, C.PLANOMEOUTLING, C.PLANOME,'
      '   SUM(S.PLSDEBITOCORRENTE - S.PLSCREDITOCOR) AS REAL,'
      '   SUM(S.PLSORCADODEBITO - S.PLSORCADOCREDITO) AS ORC,'
      '   SA.SALDOREAL, SA.SALDOORC'
      'FROM'
      '   PLANOSALDO S, PLANOCONTA C,'
      ''
      '   (SELECT'
      '       PLACONTA,'
      '       SUM(PLSDEBITOCORRENTE - PLSCREDITOCOR) AS SALDOREAL,'
      '       SUM(PLSORCADODEBITO - PLSORCADOCREDITO) AS SALDOORC'
      '    FROM PLANOSALDO'
      '    WHERE (PLANO =2) AND'
      '          (PEREXERCICIO =1998) AND'
      '          ((PERNUMERO <=4) OR (PERNUMERO IS NULL)) AND'
      '          (IDPESSOA =1)'
      '    GROUP BY PLACONTA ) SA'
      ''
      'WHERE'
      '    ((S.PLANO(+) = C.PLANO) AND'
      '    (S.PLACONTA(+) = C.PLACONTA)) AND'
      '    (SA.PLACONTA(+) = C.PLACONTA) AND'
      '    (C.PLANO =2) AND'
      '    (S.PEREXERCICIO(+) =1998) AND'
      '    (S.PERNUMERO(+) =4)'
      'GROUP BY'
      '    C.PLACONTA, SA.SALDOREAL, SA.SALDOORC,'
      '    C.PLAGRAU, C.PLATIPO,'
      '    C.PLANOMEOUTLING, C.PLANOME, C.PLACONCORRESP'
      'HAVING'
      '   (DECODE(SUM(S.PLSDEBITOCORRENTE - S.PLSCREDITOCOR), NULL'#39','
      '   (DECODE(SUM(S.PLSORCADODEBITO - S.PLSORCADOCREDITO), NULL,'
      '   (DECODE(SA.SALDOREAL,NULL,'
      '   (DECODE(SA.SALDOORC,NULL,'#39'0'#39','#39'1'#39')),'
      '   '#39'1'#39')),'#39'1'#39')),'#39'1'#39'))  = '#39'1'#39)
    ClientDataSet = cdsOrcamento
    Left = 16
    Top = 80
  end
