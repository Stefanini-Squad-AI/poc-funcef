  object cdsSaldoInicial: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 56
    Top = 144
  end
  object sqlSaldoInicial: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   C.PLACONTA, C.PLAGRAU, C.PLATIPO, C.PLACONCORRESP,        '
      '   SUBSTR(C.PLACONTA, 1, 1) AS GRAU,'
      '   C.PLANOMEOUTLING AS CONTA, C.PLANOME, C.PLANOMEOUTLING,   '
      '   SS.SALDO,'#39' '#39' as DEBCRESALDO,'
      '   0 AS SALDOABS,'
      
        '   '#39'                                                         '#39' A' +
        'S NOMEINDENTADO'
      'FROM                                                         '
      '   PLANOSALDO S, PLANOCONTA C,                               '
      '   (SELECT'
      
        '       PLACONTA, SUM(DECODE(PLSDEBITOCORRENTE, NULL, 0, PLSDEBIT' +
        'OCORRENTE)'
      
        '                   - DECODE(PLSCREDITOCOR, NULL, 0, PLSCREDITOCO' +
        'R)) AS SALDO'
      '    FROM PLANOSALDO'
      '    WHERE (1 = 2)'
      '    GROUP BY PLACONTA ) SS'
      ''
      'WHERE'
      '    ((S.PLANO(+) = C.PLANO) AND'
      '    (S.PLACONTA(+) = C.PLACONTA)) AND'
      '    (SS.PLACONTA(+) = C.PLACONTA) AND'
      '    ( 1 = 2 )'
      'GROUP BY'
      '    C.PLACONTA, SS.SALDO,'
      '    C.PLAGRAU, C.PLATIPO,'
      '    C.PLANOMEOUTLING, C.PLANOME, C.PLACONCORRESP'
      ' '
      ' ')
    ClientDataSet = cdsSaldoInicial
    Left = 152
    Top = 144
  end
end
