  object sqlBalAnalAPSC: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      
        '   PLACONTA, PLAGRAU, GRAU, PLATIPO, PLACONCORRESP, PLANATUREZA,' +
        ' CODSUBCONTA,'
      
        '   ('#39' '#39') AS DEBCREANT, ('#39' '#39') AS DEBCRESALDO, (0) AS SALDOABS, (0' +
        ') AS SALDOANTABS, ('#39' '#39') AS NOMEINDENTADO,'
      
        '   CONTA, PLANOMEOUTLING, PLANOME, NOMESUBCONTA, UNECODIGO, UNID' +
        'NEGOC, NOME, DEB, CRED, MOV,'
      '   SALDOANT, SALDO FROM'
      '('
      ''
      'SELECT'
      
        '   C.PLACONTA, C.PLAGRAU, ('#39' '#39') AS GRAU, C.PLATIPO, C.PLACONCORR' +
        'ESP, C.PLANATUREZA, (0) AS CODSUBCONTA,'
      
        '   ('#39' '#39') AS CONTA, C.PLANOMEOUTLING, C.PLANOME, ('#39' '#39') AS NOMESUB' +
        'CONTA,'
      
        '   U.UNECODIGO, S.UNIDNEGOC, U.NOME, M.DEB,M.CRED,M.MOV, SA.SALD' +
        'OANT,'
      '   SUM(DECODE(S.PLSDEBITOCORRENTE, NULL, 0, S.PLSDEBITOCORRENTE)'
      '   - DECODE(S.PLSCREDITOCOR, NULL, 0, S.PLSCREDITOCOR)) AS SALDO'
      'FROM'
      '   PLANOSALDO S, PLANOCONTA C, UNIDNEGOCIO U,'
      '   (SELECT'
      
        '       PLACONTA, UNIDNEGOC, SUM(DECODE(PLSDEBITOCORRENTE, NULL, ' +
        '0, PLSDEBITOCORRENTE)'
      
        '                   - DECODE(PLSCREDITOCOR, NULL, 0, PLSCREDITOCO' +
        'R)) AS SALDOANT'
      '    FROM PLANOSALDO'
      '    WHERE (PLANO = 2) AND'
      '          (PEREXERCICIO =1999) AND'
      '          ((PERNUMERO <6) OR (PERNUMERO IS NULL)) AND'
      '          (IDPESSOA =1)'
      '    GROUP BY PLACONTA,UNIDNEGOC ) SA,'
      '   (SELECT'
      '       PLACONTA,UNIDNEGOC,'
      '       SUM(PLSDEBITOCORRENTE) AS DEB,'
      '       SUM(PLSCREDITOCOR) AS CRED,'
      '       (SUM(PLSDEBITOCORRENTE) - SUM(PLSCREDITOCOR)) AS MOV'
      '    FROM PLANOSALDO'
      '    WHERE (PLANO = 2) AND'
      '          (PERNUMERO(+) BETWEEN 6 AND 6) AND'
      '          (PEREXERCICIO =1999) AND'
      '          (IDPESSOA =1)'
      '    GROUP BY PLACONTA, UNIDNEGOC ) M'
      'WHERE'
      '    (SA.PLACONTA(+)    = S.PLACONTA) AND'
      '    (SA.UNIDNEGOC(+)   = S.UNIDNEGOC) AND'
      '    (M.PLACONTA(+)     = S.PLACONTA) AND'
      '    (M.UNIDNEGOC(+)    = S.UNIDNEGOC) AND'
      '    (S.PLANO =2) AND'
      '    (S.PEREXERCICIO(+) =1999) AND'
      '    ((S.PERNUMERO <=6) OR (S.PERNUMERO IS NULL)) AND'
      '    (S.IDPESSOA =1) AND'
      '    (U.UNIDNEGOC = S.UNIDNEGOC) AND'
      '    (U.IDPESSOA = S.IDPESSOA) AND'
      '    (S.PLACONTA = C.PLACONTA) AND'
      '    (S.PLANO = C.PLANO) AND'
      '    (C.PLAGRAU <= 7)'
      'GROUP BY'
      
        '   C.PLACONTA, C.PLAGRAU, C.PLATIPO, C.PLACONCORRESP, C.PLANATUR' +
        'EZA,'
      
        '   C.PLANOME, U.NOME, S.UNIDNEGOC, U.UNECODIGO, C.PLANOMEOUTLING' +
        ','
      '   SA.SALDOANT, M.DEB, M.CRED, M.MOV'
      'UNION ALL'
      ''
      'SELECT'
      
        '   C.PLACONTA, C.PLAGRAU, ('#39' '#39') AS GRAU, C.PLATIPO, C.PLACONCORR' +
        'ESP, C.PLANATUREZA,'
      
        '   S.CODSUBCONTA, ('#39' '#39') AS CONTA, C.PLANOMEOUTLING, C.PLANOME, S' +
        'C.NOMESUBCONTA, U.UNECODIGO, S.UNIDNEGOC, U.NOME,'
      '   M.DEB,M.CRED,M.MOV,'
      '   SA.SALDOANT,'
      '   SUM(DECODE(S.PLSDEBITOCORRENTE, NULL, 0, S.PLSDEBITOCORRENTE)'
      '   - DECODE(S.PLSCREDITOCOR, NULL, 0, S.PLSCREDITOCOR)) AS SALDO'
      'FROM'
      '   PLANOSALDO S, SUBCONTA SC, PLANOCONTA C, UNIDNEGOCIO U,'
      '   (SELECT'
      
        '       PLACONTA,CODSUBCONTA,UNIDNEGOC,SUM(DECODE(PLSDEBITOCORREN' +
        'TE, NULL, 0, PLSDEBITOCORRENTE)'
      
        '                   - DECODE(PLSCREDITOCOR, NULL, 0, PLSCREDITOCO' +
        'R)) AS SALDOANT'
      '    FROM PLANOSALDO'
      '    WHERE (PLANO = 2) AND'
      '          (PEREXERCICIO =1999) AND'
      '          ((PERNUMERO <6) OR (PERNUMERO IS NULL)) AND'
      '          (IDPESSOA =1)'
      '    GROUP BY PLACONTA,CODSUBCONTA,UNIDNEGOC ) SA,'
      '   (SELECT'
      '       PLACONTA,CODSUBCONTA,UNIDNEGOC,'
      '       SUM(PLSDEBITOCORRENTE) AS DEB,'
      '       SUM(PLSCREDITOCOR) AS CRED,'
      '       (SUM(PLSDEBITOCORRENTE) - SUM(PLSCREDITOCOR)) AS MOV'
      '    FROM PLANOSALDO'
      '    WHERE (PLANO = 2) AND'
      '          (PERNUMERO(+) BETWEEN 6 AND 6) AND'
      '          (PEREXERCICIO =1999) AND'
      '          (IDPESSOA =1)'
      '    GROUP BY PLACONTA, CODSUBCONTA,UNIDNEGOC ) M'
      'WHERE'
      '    (SA.PLACONTA(+)    = S.PLACONTA) AND'
      '    (SA.CODSUBCONTA(+) = S.CODSUBCONTA) AND'
      '    (SA.UNIDNEGOC(+)   = S.UNIDNEGOC) AND'
      '    (M.PLACONTA(+)     = S.PLACONTA) AND'
      '    (M.CODSUBCONTA(+)  = S.CODSUBCONTA) AND'
      '    (M.UNIDNEGOC(+)    = S.UNIDNEGOC) AND'
      '    (S.PLANO =2) AND'
      '    (S.PEREXERCICIO(+) =1999) AND'
      '    ((S.PERNUMERO <=6) OR (S.PERNUMERO IS NULL)) AND'
      '    (S.IDPESSOA =1) AND'
      '    (SC.CODSUBCONTA = S.CODSUBCONTA) AND'
      '    (SC.IDPESSOA = S.IDPESSOA) AND'
      '    (U.UNIDNEGOC = S.UNIDNEGOC) AND'
      '    (U.IDPESSOA = S.IDPESSOA) AND'
      '    (S.PLACONTA = C.PLACONTA) AND'
      '    (S.PLANO = C.PLANO)'
      'GROUP BY'
      
        '   C.PLACONTA, C.PLAGRAU, C.PLATIPO, C.PLACONCORRESP, C.PLANATUR' +
        'EZA,'
      
        '   S.CODSUBCONTA, C.PLANOME, SC.NOMESUBCONTA,S.UNIDNEGOC, U.NOME' +
        ','
      '   M.DEB,M.CRED,M.MOV, U.UNECODIGO, C.PLANOMEOUTLING,'
      '   SA.SALDOANT )'
      ' ORDER BY PLACONTA, UNIDNEGOC, NOMESUBCONTA'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ClientDataSet = cdsBalAnalAPSC
    Left = 56
    Top = 128
  end
