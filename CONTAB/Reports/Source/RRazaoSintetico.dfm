  object sqlRazaoSint: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      
        '   L.PLACONTA, C.PLANOME, S.NOMESUBCONTA, U.UNECODIGO, C.PLAGRAU' +
        ','
      '   L.IDMODULO, M.NOMEMODULO, SA.SALDOANT, SS.SALDO,'
      
        '   (DECODE(L.LACDEBCRE, '#39'D'#39', L.LACVALOR, L.LACVALOR*-1)) AS MOVI' +
        'MENT,'
      '   (DECODE(L.LACDEBCRE, '#39'D'#39', L.LACVALOR, 0)) AS DEB,'
      '   (DECODE(L.LACDEBCRE, '#39'C'#39', L.LACVALOR, 0)) AS CRED,'
      '   (0) AS SALDOCORRENTE,'
      '   ('#39' '#39')  AS DEBCRE,'
      '   L.CODCENTROCUSTO, L.CODSUBCONTA'
      'FROM'
      
        '   LANCAMENTO L, PLANILHA P, PLANOCONTA C,  SUBCONTA S, UNIDNEGO' +
        'CIO U, MODULO M, '
      '   (SELECT'
      
        '       PLACONTA, SUM(PLSDEBITOCORRENTE - PLSCREDITOCOR) AS SALDO' +
        'ANT'
      '    FROM PLANOSALDO'
      '    WHERE (PLANO = 2) AND'
      #9'    (PEREXERCICIO = 1999) AND'
      '          (PERNUMERO IS NULL) AND'
      '          (PLACONTA >= '#39'1111'#39') AND'
      '          (PLACONTA <= '#39'1112'#39')'
      '    GROUP BY PLACONTA ) SA,'
      '   (SELECT'
      '       L.PLACONTA,'
      
        '       SUM(DECODE(L.LACDEBCRE, '#39'D'#39', L.LACVALOR, (L.LACVALOR * (-' +
        '1)))) AS SALDO'
      '    FROM PLANILHA P, LANCAMENTO L'
      '    WHERE (L.PLNCODIGO = P.PLNCODIGO) AND'
      #9'    (L.PLANO = 2) AND'
      #9'    (P.PEREXERCICIO = 1999) AND'
      '          (L.PLACONTA >= '#39'1111'#39') AND'
      '          (L.PLACONTA <= '#39'1112'#39') AND'
      '          (P.PLNDATDIA < TO_DATE('#39'01/02/1999'#39', '#39'DD/MM/YYYY'#39'))'
      '    GROUP BY L.PLACONTA ) SS'
      'WHERE'
      '    ((L.PLANO = C.PLANO) AND'
      '     (L.PLACONTA = C.PLACONTA)) AND'
      '    ((L.UNIDNEGOC = U.UNIDNEGOC) AND'
      '     (L.IDPESSOA = U.IDPESSOA)) AND'
      '    (P.PLNCODIGO = L.PLNCODIGO) AND'
      '    (P.IDMODULO = M.IDMODULO) AND'
      '    (SA.PLACONTA(+) = C.PLACONTA) AND'
      '    (SS.PLACONTA(+) = C.PLACONTA) AND'
      '    (S.CODSUBCONTA = L.CODSUBCONTA) AND '
      '    (P.PLNEFETIVADO = '#39'S'#39') AND '
      '    (C.PLANO = 2) AND '
      '    (P.PEREXERCICIO = 1999) AND'
      '    (P.PERNUMERO = 2) AND '
      '    (C.PLACONTA >= '#39'1111'#39') AND '
      '    (C.PLACONTA <= '#39'1112'#39') AND'
      '    ( 1 = 2) '
      ''
      '')
    ClientDataSet = cdsRazaoSint
    Left = 112
    Top = 72
  end
