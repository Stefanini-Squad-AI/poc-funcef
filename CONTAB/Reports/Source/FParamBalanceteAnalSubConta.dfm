  object sqlCCusto: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   CODCENTROCUSTO ,'
      '   CODEXTERNO'
      'FROM '
      '   CENTCUST'
      'WHERE'
      '   ( IDEMPRESA =:IDEMPRESA )'
      '   AND'
      '   ( RTRIM(CODCENTROCUSTO) = RTRIM(:CODCENTROCUSTO) )'
      '')
    ClientDataSet = cdsCCusto
    Left = 330
    Top = 275
  end
