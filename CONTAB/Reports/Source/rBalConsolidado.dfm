  object cdsBalConsolid: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 296
    Top = 104
  end
  object sqlBalConsolid: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   PLACONTA, PLANOME AS CONTA, PLAGRAU, PLANATUREZA,'
      '   PLATIPO, PLACONCORRESP,'
      '   SUBSTR(PLACONTA, 1, 1) AS GRAU,'
      '   ('#39' '#39') AS NOMEINDENTADO,'
      '   (0) AS DEB,'
      '   (0) AS CRED,'
      '   (0) AS DEBA,'
      '   (0) AS CREDA,'
      '   (0) AS MOV,'
      '   (0) AS SALDOANT, (0) AS SALDO, PLANOMEOUTLING, PLANOME'
      'FROM'
      '   PLANOCONTA'
      'WHERE'
      '  (RTRIM(PLACONTA) >= RTRIM(:pContaIni)) AND'
      '  (RTRIM(PLACONTA) <= RTRIM(:pContaFim))'
      'ORDER BY'
      '  PLACONTA'
      ' '
      ' '
      '')
    ClientDataSet = cdsBalConsolid
    Left = 384
    Top = 104
  end
  object cdsAux: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 400
    Top = 8
  end
  object sqlAux: TCMSqlParams
    SQL.Strings = (
      'SELECT  '
      '   PERNUMERO'
      'FROM '
      '   PERIODO '
      'WHERE'
      '   (IDPESSOA =:IDPESSOA) AND '
      '   (PEREXERCICIO=:PEREXERCICIO) AND '
      '   (PERNUMERO BETWEEN :PERNUMEROINI AND :PERNUMEROFIM) AND '
      '   ((PERBLOQUE IS NULL) OR (PERBLOQUE = '#39'N'#39'))'
      '')
    ClientDataSet = cdsAux
    Left = 432
    Top = 8
  end
