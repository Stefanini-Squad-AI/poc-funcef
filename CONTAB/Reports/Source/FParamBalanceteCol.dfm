  object cdsCCusto: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 408
    Top = 245
  end
  object sqlCCusto: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   CODEXTERNO '
      'FROM '
      '   CENTCUST'
      'WHERE'
      '   ( IDEMPRESA =:IDEMPRESA )'
      '   AND'
      '   ( RTRIM(CODEXTERNO ) = RTRIM(:CODEXTERNO ) )'
      '')
    ClientDataSet = cdsCCusto
    Left = 129
    Top = 221
  end
