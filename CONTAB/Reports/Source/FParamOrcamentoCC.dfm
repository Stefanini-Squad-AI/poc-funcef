  object sqlCCusto: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   CODEXTERNO  '
      'FROM '
      '   CENTCUST'
      'WHERE'
      '   ( IDEMPRESA =:IDEMPRESA )'
      '   AND'
      '   ( RTRIM(CODEXTERNO  ) = RTRIM(:CODEXTERNO  ) )'
      '')
