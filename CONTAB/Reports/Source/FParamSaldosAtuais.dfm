  object sqlAtivProj: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   UNIDNEGOC,UNECODIGO '
      'FROM '
      '   UNIDNEGOCIO'
      'WHERE'
      '   ( IDPESSOA =:IDPESSOA )'
      '   AND'
      '   ( RTRIM(UNIDNEGOC) = RTRIM(:UNIDNEGOC) )'
      '')
    ClientDataSet = cdsAtivProj
    Left = 161
    Top = 213
