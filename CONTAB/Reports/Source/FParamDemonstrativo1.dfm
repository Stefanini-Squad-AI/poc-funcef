  object sqlAtivProjG: TCMSqlParams
    SQL.Strings = (
      'SELECT UNECODIGO, UNIDNEGOC, NOME, '#39'N'#39' AS MARCA'
      'FROM UNIDNEGOCIO'
      'WHERE (IDPESSOA = :IDPESSOA)'
      '  AND (UNETIPO = '#39'A'#39')'
      'ORDER BY UNECODIGO'
      '')
    ClientDataSet = cdsAtivProjG
    Left = 145
    Top = 323
  end
