  object sqlCCusto: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   CODEXTERNO,  CODCENTROCUSTO '
      'FROM '
      '   CENTCUST'
      'WHERE'
      '   ( IDEMPRESA =:IDEMPRESA )'
      '   AND'
      '   ( RTRIM(CODEXTERNO) = RTRIM(:CODCENTROCUSTO) )'
      ''
      ''
      ''
      '')
    ClientDataSet = cdsCCusto
    Left = 241
    Top = 301
  end
