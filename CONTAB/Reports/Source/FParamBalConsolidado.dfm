  object sqlPeriodoIni: TCMSqlParams
    SQL.Strings = (
      'SELECT  '
      '   PERNUMERO, PERNOME '
      'FROM '
      '   PERIODO '
      'WHERE'
      '   (IDPESSOA =:IDPESSOA) AND '
      '   (PEREXERCICIO=:PEREXERCICIO)'
      'ORDER BY '
      '   PERNUMERO'
      '')
    ClientDataSet = cdsPeriodoIni
    Left = 185
    Top = 27
  end
  object sqlExercicio: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT '
      '   PEREXERCICIO '
      'FROM '
      '   PERIODO '
      'WHERE'
      '   IDPESSOA =:IDPESSOA'
      'ORDER BY '
      '   PEREXERCICIO'
      '')
    ClientDataSet = cdsExercicio
    Left = 75
    Top = 22
