  end
  object sqlBalSaldoAtual: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   PLACONTA, PLANOME AS CONTA, PLAGRAU, PLANATUREZA,'
      '   PLATIPO, PLACONCORRESP,'
      '   ('#39' '#39') AS DEBCRESALDO, (0) AS SALDOABS,('#39' '#39') AS NOMEINDENTADO,'
      '   SUBSTR(PLACONTA, 1, 1) AS GRAU,'
      '   (0) AS SALDO, PLANOMEOUTLING, PLANOME'
      'FROM'
      '   PLANOCONTA'
      ''
      ' ')
    ClientDataSet = cdsBalSaldoAtual
    Left = 296
    Top = 80
  end
  object cdsAux: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 40
    Top = 152
  end
  object sqlAux: TCMSqlParams
    SQL.Strings = (
      'SELECT  '
      '   PERNUMERO'
      'FROM '
      '   PERIODO '
      'WHERE'
      '   (IDPESSOA =:IDPESSOA) AND '
      '   (PEREXERCICIO=:PEREXERCICIO) AND '
      '   (PERNUMERO =:PERNUMERO) AND '
      '   ((PERBLOQUE IS NULL) OR (PERBLOQUE = '#39'N'#39'))'
      '')
    ClientDataSet = cdsAux
    Left = 120
    Top = 152
  end
