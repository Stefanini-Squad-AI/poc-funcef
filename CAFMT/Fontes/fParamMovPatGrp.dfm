  object qryMovPatGrp: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT CLASSE,'
      '       NOME AS DESCGRUPO,'
      '       TIPO AS S_A,'
      '       (0)  AS SLDANT,'
      '       (0)  AS DEBITOS,'
      '       (0)  AS CREDITOS,'
      '       (0)  AS SLDATU'
      'FROM GRUPO'
      'ORDER BY CLASSE')
    UpdateObject = updMovPatGrp
    ValidateWithMask = True
    Left = 192
    Top = 264
    object qryMovPatGrpCLASSE: TStringField
      FieldName = 'CLASSE'
      Size = 15
    end
    object qryMovPatGrpDESCGRUPO: TStringField
      FieldName = 'DESCGRUPO'
      Size = 60
    end
    object qryMovPatGrpS_A: TStringField
      FieldName = 'S_A'
      Size = 1
    end
    object qryMovPatGrpSLDANT: TFloatField
      FieldName = 'SLDANT'
    end
    object qryMovPatGrpDEBITOS: TFloatField
      FieldName = 'DEBITOS'
    end
    object qryMovPatGrpCREDITOS: TFloatField
      FieldName = 'CREDITOS'
    end
    object qryMovPatGrpSLDATU: TFloatField
      FieldName = 'SLDATU'
    end
  end
  object updMovPatGrp: TUpdateSQL
    ModifySQL.Strings = (
      'update GRUPO'
      'set'
      '  CLASSE = :CLASSE,'
      '  DESCGRUPO = :DESCGRUPO,'
      '  S_A = :S_A,'
      '  SLDANT = :SLDANT,'
      '  DEBITOS = :DEBITOS,'
      '  CREDITOS = :CREDITOS,'
      '  SLDATU = :SLDATU'
      'where'
      '  CLASSE = :OLD_CLASSE')
    InsertSQL.Strings = (
      'insert into GRUPO'
      '  (CLASSE, DESCGRUPO, S_A, SLDANT, DEBITOS, CREDITOS, SLDATU)'
      'values'
      
        '  (:CLASSE, :DESCGRUPO, :S_A, :SLDANT, :DEBITOS, :CREDITOS, :SLD' +
        'ATU)')
    DeleteSQL.Strings = (
      'delete from GRUPO'
      'where'
      '  CLASSE = :OLD_CLASSE')
    Left = 192
    Top = 320
  end
