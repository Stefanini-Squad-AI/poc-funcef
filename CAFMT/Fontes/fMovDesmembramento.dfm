  object updGerBens: TUpdateSQL
    ModifySQL.Strings = (
      'update BEM'
      'set'
      '  DESBEM = :DESBEM,'
      '  IDCONJUNTO = :IDCONJUNTO,'
      '  DESCCONJUNTO = :DESCCONJUNTO,'
      '  IDGRUPO = :IDGRUPO,'
      '  CLASSE = :CLASSE,'
      '  NOME = :NOME,'
      '  PROPORCAO = :PROPORCAO'
      'where'
      '  PLACA = :OLD_PLACA')
    InsertSQL.Strings = (
      'insert into BEM'
      
        '  (PLACA, DESBEM, IDCONJUNTO, DESCCONJUNTO, IDGRUPO, CLASSE, NOM' +
        'E, PROPORCAO)'
      'values'
      
        '  (:PLACA, :DESBEM, :IDCONJUNTO, :DESCCONJUNTO, :IDGRUPO, :CLASS' +
        'E, :NOME, '
      '   :PROPORCAO)')
    DeleteSQL.Strings = (
      'delete from BEM'
      'where'
      '  PLACA = :OLD_PLACA')
    Left = 525
    Top = 297
  end
