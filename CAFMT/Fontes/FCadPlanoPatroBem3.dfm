  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update PLANOPATROXBEM'
      'set'
      '  PPBPERCRATEIO = :PPBPERCRATEIO'
      'where'
      '  IDBEM = :OLD_IDBEM and'
