  object qryLancamento: TwwQuery
    DatabaseName = 'Basedados'
    SQL.Strings = (
      'SELECT L.PLACONTA,'
      '       L.LACHIST1,'
      '       L.LACTIPO,'
      '       L.CODCENTROCUSTO,'
      '       L.HITCODHIST,'
      '       P.PLNDATDIA,'
      '       L.LACVALOR,'
      '       L.LACHIST2,'
      '       L.LACHIST3,'
      '       L.LACHIST4,'
      '       L.LACHIST5,'
      '       P.PLNPLANIL,'
      '       L.PLNCODIGO'
      'FROM LANCAMENTO L,'
      '     PLANILHA P'
      'WHERE (L.IDMODULO = 7)'
      '  AND (L.IDPESSOA = :PIDPESSOA)'
      
        '  AND ((P.PLNDATDIA >= :pDTAINICIO) AND (P.PLNDATDIA <= :pDTAFIM' +
        '))'
      '  AND (L.PLNCODIGO = P.PLNCODIGO)'
      'ORDER BY P.PLNDATDIA,L.PLNCODIGO'
      ''
      ' '
      ' ')
    ValidateWithMask = True
    Left = 280
    Top = 56
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftDate
        Name = 'pDTAINICIO'
        ParamType = ptUnknown
      end
      item
        DataType = ftDate
        Name = 'pDTAFIM'
        ParamType = ptUnknown
      end>
    object qryLancamentoPLACONTA: TStringField
      FieldName = 'PLACONTA'
      Origin = 'BASEDADOS.LANCAMENTO.PLACONTA'
      FixedChar = True
      Size = 18
    end
