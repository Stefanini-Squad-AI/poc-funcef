  object qryImovel: TwwQuery
    DatabaseName = 'Basedados'
    SQL.Strings = (
      'SELECT IDIMOVEL, IMONOME AS IMENOME'
      'FROM IMOVEL'
      'WHERE (IDIMOVELMESTRE = :PIMOMESTRE)'
      'ORDER BY IMONOME')
    ValidateWithMask = True
    Left = 264
    Top = 16
    ParamData = <
