  object qrySomaLancObra: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT SUM(VALOFI) AS SOMAVALOFI'
      'FROM   CAFOBRALANC'
      'WHERE  (IDCAFOBRA = :PIDCAFOBRA)'
      '  AND  (IDPESSOA  = :PIDPESSOA)'
      '')
