  object qrySelBem: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT B.IDMODULO, B.IDBEM, B.IDPESSOA, B.PLACA, B.DESBEM, B.DTA' +
        'INCLUSAO, B.DATAINICIODEP,'
      
        '       B.IDGRUPO, C.IDLOCALIZACAO, C.IDRESPONSAVEL, B.BAIXATOTAL' +
        ', B.PROPBAIXA'
      'FROM BEM B,'
      '     CONJUNTO C'
      'WHERE (B.IDBEM = :PIDBEM)'
      '  AND (B.IDPESSOA = :PIDPESSOA)'
      '  AND (B.CONTROLE = '#39'T'#39')'
      '  AND (B.IDCONJUNTO = C.IDCONJUNTO)'
      '  AND (B.IDPESSOA   = C.IDPESSOA)'
      ''
      ' '
      ' ')
    ValidateWithMask = True
    Left = 272
    Top = 8
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDBEM'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'PIDPESSOA'
        ParamType = ptUnknown
      end>
    object qrySelBemIDBEM: TFloatField
      FieldName = 'IDBEM'
      Origin = 'BASEDADOS.BEM.IDBEM'
    end
    object qrySelBemIDPESSOA: TFloatField
      FieldName = 'IDPESSOA'
      Origin = 'BASEDADOS.BEM.IDPESSOA'
    end
    object qrySelBemPLACA: TFloatField
      FieldName = 'PLACA'
      Origin = 'BASEDADOS.BEM.PLACA'
    end
    object qrySelBemDESBEM: TStringField
      FieldName = 'DESBEM'
      Origin = 'BASEDADOS.BEM.DESBEM'
      Size = 200
    end
