  object qrySelTermo: TwwQuery
    CachedUpdates = True
    DatabaseName = 'Basedados'
    SQL.Strings = (
      'SELECT SB.IDSELBAIXA,'
      '       SB.SBXTERMO,'
      '       SB.SBXPROCESSO,'
      '       SB.SBXDATA,'
      '       P.NOME AS SBXNOMERESP,'
      '       SB.SBXFLGEXECUTADO,'
      '       SB.SBXDTAEXECUTADO,'
      '       SB.SBTIPOMOV'
      'FROM SELBAIXA SB,'
      '     PESSOA P'
      'WHERE (SB.IDSELBAIXA    = :PIDSELBAIXA)'
      '  AND (SB.IDRESPONSAVEL = P.IDPESSOA(+))')
    UpdateObject = updSelTermo
    ValidateWithMask = True
    Left = 592
    Top = 98
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'PIDSELBAIXA'
        ParamType = ptUnknown
      end>
