    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT AV.VALORG,AV.DATAACRESCIMO,HAV.OBS,AV.IDACRESCIMO,AV.IDMO' +
        'VIMENTACAO,'
      '       0 AS MARCADO'
      'FROM ACRESCIMOVALOR AV, ACRESCVALOR HAV'
