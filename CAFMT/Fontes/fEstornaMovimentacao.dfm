  object qryBensReaval: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT R.IDBEM,R.IDPESSOA,B.PLACA,B.DESBEM,G.NOME'
      'FROM REAVALIACAO R,'
      '     BEM B,'
      '     GRUPO G'
      'WHERE (R.DATAREAVALIACAO = :PDATAMOV)'
      '  AND (R.TAXADEP <> 0)'
      '  AND (R.IDBEM = B.IDBEM)'
      '  AND (B.IDGRUPO = G.IDGRUPO)'
      'ORDER BY B.PLACA'
      '')
    ValidateWithMask = True
