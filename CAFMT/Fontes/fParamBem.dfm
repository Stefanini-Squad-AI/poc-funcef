      Origin = 'GRUPO.CLASSE'
      Size = 15
    end
    object qryGrupoIDGRUPO: TFloatField
      FieldName = 'IDGRUPO'
      Origin = 'GRUPO.IDGRUPO'
    end
  end
  object qryLocalizacao: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT NOME, IDLOCALIZACAO'
      'FROM LOCALIZACAO'
      'ORDER BY NOME')
    ValidateWithMask = True
    Left = 144
    Top = 144
    object qryLocalizacaoNOME: TStringField
