  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update ITENSINVBENS'
      'set'
      '  IIBFLGPLACA = :IIBFLGPLACA,'
      '  IIBLOCALATUAL = :IIBLOCALATUAL,'
      '  IIBCONJUNTOATUAL = :IIBCONJUNTOATUAL,'
      '  IIBLOCALNOVO = :IIBLOCALNOVO,'
      '  IIBCONJUNTONOVO = :IIBCONJUNTONOVO,'
      '  IIBFLGSITFISICA = :IIBFLGSITFISICA'
      'where'
      '  IDINVENTARIOBENS = :OLD_IDINVENTARIOBENS and'
      '  IDEMPRESA = :OLD_IDEMPRESA and'
      '  IIBPLACA = :OLD_IIBPLACA and'
      '  IIBIDBEM = :OLD_IIBIDBEM')
    InsertSQL.Strings = (
      'insert into ITENSINVBENS'
      
        '  (IDINVENTARIOBENS, IDEMPRESA, IIBPLACA, IIBIDBEM, IIBFLGPLACA,' +
        ' IIBLOCALATUAL, '
      
        '   IIBCONJUNTOATUAL, IIBLOCALNOVO, IIBCONJUNTONOVO, IIBFLGSITFIS' +
        'ICA)'
      'values'
      
        '  (:IDINVENTARIOBENS, :IDEMPRESA, :IIBPLACA, :IIBIDBEM, :IIBFLGP' +
        'LACA, :IIBLOCALATUAL, '
      
        '   :IIBCONJUNTOATUAL, :IIBLOCALNOVO, :IIBCONJUNTONOVO, :IIBFLGSI' +
        'TFISICA)')
    DeleteSQL.Strings = (
      'delete from ITENSINVBENS'
      'where'
      '  IDINVENTARIOBENS = :OLD_IDINVENTARIOBENS and'
      '  IDEMPRESA = :OLD_IDEMPRESA and'
      '  IIBPLACA = :OLD_IIBPLACA and'
      '  IIBIDBEM = :OLD_IIBIDBEM')
    Left = 608
    Top = 336
  end
  inherited qry: TwwQuery
    AfterScroll = qryAfterScroll
    SQL.Strings = (
      'SELECT I.IDINVENTARIOBENS,'
      '       I.IDEMPRESA,'
      '       I.IIBPLACA,'
      '       I.IIBIDBEM,'
      '       I.IIBFLGPLACA,'
      '       I.IIBLOCALATUAL,'
      '       I.IIBCONJUNTOATUAL,'
      '       I.IIBLOCALNOVO,'
      '       I.IIBCONJUNTONOVO,'
      '       I.IIBFLGSITFISICA,'
      '       B.PLACA,'
      
        '       DECODE(B.DESBEM,NULL,'#39'PLACA NÃO CADASTRADA'#39',B.DESBEM) AS ' +
        'DESBEM,'
      '       B.IDBEM,'
      '       B.IDPESSOA'
      'FROM ITENSINVBENS I,'
      '     BEM B'
      'WHERE (I.IDINVENTARIOBENS = :PIDINVENTARIOBENS)'
      '  AND (I.IDEMPRESA        = :PIDEMPRESA)'
      '  AND (I.IIBIDBEM         = B.IDBEM(+))'
      ''
      ''
      ' '
      ' ')
    Left = 528
    Top = 336
    ParamData = <
      item
        DataType = ftFloat
        Name = 'PIDINVENTARIOBENS'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'PIDEMPRESA'
        ParamType = ptUnknown
      end>
