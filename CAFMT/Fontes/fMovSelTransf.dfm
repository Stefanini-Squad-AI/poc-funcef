  object updDet: TUpdateSQL
    ModifySQL.Strings = (
      'update SELBAIXABENS'
      'set'
      '  IDCONJATUAL = :IDCONJATUAL,'
      '  IDLOCALATUAL = :IDLOCALATUAL,'
      '  IDRESPATUAL = :IDRESPATUAL,'
      '  IDGRUPATUAL = :IDGRUPATUAL,'
      '  IDCONJUNTO = :IDCONJUNTO,'
      '  IDLOCALIZACAO = :IDLOCALIZACAO,'
      '  IDRESPONSAVEL = :IDRESPONSAVEL,'
      '  IDGRUPO = :IDGRUPO'
      'where'
      '  IDSELBAIXA = :OLD_IDSELBAIXA and'
      '  IDBEM = :OLD_IDBEM and'
      '  IDPESSOA = :OLD_IDPESSOA')
    InsertSQL.Strings = (
      'insert into SELBAIXABENS'
      
        '  (IDSELBAIXA, IDBEM, IDPESSOA, IDCONJATUAL, IDLOCALATUAL, IDRES' +
        'PATUAL, '
      
        '   IDGRUPATUAL, IDCONJUNTO, IDLOCALIZACAO, IDRESPONSAVEL, IDGRUP' +
        'O)'
      'values'
      
        '  (:IDSELBAIXA, :IDBEM, :IDPESSOA, :IDCONJATUAL, :IDLOCALATUAL, ' +
        ':IDRESPATUAL, '
      
        '   :IDGRUPATUAL, :IDCONJUNTO, :IDLOCALIZACAO, :IDRESPONSAVEL, :I' +
        'DGRUPO)')
    DeleteSQL.Strings = (
      'delete from SELBAIXABENS'
      'where'
      '  IDSELBAIXA = :OLD_IDSELBAIXA and'
      '  IDBEM = :OLD_IDBEM and'
      '  IDPESSOA = :OLD_IDPESSOA')
    Left = 664
  end
