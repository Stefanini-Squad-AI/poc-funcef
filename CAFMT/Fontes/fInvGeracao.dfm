  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update INVENTARIOBENS'
      'set'
      '  IDRESPONSAVEL = :IDRESPONSAVEL,'
      '  DATAINILEVANT = :DATAINILEVANT,'
      '  DATAFIMLEVANT = :DATAFIMLEVANT,'
      '  STATUS = :STATUS'
      'where'
      '  IDINVENTARIOBENS = :OLD_IDINVENTARIOBENS and'
      '  IDEMPRESA = :OLD_IDEMPRESA')
    InsertSQL.Strings = (
      'insert into INVENTARIOBENS'
      
        '  (IDINVENTARIOBENS, IDEMPRESA, IDRESPONSAVEL, DATAINILEVANT, DA' +
        'TAFIMLEVANT, '
      '   STATUS)'
      'values'
      
        '  (:IDINVENTARIOBENS, :IDEMPRESA, :IDRESPONSAVEL, :DATAINILEVANT' +
        ', :DATAFIMLEVANT, '
      '   :STATUS)')
    DeleteSQL.Strings = (
      'delete from INVENTARIOBENS'
      'where'
      '  IDINVENTARIOBENS = :OLD_IDINVENTARIOBENS and'
      '  IDEMPRESA = :OLD_IDEMPRESA')
    Left = 456
    Top = 288
  end
