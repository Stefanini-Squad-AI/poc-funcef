  object qryBensLocal: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT B.IDBEM,'
      '       B.IDPESSOA,'
      '       B.PLACA,'
      '       B.DESBEM,'
      '       B.IDCLASSEBEM,'
      '       C.IDCONJUNTO,'
      '       C.DESCCONJUNTO,'
      '       L.IDLOCALIZACAO,'
      '       L.NOME AS DESCLOCAL,'
      '       CB.CODHIERARQ,'
      '       CB.DESCRICAO AS DESCCLASSE'
      'FROM BEM B,'
      '     CONJUNTO C,'
      '     GRUPO G,'
      '     LOCALIZACAO L ,'
      '     CLASSEDEBEM CB'
      'WHERE (C.IDLOCALIZACAO = :PIDLOCAL)'
      '  AND (C.IDPESSOA      = :PIDEMPRESA)'
      '  AND (G.FLGIMOVEL     = 0)'
      '  AND ((B.BAIXATOTAL <> '#39'S'#39') OR (B.BAIXATOTAL IS NULL))'
      '  AND (B.IDCLASSEBEM   = CB.IDCLASSEBEM(+))'
      '  AND (B.IDGRUPO       = G.IDGRUPO(+))'
      '  AND (B.IDCONJUNTO    = C.IDCONJUNTO)'
      '  AND (C.IDLOCALIZACAO = L.IDLOCALIZACAO)'
      '  AND (C.IDPESSOA      = L.IDPESSOA)'
      'ORDER BY B.PLACA'
      '')
    ValidateWithMask = True
    Left = 128
    Top = 313
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDLOCAL'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'PIDEMPRESA'
        ParamType = ptUnknown
      end>
