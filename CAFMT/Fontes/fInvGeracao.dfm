  object qryLocal: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT L.IDLOCALIZACAO,'
      '       L.IDEMPRESA,'
      '       L.NOME AS DESCLOCALIZACAO,'
      '       L.IDRESPONSAVEL,'
      '       R.NOME AS NOMERESPONSAVEL,'
      '       L.CODCENTROCUSTO,'
      '       L.IDPESSOA,'
      '       CC.NOME AS DESCCCUSTO,'
      '       (0) AS SELECTED'
      'FROM   PESSOA R,'
      '       LOCALIZACAO L,'
      '       CENTCUST CC'
      'WHERE ((L.FLGLOCSAITEMP = 0) OR (L.FLGLOCSAITEMP IS NULL))'
      '  AND (L.IDRESPONSAVEL = R.IDPESSOA)'
      '  AND (L.CODCENTROCUSTO = CC.CODCENTROCUSTO(+))'
      '  AND (L.IDEMPRESA = CC.IDEMPRESA(+))'
      'ORDER BY L.NOME')
    ControlType.Strings = (
