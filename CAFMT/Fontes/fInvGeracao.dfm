  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT IDINVENTARIOBENS,'
      '       IDEMPRESA,'
      '       IDRESPONSAVEL,'
      '       DATAINILEVANT,'
      '       DATAFIMLEVANT,'
      '       STATUS'
      'FROM INVENTARIOBENS'
      'WHERE (IDINVENTARIOBENS = :PIDINVENTARIOBENS)'
      '  AND (IDEMPRESA        = :PIDEMPRESA)'
