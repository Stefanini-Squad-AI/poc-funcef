  object sqlGrupoIni: TCMSqlParams
    SQL.Strings = (
      'SELECT CLASSE, NOME, IDGRUPO'
      'FROM GRUPO'
      'WHERE (TIPO = '#39'A'#39')'
      '  AND (FLGIMOVEL = 0)'
      'ORDER BY CLASSE')
