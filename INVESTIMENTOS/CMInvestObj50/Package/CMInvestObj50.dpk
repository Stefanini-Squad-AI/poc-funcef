package CMInvestObj50;

{$R *.RES}
{$R CMINVESTOBJ50_RES.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM - Componentes e Objetos de Investimentos de Renda Variável'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CmCompo50;

contains
  uCtrlInvest in '..\CtrlObjects\uCtrlInvest.pas',
  UFuncoesInvest in '..\Fontes\UFuncoesInvest.pas';

end.
