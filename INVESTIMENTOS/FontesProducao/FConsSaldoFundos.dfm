      'TIPOFUNDOINVEST.IDTIPOINVEST = HISTFUNDO.IDTIPOINVEST'
      
        'TIPOFUNDOINVEST.IDTIPOFUNDOINVEST = FUNDOINVEST.IDTIPOFUNDOINVES' +
