    Caption = ''
    Colunas.Strings = (
      'HISTFUNDO.DATAMOVFUNDO'
      'VWPLANPREVCTBPATR.PLANPRVCONTABPATRO'
      'TIPOFUNDOINVEST.DESCTIPOFUNDOINV'
