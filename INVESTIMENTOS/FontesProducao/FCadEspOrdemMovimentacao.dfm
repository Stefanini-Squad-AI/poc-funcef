  object UpdAuxiliar: TUpdateSQL
    ModifySQL.Strings = (
      'update ORDMOVINV'
      'set'
      '  IDCORRETVALORES = :IDCORRETVALORES,'
      '  IDINVESTIMENTO = :IDINVESTIMENTO,'
      '  PUORDMOVINV = :PUORDMOVINV,'
      '  QTDEORDMOVINV = :QTDEORDMOVINV,'
