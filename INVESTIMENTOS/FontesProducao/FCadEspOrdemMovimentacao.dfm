      '  DATAAUTORIZACAO = :DATAAUTORIZACAO,'
      '  IDPLANPREVCTBPATR = :IDPLANPREVCTBPATR'
      'where'
      '  NUMDOCMOVINV = :OLD_NUMDOCMOVINV')
    InsertSQL.Strings = (
      'insert into ORDMOVINV'
      
        '  (IDCORRETVALORES, IDINVESTIMENTO, PUORDMOVINV, QTDEORDMOVINV, ' +
        'NUMDOCMOVINV, '
      
        '   STATMOVINV, IDUSUARIO, IDTIPOINVEST, IDTIPOOPERACAO, IDCARTEI' +
        'RAINVEST, '
      
        '   IDCARTEIRAGERENC, IDLOTE, IDBOLSAVALORES, IDCUSTODIANTE, QTDE' +
        'ORDENADA, '
      '   DATAAUTORIZACAO, IDPLANPREVCTBPATR)'
      'values'
      
        '  (:IDCORRETVALORES, :IDINVESTIMENTO, :PUORDMOVINV, :QTDEORDMOVI' +
        'NV, :NUMDOCMOVINV, '
      
        '   :STATMOVINV, :IDUSUARIO, :IDTIPOINVEST, :IDTIPOOPERACAO, :IDC' +
        'ARTEIRAINVEST, '
      
        '   :IDCARTEIRAGERENC, :IDLOTE, :IDBOLSAVALORES, :IDCUSTODIANTE, ' +
        ':QTDEORDENADA, '
      '   :DATAAUTORIZACAO, :IDPLANPREVCTBPATR)')
    DeleteSQL.Strings = (
      'delete from ORDMOVINV'
      'where'
