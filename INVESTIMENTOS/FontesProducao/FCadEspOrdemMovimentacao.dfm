  object QryBuscaOperacao: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT  TP.IDTIPOOPERACAO, TP.SIGLATIPOOPER, TP.NATUREZAOPERACAO' +
        ',TP.TIPOCUSTODIA,'
      
        '        TP.FLGTRATAIR, TP.IDMERCADO, TP.DESCTIPOOPERACAO, TP.VEN' +
        'CIMENTO,PAR.IDTIPOOPERLIQPEND'
      ''
      'FROM TIPOOPERACAO TP, PARAMINVEST PAR'
      ''
      'WHERE'
      '    TP.IDTIPOINVEST = 2   AND'
      '    TP.IDTIPOOPERACAO>0   AND'
      '    ('
      '      (PAR.IDTIPOOPERLIQPEND IS NULL) OR '
      '      (TP.IDTIPOOPERACAO <> PAR.IDTIPOOPERLIQPEND)'
      '    ) AND'
      '    (TP.FLGOPDIREITO<>'#39'S'#39' OR TP.FLGOPDIREITO IS NULL) AND'
      '    (TP.FLGOPGERENC<>'#39'S'#39' OR TP.FLGOPGERENC IS NULL)'
      ''
      'ORDER BY TP.DESCTIPOOPERACAO')
    ValidateWithMask = True
    Left = 681
    Top = 107
