  object QryCorretValores: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT'
      '   CV.IDCORRETVALORES,'
      '   0 AS IDCORRETGERENC,'
      '   CV.SGLCORRETVALORES'
      'FROM'
      '   CORRETVALORES CV, ORDMOVINV ORD'
      'WHERE'
      '    CV.IDCORRETVALORES = ORD.IDCORRETVALORES AND'
      
        '    ORD.DATAORDMOVINV   LIKE  TO_DATE(:DATAORDMOVINV,'#39'DD/MM/YYYY' +
        #39')'
      'ORDER BY SGLCORRETVALORES'
      ''
      '')
    ValidateWithMask = True
    Left = 629
    Top = 8
