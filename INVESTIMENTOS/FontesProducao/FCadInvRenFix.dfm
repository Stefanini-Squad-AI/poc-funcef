  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update INVESTIMENTO'
      'set'
      '  IDEMISSOR = :IDEMISSOR,'
      '  IDTIPOINVEST = :IDTIPOINVEST,'
      '  DESCINVESTIMENTO = :DESCINVESTIMENTO,'
      '  IDCLASSETIT = :IDCLASSETIT,'
      '  FLGATIVO = :FLGATIVO,'
      '  OBSINVESTIMENTO = :OBSINVESTIMENTO,'
      '  DESCCLASSINVEST = :DESCCLASSINVEST,'
      '  CODISIN = :CODISIN,'
      '  CARENCIA = :CARENCIA,'
      '  IDCARTEIRASPC = :IDCARTEIRASPC,'
      '  FLGREPACTUA = :FLGREPACTUA,'
      '  DATAEMISSAO = :DATAEMISSAO,'
      '  PUEMISSAO = :PUEMISSAO,'
      '  TAXAEMISSAO = :TAXAEMISSAO,'
      '  MOEDACALCMKT = :MOEDACALCMKT,'
      '  MOEDATXINDMKT = :MOEDATXINDMKT,'
      '  TAXAJUROSMKT = :TAXAJUROSMKT'
      'where'
      '  IDINVESTIMENTO = :OLD_IDINVESTIMENTO'
      ' ')
    InsertSQL.Strings = (
      'insert into INVESTIMENTO'
      '  (IDINVESTIMENTO, IDEMISSOR, IDTIPOINVEST, DESCINVESTIMENTO, '
      'IDCLASSETIT, '
      
        '   FLGATIVO, OBSINVESTIMENTO, DESCCLASSINVEST, CODISIN, CARENCIA' +
        ', '
      'IDCARTEIRASPC, '
      '   FLGREPACTUA, DATAEMISSAO, PUEMISSAO, TAXAEMISSAO, '
      'MOEDACALCMKT, MOEDATXINDMKT, TAXAJUROSMKT)'
      'values'
      
        '  (:IDINVESTIMENTO, :IDEMISSOR, :IDTIPOINVEST, :DESCINVESTIMENTO' +
        ','
      ':IDCLASSETIT,'
      
        '   :FLGATIVO, :OBSINVESTIMENTO, :DESCCLASSINVEST, :CODISIN, :CAR' +
        'ENCIA,'
      '   :IDCARTEIRASPC, :FLGREPACTUA, :DATAEMISSAO, :PUEMISSAO,'
      ':TAXAEMISSAO,'
      '   :MOEDACALCMKT, :MOEDATXINDMKT, :TAXAJUROSMKT)'
      ' ')
    DeleteSQL.Strings = (
      'delete from INVESTIMENTO'
      'where'
      '  IDINVESTIMENTO = :OLD_IDINVESTIMENTO')
    Left = 314
  end
