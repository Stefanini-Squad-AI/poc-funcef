  inherited qryDetalhe: TwwQuery
    SQL.Strings = (
      'SELECT'
      '   IV.IDINVESTIMENTO,'
      '   IV.IDCURVARENFIX,'
      '   CR.DESCCURVARENFIX,'
      '   IV.FLGCURVACONTABIL,'
      '   IV.FLGTPCURVASWAP,'
      '   IV.FLGCOTRENFIX,'
      '   IV.FLGCORREMISS '
      'FROM'
      '   INVESTXCURVARENFIX IV,'
      '   CURVASRENFIX CR'
      'WHERE'
      '   IV.IDINVESTIMENTO = :IDINVESTIMENTO AND'
      '   IV.IDCURVARENFIX = CR.IDCURVARENFIX'
      'ORDER BY IV.IDINVESTIMENTO, CR.DESCCURVARENFIX      '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ControlType.Strings = (
