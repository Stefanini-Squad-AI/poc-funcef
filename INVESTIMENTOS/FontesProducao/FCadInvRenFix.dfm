  inherited updDetalhe: TUpdateSQL
    ModifySQL.Strings = (
      'update INVESTXCURVARENFIX'
      'set'
      '  FLGCURVACONTABIL = :FLGCURVACONTABIL,'
      '  FLGTPCURVASWAP = :FLGTPCURVASWAP,'
      '  FLGCOTRENFIX = :FLGCOTRENFIX,'
      '  FLGCORREMISS = :FLGCORREMISS'
      'where'
      '  IDINVESTIMENTO = :OLD_IDINVESTIMENTO and'
      '  IDCURVARENFIX = :OLD_IDCURVARENFIX')
    InsertSQL.Strings = (
      'insert into INVESTXCURVARENFIX'
      '  (IDINVESTIMENTO, IDCURVARENFIX, '
      'FLGCURVACONTABIL,FLGTPCURVASWAP,FLGCOTRENFIX,FLGCORREMISS)'
      'values'
      '  (:IDINVESTIMENTO, :IDCURVARENFIX, '
      ':FLGCURVACONTABIL,:FLGTPCURVASWAP,  :FLGCOTRENFIX,:FLGCORREMISS)')
    DeleteSQL.Strings = (
      'delete from INVESTXCURVARENFIX'
      'where'
      '  IDINVESTIMENTO = :OLD_IDINVESTIMENTO and'
      '  IDCURVARENFIX = :OLD_IDCURVARENFIX')
    Left = 218
    Top = 257
  end
