  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update TABCLASSIFINVEST'
      'set'
      '  CODTABCLASSINV = :CODTABCLASSINV,'
      '  DESCTABCLASSINV = :DESCTABCLASSINV'
      'where'
      '  CODTABCLASSINV = :OLD_CODTABCLASSINV  ')
    InsertSQL.Strings = (
      'insert into TABCLASSIFINVEST'
      '  (CODTABCLASSINV, DESCTABCLASSINV)'
      'values'
      '  (:CODTABCLASSINV, :DESCTABCLASSINV)')
    DeleteSQL.Strings = (
      'delete from TABCLASSIFINVEST'
      'where'
      '  CODTABCLASSINV = :OLD_CODTABCLASSINV ')
    Left = 367
    Top = 54
  end
