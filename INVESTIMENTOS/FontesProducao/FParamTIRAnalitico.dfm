  object qryInvestimentos: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT'
      '   IV.IDINVESTIMENTO, IV.DESCINVESTIMENTO, HC.IDLOTE'
      'FROM'
      '   INVESTIMENTO IV, HISTCARTINV HC'
      'WHERE'
      '   (IV.IDINVESTIMENTO = HC.IDINVESTIMENTO) AND'
      
        '   (HC.DATAMOVCARTINV BETWEEN TO_DATE(:DataIni,'#39'DD/MM/YYYY'#39') AND' +
        ' TO_DATE(:DataFim,'#39'DD/MM/YYYY'#39')) AND'
      '   (HC.IDTIPOINVEST = 2) AND'
      
        '   ((:CarteiraInvest IS NULL) OR ((NOT :CarteiraInvest IS NULL) ' +
        'AND (HC.IDCARTEIRAINVEST = :CarteiraInvest)))'
      'ORDER BY DESCINVESTIMENTO'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 280
    Top = 160
    ParamData = <
      item
        DataType = ftString
        Name = 'DataIni'
        ParamType = ptResult
      end
      item
        DataType = ftString
        Name = 'DataFim'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'CarteiraInvest'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'CarteiraInvest'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'CarteiraInvest'
        ParamType = ptResult
      end>
    object qryInvestimentosIDINVESTIMENTO: TFloatField
      FieldName = 'IDINVESTIMENTO'
      Origin = 'BASEDADOS.INVESTIMENTO.IDINVESTIMENTO'
    end
    object qryInvestimentosDESCINVESTIMENTO: TStringField
      FieldName = 'DESCINVESTIMENTO'
      Origin = 'BASEDADOS.INVESTIMENTO.DESCINVESTIMENTO'
      Size = 60
    end
    object qryInvestimentosIDLOTE: TStringField
      FieldName = 'IDLOTE'
      Origin = 'BASEDADOS.HISTCARTINV.IDLOTE'
      Size = 10
    end
  end
