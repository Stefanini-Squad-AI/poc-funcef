  object qryCarteira: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '        IDCARTEIRAiNVEST,'
      '        DESCCARTINVEST'
      'FROM'
      '        CARTEIRAINVEST'
      'WHERE'
      '   IDTIPOINVEST=2'
      'AND IDMERCADO = 1'
      'ORDER BY DESCCARTINVEST')
    ValidateWithMask = True
    Left = 279
    Top = 44
  end
  object QryTipoInvest: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '        IDTIPOINVEST,'
      '        DESCTIPOINVEST'
      'FROM'
      '        TIPOINVEST'
      'WHERE IDTIPOINVEST = 2'
      'ORDER BY IDTIPOINVEST')
    ValidateWithMask = True
    Left = 167
    Top = 44
