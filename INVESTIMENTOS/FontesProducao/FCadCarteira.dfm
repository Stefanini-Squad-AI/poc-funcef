  inherited qry: TwwQuery
    AfterScroll = qryAfterScroll
    SQL.Strings = (
      
        'SELECT CI.IDCARTEIRAINVEST, CI.DESCCARTINVEST,CI.IDGESTORCARTEIR' +
        'A,'
      '       CI.FLGCARTPROP,      CI.FLGCALCDIARIO, CI.DATAINICIO,'
      
        '       CI.FLGTRATALOTE,     CI.IDPLANOPREV,   CI.IDPATROCINADORA' +
        ','
      '       CI.IDTIPOINVEST,     CI.IDMERCADO,     CI.FLGORDMOVINV,'
      '       CI.FLGCARTLASTRO,    CI.FLGCARTTERC,   CI.IDCONSELHINVEST'
      'FROM CARTEIRAINVEST CI'
      'ORDER BY CI.DESCCARTINVEST'
      ' '
      ' '
      ' '
      ' ')
    Left = 386
    Top = 6
