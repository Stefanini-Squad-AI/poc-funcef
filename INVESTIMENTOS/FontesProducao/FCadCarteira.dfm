  object QryGestor: TwwQuery
    DatabaseName = 'basedados'
    SQL.Strings = (
      'SELECT G.IDGESTORCARTEIRA, P.IDPESSOA, P.NOME'
      'FROM   PESSOA P, GESTORCARTEIRA G'
      'WHERE P.IDPESSOA = G.IDGESTORCARTEIRA'
      'ORDER BY P.NOME'
      ' '
      '')
    ValidateWithMask = True
    Left = 693
    Top = 109
  end
