  object QryEnquadramento: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT '#9'CXI.IDINVESTIMENTO, CXI.CODTABCLASSINV, CXI.CODCLASSINVE' +
        'ST, '
      
        #9'CXI.DTENQUADRA,        CXI.IDCARTEIRAINVEST, TCI.DESCTABCLASSIN' +
        'V, '
      
        #9'CAR.DESCCARTINVEST,              CIN.DESCCLASSINVEST           ' +
        '                                       '
      ''
      'FROM '#9'CLASSINVXINVEST CXI, CARTEIRAINVEST CAR, '
      
        #9'TABCLASSIFINVEST TCI,  CLASSIFINVEST CIN                       ' +
        '                            '
      ''
      'WHERE '#9'(1=2) AND '
      #9'(CXI.IDCARTEIRAINVEST = '#39'2'#39') AND       '
      
        #9'(CXI.IDINVESTIMENTO IS NULL)              AND                  ' +
        '             '
      
        #9'(CXI.IDCARTEIRAINVEST = CAR.IDCARTEIRAINVEST) AND              ' +
        '             '
      
        #9'(CXI.CODTABCLASSINV = TCI.CODTABCLASSINV) AND                  ' +
        '             '
      
        #9'(TCI.CODTABCLASSINV = CIN.CODTABCLASSINV) AND                  ' +
        '             '
      #9'(CXI.CODCLASSINVEST = CIN.CODCLASSINVEST)            ')
    UpdateObject = UpdEnquadra
    PictureMasks.Strings = (
      'DTENQUADRA'#9'#[#]/#[#]/##[##]'#9'T'#9'T')
    ValidateWithMask = True
    Left = 281
    Top = 502
    object QryEnquadramentoCODTABCLASSINV: TStringField
      DisplayLabel = 'Tabela'
      DisplayWidth = 42
      FieldName = 'CODTABCLASSINV'
      Size = 10
    end
    object QryEnquadramentoDESCCLASSINVEST: TStringField
      DisplayLabel = 'Classificação '
      DisplayWidth = 35
      FieldName = 'DESCCLASSINVEST'
      Size = 60
    end
    object QryEnquadramentoDTENQUADRA: TDateTimeField
      DisplayLabel = 'Data Inicio'
      DisplayWidth = 12
      FieldName = 'DTENQUADRA'
    end
    object QryEnquadramentoIDINVESTIMENTO: TFloatField
      FieldName = 'IDINVESTIMENTO'
      Visible = False
    end
    object QryEnquadramentoCODCLASSINVEST: TStringField
      FieldName = 'CODCLASSINVEST'
      Visible = False
      Size = 8
    end
    object QryEnquadramentoIDCARTEIRAINVEST: TFloatField
      FieldName = 'IDCARTEIRAINVEST'
      Visible = False
    end
    object QryEnquadramentoDESCTABCLASSINV: TStringField
      FieldName = 'DESCTABCLASSINV'
      Visible = False
      Size = 60
    end
    object QryEnquadramentoDESCCARTINVEST: TStringField
      FieldName = 'DESCCARTINVEST'
      Visible = False
      Size = 60
    end
  end
