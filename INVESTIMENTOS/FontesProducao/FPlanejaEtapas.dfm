  object QryBuscaEtapas: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT  et.SeqContratoInvest, et.IdContratoInvest, ET.IdTipoCont' +
        'rInvest, TE.DescrEtapaContrato'
      'FROM     cm.ETAPACONTRATOINV te, cm.OPERACOESXCONTRATO et'
      'WHERE  et.SEQCONTRATOINVEST = te.SEQCONTRATOINVEST And'
      
        '                et.IDTIPOCONTRINVEST =  te.IDTIPOCONTRINVEST  An' +
        'd'
      '                et.IDCONTRATOINVEST = :IDCONTRATOINVEST'
      'ORDER BY  et.IdTipoContrInvest, et.SeqContratoInvest')
    ControlType.Strings = (
      'STATUSETAPA;CheckBox;D;')
    ValidateWithMask = True
    Left = 269
    Top = 91
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDCONTRATOINVEST'
        ParamType = ptUnknown
      end>
  end
  object DsBuscaEtapas: TwwDataSource
    DataSet = QryBuscaEtapas
    Left = 267
    Top = 51
  end
  object dsEtapaContrato: TwwDataSource
    DataSet = qryEtapaContrato
    Left = 40
    Top = 59
  end
  object UpdateSQL1: TUpdateSQL
    ModifySQL.Strings = (
      'update ETAPAPROCESSO'
      'set'
      '  IDETAPA = :IDETAPA,'
      '  CODPROC = :CODPROC,'
      '  DATAINIETAPAPREV = :DATAINIETAPAPREV,'
      '  DATAFIMETAPAPREV = :DATAFIMETAPAPREV,'
      '  STATUSETAPA = :STATUSETAPA,'
      '  IDTIPOETAPA = :IDTIPOETAPA'
      'where'
      '  IDETAPA = :OLD_IDETAPA and'
      '  CODPROC = :OLD_CODPROC and'
      '  DATAINIETAPAPREV = :OLD_DATAINIETAPAPREV and'
      '  DATAFIMETAPAPREV = :OLD_DATAFIMETAPAPREV and'
      '  STATUSETAPA = :OLD_STATUSETAPA and'
      '  IDTIPOETAPA = :OLD_IDTIPOETAPA')
    InsertSQL.Strings = (
      'insert into ETAPAPROCESSO'
      
        '  (IDETAPA, CODPROC, DATAINIETAPAPREV, DATAFIMETAPAPREV, STATUSE' +
        'TAPA, IDTIPOETAPA)'
      'values'
      
        '  (:IDETAPA, :CODPROC, :DATAINIETAPAPREV, :DATAFIMETAPAPREV, :ST' +
        'ATUSETAPA, '
      '   :IDTIPOETAPA)')
    DeleteSQL.Strings = (
      'delete from ETAPAPROCESSO'
      'where'
      '  IDETAPA = :OLD_IDETAPA and'
      '  CODPROC = :OLD_CODPROC and'
      '  DATAINIETAPAPREV = :OLD_DATAINIETAPAPREV and'
      '  DATAFIMETAPAPREV = :OLD_DATAFIMETAPAPREV and'
      '  STATUSETAPA = :OLD_STATUSETAPA and'
      '  IDTIPOETAPA = :OLD_IDTIPOETAPA')
    Left = 239
    Top = 65531
  end
  object qryEtapaContrato: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select IDTIPOCONTRINVEST,SEQCONTRATOINVEST,IDCONTRATOINVEST,'
      '           DATAOPERPREVISTA'
      'From CM.OPERACOESXCONTRATO'
      'Where SEQCONTRATOINVEST  =  :SEQCONTRATOINVEST  And'
      '           IDTIPOCONTRINVEST =  :IDTIPOCONTRINVEST And'
      '            IDCONTRATOINVEST =  :IDCONTRATOINVEST'
      'Order By SEQCONTRATOINVEST')
    ValidateWithMask = True
    Left = 112
    Top = 56
    ParamData = <
      item
        DataType = ftInteger
        Name = 'SEQCONTRATOINVEST'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDTIPOCONTRINVEST'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDCONTRATOINVEST'
        ParamType = ptUnknown
      end>
  end
end
