  object qryInsOperacaoInvest: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'INSERT INTO OPERACAOINVEST'
      
        '(IDOPERACAOINVEST,MOECODIGO,EMPRESAPROP,IDCARTEIRAINVEST,IDINVES' +
        'TIMENTO,IDTIPOINVEST,'
      
        'IDTIPOOPERACAO,DATAOPERACAO,NUMDOCUMENTO,QTDEOPERACAO,PRECOUNITO' +
        'PERACAO,VLROPERACAO,'
      
        'DATAVENCOPER,IDFORCLI,OBSERVACAO,IDLOTE,IDPLANPREVCTBPATR,IDCUST' +
        'ODIANTE)'
      'VALUES'
      
        '(:IDOPERACAOINVEST,:MOECODIGO,:EMPRESAPROP,:IDCARTEIRAINVEST,:ID' +
        'INVESTIMENTO,:IDTIPOINVEST,'
      
        ':IDTIPOOPERACAO,:DATAOPERACAO,:NUMDOCUMENTO,:QTDEOPERACAO,:PRECO' +
        'UNITOPERACAO,:VLROPERACAO,'
      
        ':DATAVENCOPER,:IDFORCLI,:OBSERVACAO,:IDLOTE,:IDPLANPREVCTBPATR,:' +
        'IDCUSTODIANTE)'
      ''
      ' ')
    ValidateWithMask = True
    Left = 243
    Top = 184
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDOPERACAOINVEST'
        ParamType = ptUnknown
      end
