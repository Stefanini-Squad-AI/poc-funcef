  object qryBuscaLote: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDLOTE,IDPLANPREVCTBPATR,DATAMOVCARTINV '
      'FROM'
      '  CM.HISTCARTINV'
      'WHERE'
      '   IDINVESTIMENTO = :IDINVESTIMENTO'
      '   AND DATAMOVCARTINV = (SELECT MAX(DATAMOVCARTINV)'
      '                         FROM HISTCARTINV'
      
        '                         WHERE (IDINVESTIMENTO = :IDINVESTIMENTO' +
        ')'
      
        '                         AND (DATAMOVCARTINV <= TO_DATE(:DATAREF' +
        ','#39'DD/MM/YYYY'#39')))')
    ValidateWithMask = True
    Left = 243
    Top = 233
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDINVESTIMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDINVESTIMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'DATAREF'
        ParamType = ptUnknown
      end>
    object qryBuscaLoteIDLOTE: TStringField
      FieldName = 'IDLOTE'
      Size = 10
    end
    object qryBuscaLoteIDPLANPREVCTBPATR: TFloatField
      FieldName = 'IDPLANPREVCTBPATR'
    end
    object qryBuscaLoteDATAMOVCARTINV: TDateTimeField
      FieldName = 'DATAMOVCARTINV'
    end
  end
