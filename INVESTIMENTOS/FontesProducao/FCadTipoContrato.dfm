  object QryTipoOperacao: TwwQuery
    DatabaseName = 'BaseDados'
    DataSource = ds
    SQL.Strings = (
      'SELECT '#9'T.IDTIPOOPERACAO, T.IDTIPOINVEST, T.IDMERCADO, '
      '                T.DESCTIPOOPERACAO,  M.DESCMERCADO'
      ''
      'FROM   '#9'TIPOOPERACAO T, MERCADO M'
      ''
      'WHERE  '#9'T.IDMERCADO = M.IDMERCADO(+) AND '
      #9'T.IDTIPOINVEST = :IDTIPOINVEST AND'
      #9'T.IDTIPOOPERACAO > 0 '
      ''
      'ORDER BY T.DESCTIPOOPERACAO')
    ValidateWithMask = True
    Left = 35
    Top = 254
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDTIPOINVEST'
        ParamType = ptUnknown
      end>
  end
