  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update INVESTIMENTO'
      'set'
      '  DESCINVESTIMENTO = :DESCINVESTIMENTO,'
      '  IDTIPOINVEST = :IDTIPOINVEST,'
      '  FLGATIVO = :FLGATIVO,'
      '  STAOPCAO = :STAOPCAO,'
      '  IDCARTEIRASPC = :IDCARTEIRASPC'
      'where'
      '  IDINVESTIMENTO = :OLD_IDINVESTIMENTO')
    InsertSQL.Strings = (
      'insert into INVESTIMENTO'
      '  (DESCINVESTIMENTO, IDINVESTIMENTO, IDTIPOINVEST, FLGATIVO, '
      'STAOPCAO,IDCARTEIRASPC)'
      'values'
      
        '  (:DESCINVESTIMENTO, :IDINVESTIMENTO, :IDTIPOINVEST, :FLGATIVO,' +
        ' '
      ':STAOPCAO,:IDCARTEIRASPC)')
    DeleteSQL.Strings = (
      'delete from INVESTIMENTO'
      'where'
      '  IDINVESTIMENTO = :OLD_IDINVESTIMENTO')
    Left = 258
  end
