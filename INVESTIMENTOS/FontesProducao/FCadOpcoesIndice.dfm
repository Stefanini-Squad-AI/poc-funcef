  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT I.DESCINVESTIMENTO, I.IDINVESTIMENTO,'
      '   I.IDTIPOINVEST, I.FLGATIVO, I.STAOPCAO, I.IDCARTEIRASPC'
      'FROM   OPCOES O, INVESTIMENTO I'
      'WHERE  O.IDINVESTIMENTO = I.IDINVESTIMENTO'
      '   AND O.IDTIPOOPCAO = 1'
      '   AND O.IDOPCAO = :IDOPCAO'
      ' '
      ' ')
    Left = 230
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDOPCAO'
        ParamType = ptResult
      end>
    object qryIDINVESTIMENTO: TFloatField
      FieldName = 'IDINVESTIMENTO'
      Origin = 'BASEDADOS.INVESTIMENTO.IDINVESTIMENTO'
    end
    object qryDESCINVESTIMENTO: TStringField
      FieldName = 'DESCINVESTIMENTO'
      Origin = 'BASEDADOS.INVESTIMENTO.DESCINVESTIMENTO'
      Size = 60
    end
    object qryIDTIPOINVEST: TFloatField
      FieldName = 'IDTIPOINVEST'
      Origin = 'BASEDADOS.INVESTIMENTO.IDTIPOINVEST'
    end
    object qryFLGATIVO: TStringField
      FieldName = 'FLGATIVO'
      Origin = 'BASEDADOS.INVESTIMENTO.FLGATIVO'
      FixedChar = True
      Size = 1
    end
    object qrySTAOPCAO: TStringField
      FieldName = 'STAOPCAO'
      Origin = 'BASEDADOS.INVESTIMENTO.STAOPCAO'
      FixedChar = True
      Size = 1
    end
    object qryIDCARTEIRASPC: TFloatField
      FieldName = 'IDCARTEIRASPC'
      Origin = 'BASEDADOS.INVESTIMENTO.IDCARTEIRASPC'
    end
  end
  object qryOpcoes: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT O.IDOPCAO, O.IDINVESTIMENTO, O.DTAVENCTO, O.VLRPRECOEX, O' +
        '.VLRSTRIKEPUT,'
      
        '       O.VLRPONTO, O.STATPAMERICANA, O.STAOPCCOMPRA, O.TIPCOTVEN' +
        'C, O.IDTIPOOPCAO'
      'FROM   OPCOES O'
      'WHERE  O.IDTIPOOPCAO = 1'
      '   AND O.IDOPCAO = :IDOPCAO')
    UpdateObject = updOpcoes
    ValidateWithMask = True
    Left = 344
    Top = 54
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDOPCAO'
        ParamType = ptInputOutput
      end>
    object qryOpcoesIDOPCAO: TFloatField
      FieldName = 'IDOPCAO'
      Origin = 'BASEDADOS.OPCOES.IDOPCAO'
    end
    object qryOpcoesIDINVESTIMENTO: TFloatField
      FieldName = 'IDINVESTIMENTO'
      Origin = 'BASEDADOS.OPCOES.IDINVESTIMENTO'
    end
    object qryOpcoesDTAVENCTO: TDateTimeField
      FieldName = 'DTAVENCTO'
      Origin = 'BASEDADOS.OPCOES.DTAVENCTO'
    end
    object qryOpcoesVLRPRECOEX: TFloatField
      FieldName = 'VLRPRECOEX'
      Origin = 'BASEDADOS.OPCOES.VLRPRECOEX'
    end
    object qryOpcoesVLRSTRIKEPUT: TFloatField
      FieldName = 'VLRSTRIKEPUT'
      Origin = 'BASEDADOS.OPCOES.VLRSTRIKEPUT'
    end
    object qryOpcoesVLRPONTO: TFloatField
      FieldName = 'VLRPONTO'
      Origin = 'BASEDADOS.OPCOES.VLRPONTO'
    end
    object qryOpcoesSTATPAMERICANA: TStringField
      FieldName = 'STATPAMERICANA'
      Origin = 'BASEDADOS.OPCOES.STATPAMERICANA'
      FixedChar = True
      Size = 1
    end
    object qryOpcoesSTAOPCCOMPRA: TStringField
      FieldName = 'STAOPCCOMPRA'
      Origin = 'BASEDADOS.OPCOES.STAOPCCOMPRA'
      FixedChar = True
      Size = 1
    end
    object qryOpcoesTIPCOTVENC: TStringField
      FieldName = 'TIPCOTVENC'
      Origin = 'BASEDADOS.OPCOES.TIPCOTVENC'
      FixedChar = True
      Size = 1
