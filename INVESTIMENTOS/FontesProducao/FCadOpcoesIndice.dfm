  object dsOpcoes: TwwDataSource
    DataSet = qryOpcoes
    Left = 400
    Top = 54
  end
  object updOpcoes: TUpdateSQL
    ModifySQL.Strings = (
      'update OPCOES'
      'set'
      '  DTAVENCTO = :DTAVENCTO,'
      '  VLRPRECOEX = :VLRPRECOEX,'
      '  STATPAMERICANA = :STATPAMERICANA,'
      '  STAOPCCOMPRA = :STAOPCCOMPRA,'
      '  IDTIPOOPCAO = :IDTIPOOPCAO,'
      '  TIPCOTVENC = :TIPCOTVENC,'
      '  VLRSTRIKEPUT = :VLRSTRIKEPUT,'
      '  VLRPONTO = :VLRPONTO'
      'where'
      '  IDOPCAO = :OLD_IDOPCAO')
    InsertSQL.Strings = (
      'insert into OPCOES'
      '  (IDOPCAO, IDINVESTIMENTO, DTAVENCTO, VLRPRECOEX,    '
      '   STATPAMERICANA, STAOPCCOMPRA, IDTIPOOPCAO, TIPCOTVENC, '
      '   VLRSTRIKEPUT, VLRPONTO)'
      'values'
      '  (:IDOPCAO, :IDINVESTIMENTO, :DTAVENCTO, :VLRPRECOEX,       '
      
        '   :STATPAMERICANA, :STAOPCCOMPRA, :IDTIPOOPCAO, :TIPCOTVENC,   ' +
        ' '
      '   :VLRSTRIKEPUT, :VLRPONTO)')
    DeleteSQL.Strings = (
      'delete from OPCOES'
      'where'
      '  IDOPCAO = :OLD_IDOPCAO')
    Left = 372
    Top = 54
  end
  object qryCarteiraSPC: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDCARTEIRASPC, DESCARTEIRASPC'
      'FROM CARTEIRASPC'
      'ORDER BY DESCARTEIRASPC')
