  object QryInsOperacaoInvest: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'INSERT INTO OPERACAOINVEST'
      
        '(IDOPERACAOINVEST,  IDCORRETVALORES,  MOECODIGO,        IDMODULO' +
        ','
      
        'EMPRESAPROP,       IDINVESTIMENTO,   IDCARTEIRAINVEST, IDCARTEIR' +
        'AGERENC,'
      
        'IDTIPOINVEST,      IDTIPOOPERACAO,    DATAOPERACAO,     NUMDOCUM' +
        'ENTO,     QTDEOPERACAO,'
      'PRECOUNITOPERACAO, VLROPERACAO,      DATAVENCOPER,     IDFORCLI,'
      
        'IDLOTE,            IDCUSTODIANTE,    VLRIR,            FLGSTATUS' +
        'FECHBOL,'
      'FLGSTATUSORDMOV,   IDPLANPREVCTBPATR)'
      'VALUES'
      
        '(:IDOPERACAOINVEST,  :IDCORRETVALORES,   :MOECODIGO,        :IDM' +
        'ODULO,'
      
        ' :EMPRESAPROP,       :IDINVESTIMENTO,    :IDCARTEIRAINVEST, :IDC' +
        'ARTEIRAGERENC,'
      
        ' :IDTIPOINVEST,      :IDTIPOOPERACAO,    :DATAOPERACAO,     :NUM' +
        'DOCUMENTO,'
      
        ' :QTDEOPERACAO,      :PRECOUNITOPERACAO, :VLROPERACAO,      :DAT' +
        'AVENCOPER,'
      
