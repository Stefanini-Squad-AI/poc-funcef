  object qryBuscaOperacoes: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT  OPE.IDOPERACAOINVEST, OPE.IDCUSTODIANTE, OPE.IDCORRETVAL' +
        'ORES,'
      
        #9'OPE.MOECODIGO, OPE.IDMODULO, OPE.EMPRESAPROP, OPE.IDINVESTDEST,' +
        ' OPE.IDCARTEIRAINVEST,'
      
        '        OPE.IDCARTEIRAGERENC, OPE.IDINVESTIMENTO, OPE.IDTIPOINVE' +
        'ST, OPE.IDTIPOOPERACAO,'
      
        '        OPE.IDINSTFIN, OPE.DATAOPERACAO, OPE.NUMDOCUMENTO, OPE.Q' +
        'TDEOPERACAO, OPE.PRECOUNITOPERACAO,'
      
        '        OPE.VLROPERACAO, OPE.DATAVENCOPER, OPE.VLROPERACAOOM, OP' +
        'E.IDFORCLI, OPE.IDCARTORIDEST,'
      
        #9'OPE.IDLOTE, OPE.INVORIGEM, OPE.IDCUSTORIG, OPE.IDCUSTDEST, OPE.' +
        'FLGSTATUSFECHBOL,'
      
        '        OPE.FLGSTATUSORDMOV, OPE.IDTERCEIRO, OPE.DATALIQOPER, OP' +
        'E.VLRIR, INV.IDEMISSOR,'
      
        '        INV.DESCINVESTIMENTO, CA.FLGCARTPROP, BOL.IDBOLSAVALORES' +
        ', BOL.SGLBOLSAVALORES,'
      '        AXB.QTDELOTE, OPE.IDPLANPREVCTBPATR'
      
        'FROM OPERACAOINVEST OPE, INVESTIMENTO INV, CARTEIRAINVEST CA, AC' +
        'AO ACA, ACOESXBOLSA AXB,'
      '        OPRACAO OPA, BOLSAVALORES BOL'
      'WHERE OPE.NUMDOCUMENTO = :BOLETA AND'
      '               OPE.IDOPERACAOINVEST = OPA.IDOPERACAOINVEST AND'
      '               OPE.IDINVESTIMENTO = INV.IDINVESTIMENTO     AND'
      '               OPE.IDCARTEIRAINVEST = CA.IDCARTEIRAINVEST  AND'
      '               AXB.IDACAO = INV.IDINVESTIMENTO             AND'
      '               AXB.IDACAO = ACA.IDACAO '#9'                   AND'
      '               AXB.IDBOLSAVALORES = OPA.IDBOLSAVALORES     AND'
      '               OPA.IDBOLSAVALORES = BOL.IDBOLSAVALORES'
      'ORDER BY IDCARTEIRAINVEST, IDCARTEIRAGERENC DESC'
      ' ')
    UpdateObject = UpdBuscaOperacoes
    ValidateWithMask = True
    Left = 141
    Top = 95
    ParamData = <
      item
        DataType = ftString
        Name = 'BOLETA'
        ParamType = ptUnknown
      end>
