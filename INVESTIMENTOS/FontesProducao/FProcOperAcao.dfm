  object QryBuscaTipoOper: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT IDTIPOINVEST, IDTIPOOPERACAO, IDMERCADO,   DESCTIPOOPERAC' +
        'AO,'
      
        '      TIPOCUSTODIA, VENCIMENTO,     TIPCREDOR,   NATUREZAOPERACA' +
        'O,'
      
        '      FLGTRANSF, FLGCORRET, FLGORDMOVINV, FLGTRATAIR,RECPAG , FL' +
        'GCONTAINVEST'
      'FROM TIPOOPERACAO'
      'WHERE IDTIPOOPERACAO = :TIPOOPERACAO'
      '')
    ValidateWithMask = True
