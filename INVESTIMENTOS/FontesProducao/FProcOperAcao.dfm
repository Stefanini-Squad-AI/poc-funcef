  object QryBuscaBoletas: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT NUMDOCUMENTO, DATAOPERACAO'
      'FROM OPERACAOINVEST '
      'WHERE FLGSTATUSFECHBOL = '#39'L'#39' AND '
      '      IDTIPOINVEST=2         AND '
      '      DATAOPERACAO = :DATAREF ')
    ValidateWithMask = True
    Left = 33
    Top = 109
    ParamData = <
      item
        DataType = ftDate
        Name = 'DATAREF'
        ParamType = ptUnknown
      end>
