  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT UT.IDUSUARIO,'
      '       US.NOMEUSUARIO,'
      '       UT.IDTIPOINVEST,'
      '       TI.DESCTIPOINVEST,'
      '       UT.TIPOMENU,'
      '       UT.IDPLANPREVCTBPATR'
      ''
      'FROM USUARIOTIPOMENU UT,'
      '           USUARIOSISTEMA US,'
      '           TIPOINVEST TI'
      ''
      'WHERE (UT.IDUSUARIO = :IDUSUARIO)      AND'
      '      (UT.IDUSUARIO = US.IDUSUARIO(+)) AND'
      '      (UT.IDTIPOINVEST = TI.IDTIPOINVEST(+))'
      '      '
      'ORDER BY US.NOMEUSUARIO'
      ' '
      ' ')
    Left = 298
    Top = 5
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDUSUARIO'
        ParamType = ptResult
        Value = 255
      end>
    object qryIDUSUARIO: TFloatField
      FieldName = 'IDUSUARIO'
    end
    object qryNOMEUSUARIO: TStringField
      DisplayLabel = 'Nome do Usuário'
      FieldName = 'NOMEUSUARIO'
      FixedChar = True
    end
    object qryIDTIPOINVEST: TFloatField
      FieldName = 'IDTIPOINVEST'
    end
    object qryDESCTIPOINVEST: TStringField
      DisplayLabel = 'Tipo de Investimento'
      FieldName = 'DESCTIPOINVEST'
      Size = 60
    end
    object qryTIPOMENU: TStringField
      DisplayLabel = 'Menu Selecionado'
      FieldName = 'TIPOMENU'
      FixedChar = True
      Size = 1
    end
    object qryIDPLANPREVCTBPATR: TFloatField
      FieldName = 'IDPLANPREVCTBPATR'
    end
  end
