  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update USUARIOTIPOMENU'
      'set'
      '  IDUSUARIO = :IDUSUARIO,'
      '  IDTIPOINVEST = :IDTIPOINVEST,'
      '  TIPOMENU = :TIPOMENU,'
      '  IDPLANPREVCTBPATR = :IDPLANPREVCTBPATR'
      'where'
      '  IDUSUARIO = :OLD_IDUSUARIO')
    InsertSQL.Strings = (
      'insert into USUARIOTIPOMENU'
      '  (IDUSUARIO, IDTIPOINVEST, TIPOMENU, IDPLANPREVCTBPATR)'
      'values'
      '  (:IDUSUARIO, :IDTIPOINVEST, :TIPOMENU, :IDPLANPREVCTBPATR)')
    DeleteSQL.Strings = (
      'delete from USUARIOTIPOMENU'
      'where'
      '  IDUSUARIO = :OLD_IDUSUARIO')
    Left = 354
    Top = 5
  end
