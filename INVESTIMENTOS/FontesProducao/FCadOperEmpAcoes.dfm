  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT'
      '   OP.IDOPEREMPACOES,'
      '   OP.IDCUSTODIANTE,'
      '   OP.IDCARTEIRAINVEST,'
      '   OP.IDINVESTIMENTO,'
      '   OP.IDTIPOINVEST,'
      '   OP.IDTIPOOPERACAO,'
      '   OP.DATAOPERACAO,'
      '   OP.DATAVENCOPER,'
      '   OP.VLROPERACAO,'
      '   OP.QTDOPERACAO,'
      '   OP.PUOPERACAO,'
      '   OP.TAXAOPERACAO,'
      '   OP.VLRIR,'
      '   OP.FLGREVERSAO,'
      '   OP.FLGPRECO,'
      '   OP.IDOPEREMPACOESAP,'
      '   OP.VLRRESGATE,'
      '   OP.VLRJUROS,'
      '   OP.TIPOCONFIRMADO,'
      '   0 AS VLRRESGATEATU,'
      '   VLRRESGATE-VLROPERACAO AS VALOREMPRESTIMO,'
      '   IV.DESCINVESTIMENTO,'
      '   TP.DESCTIPOOPERACAO,'
      '   OP.PLNCODIGO,'
      '   OP.CODDOCUMENTO'
      'FROM'
      '   OPEREMPACOES OP, INVESTIMENTO IV, TIPOOPERACAO TP'
      'WHERE'
      '   IDOPEREMPACOES = :IDOPEREMPACOES'
      '   AND OP.IDINVESTIMENTO = IV.IDINVESTIMENTO'
      '   AND OP.IDTIPOOPERACAO = TP.IDTIPOOPERACAO'
      ' '
      ' '
      ' '
      ' '
      ' ')
    Left = 538
    Top = 57
