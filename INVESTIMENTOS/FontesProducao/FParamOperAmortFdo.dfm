  object qryFundoInvest: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   FUN.IDFUNDOINVEST, FUN.DESCFUNDOINVEST'
      'FROM'
      '   FUNDOINVEST FUN, TIPOFUNDOINVEST TPF'
      'WHERE'
      
        '   ((:IDTIPOFUNDOINVEST IS NULL) OR (FUN.IDTIPOFUNDOINVEST = :ID' +
        'TIPOFUNDOINVEST)) AND'
      '   FUN.IDTIPOFUNDOINVEST = TPF.IDTIPOFUNDOINVEST'
      'ORDER BY'
      '  FUN.DESCFUNDOINVEST'
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 183
    Top = 56
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDTIPOFUNDOINVEST'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDTIPOFUNDOINVEST'
        ParamType = ptUnknown
      end>
