   //IDTIPOINVEST, IDTIPOOPERACAO, IDMERCADO, CODTIPDOC, DESCTIPOOPERACAO                                             , NATUREZAOPERACAO, TIPOCUSTODIA, VENCIMENTO, FLGGERACONTAB, FLGGERACAPCAR, RECPAG, TIPCREDOR, FLGGERACAF, FLGTRANSF, FLGCORRET, FLGORDMOVINV, IDMOTIVOBLOQUEIO, FLGOPDIREITO, FLGAGE, FLGDATAEX, FLGDATACOM, FLGINVORIGEM, FLGPERC, FLGPARIDADE, FLGPRZBOLSA, FLGPRZEMP, FLGATADEC, FLGFORMAPAGREC, FLGDIVACAO, FLGINIPAG, FLGJUROS, MOTBLOQCARTORIG, MOTBLOQCARTDEST, TIPSALDOCARTORIG, TIPSALDOCARTDEST, FLGTRATAIR, SIGLATIPOOPER, FLGISENTOIR, FLGGRAVAIRLITIGIO, FLGOPGERENC, TIPOMOVTO, STAATIVO, FLGRENTABILIDADE, FLGMOVCOTA, FLGCONTAINVEST, FLGCOTARECDES, FLGDATAVENCIMENTO, FLGOBRIGAOBS


Begin
   {  ---- ATENÇÃO  -----------------------------------------------------------------------
      TODOS OS PARAMETROS DA QUERY DEVEM ESTAR NA MESMA ORDEM DOS CONTEUDOS DO VETOR

      * O CAMPO CODTIPDOC DEVERÁ SER PREENCHIDO PELO FORM DE ACORDO COM O TIPO CADASTRADO
        PELO USUÁRIO
      ------------------------------------------------------------------------------------}
   Try
      For i := 1 To Length(aTipoper) Do
         Begin

            If Not (dtmBaseDados.dbBaseDados.InTransaction) Then
               DtmBaseDados.dbBaseDados.StartTransaction;

            // Monta Parâmetros
            OperComum.LimpaParametros(qryInsTipoOperacao, True);
            For j := 0 To Length(aTipoper[i]) - 1 Do
               Begin
                  sValor := LeValorArray(aTipoper[i, j]);
                  If sValor = '' Then
                     qryInsTipoOperacao.Params[j].Clear
                  Else
                     Begin
                        If aTipDado[j] = 'S' Then
                           qryInsTipoOperacao.Params[j].AsString := Trim(sValor)
                        Else If aTipDado[j] = 'N' Then
                           qryInsTipoOperacao.Params[j].AsInteger := StrToInt(Trim(sValor))
                        Else If aTipDado[j] = 'D' Then
                           qryInsTipoOperacao.Params[j].AsDateTime := StrToDateTime(Trim(sValor));
                     End;
               End;

            Try
               // Insere Tipo de Operação
               qryInsTipoOperacao.ExecSQL;
               dtmBaseDados.dbBaseDados.Commit;
            Except
               dtmBaseDados.dbBaseDados.RollBack;
            End;
         End;
      Result := True;
   Except
      On E: Exception Do
         Begin
            // AL_52
            Result := False;
            If dtmBaseDados.dbBaseDados.InTransaction Then
               dtmBaseDados.dbBaseDados.Rollback;
            MsgDlg('Erro na inclusão automática de Tipos de Operação:' + #13 +
               E.Message + #13 +
               'Operação ' + aTipoper[i, 1] + ' - ' + aTipoper[i, 4], 'Mensagem do Sistema ', mtError, [mbOK], 0);
         End;
   End;
End;

Function TFrmPrincipal.LeValorArray(sValor: String; sValDefault: String = ''): String;
Begin
   If (Trim(sValor) = '') And (Trim(sValDefault) <> '') Then
      Result := sValDefault
   Else If Trim(sValor) = '' Then
      Result := ''
   Else Result := sValor;
End;

