Procedure TFrmPrincipal.HabilitaMenus;
Var
   i, j, k, l, m: integer;
   SubMenu1, SubMenu2, SubMenu3, SubMenu4: TMenuItem;
Begin
   //Al_49 -
   //Desabilitado por ter ser substituido pelo o de Sbscrição de cotas
   mnuFluxoSubsCotasAcoes.Visible := False;
   mnuFluxoCotasIntegralizar.Visible := False;
   mnuFluxoCotaIntegrDirCred.Visible := False;
   //Desabilitado pelo RendaFixa Novo
   mnuLancamentos.Visible := False;

   // Provisoriamente habilita/desabilita itens do menu
   // ------------------------------------------------------------
   mnuMarcaDesmarcaRF.Enabled := True;

   // ------------------------------------------------------------
   // Fim da habilitação/desabilitação temporária de itens do menu

   // Menus de Fundos
   mnuAcoesFundos.Enabled := False;
   mnuItmFundoImobiliario.Enabled := False;
   MnuDireitoCreditorio.Enabled := False;
   //AL_45 Ini
   mnuConsFdoRendaFixa.Enabled := False;
   mnuConsFdoAcoes.Enabled := False;
   mnuConsFdoImobiliario.Enabled := False;
   mnuConsFdoDirCred.Enabled := False;
   If iTipoInvestUsu = 5 Then // Fundo de Renda Fixa
      mnuConsFdoRendaFixa.Enabled := True
   Else If iTipoInvestUsu = 6 Then // Fundo de Renda Variavel
      Begin
         mnuAcoesFundos.Enabled := True;
         mnuConsFdoAcoes.Enabled := True;
      End
   Else If iTipoInvestUsu = 7 Then // Fundo Imobiliario
      Begin
         mnuItmFundoImobiliario.Enabled := True;
         mnuConsFdoImobiliario.Enabled := True;
      End
   Else If iTipoInvestUsu = 9 Then // Fundo Direito Creditório
      Begin
         MnuDireitoCreditorio.Enabled := True;
         mnuConsFdoDirCred.Enabled := True;
      End;
   //Ricardo Cristiano - 11/08/2008 - N. Sol 92822 -  N. Kintana 389089 - RETIRAR APOS HABILITAR O MENU
   MnuParamCotacaoRV.Enabled := True;
   //Ricardo Cristiano - 29/01/2010 - N. Sol 129885 -  N. Kintana 717793
   mnuResAnucProvEstr.Enabled := True;
   //Ricardo Cristiano - 05/02/2010 - N. Sol 130405 -  N. Kintana 732748
   MnuCancelSubsCotaEstru.Enabled := True;
   //Renan 17/08/2010 - Sol. 127135 - Kintana 694808
   mnuLogCustdia.Enabled := True;
   //Ricardo Cristiano - 24/02/2011 - N. Sol 84432 -  N. Kintana 523253
   mnuContratosLiquidados.Enabled := True;
   //Paulo Nobre 05/07/2011 - SOL 160038 - Kintana 1331763
   mnuPosicaoJurosAberto.Enabled := True;
End;

