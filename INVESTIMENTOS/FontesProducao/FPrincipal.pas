      ('INVEST', 'INV_RENDIMEN'),
      ('INVEST', 'INV_IRPROVRE'),
      ('INVEST', 'INV_VLRAGIO'),
      ('INVEST', 'INV_VLRDESAG'),
      ('INVEST', 'INV_PUMERCCP'));

Begin
   {   ---- ATENÇÃO  ----
       TODOS OS PARAMETROS DA QUERY DEVEM ESTAR NA MESMA ORDEM DOS CONTEUDOS DO VETOR
       SOMENTE O QUINTO PARAMETRO NÃO ESTÁ NA QUERY POIS É IGUAL AO PRIMEIRO
   }
   Try

      For i := 1 To Length(aItens) Do
         Begin

            If Not (dtmBaseDados.dbBaseDados.InTransaction) Then
               DtmBaseDados.dbBaseDados.StartTransaction;

            // Insere Item de Renda Fixa
            OperComum.LimpaParametros(qryInsItemRenFix, True);
            For j := 0 To Length(aItens[i]) - 1 Do
               qryInsItemRenFix.Params[j].AsString := aItens[i, j];

            Try
               qryInsItemRenFix.ExecSQL;
            Except
            End;

            If qryInsItemRenFix.RowsAffected > 0 Then
               Begin
                  // Insere Campo do Regra
                  OperComum.LimpaParametros(qryInsCMPBD, True);
                  For j := 0 To Length(aCmPbd[i]) - 1 Do
                     qryInsCMPBD.Params[j].AsString := aCmPbd[i, j];

                  Try
                     qryInsCMPBD.ExecSQL;
                  Except
                  End;

                  OperComum.LimpaParametros(qryInsCMPBDGRP, True);
                  For j := 0 To Length(aCmPbdGrp[i]) - 1 Do
                     qryInsCMPBDGRP.Params[j].AsString := aCmPbdGrp[i, j];

                  Try
                     qryInsCMPBDGRP.ExecSQL;
                  Except
                  End;

               End;
            dtmBaseDados.dbBaseDados.Commit;
         End;
      Result := True;
   Except
      On E: Exception Do
         Begin
            // AL_52
            Result := False;
            If dtmBaseDados.dbBaseDados.InTransaction Then
               dtmBaseDados.dbBaseDados.Rollback;

            MsgDlg('Erro na inclusão automática de Items de Renda Fixa:' + #13 +
               E.Message + #13 +
               'Item ' + aItens[i, 1], 'Mensagem do Sistema ', mtError, [mbOK], 0);
         End;
   End;
End;

