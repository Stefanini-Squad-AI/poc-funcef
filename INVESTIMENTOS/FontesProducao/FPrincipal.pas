// AL_79 - Geral para todos os relatórios em 3 camadas

Procedure TFrmPrincipal.AppPadraoPrintReportPadrao(sender: TObject; IdReports: Integer; sFileName: String; Var Printed: Boolean);
Var rptInvestimento: TCtrlRelatorios;
Begin
   Inherited;
   Try
      rptInvestimento := TCtrlRelatorios.Create;

      Printed := ShowReport(IdReports, rptInvestimento);
      rptInvestimento.Free;
   Except
      On E: Exception Do
         Begin
            rptInvestimento.Free;
            If (UpperCase(E.Message) <> 'OPERATION ABORTED') Then
               Raise
            Else
               Abort;
         End;
   End;
End;

