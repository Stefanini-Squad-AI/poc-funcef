  inherited qry: TwwQuery
    Tag = 5
    SQL.Strings = (
      'SELECT IDEVENTOCAIXACOTA,'
      '       DESCCAIXACOTA,'
      '       IDTIPOINVEST,'
      '       IDTIPOOPERACAO,'
      '       IDTIPODESPINVEST,'
      
        '       DECODE(NVL(IDTIPOOPERACAO,0),0,IDTIPODESPINVEST||10||IDTI' +
        'POINVEST,IDTIPOOPERACAO||1000||IDTIPOINVEST) AS IDOPERACAO,'
      '       STACAIXA,'
      '       STACOTA,'
      '       STAATIVOPASSIVO,'
      '       STACOTIZA,'
      '       STASOMADIMINUI,'
      '       IDREGRA,'
      '       STACPMF'
      'FROM  EVENTOCAIXACOTA'
      'WHERE IDEVENTOCAIXACOTA = :IDEVENTOCAIXACOTA'
      'ORDER BY DESCCAIXACOTA'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    Left = 194
    Top = 94
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDEVENTOCAIXACOTA'
        ParamType = ptResult
      end>
