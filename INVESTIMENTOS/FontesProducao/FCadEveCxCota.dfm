  object qryTipoOperacao: TwwQuery
    Tag = 5
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DESCTIPOOPERACAO,'
      
        '       DECODE(NVL(IDTIPOOPERACAO,0),0,IDTIPODESPINVEST||10||IDTI' +
        'POINVEST,IDTIPOOPERACAO||1000||IDTIPOINVEST) AS IDOPERACAO,'
      '       IDTIPOOPERACAO, IDTIPODESPINVEST, IDTIPOINVEST'
      'FROM'
      '  (SELECT'
      
        '      DESCTIPOOPERACAO, IDTIPOOPERACAO, 0 AS IDTIPODESPINVEST, I' +
        'DTIPOINVEST'
      '   FROM'
      '      TIPOOPERACAO'
      '   UNION'
      '   SELECT'
      
        '      DESCTIPODESPINV AS DESCTIPOOPERACAO, 0 AS IDTIPOOPERACAO, ' +
        'IDTIPODESPINVEST, 2 AS IDTIPOINVEST'
      '   FROM  TIPODESPINVEST )'
      'ORDER BY DESCTIPOOPERACAO'
      ' ')
    ValidateWithMask = True
    Left = 385
    Top = 116
