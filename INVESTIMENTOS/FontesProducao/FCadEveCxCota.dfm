  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update EVENTOCAIXACOTA'
      'set'
      '  DESCCAIXACOTA = :DESCCAIXACOTA,'
      '  IDTIPOINVEST = :IDTIPOINVEST,'
      '  IDTIPOOPERACAO = :IDTIPOOPERACAO,'
      '  IDTIPODESPINVEST = :IDTIPODESPINVEST,'
      '  STACAIXA = :STACAIXA,'
      '  STACOTA = :STACOTA,'
      '  STAATIVOPASSIVO = :STAATIVOPASSIVO,'
      '  STACOTIZA = :STACOTIZA,'
      '  STASOMADIMINUI = :STASOMADIMINUI,'
      '  IDREGRA = :IDREGRA,'
      '  STACPMF = :STACPMF'
      'where'
      '  IDEVENTOCAIXACOTA = :OLD_IDEVENTOCAIXACOTA')
    InsertSQL.Strings = (
      'insert into EVENTOCAIXACOTA'
      
        '  (IDEVENTOCAIXACOTA, DESCCAIXACOTA, IDTIPOINVEST, IDTIPOOPERACA' +
        'O, '
      'IDTIPODESPINVEST, '
      
        '   STACAIXA, STACOTA, STAATIVOPASSIVO, STACOTIZA, STASOMADIMINUI' +
        ', '
      'IDREGRA, '
      '   STACPMF)'
      'values'
      '  (:IDEVENTOCAIXACOTA, :DESCCAIXACOTA, :IDTIPOINVEST, '
      ':IDTIPOOPERACAO, '
      '   :IDTIPODESPINVEST, :STACAIXA, :STACOTA, :STAATIVOPASSIVO, '
      ':STACOTIZA, '
      '   :STASOMADIMINUI, :IDREGRA, :STACPMF)')
    DeleteSQL.Strings = (
      'delete from EVENTOCAIXACOTA'
      'where'
      '  IDEVENTOCAIXACOTA = :OLD_IDEVENTOCAIXACOTA')
    Left = 250
    Top = 94
  end
