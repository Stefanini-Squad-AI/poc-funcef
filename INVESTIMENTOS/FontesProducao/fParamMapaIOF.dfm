  object qryClasseTit: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '
      '   IDCLASSETIT,DESCCLASSETIT '
      'FROM '
      '   CLASSETITRENFIX'
      'ORDER BY DESCCLASSETIT  '
      ' ')
    ValidateWithMask = True
    Left = 350
    Top = 69
