  object UpdDetalheResg: TUpdateSQL
    ModifySQL.Strings = (
      'update PEDIDOFUNDO'
      'set'
      '  IDPEDIDOFUNDO = :IDPEDIDOFUNDO,'
      '  IDTIPOINVEST = :IDTIPOINVEST,'
      '  IDTIPOOPERACAO = :IDTIPOOPERACAO,'
      '  IDFUNDOINVEST = :IDFUNDOINVEST,'
      '  DATAPEDIDO = :DATAPEDIDO,'
      '  DATALIQUIDACAO = :DATALIQUIDACAO,'
      '  VLRPEDIDO = :VLROPERACAO,'
      '  IDPLANPREVCTBPATR = :IDPLANPREVCTBPATR,'
      '  DATACOTIZACAO = :DATACOTIZACAO,'
      '  CODDOCUMENTO = :CODDOCUMENTO,'
      '  NUMLANCTO = :NUMLANCTO,'
      '  PLNCODIGO = :PLNCODIGO,'
      '  PLANO = :PLANO,'
      '  IDCOMPOSICAOFUNDO = :IDCOMPOSICAOFUNDO,'
      '  STAESPECIFICADO = :STAESPECIFICADO'
      'where'
      '  IDPEDIDOFUNDO = :OLD_IDPEDIDOFUNDO')
    InsertSQL.Strings = (
      'insert into PEDIDOFUNDO'
      '  (IDPEDIDOFUNDO, IDTIPOINVEST, IDTIPOOPERACAO, IDFUNDOINVEST, '
      'DATAPEDIDO, '
      '   DATALIQUIDACAO, VLRPEDIDO, IDPLANPREVCTBPATR, DATACOTIZACAO, '
      'CODDOCUMENTO, '
      '   NUMLANCTO, PLNCODIGO, PLANO, IDCOMPOSICAOFUNDO, '
      'STAESPECIFICADO)'
      'values'
      
        '  (:IDPEDIDOFUNDO, :IDTIPOINVEST, :IDTIPOOPERACAO, :IDFUNDOINVES' +
        'T, '
      ':DATAPEDIDO, '
      '   :DATALIQUIDACAO, :VLROPERACAO, :IDPLANPREVCTBPATR, '
      ':DATACOTIZACAO, :CODDOCUMENTO, '
      '   :NUMLANCTO, :PLNCODIGO, :PLANO, :IDCOMPOSICAOFUNDO, '
      ':STAESPECIFICADO)')
    DeleteSQL.Strings = (
      'delete from PEDIDOFUNDO'
      'where'
      '  IDPEDIDOFUNDO = :OLD_IDPEDIDOFUNDO')
    Left = 291
    Top = 198
