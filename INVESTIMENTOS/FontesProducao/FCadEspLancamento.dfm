  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update OPERACAOFUNDO'
      'set'
      '  DESCFUNDOINVEST = :DESCFUNDOINVEST,'
      '  DESCTIPOOPERACAO = :DESCTIPOOPERACAO,'
      '  VLROPERACAO = :VLROPERACAO,'
      '  IDTIPOOPERACAO = :IDTIPOOPERACAO,'
      '  IDTIPOINVEST = :IDTIPOINVEST,'
      '  IDFUNDOINVEST = :IDFUNDOINVEST,'
      '  IDCARTEIRAINVEST = :IDCARTEIRAINVEST,'
      '  STAESPECIFICADO = :STAESPECIFICADO'
      'where'
      '  IDFUNDOINVEST = :OLD_IDFUNDOINVEST')
    InsertSQL.Strings = (
      'insert into OPERACAOFUNDO'
      
        '  (DESCFUNDOINVEST, DESCTIPOOPERACAO, VLROPERACAO, IDTIPOOPERACA' +
        'O, IDTIPOINVEST, '
      '   IDFUNDOINVEST, IDCARTEIRAINVEST, STAESPECIFICADO)'
      'values'
      
        '  (:DESCFUNDOINVEST, :DESCTIPOOPERACAO, :VLROPERACAO, :IDTIPOOPE' +
        'RACAO, '
      
        '   :IDTIPOINVEST, :IDFUNDOINVEST, :IDCARTEIRAINVEST, :STAESPECIF' +
        'ICADO)')
    DeleteSQL.Strings = (
      'delete from OPERACAOFUNDO'
      'where'
      '  IDFUNDOINVEST = :OLD_IDFUNDOINVEST')
    Left = 467
    Top = 6
  end
