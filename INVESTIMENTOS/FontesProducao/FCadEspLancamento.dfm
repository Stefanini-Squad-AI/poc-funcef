  object QryComposicaoFundo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   FI.DESCFUNDOINVEST,'
      '   FI.IDFUNDOINVEST,'
      '   FI.IDTIPOFUNDOINVEST,'
      '   FI.IDCARTEIRAINVEST,'
      '   FI.IDGESTORCARTEIRA,'
      '   FI.PZOCOTAPLIC,'
      '   FI.QTDDECQTD,'
      '   FI.PZOLIQAPLIC,'
      '   CF.IDCOMPOSICAOFUNDO,'
      '   CF.IDFUNDOINVESTCOMP'
      'FROM  COMPOSICAOFUNDO CF,'
      
        ' (SELECT DESCFUNDOINVEST,  IDFUNDOINVEST, IDTIPOFUNDOINVEST, IDC' +
        'ARTEIRAINVEST,'
      '         IDGESTORCARTEIRA, PZOCOTAPLIC,   QTDDECQTD, PZOLIQAPLIC'
      '  FROM   HISTFUNDOINVEST'
      
        '  WHERE (IDFUNDOINVEST || TO_CHAR(DTAVIGENCIA,'#39'DD/MM/YYYY, HH24:' +
        'MI:SS'#39') IN'
      
        '        (SELECT IDFUNDOINVEST || TO_CHAR(MAX(DTAVIGENCIA),'#39'DD/MM' +
        '/YYYY, HH24:MI:SS'#39')'
      '         FROM   HISTFUNDOINVEST'
      
        '         WHERE  DTAVIGENCIA < TO_DATE(:DATAOPERACAO,'#39'DD/MM/YYYY'#39 +
        ')+1'
      '         GROUP BY IDFUNDOINVEST))) FI'
      'WHERE'
      '       CF.IDFUNDOINVEST     = :IDFUNDOINVEST        AND'
      '       FI.IDFUNDOINVEST     = CF.IDFUNDOINVESTCOMP'
      'ORDER BY FI.DESCFUNDOINVEST'
      ''
      ''
      ''
      ' ')
    ValidateWithMask = True
    Left = 552
    Top = 145
    ParamData = <
      item
        DataType = ftString
        Name = 'DATAOPERACAO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDFUNDOINVEST'
        ParamType = ptInput
      end>
  end
  object QryTipoFundo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDTIPOINVEST, IDTIPOFUNDOINVEST, DESCTIPOFUNDOINV'
      'FROM TIPOFUNDOINVEST'
