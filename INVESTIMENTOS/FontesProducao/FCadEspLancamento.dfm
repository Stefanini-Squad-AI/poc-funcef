  object QryTipoOperacao: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT IDTIPOINVEST, IDTIPOOPERACAO, DESCTIPOOPERACAO, NATUREZAO' +
        'PERACAO,'
      '       FLGCONTAINVEST'
      'FROM TIPOOPERACAO'
      'WHERE (IDTIPOINVEST = :IDTIPOINVEST)  AND'
      '      (CODTIPDOC IS NOT NULL)         AND'
      '      (IDTIPOOPERACAO > 0)            AND'
      '      (NATUREZAOPERACAO IN ('#39'A'#39','#39'D'#39'))'
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 552
    Top = 95
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDTIPOINVEST'
        ParamType = ptInput
      end>
  end
