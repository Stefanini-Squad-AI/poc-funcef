  object QryDetalheResg: TwwQuery
    CachedUpdates = True
    BeforePost = QryDetalheResgBeforePost
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT'
      '   FI.DESCFUNDOINVEST,'
      '   FI.IDTIPOFUNDOINVEST,'
      '   FI.DTAINIPROC,'
      '   TP.DESCTIPOOPERACAO,'
      '   TP.FLGCONTAINVEST,'
      '   TI.DATAULTFECH,'
      '   PF.IDPEDIDOFUNDO,'
      '   PF.IDTIPOINVEST,'
      '   PF.IDTIPOOPERACAO,'
      '   PF.IDFUNDOINVEST,'
      '   PF.DATAPEDIDO,'
      '   PF.DATALIQUIDACAO,'
      '   PF.VLRPEDIDO AS VLROPERACAO,'
      '   PF.IDPLANPREVCTBPATR,'
      '   PF.DATACOTIZACAO,'
      '   PF.CODDOCUMENTO,'
      '   PF.NUMLANCTO,'
      '   PF.PLNCODIGO,'
      '   PF.PLANO,'
      '   PF.IDCOMPOSICAOFUNDO,'
      '   PF.STAESPECIFICADO'
      'FROM'
      '   PEDIDOFUNDO PF,'
      
        '  (SELECT DESCFUNDOINVEST, IDTIPOFUNDOINVEST, IDFUNDOINVEST, DTA' +
        'INIPROC'
      
        '   FROM HISTFUNDOINVEST WHERE (IDFUNDOINVEST || TO_CHAR(DTAVIGEN' +
        'CIA,'#39'DD/MM/YYYY, HH24:MI:SS'#39') IN'
      
        '           (SELECT IDFUNDOINVEST || TO_CHAR(MAX(DTAVIGENCIA),'#39'DD' +
        '/MM/YYYY, HH24:MI:SS'#39')'
      '            FROM HISTFUNDOINVEST'
      
        '            WHERE DTAVIGENCIA < TO_DATE(:DATAOPERACAO,'#39'DD/MM/YYY' +
        'Y'#39')+1'
      '            GROUP BY IDFUNDOINVEST))) FI,'
      '   COMPOSICAOFUNDO CF, TIPOOPERACAO TP, TIPOFUNDOINVEST TI'
      'WHERE'
      
        '   PF.IDTIPOINVEST      = :IDTIPOINVEST                       AN' +
        'D'
      
        '   PF.IDPLANPREVCTBPATR = :IDPLANPREVCTBPATR                  AN' +
        'D'
      
        '   PF.DATAPEDIDO        = TO_DATE(:DATAOPERACAO,'#39'DD/MM/YYYY'#39') AN' +
        'D'
      
        '   PF.IDTIPOOPERACAO    = :IDTIPOOPERACAO                     AN' +
        'D'
      
        '   CF.IDFUNDOINVEST     = :IDFUNDOINVEST                      AN' +
        'D'
      
        '   CF.IDCOMPOSICAOFUNDO = PF.IDCOMPOSICAOFUNDO                AN' +
        'D'
      
        '   TI.IDTIPOINVEST      = PF.IDTIPOINVEST                     AN' +
        'D'
      
        '   FI.IDTIPOFUNDOINVEST = TI.IDTIPOFUNDOINVEST                AN' +
        'D'
      
        '   FI.IDFUNDOINVEST     = PF.IDFUNDOINVEST                    AN' +
        'D'
      
        '   TP.IDTIPOINVEST      = PF.IDTIPOINVEST                     AN' +
        'D'
      '   TP.IDTIPOOPERACAO    = PF.IDTIPOOPERACAO'
      'ORDER BY FI.DESCFUNDOINVEST, TP.DESCTIPOOPERACAO')
    UpdateObject = UpdDetalheResg
