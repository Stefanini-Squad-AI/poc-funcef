  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT DISTINCT'
      '   FI.DESCFUNDOINVEST,'
      '   TP.DESCTIPOOPERACAO,'
      '   OP.VLROPERACAO,'
      '   OP.IDTIPOOPERACAO,'
      '   OP.IDTIPOINVEST,'
      '   OP.IDFUNDOINVEST,'
      '   OP.IDCARTEIRAINVEST,'
      '   OP.DATAOPERACAO,'
      '   OP.IDPLANPREVCTBPATR,'
      '   OP.VLROPERACAO As VALOR,'
      '   OP.STAESPECIFICADO,'
      '   OP.IDOPERACAOFUNDO'
      'FROM'
      '   OPERACAOFUNDO OP,'
      '   (SELECT DESCFUNDOINVEST, IDFUNDOINVEST, IDTIPOFUNDOINVEST'
      '    FROM HISTFUNDOINVEST'
      '    WHERE (IDFUNDOINVEST || DTAVIGENCIA IN'
      '            (SELECT IDFUNDOINVEST || MAX(DTAVIGENCIA)'
      '             FROM HISTFUNDOINVEST'
      
        '             WHERE DTAVIGENCIA < TO_DATE(:DATAOPERACAO,'#39'DD/MM/YY' +
        'YY'#39')+1'
      '             GROUP BY IDFUNDOINVEST))) FI,'
      '   TIPOOPERACAO TP, COMPOSICAOFUNDO CF'
      'WHERE'
      
        '   OP.IDTIPOINVEST      = :IDTIPOINVEST                        A' +
        'ND'
      
        '   OP.IDPLANPREVCTBPATR = :IDPLANPREVCTBPATR                   A' +
        'ND'
      
        '   OP.DATAOPERACAO      = TO_DATE(:DATAOPERACAO,'#39'DD/MM/YYYY'#39') AN' +
        'D'
      
        '   OP.IDTIPOOPERACAO    = :IDTIPOOPERACAO                      A' +
        'ND'
      
        '   FI.IDTIPOFUNDOINVEST = :IDTIPOFUNDOINVEST                   A' +
        'ND'
      
        '   OP.IDCOMPOSICAOFUNDO IS NULL                               AN' +
        'D'
      
        '   FI.IDFUNDOINVEST     = OP.IDFUNDOINVEST                    AN' +
        'D'
      
        '   TP.IDTIPOINVEST      = OP.IDTIPOINVEST                     AN' +
        'D'
      
        '   TP.IDTIPOOPERACAO    = OP.IDTIPOOPERACAO                   AN' +
        'D'
      '   CF.IDFUNDOINVEST     = OP.IDFUNDOINVEST'
      'ORDER BY FI.DESCFUNDOINVEST, TP.DESCTIPOOPERACAO'
      ' ')
    ControlType.Strings = (
      'STAESPECIFICADO;CheckBox;S;N')
