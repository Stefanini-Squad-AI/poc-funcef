  object QryConciliaCustodia: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      
        'DECODE(HI.DESCINVESTIMENTO,NULL, HC.DESCINVESTIMENTO,HI.DESCINVE' +
        'STIMENTO), NVL((HI.SALDO-NVL(HC.SALDO,0)),0) AS DIFERENCA,'
      
        'HI.SALDO AS SALDOHISTCART, NVL(HC.SALDO,0) AS SALDOHISTCUSTODIA,' +
        ' HC.IDCUSTODIA,'
      'HC.SALDOLIBERADO,HC.SALDOBLOQUEADO'
      ' FROM'
      '(  SELECT DISTINCT'
      '          NVL(H1.SALDOQTDEINVCART,0) AS SALDO,'
      '          IV.DESCINVESTIMENTO, IV.IDINVESTIMENTO'
      '        FROM'
      '           CM.HISTCARTINV H1, CM.INVESTIMENTO IV'
      '        WHERE'
      '           (H1.IDHISTCARTINV  IN'
      '             ('
      '              SELECT MAX(H2.IDHISTCARTINV)'
      '              FROM HISTCARTINV H2'
      '              WHERE'
      '                H2.IDTIPOINVEST     = 2                 AND'
      '                H2.IDCARTEIRAINVEST =:IDCARTEIRAINVEST  AND'
      '                H2.IDINVESTIMENTO   =:IDINVESTIMENTO    AND'
      
        '                (((H2.DATAMOVCARTINV     = TO_DATE(:DATA,'#39'DD/MM/' +
        'YYYY'#39')) )  OR'
      
        '                 ((H2.DATAMOVCARTINV     < TO_DATE(:DATA,'#39'DD/MM/' +
        'YYYY'#39')) AND (H2.IDHISTCARTINV <9999999999)))'
      
        '              GROUP BY H2.IDINVESTIMENTO))                      ' +
        ' AND'
      '           (H1.IDINVESTIMENTO     = IV.IDINVESTIMENTO)     AND'
      '           (NVL(H1.SALDOQTDEINVCART,0) > 0)'
      ''
      'ORDER BY           IV.DESCINVESTIMENTO) HI,'
      ''
      '('
      'SELECT'
      
        '   (HC.SALDOLIBERADO+HC.SALDOBLOQUEADO) AS SALDO, IV.DESCINVESTI' +
        'MENTO, IV.IDINVESTIMENTO,'
      '    HC.SALDOLIBERADO,HC.SALDOBLOQUEADO,'
      '    HC.IDCUSTODIA'
      'FROM'
      '    HISTCUSTODIA HC, INVESTIMENTO IV'
      'WHERE'
      '    HC.IDCUSTODIA IN'
      #9'(SELECT MAX(IDCUSTODIA)'
      #9' FROM'
      #9#9'(SELECT *'
      #9#9' FROM  HISTCUSTODIA'
      #9#9' WHERE'
      #9#9'      (IDCARTEIRAINVEST =:IDCARTEIRAINVEST) AND'
      '                      (IDINVESTIMENTO   =:IDINVESTIMENTO)   AND'
      
        #9#9'      (IDINVESTIMENTO||DATAMOVCUSTOD IN (SELECT IDINVESTIMENTO' +
        '||MAX(H1.DATAMOVCUSTOD)'
      ' '#9#9#9'                    FROM HISTCUSTODIA H1'
      
        '                  '#9#9#9'  WHERE   (H1.IDCARTEIRAINVEST =:IDCARTEIRA' +
        'INVEST) AND'
      
        '                                                  (H1.IDINVESTIM' +
        'ENTO   =:IDINVESTIMENTO)   AND'
      
        #9#9#9'                         ((H1.DATAMOVCUSTOD < TO_DATE(:DATA,'#39 +
        'DD/MM/YYYY'#39')) OR'
      
        #9#9#9'                          (H1.DATAMOVCUSTOD = TO_DATE(:DATA,'#39 +
        'DD/MM/YYYY'#39')))'
      #9#9#9'                    GROUP BY IDINVESTIMENTO) )'
      ''
      #9#9' ORDER BY IDCUSTODIA)'
      #9' GROUP BY IDINVESTIMENTO) '#9#9'  AND'
      '  (HC.IDINVESTIMENTO = IV.IDINVESTIMENTO)   AND'
      ' ((HC.SALDOLIBERADO+HC.SALDOBLOQUEADO) > 0)'
      'ORDER BY           IV.DESCINVESTIMENTO) HC'
      ''
      'WHERE'
      ''
      '     HI.IDINVESTIMENTO = HC.IDINVESTIMENTO  AND'
      '     NVL((HI.SALDO-NVL(HC.SALDO,0)),0) <> 0'
      ''
      ''
      'ORDER BY HI.DESCINVESTIMENTO'
      ''
      ''
      '')
    ValidateWithMask = True
    Left = 394
    Top = 67
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDCARTEIRAINVEST'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDINVESTIMENTO'
        ParamType = ptResult
      end
      item
        DataType = ftString
        Name = 'DATA'
        ParamType = ptResult
      end
      item
        DataType = ftString
        Name = 'DATA'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDCARTEIRAINVEST'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDINVESTIMENTO'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDCARTEIRAINVEST'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDINVESTIMENTO'
        ParamType = ptResult
      end
      item
        DataType = ftString
        Name = 'DATA'
        ParamType = ptResult
      end
      item
        DataType = ftString
        Name = 'DATA'
        ParamType = ptResult
      end>
  end
