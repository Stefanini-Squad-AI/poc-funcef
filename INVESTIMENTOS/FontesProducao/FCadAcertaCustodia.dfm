  object qryConsCarteira: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '      IDCARTEIRAINVEST, DESCCARTINVEST'
      'FROM'
      '    CARTEIRAINVEST'
      'WHERE'
      '    IDTIPOINVEST = 2'
      ''
      'ORDER BY DESCCARTINVEST'
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 394
    Top = 19
