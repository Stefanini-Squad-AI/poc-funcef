      Visible = False
      Size = 10
    end
  end
  object qryNivel2: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT'
      
        '   TP.IDTIPOINVEST, 0 AS IDTIPOFUNDOINVEST, IV.IDINVESTIMENTO, I' +
        'V.DESCINVESTIMENTO,'
      '   TP.DESCTIPOINVEST AS TIPOINVESTIMENTO'
      
        'FROM   HISTRENFIX HR, OPERRENFIX OP, INVESTIMENTO IV, TIPOINVEST' +
        ' TP'
      'WHERE  (TP.IDTIPOINVEST = 1)'
      
        '  AND  (((OP.VENCOPERACAO IS NOT NULL) AND (OP.VENCOPERACAO >= T' +
        'O_DATE(:DATAANT,'#39'DD/MM/YYYY'#39'))) OR'
      '         (OP.VENCOPERACAO IS NULL))'
      '  AND (HR.IDHISTRENFIX IN'
      '             (SELECT MAX(H1.IDHISTRENFIX)'
      '              FROM HISTRENFIX H1'
      
        '              WHERE (H1.DATAHISTRENFIX BETWEEN TO_DATE(:DATAANT,' +
        #39'DD/MM/YYYY'#39') and'
      
        '                                               TO_DATE(:DATAATU,' +
        #39'DD/MM/YYYY'#39'))'
      
        '                AND ((:IDPLANPREVCTBPATR IS NULL) OR (H1.IDPLANP' +
        'REVCTBPATR = :IDPLANPREVCTBPATR))'
      
        '                AND ((H1.DATAHISTRENFIX || H1.IDPLANPREVCTBPATR ' +
        '|| H1.IDINVESTIMENTO || H1.IDOPERRENFIXAPLIC) IN'
      
        '                            (SELECT MAX(H2.DATAHISTRENFIX) || H2' +
        '.IDPLANPREVCTBPATR || H2.IDINVESTIMENTO || H2.IDOPERRENFIXAPLIC'
      '                             FROM HISTRENFIX H2'
      
        '                             WHERE (H2.DATAHISTRENFIX BETWEEN TO' +
        '_DATE(:DATAANT,'#39'DD/MM/YYYY'#39') and'
      
        '                                                              TO' +
        '_DATE(:DATAATU,'#39'DD/MM/YYYY'#39'))'
      
        '                               AND ((:IDPLANPREVCTBPATR IS NULL)' +
        ' OR (H2.IDPLANPREVCTBPATR = :IDPLANPREVCTBPATR))'
      
        '                             GROUP BY H2.IDPLANPREVCTBPATR, H2.I' +
        'DINVESTIMENTO, H2.IDOPERRENFIXAPLIC))'
      
        '              GROUP BY H1.DATAHISTRENFIX, H1.IDPLANPREVCTBPATR, ' +
        'H1.IDINVESTIMENTO, H1.IDOPERRENFIXAPLIC))'
      '  AND (HR.IDINVESTIMENTO = IV.IDINVESTIMENTO)'
      '  AND (HR.IDOPERRENFIXAPLIC = OP.IDOPERRENFIX)'
      ''
      'UNION'
      ''
      'SELECT DISTINCT'
      
        '   IV.IDTIPOINVEST, 0 AS IDTIPOFUNDOINVEST, IV.IDINVESTIMENTO, I' +
        'V.DESCINVESTIMENTO,'
      '   TP.DESCTIPOINVEST AS TIPOINVESTIMENTO'
      'FROM'
      '   INVESTIMENTO IV, TIPOINVEST TP,'
      '   (SELECT IDINVESTIMENTO'
      '    FROM HISTCARTINV'
      '    WHERE IDHISTCARTINV IN'
      '              (SELECT MAX(IDHISTCARTINV)'
      '               FROM HISTCARTINV'
      
        '               WHERE (((:IDPLANPREVCTBPATR IS NOT NULL) AND (IDP' +
        'LANPREVCTBPATR=:IDPLANPREVCTBPATR)) OR'
      
        '                      ((:IDPLANPREVCTBPATR IS NULL)     AND (IDP' +
        'LANPREVCTBPATR IS NOT NULL)))'
      '                 AND (IDCARTEIRAINVEST IN (1,2,8))'
      '                 AND (IDCARTEIRAGERENC IS NULL)'
      '                 AND ((DATAMOVCARTINV || IDINVESTIMENTO) IN'
      
        '                             (SELECT (MAX(DATAMOVCARTINV) || IDI' +
        'NVESTIMENTO)'
      '                              FROM    HISTCARTINV'
      
        '                              WHERE (((:IDPLANPREVCTBPATR IS NOT' +
        ' NULL) AND (IDPLANPREVCTBPATR=:IDPLANPREVCTBPATR)) OR'
      
        '                                     ((:IDPLANPREVCTBPATR IS NUL' +
        'L)     AND (IDPLANPREVCTBPATR IS NOT NULL)))'
      
        '                                AND (IDCARTEIRAINVEST IN (1,2,8)' +
        ')'
      '                                AND (IDCARTEIRAGERENC IS NULL)'
      
        '                                AND (DATAMOVCARTINV  <= TO_DATE(' +
        ':DATAATU,'#39'DD/MM/YYYY'#39'))'
      
        '                              GROUP BY IDINVESTIMENTO, IDCARTEIR' +
        'AINVEST))'
      '               GROUP BY IDINVESTIMENTO, IDCARTEIRAINVEST)'
      
        '      AND (((DATAMOVCARTINV < TO_DATE(:DATAANT,'#39'DD/MM/YYYY'#39')) AN' +
        'D (NVL(SALDOQTDEINVCART,0) > 0) ) OR'
      '            (DATAMOVCARTINV >= TO_DATE(:DATAANT,'#39'DD/MM/YYYY'#39')))'
      '    GROUP BY IDINVESTIMENTO'
      '    UNION'
      '    SELECT IDINVESTIMENTO'
      '    FROM HISTOPCIND'
      
        '    WHERE ((:IDPLANPREVCTBPATR IS NULL) OR (IDPLANPREVCTBPATR=:I' +
        'DPLANPREVCTBPATR))'
      
        '      AND (DATAHISTOPCIND BETWEEN TO_DATE(:DATAANT,'#39'DD/MM/YYYY'#39')' +
        ' AND'
      
        '                                  TO_DATE(:DATAATU,'#39'DD/MM/YYYY'#39')' +
        ')'
      '      AND (IDHISTOPCIND IN'
      '                (SELECT MAX(IDHISTOPCIND)'
      '                 FROM HISTOPCIND'
      
        '                 WHERE ((:IDPLANPREVCTBPATR IS NULL) OR (IDPLANP' +
        'REVCTBPATR=:IDPLANPREVCTBPATR))'
      
        '                   AND (DATAHISTOPCIND BETWEEN TO_DATE(:DATAANT,' +
        #39'DD/MM/YYYY'#39') AND'
      
        '                                               TO_DATE(:DATAATU,' +
        #39'DD/MM/YYYY'#39'))'
      
        '                   AND (DATAHISTOPCIND IN (SELECT MAX(DATAHISTOP' +
        'CIND)'
      '                                           FROM HISTOPCIND'
      
        '                                           WHERE ((:IDPLANPREVCT' +
        'BPATR IS NULL) OR (IDPLANPREVCTBPATR=:IDPLANPREVCTBPATR))'
      
        '                                             AND (DATAHISTOPCIND' +
        ' BETWEEN TO_DATE(:DATAANT,'#39'DD/MM/YYYY'#39')  AND'
      
        '                                                                ' +
        '         TO_DATE(:DATAATU,'#39'DD/MM/YYYY'#39'))'
      
        '                                           GROUP BY IDINVESTIMEN' +
        'TO))'
      '                 GROUP BY DATAHISTOPCIND, IDINVESTIMENTO))'
      '    GROUP BY IDINVESTIMENTO) OP'
      'WHERE'
      '   (IV.IDINVESTIMENTO = OP.IDINVESTIMENTO) AND'
      '   (TP.IDTIPOINVEST   = IV.IDTIPOINVEST)'
      ''
      'UNION'
      ''
      'SELECT DISTINCT'
      
        '   HF.IDTIPOINVEST, HI.IDTIPOFUNDOINVEST, HF.IDFUNDOINVEST AS ID' +
        'INVESTIMENTO,'
      '   HI.DESCFUNDOINVEST AS DESCINVESTIMENTO, TP.TIPOINVESTIMENTO'
      'FROM'
      '   HISTFUNDO HF,'
      '   (SELECT TI.IDTIPOINVEST, TF.IDTIPOFUNDOINVEST,'
      
        '                DECODE(NVL(TF.IDTIPOFUNDOINVEST,0),0,TI.DESCTIPO' +
        'INVEST, TI.DESCTIPOINVEST || '#39' - '#39' || TF.DESCTIPOFUNDOINV) AS TI' +
        'POINVESTIMENTO'
      '    FROM TIPOINVEST TI, TIPOFUNDOINVEST TF'
      '    WHERE TI.IDTIPOINVEST NOT IN (-1,3,4)'
      '      AND TI.IDTIPOINVEST = TF.IDTIPOINVEST(+) '
      '    ORDER BY IDTIPOINVEST) TP,'
      ''
      '   (SELECT MAX(IDHISTFUNDO) AS IDHISTFUNDO'
      '    FROM HISTFUNDO HF'
      '    WHERE'
      '          (HF.IDTIPOINVEST      > 0)'
      
        '      AND (((:IDPLANPREVCTBPATR IS NULL)     AND (HF.IDPLANPREVC' +
        'TBPATR > 0)) OR'
      
        '           ((:IDPLANPREVCTBPATR IS NOT NULL) AND (HF.IDPLANPREVC' +
        'TBPATR = :IDPLANPREVCTBPATR)))'
      '      AND (HF.IDFUNDOINVEST     > 0)'
      
        '      AND (HF.DATAAPLICACAO     <= TO_DATE(:DATAATU,'#39'DD/MM/YYYY'#39 +
        '))'
      
        '      AND (HF.DATAMOVFUNDO BETWEEN TO_DATE(:DATAANT,'#39'DD/MM/YYYY'#39 +
        ') AND'
      
        '                                   TO_DATE(:DATAATU,'#39'DD/MM/YYYY'#39 +
        '))'
      
        '    GROUP BY HF.IDTIPOINVEST, HF.IDPLANPREVCTBPATR, HF.IDFUNDOIN' +
        'VEST, HF.DATAAPLICACAO, HF.DATAMOVFUNDO) HMAX,'
      ''
      
        '   (SELECT HS.IDFUNDOINVEST, HS.DTAVIGENCIA, HS.IDTIPOFUNDOINVES' +
        'T,'
      '           HS.DESCFUNDOINVEST, HS.IDCARTEIRASPC'
      '    FROM HISTFUNDOINVEST HS'
      '    WHERE HS.DTAVIGENCIA = (SELECT MAX(DTAVIGENCIA)'
      '                            FROM HISTFUNDOINVEST'
      
        '                            WHERE (DTAVIGENCIA <= TO_DATE(:DATAA' +
        'TU,'#39'DD/MM/YYYY'#39'))'
      
        '                              AND (IDFUNDOINVEST = HS.IDFUNDOINV' +
        'EST))) HI'
      'WHERE'
      '      (HF.IDHISTFUNDO       = HMAX.IDHISTFUNDO)'
      '  AND (HF.IDFUNDOINVEST     = HI.IDFUNDOINVEST)'
      '  AND (TP.IDTIPOFUNDOINVEST = HI.IDTIPOFUNDOINVEST)'
      ''
      'ORDER BY IDTIPOINVEST, IDTIPOFUNDOINVEST, DESCINVESTIMENTO')
    ValidateWithMask = True
    Left = 296
    Top = 225
