  object qryConsMoeda: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT DISTINCT MO.MOEDESC, MO.MOECODIGO, MO.MOESIGLA, TI.CODTRA' +
        'TAIND'
      'FROM MOEDA MO, TRATAINDICE TI'
      'WHERE MO.MOECODIGO = TI.MOECODIGO'
      'ORDER BY MOEDESC'
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 680
    Top = 7
    object qryConsMoedaMOEDESC: TStringField
      DisplayLabel = 'Moeda'
      DisplayWidth = 20
      FieldName = 'MOEDESC'
      Origin = 'BASEDADOS.MOEDA.MOEDESC'
    end
