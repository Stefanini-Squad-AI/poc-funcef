  object qryPlanoPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT PLANPRVCONTABPATRO, IDPLANPREVCTBPATR, IDPLANOPREV, IDPAT' +
        'RO'
      'FROM VWPLANPREVCTBPATR'
      'UNION'
      
        'SELECT '#39'Todos os Planos'#39' AS PLANPRVCONTABPATRO, -1 AS IDPLANPREV' +
        'CTBPATR, -1 AS IDPLANOPREV, -1 AS IDPATRO'
      'FROM DUAL'
      '')
    ValidateWithMask = True
    Left = 788
    Top = 70
