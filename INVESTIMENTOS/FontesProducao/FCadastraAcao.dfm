  object QryEmissor: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDEMISSOR, SIGLAEMISSOR'
      'FROM EMISSOR'
      'WHERE FLGATIVARV IS NULL OR FLGATIVARV = '#39'S'#39' '
      'ORDER BY SIGLAEMISSOR'
      '')
