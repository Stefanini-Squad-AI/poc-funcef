  object QryBuscaInvestimento: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT  INV.IDINVESTIMENTO,   INV.IDMOEDACONTAB, INV.IDEMISSOR, ' +
        'INV.IDTIPOINVEST,'
      
        '        INV.DESCINVESTIMENTO, ACA.CODTIPOACAO, AXB.MOECODIGO, AX' +
        'B.QTDELOTE,'
