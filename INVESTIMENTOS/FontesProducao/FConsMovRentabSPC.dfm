  object qryBuscaPagJur: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT SUM(NVL(VLROPERACAO,0)) AS TOTPAGJUR'
      'FROM OPERRENFIX'
      'WHERE    IDTIPOOPERACAO = -17'
      '  AND    DATAOPERACAO   = TO_DATE(:DATAATU, '#39'DD/MM/YYYY'#39')'
      
        '  AND ((:IDPLANPREVCTBPATR IS NULL) OR (IDPLANPREVCTBPATR = :IDP' +
        'LANPREVCTBPATR))'
      '  AND    IDINVESTIMENTO IN (SELECT I.IDINVESTIMENTO'
      '                            FROM   INVESTXCURVARENFIX I'
      '                            WHERE  I.IDINVESTIMENTO IN (0000)'
      '                            AND    I.FLGCOTRENFIX = '#39'Y'#39')')
    ValidateWithMask = True
    Left = 445
    Top = 325
    ParamData = <
      item
        DataType = ftString
        Name = 'DATAATU'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptResult
      end>
    object qryBuscaPagJurTOTPAGJUR: TFloatField
      FieldName = 'TOTPAGJUR'
    end
  end
  object qryBuscaOpeOpcInd: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT SUM(NVL(OPE.VALORAPL,0)) AS VALORAPL,'
      '       ABS(SUM(NVL(OPE.VALORRSG,0))) AS VALORRSG'
      ''
      'FROM ( SELECT HI.SLDHISTOPCIND AS VALORAPL, 0 AS VALORRSG'
      '       FROM HISTOPCINDXITENS HI'
      '       WHERE HI.IDITEMOPCIND = -8'
      '         AND HI.SLDHISTOPCIND > 0'
      '         AND HI.IDHISTOPCIND IN'
      '                 (SELECT MAX(H.IDHISTOPCIND)'
      '                  FROM HISTOPCIND H'
      '                  WHERE (H.IDINVESTIMENTO IN (0000))'
      
        '                    AND (H.DATAHISTOPCIND = TO_DATE(:DATAATU,'#39'DD' +
        '/MM/YYYY'#39'))'
      
        '                    AND ((:IDPLANPREVCTBPATR IS NULL) OR (H.IDPL' +
        'ANPREVCTBPATR = :IDPLANPREVCTBPATR))'
      '                  GROUP BY H.IDINVESTIMENTO)'
      ''
      '       UNION ALL'
      ''
      '       SELECT 0 AS VALORAPL, HI.SLDHISTOPCIND AS VALORRSG'
      '       FROM HISTOPCINDXITENS HI'
      '       WHERE HI.IDITEMOPCIND = -8'
      '         AND HI.SLDHISTOPCIND < 0'
      '         AND HI.IDHISTOPCIND IN'
      '                 (SELECT MAX(IDHISTOPCIND)'
      '                  FROM HISTOPCIND H'
      '                  WHERE (H.IDINVESTIMENTO IN (0000))'
      
        '                    AND (H.DATAHISTOPCIND = TO_DATE(:DATAATU,'#39'DD' +
        '/MM/YYYY'#39'))'
      
        '                    AND ((:IDPLANPREVCTBPATR IS NULL) OR (H.IDPL' +
        'ANPREVCTBPATR = :IDPLANPREVCTBPATR))'
      '                  GROUP BY IDINVESTIMENTO)'
      '     ) OPE')
    ValidateWithMask = True
    Left = 322
    Top = 325
    ParamData = <
      item
        DataType = ftString
        Name = 'DATAATU'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptResult
      end
      item
        DataType = ftString
        Name = 'DATAATU'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptResult
      end>
    object qryBuscaOpeOpcIndVALORAPL: TFloatField
      FieldName = 'VALORAPL'
    end
    object qryBuscaOpeOpcIndVALORRSG: TFloatField
      FieldName = 'VALORRSG'
    end
  end
