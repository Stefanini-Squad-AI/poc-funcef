  object qryBuscaSaldoInv: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT SUM(NVL(TOTAL.SALDO,0)) AS SALDO'
      'FROM ( SELECT SALDOVLRINVCART AS SALDO'
      '       FROM   HISTCARTINV'
      '       WHERE  (IDHISTCARTINV IN'
      '                 (SELECT MAX(H2.IDHISTCARTINV)'
      '                  FROM HISTCARTINV H2'
      '                  WHERE  H2.IDTIPOINVEST > 0'
      
        '                   AND  (((:IDPLANPREVCTBPATR IS NULL) AND (H2.I' +
        'DPLANPREVCTBPATR > 0)) OR'
      
        '                        (H2.IDPLANPREVCTBPATR = :IDPLANPREVCTBPA' +
        'TR) )'
      
        '                   AND ((H2.IDCARTEIRAINVEST = 1) OR (H2.IDCARTE' +
        'IRAINVEST = 2) OR (H2.IDCARTEIRAINVEST = 8))'
      '                    AND (H2.IDCARTEIRAGERENC IS NULL)'
      
        '                   AND  (H2.IDINVESTIMENTO||H2.DATAMOVCARTINV) I' +
        'N'
      
        '                               (SELECT  H3.IDINVESTIMENTO||MAX(H' +
        '3.DATAMOVCARTINV)'
      '                                FROM HISTCARTINV H3'
      '                                WHERE  H3.IDTIPOINVEST > 0'
      
        '                                 AND  (((:IDPLANPREVCTBPATR IS N' +
        'ULL) AND (H3.IDPLANPREVCTBPATR > 0)) OR'
      
        '                                      (H3.IDPLANPREVCTBPATR = :I' +
        'DPLANPREVCTBPATR) )'
      
        '                                 AND ((H3.IDCARTEIRAINVEST = 1) ' +
        'OR (H3.IDCARTEIRAINVEST = 2) OR (H3.IDCARTEIRAINVEST = 8))'
      
        '                                  AND (H3.IDCARTEIRAGERENC IS NU' +
        'LL)'
      
        '                                  AND (H3.IDINVESTIMENTO IN (000' +
        '0))'
      
        '                                  AND (H3.DATAMOVCARTINV <= TO_D' +
        'ATE(:DATAATU,'#39'DD/MM/YYYY'#39'))'
      
        '                                GROUP BY H3.IDTIPOINVEST, H3.IDP' +
        'LANPREVCTBPATR, H3.IDCARTEIRAINVEST, H3.IDCARTEIRAINVEST,'
      '                                         H3.IDINVESTIMENTO)'
      
        '                  GROUP BY H2.IDTIPOINVEST, H2.IDPLANPREVCTBPATR' +
        ', H2.IDCARTEIRAINVEST, H2.IDCARTEIRAINVEST,'
      '                           H2.IDINVESTIMENTO))'
      '       AND (NVL(SALDOQTDEINVCART,0) > 0)'
      ''
      '       UNION ALL'
      ''
      '       SELECT (HI.SLDHISTOPCIND / 2) AS SALDO'
      '       FROM HISTOPCINDXITENS HI'
      '       WHERE HI.IDITEMOPCIND = -6'
      '         AND HI.IDHISTOPCIND IN'
      '                 (SELECT MAX(IDHISTOPCIND)'
      '                  FROM HISTOPCIND H'
      '                  WHERE (H.IDINVESTIMENTO IN'
      '                               (SELECT IDINVESTIMENTO'
      '                                FROM OPERACAOOPCIND'
      '                                WHERE IDBOLETA || IDLOTE IN'
      
        '                                        (SELECT IDBOLETA || IDLO' +
        'TE'
      '                                         FROM OPERACAOOPCIND'
      
        '                                         WHERE IDINVESTIMENTO IN' +
        ' (0000)'
      
        '                                           AND ((:IDPLANPREVCTBP' +
        'ATR IS NULL) OR'
      
        '                                                (IDPLANPREVCTBPA' +
        'TR = :IDPLANPREVCTBPATR)))))'
      
        '                    AND (H.DATAHISTOPCIND || H.IDINVESTIMENTO) I' +
        'N'
      
        '                               (SELECT MAX(DATAHISTOPCIND) || ID' +
        'INVESTIMENTO'
      '                                FROM HISTOPCIND'
      
        '                                WHERE DATAHISTOPCIND <= TO_DATE(' +
        ':DATAATU,'#39'DD/MM/YYYY'#39')'
      
        '                                  AND ((:IDPLANPREVCTBPATR IS NU' +
        'LL) OR (IDPLANPREVCTBPATR = :IDPLANPREVCTBPATR))'
      '                                  AND IDINVESTIMENTO IN'
      
        '                                           (SELECT IDINVESTIMENT' +
        'O'
      '                                            FROM OPERACAOOPCIND'
      
        '                                            WHERE IDBOLETA || ID' +
        'LOTE IN'
      
        '                                                    (SELECT IDBO' +
        'LETA || IDLOTE'
      
        '                                                     FROM OPERAC' +
        'AOOPCIND'
      
        '                                                     WHERE IDINV' +
        'ESTIMENTO IN (0000)'
      
        '                                                       AND ((:ID' +
        'PLANPREVCTBPATR IS NULL) OR'
      
        '                                                            (IDP' +
        'LANPREVCTBPATR = :IDPLANPREVCTBPATR))))'
      '                                GROUP BY IDINVESTIMENTO)'
      
        '                    AND ((:IDPLANPREVCTBPATR IS NULL) OR (H.IDPL' +
        'ANPREVCTBPATR = :IDPLANPREVCTBPATR))'
      '                  GROUP BY IDINVESTIMENTO)'
      '     ) TOTAL')
    ValidateWithMask = True
    Left = 202
    Top = 325
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'DATAATU'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'DATAATU'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptInput
      end>
    object qryBuscaSaldoInvSALDO: TFloatField
      FieldName = 'SALDO'
    end
  end
