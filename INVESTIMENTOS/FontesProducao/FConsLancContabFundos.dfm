  object QryFundos: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  FUN.IDFUNDOINVEST, FUN.DESCFUNDOINVEST'
      'FROM'
      ' (SELECT IDFUNDOINVEST, DESCFUNDOINVEST'
      '  FROM   HISTFUNDOINVEST'
      
        '  WHERE  (IDFUNDOINVEST || TO_CHAR(DTAVIGENCIA,'#39'DD/MM/YYYY, HH24' +
        ':MI:SS'#39') IN'
      
        '             (SELECT IDFUNDOINVEST || MAX(TO_CHAR(DTAVIGENCIA,'#39'D' +
        'D/MM/YYYY, HH24:MI:SS'#39'))'
      '              FROM   HISTFUNDOINVEST'
      
        '              WHERE  DTAVIGENCIA < TO_DATE(:DATA_INI,'#39'DD/MM/YYYY' +
        #39')+1'
      '              GROUP BY IDFUNDOINVEST))) FUN,'
      ''
      ' (SELECT HF.IDFUNDOINVEST, HF.IDTIPOINVEST'
      '  FROM   HISTFUNDO HF'
      '  WHERE'
      
        '      (((:IDPLANPREVCTBPATR IS NOT NULL) AND (HF.IDPLANPREVCTBPA' +
        'TR = :IDPLANPREVCTBPATR)) OR'
      '        (:IDPLANPREVCTBPATR IS NULL))'
      '  AND((HF.DATAMOVFUNDO >= TO_DATE(:DATA_INI,'#39'DD/MM/YYYY'#39'))'
      '  AND (HF.DATAMOVFUNDO <= TO_DATE(:DATA_FIM,'#39'DD/MM/YYYY'#39')))'
      '  AND (HF.IDTIPOINVEST  = :IDTIPOINVEST)'
      '  AND (HF.SALDOQTDCOTAS > 0)'
      '  GROUP BY IDFUNDOINVEST, IDTIPOINVEST) HIST'
      ''
      'WHERE'
      '      (FUN.IDFUNDOINVEST = HIST.IDFUNDOINVEST)'
      ''
      'ORDER BY  FUN.DESCFUNDOINVEST')
    ValidateWithMask = True
    Left = 128
    Top = 124
    ParamData = <
      item
        DataType = ftDateTime
        Name = 'DATA_INI'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptResult
      end
      item
        DataType = ftInteger
        Name = 'IDPLANPREVCTBPATR'
        ParamType = ptResult
      end
      item
        DataType = ftDateTime
        Name = 'DATA_INI'
        ParamType = ptUnknown
      end
      item
        DataType = ftDateTime
        Name = 'DATA_FIM'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDTIPOINVEST'
        ParamType = ptResult
      end>
  end
  object QryOperacao: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT TP.IDTIPOOPERACAO, TP.DESCTIPOOPERACAO'
      'FROM   TIPOOPERACAO TP'
      'WHERE TP.IDTIPOINVEST = :IDTIPOINVEST'
      'ORDER BY TP.DESCTIPOOPERACAO'
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 240
    Top = 124
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDTIPOINVEST'
        ParamType = ptUnknown
      end>
  end
