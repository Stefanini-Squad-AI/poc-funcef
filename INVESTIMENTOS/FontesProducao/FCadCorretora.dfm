  inherited updSubTipo: TUpdateSQL
    ModifySQL.Strings = (
      'update CORRETVALORES'
      'set'
      '  IDCORRETVALORES = :IDCORRETVALORES,'
      '  SGLCORRETVALORES = :SGLCORRETVALORES,'
      '  CODIGOCETIP = :CODIGOCETIP,'
      '  FLGATIVARV = :FLGATIVARV,'
      '  FLGATIVARF = :FLGATIVARF,'
      '  FLGATIVABMF = :FLGATIVABMF,'
      '  FLGATIVAFDO = :FLGATIVAFDO,'
      '  SUBCONTAD = :SUBCONTAD,'
      '  SUBCONTAC = :SUBCONTAC,'
      '  SGLCORRETCUSTODIANTE = :SGLCORRETCUSTODIANTE'
      'where'
      '  IDCORRETVALORES = :OLD_IDCORRETVALORES')
    InsertSQL.Strings = (
      'insert into CORRETVALORES'
      '  (IDCORRETVALORES, SGLCORRETVALORES, CODIGOCETIP, FLGATIVARV, '
      'FLGATIVARF, '
      '   FLGATIVABMF, FLGATIVAFDO, SUBCONTAD, SUBCONTAC, '
      'SGLCORRETCUSTODIANTE)'
      'values'
      
        '  (:IDCORRETVALORES, :SGLCORRETVALORES, :CODIGOCETIP, :FLGATIVAR' +
        'V, '
      ':FLGATIVARF, '
      '   :FLGATIVABMF, :FLGATIVAFDO, :SUBCONTAD, :SUBCONTAC, '
      ':SGLCORRETCUSTODIANTE)')
    DeleteSQL.Strings = (
      'delete from CORRETVALORES'
      'where'
      '  IDCORRETVALORES = :OLD_IDCORRETVALORES')
    Left = 517
    Top = 66
  end
