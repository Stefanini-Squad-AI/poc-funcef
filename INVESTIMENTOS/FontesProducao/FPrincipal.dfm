  object QryFatorCota: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT *'
      'FROM'
      '    HISTFUNDO, FUNDOINVEST'
      'WHERE'
      '    HISTFUNDO.IDTIPOINVEST    = 6 AND'
      
        '    HISTFUNDO.DATAMOVFUNDO   =  TO_DATE('#39'29/01/2003'#39','#39'DD/MM/YYYY' +
        #39') AND    '
      
        '    HISTFUNDO.DATAAPLICACAO   < TO_DATE('#39'31/10/2000'#39','#39'DD/MM/YYYY' +
        #39') AND'
      '    FUNDOINVEST.IDFUNDOINVEST = HISTFUNDO.IDFUNDOINVEST'
      ' '
      ' ')
    UpdateObject = UpdFatorCota
    ControlType.Strings = (
      'STATUS;CheckBox;Yes;No')
    ValidateWithMask = True
    Left = 215
    Top = 404
  end
  object DsFatorCota: TwwDataSource
    DataSet = QryFatorCota
    Left = 215
    Top = 430
  end
  object UpdFatorCota: TUpdateSQL
    ModifySQL.Strings = (
      'update HISTFUNDO'
      'set'
      '  IDHISTFUNDO = :IDHISTFUNDO,'
      '  CODDOCUMENTO = :CODDOCUMENTO,'
      '  PLNCODIGO = :PLNCODIGO,'
      '  PLANO = :PLANO,'
      '  IDTIPOINVEST = :IDTIPOINVEST,'
      '  IDTIPOOPERACAO = :IDTIPOOPERACAO,'
      '  IDCARTEIRAINVEST = :IDCARTEIRAINVEST,'
      '  IDFUNDOINVEST = :IDFUNDOINVEST,'
      '  DATAAPLICACAO = :DATAAPLICACAO,'
      '  DATAMOVFUNDO = :DATAMOVFUNDO,'
      '  HISTMOVFUNDO = :HISTMOVFUNDO,'
      '  NATURMOVFUNDO = :NATURMOVFUNDO,'
      '  TIPMOVFUNDO = :TIPMOVFUNDO,'
      '  VLRAPLICADO = :VLRAPLICADO,'
      '  VLRIRPROV = :VLRIRPROV,'
      '  VLRIOFPROV = :VLRIOFPROV,'
      '  VLRVARIACAO = :VLRVARIACAO,'
      '  COTASMOVFUNDO = :COTASMOVFUNDO,'
      '  VLRMOVFUNDO = :VLRMOVFUNDO,'
      '  FLGCALCSALDO = :FLGCALCSALDO,'
      '  SALDOQTDCOTAS = :SALDOQTDCOTAS,'
      '  SALDOVLRFUNDO = :SALDOVLRFUNDO,'
      '  IDOPERACAOFUNDO = :IDOPERACAOFUNDO,'
      '  DATAULTPGTOIR = :DATAULTPGTOIR,'
      '  COTAAPLICACAO = :COTAAPLICACAO,'
      '  IDPLANPREVCTBPATR = :IDPLANPREVCTBPATR,'
      '  IDOPERACAOINVEST = :IDOPERACAOINVEST,'
      '  VLRCUSTOATUAL = :VLRCUSTOATUAL,'
      '  IDCOMPOSICAOFUNDO = :IDCOMPOSICAOFUNDO,'
      '  DTACOTA = :DTACOTA,'
      '  VLRCOTA = :VLRCOTA,'
      '  TRGDTINCLUSAO = :TRGDTINCLUSAO,'
      '  TRGUSERINCLUSAO = :TRGUSERINCLUSAO'
      'where'
      '  IDHISTFUNDO = :OLD_IDHISTFUNDO')
    InsertSQL.Strings = (
      'insert into HISTFUNDO'
      
        '  (IDHISTFUNDO, CODDOCUMENTO, PLNCODIGO, PLANO, IDTIPOINVEST, ID' +
        'TIPOOPERACAO, '
      
        '   IDCARTEIRAINVEST, IDFUNDOINVEST, DATAAPLICACAO, DATAMOVFUNDO,' +
        ' HISTMOVFUNDO, '
      
        '   NATURMOVFUNDO, TIPMOVFUNDO, VLRAPLICADO, VLRIRPROV, VLRIOFPRO' +
        'V, VLRVARIACAO, '
      
        '   COTASMOVFUNDO, VLRMOVFUNDO, FLGCALCSALDO, SALDOQTDCOTAS, SALD' +
        'OVLRFUNDO, '
      
        '   IDOPERACAOFUNDO, DATAULTPGTOIR, COTAAPLICACAO, IDPLANPREVCTBP' +
        'ATR, IDOPERACAOINVEST, '
      
        '   VLRCUSTOATUAL, IDCOMPOSICAOFUNDO, DTACOTA, VLRCOTA, TRGDTINCL' +
        'USAO, TRGUSERINCLUSAO)'
      'values'
      
        '  (:IDHISTFUNDO, :CODDOCUMENTO, :PLNCODIGO, :PLANO, :IDTIPOINVES' +
        'T, :IDTIPOOPERACAO, '
      
        '   :IDCARTEIRAINVEST, :IDFUNDOINVEST, :DATAAPLICACAO, :DATAMOVFU' +
        'NDO, :HISTMOVFUNDO, '
      
        '   :NATURMOVFUNDO, :TIPMOVFUNDO, :VLRAPLICADO, :VLRIRPROV, :VLRI' +
        'OFPROV, '
      
        '   :VLRVARIACAO, :COTASMOVFUNDO, :VLRMOVFUNDO, :FLGCALCSALDO, :S' +
        'ALDOQTDCOTAS, '
      
        '   :SALDOVLRFUNDO, :IDOPERACAOFUNDO, :DATAULTPGTOIR, :COTAAPLICA' +
        'CAO, :IDPLANPREVCTBPATR, '
      
        '   :IDOPERACAOINVEST, :VLRCUSTOATUAL, :IDCOMPOSICAOFUNDO, :DTACO' +
        'TA, :VLRCOTA, '
      '   :TRGDTINCLUSAO, :TRGUSERINCLUSAO)')
    DeleteSQL.Strings = (
      'delete from HISTFUNDO'
      'where'
      '  IDHISTFUNDO = :OLD_IDHISTFUNDO')
    Left = 215
    Top = 445
  end
