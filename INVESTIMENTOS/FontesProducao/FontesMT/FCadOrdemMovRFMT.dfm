    SQL.Strings = (
      'SELECT * FROM ORDEMRENFIX O, TIPOOPERACAO T'
      'WHERE O.IDTIPOOPERACAO = T.IDTIPOOPERACAO'
      ' ')
    ClientDataSet = Cds
    Left = 416
    Top = 7
  end
