  object sqlCarteira: TCMSqlParams
    SQL.Strings = (
      
        'SELECT                                                          ' +
        '     '
      
        'IDTIPOINVEST, IDPLANOPREV, IDPATROCINADORA, IDMERCADO,          ' +
        '  '
      
        'IDGESTORCARTEIRA, IDDAIEACART, IDCARTEIRAINVEST, FLGTRATALOTE,  ' +
        '  '
      
        'FLGORDMOVINV, FLGCARTTERC, FLGCARTPROP, FLGCARTLASTRO,          ' +
        '  '
      'FLGCALCDIARIO, DESCCARTINVEST, DATAULTFECH, DATAINICIO         '
      
        'FROM CARTEIRAINVEST                                             ' +
        '  '
      
        'WHERE ((IDTIPOINVEST = 1) OR (IDTIPOINVEST IS NULL))            ' +
        '  '
      'ORDER BY DESCCARTINVEST')
    ClientDataSet = cdsCarteira
    Left = 552
    Top = 174
  end
