  object sqlTipoOperacao: TCMSqlParams
    SQL.Strings = (
      
        'SELECT IDTIPOOPERACAO, IDTIPOINVEST, DESCTIPOOPERACAO, NATUREZAO' +
        'PERACAO'
      'FROM TIPOOPERACAO'
      'WHERE IDTIPOINVEST = 1'
      'ORDER BY 3')
    ClientDataSet = cdsTipoOperacao
    Left = 241
    Top = 135
  end
