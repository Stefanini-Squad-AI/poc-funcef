  object sqlpProvPerda: TCMSqlParams
    SQL.Strings = (
      'SELECT I.DESCINVESTIMENTO, P.DATAVIGENCIA, P.PERCENTUAL,'
      '       P.IDPROVPERDARV, P.IDINVESTIMENTO'
      'FROM PROVPERDARV P, INVESTIMENTO I'
      'WHERE P.IDINVESTIMENTO = I.IDINVESTIMENTO')
    Left = 440
    Top = 7
  end
