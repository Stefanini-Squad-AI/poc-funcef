  object CMSqlParams2: TCMSqlParams
    SQL.Strings = (
      
        'SELECT DESCINVESTIMENTO, IDINVESTIMENTO, IDTIPOINVEST, IDMOEDACO' +
        'NTAB, IDEMISSOR, FLGATIVO,'
      
        '       OBSINVESTIMENTO, CODISIN, IDCLASSETIT, CARENCIA, STAOPCAO' +
        ', IDCARTEIRASPC, FLGRFXANTIGO,'
      '       IDINVESTPRP, FLGREPACTUA'
      'FROM INVESTIMENTO'
      'WHERE IDTIPOINVEST = 2'
      'ORDER BY DESCINVESTIMENTO')
    Left = 297
    Top = 103
  end
end
