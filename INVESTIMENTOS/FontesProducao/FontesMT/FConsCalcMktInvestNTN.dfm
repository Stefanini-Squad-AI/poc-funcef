    SQL.Strings = (
      
        'SELECT FL.DATAFLUXO, 0 AS DIAS, 0 AS CUPOMEMISSAO, 0 AS CUPOMCOM' +
        'PRA, 0 AS PUPAR, 0 AS PUJUREMISS, 0 AS PUJURCOMPRA, '
      '       DECODE(OP.VENCOPERACAO, '#39#39', '#39'N'#39', '#39'S'#39') AS ULTIMO'
