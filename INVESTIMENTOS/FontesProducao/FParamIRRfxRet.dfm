  object qryInvestimento: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   IV.IDINVESTIMENTO,'
      '   IV.DESCINVESTIMENTO'
      'FROM'
      'INVESTIMENTO IV, CLASSETITRENFIX CL'
      'WHERE IV.IDTIPOINVEST = 1'
      'AND IV.IDCLASSETIT = CL.IDCLASSETIT'
      'ORDER BY DESCINVESTIMENTO'
      ''
      ' '
      '')
    ValidateWithMask = True
    Left = 324
    Top = 87
