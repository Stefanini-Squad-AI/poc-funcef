      Origin = 'INVESTIMENTO.IDINVESTIMENTO'
      Visible = False
    end
  end
  object qryCarteira: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   IDCARTEIRAINVEST,'
      '   DESCCARTINVEST'
      'FROM'
      '   CARTEIRAINVEST'
      'WHERE'
      '   IDTIPOINVEST = 1'
      'ORDER BY'
