  object qryMovimento: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DATAMOVCARTINV,'
      '       QTDEMOVINVCART,'
      '       ABS(VLRMOVCARTINV) AS VLRMOVCARTINV,'
      '       NATURMOVCARTINV,'
      '       SALDOQTDEINVCART'
      'FROM HISTCARTINV'
      'WHERE (IDTIPOINVEST = 2)'
      '  AND (IDCARTEIRAINVEST = :IDCARTEIRAINVEST)'
      '  AND (IDINVESTIMENTO = :IDINVESTIMENTO)'
      '  AND (DATAMOVCARTINV BETWEEN TO_DATE(:DATAINI,'#39'DD/MM/YYYY'#39') AND'
      '                              TO_DATE(:DATAFIM,'#39'DD/MM/YYYY'#39'))'
      '  AND (TIPMOVCARTINV = '#39'OPE'#39')'
      '  AND (IDTIPOOPERACAO IN (SELECT IDTIPOOPERACAO'
      '                          FROM TIPOOPERACAO'
      '                          WHERE IDTIPOINVEST = 2'
      '                            AND NATUREZAOPERACAO IN ('#39'A'#39','#39'D'#39')'
      '                            AND IDTIPOOPERACAO > 0'
      '                            AND IDMERCADO = 1) )'
      'ORDER BY DATAMOVCARTINV'
      ''
      ''
      ' '
      ' ')
    ValidateWithMask = True
    Left = 224
    Top = 190
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDCARTEIRAINVEST'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'IDINVESTIMENTO'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'DATAINI'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'DATAFIM'
        ParamType = ptInput
      end>
    object qryMovimentoDATAMOVCARTINV: TDateTimeField
      FieldName = 'DATAMOVCARTINV'
    end
    object qryMovimentoQTDEMOVINVCART: TFloatField
      FieldName = 'QTDEMOVINVCART'
    end
    object qryMovimentoVLRMOVCARTINV: TFloatField
      FieldName = 'VLRMOVCARTINV'
    end
    object qryMovimentoNATURMOVCARTINV: TStringField
      FieldName = 'NATURMOVCARTINV'
      FixedChar = True
      Size = 1
    end
    object qryMovimentoSALDOQTDEINVCART: TFloatField
      FieldName = 'SALDOQTDEINVCART'
    end
  end
  object qryBuscaCustoRET: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDACAO, SUM(NVL(CUSTO_RET,0)) AS CUSTO_RET'
      'FROM ACOESXBOLSA'
      'WHERE IDACAO = :IDINVESTIMENTO'
      'GROUP BY IDACAO')
    ValidateWithMask = True
    Left = 176
    Top = 190
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDINVESTIMENTO'
        ParamType = ptInput
      end>
    object qryBuscaCustoRETIDACAO: TFloatField
      FieldName = 'IDACAO'
    end
    object qryBuscaCustoRETCUSTO_RET: TFloatField
      FieldName = 'CUSTO_RET'
    end
  end
