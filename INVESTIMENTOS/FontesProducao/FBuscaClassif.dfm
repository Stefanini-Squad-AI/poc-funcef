  object QryDetalhe: TwwQuery
    DatabaseName = 'BaseDados'
    RequestLive = True
    SQL.Strings = (
      
        'SELECT '#9'CODTABCLASSINV, CODCLASSINVEST, DESCCLASSINVEST,        ' +
        '                 '
      #9'CLASSIFANALIT'
      ''
      'FROM CLASSIFINVEST'
      ''
      'WHERE CODTABCLASSINV = :wCODTABCLASSINV'
      ''
      'ORDER BY CODCLASSINVEST')
    ValidateWithMask = True
    Left = 7
    Top = 54
    ParamData = <
      item
        DataType = ftString
        Name = 'wCODTABCLASSINV'
        ParamType = ptUnknown
      end>
  end
