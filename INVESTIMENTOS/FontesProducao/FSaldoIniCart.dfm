  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update HISTCARTINV'
      'set'
      '  IDDESPCARTINVEST = :IDDESPCARTINVEST,'
      '  IDLANCIMOVEL = :IDLANCIMOVEL,'
      '  PLANO = :PLANO,'
      '  CODDOCUMENTO = :CODDOCUMENTO,'
      '  IDTIPOINVEST = :IDTIPOINVEST,'
      '  PLNCODIGO = :PLNCODIGO,'
      '  IDOPERACAOINVEST = :IDOPERACAOINVEST,'
      '  IDMODULO = :IDMODULO,'
      '  IDEMPRESAPROP = :IDEMPRESAPROP,'
      '  IDTIPOOPERACAO = :IDTIPOOPERACAO,'
      '  IDDESPOPERINVEST = :IDDESPOPERINVEST,'
      '  IDINVESTIMENTO = :IDINVESTIMENTO,'
      '  IDCARTEIRAINVEST = :IDCARTEIRAINVEST,'
      '  IDCARTEIRAGERENC = :IDCARTEIRAGERENC,'
      '  DATAMOVCARTINV = :DATAMOVCARTINV,'
      '  VLRMOVCARTINV = :VLRMOVCARTINV,'
      '  COTASMOVCARTINV = :COTASMOVCARTINV,'
      '  SALDOVLRINVCART = :SALDOVLRINVCART,'
      '  SALDOQTDEINVCART = :SALDOQTDEINVCART,'
      '  SALDOVLRCARTINV = :SALDOVLRCARTINV,'
      '  SALDOCOTASCARTINV = :SALDOCOTASCARTINV,'
      '  HISTMOVCARTINV = :HISTMOVCARTINV,'
      '  NATURMOVCARTINV = :NATURMOVCARTINV,'
      '  TIPMOVCARTINV = :TIPMOVCARTINV,'
      '  FLGCALCSALDO = :FLGCALCSALDO,'
      '  MOVIMATU = :MOVIMATU,'
      '  SALDOATU = :SALDOATU,'
      '  MOVIMCAR = :MOVIMCAR,'
      '  SALDOCAR = :SALDOCAR,'
      '  IDLOTE = :IDLOTE,'
      '  MOVIMAQUI = :MOVIMAQUI,'
      '  SALDOAQUI = :SALDOAQUI,'
      '  SALDOREND = :SALDOREND,'
      '  QTDEMOVINVCART = :QTDEMOVINVCART,'
      '  FLGCUSTODIA = :FLGCUSTODIA,'
      '  RECPAG = :RECPAG,'
      '  NATURMOVOPER = :NATURMOVOPER,'
      '  NUMLANCTO = :NUMLANCTO,'
      '  SALDOJUROS = :SALDOJUROS,'
      '  VLRJUROS = :VLRJUROS,'
      '  SALDOPREMIO = :SALDOPREMIO,'
      '  VLRPREMIO = :VLRPREMIO,'
      '  SALDOVARIACAO = :SALDOVARIACAO,'
      '  SALDOIRPROV = :SALDOIRPROV,'
      '  SALDOIRAPU = :SALDOIRAPU,'
      '  SALDOIOFPROV = :SALDOIOFPROV,'
      '  SALDOIOFAPU = :SALDOIOFAPU,'
      '  SALDOAGIO = :SALDOAGIO,'
      '  IDPLANPREVCTBPATR = :IDPLANPREVCTBPATR,'
      '  SALDOQTDECPMF = :SALDOQTDECPMF'
      'where'
      '  IDHISTCARTINV = :OLD_IDHISTCARTINV'
      ' ')
    InsertSQL.Strings = (
      'insert into HISTCARTINV'
      
        '  (IDHISTCARTINV, IDDESPCARTINVEST, IDLANCIMOVEL, PLANO, CODDOCU' +
        'MENTO, '
      
        '   IDTIPOINVEST, PLNCODIGO, IDOPERACAOINVEST, IDMODULO, IDEMPRES' +
        'APROP, '
      
        '   IDTIPOOPERACAO, IDDESPOPERINVEST, IDINVESTIMENTO, IDCARTEIRAI' +
        'NVEST, '
      
        '   IDCARTEIRAGERENC, DATAMOVCARTINV, VLRMOVCARTINV, COTASMOVCART' +
        'INV, SALDOVLRINVCART, '
      
        '   SALDOQTDEINVCART, SALDOVLRCARTINV, SALDOCOTASCARTINV, HISTMOV' +
        'CARTINV, '
      
        '   NATURMOVCARTINV, TIPMOVCARTINV, FLGCALCSALDO, MOVIMATU, SALDO' +
        'ATU, MOVIMCAR, '
      
        '   SALDOCAR, IDLOTE, MOVIMAQUI, SALDOAQUI, SALDOREND, QTDEMOVINV' +
        'CART, FLGCUSTODIA, '
      
        '   RECPAG, NATURMOVOPER, NUMLANCTO, SALDOJUROS, VLRJUROS, SALDOP' +
        'REMIO, '
      
        '   VLRPREMIO, SALDOVARIACAO, SALDOIRPROV, SALDOIRAPU, SALDOIOFPR' +
        'OV, SALDOIOFAPU, '
      '   SALDOAGIO, IDPLANPREVCTBPATR, SALDOQTDECPMF)'
      'values'
      
        '  (:IDHISTCARTINV, :IDDESPCARTINVEST, :IDLANCIMOVEL, :PLANO, :CO' +
        'DDOCUMENTO, '
      
        '   :IDTIPOINVEST, :PLNCODIGO, :IDOPERACAOINVEST, :IDMODULO, :IDE' +
        'MPRESAPROP, '
      
        '   :IDTIPOOPERACAO, :IDDESPOPERINVEST, :IDINVESTIMENTO, :IDCARTE' +
        'IRAINVEST, '
      
        '   :IDCARTEIRAGERENC, :DATAMOVCARTINV, :VLRMOVCARTINV, :COTASMOV' +
        'CARTINV, '
      
        '   :SALDOVLRINVCART, :SALDOQTDEINVCART, :SALDOVLRCARTINV, :SALDO' +
        'COTASCARTINV, '
      
        '   :HISTMOVCARTINV, :NATURMOVCARTINV, :TIPMOVCARTINV, :FLGCALCSA' +
        'LDO, :MOVIMATU, '
      
        '   :SALDOATU, :MOVIMCAR, :SALDOCAR, :IDLOTE, :MOVIMAQUI, :SALDOA' +
        'QUI, :SALDOREND, '
      
        '   :QTDEMOVINVCART, :FLGCUSTODIA, :RECPAG, :NATURMOVOPER, :NUMLA' +
        'NCTO, :SALDOJUROS, '
      
        '   :VLRJUROS, :SALDOPREMIO, :VLRPREMIO, :SALDOVARIACAO, :SALDOIR' +
        'PROV, :SALDOIRAPU, '
      
        '   :SALDOIOFPROV, :SALDOIOFAPU, :SALDOAGIO, :IDPLANPREVCTBPATR, ' +
        ':SALDOQTDECPMF)'
      ' ')
    DeleteSQL.Strings = (
      'delete from HISTCARTINV'
      'where'
      '  IDHISTCARTINV = :OLD_IDHISTCARTINV')
    Left = 514
    Top = 4
  end
