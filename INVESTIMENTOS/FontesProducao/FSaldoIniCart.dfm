  object qryContrato: TwwQuery
    AfterOpen = qryContratoAfterOpen
    DatabaseName = 'BaseDados'
    DataSource = dtsInvestimento
    SQL.Strings = (
      'SELECT DISTINCT IDLOTE'
      ''
      'FROM CONTRATOINVESTIM'
      ''
      'WHERE IDINVESTIMENTO = :IdInvestimento'
      ''
      'UNION'
      ''
      'SELECT  '#39#39'  AS IDLOTE'
      ''
      'FROM CONTRATOINVESTIM'
      ''
      ''
      'ORDER BY IDLOTE DESC'
      '')
    ValidateWithMask = True
    Left = 311
    Top = 202
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IdInvestimento'
        ParamType = ptUnknown
      end>
