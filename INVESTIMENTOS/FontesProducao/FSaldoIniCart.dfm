  inherited qry: TwwQuery
    AutoCalcFields = False
    AfterScroll = qryAfterScroll
    SQL.Strings = (
      
        'SELECT HIS.IDHISTCARTINV, HIS.IDDESPCARTINVEST, HIS.IDLANCIMOVEL' +
        ', HIS.PLANO, HIS.CODDOCUMENTO,'
      
        '       HIS.IDTIPOINVEST, HIS.PLNCODIGO, HIS.IDOPERACAOINVEST, HI' +
        'S.IDMODULO, HIS.IDEMPRESAPROP,'
      
        '       HIS.IDTIPOOPERACAO, HIS.IDDESPOPERINVEST, HIS.IDINVESTIME' +
        'NTO, HIS.IDCARTEIRAINVEST, HIS.IDCARTEIRAGERENC,'
      
        '       HIS.DATAMOVCARTINV, HIS.VLRMOVCARTINV, HIS.COTASMOVCARTIN' +
        'V, HIS.SALDOVLRINVCART,'
      
        '       HIS.SALDOQTDEINVCART, HIS.SALDOVLRCARTINV, HIS.SALDOCOTAS' +
        'CARTINV, HIS.HISTMOVCARTINV,'
      
        '       HIS.NATURMOVCARTINV, HIS.TIPMOVCARTINV, HIS.FLGCALCSALDO,' +
        ' HIS.MOVIMATU, HIS.SALDOATU,'
      
        '       HIS.MOVIMCAR, HIS.SALDOCAR, HIS.IDLOTE, HIS.MOVIMAQUI, HI' +
        'S.SALDOAQUI, HIS.SALDOREND,'
      
        '       HIS.QTDEMOVINVCART, HIS.FLGCUSTODIA, HIS.RECPAG, HIS.NATU' +
        'RMOVOPER, HIS.NUMLANCTO,'
      
        '       HIS.SALDOJUROS, HIS.VLRJUROS, HIS.SALDOPREMIO, HIS.VLRPRE' +
        'MIO, HIS.SALDOVARIACAO,'
      
        '       HIS.SALDOIRPROV, HIS.SALDOIRAPU, HIS.SALDOIOFPROV, HIS.SA' +
        'LDOIOFAPU, HIS.SALDOAGIO,'
      '       HIS.IDPLANPREVCTBPATR, HIS.SALDOQTDECPMF'
      '               '
      'FROM HISTCARTINV HIS'
      ''
      'WHERE HIS.IDHISTCARTINV = :IDHISTCARTINV'
      ''
      'ORDER BY HIS.DATAMOVCARTINV, HIS.IDHISTCARTINV'
      ' '
      ' '
      ' ')
