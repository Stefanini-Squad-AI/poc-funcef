  object qryCarteira: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT (IDCARTEIRAINVEST) AS ID, DESCCARTINVEST, IDCARTEIRAINVES' +
        'T,'
      '        0 AS IDCARTEIRAGERENC, DATAINICIO'
      'FROM CARTEIRAINVEST'
      'UNION'
      'SELECT'
      '   (IDCARTEIRAINVEST+IDCARTEIRAGERENC+100) AS ID,'
      
        '    DESCCARTGERENC AS DESCCARTINVEST, IDCARTEIRAINVEST, IDCARTEI' +
        'RAGERENC,'
      '    TO_DATE('#39'30/12/2002'#39','#39'DD/MM/YYYY'#39') AS DATAINICIO'
      'FROM CARTEIRAGERENC'
      'ORDER BY DESCCARTINVEST'
      ' '
      ''
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 302
    Top = 72
    object qryCarteiraDESCCARTINVEST: TStringField
      DisplayLabel = 'Carteira'
      DisplayWidth = 40
      FieldName = 'DESCCARTINVEST'
      Origin = 'CARTEIRAINVEST.DESCCARTINVEST'
      Size = 60
    end
    object qryCarteiraIDCARTEIRAINVEST: TFloatField
      FieldName = 'IDCARTEIRAINVEST'
      Origin = 'CARTEIRAINVEST.IDCARTEIRAINVEST'
    end
    object qryCarteiraDATAINICIO: TDateTimeField
      FieldName = 'DATAINICIO'
      Origin = 'CARTEIRAINVEST.DATAINICIO'
    end
    object qryCarteiraIDCARTEIRAGERENC: TFloatField
      FieldName = 'IDCARTEIRAGERENC'
    end
    object qryCarteiraID: TFloatField
      FieldName = 'ID'
    end
  end
