  object QryAchaCustodia: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDCUSTODIA, IDCUSTODIANTE'
      'FROM HISTCUSTODIA'
      'WHERE IDCARTEIRAINVEST = :CARTEIRA AND'
      '      IDINVESTIMENTO = :INVESTIMENTO AND '
      
        '      (((IDLOTE IS NOT NULL) AND (IDLOTE = :IDLOTE)) OR ((IDLOTE' +
        ' IS NULL) AND (:IDLOTE IS NULL))) AND'
      '      TIPOCUSTODIA = '#39'I'#39
      '')
    ValidateWithMask = True
    Left = 396
    Top = 2
    ParamData = <
      item
        DataType = ftInteger
        Name = 'CARTEIRA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'INVESTIMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'IDLOTE'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'IDLOTE'
        ParamType = ptUnknown
      end>
    object QryAchaCustodiaIDCUSTODIA: TFloatField
      FieldName = 'IDCUSTODIA'
