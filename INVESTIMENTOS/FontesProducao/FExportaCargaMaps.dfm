  object QryOperacaoBolsa: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '    OI.DATAOPERACAO,'
      '    OI.QTDEOPERACAO,'
      '    OI.PRECOUNITOPERACAO,'
      '    OI.VLROPERACAO,'
      '    AB.SIGLAACAOBOLSA,'
      '    TP.TIPOCUSTODIA,'
      '    CG.DESCCARTGERENC'
      'FROM'
      
        '    OPERACAOINVEST OI, TIPOOPERACAO TP, ACOESXBOLSA AB, CARTEIRA' +
        'GERENC CG'
      'WHERE'
      '    OI.DATAOPERACAO      =:DATAOPERACAO        AND'
      '    OI.IDTIPOINVEST      = 2                   AND'
      '    OI.IDTIPOOPERACAO    > 0                   AND'
      '    OI.IDOPERACAODIREITO IS NULL               AND'
      '    TP.IDTIPOOPERACAO    = OI.IDTIPOOPERACAO   AND'
      '    AB.IDACAO(+)         = OI.IDINVESTIMENTO   AND'
      '    CG.IDCARTEIRAINVEST  = OI.IDCARTEIRAINVEST AND'
      '    CG.IDCARTEIRAGERENC  = OI.IDCARTEIRAGERENC'
      'ORDER BY AB.SIGLAACAOBOLSA'
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 262
    Top = 171
    ParamData = <
      item
        DataType = ftString
        Name = 'DATAOPERACAO'
        ParamType = ptResult
      end>
  end
  object OpenDialog1: TOpenDialog
    InitialDir = 'C:\'
