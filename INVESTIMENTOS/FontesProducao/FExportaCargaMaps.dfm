    Left = 366
    Top = 79
  end
  object QryPosicaoBolsa: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT'
      '  CG.DESCCARTGERENC,'
      '  AB.SIGLAACAOBOLSA,'
      '  IV.DESCINVESTIMENTO,'
      '  IV.CODISIN,'
      '  H1.IDCARTEIRAINVEST,'
      '  H1.IDINVESTIMENTO,'
      '  H1.IDLOTE,'
      '  AB.QTDELOTE,'
      '  NVL(H1.SALDOQTDEINVCART,0) AS QTDE,'
      
        ' (H1.SALDOVLRINVCART/DECODE(NVL(H1.SALDOQTDEINVCART,0),0,1,H1.SA' +
        'LDOQTDEINVCART)) AS COTACAO,'
      '  H1.SALDOVLRINVCART AS SALDO'
      'FROM'
      '   CM.HISTCARTINV H1, CM.INVESTIMENTO IV, CM.TIPOOPERACAO TP,'
      '   CM.ACOESXBOLSA AB, CM.CARTEIRAGERENC CG'
      'WHERE'
      '   (H1.IDTIPOINVEST = 2)                  AND'
      '   (H1.IDHISTCARTINV  IN'
      '     ('
      '      SELECT MAX(H2.IDHISTCARTINV)'
      '      FROM HISTCARTINV H2'
      '      WHERE'
      '        (H2.IDTIPOINVEST = 2)               AND'
      '        (H2.IDCARTEIRAGERENC IN (10,11))  AND'
      
        '        ((H2.DATAMOVCARTINV || H2.IDINVESTIMENTO || IDCARTEIRAGE' +
        'RENC) IN'
      
        '                            (SELECT (MAX(H3.DATAMOVCARTINV) || I' +
        'DINVESTIMENTO || IDCARTEIRAGERENC)'
      '                             FROM HISTCARTINV H3'
      '                             WHERE'
      
        '                                   (H3.IDTIPOINVEST = 2)        ' +
        '     AND'
      
        '                                   (H3.IDCARTEIRAGERENC IN (10,1' +
        '1))  AND'
      
        '                                   (H3.DATAMOVCARTINV = TO_DATE(' +
        ':DATA,'#39'DD/MM/YYYY'#39'))'
      
        '                             GROUP BY H3.IDINVESTIMENTO, H3.IDCA' +
        'RTEIRAGERENC) )'
      
        '      GROUP BY H2.IDINVESTIMENTO, H2.IDCARTEIRAGERENC))         ' +
        '              AND'
      '   (H1.IDINVESTIMENTO     = IV.IDINVESTIMENTO(+))        AND'
      '   (H1.IDCARTEIRAGERENC   = CG.IDCARTEIRAGERENC)         AND'
      '   (H1.IDCARTEIRAINVEST   = CG.IDCARTEIRAINVEST)         AND'
      '   (AB.IDACAO(+)          = H1.IDINVESTIMENTO)           AND'
      '   (NVL(H1.SALDOQTDEINVCART,0) > 0)'
      'ORDER BY IV.DESCINVESTIMENTO'
      '')
    ValidateWithMask = True
    Left = 158
    Top = 171
    ParamData = <
      item
        DataType = ftString
        Name = 'DATA'
        ParamType = ptResult
      end>
  end
end
