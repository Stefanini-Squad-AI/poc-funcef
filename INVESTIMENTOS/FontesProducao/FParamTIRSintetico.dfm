  object qryInvestimentosNew: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '     IDINVESTIMENTO,DESCINVESTIMENTO '
      'FROM '
      '     INVESTIMENTO '
      'WHERE'
      '     IDTIPOINVEST = :IDTIPOINVEST'
