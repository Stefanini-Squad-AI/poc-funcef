  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT'
      '   OP.IDOPEREMPACOES,'
      '   OP.IDCUSTODIANTE,'
      '   OP.IDCARTEIRAINVEST,'
      '   OP.IDINVESTIMENTO,'
      '   OP.IDTIPOINVEST,'
      '   OP.IDTIPOOPERACAO,'
      '   OP.DATAOPERACAO,'
      '   OP.DATAVENCOPER,'
      '   OP.VLROPERACAO,'
      '   OP.QTDOPERACAO,'
      '   OP.PUOPERACAO,'
      '   OP.TAXAOPERACAO,'
      '   OP.VLRIR,'
      '   OP.FLGREVERSAO,'
      '   OP.FLGPRECO,'
      '   OP.IDOPEREMPACOESAP,'
      '   OP.VLRRESGATE,'
      '   OP.VLRJUROS,'
      '   OP.TIPOCONFIRMADO, '
      '   0 AS VLRRESGATEATU,'
      '   VLRRESGATE-VLROPERACAO AS VALOREMPRESTIMO,'
      '   IV.DESCINVESTIMENTO,'
      '   CU.SGLCUSTODIANTE,'
      '   TP.DESCTIPOOPERACAO,'
      '   OP.PLNCODIGO,'
      '   OP.CODDOCUMENTO,'
      '   OP.IDPLANPREVCTBPATR'
      'FROM'
      '   OPEREMPACOES OP, INVESTIMENTO IV, TIPOOPERACAO TP,'
      '   CUSTODIANTE CU'
      'WHERE'
      '   IDOPEREMPACOES = :IDOPEREMPACOES'
      '   AND OP.IDINVESTIMENTO = IV.IDINVESTIMENTO'
      '   AND OP.IDTIPOOPERACAO = TP.IDTIPOOPERACAO'
      '   AND OP.IDCUSTODIANTE  = CU.IDCUSTODIANTE'
      ' '
      ' '
      ' '
      ' '
      ' ')
    Left = 197
    Top = 99
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDOPEREMPACOES'
        ParamType = ptUnknown
      end>
