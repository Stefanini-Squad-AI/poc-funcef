  object QryBuscaCotacao: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '       CT.DATACOTAACAO,CT.VLRMEDIA, CT.QTDELOTE '
      'FROM'
      '       COTACAOACAO CT,'
      '       (SELECT '
      '               MAX(DATACOTAACAO) AS DATA'
      '        FROM '
      '               COTACAOACAO'
      '        WHERE'
      '               (IDACAO = :iIDACAO) AND'
      
        '               (DATACOTAACAO <= TO_DATE(:dDataRef,'#39'DD/MM/YYYY'#39'))' +
        ' AND'
      '               (VLRMEDIA > 0)'
      '        ) CT1'
      'WHERE'
      '        (CT.DATACOTAACAO = DATA) AND'
      '        (IDACAO = :iIDACAO)'
      ''
      ''
      ''
      ''
      ''
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 477
    Top = 213
    ParamData = <
      item
        DataType = ftInteger
        Name = 'iIDACAO'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'dDataRef'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'iIDACAO'
        ParamType = ptUnknown
      end>
    object QryBuscaCotacaoDATACOTAACAO: TDateTimeField
      FieldName = 'DATACOTAACAO'
    end
    object QryBuscaCotacaoVLRMEDIA: TFloatField
      FieldName = 'VLRMEDIA'
    end
    object QryBuscaCotacaoQTDELOTE: TFloatField
      FieldName = 'QTDELOTE'
    end
  end
