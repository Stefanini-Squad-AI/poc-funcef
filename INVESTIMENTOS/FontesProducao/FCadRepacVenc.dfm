  object qryOperAplic: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT I.DESCINVESTIMENTO, O.DATAOPERACAO, O.QTDEOPERACAO, O.PUO' +
        'PERACAO, O.VLROPERACAO,'
      
        '       O.DATAEMISSAO, O.PUEMISSAO, O.VENCOPERACAO, O.IDOPERRENFI' +
        'X, O.IDINVESTIMENTO,'
      '       O.IDPLANPREVCTBPATR, I.IDCLASSETIT'
      'FROM OPERRENFIX O, INVESTIMENTO I'
      'WHERE O.IDOPERRENFIX = :IDOPERRENFIX'
      '  AND O.IDINVESTIMENTO = I.IDINVESTIMENTO'
