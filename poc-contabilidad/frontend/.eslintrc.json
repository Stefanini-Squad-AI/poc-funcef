{
  "extends": "next/core-web-vitals",
  "plugins": ["boundaries"],
  "settings": {
    "boundaries/elements": [
      {
        "type": "app",
        "pattern": "src/app/**"
      },
      {
        "type": "features",
        "pattern": "src/features/**",
        "capture": ["feature"]
      },
      {
        "type": "core",
        "pattern": "src/core/**"
      },
      {
        "type": "shared",
        "pattern": "src/shared/**"
      }
    ]
  },
  "rules": {
    "boundaries/element-types": [
      "error",
      {
        "default": "disallow",
        "rules": [
          {
            "from": "app",
            "allow": ["features", "core", "shared"]
          },
          {
            "from": "features",
            "allow": ["core", "shared"]
          },
          {
            "from": "features",
            "disallow": ["features"]
          },
          {
            "from": "core",
            "allow": ["shared"]
          },
          {
            "from": "shared",
            "allow": []
          }
        ]
      }
    ],
    "boundaries/no-unknown-files": "error"
  }
}
