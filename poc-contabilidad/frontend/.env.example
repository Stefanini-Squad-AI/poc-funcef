# API Backend
NEXT_PUBLIC_API_URL=https://localhost:5001

# Ambiente
NODE_ENV=development

# IdEmpresa: ID da empresa/pessoa selecionada (equivale a Sistema.IdEmpresa no legacy)
# No legacy, é definido no login. Aqui, configurável para testar diferentes empresas.
# Empresa 1 = FLGSEGREGAVIRTUAL='N' (Rateio/antigo)
# Empresa 2 = FLGSEGREGAVIRTUAL='S' (Segregação/novo)
NEXT_PUBLIC_ID_EMPRESA=1

# Entra ID (optional - para quando integrar auth)
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
