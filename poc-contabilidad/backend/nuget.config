<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Feed local do Funcef-kit (versão 3.0.0 já disponível) -->
    <add key="funcef-local" value="../../poc-funcef/Funcef-kit/feeds/nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- GitHub Packages (comentado - descomentar se precisar versão 3.1+) -->
    <!-- <add key="funcef-componentes" value="https://nuget.pkg.github.com/funcef-componentes/index.json" /> -->
  </packageSources>

  <packageSourceMapping>
    <!-- FUNCEF packages vêm do feed local -->
    <packageSource key="funcef-local">
      <package pattern="FUNCEF.*" />
    </packageSource>
    <!-- Todo o resto vem do nuget.org -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Credenciais só necessárias para GitHub Packages -->
  <!--
  <packageSourceCredentials>
    <funcef-componentes>
      <add key="Username" value="funcef" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </funcef-componentes>
  </packageSourceCredentials>
  -->
</configuration>
