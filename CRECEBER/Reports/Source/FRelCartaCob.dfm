  object SqlModelo: TCMSqlParams
    SQL.Strings = (
      'SELECT IDCARTACOBRANCA, MODELOCARTA, IDREPORTS, ORIGEMCM'
      'FROM CARTACOBRANCA'
      'WHERE (IDREPORTS IS NOT NULL) AND'
      
        '               ((FLGTIPOCARTA = '#39'C'#39') OR (FLGTIPOCARTA IS NULL)) ' +
        ' AND '
      '               (MODELOCARTA IS NOT NULL)      '
      'ORDER BY  MODELOCARTA')
    ClientDataSet = CdsModelo
    Left = 354
    Top = 38
  end
