  end
  object SQLPagamentos: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   P.RAZAOSOCIAL AS NOME,'
      '   D.NODOCUMENTO,'
      '   D.COMPLDOCUMENTO,'
      '   L.DATALANCTO,'
      '   L.VALOR,'
      '   L.VALOROUTRAMOEDA,'
      '   D.CODDOCUMENTO,'
      '   L.NUMLANCTO,'
      '   L.PLNCODIGO,'
      '   R.CODLANCFINANC,'
      '   R.NUMCHQBORDERO,'
      '   L.OPERACAO, R.NUMLOTE,'
      '   R.DATACFLOAT,'
      '   R.CODLANCNAOIDENT,'
      '   DECODE(D.RECPAG,'#39'R'#39','
      '   R.NUMCHQBORDERO,'
      '   TO_CHAR(R.NUMLOTE)) AS LOTE,'
      '   L.NUMLOTEMANUAL,'
      '   D.FLGTIPODOCUMENTO'
      'FROM'
      '   PESSOA P,'
      '   DOCUMENTO D,'
      '   LANCTODOCUM L,'
      '   RECBTOPAGTO R'
      'WHERE'
      '   (1=2)')
    ClientDataSet = CdsPagamentos
    Left = 541
    Top = 53
  end
