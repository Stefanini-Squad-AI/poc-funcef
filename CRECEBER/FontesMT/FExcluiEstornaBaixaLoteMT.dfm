  object SQLSelecionados: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   P.RAZAOSOCIAL AS NOME,'
      '   D.NODOCUMENTO,'
      '   D.COMPLDOCUMENTO,'
      '   L.DATALANCTO,'
      '   L.VALOR,'
      '   L.VALOROUTRAMOEDA,'
      '   D.CODDOCUMENTO,'
      '   L.NUMLANCTO,'
      '   L.PLNCODIGO,'
      '   R.CODLANCFINANC,'
      '   R.NUMCHQBORDERO,'
      '   L.OPERACAO,'
      '   R.NUMLOTE,'
      '   R.DATACFLOAT,'
      '   R.CODLANCNAOIDENT,'
      '   DECODE(D.RECPAG,'#39'R'#39',R.NUMCHQBORDERO,R.NUMLOTE) AS LOTE,'
      '   L.NUMLOTEMANUAL,'
      '   D.FLGTIPODOCUMENTO'
      'FROM'
      '   LANCTODOCUM L,'
      '   DOCUMENTO D,'
      '   RECBTOPAGTO R,'
      '   PESSOA P'
      'WHERE'
      '  (1=2)')
    ClientDataSet = CdsSelecionados
    Left = 673
    Top = 53
  end
