  object SQLExcluiEstornaFinanc: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   (0) AS LOTE,'
      '   P.RAZAOSOCIAL AS NOME,'
      '   D.NODOCUMENTO,'
      '   D.COMPLDOCUMENTO,'
      '   L.DATALANCTO,'
      '   L.VALOR,'
      '   L.VALOROUTRAMOEDA,'
      '   D.CODDOCUMENTO,'
      '   L.NUMLANCTO,'
      '   L.PLNCODIGO,'
      '   R.CODLANCFINANC,'
      '   R.NUMCHQBORDERO,'
      '   L.OPERACAO,'
      '   R.NUMLOTE,'
      '   R.DATACFLOAT,'
      '   R.CODLANCNAOIDENT'
      'FROM'
      '   LANCTODOCUM L,'
      '   DOCUMENTO D,'
      '   RECBTOPAGTO R,'
      '   PESSOA P'
      'WHERE'
      '   (1=2)'
      ' ')
    ClientDataSet = CdsExcluiEstornaFinanc
    Left = 421
    Top = 53
  end
