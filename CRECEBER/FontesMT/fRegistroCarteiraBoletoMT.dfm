  object sqlContas: TCMSqlParams
    SQL.Strings = (
      'SELECT PO.CODPORTFORMA,'
      '             PO.DESCRICAO'
      '  FROM PORTADORFORMA PO'
      ' WHERE PO.RECPAG = '#39'R'#39
      '   AND NVL(PO.FLGATIVO, '#39'S'#39') = '#39'S'#39
      '   AND PO.IDCONFIGBARRAS IS NOT NULL'
      '   AND PO.NUMEMPRESABANCO IS NOT NULL'
      ' ORDER BY PO.DESCRICAO')
    ClientDataSet = cdsContas
    Left = 120
    Top = 84
  end
