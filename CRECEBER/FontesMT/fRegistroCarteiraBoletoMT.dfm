  object sqlSelecionados: TCMSqlParams
    SQL.Strings = (
      'SELECT D.CODDOCUMENTO , '
      '       D.NODOCUMENTO,'
      '       P.RAZAOSOCIAL,'
      '       D.DATAPROGRAMADA,'
      '       D.NOSSONUMERO,'
      '       LANC.VLR_LIQ AS VALOR'
      'FROM DOCUMENTO D'
      ' JOIN PESSOA P ON (P.IDPESSOA = D.IDFORCLI)'
      
        ' Left outer JOIN ( SELECT L.CODDOCUMENTO, SUM(DECODE(L.DEBCRE, '#39 +
        'C'#39', L.VALOR *-1, L.VALOR)) AS VLR_LIQ'
      '        FROM LANCTODOCUM L  '
      '       WHERE L.OPERACAO <> 5'
      
        '       GROUP BY L.CODDOCUMENTO) LANC ON LANC.CODDOCUMENTO = D.CO' +
        'DDOCUMENTO'
      ' WHERE D.RECPAG = '#39'R'#39
      ' AND  D.CODDOCUMENTO  = -1'
      ' ORDER BY D.DATAPROGRAMADA, P.RAZAOSOCIAL, LANC.VLR_LIQ')
    ClientDataSet = cdsSelecionados
    Left = 113
    Top = 480
  end
  object sqlDisponiveis: TCMSqlParams
    SQL.Strings = (
      'SELECT D.CODDOCUMENTO , '
      '       D.NODOCUMENTO,'
      '       P.RAZAOSOCIAL,'
      '       D.DATAPROGRAMADA,'
      '       D.NOSSONUMERO,'
      '       LANC.VLR_LIQ AS VALOR'
      'FROM DOCUMENTO D'
      ' JOIN PESSOA P ON (P.IDPESSOA = D.IDFORCLI)'
      
        ' Left outer JOIN ( SELECT L.CODDOCUMENTO, SUM(DECODE(L.DEBCRE, '#39 +
        'C'#39', L.VALOR *-1, L.VALOR)) AS VLR_LIQ'
      '        FROM LANCTODOCUM L  '
      '       WHERE L.OPERACAO <> 5'
      
        '       GROUP BY L.CODDOCUMENTO) LANC ON LANC.CODDOCUMENTO = D.CO' +
        'DDOCUMENTO'
      ' WHERE D.RECPAG = '#39'R'#39
      ' AND  D.CODDOCUMENTO  = -1'
      ' ORDER BY D.DATAPROGRAMADA, P.RAZAOSOCIAL, LANC.VLR_LIQ')
    ClientDataSet = cdsDisponiveis
    Left = 108
    Top = 272
  end
