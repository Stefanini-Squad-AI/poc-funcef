  object sqlModulos: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  IDMODULO, NOMEMODULO '
      'FROM MODULO '
      'ORDER BY NOMEMODULO'
      '')
    ClientDataSet = cdsModulos
    Left = 224
    Top = 128
  end
  object sqlLancamento: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  D.IDMODULO AS COD_PROCESSO,'
      '  TO_CHAR(SYSDATE, '#39'DD/MM/YYYY'#39') AS DATA_PROCESSAMENTO,'
      '  D.NODOCUMENTO AS NODOCUMENTO,'
      '  D.IDPESSOA AS COD_EMPRESA,'
      '  RD.CODCENTRORESPON,'
      
        '  DECODE(D.RECPAG,'#39'R'#39',CP.CODCLIENTE, FS.CODCORRESP) AS COD_FORCL' +
        'I,'
      '  RD.CODTIPRECDES,'
      '  D.CODFORMA,'
      '  D.DATAVENCTO,'
      '  D.DATAPROGRAMADA,'
      '  1 AS AGRUPA,'
      '  0 AS AUTENTICA,'
      '  SUBSTR(OBS,1,255) AS DESCRICAO,'
      '  RD.IDPROGRAMA,'
      '  RD.IDPLANOPREV,'
      '  CC.CODEXTERNO AS COD_CENTRO_CUSTO,'
      '  SUM( DECODE(D.RECPAG, '#39'R'#39','
      '              DECODE(LD.DEBCRE,'#39'D'#39', LD.VALOR, LD.VALOR * -1),'
      
        '              DECODE(LD.DEBCRE,'#39'C'#39', LD.VALOR, LD.VALOR * -1) ) )' +
        ' AS VLR_LIQUIDO'
      
        ' FROM DOCUMENTO D, LANCTODOCUM LD, RATEIODOCUM RD, CLIENTEPESS C' +
        'P, FORNSERV FS,'
      '      CENTCUST CC'
      'WHERE D.CODDOCUMENTO = 129220 AND'
      '      RTRIM(LD.OPERACAO) IN(2,4) AND'
      '      D.CODDOCUMENTO = LD.CODDOCUMENTO AND'
      '      D.CODDOCUMENTO = RD.CODDOCUMENTO AND'
      '      RD.CODCENTROCUSTO = CC.CODCENTROCUSTO(+) AND'
      '      D.IDFORCLI = CP.IDPESSOA(+) AND'
      '      D.IDFORCLI = FS.IDPESSOA(+)'
      
        'GROUP BY D.IDMODULO, TO_CHAR(SYSDATE, '#39'DD/MM/YYYY'#39'), D.NODOCUMEN' +
        'TO,'
      
        '         D.IDPESSOA, RD.CODCENTRORESPON, DECODE(D.RECPAG,'#39'R'#39',CP.' +
        'CODCLIENTE, FS.CODCORRESP),'
      
        '         RD.CODTIPRECDES, D.CODFORMA, D.DATAVENCTO, D.DATAPROGRA' +
        'MADA, 1, 0,'
      
        '         SUBSTR(OBS,1,255), RD.IDPROGRAMA, RD.IDPLANOPREV, CC.CO' +
        'DEXTERNO'
      ''
      '')
    ClientDataSet = cdsLancamento
    Left = 296
    Top = 128
  end
