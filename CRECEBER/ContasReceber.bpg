#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = ContasaReceber.exe CmCapCarUtilObj50.bpl CMCapCarObj50.bpl \
  CMCfinanObj50.bpl CMContabObj50.bpl CMPlaneOrcObj50.bpl CMIntBancoMT50.bpl \
  CMCompo50.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

ContasaReceber.exe: FontesMT\ContasaReceber.dpr
  $(DCC)

CmCapCarUtilObj50.bpl: ..\CmCapCarUtilObj50\Package\CmCapCarUtilObj50.dpk
  $(DCC)

CMCapCarObj50.bpl: ..\CMCapCarObj50\Package\CMCapCarObj50.dpk
  $(DCC)

CMCfinanObj50.bpl: ..\CMCfinanObj50\Package\CMCfinanObj50.dpk
  $(DCC)

CMContabObj50.bpl: ..\CMContabObj50\Package\CMContabObj50.dpk
  $(DCC)

CMPlaneOrcObj50.bpl: ..\CMPlaneOrcObj50\Package\CMPlaneOrcObj50.dpk
  $(DCC)

CMIntBancoMT50.bpl: ..\CMIntBancoMT50\Package\CMIntBancoMT50.dpk
  $(DCC)

CMCompo50.bpl: ..\CM\componentescm\package\CMCompo50.dpk
  $(DCC)


