package dxPSCored5;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $00400000}
{$DESCRIPTION 'ExpressPrinting System (core 2.0) by Developer Express Inc.'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  vclx50,
  VCL50,
  dxComnd5;

contains
  dxPSPrVwStd,
  dxPSRes,
  dxFEFDlg,
  dxBrhDlg,
  dxBase,
  dxPrnPg,
  dxPSGlbl,
  dxfmClr,
  dxPcPrVw,
  dxPrnDlg,
  dxPreVw,
  dxPSCore,
  dxPPAttr,
  dxPrnDev,
  dxBkgnd,
  dxWrap,
  dxPSUtl,
  dxFmMnPg,
  dxfmZoom,
  dxPgSDlg,
  dxPSImgs,
  dxPSPrVwOpt,
  dxPSfmttl,
  dxPSPopupMan,
  dxfmpnfmt,
  dxfmDTFmt,
  dxfmDfnStl,
  dxPSEvnt,
  dxPSESys,
  dxPSEngn,
  dxPSPrVw,
  dxPSForm,
  dxPSPgsMnuBld,
  dxfmChFN,
  dxExtCtrlsStrs,
  dxExtctrls;

end.
