package ip50_d5;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'InfoPower 2000 for Delphi 5'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  VCL50,
  VCLX50,
  VCLDB50,
  VCLBDE50,
  CmSql50;

contains
  wwdbgrid in '..\source\wwdbgrid.pas',
  wwtable in '..\source\wwtable.pas',
  wwmemo in '..\source\wwmemo.pas',
  wwdblook in '..\source\wwdblook.pas',
  wwidlg in '..\source\wwidlg.pas',
  wwdbdlg in '..\source\wwdbdlg.pas',
  wwquery in '..\source\wwquery.pas',
  wwkeycb in '..\source\wwkeycb.pas',
  wwdotdot in '..\source\wwdotdot.pas',
  wwdatsrc in '..\source\wwdatsrc.pas',
  wwqbe in '..\source\wwqbe.pas',
  wwlocate in '..\source\wwlocate.pas',
  wwdbcomb in '..\source\wwdbcomb.pas',
  wwdbspin in '..\source\wwdbspin.pas',
  wwdbedit in '..\source\wwdbedit.pas',
  wwfltdlg in '..\source\wwfltdlg.pas',
  wwintl in '..\source\wwintl.pas',
  wwstorep in '..\source\wwstorep.pas',
  wwriched in '..\source\wwriched.pas',
  wwrcdvw in '..\source\wwrcdvw.pas',
  wwrich in '..\source\wwrich.pas',
  wwrichtb in '..\source\wwrichtb.pas',
  wwrchdlg in '..\source\wwrchdlg.pas',
  wwfltvw in '..\source\wwfltvw.pas',
  wwfltdum in '..\source\wwfltdum.pas',
  wwspin in '..\source\wwspin.pas',
  wwdbigrd in '..\source\wwdbigrd.pas',
  wwcommon in '..\source\wwcommon.pas',
  wwpict in '..\source\wwpict.pas',
  wwsystem in '..\source\wwsystem.pas',
  wwfilter in '..\source\wwfilter.pas',
  wwstacks in '..\source\wwstacks.pas',
  wwstr in '..\source\wwstr.pas',
  wwtypes in '..\source\wwtypes.pas',
  wwrcdpnl in '..\source\wwrcdpnl.pas',
  wwDialog in '..\source\wwDialog.pas',
  wwDBNavigator in '..\source\wwDBNavigator.pas',
  wwdbdatetimepicker in '..\source\wwdbdatetimepicker.pas',
  wwmonthcalendar in '..\source\wwmonthcalendar.pas',
  wwSpeedButton in '..\source\wwSpeedButton.pas',
  wwricholecallback in '..\source\wwricholecallback.pas',
  wwTrackIcon in '..\source\wwTrackIcon.pas',
  wwrichole in '..\source\wwrichole.pas',
  wwcollection in '..\source\wwcollection.pas',
  wwDataInspector in '..\source\wwDataInspector.pas',
  wwFrame in '..\source\wwFrame.pas',
  wwClearPanel in '..\source\wwClearPanel.pas';

end.
