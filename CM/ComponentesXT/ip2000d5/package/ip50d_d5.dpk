package ip50d_d5;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Woll2Woll InfoPower 2000'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  ip50_d5;

contains
  infopowr in '..\source\infopowr.pas',
  ipabout in '..\source\ipabout.pas',
  ipdsgn in '..\source\ipdsgn.pas',
  wwprpds in '..\source\wwprpds.pas',
  wwprpedt in '..\source\wwprpedt.pas',
  wwpiced2 in '..\source\wwpiced2.pas',
  wwfltfld in '..\source\wwfltfld.pas',
  wwselfld in '..\source\wwselfld.pas',
  wwprppic in '..\source\wwprppic.pas',
  wwpicdb in '..\source\wwpicdb.pas',
  wwprpfld in '..\source\wwprpfld.pas',
  wwaddlk in '..\source\wwaddlk.pas',
  wwgttbl in '..\source\wwgttbl.pas',
  wwprpcom in '..\source\wwprpcom.pas',
  wwDBNavEdt in '..\source\wwDBNavEdt.pas',
  wwcollectioneditor in '..\source\wwcollectioneditor.pas',
  wwInspectorPrpEdt in '..\source\wwInspectorPrpEdt.pas',
  wwinspectorprop in '..\source\wwinspectorprop.pas',
  wwedtpic in '..\source\wwedtpic.pas';

end.
