package Ml42ND50;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Multilizer Components: Non-Data-Aware'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  Vclx50;

contains
  IvAMulti in 'IvAMulti.pas',
  IvBinDic in 'IvBinDic.pas',
  IvCommon in 'IvCommon.pas',
  IvConMod in 'IvConMod.pas',
  IvDialog in 'IvDialog.pas',
  IvDictio in 'IvDictio.pas',
  IvDlgMod in 'IvDlgMod.pas',
  IvDsMult in 'IvDsMult.pas',
  IvEBinDi in 'IvEBinDi.pas',
  IvEFiMul in 'IvEFiMul.pas',
  IvEMulti in 'IvEMulti.pas',
  IvFiMult in 'IvFiMult.pas',
  IvLanguD in 'IvLanguD.pas' {IvLanguageDialog},
  IvLaSelD in 'IvLaSelD.pas' {IvLanguageSelectDialog},
  IvLoSelD in 'IvLoSelD.pas' {IvLocaleSelectDialog},
  IvMlCons in 'IvMlCons.pas',
  IvMLDFil in 'IvMLDFil.pas',
  IvMlDlgs in 'IvMlDlgs.pas',
  IvMlRead in 'IvMlRead.pas',
  IvMLTP in 'IvMLTP.pas',
  IvMlUtil in 'IvMlUtil.pas',
  IvMulti in 'IvMulti.pas',
  IvParser in 'IvParser.pas',
  IvPSDlg in 'IvPSDlg.pas',
  IvReader in 'IvReader.pas',
  IvSocket in 'IvSocket.pas',
  IvSuSeld in 'IvSuSelD.pas' {IvSubLanguageSelectDialog},
  IvSynchr in 'IvSynchr.pas',
  IvTestDi in 'IvTestDi.pas',
  IvTests in 'IvTests.pas',
  IvUMulti in 'IvUMulti.pas',
  IvUsrDic in 'IvUsrDic.pas',
  IvUTF8 in 'IvUTF8.pas',
  IvWParser in 'IvWParser.pas',
  IvWReader in 'IvWReader.pas',
  Odbc in 'ODBC.pas',
  IvDatDic in 'IvDatDic.pas',
  IvODBCDic in 'IvODBCDic.pas',
  IvConnection in 'IvConnection.pas',
  IvWMLDFi in 'IvWMLDFi.pas',
  IvStrLst in 'IvStrLst.pas',
  IvCacDic in 'IvCacDic.pas';

end.
