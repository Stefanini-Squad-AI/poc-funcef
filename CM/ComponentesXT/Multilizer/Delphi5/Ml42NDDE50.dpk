package Ml42NDDE50;

{$R *.RES}
{$R 'IvMulReg.dcr'}
{$R 'IvOldReg.dcr'}
{$R 'IvDlgReg.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Multilizer Components'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  Ml42ND50;

contains
  IvTargD in 'IvTargD.pas' {IvTargetPropertyDialog},
  IvTargsd in 'IvTargsD.pas' {IvTargetPropertiesDialog},
  IvAboutD in 'IvAboutD.pas' {IvAboutDialog},
  IvPassWD in 'IvPassWD.pas' {IvPasswordDialog},
  IvFiltEd in 'IvFiltEd.pas' {IvFilterEditor},
  IvMulReg in 'IvMulReg.pas',
  IvOldReg in 'IvOldReg.pas',
  IvDlgReg in 'IvDlgReg.pas';

end.
