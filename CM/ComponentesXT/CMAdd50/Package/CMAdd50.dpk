package CMAdd50;

{$R *.RES}
{$R CMADD50_RES.RES}

{$R 'CMAdd50.DCR'}
{$R '..\Source\FSMTimer.dcr'}
{$R '..\source\DialUp.dcr'}
{$R '..\Source\WinshoesWinInet.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Additional Components'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  ip50_d5;

{%File '..\Source\FSM.inc'}

contains
  RegCmAdd50 in '..\Source\RegCmAdd50.pas',
  SortGrid in '..\Source\SortGrid.pas',
  UNZDLL in '..\Source\UnzDll.pas',
  ZCallBck in '..\Source\ZCallBck.pas',
  ZIPDLL in '..\Source\ZipDll.pas',
  ZipMsg in '..\Source\ZipMsg.pas',
  ZipMstr in '..\Source\ZipMstr.pas',
  RipeMD in '..\Source\RIPEMD.PAS',
  Twofish in '..\Source\TWOFISH.PAS',
  BfConsts in '..\Source\BfConsts.pas',
  BfDialogs in '..\Source\BfDialogs.pas',
  BfFileUtils in '..\Source\BfFileUtils.pas',
  BftdUtils in '..\Source\BftdUtils.pas',
  BrowseFolder in '..\Source\BrowseFolder.pas',
  uProcuraDir in '..\Source\uProcuraDir.pas',
  ComPort in '..\Source\Comport.pas',
  TaskIcon in '..\Source\TASKICON.PAS',
  TrayIcon in '..\Source\Trayicon.pas',
  CMNetUsers in '..\Source\CMNetUsers.pas',
  ZipDir in '..\Source\Zipdir.pas',
  FSM_DbFxLib in '..\Source\FSM_DBFxLib.pas',
  FSM_DelphiLib in '..\Source\FSM_DelphiLib.pas',
  FSM_FxLib in '..\Source\FSM_FxLib.pas',
  FSM_WinAPILib in '..\Source\FSM_WinApiLib.pas',
  FSMTimer in '..\Source\FSMTimer.pas',
  FSMConsts in '..\Source\FSMConsts.pas',
  DialUp in '..\Source\DialUp.pas',
  WinInetControl in '..\Source\wininetcontrol.pas',
  SimpFTP in '..\Source\SimpFTP.pas',
  RGStrFuncs in '..\Source\rgstrfuncs.pas',
  RGFileutil in '..\Source\RGFileUtil.pas',
  SdfData in '..\Source\SdfData.pas';

end.
