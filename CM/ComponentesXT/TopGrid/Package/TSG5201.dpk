package TSG5201;

{$R *.RES}
{$R 'TSGrid.dcr'}
{$R 'TSMask.dcr'}
{$R 'TSImageList.dcr'}
{$R 'TSDateTime.dcr'}
{$ALIGN ON}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS OFF}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Top Support TopGrid - Non Data Aware Grid Component'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl50;

contains
  TSGrid in '..\Source\TSGrid.pas',
  TSMask in '..\Source\TSMask.pas',
  TSImageList in '..\Source\TSImageList.pas',
  TSDateTime in '..\Source\TSDateTime.pas',
  TSCommon in '..\Source\TSCommon.pas',
  TSGLib in '..\Source\TSGLib.pas',
  TSDateTimeDef in '..\Source\TSDateTimeDef.pas',
  TSMbcs in '..\Source\TSMbcs.pas',
  TSSetLib in '..\Source\TSSetLib.pas',
  Grids_ts in '..\Source\Grids_ts.pas';

end.
