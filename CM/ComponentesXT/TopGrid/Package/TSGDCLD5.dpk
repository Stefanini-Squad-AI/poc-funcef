package TSGDCLD5;

{$R *.RES}
{$R 'TsDesign.dcr'}
{$ALIGN ON}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS OFF}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Top Support TopGrid Components'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  VCLDB50,
  TSG5201,
  TSDG5201;

contains
  TsEditor in '..\Source\TsEditor.pas',
  TsDesign in '..\Source\TsDesign.pas',
  TSImagelistEditor in '..\Source\TSImagelistEditor.pas',
  TSDateTimeEditor in '..\Source\TSDateTimeEditor.pas',
  TSGReg in '..\Source\TSGReg.pas',
  TSSetName in '..\Source\TSSetName.pas';

end.
