package xtradev;

{$R *.RES}
{$R 'txcomp.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $00400000}
{$DESCRIPTION 'Extra ReportBuilder Devices'}
{$IMPLICITBUILD ON}

requires
  VCL40,
  VCLJPG40,
  RBRCL54;

contains
  TXtraDev in 'TXtraDev.pas',
  TXComp in 'txcomp.pas',
  TXTIFF in 'txtiff.pas',
  TXParse in 'TXParse.pas';

end.
