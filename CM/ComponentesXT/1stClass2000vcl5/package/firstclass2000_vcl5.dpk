package FirstClass2000_vcl5;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Woll2Woll 1stClass 2000'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  VCL50,
  VCLDB50,
  VCLX50,
  Vclbde50;

contains
  fcClearPanel,
  fcCollection,
  fcColorCombo,
  fcCombo,
  fcCommon,
  fcOutlookBar,
  fcButtonGroup,
  fcimageform,
  fcGraphics,
  fcChangeLink,
  fcLabel,
  fcMsg,
  fcStatusBar,
  fcImager,
  fcButton,
  fcText,
  fcDBTreeView,
  fcCanvas,
  fcDBCommon,
  fcScrollBar,
  fcImage,
  fcShapeBtn,
  fcEvaluator,
  fcOutlookList,
  fcCustomDraw,
  fcImgBtn,
  fcBitmap,
  fcFontCombo,
  fcToolTip,
  fcTreeCombo,
  fcTreeView,
  fcframe,
  fcDemoRichEdit;

end.
