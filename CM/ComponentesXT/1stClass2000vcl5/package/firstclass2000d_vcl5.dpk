package FirstClass2000d_d5;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Woll2Woll 1stClass 2000'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  VCL50,
  VCLDB50,
  VCLX50,
  Vclbde50,
  firstclass2000_vcl5;

contains
  fcAbout in '..\source\fcAbout.pas',
  fcCollectionEditor in '..\source\fcCollectionEditor.pas',
  fClass in '..\source\fClass.pas',
  fcPicEdt in '..\source\fcPicEdt.pas',
  fcLinesEditor in '..\source\fcLinesEditor.pas',
  fcTreeView_ItemsEditor in '..\source\fcTreeView_ItemsEditor.pas',
  fcPropEdt in '..\source\fcPropEdt.pas';

end.
