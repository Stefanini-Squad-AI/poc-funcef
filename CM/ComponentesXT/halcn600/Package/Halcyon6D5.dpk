package Halcyon6D5;

{$R *.RES}
{$R 'Halcn6rg.DCR'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Halcyon Database Engine Version 6'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  vcl50,
  vcldb50,
  Vclx50,
  Vclbde50,
  ip50_d5;

{%File '..\source\c001p437.nls'}

contains
  gs6_cdx in '..\source\gs6_cdx.pas',
  gs6_cnst in '..\source\gs6_cnst.pas',
  gs6_Date in '..\source\gs6_date.pas',
  gs6_DBF in '..\source\gs6_DBF.pas',
  gs6_dbsy in '..\source\gs6_dbsy.pas',
  gs6_disk in '..\source\gs6_disk.pas',
  gs6_encrxm in '..\source\gs6_encrxm.pas',
  gs6_eror in '..\source\gs6_eror.pas',
  gs6_glbl in '..\source\gs6_glbl.pas',
  gs6_indx in '..\source\gs6_indx.pas',
  gs6_lcal in '..\source\gs6_lcal.pas',
  gs6_mdx in '..\source\gs6_mdx.pas',
  gs6_memo in '..\source\gs6_memo.pas',
  gs6_mix in '..\source\gs6_mix.pas',
  gs6_ndx in '..\source\gs6_ndx.pas',
  gs6_ntx in '..\source\gs6_ntx.pas',
  gs6_shel in '..\source\gs6_shel.pas',
  gs6_sort in '..\source\gs6_sort.pas',
  gs6_sql in '..\source\gs6_sql.pas',
  gs6_thrd in '..\source\gs6_thrd.pas',
  gs6_tool in '..\source\gs6_tool.pas',
  gs6_udf in '..\source\gs6_udf.pas',
  halcn4ip in '..\source\Halcn4ip.pas',
  Halcn6DB in '..\source\Halcn6DB.pas',
  halcn6id in '..\source\Halcn6Id.pas' {IndexDescDef},
  Halcn6Nv in '..\source\Halcn6Nv.pas',
  Halcn6Pr in '..\source\Halcn6Pr.pas' {IndexForm},
  Halcn6rg in '..\source\Halcn6rg.pas';

end.
