  inherited qry: TwwQuery
    BeforePost = qryBeforePost
    SQL.Strings = (
      'SELECT'
      ' PESSOA.IDPESSOA ,'
      ' PESSOA.IDIMAGEM,'
      ' PESSOA.NOME ,'
      ' PESSOA.TIPO ,'
      ' PESSOA.RAZAOSOCIAL ,'
      ' PESSOA.NUMDOCUMENTO ,'
      ' PESSOA.IDDOCUMENTO ,'
      ' PESSOA.EMAIL ,'
      ' PESSOA.IDGRUPO,'
      ' PESSOA.IDENDCOMERCIAL,'
      ' PESSOA.IDENDRESIDENCIAL,'
      ' PESSOA.IDENDENTREGA,'
      ' PESSOA.IDENDCOBRANCA,'
      ' PESSOA.IDENDCORRESP,'
      ' G.NOME AS NOMEGRUPO,'
      ' PESSOA.HOMEPAGE,'
      ' PESSOA.IDMODULORESPON,'
      ' MODULO.NOMEMODULO'
      ''
      'FROM PESSOA, PESSOA g, MODULO'
      'WHERE ( PESSOA.IDPESSOA =:IdPessoa )  AND'
      '      ( PESSOA.IDGRUPO =  G.IDPESSOA(+) ) AND'
      '      ( PESSOA.IDMODULORESPON = MODULO.IDMODULO(+) )'
      ' '
      ' '
      ' ')
  end
