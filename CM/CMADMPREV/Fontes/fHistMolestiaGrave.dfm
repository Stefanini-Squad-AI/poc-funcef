  object updHistMolestiaGrave: TUpdateSQL
    ModifySQL.Strings = (
      'UPDATE HSTMOLESTIAGRAVE'
      'SET'
      '    DTFINAL  =  :DTFINAL ,'
      '    DTINICIO =  :DTINICIO '
      'WHERE '
      '        IDPESSOA =  :OLD_IDPESSOA'
      '        AND DTINICIO =  :OLD_DTINICIO'
      '        AND DTFINAL  =  :OLD_DTFINAL'
      ' ')
    InsertSQL.Strings = (
      'INSERT INTO HSTMOLESTIAGRAVE '
      '(IDPESSOA,DTINICIO,DTFINAL) '
      'VALUES'
      '(:IDPESSOA, :DTINICIO, :DTFINAL) ')
    DeleteSQL.Strings = (
      'DELETE FROM HSTMOLESTIAGRAVE '
      'WHERE IDPESSOA = :OLD_IDPESSOA '
      'AND DTINICIO = :OLD_DTINICIO'
      ''
      '')
    Left = 224
    Top = 136
  end
