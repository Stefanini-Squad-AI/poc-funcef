    Filtered = True
    SQL.Strings = (
      'SELECT'
      '    IDPESSOA, DTINICIO, DTFINAL'
      'FROM HSTMOLESTIAGRAVE'
      'WHERE IDPESSOA = :IdPessoa'
      'ORDER BY DTINICIO desc'
