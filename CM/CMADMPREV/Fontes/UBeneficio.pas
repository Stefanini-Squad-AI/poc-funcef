  bReajustou,         bPrimeiroDoLote,  bPagtoUnico,           bPagaAbono, bEhAntecipacao,
  bPossuiAbono,       bPagaIntegral,    bEhAdiantamentoAbono,  bJaGravouLote : Boolean;

  iIdTitBenef,        iIdRegraQuitAnt,
  iFlgEnviado,        iFlgPagaINSSBF,   iFlgPagaINSSBP,        iIncluiMesConc : Integer;

  sFlgDevolucao,      sCodPortForma ,   sPlanoOrigem : String;

  dValorQuitado,           dValorBeneficioNoMes,  dValorBeneficioIntegralAposMinimo,
  dValorBeneficioIntegral, dValorPrevAntesMinimo : Double;

  sDataFinalAntecip,  sSQL,                   sMesAbono,      sFontePagadora,     sDataQuitacao,
  sFlagProvisorio,    sVlrInfINSSInicial,     sFlgReferencia, sDIB,
  sAnoMesDIB,         sDIP,                   sAnoMesDIP,     sIdRegraAntecipAbono,
  sDIbBenefAnt,       sDataInicioParaCalculo, sDataInicioParaAbono : String;
  bInsere: Boolean; //BRUNO AZEVEDO SOL 179253 KINTANA 1649151
  //MARCELO ALMEIDA - SOL 63067 - KTN 524520
  bResgateParcelado : Boolean;
  bQtdeParcelas     : integer;

  rValorBSRateado, rValorFABRateado : string;        // william moreira - SOL 268820 / PPM 1271204
  bApresentaBSFAB, bApresentaDeficit : boolean;        // william moreira - SOL 268820 / PPM 1271204
  rVlrBSTotal, rVlrFABTotal, rVlrBCDeficit  : string;  // edilaine - SOL 253577-17464 / PPM 955703
  rVlrBSTotalAbono, rVlrFABTotalAbono, rVlrBCDeficitAbono  : string;  // edilaine - SOL 253577-17464 / PPM 955703
  rVlrCalculo : double;     // edilaine - SOL 253577-17464 / PPM 955703

  dValorBSNoMes,    dValorFABNoMes,    dValorDeficitNoMes     : double;    // edilaine - SOL 253577-17514 / PPM 971383
  dValorBSIntegral, dValorFABIntegral, dValorDeficitIntegral  : double;    // edilaine - SOL 253577-17514 / PPM 971383
  dValorBSIntegralPosMin, dValorFABIntegralPosMin, dValorDeficitIntegralPosMin  : double;    // edilaine - SOL 253577-17514 / PPM 971383
  dValorBSIntegraAntMin, dValorFABIntegralAntMin, dValorDeficitIntegralantMin   : double;    // edilaine - SOL 253577-17514 / PPM 971383
  dValorBSRateado,    dValorFABRateado,    dValorDeficitRateado     : double;    // edilaine - SOL 253577-17514 / PPM 971383
  sValorBSNoMes,    sValorFABNoMes,    sValorDeficitNoMes : String;  //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131
  //MARCELO ALMEIDA - SOL 63067 - KTN 524520

  PerfilAtual    : TRecPerfilInv; //leandro wo3084

  //edilaine WO18367 : inicio
  rValorBsTitular, rValorFabTitular, rVlrTotTitular,
  rValorBSTitMes, rValorFABTitMes,
  rVlrBSTitAbono, rVlrFABTitAbono : string;
  dValorBsTitular, dValorFabTitular,
  dValorTitIntegral, dValorTitIntegralPosMin,
  dValorTitIntegraAntMin, dValorTitRateado : double;
  //edilaine WO18367 : fim


Begin

  Result       := False;  bErro          := False; bPagaAbono      := False;
  bPossuiAbono := False;  bJaGravouLote  := False; bPrimeiroDoLote := False;
  bPagtoUnico  := False;  bEhAntecipacao := False;

  sMesUltPreparo := '';

  iIdRegraAbono := -1;

  rValorAbono   := 0;    sValorAbono := '0';    dValorBenefRateado := 0;

  {                    ** ATENÇÃO SENHOR DESENVOLVEDOR **                      }
  { As consultas as tabelas de BENEFICIO desta rotina foram todas consolidadas }
  { na consulta abaixo. Caso seja preciso utilizar alguma coluna do banco de   }
  { dados que possua relação com BENEFICIO e não esteja na consulta abaixo,    }
  { favor incrementar a consulta mas LEMBRANDO que é necessário verificar após }
  { a alteração como ficou o PLANO DE EXECUÇÃO.                                }
  sSQL := 'SELECT '+
          '  BFB.FLGPROVISORIO, BFB.VLRINFINSS,    BFP.FLGREFERENCIA, BFB.IDPLANOORIGEM,    '+
          '  BFB.DIBBENEFANT,   BFB.FONTEPAGADORA, BFB.FLGPAGAINSS AS FLGPAGAINSSBENEFBF,   '+

          '  NVL( BFB.IDTITBENEF, -1 ) AS IDTITBENEF,                        '+
          '  NVL( BFB.DATAINICIOFUND, BFB.DATAINICIOINSS) AS DATAINICIOFUND, '+
          '  NVL( BFB.VALORBASE1,  BPP.VALORBASE1 ) AS VALORBASE1,           '+
          '  NVL( BFB.VALORBASE2,  BPP.VALORBASE2 ) AS VALORBASE2,           '+
          '  NVL( BFB.VALORBASE3,  BPP.VALORBASE3 ) AS VALORBASE3,           '+
          '  BFP.FLGPAGAINTEG, BFP.IDREGRAQUITANT, BFP.FLGPAGAINSS AS FLGPAGAINSSBENEFBP,   '+
          '  BFT.PERCENTUAL, BFB.RESGATEPARCELADO, BFB.QTDEPARCELAS    '+
          'FROM '+
          '  BENEFBFCIARIO BFB, BENEFPLANPREV BFP, BFCIARIOTITPLAN BFT, BENEFPLANOPART BPP '+
          'WHERE '+
          '       (BFB.IDPESSJUR     = '+ IntToStr(piIdPessJur)+')'+
          '  AND (BFB.IDPLANOPREV    = '+ IntToStr(piIdPlanoPrev)+')'+
          '  AND (BFB.IDTITULAR      = '+ IntToStr(piIdTitular)+')'+
          '  AND (BFB.IDPESSOA       = '+ IntToStr(piIdBeneficiario)+')'+
          '  AND (BFB.SEQPROPOSTA    = '+ IntToStr(piSeqProposta)+')'+
          '  AND (BFB.IDBENEFICIO    = '+ IntToStr(piIdBeneficio)+')'+
          '  AND (BFB.NUMEROPROCESSO = '+ IntToStr(piNumeroProcesso)+')'+
          '  AND (BFB.IDPLANOPREV    = BFP.IDPLANOPREV)'+
          '  AND (BFB.IDBENEFICIO    = BFP.IDBENEFICIO)'+

          '  AND (BFB.IDPESSJUR      = BFT.IDPESSJUR)      '+
          '  AND (BFB.IDPLANOPREV    = BFT.IDPLANOPREV)    '+
          '  AND (BFB.IDTITULAR      = BFT.IDTITULAR)      '+
          '  AND (BFB.IDPESSOA       = BFT.IDPESSOA)       '+
          '  AND (BFB.SEQPROPOSTA    = BFT.SEQPROPOSTA)    '+
          '  AND (BFB.IDBENEFICIO    = BFT.IDBENEFICIO)    '+
          '  AND (BFB.IDPLANOORIGEM  = BFT.IDPLANOORIGEM ) '+

          '  AND (BFB.IDPESSJUR      = BPP.IDPESSJUR(+))   '+
          '  AND (BFB.IDPLANOPREV    = BPP.IDPLANOPREV(+)) '+
          '  AND (BFB.IDPESSOA       = BPP.IDPESSOA(+))    '+
          '  AND (BFB.SEQPROPOSTA    = BPP.SEQPROPOSTA(+)) '+
          '  AND (BFB.IDBENEFICIO    = BPP.IDBENEFICIO(+)) ';

  FazQuery( QryAux, sSQL );

  { Guardar dados do beneficio }
  sFlagProvisorio    := QryAux.FieldByName('FLGPROVISORIO').AsString;
  sVlrInfINSSInicial := QryAux.FieldByName('VLRINFINSS').AsString;
  sFlgReferencia     := QryAux.FieldByName('FLGREFERENCIA').AsString;
  sDIbBenefAnt       := QryAux.FieldByName('DIBBENEFANT').AsString;
  sFontePagadora     := QryAux.FieldByName('FONTEPAGADORA').AsString;
  sDIB               := QryAux.FieldByName('DATAINICIOFUND').AsString;
  sPlanoOrigem       := QryAux.FieldByName('IDPLANOORIGEM').AsString;

  iFlgPagaINSSBF     := QryAux.FieldByName('FLGPAGAINSSBENEFBF').AsInteger;
  iFlgPagaINSSBP     := QryAux.FieldByName('FLGPAGAINSSBENEFBP').AsInteger;

  dPercentual        := QryAux.FieldByName('PERCENTUAL').AsFloat;

  //MARCELO ALMEIDA - SOL 63067 - KTN 524520
  bResgateParcelado := (QryAux.FieldByName('RESGATEPARCELADO').AsInteger = 1);
  bQtdeParcelas     :=  QryAux.FieldByName('QTDEPARCELAS').AsInteger ;
  //MARCELO ALMEIDA - SOL 63067 - KTN 524520

  if ( piIdTitular <> piIdBeneficiario )
