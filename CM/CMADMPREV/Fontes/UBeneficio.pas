function PegaValorTOTALBsFabNovo(qryAux   : TwwQuery;
                                 piNumeroProcesso,
                                 piIdBeneficio,
                                 piIdBeneficiario  : longint;
                                 psDataInicio      : string;
                                 rcVlrBsFab        : TRecBsFab;
                                 const bBuscaValorNaDIB : boolean = false;     // edilaine - SIG 20749
                                 const bCalcVlrTotal : boolean = false         // edilaine - SIG 85197
                                ) : TRecBsFab;
var sAnoMes : string;
    rVlrTotal : double;          // edilaine - SIG 85197
    rVlrAtual : double;          // edilaine - SIG 85197
    rValor    : double;          // edilaine - SIG 85197
    resFabBs  : TRecBsFab;       // edilaine WO22176
begin
   if Trim(psDataInicio) = '' then psDataInicio := FormatDateTime('dd/mm/yyyy', date);

   sAnoMes := Copy(psDataInicio,7,4) + '/' + Copy(psDataInicio,4,2);

   try
     if (not bBuscaValorNaDIB) then   // edilaine - SIG 20749
     begin
       with qryAux do
       begin
          Close;
          SQL.Clear;
          SQL.Add(' SELECT MES, VALORBS, VALORFAB, VLRBASEDEFICIT ' +
                  '         , VALORTOTAL, VALORPREV '+  // edilaine - SIG 85197
                  '         , FABTITULAR, BSTITULAR '+  //edilaine WO22176
                  ' FROM   HSTBENEFBFCIARIO '+
                  ' WHERE  IDPESSOA       = '+IntToStr(piIdBeneficiario)+
                  ' AND    MESREFERENCIA  = '''+sAnoMes+''''+
                  ' AND    IDBENEFICIO    = '+IntToStr(piIdBeneficio) +
                  ' AND    NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)
                  +' ORDER BY MES DESC  ');

          Open;
          if (not IsEmpty) then begin
             resFabBs.sVlrTotalBS    := FieldByName('VALORBS').AsString;
             resFabBs.sVlrTotalFab   := FieldByName('VALORFAB').AsString;
             resFabBs.sVlrDeficit    := FieldByName('VLRBASEDEFICIT').AsString;
             resFabBs.sVlrFabTit     := FieldByName('FABTITULAR').AsString;      //edilaine WO22176
             resFabBs.sVlrBSTit      := FieldByName('BSTITULAR').AsString;       //edilaine WO22176

             // edilaine - SIG 85197 - inicio
             if bCalcVlrTotal then
             begin
               rVlrTotal :=  FieldByName('VALORTOTAL').AsFloat;
               rVlrAtual :=  FieldByName('VALORPREV').AsFloat;
             end;
             // edilaine - SIG 85197 - inicio

             Close;
             Exit;
          end
       end;
     end;

     with qryAux do
     begin
        Close;
        SQL.Clear;
        // edilaine - SIG 85197 - inicio
        SQL.Add(' SELECT B.BSDIB, B.FABDIB, B.VLRFABTOTAL, B.VLRBSTOTAL, B.VLRBASEDEFICIT, B.DATAINICIO ' +
                '        , B.VALORNADIB, HB.VALORTOTAL ' +
                '        , B.FABTITULAR, B.BSTITULAR, B.VLRTOTALTITULAR    '+  //edilaine WO22176
                ' FROM   BENEFBFCIARIO B '+
                ' JOIN   HSTBENEFBFCIARIO HB ON HB.IDPESSOA = B.IDPESSOA   ' +
                '                           AND HB.IDTITULAR = B.IDTITULAR ' +
                '                           AND HB.IDPLANOPREV = B.IDPLANOPREV '+
                '                           AND HB.IDPESSJUR   = B.IDPESSJUR   '+
                '                           AND HB.SEQPROPOSTA = B.SEQPROPOSTA '+
                '                           AND HB.IDBENEFICIO = B.IDBENEFICIO '+
                '                           AND HB.MESREFERENCIA = TO_CHAR(B.DATAINICIO, ''YYYY/MM'') '+
                ' WHERE  B.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
                ' AND    B.IDPESSOA       = '+IntToStr(piIdBeneficiario)+
                ' AND    B.IDBENEFICIO    = '+IntToStr(piIdBeneficio)
                );
        Open;

        if (not IsEmpty) and (bCalcVlrTotal) then
        begin
          rVlrTotal :=  FieldByName('VALORTOTAL').AsFloat;
          rVlrAtual :=  FieldByName('VALORNADIB').AsFloat;
        end;
        // edilaine - SIG 85197 - inicio


        If (not IsEmpty) and (qryAux.FieldByName('DATAINICIO').AsFloat >= StrToDate(psDataInicio)) Then    //edilaine - SIG94608
        Begin
           resFabBs.sVlrTotalBS    := FieldByName('BSDIB').AsString;
           resFabBs.sVlrTotalFab   := FieldByName('FABDIB').AsString;
           resFabBs.sVlrDeficit    := FieldByName('VLRBASEDEFICIT').AsString;
           resFabBs.sVlrFabTit     := FieldByName('FABTITULAR').AsString;            //edilaine WO22176
           resFabBs.sVlrBSTit      := FieldByName('BSTITULAR').AsString;             //edilaine WO22176
           resFabBs.sVlrTotTit     := FieldByName('VLRTOTALTITULAR').AsString;       //edilaine WO22176

           Close;
           Exit;
        End;

        if (not IsEmpty) and (FieldByName('VALORTOTAL').AsFloat > 0) then
        begin
           resFabBs.sVlrTotalBS   := FieldByName('VLRBSTOTAL').AsString;
           resFabBs.sVlrTotalFab  := FieldByName('VLRFABTOTAL').AsString;
           resFabBs.sVlrDeficit   := FieldByName('VLRBASEDEFICIT').AsString;
           resFabBs.sVlrFabTit    := FieldByName('FABTITULAR').AsString;      //edilaine WO22176
           resFabBs.sVlrBSTit     := FieldByName('BSTITULAR').AsString;       //edilaine WO22176
           Close;
           Exit;
        end;
     end;

   finally
     // edilaine - SIG 85197 - inicio
     if bCalcVlrTotal then
     begin
       if resFabBs.sVlrTotalBS <> '' then
       begin
         rValor := StrToFloat(resFabBs.sVlrTotalBS);
         rValor := Arredonda(rValor / rVlrAtual * rVlrTotal, 2);
         resFabBs.sVlrTotalBS := FloatToStr(rValor);
       end;

       if resFabBs.sVlrTotalFab <> '' then
       begin
         rValor := StrToFloat(resFabBs.sVlrTotalBS);
         rValor := Arredonda(rVlrTotal - rValor, 2);
         resFabBs.sVlrTotalFab := FloatToStr(rValor);
       end;

       if resFabBs.sVlrDeficit <> '' then
       begin
         rValor := StrToFloat(resFabBs.sVlrDeficit);
         rValor := Arredonda(rValor / rVlrAtual * rVlrTotal, 2);
         resFabBs.sVlrDeficit := FloatToStr(rValor);
       end;
     end;
     // edilaine - SIG 85197 - fim

     Result := resFabBs;    //edilaine WO22176
   end;
end;


Function CalculaPercPensao(piIdTitular, piIdBeneficio, piIdPlanoPrev : integer; psAnoMes : string;
                           dVlrBSTit : double = 0; dVlrBSTot : double = 0) : integer;
var
  _qry    : TwwQuery;
  iNumDep : integer;
  sData   : string;
begin
  _qry := TwwQuery.create(nil);

  if (dVlrBSTit > 0) and (dVlrBSTot > 0) then
  begin
    Result := Trunc((dVlrBSTot / dVlrBSTit) * 100);
    Exit;
  end;

  sData := '01/'+Copy(psAnoMes,6,2)+'/'+Copy(psAnoMes,1,4);

  try
    _qry.DataBaseName := 'BaseDados';

    _qry.Sql.Add('SELECT COUNT(D.IDPESSOA) AS NUMDEP,                      ');
    _qry.Sql.Add('       MAX(P.DTNOVOCALCPENSASALDADA) DTREGRANOVA         ');
    _qry.Sql.Add('  FROM (                                                 ');
    _qry.Sql.Add('SELECT BF.IDPESSOA, BF.DATAINICIOFUND AS DATAINICIO,     ');
    _qry.Sql.Add('       NVL(BT.DATAFIMRECEB, TRUNC(SYSDATE)) AS DATAFIM   ');
    _qry.Sql.Add('  FROM BFCIARIOTITPLAN BT                                ');
    _qry.Sql.Add('  JOIN BENEFBFCIARIO   BF                                ');
    _qry.Sql.Add('    ON BF.IDTITULAR   = BT.IDTITULAR                     ');
    _qry.Sql.Add('   AND BF.IDPLANOPREV = BT.IDPLANOPREV                   ');
    _qry.Sql.Add('   AND BF.IDPESSJUR   = BT.IDPESSJUR                     ');
    _qry.Sql.Add('   AND BF.IDBENEFICIO = BT.IDBENEFICIO                   ');
    _qry.Sql.Add('   AND BF.SEQPROPOSTA = BT.SEQPROPOSTA                   ');
    _qry.Sql.Add(' WHERE BT.IDTITULAR   = '+IntToStr(piIdTitular)           );
    _qry.Sql.Add('   AND BT.IDBENEFICIO = '+IntToStr(piIdBeneficio)         );
    _qry.Sql.Add('   AND BT.IDPLANOPREV = '+IntToStr(piIdPlanoPrev)         );
    _qry.Sql.Add(') D, PARAMAPREV P                                        ');
    _qry.Sql.Add(' WHERE (D.DATAINICIO <= TO_DATE('+QuotedStr(sData)+', ''DD/MM/YYYY'') OR  ');
    _qry.Sql.Add('        TO_CHAR(D.DATAINICIO, ''YYYY/MM'') = '+QuotedStr(psAnoMes)+')     ');
    _qry.Sql.Add('   AND D.DATAFIM >= TO_DATE('+QuotedStr(sData)+', ''DD/MM/YYYY'')' );
    _qry.Open;

    if _qry.FieldByName('DTREGRANOVA').AsDateTime > StrToDate(sData) then
      Result  := 80
    else
    begin
      iNumDep := StrToIntDef(_qry.FieldByName('NUMDEP').AsString, 0);
      Result  := iff(iNumDep >= 3, 80, 50 + (iNumDep * 10));
    end;
  finally
    _qry.close;
    FreeAndNil(_qry);
  end;

end;
