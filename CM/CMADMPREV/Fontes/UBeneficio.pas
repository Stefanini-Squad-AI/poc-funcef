                                                      dValorTitIntegraAntMin, dValorTitRateado,        //edilaine WO18367
                                                      dValorSRB,
                                                      piIdCalculo,
                                                      sDataFolha,
                                                      False, pbMigracaoPlano,
                                                      -1, True, True
                                                           );

          dValorBsTitular := dValorTitIntegral;
          rValorBsTitular := FloatToStr(dValorBsTitular);
          rValorBSTitMes  := FloatToStr(dValorTitIntegral);
