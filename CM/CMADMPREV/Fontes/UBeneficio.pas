   rValorFABTitMes  := '';
   //edilaine WO18367 : fim

   if (not qryAux.isEmpty)  then
   begin
     // william moreira - SOL 268820 / PPM 1271204 - inicio
     bApresentaBSFAB   := QryAux.FieldByName('FLGAPRESENTABSFAB').AsString = '1';
