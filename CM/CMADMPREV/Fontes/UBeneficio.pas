function FlgNovaCalcPensaoSaldada(sDataDIB : string) : boolean;
var
  qry : TwwQuery;
begin
  Result := false;
  if trim(SDataDib) = '' then
     exit;

  qry := TwwQuery.Create(nil);
  try
    qry.DatabaseName :=  'BaseDados';
    qry.Sql.Text := 'SELECT CASE  '+
                    '        WHEN TO_DATE('+QuotedStr(sDataDIB)+', ''DD/MM/YYYY'') >= PA.DTNOVOCALCPENSASALDADA '+
                    '          THEN 1           '+
                    '          ELSE 0           '+
                    '       END FLGNOVOCALCULO  '+
                    '  FROM PARAMAPREV PA       ';
