  // edilaine - SOL 253577-17541 / PPM 978024 - fim


  // 2. Verificar possiveis problemas para o MES DA RETENCAO
  //    2.1 Se Data da Retencao = Ultimo Dia do Mes
  //        Entao 2.1.1. Pagar Beneficio Integral
  //              2.1.2. Verificar se beneficio já está no historico (preparado)
  //              2.1.3. Se nao estiver, entao inserir beneficio no historico
  if StrToInt(Copy(sNovaDataFinal,1,2)) = TrazUltDiaMes( StrToInt(Copy(sNovaDataFinal,4,2)),
                                                         StrToInt(Copy(sNovaDataFinal,7,4)) ) then
  begin
    qry.Close;
    qry.SQL.Clear;
    qry.SQl.Add(' SELECT IDPESSJUR,   IDTITULAR,     IDPLANOPREV,     '+
                '        MES,         IDMOTIVO,      NUMEROPROCESSO,  '+
                '        IDBENEFICIO, IDPESSOA,      MESREFERENCIA,   '+
                '        SEQPROPOSTA, VALORPREV,     VALORINTEGRAL,   '+
                '        VLBENEFPGTO                                  '+
                ' FROM  HSTBENEFBFCIARIO                              '+
                ' WHERE (IDPESSOA       = '+IntToStr(piIdBeneficiario)      +')'+
                ' AND   (MESREFERENCIA  = '''+sAnoMesInicioFaixa      +''')'+
                ' AND   (IDBENEFICIO    = '+IntToStr(piIdBeneficio)       +')'+
                ' AND   (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)    +')');

    qry.Open;

    if qry.IsEmpty then // Beneficio do mes da retencao ainda nao foi preparado
    begin
      iSeqBeneficio := PegaSeqBeneficio(qryAux,       piIdPessJur, piIdTitular,
                                        piIdPlanoPrev,    piIdBeneficiario,  piSeqProposta,
                                        piNumeroProcesso, piIdBeneficio,
                                        iIdMotivoAux,
                                        sAnoMesPagto, sAnoMesInicioFaixa);

      // Se o beneficio esta sendo encerrado por MORTE
      // Entao Se o beneficiario for o participante
      //       Entao Inserir no historico do proprio e na concessao de beneficios para
      //             beneficiarios, este beneficio será cobrado dos mesmos
      //       Senao inserir o acerto por beneficiario
      // Senao Pagar o beneficio para o proprio
      if pbFlgEncerraFale then
      begin
        if prmIdMotDevolNaoIden <= 0 then
        begin
          sMsgErro := 'Motivo para Pagamento com Recebedor não Identificado não preenchido.';
          Exit;
        end;

        if piIdTitular = piIdBeneficiario then // o participante é quem morreu
        begin
          if not InsereHstBenefBfciario ( qryAux,           iSeqBeneficio,  piNumeroProcesso,
                                          piIdBeneficio,    piIdPessJur,    piIdPlanoPrev,
                                          piIdTitular,      piSeqProposta,  piIdBeneficiario,
                                          piIdRegraCalculo,
                                          iIdMotivoAux,
                                          qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,
                                          sAnoMesInicioFaixa,
                                          sAnoMesPagto ,    psMatricula,    psInscricaoNumero,
                                          Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Pagamento de Último Mês : '+sNome+ ' em '+sNovaDataFinal,1,200)+'- Falecimento de Participante. ',
                                          rValorIntegral, rValorIntegral, rValorIntegral,
                                          0, 0, 1, 0, piIdLoteRetemEncerra, sMsgErro,
                                          sDataPagamento,
                                          dValorTotalOriginal, 0,0,0,0,0,0,-1,'',-1,'',False, // edilaine - SOL 253577-17464 / PPM 955703
                                          sValorFAB,        // edilaine - SOL 253577-17541 / PPM 978024
                                          sValorBS,         // edilaine - SOL 253577-17541 / PPM 978024
                                          sValorDeficit     // edilaine - SOL 253577-17541 / PPM 978024
                                          ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                          )
          then Exit;

        end
        else
        begin

          // Beneficio no mes do encerramento ainda nao foi preparado
          // Como um dos beneficiarios que morreu, preparar o beneficio
          // já com o novo valor rateado

          qryBenefRecalculados.First;
          while not qryBenefRecalculados.Eof do
          begin

            if not InsereHstBenefBfciario ( qryAux,           iSeqBeneficio,  piNumeroProcesso,
                                            piIdBeneficio,    piIdPessJur,    piIdPlanoPrev,
                                            piIdTitular,      piSeqProposta,
                                            qryBenefRecalculados.FieldByName('IdPessoa').AsInteger,
                                            piIdRegraCalculo, iIdMotivoAux,
                                            qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,
                                            sAnoMesInicioFaixa,
                                            sAnoMesPagto ,    psMatricula,    psInscricaoNumero,
                                            Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Pagamento de Último Mês : '+sNome+ ' em '+sNovaDataFinal,1,200)+'- Falecimento de Participante. ',
                                            qryBenefRecalculados.FieldByName('ValorAtual').AsFloat,
                                            qryBenefRecalculados.FieldByName('ValorAtual').AsFloat,
                                            rValorIntegral,
                                            0, 0, 1, 0, piIdLoteRetemEncerra,
                                            sMsgErro,
                                            sDataPagamento,
                                            dValorTotalOriginal, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                            qryBenefRecalculados.FieldByName('VLRFABATUAL').AsString,
                                            qryBenefRecalculados.FieldByName('VLRBSATUAL').AsString,
                                            qryBenefRecalculados.FieldByName('VLRBASEDEFICIT').AsString   // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                            ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                          )
            then Exit;
            qryBenefRecalculados.Next;
          end;
        end;
      end
      else  // Pagar o beneficio para o proprio
      begin
        if not InsereHstBenefBfciario ( qryAux,           iSeqBeneficio,  piNumeroProcesso,
                                        piIdBeneficio,    piIdPessJur,    piIdPlanoPrev,
                                        piIdTitular,      piSeqProposta,  piIdBeneficiario,
                                        piIdRegraCalculo, iIdMotivoAux,
                                        qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,
                                        sAnoMesInicioFaixa, sAnoMesPagto ,    psMatricula,
                                        psInscricaoNumero,
                                        Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Retenção/Pagamento de Último Mês : '+sNome+ ' em '+sNovaDataFinal,1,200),
                                        rValorIntegral, rValorIntegral, rValorIntegral,
                                        0, 0, 1, 0, piIdLoteRetemEncerra, sMsgErro,
                                        sDataPagamento,
                                        dValorTotalOriginal, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                        sValorFAB,
                                        sValorBS,
                                        sValorDeficit     // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                        ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                      )
        then Exit;
      end;

    end; 

  end { if StrToInt(Copy(sNovaDataFinal,1,2)) = TrazUltDiaMes( StrToInt(Copy(sNovaDataFinal,4,2)), }
  else
  //    2.2 Se Data da Retencao = Meio do Mes
  //        Entao 2.2.1. Pagar pro-rata
  //              2.2.2. Verificar se benefício já existe no histórico
  //              2.2.3. Se existir
  //                     Entao 2.2.3.1. Verificar se benefício já foi pago
  //                           2.2.3.2. Se benefício já pago Entao inserir uma devolucao dos dias devidos
  //                           2.2.3.3. Se benefício na previa Entao inserir uma devolucao dos dias devidos
  //                           2.2.3.4. Se beneficio preparado Entao desfazer preparo do valor
  //                                    integral e inserir valor pro-rata
  begin

    //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
    qry.Close;
    qry.SQL.Clear;
    qry.SQl.Add(' select hb.IDPESSJUR, '+
                ' hb.IDTITULAR, '+
                ' hb.IDPLANOPREV, '+
                ' hb.NUMEROPROCESSO, '+
                ' hb.IDBENEFICIO, '+
                ' hb.IDPESSOA, '+
                ' hb.MESREFERENCIA, '+
                ' hb.SEQPROPOSTA,   '+
                ' bf.flgpagainss,   '+
                ' bf.idsitbeneficio,'+
                ' max(hb.VALORINTEGRAL) as VALORINTEGRAL, '+
                ' sum(decode(hb.FLGDEVOLUCAO, 1, -hb.VALORPREV, hb.VALORPREV)) as VALORPREVISTO, '+
                ' sum(decode(hb.FLGDEVOLUCAO, 1, -hb.VLBENEFPGTO, hb.VLBENEFPGTO)) as VLBENEFPGTO, '+
                ' sum(decode(hb.FLGDEVOLUCAO, 1, -hb.VALORTOTAL, hb.VALORTOTAL)) as VALORTOTAL '+
                ' from HSTBENEFBFCIARIO hb '+
                ' inner join BENEFBFCIARIO bf on '+
                ' hb.IDPLANOPREV = bf.idplanoprev AND '+
                ' hb.IDBENEFICIO = bf.idbeneficio AND  '+
                ' hb.NUMEROPROCESSO = bf.numeroprocesso AND '+
                ' hb.IDPESSJUR = bf.idpessjur AND '+
                ' hb.IDTITULAR = bf.idtitular AND '+
                ' hb.IDPLANOORIGEM = bf.idplanoorigem AND '+
                ' hb.IDPESSOA = bf.idpessoa AND '+
                ' hb.SEQPROPOSTA = bf.seqproposta '+
                ' where (hb.IDPESSOA = '+IntToStr(piIdBeneficiario)          +')'+
                ' and (hb.MESREFERENCIA = '''+sAnoMesAposInicioFaixa+''')'+
                ' and (hb.IDBENEFICIO = '+IntToStr(piIdBeneficio)       +')'+
                ' and (hb.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)    +')'+
                ' group by hb.IDPESSJUR, '+
                ' hb.IDTITULAR, '+
                ' hb.IDPLANOPREV, '+
                ' hb.NUMEROPROCESSO, '+
                ' hb.IDBENEFICIO, '+
                ' hb.IDPESSOA, '+
                ' hb.MESREFERENCIA, '+
                ' hb.SEQPROPOSTA, '+
                ' bf.flgpagainss, '+
                ' bf.idsitbeneficio ');
    qry.Open;

    if qry.IsEmpty then // BENEFICIO NAO EXISTE NO HISTORICO PARA O MES INDICADO
    begin               // beneficio ainda nao foi preparado no mes da retencao

      if not (pbFlgEncerraFale) or (piIdTitular <> piIdBeneficiario) then
      begin

        iSeqBeneficio := PegaSeqBeneficio( qryAux,
                                           piIdPessJur,      piIdTitular,
                                           piIdPlanoPrev,    piIdBeneficiario,  piSeqProposta,
                                           piNumeroProcesso, piIdBeneficio,     iIdMotivoAux,
                                           sAnoMesPagto, sAnoMesInicioFaixa );

        if not InsereHstBenefBfciario ( qryAux,           iSeqBeneficio,  piNumeroProcesso,
                                        piIdBeneficio,    piIdPessJur,    piIdPlanoPrev,
                                        piIdTitular,      piSeqProposta,  piIdBeneficiario,
                                        piIdRegraCalculo,
                                        iIdMotivoAux,
                                        qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,
                                        sAnoMesInicioFaixa, sAnoMesPagto ,    psMatricula,    psInscricaoNumero,
                                        Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Retenção/Pagamento de Último Mês : '+sNome+ ' em '+sNovaDataFinal,1,200),
                                        rValorRateado, rValorRateado, rValorIntegral,
                                        0, 0, 1, 0, piIdLoteRetemEncerra, sMsgErro,
                                        sDataPagamento,
                                        dValorTotalOriginal, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                        sValorFAB,
                                        sValorBS,
                                        sValorDeficit     // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                        ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                      )
        then Exit;
      end
      else  // foi encerrado por falecimento
      begin
        // pagar o devido com motivo recebedor nao identificado
        iSeqBeneficio := PegaSeqBeneficio(qryAux,       piIdPessJur, piIdTitular,
                                          piIdPlanoPrev,piIdBeneficiario,  piSeqProposta,
                                          piNumeroProcesso,          piIdBeneficio,
                                          iIdMotivoAux,       sAnoMesPagto,
                                          sAnoMesInicioFaixa );

        if not InsereHstBenefBfciario ( qryAux,           iSeqBeneficio,  piNumeroProcesso,
                                        piIdBeneficio,    piIdPessJur,    piIdPlanoPrev,
                                        piIdTitular,      piSeqProposta,  piIdBeneficiario,
                                        piIdRegraCalculo, iIdMotivoAux,
                                        qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,
                                        sAnoMesInicioFaixa,
                                        sAnoMesPagto ,    psMatricula,    psInscricaoNumero,
                                        Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Retenção/Pagamento de Último Mês : '+sNome+ ' em '+sNovaDataFinal,1,200),
                                        rValorRateado, rValorRateado, rValorIntegral,
                                        0, 0, 1, 0, piIdLoteRetemEncerra, sMsgErro,
                                        sDataPagamento,
                                        dValorTotalOriginal, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                        sValorFAB,
                                        sValorBS,
                                        sValorDeficit     // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                        ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                      )
        then Exit;

      end;

    end
    else  // Beneficio já existe no histórico
    begin

      if ( not pbApenasMudouPrevistaParaEfetiva ) then
      begin
        if (BenefExistePREVIA ( qryAux, piIdPessJur,   piIdTitular,
                                piIdPlanoPrev,    prmIdMotivoFolhaBen,
                                piNumeroProcesso, piIdBeneficio, piIdBeneficiario, piSeqProposta,
                                sAnoMesInicioFaixa, sAnoMesInicioFaixa) or
           ( qry.FieldByName('VlBenefPgto').AsFloat > 0 ) ) then
        begin

          if not (pbFlgEncerraFale) or (piIdTitular <> piIdBeneficiario) then
          begin

            dValorPago := qry.FieldByName('VLBENEFPGTO').AsFloat;

            if rValorRateado > dValorPago then
            begin
              dValorDevolver := rValorRateado - dValorPago;
              sFlgDevolucao  := '0';
            end
            else
            begin
              dValorDevolver := dValorPago - rValorRateado ;
              sFlgDevolucao  := '1';
            end;

            dValorDevolver := StrToFloat(FormatFloat('#0.00', dValorDevolver));

            iSeqBeneficio  := PegaSeqBeneficio( qryAux,              piIdPessJur,            piIdTitular,
                                                piIdPlanoPrev,       piIdBeneficiario,             piSeqProposta,
                                                piNumeroProcesso,    piIdBeneficio,          iIdMotivoAux,
                                                sAnoMesPagto,        sAnoMesInicioFaixa );

            if not InsereHstBenefBfciario ( qryAux,
                                            iSeqBeneficio,
                                            piNumeroProcesso, piIdBeneficio,    piIdPessJur,
                                            piIdPlanoPrev,    piIdTitular,      piSeqProposta,
                                            piIdBeneficiario, piIdRegraCalculo, iIdMotivoAux,
                                            qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,
                                            sAnoMesInicioFaixa, sAnoMesPagto ,
                                            psMatricula,   psInscricaoNumero,
                                            Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Devolução de Pagamento Indevido : '+sNome+ ' em '+sNovaDataFinal,1,200),
                                            dValorDevolver, dValorDevolver, qry.FieldByname('VALORINTEGRAL').AsFloat,
                                            0, 0, 1, StrToInt(sFlgDevolucao), piIdLoteRetemEncerra,
                                            sMsgErro,
                                            sDataPagamento,
                                            dValorTotalOriginal, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                            sValorFAB,
                                            sValorBS,
                                            sValorDeficit     // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                            ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                          )
            then Exit;

          end
          else { if not (pbFlgEncerraFale) or (piIdTitular <> piIdBeneficiario) }
          begin

            // cobrar com motivo recebedor nao identificado
            iSeqBeneficio := PegaSeqBeneficio( qryAux,       piIdPessJur, piIdTitular,
                                               piIdPlanoPrev,piIdBeneficiario,  piSeqProposta,
                                               piNumeroProcesso,          piIdBeneficio,
                                               iIdMotivoAux,       sAnoMesPagto,
                                               sAnoMesInicioFaixa );

            //Excluir registros preparados 
            If cRetemEncerra = 'E'
            Then ExecutarQuery( QryAux, ' DELETE FROM HSTBENEFBFCIARIO '+
                                        ' WHERE  IDPESSJUR      = '+qry.FieldByName('IDPESSJUR').AsString+
                                        ' AND    IDTITULAR      = '+qry.FieldByName('IDTITULAR').AsString+
                                        ' AND    IDPLANOPREV    = '+qry.FieldByName('IDPLANOPREV').AsString+
                                        ' AND    IDBENEFICIO    = '+qry.FieldByName('IDBENEFICIO').AsString+
                                        ' AND    NUMEROPROCESSO = '+qry.FieldByName('NUMEROPROCESSO').AsString+
                                        ' AND    IDPESSOA       = '+qry.FieldByName('IDPESSOA').AsString+
                                        ' AND    MESREFERENCIA  = '''+sAnoMesInicioFaixa+''''+
                                        ' AND    SEQPROPOSTA    = '+qry.FieldByName('SEQPROPOSTA').AsString+
                                        ' AND    (VLBENEFPGTO <= 0 OR VLBENEFPGTO IS NULL) ' );

            if prmFlgTipoAcertoFL = 0 then
            begin

              dValorPago      := qry.FieldByName('VLBENEFPGTO').AsFloat;

              if not InsereHstBenefBfciario ( qryAux,           iSeqBeneficio,  piNumeroProcesso,
                                              piIdBeneficio,    piIdPessJur,    piIdPlanoPrev,
                                              piIdTitular,      piSeqProposta,  piIdBeneficiario,
                                              piIdRegraCalculo, iIdMotivoAux,
                                              qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,
                                              sAnoMesInicioFaixa,
                                              sAnoMesPagto ,    psMatricula,    psInscricaoNumero,
                                              Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Retenção/Pagamento de Último Mês : '+sNome+ ' em '+sNovaDataFinal,1,200),
                                              ( dValorPago - rValorRateado ), ( dValorPago - rValorRateado ), rValorIntegral,
                                              0, 0, 1, 1, piIdLoteRetemEncerra,
                                              sMsgErro,
                                              sDataPagamento,
                                              dValorTotalOriginal, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                              sValorFAB,
                                              sValorBS,
                                              sValorDeficit     // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                              ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                            )
              then Exit;

            end
            else // caso da funcef. Cobrar devolução INTEGRAL e PAGAR dias devidos
            begin

              if not InsereHstBenefBfciario ( qryAux,           iSeqBeneficio,  piNumeroProcesso,
                                              piIdBeneficio,    piIdPessJur,    piIdPlanoPrev,
                                              piIdTitular,      piSeqProposta,  piIdBeneficiario,
                                              piIdRegraCalculo, iIdMotivoAux,

                                              qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,

                                              sAnoMesInicioFaixa, sAnoMesPagto ,    psMatricula,    psInscricaoNumero,
                                              Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Retenção/Pagamento de Último Mês : '+sNome+ ' em '+sNovaDataFinal,1,200),
                                              rValorIntegral, rValorIntegral, rValorIntegral,
                                              0, 0, 1, 1, piIdLoteRetemEncerra,
                                              sMsgErro,
                                              sDataPagamento,
                                              dValorTotalOriginal, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                              sValorFAB,
                                              sValorBS,
                                              sValorDeficit     // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                              ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                            )
              then Exit;

              if not InsereHstBenefBfciario ( qryAux,           iSeqBeneficio,  piNumeroProcesso,
                                              piIdBeneficio,    piIdPessJur,    piIdPlanoPrev,
                                              piIdTitular,      piSeqProposta,  piIdBeneficiario,
                                              piIdRegraCalculo, iIdMotivoAux,

                                              qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,

                                              sAnoMesInicioFaixa, sAnoMesPagto ,    psMatricula,    psInscricaoNumero,
                                              Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Retenção/Pagamento de Último Mês : '+sNome+ ' em '+sNovaDataFinal,1,200),
                                              rValorRateado, rValorRateado, rValorIntegral,
                                              0, 0, 1, 0, piIdLoteRetemEncerra,
                                              sMsgErro,
                                              sDataPagamento,
                                              dValorTotalOriginal, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                              sValorFAB,
                                              sValorBS,
                                              sValorDeficit     // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                              ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                            )

              then Exit;

            end;

          end;

        end
        else  // Beneficio está preparado e NAO ESTÁ NA PREVIA
        begin
          qryAux.Close;
          qryAux.SQL.Clear;

          //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
          if ((not qry.IsEmpty) and (qry.FieldByName('VALORPREVISTO').AsFloat > 0) and (qry.FieldByName('flgpagainss').AsString = '0') and (qry.FieldByName('idsitbeneficio').AsInteger = 2)) then begin
            if cRetemEncerra = 'E'
            then qryAux.SQL.Add(' DELETE FROM HSTBENEFBFCIARIO '+
                                ' WHERE  IDPESSJUR      = '+qry.FieldByName('IDPESSJUR').AsString+
                                ' AND    IDTITULAR      = '+qry.FieldByName('IDTITULAR').AsString+
                                ' AND    IDPLANOPREV    = '+qry.FieldByName('IDPLANOPREV').AsString+
                                ' AND    MES            < '''+sAnoMesPagto+''''+
                                ' AND    IDBENEFICIO    = '+qry.FieldByName('IDBENEFICIO').AsString+
                                ' AND    NUMEROPROCESSO = '+qry.FieldByName('NUMEROPROCESSO').AsString+
                                ' AND    IDPESSOA       = '+qry.FieldByName('IDPESSOA').AsString+
                                ' AND    MESREFERENCIA  = '''+qry.FieldByName('MESREFERENCIA').AsString+''''+
                                ' AND    SEQPROPOSTA    = '+qry.FieldByName('SEQPROPOSTA').AsString)

            else qryAux.SQL.Add(' UPDATE HSTBENEFBFCIARIO SET FLGENVIADO = 9, FLGCONCESSAO = 1 '+
                                ' WHERE  IDPESSJUR      = '+qry.FieldByName('IDPESSJUR').AsString+
                                ' AND    IDTITULAR      = '+qry.FieldByName('IDTITULAR').AsString+
                                ' AND    IDPLANOPREV    = '+qry.FieldByName('IDPLANOPREV').AsString+
                                ' AND    MES            < '''+sAnoMesPagto+''''+
                                ' AND    IDBENEFICIO    = '+qry.FieldByName('IDBENEFICIO').AsString+
                                ' AND    NUMEROPROCESSO = '+qry.FieldByName('NUMEROPROCESSO').AsString+
                                ' AND    IDPESSOA       = '+qry.FieldByName('IDPESSOA').AsString+
                                ' AND    MESREFERENCIA  = '''+qry.FieldByName('MESREFERENCIA').AsString+''''+
                                ' AND    SEQPROPOSTA    = '+qry.FieldByName('SEQPROPOSTA').AsString);
          end;
          
          try
            qryAux.ExecSQL;
          except
          //Brunno Mattos - KTN 767861 - SOL 132659 Inicio
          on e:Exception do
          begin
            TratarErro(e.Message);
            sMsgErro := sNome+' : Erro ao desfazer benefício preparado. ';
            Exit;
          end;
          //Brunno Mattos - KTN 767861 - SOL 132659 Fim

          end;

          if not (pbFlgEncerraFale) or (piIdTitular = piIdBeneficiario) then
          begin
            // Inserir o valor rateado
            iSeqBeneficio := PegaSeqBeneficio( QryAux,
                                               piIdPessJur,      piIdTitular,   piIdPlanoPrev,
                                               piIdBeneficiario, piSeqProposta, piNumeroProcesso,
                                               piIdBeneficio,    iIdMotivoAux,
                                               sAnoMesPagto, sAnoMesInicioFaixa );

            if not InsereHstBenefBfciario ( qryAux,           iSeqBeneficio,  piNumeroProcesso,
                                            piIdBeneficio,    piIdPessJur,    piIdPlanoPrev,
                                            piIdTitular,      piSeqProposta,  piIdBeneficiario,
                                            piIdRegraCalculo, iIdMotivoAux,
                                            qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,
                                            sAnoMesInicioFaixa, sAnoMesPagto , psMatricula, psInscricaoNumero,
                                            Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Retenção/Pagamento de Último Mês : '+sNome+ ' em '+sNovaDataFinal,1,200),
                                            rValorRateado, rValorRateado, rValorIntegral,
                                            0, 0, 1, 0,
                                            piIdLoteRetemEncerra, sMsgErro,
                                            sDataPagamento, 
                                            dValorTotalOriginal, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                            sValorFAB,
                                            sValorBS,
                                            sValorDeficit     // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                            ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                          )
            then Exit;
          end;
        end;

      end; // if pbApenasMudouPrevistaParaEfetiva

    end; // else  // Beneficio já existe no histórico

  end; // 2. Fim (Verificar possiveis problemas para o MES DA RETENCAO)

  // 3. Verificar possiveis problemas para os MESES APOS O MES DA RETENCAO
  //    3.1 Para cada mes apos o mes da retencao fazer :
  //        3.1.1. Verificar se benefício já foi pago
  //        3.1.2. Se benefício já pago Entao informar que beneficio já foi pago
  //        3.1.3. Se benefício na previa Entao informar que para desfazer previa
  //        3.1.4. Se beneficio preparado Entao desfazer preparo do valor integral
  If ( Not pbApenasMudouPrevistaParaEfetiva ) Then
  Begin

    //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
    //sAnoMesAposInicioFaixa := ProximoAnoMes(StrToInt(Copy(sAnoMesInicioFaixa, 6,2)), StrToInt(Copy(sAnoMesInicioFaixa, 1,4)));
    sAnoMesAposInicioFaixa := sAnoMesInicioFaixa;

    While sAnoMesAposInicioFaixa <= sAnoMesFinalFaixa do
    Begin

      dValorPrevAntesMinimo := rValorIntegral;

      // Tratamento de benefício mínimo

      // Neste ponto a variavel sValorFinal, dValorTotal e dValorBeneficioNoMes está com o
      // valor do benefício reajustado, sem pro-rata de beneficiarios e sem pro-rata dias
      if not CalculaBeneficioMinimo ( piNumeroProcesso, piIdPessJur,       piIdPlanoPrev,
                                      piIdTitular,      piIdBeneficiario,  piIdBeneficio,

                                      FloatToStr(rValorIntegral), FloatToStr(rValorIntegral),
                                      qryBenefRecalculados.RecordCount,
                                      sAnoMesInicioFaixa,
                                      psDataInicio, sNovaDataFinal,
                                      dValorDepoisMinimo,
                                      sMsgErro )
      then Exit;

      if dValorDepoisMinimo > 0 then
      begin
        sValorIntegral := FloatToStr(dValorDepoisMinimo);
        rValorIntegral := StrToFloat(ClienteNumero(sValorIntegral));
        dValorTotal    := StrToFloat(ClienteNumero(sValorIntegral));
      end;


      // edilaine - SOL 253577-17541 / PPM 978024 - inicio
      { BS }
      if not CalculaBeneficioMinimo ( piNumeroProcesso, piIdPessJur,       piIdPlanoPrev,
                                      piIdTitular,      piIdBeneficiario,  piIdBeneficio,

                                      FloatToStr(rValorBS),
                                      FloatToStr(rValorBS),
                                      qryBenefRecalculados.RecordCount,
                                      sAnoMesInicioFaixa,
                                      psDataInicio, sNovaDataFinal,
                                      rVlrDepoisMinBS,
                                      sMsgErro )
      then Exit;

      if rVlrDepoisMinBS > 0 then
      begin
        sValorBS := FloatToStr(rVlrDepoisMinBS);
        rValorBS := StrToFloat(ClienteNumero(sValorBS));
      end;

      { FAB }
      if not CalculaBeneficioMinimo ( piNumeroProcesso, piIdPessJur,       piIdPlanoPrev,
                                      piIdTitular,      piIdBeneficiario,  piIdBeneficio,

                                      FloatToStr(rValorFAB),
                                      FloatToStr(rValorFAB),
                                      qryBenefRecalculados.RecordCount,
                                      sAnoMesInicioFaixa,
                                      psDataInicio, sNovaDataFinal,
                                      rVlrDepoisMinFAB,
                                      sMsgErro )
      then Exit;

      if rVlrDepoisMinFAB > 0 then
      begin
        sValorFAB := FloatToStr(rVlrDepoisMinFAB);
        rValorFAB := StrToFloat(ClienteNumero(sValorFAB));
      end;

      { Deficit }
      if not CalculaBeneficioMinimo ( piNumeroProcesso, piIdPessJur,       piIdPlanoPrev,
                                      piIdTitular,      piIdBeneficiario,  piIdBeneficio,

                                      FloatToStr(rValorDeficit),
                                      FloatToStr(rValorDeficit),
                                      qryBenefRecalculados.RecordCount,
                                      sAnoMesInicioFaixa,
                                      psDataInicio, sNovaDataFinal,
                                      rVlrDepoisMinDeficit,
                                      sMsgErro )
      then Exit;

      if rVlrDepoisMinDeficit > 0 then
      begin
        sValorDeficit := FloatToStr(rVlrDepoisMinDeficit);
        rValorDeficit := StrToFloat(ClienteNumero(sValorDeficit));
      end;
      // edilaine - SOL 253577-17541 / PPM 978024 - fim

      // fim do tratamento de benefício mínimo

      //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
      qry.Close;
      qry.SQL.Clear;
      qry.SQl.Add(' select hb.IDPESSJUR, '+
                  '        hb.IDTITULAR, '+
                  '        hb.IDPLANOPREV, '+
                  '        hb.NUMEROPROCESSO, '+
                  '        hb.IDBENEFICIO, '+
                  '        hb.IDPESSOA, '+
                  '        hb.MESREFERENCIA, '+
                  '        hb.SEQPROPOSTA,   '+
                  '        bf.flgpagainss,   '+
                  '        bf.idsitbeneficio,'+
                  '        max(hb.VALORINTEGRAL) as VALORINTEGRAL, '+
                  '        sum(decode(hb.FLGDEVOLUCAO, 1, -hb.VALORPREV, hb.VALORPREV)) as VALORPREVISTO, '+
                  '        sum(decode(hb.FLGDEVOLUCAO, 1, -hb.VLBENEFPGTO, hb.VLBENEFPGTO)) as VLBENEFPGTO, '+
                  '        sum(decode(hb.FLGDEVOLUCAO, 1, -hb.VALORTOTAL, hb.VALORTOTAL)) as VALORTOTAL, '+
                  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                  '        max(hb.VALORBS) as VALORBS, '+
                  '        max(hb.VALORFAB) as VALORFAB, '+
                  '        max(hb.VLRBASEDEFICIT) as VLRBASEDEFICIT '+
                  // edilaine - SOL 253577-17541 / PPM 978024 - fim
                  ' from   HSTBENEFBFCIARIO hb '+
                  '        inner join BENEFBFCIARIO bf on hb.IDPLANOPREV = bf.idplanoprev AND '+
                  '                                       hb.IDBENEFICIO = bf.idbeneficio AND  '+
                  '                                       hb.NUMEROPROCESSO = bf.numeroprocesso AND '+
                  '                                       hb.IDPESSJUR = bf.idpessjur AND '+
                  '                                       hb.IDTITULAR = bf.idtitular AND '+
                  '                                       hb.IDPLANOORIGEM = bf.idplanoorigem AND '+
                  '                                       hb.IDPESSOA = bf.idpessoa AND '+
                  '                                       hb.SEQPROPOSTA = bf.seqproposta '+
                  ' where  (hb.IDPESSOA = '+IntToStr(piIdBeneficiario)          +')'+
                  ' and    (hb.MESREFERENCIA = '''+sAnoMesAposInicioFaixa+''')'+
                  ' and    (hb.IDBENEFICIO = '+IntToStr(piIdBeneficio)       +')'+
                  ' and    (hb.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)    +')'+
                  ' and    (TRUNC(hb.TRGDTINCLUSAO) < TO_DATE('+QuotedStr(DateToStr(date))+', ''DD/MM/YYYY'') ) '+   //edilaine - SIG74042
                  ' group by hb.IDPESSJUR, '+
                  '          hb.IDTITULAR, '+
                  '          hb.IDPLANOPREV, '+
                  '          hb.NUMEROPROCESSO, '+
                  '          hb.IDBENEFICIO, '+
                  '          hb.IDPESSOA, '+
                  '          hb.MESREFERENCIA, '+
                  '          hb.SEQPROPOSTA, '+
                  '          bf.flgpagainss, '+
                  '          bf.idsitbeneficio ');
      qry.Open;

      // Verificar se beneficio está na previa ou já foi efetivado
      if BenefExistePREVIA ( qryAux, piIdPessJur,   piIdTitular,
                                 piIdPlanoPrev,    prmIdMotivoFolhaBen,
                                 piNumeroProcesso, piIdBeneficio, piIdBeneficiario, piSeqProposta,
                                 sAnoMesAposInicioFaixa, sAnoMesAposInicioFaixa) or
             ((not qry.IsEmpty) and (qry.FieldByName('VlBenefPgto').AsFloat > 0))
              then
      begin
        iSeqBeneficio := PegaSeqBeneficio(qryAux,
                                          piIdPessJur,      piIdTitular,   piIdPlanoPrev,
                                          piIdBeneficiario, piSeqProposta, piNumeroProcesso,
                                          piIdBeneficio,    iIdMotivoAux,
                                          sAnoMesPagto,     sAnoMesAposInicioFaixa);

        if not InsereHstBenefBfciario ( qryAux,
                                        iSeqBeneficio,
                                        piNumeroProcesso, piIdBeneficio,    piIdPessJur,
                                        piIdPlanoPrev,    piIdTitular,      piSeqProposta,
                                        piIdBeneficiario, piIdRegraCalculo, iIdMotivoAux,
                                        qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,
                                        sAnoMesAposInicioFaixa, sAnoMesPagto ,
                                        psMatricula,   psInscricaoNumero,
                                        Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Devolução de Pagamento Indevido : '+sNome+ ' em '+sNovaDataFinal,1,200),

                                        qry.FieldByName('VLBENEFPGTO').AsFloat,
                                        qry.FieldByName('VLBENEFPGTO').AsFloat,
                                        qry.FieldByName('VLBENEFPGTO').AsFloat,
                                        0, 0, 1, 1, piIdLoteRetemEncerra,
                                        sMsgErro,
                                        sDataPagamento,
                                        qry.FieldByName('VALORTOTAL').AsFloat, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                        qry.FieldByName('VALORFAB').AsString,
                                        qry.FieldByName('VALORBS').AsString,
                                        qry.FieldByName('VLRBASEDEFICIT').AsString    // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                        ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                      )
        then Exit;

      //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
      end
      else
      if ((not qry.IsEmpty) and (qry.FieldByName('VALORPREVISTO').AsFloat > 0) and (qry.FieldByName('flgpagainss').AsString = '0') and (qry.FieldByName('idsitbeneficio').AsInteger = 2)) then begin
        iSeqBeneficio := PegaSeqBeneficio(qryAux,
                                          piIdPessJur,      piIdTitular,   piIdPlanoPrev,
                                          piIdBeneficiario, piSeqProposta, piNumeroProcesso,
                                          piIdBeneficio,    iIdMotivoAux,
                                          sAnoMesPagto,     sAnoMesAposInicioFaixa);

        if not InsereHstBenefBfciario ( qryAux,
                                        iSeqBeneficio,
                                        piNumeroProcesso, piIdBeneficio,    piIdPessJur,
                                        piIdPlanoPrev,    piIdTitular,      piSeqProposta,
                                        piIdBeneficiario, piIdRegraCalculo, iIdMotivoAux,
                                        qryBenefRecalculados.fieldbyname('CODPORTFORMA').asinteger,
                                        sAnoMesAposInicioFaixa, sAnoMesPagto ,
                                        psMatricula,   psInscricaoNumero,
                                        Copy('Matric.'+psMatricula+'-Insc. Nº. '+psInscricaoNumero+'- Devolução de Pagamento Indevido : '+sNome+ ' em '+sNovaDataFinal,1,200),

                                        qry.FieldByName('VALORPREVISTO').AsFloat,
                                        qry.FieldByName('VALORPREVISTO').AsFloat,
                                        qry.FieldByName('VALORPREVISTO').AsFloat,
                                        //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
                                        0, 8, 1, 1, piIdLoteRetemEncerra,
                                        sMsgErro,
                                        sDataPagamento,
                                        qry.FieldByName('VALORTOTAL').AsFloat, 0,0,0,0,0,0,-1,'',-1,'',False,  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
                                        qry.FieldByName('VALORFAB').AsString,
                                        qry.FieldByName('VALORBS').AsString,
                                        qry.FieldByName('VLRBASEDEFICIT').AsString    // edilaine - SOL 253577-17541 / PPM 978024 - fim
                                        ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                      )
        then Exit;
      end else
      begin
        if not qry.IsEmpty // Beneficio está preparado, mas não está na previa, nem efetivado
        then begin
          qryAux.Close;
          qryAux.SQL.Clear;

          if cRetemEncerra = 'E'
          then begin

            { Alterado para tratar eventual Abono já preparado mas não pago }
            sSQL := ' DELETE FROM HSTBENEFBFCIARIO '+
                    ' WHERE (IDPESSOA       = '+IntToStr(piIdBeneficiario)          +')'+
                    ' AND   (MESREFERENCIA  = '''+sAnoMesAposInicioFaixa      +''')'+
                    ' AND   (IDBENEFICIO    = '+IntToStr(piIdBeneficio)       +')'+
                    ' AND   (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)    +')';
            { Caso seja mes do Abono Anual (13) altera o IDMOTIVO }
            If Copy(sAnoMesAposInicioFaixa,6,2) = '13'
            Then Begin
              sSQL := sSQL +  ' AND   (IDMOTIVO       = '+IntToStr(prmIdMotivoAbono) +')';
            End Else Begin
              sSQL := sSQL +  ' AND   (IDMOTIVO       = '+IntToStr(prmIdMotivoFolhaBEN) +')';
            End;

          end
          else { if cRetemEncerra = 'E' }
          begin

            sSQL := ' UPDATE HSTBENEFBFCIARIO SET FLGENVIADO = 9, FLGCONCESSAO = 1 '+
                    ' WHERE (IDPESSOA       = '+IntToStr(piIdBeneficiario)          +')'+
                    ' AND   (MESREFERENCIA  = '''+sAnoMesAposInicioFaixa      +''')'+
                    ' AND   (IDBENEFICIO    = '+IntToStr(piIdBeneficio)       +')'+
                    ' AND   (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)    +')';
            { Caso seja mes do Abono Anual (13) aLtera o IDMOTIVO }
            If Copy(sAnoMesAposInicioFaixa,6,2) = '13' Then
            Begin
              sSQL := sSQL +  ' AND   (IDMOTIVO       = '+IntToStr(prmIdMotivoAbono) +')';
            End Else Begin
              sSQL := sSQL +  ' AND   (IDMOTIVO       = '+IntToStr(prmIdMotivoFolhaBEN) +')';
            End;

          end; { if cRetemEncerra = 'E' }

          qryAux.SQL.Add(sSQL);
          try
            qryAux.ExecSQL;
          except
          //Brunno Mattos - KTN 767861 - SOL 132659 Inicio
          on e:Exception do
          begin
            TratarErro(e.Message);
            sMsgErro := sNome+' : Erro ao desfazer benefício preparado. ';
            Exit;
          end;
          //Brunno Mattos - KTN 767861 - SOL 132659 Fim

          end;

        end; { Else if not qry.IsEmpty }

      end; { Else if BenefExistePREVIA ( qryAux, piIdPessJur,   piIdTitular, }

      sAnoMesAposInicioFaixa := ProximoAnoMes(StrToInt(Copy(sAnoMesAposInicioFaixa, 6,2)), StrToInt(Copy(sAnoMesAposInicioFaixa, 1,4)));

    End; { while sAnoMesAposInicioFaixa <= sAnoMesFinalFaixa do }

  End; { if not pbApenasMudouPrevistaParaEfetiva}

  // 4. Verificar possiveis problemas para os ABONOS do ano da data final, até o ano atual
  //    4.1 Para cada ano encontrado fazer :
  //        4.1.1. Verificar se abono já foi pago
  //        4.1.2. Se abono já pago entao pedir devolucao pro-rata
  //        4.1.3. Se abono na previa entao informar que para desfazer previa
  //        4.1.4. Se abono preparado entao desfazer preparo do valor integral e fazer o pro-rata
  // ********************************************************************************
  // ABONO : Verificar ABONOS que devem ser pagos no período anterior ao encerramento
  // ********************************************************************************
  // CONFORME RESPONDIDO POR TODOS OS CLIENTES EM QUESTIONARIO ENVIADO EM AGOSTO/2004
  // A RETENCAO NUNCA CALCULA ABONO
  if cRetemEncerra = 'E' then
  begin

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add(' SELECT MAX(MESREFERENCIA) AS ULTMESABONO FROM HSTBENEFBFCIARIO '+
                   ' WHERE  IDPESSOA        = '+IntToStr(piIdBeneficiario)+
                   ' AND    SUBSTR(MESREFERENCIA,6,2) = ''13'' '+
                   ' AND    IDBENEFICIO     = '+IntToStr(piIdBeneficio)+
                   ' AND    NUMEROPROCESSO  = '+IntToStr(piNumeroProcesso)+
                   ' AND    VLBENEFPGTO     IS NOT NULL ');
    qryAux.Open;

    if (qryAux.IsEmpty) or (qryAux.FieldByName('UltMesAbono').AsString = '')
    then sUltAnoMesAbono := Copy(sNovaDataFinal,7,4)+'/'+PagaMesPagAbono( QryAux,
                                                                          piIdPessjur, piIdPlanoPrev, piIdBeneficio,
                                                                          sAnoMesPagto,
                                                                          bEhAntecipacao )
    else sUltAnoMesAbono := qryAux.FieldByName('UltMesAbono').AsString;

    bPagaAbono := VerificaSePagaAbonoParticip( qryAux,
                                               piIdPlanoPrev, piIdBeneficio, '', '',
                                               iIdRegraAbono,
                                               cTipoAbono, // A - final do Ano e B - final do Beneficio
                                               bErro, sMsgErro );
    if bPagaAbono
    then begin

      // verifica se existe o cadastro de mês de pagamento do abono
      // caso exista, assume-se este mês caso não, asusme-se como o mês 12

      // Acertar abono a partir do ano do encerramento

      sAnoMesInicioAbono := sAnoMesInicioFaixa;
      sAnoMesFinalAbono  := sAnoMesFinalFaixa;
      sAnoMesAtualAbono  := sAnoMesInicioFaixa;

      While ( sAnoMesAtualAbono <= sAnoMesFinalAbono ) Do
      Begin

        if (sAnoMesAtualAbono = sAnoMesFinalAbono)      and
           (Copy(sAnoMesPagto,6,2) <> sMesAbono)        and
           (sAnoMesPagto           < sAnoMesFinalAbono) and
           (cTipoAbono = 'A')
        then break;

        if not EhMesAbono(QryAux,piIdPessjur, piIdPlanoPrev, piIdBeneficio,sAnoMesAtualAbono)
        then begin

          if not ( (sAnoMesAtualAbono = sAnoMesInicioAbono) and (cTipoAbono = 'B') ) then
          begin
            sAnoMesAtualAbono := ProximoAnoMes(StrToInt(Copy(sAnoMesAtualAbono, 6,2)), StrToInt(Copy(sAnoMesAtualAbono, 1,4)));
            continue;
          end;

        end;

        // Para os anos anteriores ao ultimo, pagar o abono INCONDICIONALMENTE
        // Para o ultimo ano, verificar se o abono é pago no final do ano ou
        // no final do beneficio. Se for pago no final do ano, entao a folha
        // irá preparar este abono
        if StrToInt(Copy(sAnoMesAtualAbono,1,4)) < StrToInt(Copy(sNovaDataFinal,7,4))
        then sAnoMesBuscaAbono  := sAnoMesAtualAbono
        else sAnoMesBuscaAbono  := Copy(sNovaDataFinal,7,4)+'/'+Copy(sNovaDataFinal,4,2);

        // Pega valor do abono para passar pela regra de Ben. Mínimo.
        sSql := ' SELECT MESREFERENCIA, VALORTOTAL, VALORINTEGRAL, '+
                '        VALORBS, VALORFAB, VLRBASEDEFICIT '+    // edilaine - SOL 253577-17541 / PPM 978024
                ' FROM HSTBENEFBFCIARIO '+
                ' WHERE  IDPESSOA = '+IntToStr(piIdBeneficiario);

        If sAnoMesAtualAbono = sAnoMesFinalAbono Then
          sSql := sSql + ' AND    (MESREFERENCIA <= '+ QuotedStr(Copy(sNovaDataFinal,7,4)+Copy(sNovaDataFinal,3,3))+
                         '         OR MESREFERENCIA = '+QuotedStr(sAnoMesAtualAbono)+')'
        Else
          sSql := sSql + ' AND    MESREFERENCIA   <= '''+sAnoMesAtualAbono+'''';

        sSql := sSql + ' AND    IDBENEFICIO     = '+IntToStr(piIdBeneficio)+
                       ' AND    NUMEROPROCESSO  = '+IntToStr(piNumeroProcesso)+
                       ' AND    VALORINTEGRAL > 0 '+
                       ' ORDER BY MESREFERENCIA DESC,  SEQBENEFICIO DESC';

        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add(sSql);
        qryAux.Open;
        qryAux.First;

        If not qryAux.IsEmpty
        Then Begin

          If piIdTitular = piIdBeneficiario Then
            rValorIntegral := qryAux.FieldbyName('VALORINTEGRAL').AsFloat
          Else
            rValorIntegral := qryAux.FieldbyName('VALORTOTAL').AsFloat;

          sValorTotal    := qryAux.FieldbyName('VALORTOTAL').AsString;
          sValorIntegral := OraNumero(FloatToStr(rValorIntegral));

          // edilaine - SOL 253577-17541 / PPM 978024 - inciio
          sVlrBSAbono      := qryAux.FieldbyName('VALORBS').AsString;
          sVlrFABAbono     := qryAux.FieldbyName('VALORFAB').AsString;
          sVlrDeficitAbono := qryAux.FieldbyName('VLRBASEDEFICIT').AsString;
          // edilaine - SOL 253577-17541 / PPM 978024 - fim

        End
        Else
        Begin

          rValorIntegral := prValorAtual;
          sValorIntegral := OraNumero(FloatToStr(prValorATual));

          // edilaine - SOL 253577-17541 / PPM 978024 - inciio
          {busca valores}
          qryAux.Close;
          qryAux.SQL.Clear;
          qryAux.SQL.Add(' SELECT BFC.FLGPROVISORIO, BFC.IDPLANOORIGEM,  '+
                         '        BP.FLGAPRESENTABSFAB, BP.FLGAPRESENTADEFICIT, '+
                         '        BFC.VLRFABATUAL, BFC.VLRBSATUAL, BFC.VLRBASEDEFICIT '+
                         '   FROM BENEFBFCIARIO BFC, BENEFPLANPREV BP '+
                         '  WHERE BFC.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
                         '    AND BFC.IDPESSJUR      = '+IntToStr(piIdPessJur)+
                         '    AND BFC.IDTITULAR      = '+IntToStr(piIdTitular)+
                         '    AND BFC.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
                         '    AND BFC.IDBENEFICIO    = '+IntToSTr(piIdBeneficio)+
                         '    AND BFC.IDPESSOA       = '+IntToStr(piIdBeneficiario)+
                         '    AND BFC.SEQPROPOSTA    = '+IntToStr(piSeqProposta) +
                         '    AND BFC.IDPLANOPREV    = BP.IDPLANOPREV '+
                         '    AND BFC.IDBENEFICIO    = BP.IDBENEFICIO ');
          qryAux.Open;

          sVlrBSAbono      := qryAux.FieldbyName('VALORBS').AsString;
          sVlrFABAbono     := qryAux.FieldbyName('VALORFAB').AsString;
          sVlrDeficitAbono := qryAux.FieldbyName('VLRBASEDEFICIT').AsString;
          // edilaine - SOL 253577-17541 / PPM 978024 - fim
        End;

        sAnoMesMinimoAbono := Copy(sAnoMesBuscaAbono,1,4)+'/13';

        // Valor integral já foi comparado com o minimo ao calcular o valor de
        // dezembro Passa pela regra de Benef Mínimo para o abono.
        if not CalculaBeneficioMinimo ( piNumeroProcesso,
                                        piIdPessJur,      piIdPlanoPrev, piIdTitular,
                                        piIdBeneficiario, piIdBeneficio,
                                        FloatToStr(rValorIntegral),
                                        FloatToStr(rValorIntegral),
                                        qryBenefRecalculados.RecordCount,
                                        sAnoMesInicioFaixa,
                                        psDataInicio,
                                        sNovaDataFinal,
                                        dValorDepoisMinimo,
                                        sMsgErro )
        then Exit;

        // edilaine - SOL 253577-17541 / PPM 978024 - inicio
        if sVlrBSAbono <> '' then
        begin
          if not CalculaBeneficioMinimo ( piNumeroProcesso,
                                          piIdPessJur,      piIdPlanoPrev, piIdTitular,
                                          piIdBeneficiario, piIdBeneficio,
                                          sVlrBSAbono,
                                          sVlrBSAbono,
                                          qryBenefRecalculados.RecordCount,
                                          sAnoMesInicioFaixa,
                                          psDataInicio,
                                          sNovaDataFinal,
                                          rVlrDepoisMinBS,
                                          sMsgErro )
          then Exit;

          if rVlrDepoisMinBS > 0 then
          begin
            sVlrBSAbono := FloatToStr(rVlrDepoisMinBS);
            rVlrBSAbono := StrToFloat(ClienteNumero(sVlrBSAbono));
          end;

        end;

        if sVlrFABAbono <> '' then
        begin
          if not CalculaBeneficioMinimo ( piNumeroProcesso,
                                          piIdPessJur,      piIdPlanoPrev, piIdTitular,
                                          piIdBeneficiario, piIdBeneficio,
                                          sVlrFABAbono,
                                          sVlrFABAbono,
                                          qryBenefRecalculados.RecordCount,
                                          sAnoMesInicioFaixa,
                                          psDataInicio,
                                          sNovaDataFinal,
                                          rVlrDepoisMinFAB,
                                          sMsgErro )
          then Exit;

          if rVlrDepoisMinFAB > 0 then
          begin
            sVlrFABAbono := FloatToStr(rVlrDepoisMinFAB);
            rVlrFABAbono := StrToFloat(ClienteNumero(sVlrFABAbono));
          end;

        end;

        if sVlrDeficitAbono <> '' then
        begin
          if not CalculaBeneficioMinimo ( piNumeroProcesso,
                                          piIdPessJur,      piIdPlanoPrev, piIdTitular,
                                          piIdBeneficiario, piIdBeneficio,
                                          sVlrDeficitAbono,
                                          sVlrDeficitAbono,
                                          qryBenefRecalculados.RecordCount,
                                          sAnoMesInicioFaixa,
                                          psDataInicio,
                                          sNovaDataFinal,
                                          rVlrDepoisMinDeficit,
                                          sMsgErro )
          then Exit;

          if rVlrDepoisMinDeficit > 0 then
          begin
            sVlrDeficitAbono := FloatToStr(rVlrDepoisMinDeficit);
            rVlrDeficitAbono := StrToFloat(ClienteNumero(sVlrDeficitAbono));
          end;
        end;
       // edilaine - SOL 253577-17541 / PPM 978024 - fim

        if prmIdRegraCalcBenefMin <= 0 Then
        Begin

          qryAux.Close;
          qryAux.SQL.Clear;
          qryAux.SQL.Add(' SELECT MESREFERENCIA, VALORINTEGRAL, VALORTOTAL, '+
                         '        VALORBS, VALORFAB, VLRBASEDEFICIT '+   // edilaine - SOL 253577-17541 / PPM 978024
                         ' FROM   HSTBENEFBFCIARIO '+
                         ' WHERE  IDPESSOA        = '+IntToStr(piIdBeneficiario)+
                         ' AND    MESREFERENCIA   <= '''+sAnoMesBuscaAbono+''''+
                         ' AND    IDBENEFICIO     = '+IntToStr(piIdBeneficio)+
                         ' AND    NUMEROPROCESSO  = '+IntToStr(piNumeroProcesso)+
                         ' AND    VALORINTEGRAL > 0 '+
                         ' ORDER BY MESREFERENCIA DESC,  SEQBENEFICIO DESC'
                         );
          qryAux.Open;
          qryAux.First;

          if (not qryAux.IsEmpty)
          then sValorInteiro := qryAux.FieldbyName('VALORINTEGRAL').AsString
          else sValorInteiro := sValorIntegral;

          sValorTotal    := qryAux.FieldbyName('VALORTOTAL').AsString;

          // edilaine - SOL 253577-17541 / PPM 978024 - inicio
          sValorBS      := qryAux.FieldbyName('VALORBS').AsString;
          sValorFAB     := qryAux.FieldbyName('VALORFAB').AsString;
          sValorDeficit := qryAux.FieldbyName('VLRBASEDEFICIT').AsString;
          // edilaine - SOL 253577-17541 / PPM 978024 - fim

        End
        Else
        Begin

          sValorInteiro := FloatToStr(dValorDepoisMinimo);
          sValorTotal   := FloatToStr(dValorDepoisMinimo);

          // edilaine - SOL 253577-17541 / PPM 978024 - inicio
          sValorBS      := FloatToStr(rVlrDepoisMinBS);
          sValorFAB     := FloatToStr(rVlrDepoisMinFAB);
          sValorDeficit := FloatToStr(rVlrDepoisMinDeficit);
          // edilaine - SOL 253577-17541 / PPM 978024 - fim

        End;

        if Copy(sAnoMesAtualAbono,1,4) < Copy(sAnoMesFinalAbono,1,4) then
        begin

          rValorAbono :=  ExecutaRegraValorAbono(qryAux,
                                                 iIdRegraAbono, piIdPessJur,
                                                 piIdPlanoPrev, piIdTitular,
                                                 piSeqProposta, piIdBeneficiario,
                                                 piIdBeneficio,
                                                 psDataInicio,  sNovaDataFinal,
                                                 sAnoMesAtualAbono,
                                                 StrToFloat(ClienteNumero(sValorInteiro)),
                                                 sFlagProvisorio,
                                                 bErro,
                                                 sMsgErro,
                                                 iIdCalculoGeral,
                                                 3 , qryBenefRecalculados.RecordCount,
                                                 '', StrToFloat(ClienteNumero(sValorTotal)));

          // edilaine - SOL 253577-17541 / PPM 978024 - inicio
          if sValorBS <> '' then
          begin
            rVlrBSAbono :=  ExecutaRegraValorAbono(qryAux,
                                                   iIdRegraAbono, piIdPessJur,
                                                   piIdPlanoPrev, piIdTitular,
                                                   piSeqProposta, piIdBeneficiario,
                                                   piIdBeneficio,
                                                   psDataInicio,  sNovaDataFinal,
                                                   sAnoMesAtualAbono,
                                                   StrToFloat(ClienteNumero(sValorBS)),
                                                   sFlagProvisorio,
                                                   bErro,
                                                   sMsgErro,
                                                   iIdCalculoGeral,
                                                   3 , qryBenefRecalculados.RecordCount,
                                                   '', StrToFloat(ClienteNumero(sValorTotal)));

            sVlrBSAbono := FloatToStr(rVlrBSAbono);
          end;

          if sValorFAB <> '' then
          begin
            rVlrFABAbono :=  ExecutaRegraValorAbono(qryAux,
                                                    iIdRegraAbono, piIdPessJur,
                                                    piIdPlanoPrev, piIdTitular,
                                                    piSeqProposta, piIdBeneficiario,
                                                    piIdBeneficio,
                                                    psDataInicio,  sNovaDataFinal,
                                                    sAnoMesAtualAbono,
                                                    StrToFloat(ClienteNumero(sValorFAB)),
                                                    sFlagProvisorio,
                                                    bErro,
                                                    sMsgErro,
                                                    iIdCalculoGeral,
                                                    3 , qryBenefRecalculados.RecordCount,
                                                    '', StrToFloat(ClienteNumero(sValorTotal)));

            sVlrFABAbono := FloatToStr(rVlrFABAbono);
          end;

          if sValorDeficit <> '' then
          begin
            rVlrDeficitAbono :=  ExecutaRegraValorAbono(qryAux,
                                                   iIdRegraAbono, piIdPessJur,
                                                   piIdPlanoPrev, piIdTitular,
                                                   piSeqProposta, piIdBeneficiario,
                                                   piIdBeneficio,
                                                   psDataInicio,  sNovaDataFinal,
                                                   sAnoMesAtualAbono,
                                                   StrToFloat(ClienteNumero(sValorDeficit)),
                                                   sFlagProvisorio,
                                                   bErro,
                                                   sMsgErro,
                                                   iIdCalculoGeral,
                                                   3 , qryBenefRecalculados.RecordCount,
                                                   '', StrToFloat(ClienteNumero(sValorTotal)));

            sVlrDeficitAbono := FloatToStr(rVlrDeficitAbono);
          end;
          // edilaine - SOL 253577-17541 / PPM 978024 - fim

        end
        else
        begin

          // MesAtualAbono = FinalAtualAbono
          // Se for o ultimo ano/mes e o abono for pago apenas no final do ano
          // e nao estivermos no final do ano e nao for falecimento do proprio participante
          // Entao nao pagar abono
          if (cTipoAbono = 'A') and
            (((Copy(sAnoMesAtualAbono,1,4)>= Copy(sAnoMesPagto,1,4)) and (Copy(sAnoMesPagto,6,2) <> sMesAbono) )) then
          begin

            if (piIdTitular = piIdBeneficiario) then
            begin
              if not pbFlgEncerraFale
              then break;
            end
            else
              break;
          end;

          rValorAbono :=  ExecutaRegraValorAbono( qryAux,
                                                  iIdRegraAbono, piIdPessJur,   piIdPlanoPrev,
                                                  piIdTitular,   piSeqProposta, piIdBeneficiario,
                                                  piIdBeneficio,

                                                  psDataInicio,  sNovaDataFinal,
                                                  sAnoMesAtualAbono,
                                                  StrToFloat(ClienteNumero(sValorInteiro)),
                                                  sFlagProvisorio,
                                                  bErro,
                                                  sMsgErro,
                                                  iIdCalculoGeral,
                                                  3, qryBenefRecalculados.RecordCount,
                                                  '',
                                                  StrToFloat(ClienteNumero(sValorTotal)) );

         // edilaine - SOL 253577-17541 / PPM 978024 - inicio
          if sValorBS <> '' then
          begin
            rVlrBSAbono :=  ExecutaRegraValorAbono(qryAux,
                                                   iIdRegraAbono, piIdPessJur,
                                                   piIdPlanoPrev, piIdTitular,
                                                   piSeqProposta, piIdBeneficiario,
                                                   piIdBeneficio,
                                                   psDataInicio,  sNovaDataFinal,
                                                   sAnoMesAtualAbono,
                                                   StrToFloat(ClienteNumero(sValorBS)),
                                                   sFlagProvisorio,
                                                   bErro,
                                                   sMsgErro,
                                                   iIdCalculoGeral,
                                                   3 , qryBenefRecalculados.RecordCount,
                                                   '', StrToFloat(ClienteNumero(sValorTotal)));

            sVlrBSAbono := FloatToStr(rVlrBSAbono);
          end;

          if sValorFAB <> '' then
          begin
            rVlrFABAbono :=  ExecutaRegraValorAbono(qryAux,
                                                   iIdRegraAbono, piIdPessJur,
                                                   piIdPlanoPrev, piIdTitular,
                                                   piSeqProposta, piIdBeneficiario,
                                                   piIdBeneficio,
                                                   psDataInicio,  sNovaDataFinal,
                                                   sAnoMesAtualAbono,
                                                   StrToFloat(ClienteNumero(sValorFAB)),
                                                   sFlagProvisorio,
                                                   bErro,
                                                   sMsgErro,
                                                   iIdCalculoGeral,
                                                   3 , qryBenefRecalculados.RecordCount,
                                                   '', StrToFloat(ClienteNumero(sValorTotal)));

            sVlrFABAbono := FloatToStr(rVlrFABAbono);
          end;

          if sValorDeficit <> '' then
          begin
            rVlrDeficitAbono :=  ExecutaRegraValorAbono(qryAux,
                                                   iIdRegraAbono, piIdPessJur,
                                                   piIdPlanoPrev, piIdTitular,
                                                   piSeqProposta, piIdBeneficiario,
                                                   piIdBeneficio,
                                                   psDataInicio,  sNovaDataFinal,
                                                   sAnoMesAtualAbono,
                                                   StrToFloat(ClienteNumero(sValorDeficit)),
                                                   sFlagProvisorio,
                                                   bErro,
                                                   sMsgErro,
                                                   iIdCalculoGeral,
                                                   3 , qryBenefRecalculados.RecordCount,
                                                   '', StrToFloat(ClienteNumero(sValorTotal)));

            sVlrDeficitAbono := FloatToStr(rVlrDeficitAbono);
          end;
          // edilaine - SOL 253577-17541 / PPM 978024 - fim
        end;

        qryAux.Close;
        qryAux.SQL.Clear;

        qryAux.SQl.Add(' SELECT SUM(DECODE(FLGDEVOLUCAO,1,-VLBENEFPGTO,VLBENEFPGTO)) AS VLBENEFPGTO '+
                       ' FROM   HSTBENEFBFCIARIO '+
                       ' WHERE  (IDPESSOA       = '+IntToStr(piIdBeneficiario)      +')'+
                       ' AND    (MESREFERENCIA  = '''+Copy(sAnoMesAtualAbono,1,4)+'/13'+''')'+
                       ' AND    (IDBENEFICIO    = '+IntToStr(piIdBeneficio)+')'+
                       ' AND    (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+')');
        qryAux.Open;

        if not qryAux.IsEmpty
        then rValorAbonoJaPago := qryAux.FieldByName('VLBENEFPGTO').AsFloat
        else rValorAbonoJaPago := 0;


        If ( rValorAbonoJaPago = 0 ) And
           ( sAnoMesAtualAbono > sAnoMesInicioFaixa ) Then
        Begin
          sAnoMesAtualAbono := ProximoAnoMes( StrToInt( Copy( sAnoMesAtualAbono, 6,2 ) ),
                                              StrToInt( Copy( sAnoMesAtualAbono, 1,4 ) ) );
          Continue;
        End;

        if rValorAbonoJaPago <= 0 then
        begin
          qryAux.Close;
          qryAux.SQL.Clear;
          qryAux.SQl.Add(' DELETE '+
                         ' FROM   HSTBENEFBFCIARIO '+
                         ' WHERE  (IDPESSOA       = '+IntToStr(piIdBeneficiario)      +')'+
                         ' AND    (MESREFERENCIA  = '''+Copy(sAnoMesAtualAbono,1,4)+'/13'+''')'+
                         ' AND    (IDBENEFICIO    = '+IntToStr(piIdBeneficio)+')'+
                         ' AND    (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+')');
          qryAux.ExecSql;

        End
        Else
        Begin

          {  Tratamento para adiantamento de abono }
          If ( sAnoMesAtualAbono <= sAnoMesInicioFaixa ) Then
          Begin

            bDevolverAdiantamento := True;

          End;
         

        end;

        // Se já teve abono pago e a diferença for de até 1 centavo, entao ignorar
        if (rValorAbonoJaPago > 0) and (Abs(rValorAbono - rValorAbonoJaPago) <= 0.011) then
        begin
          sAnoMesAtualAbono  := ProximoAnoMes(StrToInt(Copy(sAnoMesAtualAbono, 6,2)), StrToInt(Copy(sAnoMesAtualAbono, 1,4)));
          continue;
        end;

        // irá devolver tudo que já foi pago e cobrar o valor calculado pela regra.   
        rValorAbono   := rValorAbono;
        sFlgDevolucao := '0';

        sAnoMesRefAbono := Copy(sAnoMesAtualAbono,1,4)+'/13';

        // Insere no Historico de Beneficios
        if iIdRegraAbono > 0 then
          sIdRegraCalculo := IntToStr(iIdRegraAbono)
        else
          sIdRegraCalculo := ' NULL ';

        If rValorAbono > 0 then
        Begin
          sSQL := ' DELETE '+
                  ' FROM   HSTBENEFBFCIARIO '+
                  ' WHERE  (IDPESSOA       = '+IntToStr(piIdBeneficiario) +')'+
                  ' AND    (MESREFERENCIA  = '+QuotedStr(sAnoMesRefAbono) +')'+
                  ' AND    (MES            = '+QuotedStr(sAnoMesPagto)    +')'+
                  ' AND    (IDMOTIVO       = '+IntToStr(iIdMotivoAux)     +')'+
                  ' AND    (IDBENEFICIO    = '+IntToStr(piIdBeneficio)    +')'+
                  ' AND    (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso) +')'+
                  ' AND    (VLBENEFPGTO <= 0 OR VLBENEFPGTO IS NULL) ' ;

          ExecutarQuery(QryAux, sSQL);

          qryAux.Close;
          qryAux.Sql.Clear;
          qryAux.Sql.Add('SELECT IDPLANOORIGEM   '                            +
                         'FROM BENEFBFCIARIO     '                            +
                         'WHERE NUMEROPROCESSO = '+IntToStr(piNumeroProcesso) +
                         ' AND IDBENEFICIO    = '+IntToStr(piIdBeneficio)    +
                         ' AND IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)    +
                         ' AND IDPESSJUR      = '+IntToStr(piIdPessJur)      +
                         ' AND IDTITULAR      = '+IntToStr(piIdTitular)      +
                         ' AND IDPESSOA       = '+IntToStr(piIdBeneficiario) +
                         ' AND SEQPROPOSTA    = '+IntToStr(piSeqProposta))   ;
          qryAux.Open;
          sPlanoOrigem := qryAux.FieldByName('IDPLANOORIGEM').AsString;

          { Tratamento para adiantamento de abono. }
          { Cobrar todo adiantamento pago caso exista. E pagar integralmente   }
          { o abono do ano.                                                    }

          iCodPortForma   := QryBenefRecalculados.FieldByName('CODPORTFORMA').AsInteger;

          //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
          qry.Close;
          qry.SQL.Clear;
          qry.SQl.Add(' select BF.FLGPAGAINSS,   '+
                      '        BF.IDSITBENEFICIO '+
                      '   from BENEFBFCIARIO BF  '+
                      ' where (BF.IDPESSOA = '+IntToStr(piIdBeneficiario)     +')'+
                      ' and (BF.IDBENEFICIO = '+IntToStr(piIdBeneficio)       +')'+
                      ' and (BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso) +')');
          qry.Open;

          sFlgEnviado := 0;
          if ((not qry.IsEmpty) and (qry.FieldByName('flgpagainss').AsString = '0') and (qry.FieldByName('idsitbeneficio').AsInteger = 2)) then begin
            sFlgEnviado := 8;
          end;
          //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622

          If ( bDevolverAdiantamento = True ) Then
          Begin

            iSeqBeneficio := PegaSeqBeneficio(qryAux,
                                              piIdPessJur,   piIdTitular,
                                              piIdPlanoPrev, piIdBeneficiario,
                                              piSeqProposta, piNumeroProcesso,
                                              piIdBeneficio, iIdMotivoAux,
                                              sAnoMesPagto,
                                              sAnoMesRefAbono );

            If not InsereHstBenefBfciario( QryAux,
                                           iSeqBeneficio,
                                           piNumeroProcesso, piIdBeneficio,
                                           piIdPessJur,      piIdPlanoPrev,
                                           piIdTitular,      piSeqProposta,
                                           piIdBeneficiario,
                                           -1,                             { IDREGRACALCULO    }
                                           iIdMotivoAux,                   { IDMOTIVO          }
                                           iCodPortForma,                  { CODPORTFORMA      }
                                           sAnoMesRefAbono,                { MESREFERENCIA     }
                                           sAnoMesPagto,                   { MESCOBRANCA       }
                                           '', '', '',
                                           rValorAbonoJaPago,              { VALORPREV         }
                                           rValorAbonoJaPago,              { VALORCALCULADO    }
                                           StrToFloat( sValorInteiro ),    { VALORINTEGRAL     }
                                           0,                              { VALORPAGO         }
                                           sFlgEnviado,                    //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
                                           1,                              { PIFLGCONCESSAO    }
                                           1,                              { FLGDEVOLUCAO      }
                                           piIdLoteRetemEncerra,
                                           sMsgErro,
                                           sDataPagamento, 
                                           dValorTotalOriginal,
                                           0,                              { VALORSRB          }
                                           dPercentual,                    { PERCENTUAL        }
                                           0,                              { VALORPREVANTESMIN }
                                           0,                              { VALOROP1          }
                                           0,                              { VALOROP3          }
                                           0,                              { VALOROP2          }

                                           piIdTitular,                    { IDTITBENEF        }
                                           sAnoMesAtualAbono,
                                           4                               { TIPOMOV           }
                                           ,''
                                           , false
                                           , sVlrFABAbono            // edilaine - SOL 253577-17541 / PPM 978024
                                           , sVlrBSAbono             // edilaine - SOL 253577-17541 / PPM 978024
                                           , sVlrDeficitAbono        // edilaine - SOL 253577-17541 / PPM 978024
                                           ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                            ) Then
            Begin
              bErro := True;
              sMsgErro := 'Erro na gravação do abono . ';
              Exit;
            End;

          End;

          iSeqBeneficio := PegaSeqBeneficio(qryAux,
                                            piIdPessJur,   piIdTitular,
                                            piIdPlanoPrev, piIdBeneficiario,
                                            piSeqProposta, piNumeroProcesso,
                                            piIdBeneficio, iIdMotivoAux,
                                            sAnoMesPagto,
                                            sAnoMesRefAbono );

          If not InsereHstBenefBfciario( QryAux,
                                         iSeqBeneficio,
                                         piNumeroProcesso, piIdBeneficio,
                                         piIdPessJur,      piIdPlanoPrev,
                                         piIdTitular,      piSeqProposta,
                                         piIdBeneficiario,
                                         StrToInt( sIdRegraCalculo ) ,   { IDREGRACALCULO    }
                                         iIdMotivoAux,                   { IDMOTIVO          }
                                         iCodPortForma,                  { CODPORTFORMA      }
                                         sAnoMesRefAbono,                { MESREFERENCIA     }
                                         sAnoMesPagto,                   { MESCOBRANCA       }
                                         '', '', '',
                                         rValorAbono, rValorAbono,
                                         StrToFloat( sValorInteiro ),
                                         0, // VALORPAGO
                                         sFlgEnviado,                    //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
                                         1, // PIFLGCONCESSAO
                                         StrToInt( sFlgDevolucao ),
                                         piIdLoteRetemEncerra,
                                         sMsgErro,
                                         sDataPagamento, 
                                         dValorTotalOriginal,
                                         0,                              { VALORSRB          }
                                         dPercentual,                    { PERCENTUAL        }
                                         0,                              { VALORPREVANTESMIN }
                                         0,                              { VALOROP1          }
                                         0,                              { VALOROP3          }
                                         0,                              { VALOROP2          }

                                         piIdTitular,                    { IDTITBENEF        }
                                         sAnoMesAtualAbono,
                                         4                               { TIPOMOV           }
                                         ,''
                                         , false
                                         , sVlrFABAbono            // edilaine - SOL 253577-17541 / PPM 978024
                                         , sVlrBSAbono             // edilaine - SOL 253577-17541 / PPM 978024
                                         , sVlrDeficitAbono        // edilaine - SOL 253577-17541 / PPM 978024
                                         ,0, qryBenefRecalculados.fieldbyname('IDPERFILINVEST').asinteger    //edilaine - SIG55933
                                          ) Then
          Begin
            bErro := True;
            sMsgErro := 'Erro na gravação do abono . ';
            Exit;
          End;

        End;

        sAnoMesAtualAbono  := ProximoAnoMes(StrToInt(Copy(sAnoMesAtualAbono, 6,2)), StrToInt(Copy(sAnoMesAtualAbono, 1,4)));

      End; { while sAnoMesAtualAbono <= sAnoMesFinalAbono do begin }

    End; { if bPagaAbono }

  End; { if cRetemEncerra = 'E' then }

  // *********************************************************************************************
  // ***************************  FIM DO TRATAMENTO DE BENEFICIOS
  // *********************************************************************************************

  // **************************************************************************
  // ** TRATAR CONTRIBUICOES QUE NÃO SÃO SOBRE 13o.
  // **************************************************************************
  if pbBenefReferencia
  then begin
    frmAguarde.Mostra('Atualizando Benefícios ...');
    Result := True;
    Exit;
  end;

  frmAguarde.Mostra('Atualizando Contribuições ...');

  // Preencher variaveis auxiliares
  sSQL := ' SELECT IDSITPART FROM PARTPREVPLAN '+
          ' WHERE  IDPESSJUR      = '+IntToStr(piIdPessJur)+
          ' AND    IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
          ' AND    IDPESSOA       = '+IntToStr(piIdBeneficiario) +
          ' AND    SEQPROPOSTA    = '+IntToStr(piSeqProposta);
  qry.Close;
  qry.SQL.Clear;
  qry.SQL.Add(sSQL);
  qry.Open;

  sIdSitPart := qry.FieldByName('IDSITPART').AsString;

  if cRetemEncerra = 'R'
  then iFlgDataPrevista := 1
  else iFlgDataPrevista := 0;

  // Definir IDPESSOA da contribuicao. Caso pensão buscar o responsavel
  // nucleo familiar.
  if piIdTitular <> piIdBeneficiario
  then begin
    //  Buscar responsável do Nucleo Familiar
    sSQL := ' SELECT NF.IDRESPNUCLEO                               '+
            ' FROM   BFCIARIOTITPLAN BT, NUCLEOFAMILIAR NF         '+
            ' WHERE  BT.IDPESSOA    = '+IntToStr(piIdBeneficiario)  +
            ' AND    BT.IDBENEFICIO = '+IntToStr(piIdBeneficio)     +
            ' AND    BT.IDNUCLEOFAMILIAR = NF.IDNUCLEOFAMILIAR     ';
    FazQuery(Qry, sSQL);
    iIdPessoaHstContrib := qry.FieldByName('IDRESPNUCLEO').AsInteger;
    StrConcedidos       := qry.FieldByName('IDRESPNUCLEO').AsString+',';
  end
  else
  begin
    iIdPessoaHstContrib := piIdBeneficiario;
