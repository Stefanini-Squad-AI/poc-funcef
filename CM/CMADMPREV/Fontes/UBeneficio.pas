   // edilaine - SOL 253577-17464 / PPM 955703 Fim

  PerfilAtual := BuscaPerfilInvestimento( piIdPerfilInvest);     //leandro wo3084

  {----------------------------------------------------------------------------}
  { Loop principal, de todos os meses                                          }
  While (sAnoMesLote >= sAnoMesDataInicio) And (sMesAtual <= sMesFinal) Do
  Begin

     // edilaine - SOL 253577-17464 / PPM 955703 Inicio
     if (rVlrBSTotal <> '') and (StrToFloat(rVlrBSTotal) > 0) then
