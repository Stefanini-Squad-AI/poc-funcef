                                                      dValorTitIntegral, dValorTitIntegralPosMin,      //edilaine WO18367
                                                      dValorTitIntegraAntMin, dValorTitRateado,        //edilaine WO18367
                                                      dValorSRB,
                                                      piIdCalculo,
                                                      sDataFolha,
                                                      False, pbMigracaoPlano,
                                                      -1, True, True
                                                    );

          dValorFabTitular := dValorTitIntegral;
          rValorFabTitular := FloatToStr(dValorFabTitular);
          rValorFABTitMes  := FloatToStr(dValorTitIntegral);
          //edilaine WO18367 : fim
        end;
        //edilaine WO22679 : fim


        rVlrCalculo := StrToFloat(rVlrFABTotal);
        rVlrCalculo := CalculaBeneficioAPagarNoMes( qryAux,
                                                    sMesAtual,
                                                    piIdTitular,   piIdBeneficiario,
                                                    piSeqProposta, piIdPessJur,
                                                    piIdPlanoPrev, piNumeroProcesso,
                                                    piIdBeneficio, piTotBeneficiarios,
                                                    piIdRegraPrimPagto, piIdRegraUltPagto,
                                                    piIdTpPagto,
                                                    psDataInicio, psDataFinal,
                                                    sMesFinal,
                                                    psCalculaTodoMes,
                                                    rVlrCalculo, rVlrCalculo,
                                                    dValorEmCotas,
                                                    pbCalculaPrimUltPgto,
                                                    psDataInicioOriginal,
                                                    piTipoMov,
