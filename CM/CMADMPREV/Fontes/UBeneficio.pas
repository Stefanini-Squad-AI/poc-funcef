function PegaSeqBeneficio(qryAux : TwwQuery;
                          piIdPessJur,   piIdTitular,
                          piIdPlanoPrev, piIdPessoa,
                          piSeqProposta, piNumeroProcesso,
                          piIdBeneficio, piIdMotivo         : longint;
                          psAnoMesPgmto, psAnoMesRef        : string): word;
var sSQL : string;
begin

  sSQL := ' SELECT MAX(SEQBENEFICIO) AS SEQBENEFICIO FROM HSTBENEFBFCIARIO '+
          ' WHERE (IDPESSJUR      = '+IntToStr(piIdPessJur)+'     ) '+
          ' AND   (IDTITULAR      = '+IntToStr(piIdTitular)+'     ) '+
          ' AND   (IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+'   ) ';
  //if Trim(psAnoMesPgmto) <> ''
  //then sSQL := sSQL + ' AND (MES  = '''+psAnoMesPgmto+'''         ) ';

  sSQL := sSQL + //'  AND   (IDMOTIVO       = '+IntToStr(piIdMotivo)+'      ) '+
          ' AND   (IDBENEFICIO    = '+IntToStr(piIdBeneficio)+'   ) '+
          ' AND   (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+') '+
          ' AND   (IDPESSOA       = '+IntToStr(piIdPessoa)+'      ) '+
          ' AND   (MESREFERENCIA  = '''+psAnoMesRef  +'''         ) '+
          ' AND   (SEQPROPOSTA    = '+IntToStr(piSeqProposta)+'   ) ';

  qryAux.Close;
  qryAux.SQL.Clear;
  qryAux.SQL.Add(sSQL);
  qryAux.Open;
  if qryAux.IsEmpty
  then Result := 1
  else Result := qryAux.FieldByName('SeqBeneficio').AsInteger + 1;
  qryAux.Close;
end;

function ConverteBeneficioParaCotasGeral(qryAux : TwwQuery;
                                         piIdPlanoPrev,
                                         piIdBeneficio : longint;
                                         psData        : string;
                                         prValorReal   : real;
                                         var bErro     : boolean;
                                         var sMsgErro  : string) : real;
var iIndice           : longint;
    rValorDaCotaBenef : double;
    sDataDaCotaBenef  : string;

begin
  Result := 0;
  // Verificar e beneficio é em real ou em cotas
  qryAux.Close;
  qryAux.SQL.Clear;
  qryAux.SQL.Add(' SELECT FLGCALCTODOMES, INDICEREAJBENEF '+
                 ' FROM   BENEFPLANPREV                   '+
                 ' WHERE  IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                 ' AND    IDBENEFICIO  = '+IntToStr(piIdBeneficio));
  qryAux.Open;

  if (qryAux.FieldByName('FLGCALCTODOMES').AsInteger = 0)
  then begin
     bErro := False;
     qryAux.Close;
     Exit;
  end;

  if qryAux.FieldbyName('IndiceReajBenef').AsString = ''
  then begin
     sMsgErro := 'O índice de conversão do valor do benefício não está cadastrado. '+
                 'Verifique no Cadastro de Plano Previdenciário.';
     bErro := True;
     qryAux.Close;
     Exit;
  end;

  iIndice := qryAux.FieldbyName('IndiceReajBenef').AsInteger;

  // O beneficio é em cotas -> converter pelo indice
  qryAux.Close;
  qryAux.SQL.Clear;
  qryAux.SQL.Add(' SELECT COTVALOR, COTDATA '+
                 ' FROM   COTACAOMOEDA      '+
                 ' WHERE  (MOECODIGO = '+IntToStr(iIndice)+')'+
                 ' AND    (COTDATA <= TO_DATE('''+Trim(psData)+''',''DD/MM/YYYY'') ) '+
                 ' ORDER BY COTDATA DESC ');
  qryAux.Open;
  if qryAux.IsEmpty
  then begin
     sMsgErro := 'O índice de conversão do valor do benefício não está cadastrado. '+
                 'Verifique no Cadastro de Cotações da Moeda.';
     bErro := True;
     qryAux.Close;
     Exit;
  end;
  qryAux.First;
  rValorDaCotaBenef := qryAux.FieldByName('CotValor').AsFloat;

  sDataDaCotaBenef   := FormatDateTime('dd/mm/yyyy', qryAux.FieldByName('CotData').AsDateTime); 

  // Converter de cota para real
  if rValorDaCotaBenef = 0
  then begin
     sMsgErro := 'O índice de conversão do valor do benefício está zerado. '+
                 'Verifique no Cadastro de Cotações da Moeda.';
     bErro := True;
     qryAux.Close;
     Exit;
  end
  else Result  := prValorReal / rValorDaCotaBenef;
end; // ConverteBeneficioParaCotas


function ValidaBeneficioAnterior ( qryBeneficioAntOld : TwwQuery;
                                   piIdPessJur,
                                   piIdPlanoPrev,
                                   piIdTitular,
                                   piSeqProposta,
                                   piIdEvento      : longint;
                                   bObrigatorio    : boolean;
                                   sDataEvento     : string;
                                   var sMsgErro    : string;
                                   var bEncerrou   : boolean;
                                   bVemEventoMorte    : Boolean = False) : boolean; //SOL 122922 - Ádler Souza     
var bEncerrouBenefAnt,
    bAchouBeneficio,
    bEncerra          : boolean;
    sFlgInterno       : string;
    qryBeneficioAnt   : TwwQuery;
    iNumProcessoAnt   : Longint; 
    iNumDiasBenefAnt  : word;
    bIncluiFontePagadora: Boolean; // Alterado por FHBS - 26/02/2019 - SIG81677
begin
   Result          := False;
   iNumProcessoAnt := 0;
   bEncerrou       := False;

   qryBeneficioAnt := TwwQuery.Create(Application);
   qryBeneficioAnt.DatabaseName :=  'BaseDados';

   if not bObrigatorio
   then begin
     qryBeneficioAnt.Close;
     qryBeneficioAnt.Sql.Clear;
     qryBeneficioAnt.Sql.Add(' SELECT FLGENCERRABENEFI FROM EVENTOGERADOR ' +
                             ' WHERE  IDEVENTOGERADOR = ' +IntToStr(piIdEvento) );
     qryBeneficioAnt.Open;
     bEncerra := (qryBeneficioAnt.FieldByName('FLGENCERRABENEFI').AsInteger = 1);
   end
   else bEncerra := True;

   qryBeneficioAnt.Close;
   qryBeneficioAnt.Sql.Clear;
   qryBeneficioAnt.Sql.Add(' SELECT FLGINTERNO FROM EVENTOGERADOR ' +
                           ' WHERE  IDEVENTOGERADOR = ' +IntToStr(piIdEvento) );
   qryBeneficioAnt.Open;
   if qryBeneficioAnt.IsEmpty
   then begin
      sMsgErro := 'Parâmetros do evento não encontrados.';
      qryBeneficioAnt.Close;
      qryBeneficioAnt.Free;
      Exit;
   end;

   sFlgInterno := qryBeneficioAnt.FieldByName('FlgInterno').AsString;

   if Trim(sDataEvento) = '' then sDataEvento := FormatDateTime('dd/mm/yyyy', date);

   bAchouBeneficio := True;
   iNumDiasBenefAnt := 1;

   with qryBeneficioAnt do
   begin
      //TAES - SIG111449 - início
      // Alterado por FHBS - 26/02/2019 - SIG81677
      {bIncluiFontePagadora := False;
      if (piIdEvento = 383) then
      begin
        Close;
        SQL.Clear;
        SQL.Add(' select ep.dataregistro, ep.ideventogerador');
        SQL.Add('   from eventosprev ep');
        SQL.Add('  where ep.idpessoa = ' + IntToStr(piIdTitular) );
        SQL.Add('    and ep.ideventogerador in (2,7,8,11,364,366,370,129)');
        SQL.Add('  order by ep.dataregistro desc');

        Open;
        First;
        bIncluiFontePagadora := (FieldByName('IdEventoGerador').AsInteger <> 129)
      end;}
      // Fim - Alterado por FHBS - 26/02/2019 - SIG81677
      //TAES - SIG111449 - fim


      Close;
      SQL.Clear;
      SQL.Add(' SELECT DISTINCT B.NOME,         BF.IDBENEFICIO, BF.IDTITULAR,      '+
              '                 BF.IDPLANOPREV, BF.IDPESSJUR,   BF.IDSITBENEFICIO, '+
              '                 BF.NUMEROPROCESSO, BF.DATAREQUERIMENTO,            '+
              '                 BF.FLGPROVISORIO, BP.NUMDIASBENEFANT               '+ 
              ' FROM   BENEFICIO B, BENEFPLANPREV BP, BENEFBFCIARIO BF             '+ 
              ' WHERE  (BF.IDPESSJUR      = '+IntToStr(piIdPessJur)  +')           '+
              ' AND    (BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+')           '+
              ' AND    (BF.IDTITULAR      = '+IntToStr(piIdTitular)  +')           '+
              ' AND    (BF.IDPESSOA       = '+IntToStr(piIdTitular)  +')           '+
              ' AND    (BF.IDBENEFICIO    =  B.IDBENEFICIO             )           '+
              ' AND    (BF.SEQPROPOSTA    = '+IntToStr(piSeqProposta)+')           '+
              ' AND    (BP.IDPLANOPREV    = BF.IDPLANOPREV )                       '+ 
              ' AND    (BP.IDBENEFICIO    = BF.IDBENEFICIO )                       '+ 
              ' AND    (B.FLGRESGATE <> 1)                                         '+
              ' AND    ( BF.IDSITBENEFICIO IN (1,2,4) ) ');

      //Início - William Santana - SIG 21139
      //para eventos de aposentedoria, não deve considerar eventos de INSS na verificação
      case (piIdEvento) of
          2,7,8,11,364,366,370,383: SQL.Add(' AND FONTEPAGADORA = 1 ');
          //383: if bIncluiFontePagadora then SQL.Add(' AND FONTEPAGADORA = 1 '); // Alterado por FHBS - 26/02/2019 - SIG81677 //TAES - SIG111449
      end;
      //Término - William Santana - SIG 21139

      Open;
      // Se nao estiver vazia, entao o participante possui algum beneficio
      //    em aberto (normal ou nao concedido(pendente))
      if IsEmpty
      then begin
         bAchouBeneficio := False;
      end;

      if bAchouBeneficio
      then begin
         // Se o beneficiario estiver concedido e for provisorio,
         // entao nao pode requerer outro beneficio
         while not Eof do
         begin
            if (FieldByName('IdSitBeneficio').AsInteger = 1) and (FieldByName('FlgProvisorio').AsInteger = 1)
            then begin
               sMsgErro := 'O benefício "'+FieldByName('Nome').AsString+'" requerido em '+
                           FieldByName('DataRequerimento').AsString+' é um "Benefício Provisório" '+#13+
                           'e deverá ser encerrado para haver um novo requerimento.'+#13+
                           'Verifique o Processo Nº '+FieldByName('NumeroProcesso').AsString+'.';
               Close;
               Free;
               Exit;
            end;
 
            if not bEncerra
            then begin
               Result := True;
               Close;
               Free;
               Exit;
            end;

            if FieldByname('NUMDIASBENEFANT').AsString <> ''
            then iNumDiasBenefAnt := FieldByname('NUMDIASBENEFANT').AsInteger;

            If iNumProcessoAnt <> FieldByName('NumeroProcesso').AsInteger
             Then iNumProcessoAnt := FieldByName('NumeroProcesso').AsInteger
             Else Begin
               Next;
               Continue;
             End;

            if (FieldByName('IdSitBeneficio').AsInteger = 1) or
               (FieldByName('IdSitBeneficio').AsInteger = 2) or
               (FieldByName('IdSitBeneficio').AsInteger = 3) or
               (FieldByName('IdSitBeneficio').AsInteger = 4)
            then begin // beneficio já concedido (chamar tela de encerramento)

               frmRetemEncerraNOVO := TfrmRetemEncerraNOVO.Create(Application);
               with frmRetemEncerraNOVO do
               begin
                  bOutroEvTmp := ((piIdEvento = 351) or (piIdEvento = 383));// Darivaldo Alencar SIG70882

                  bEventoMorte := bVemEventoMorte; //SOL 122922 - Ádler Souza
                  iNumeroProcesso := FieldByName('NumeroProcesso').AsInteger;
                  iIdTitular      := piIdTitular;
                  iSeqProposta    := piSeqProposta;
                  iIdPessJur      := piIdPessJur;
                  iIdPlanoPrev    := piIdPlanoPrev;

                  qry.Close;
                  qry.ParamByName('IDPESSOA').AsInteger       := iIdTitular;
                  qry.ParamByName('NUMEROPROCESSO').AsInteger := iNumeroProcesso;
                  //BRUNO AZEVEDO SOL 167416 KINTANA 1468721
                  qry.ParamByName('IDPLANOPREV').AsInteger    := iIdPlanoPrev;
                  qry.Open;

                  qryTitular.Close;
                  qryTitular.ParamByName('IdPessoa').Value    := iIdTitular;
                  qryTitular.ParamByName('IdPessJur').Value   := iIdPessJur;
                  qryTitular.ParamByName('IdPlanoPrev').Value := iIdPlanoPrev;
                  qryTitular.ParamByName('SeqProposta').Value := iSeqProposta;
                  qryTitular.Open;

                  if qry.FieldByName('IDPESSOA').AsInteger = qry.FieldByName('IDTITULAR').AsInteger
                  then lblTitulo.Caption := 'Benefícios do Participante '
                  else lblTitulo.Caption := 'Benefícios do Beneficiário ';

                  lblBeneficiario.Caption := qry.FieldByName('NOME').AsString+' (Matricula : '+qry.FieldByName('MATRICULADEP').AsString+')';

                  sbtnRetencao.Visible        := False;
                  bbtnProcurar.Visible        := False;
                  bbtnConfirmar.Enabled       := False;
                  bbtnCancelar.Enabled        := False;
                  bOperacaoEmAberto           := False;
                  bVeioDoMenu                 := False;
                  bObrigaDataEncerra          := True;
                  sFlgEvento                  := sFlgInterno;

                  //BRUNO AZEVEDO SOL 144003 KINTANA 952202
                  sDataFinalPrevista          := FormatDateTime('dd/mm/yyyy', StrToDate(sDataEvento));

                  //Renato Visoni SOL 148654 Kintana 1048386
                  if not qry.isEmpty then
                  begin
                    ShowModal;
                  end;  
                  //Renato Visoni SOL 148654 Kintana 1048386

                  //Otacilio Aquino SOL 181600 Kintana 1704215
                  if not(bEncerrou) then  // Diferente do botao sair do Encerramento de Beneficios
                     sMsgErro := 'Evento Cancelado.';

                  bEncerrouBenefAnt           := bEncerrou;

                  If ( qry.IsEmpty = True ) Then bEncerrouBenefAnt := True;

                  If ( bCancelouEncerramento = True ) Then bEncerrouBenefAnt := False;

               end;
               frmRetemEncerraNOVO.Free;

               //Otacilio Aquino SOL 181600 Kintana 1704215
               if not(bEncerrou) and (Trim(sMsgErro) <> '') then
                 Exit;

{              // SOL 102758 - KTN - 534.895 Daniel Begnami
               if not bEncerrouBenefAnt
               then begin
                  sMsgErro := 'O benefício "'+FieldByName('Nome').AsString+'" requerido em '+
                               FieldByName('DataRequerimento').AsString+' deve ser encerrado. '+#13+
                              'Verifique o Processo Nº '+FieldByName('NumeroProcesso').AsString+'.';
                  Free;
                  Exit;
               end;
}              // FIM

               bEncerrou       := True;


            end
            else begin // beneficio pendente de concessao (obrigar concessao ou nao concessao)
               sMsgErro := 'O benefício "'+FieldByName('Nome').AsString+'" requerido em '+
                           FieldByName('DataRequerimento').AsString+' está em aberto. '+#13+
                           'Verifique o Processo Nº '+FieldByName('NumeroProcesso').AsString+'.';
               Close;
               Free;
               Exit;
            end;

            Next;
         end;
      end;
   end;//with

   // **************************************************************************
   // VERIFICAR SE PARTICIPANTE, TAMBÉM É BENEFICIÁRIO DE OUTRO PARTICIPANTE
   // **************************************************************************
   
   // Só se for falecimento deve encerrar os beneficios do participante
   // como beneficiario de outro participante
   if sFlgInterno = 'FL'
   then begin
      bAchouBeneficio := True;
      while bAchouBeneficio do
      begin
         with qryBeneficioAnt do
         begin
            Close;
            SQL.Clear;
            SQL.Add(' SELECT DISTINCT B.NOME,         BF.IDBENEFICIO, BF.IDTITULAR,     '+
                    '                 BF.IDPLANOPREV, BF.IDPESSJUR,   BF.IDSITBENEFICIO,'+
                    '                 BF.NUMEROPROCESSO, BF.DATAREQUERIMENTO,           '+
                    '                 BF.FLGPROVISORIO                                  '+
                    ' FROM   BENEFICIO B, BENEFBFCIARIO BF '+
                    ' WHERE  (BF.IDTITULAR      <> '+IntToStr(piIdTitular)  +')  '+
                    ' AND    (BF.IDPESSOA       =  '+IntToStr(piIdTitular)  +')  '+
                    ' AND    (BF.IDBENEFICIO    =  B.IDBENEFICIO             )  '+
                    ' AND    (BF.SEQPROPOSTA    = '+IntToStr(piSeqProposta)+')  '+
                    ' AND    ( (BF.IDSITBENEFICIO IN (1,2,4) ) OR                    '+ 
                    '          ( (BF.IDSITBENEFICIO = 2) AND (BF.DATAFINALPREVISTA >= TO_DATE('''+sDataEvento+''',''DD/MM/YYYY'') ) ) OR '+
                    '          ( (BF.IDSITBENEFICIO = 3) AND (BF.DATAFINAL         >= TO_DATE('''+sDataEvento+''',''DD/MM/YYYY'') ) )    '+
                    '         ) ');

            Open;
            // Se nao estiver vazia, entao o participante possui algum beneficio
            //    em aberto (normal ou nao concedido(pendente)
            if IsEmpty
            then begin
               bAchouBeneficio := False;
               Result := True;
               Close;
               Free;
               Exit;
            end;

            // Se o beneficiario estiver concedido e for provisorio,
            // entao nao pode requerer outro beneficio
            if (FieldByName('IdSitBeneficio').AsInteger = 1) and (FieldByName('FlgProvisorio').AsInteger = 1)
            then begin
               sMsgErro := 'O benefício "'+FieldByName('Nome').AsString+'" requerido em '+
                           FieldByName('DataRequerimento').AsString+' é um "Benefício Provisório" '+#13+
                           'e deverá ser encerrado para haver um novo requerimento.'+#13+
                           'Verifique o Processo Nº '+FieldByName('NumeroProcesso').AsString+'.';
               Close;
               Free;
               Exit;
            end;

            if not bEncerra
            then begin
               Result := True;
               Close;
               Free;
               Exit;
            end;

            if (FieldByName('IdSitBeneficio').AsInteger = 1) or
               (FieldByName('IdSitBeneficio').AsInteger = 2) or
               (FieldByName('IdSitBeneficio').AsInteger = 3) or
               (FieldByName('IdSitBeneficio').AsInteger = 4)
            then begin
               frmRetemEncerraNOVO := TfrmRetemEncerraNOVO.Create(Application);
               with frmRetemEncerraNOVO do
               begin
                  bOutroEvTmp := ((piIdEvento = 351) or (piIdEvento = 383));// Darivaldo Alencar SIG70882

                  iNumeroProcesso := FieldByName('NumeroProcesso').AsInteger;
                  iIdTitular      := FieldByName('IdTitular').AsInteger;
                  iSeqProposta    := piSeqProposta;
                  iIdPessJur      := FieldByName('IdPessJur').AsInteger;
                  iIdPlanoPrev    := FieldByName('IdPlanoPrev').AsInteger;

                  qry.Close;
                  qry.ParamByName('IDPESSOA').AsInteger       := iIdTitular;
                  qry.ParamByName('NUMEROPROCESSO').AsInteger := iNumeroProcesso;
                  //BRUNO AZEVEDO SOL 167416 KINTANA 1468721
                  qry.ParamByName('IDPLANOPREV').AsInteger    := iIdPlanoPrev;
                  qry.Open;

                  qryTitular.Close;
                  qryTitular.ParamByName('IdPessoa').Value    := iIdTitular;
                  qryTitular.ParamByName('IdPessJur').Value   := iIdPessJur;
                  qryTitular.ParamByName('IdPlanoPrev').Value := iIdPlanoPrev;
                  qryTitular.ParamByName('SeqProposta').Value := iSeqProposta;
                  qryTitular.Open;

                  if qry.FieldByName('IDPESSOA').AsInteger = qry.FieldByName('IDTITULAR').AsInteger
                  then lblTitulo.Caption := 'Benefícios do Participante '
                  else lblTitulo.Caption := 'Benefícios do Beneficiário ';

                  lblBeneficiario.Caption := qry.FieldByName('NOME').AsString+' (Matricula : '+qry.FieldByName('MATRICULADEP').AsString+')';

                  sbtnRetencao.Visible        := False;
                  bbtnProcurar.Visible        := False;
                  bbtnConfirmar.Enabled       := False;
                  bbtnCancelar.Enabled        := False;
                  bOperacaoEmAberto           := False;
                  bVeioDoMenu                 := False;
                  bObrigaDataEncerra          := True;
                  sFlgEvento                  := sFlgInterno;

                  //BRUNO AZEVEDO SOL 144003 KINTANA 952202
                  sDataFinalPrevista          := FormatDateTime('dd/mm/yyyy', StrToDate(sDataEvento));

                  //Renato Visoni SOL 148654 Kintana 1048386
                  if not qry.isEmpty then begin
                    ShowModal;
                  end else begin
                    frmRetemEncerraNOVO.Free;
                    Break;
                  end;

                  //Renato Visoni SOL 148654 Kintana 1048386

                  bEncerrouBenefAnt           := bEncerrou;
               end;
               frmRetemEncerraNOVO.Free;

{              // SOL 102758 - KTN - 534.895 Daniel Begnami

               if not bEncerrouBenefAnt
               then begin
                  sMsgErro := 'O benefício "'+FieldByName('Nome').AsString+'" requerido em '+
                               FieldByName('DataRequerimento').AsString+' deve ser encerrado. '+#13+
                              'Verifique o Processo Nº '+FieldByName('NumeroProcesso').AsString+'.';
                  Free;
                  Exit;
               end;
}              // FIM

               bEncerrou       := True;
            end
            else begin // beneficio pendente de concessao (obrigar concessao ou nao concessao)
               sMsgErro := 'O benefício "'+FieldByName('Nome').AsString+'" requerido em '+
                           FieldByName('DataRequerimento').AsString+' está em aberto. '+#13+
                           'Verifique o Processo Nº '+FieldByName('NumeroProcesso').AsString+'.';
               Close;
               Free;
               Exit;
            end;
         end;//with
      end;
   end;

   Result := True;
end;//ValidaBeneficioAnterior


function PegaValorIntegral( qryAux              : TwwQuery;
                            piNumeroProcesso,
                            piIdBeneficio,
                            piIdBeneficiario    : longint;
                            psDataInicio        : string;
                            piIdMotivo          : longint = -1;
                            piIdLote : Integer = -1 ) : double ;
var sAnoMes : string;
begin
   if Trim(psDataInicio) = '' then psDataInicio := FormatDateTime('dd/mm/yyyy', date);

   sAnoMes := Copy(psDataInicio,7,4) + '/' + Copy(psDataInicio,4,2);
   Result  := 0;

   // Se o idbeneficio = -1, entao pegar de todos os beneficios do processo
   with qryAux do
   begin
      Close;
      SQL.Clear;
      {Buscar o ultimo registro inserido }
      SQL.Add(' SELECT DISTINCT H.IDBENEFICIO, H.MES, H.VALORINTEGRAL '+
              ' FROM   HSTBENEFBFCIARIO H, BENEFPLANPREV BP '+
              ' WHERE  H.IDPESSOA       = '+IntToStr(piIdBeneficiario)+
              ' AND    H.MESREFERENCIA = '''+sAnoMes+'''');

      if piIdBeneficio > 0
      then SQL.Add(' AND    H.IDBENEFICIO    = '+IntToStr(piIdBeneficio) )
      else SQL.Add(' AND    BP.FLGREFERENCIA = 0                         ');

      //BRUNO AZEVEDO SOL 155437 KINTANA 1209988
      //  if piIdMotivo > 0
      //  then SQL.Add(' AND    H.IDMOTIVO = '+IntToStr(piIdMotivo) );

      //if piIdLote > 0 then qryAux.SQL.Add(' AND H.IDLOTE = '''+IntToStr(piIdLote)+''' ');

      SQL.Add(' AND    H.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso) +
              ' AND    BP.IDPLANOPREV   = H.IDPLANOPREV '+
              ' AND    BP.IDBENEFICIO   = H.IDBENEFICIO '+
              ' ORDER BY H.MES DESC  ');
      Open;

      if (not IsEmpty) and (FieldByName('VALORINTEGRAL').AsFloat > 0)
      then begin

            Result := Result + FieldByName('VALORINTEGRAL').AsFloat;
         Close;
         Exit;
      end
   end;

   //BRUNO AZEVEDO SOL 155437 KINTANA 1209988
   with qryAux do
   begin
      Close;
      SQL.Clear;
      {Buscar o ultimo registro inserido }
      SQL.Add(' SELECT DISTINCT H.IDBENEFICIO, H.MES, H.VALORINTEGRAL '+
              ' FROM   HSTBENEFBFCIARIO H, BENEFPLANPREV BP '+
              ' WHERE  H.IDPESSOA       = '+IntToStr(piIdBeneficiario)+
              ' AND    H.MESREFERENCIA = '''+sAnoMes+'''');

      if piIdBeneficio > 0
      then SQL.Add(' AND    H.IDBENEFICIO    = '+IntToStr(piIdBeneficio) )
      else SQL.Add(' AND    BP.FLGREFERENCIA = 0                         ');
      SQL.Add(' AND    H.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso) +
              ' AND    BP.IDPLANOPREV   = H.IDPLANOPREV '+
              ' AND    BP.IDBENEFICIO   = H.IDBENEFICIO '+
              ' ORDER BY H.MES DESC  ');
      Open;

      if (not IsEmpty) and (FieldByName('VALORINTEGRAL').AsFloat > 0)
      then begin

            Result := Result + FieldByName('VALORINTEGRAL').AsFloat;
         Close;
         Exit;
      end
   end;
   //BRUNO AZEVEDO SOL 155437 KINTANA 1209988



   with qryAux do
   begin
      Close;
      SQL.Clear;

      { Acerto na pesquisa da BENEFBFCIARIO para }
      { igualar a lógica da pesquisa no historico.                           }
      SQL.Add(' SELECT B.VALORATUAL '+
              ' FROM   BENEFBFCIARIO B, BENEFPLANPREV BP  '+
              ' WHERE  B.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
              ' AND    B.IDPESSOA       = '+IntToStr(piIdBeneficiario));

      if piIdBeneficio > 0
      then SQL.Add(' AND    B.IDBENEFICIO    = '+IntToStr(piIdBeneficio) )
