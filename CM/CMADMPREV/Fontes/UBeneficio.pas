  sIdSitFunc,            sIdSitPartAntes,      sIdSitPlanAntes,     sIdSitFuncAntes,
  sIdSitPartAtual,       sIdSitPlanAtual,      sIdSitFuncAtual,     sVlrInfInss,
  sVlrInfINSSDIB,        sVlrCalcINSSDIB,      sDIBSupl,            sDataInicioAntINSS,
  sValorAntINSS,         sNomeBenefAntINSS,    sIdTpPagtoAntINSS,   sUltMesReajAntINSS,
  sFlgBenefMinAntINSS,   sTPMODALIDADE,        sDataEventoAntINSS,  sCodBeneficioAntINSS,
  sValorBase1AntINSS,    sDataRefSRB,          sValorBase2AntINSS,  sValorBase3AntINSS,
  sSQLBenefAssoc,        sDataInicioFund,      sDataInicioFundSRB,  sAnoMesRefAux,
  sDibBenefAnt,          sNumProcAntINSS,      sDataInicioINSS,     sVlrCalcInss,
  sFlgBenefMinimo,       sValorBase1Inss,      sValorBase2Inss,     sValorBase3Inss,

  sVlrBSAtual,           sVlrBSTotal,          sVlrFABAtual,        sVlrFABTotal,                 // edilaine - SOL 253577-17464 / PPM 955703
  sVlrBaseDeficit,       sSaldoFAB,            sBenefSaldado,                                     // edilaine - SOL 253577-17464 / PPM 955703

  sDataRef,              sDataInicioFundConst, sDataInicioFundAux,  sUltValorReajuste   : String;

  rValorAtual,   //edilaine SIG134721
  dPercProvisorio, dValorTotalReajustado, dValorRateadoReajustado, dValorAux : Double;

  bPossuiReajusteINSS, bReajustaSRB, bReajustaSuplementacao, bReajustaInssNConcedido : Boolean;

  iIdCalculo, iNumeroProcessoINSS : LongInt;

  iFlgProvisorio, iFlgResgate, iPrazoProvisorio : Integer;

  iIdTpPagtoBenefic : Integer;  // Andre Imakawa - SIG 44344

  iPercFamiliar : Double;           // SIG 132162 Ferrari


  bProcReajuste : boolean;  //WO32055 Leandro

begin

  sIdRegraReajuste         :='';
  sValorBeneficio          :='';
  sUltMesReajuste          :='';
  sDataInicioAntLocal      :='';
  sValorAnt                :='';
  sNomeBenefAnt            :='';
  sIdTpPagtoAnt            :='';
  sUltMesReajAnt           :='';
  sFlgBenefMinAnt          :='';
  sDataEventoAnt           :='';
  sCodBeneficioAnt         :='';
  sValorBase1Ant           :='';
  sValorBase2Ant           :='';
  sValorBase3Ant           :='';
  sValorBase1              :='';
  sValorBase2              :='';
  sValorBase3              :='';
  sNumProcINSS             :='';
  sUltMesReajusteINSS      :='';
  sDataEvento              :='';
  sValorTotal              :='';
  sValorSRB                :='';
  sIdSitPart               :='';
  sIdSitPlan               :='';
  sIdSitFunc               :='';
  sIdSitPartAntes          :='';
  sIdSitPlanAntes          :='';
  sIdSitFuncAntes          :='';
  sIdSitPartAtual          :='';
  sIdSitPlanAtual          :='';
  sIdSitFuncAtual          :='';
  sVlrInfInss              :='';
  sVlrInfINSSDIB           :='';
  sVlrCalcINSSDIB          :='';
  sDIBSupl                 :='';
  sDataInicioAntINSS       :='';
  sValorAntINSS            :='';
  sNomeBenefAntINSS        :='';
  sIdTpPagtoAntINSS        :='';
  sUltMesReajAntINSS       :='';
  sFlgBenefMinAntINSS      :='';
  sTPMODALIDADE            :='';
  sDataEventoAntINSS       :='';
  sCodBeneficioAntINSS     :='';
  sValorBase1AntINSS       :='';
  sDataRefSRB              :='';
  sValorBase2AntINSS       :='';
  sValorBase3AntINSS       :='';
  sSQLBenefAssoc           :='';
  sDataInicioFund          :='';
  sDataInicioFundSRB       :='';
  sAnoMesRefAux            :='';
  sDibBenefAnt             :='';
  sNumProcAntINSS          :='';
  sDataInicioINSS          :='';
  sVlrCalcInss             :='';
  sFlgBenefMinimo          :='';
  sValorBase1Inss          :='';
  sValorBase2Inss          :='';
  sValorBase3Inss          :='';
  sVlrBSAtual              :='';
  sVlrBSTotal              :='';
  sVlrFABAtual             :='';
  sVlrFABTotal             :='';
  sVlrBaseDeficit          :='';
  sSaldoFAB                :='';
  sBenefSaldado            :='';
  sDataRef                 :='';
  sDataInicioFundConst     :='';
  sDataInicioFundAux       :='';
  sUltValorReajuste        :='';
  dPercProvisorio          :=0;
  dValorTotalReajustado    :=0;
  dValorRateadoReajustado  :=0;
  dValorAux                :=0;
  iIdCalculo               :=0;
  iNumeroProcessoINSS      :=0;
  iIdTpPagtoBenefic        :=0;  // Andre Imakawa - SIG 44344

  bProcReajuste            := True;  //WO32055 Leandro

  Result := ClienteNumero( FloatToStr( pdValorEmReal ) );

  bErro      := False;
  sMsgErro   := ' ';
  bReajustou := False;

  sDibBenefAnt := '';

  bReajustaInssNConcedido := False;

  sValorBase1 := OraNumero(FloatToStr(pdValorBase1));
  sValorBase2 := OraNumero(FloatToStr(pdValorBase2));
  sValorBase3 := OraNumero(FloatToStr(pdValorBase3));

  sDataInicioAntLocal := sDataInicioAnt;

  BuscaDadosBeneficioAnterior( QryAux,
                               piIdPessJur, piIdPlanoPrev,
                               piIdTitular, piIdBeneficio,
                               0,
                               psDataInicio, sDataInicioAnt,
                               sValorAnt,
                               sNomeBenefAnt,  sIdTpPagtoAnt,
                               sUltMesReajAnt, sFlgBenefMinAnt,
                               sDataEventoAnt, sCodBeneficioAnt,
                               sValorBase1Ant, sValorBase2Ant, sValorBase3Ant,
                               sNumProcINSS,                                      // SIG97504 Tiago Von
                               True,                                              // SIG97504 Tiago Von
                               -1,                                                // SIG97504 Tiago Von
                               piOrigem );


  If sDataInicioAnt = ''
  Then sDataInicioAnt := sDataInicioAntLocal;

  sSQL := ' SELECT BP.FLGREFERENCIA, B.FLGPECULIO, B.FLGRESGATE   '+
          ' FROM   BENEFPLANPREV BP, BENEFICIO B '+
          ' WHERE  BP.IDPLANOPREV = '+IntToStr( piIdPlanoPrev )+
          ' AND    BP.IDBENEFICIO = '+IntToStr( piIdBeneficio )+
          ' AND    BP.IDBENEFICIO = B.IDBENEFICIO ';

  FazQuery( QryAux, sSQL );

  If ( ( QryAux.IsEmpty) Or (QryAux.FieldByName('FLGPECULIO').AsInteger = 1) )
  Then Exit
  Else If QryAux.FieldByName('FLGREFERENCIA').AsInteger = 1
       Then pbBenefReferencia := True
       Else pbBenefReferencia := False;

  iFlgResgate := qryAux.FieldByName('FLGRESGATE').AsInteger;


  //edilaine SIG132162 : inicio
  If ( piIdTitular <> piIdPessoa ) And ( Not pbMigracaoPlano ) Then
  Begin
    sSQL := ' SELECT BTIT.PERCENTUAL '+
            ' FROM   BENEFPLANPREV BP, DEPENTIT DP, BFCIARIOTITPLAN BTIT, '+
            '        PROCESSOBENEF P,  BENEFBFCIARIO BF    '+
            ' WHERE  BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
            ' AND    BF.IDPESSJUR      = '+IntToStr(piIdPessJur)+
            ' AND    BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
            ' AND    BF.IDTITULAR      = '+IntToStr(piIdTitular)+
            ' AND    BF.SEQPROPOSTA    = 1 ' ;

    { No caso de desdobramento não pode buscar informações do  beneficiario }
    { concedido no banco de dados, pois ele ainda não foi incluido          }
    If piOrigem <> 5 Then { <> de Desdobramento }
    Begin
      sSQL := sSQL + ' AND    BF.IDPESSOA       = '+IntToStr(piIdPessoa);
    End;

    sSQL := sSQL + ' AND    BF.IDBENEFICIO    = '+IntToStr(piIdBeneficio)+
                   ' AND    P.NUMEROPROCESSO  = BF.NUMEROPROCESSO '+
                   ' AND    BP.IDPLANOPREV    = BF.IDPLANOPREV    '+
                   ' AND    BP.IDBENEFICIO    = BF.IDBENEFICIO    '+
                   ' AND    BTIT.IDPESSJUR    = BF.IDPESSJUR      '+
                   ' AND    BTIT.IDPLANOPREV  = BF.IDPLANOPREV    '+
                   ' AND    BTIT.IDTITULAR    = BF.IDTITULAR      '+
                   ' AND    BTIT.IDPESSOA     = BF.IDPESSOA       '+
                   ' AND    BTIT.SEQPROPOSTA  = BF.SEQPROPOSTA    '+
                   ' AND    BTIT.IDBENEFICIO  = BF.IDBENEFICIO    '+
                   ' AND    DP.IDTITULAR      = BTIT.IDTITULAR    '+
                   ' AND    DP.IDPESSOA       = BTIT.IDPESSOA     ';

    FazQuery( QryAux, sSQL );
    If (not QryAux.IsEmpty) then
       iPercFamiliar := QryAux.FieldByName('PERCENTUAL').AsFloat    // SIG 132162 Ferrari
    else
       iPercFamiliar := 100;
  end
  else
    iPercFamiliar := 100;
  //edilaine SIG132162 : fim


  { Caso a DIB seja anterior a DIB, e entre as duas tenha um reajuste, este deve ser  }
  { processado. O loop de PAGAMENTO/REAJUSTE é todo feito em cima da DIP(DATAINICIO), }
  { mas a DIB(DATAINICIOFUND) é que deve ser levada em conta para o reajuste do INSS, }
  { então caso seja reajuste do INSS, a rotina deve buscar se, entre a DIB e a DIP,   }
  { há algum reajuste do inss, e processá-lo.                                         }
  sAnoMesRefAux   := psAnoMesRef;
  sDataInicioFund := psDataInicio;

  sSQL := ' SELECT BF.DATAINICIOFUND, BF.ULTMESREAJUSTE, P.DTEVENTO, BF.DIBBENEFANT, '+
        //'        BF.ULTVALORATUALREAJ '+                           // Andre Imakawa - SIG 44344
          '        BF.ULTVALORATUALREAJ, IDTPPAGTOBENEFIC '+         // Andre Imakawa - SIG 44344
          '        , BF.FONTEPAGADORA  ' +                           //edilaine - SIG89790
          ' FROM   BENEFBFCIARIO BF, PROCESSOBENEF P, BENEFPLANPREV BP '+
          ' WHERE  BF.IDPESSJUR      = '+IntToStr(piIdPessJur)+
          ' AND    BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
          ' AND    BF.IDTITULAR      = '+IntToStr(piIdTitular)+
          ' AND    BF.IDPESSOA       = '+IntToStr(piIdPessoa)+
          ' AND    BF.IDBENEFICIO    = '+IntToStr(piIdBeneficio)+
          ' AND    BF.IDSITBENEFICIO IN (1,2,4,6,7)  '+
          ' AND    BP.IDPLANOPREV    = BF.IDPLANOPREV '+
          ' AND    BP.IDBENEFICIO    = BF.IDBENEFICIO ';

  If (pbBenefReferencia)
  Then sSQL := sSQL + ' AND    BP.FLGREFERENCIA  = 1 ';

  sSQL := sSQL + ' AND    P.NUMEROPROCESSO  = BF.NUMEROPROCESSO';

  FazQuery( QryAux, sSQL );

  If ( Not Qryaux.IsEmpty ) Then
  begin
    sDataInicioFund      := qryaux.fieldbyname('DATAINICIOFUND').AsString;
    sDataInicioFundConst := qryaux.fieldbyname('DATAINICIOFUND').AsString;

    sDibBenefAnt         := qryaux.fieldbyname('DIBBENEFANT').AsString;
    sDataEvento          := qryaux.fieldbyname('DTEVENTO').AsString;
    //sDataInicioFundSRB   := qryaux.fieldbyname('DATAINICIOFUND').AsString; //SOL 253577-18114  PPM 1292515
    sUltValorReajuste    := qryaux.fieldbyname('ULTVALORATUALREAJ').AsString;
    iIdTpPagtoBenefic    := qryaux.fieldbyname('IDTPPAGTOBENEFIC').AsInteger;
  end;
  sDataInicioFundSRB   := sDataInicioFund; //SOL 253577-18114  PPM 1292515
  //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - INÍCIO
  if (trim(sDIBAnt) <> '') then begin
    sDibBenefAnt := sDIBAnt;
  end;
  //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - FIM

  Try

    If ( StrToDate( sDataInicioFund ) <  StrToDate( psDataInicio ) ) Then
    Begin

      { Guardar último mês em que o benefício foi reajustado }
      If (pbRetroativo or pbMigracaoPlano) and (psUltMesReajuste <> '')
      Then sUltMesReajuste :=  psUltMesReajuste
      Else sUltMesReajuste :=  qryaux.fieldbyname('ULTMESREAJUSTE').AsString;

      { Caso o último mês de reajuste seja maior que a dib, então pegar a data }
      { de último reajuste                                                     }
      If (trim(sUltMesReajuste) <> '') and
         (trim(sUltMesReajuste) <> '0000/00') and
         (trim(sDataInicioFund) <> '') then
      begin
        if StrToDate('01/'+ Copy( sUltMesReajuste, 6, 2 )+'/'+Copy( sUltMesReajuste, 1, 4 ) ) >
           StrToDate( sDataInicioFund ) then
           sDataInicioFund :=  '01/'+copy(sUltMesReajuste,6,2)+'/'+copy(sUltMesReajuste,1,4);
      end;

      If ( pbBenefReferencia )
      Then sSQL := ' SELECT MIN(MESREAJ) MESREAJ     '+
                   ' FROM   REAJINSS                 '+
                   ' WHERE MESREAJ <= '''+psAnoMesRef+'''  '+
                   ' AND   MESREAJ >= TO_CHAR(TO_DATE('''+sDataInicioFund+''',''DD/MM/YYYY''),''YYYY/MM'')  '+
                   ' AND IDRGREAJ IS NOT NULL  '

      Else sSQL := ' SELECT MIN(MESREAJ) MESREAJ     '+
                   ' FROM   REAJSALPATRO      '+
                   ' WHERE MESREAJ    <= '''+psAnoMesRef+'''  '+
                   ' AND   MESREAJ    >= TO_CHAR(TO_DATE('''+sDataInicioFund+''',''DD/MM/YYYY''),''YYYY/MM'')  '+
                   ' AND   IDPESSJUR   = '+IntToStr(piIdPessJur)   +
                   ' AND   IDPLANOPREV = '+IntToStr(piIdPlanoPrev);

      FazQuery( QryAux, sSQL );

      if (qryaux.fieldbyname('MESREAJ').AsString = psAnoMesRef) and (piOrigem = 5) then //SOL 253577-18114  PPM 1292515
         exit;


      If ( Not Qryaux.Isempty) And (qryaux.fieldbyname('MESREAJ').AsString <> '') And
         (qryaux.fieldbyname('MESREAJ').AsString > sUltMesReajuste) Then
      Begin

        if (pbBenefReferencia)
        then sAnoMesRefAux :=  qryaux.fieldbyname('MESREAJ').AsString
        else
        begin
           if psAnoMesRef = Copy(psDataInicio,7,4)+'/'+Copy(psDataInicio,4,2)
           then sAnoMesRefAux :=  qryaux.fieldbyname('MESREAJ').AsString;
        end;


        sSQL := ' UPDATE BENEFBFCIARIO BF SET '+
                '   ULTMESREAJUSTE = '''+sAnoMesRefAux+''' '+
                ' WHERE  BF.IDPESSJUR      = '+ IntToStr( piIdPessJur   )   +
                ' AND    BF.IDPLANOPREV    = '+ IntToStr( piIdPlanoPrev )   +
                ' AND    BF.IDTITULAR      = '+ IntToStr( piIdTitular   )   +
                ' AND    BF.IDPESSOA       = '+ IntToStr( piIdPessoa    )   +
                ' AND    BF.IDBENEFICIO    = '+ IntToStr( piIdBeneficio ) ;

        ExecutarQuery( QryAux, sSQL );

      End; { If ( Not Qryaux.Isempty) And (qryaux.fieldbyname('MESREAJ').AsString <> '') And }

    End; { If ( StrToDate( sDataInicioFund ) <  StrToDate( psDataInicio ) ) Then }

  Except

  End;

  { Caso migração muda ORIGEM para 7 }
  If pbMigracaoPlano = True Then piOrigem := 7;

  While ( sAnoMesRefAux <= psAnoMesRef ) Do
  Begin

    bReajustaSRB          := False;
    bPossuiReajusteINSS   := False;
    sIdRegraReajuste      := '';

    bReajustaInssNConcedido := False;
    bReajustaSuplementacao  := False;

    { Verifica se existe reajuste da patrocinadora, existindo recalcula o }
    { enquadramento. FUNCEF                                               }
    sSQL := 'SELECT IDRGREAJ, PERCENTUAL FROM  REAJSALPATRO '+
            ' WHERE  MESREAJ     = '+QuotedStr(sAnoMesRefAux)  +' AND '+
            '        IDPESSJUR   = '+IntToStr(piIdPessJur)     +' AND '+
            '        IDRGREAJ is not null   AND                       '+ //leandro - WO3084 - 21/09/2023
            '        IDPLANOPREV = '+IntToStr(piIdPlanoPrev)   +'     ';

    If (
         ( ( pbBenefReferencia = False ) And FazQuery(QryAux,sSQL) ) Or
         ( pbCalculaTudo = True )
       ) And
       ( Not pbMigracaoPlano )
       {And ( sAnoMesRefAux > sUltMesReajuste ) } // Renato Visoni SOL 134849 Kintana 799is not null 085
       Then
    Begin

      bReajustaSRB := True;
      bPossuiReajusteINSS := True;

      Try

        { Por mais incrivel que pareca; mais uma vez buscar os dados do beneficios }
        frmAguarde.Mostra('Executando reajuste de patrocinadora  ...');

        { No caso de desdobramento os dados do beneficio ainda não estao no Banco }
        { buscar os dados sem incluir o beneficio.                                }
        If prmCalculaSRBNoRetroativo Then
        Begin

          If ( piOrigem = 5 ) Then
          Begin
             sSQL := ' SELECT BP.IDREGRASRB,    '+
                     '        EL.IDSITFUNC,     '+
                     '        PP.IDSITPART, PP.IDSITPLANOPREV, '+
                     '        B.NUMORDEMEVENTO '+
                     ' FROM   ELEGPATRO EL, PARTPREVPLAN PP,    '+
                     '        BENEFPLANPREV BP, BENEFICIO B     '+
                     ' WHERE  EL.IDPESSJUR          = '+IntToStr(piIdPessJur)     +
                     ' AND    EL.IDPESSOA           = '+IntToStr(piIdTitular)     +
                     ' AND    PP.IDPLANOPREV        = '+IntToStr(piIdPlanoPrev)   +
                     ' AND    PP.SEQPROPOSTA        = 1                          '+
                     ' AND    BP.IDBENEFICIO        = '+IntToStr(piIdBeneficio)   +
                     ' AND    EL.IDPESSJUR          = PP.IDPESSJUR               '+
                     ' AND    EL.IDPESSOA           = PP.IDPESSOA                '+
                     ' AND    BP.IDPLANOPREV        = PP.IDPLANOPREV             '+
                     ' AND    BP.IDBENEFICIO        = B.IDBENEFICIO              ';
          End
          //edilaine SIG131098 : inicio
          //else If ( piOrigem = 6 ) Then                               //edilaine SIG131556
          //else If ( piOrigem = 6 ) and (not pbCalculaTudo) and (PIDPLANPREVCONTAB = 2) Then         //edilaine SIG131556   // Ferrari sig 132162  //leandro WO3084
          else If (not pbCalculaTudo) and (PIDPLANPREVCONTAB = 2) Then         //edilaine SIG131556   // Ferrari sig 132162  //leandro WO3084
          Begin
             sSQL := ' SELECT R.IDRGREAJ AS IDREGRASRB,          '+
                     '        EL.IDSITFUNC,                      '+
                     '        PP.IDSITPART, PP.IDSITPLANOPREV,   '+
                     '        B.NUMORDEMEVENTO                   '+
                     ' FROM   ELEGPATRO     EL, PARTPREVPLAN PP, '+
                     '        BENEFPLANPREV BP, BENEFICIO B,     '+
                     '        REAJSALPATRO  R                    '+
                     ' WHERE  EL.IDPESSJUR          = '+IntToStr(piIdPessJur)     +
                     ' AND    EL.IDPESSOA           = '+IntToStr(piIdTitular)     +
                     ' AND    PP.IDPLANOPREV        = '+IntToStr(piIdPlanoPrev)   +
                     ' AND    PP.SEQPROPOSTA        = 1                          '+
                     ' AND    EL.IDPESSJUR          = PP.IDPESSJUR               '+
                     ' AND    EL.IDPESSOA           = PP.IDPESSOA                '+
                     ' AND    R.IDPESSJUR           = PP.IDPESSJUR               '+
                     ' AND    R.IDPLANOPREV         = PP.IDPLANOPREV             '+
                     ' AND    R.MESREAJ             = '+QuotedStr(sAnoMesRefAux)  +
                     ' AND    BP.IDBENEFICIO        = '+IntToStr(piIdBeneficio)   +
                     ' AND    BP.IDPLANOPREV        = PP.IDPLANOPREV             '+
                     ' AND    BP.IDBENEFICIO        = B.IDBENEFICIO              ';

          end
          //edilaine SIG131098 : fim
          Else
          Begin
             sSQL := ' SELECT BF.ULTMESREAJUSTE, BF.VALORSRB, BF.DATAINICIOFUND, '+
                     '        BF.VLRINFINSS,     BF.VLRCALCINSS, BF.VALORNADIB,  '+
                     '        BP.IDREGRASRB,    '+
                     '        EL.IDSITFUNC,  '+
                     '        PP.IDSITPART, PP.IDSITPLANOPREV, '+
                     '        B.NUMORDEMEVENTO '+
                     ' FROM   BENEFBFCIARIO BF, BENEFPLANPREV BP, BENEFICIO B,   '+
                     '        ELEGPATRO EL, PARTPREVPLAN PP '+
                     ' WHERE  BF.IDPESSJUR          = '+IntToStr(piIdPessJur)     +
                     ' AND    BF.IDPLANOPREV        = '+IntToStr(piIdPlanoPrev)   +
                     ' AND    BF.IDTITULAR          = '+IntToStr(piIdTitular)     +
                     ' AND    BF.SEQPROPOSTA        = 1                          '+
                     ' AND    BF.IDPESSOA           = '+IntToStr(piIdPessoa)      +
                     ' AND    BF.IDBENEFICIO        = '+IntToStr(piIdBeneficio)   +
                     ' AND    BF.IDSITBENEFICIO IN (1,2,3,4,7)  '+
                     ' AND    BP.IDPLANOPREV        = BF.IDPLANOPREV             '+
                     ' AND    BP.IDBENEFICIO        = BF.IDBENEFICIO             '+

                     ' AND    BF.IDTITULAR          = EL.IDPESSOA                '+
                     ' AND    BF.IDPESSJUR          = EL.IDPESSJUR               '+

                     ' AND    BF.IDTITULAR          = PP.IDPESSOA                '+
                     ' AND    BF.IDPESSJUR          = PP.IDPESSJUR               '+
                     ' AND    BF.IDPLANOPREV        = PP.IDPLANOPREV             '+
                     ' AND    BF.IDBENEFICIO        = B.IDBENEFICIO              ';
          End;

          FazQuery( QryAux, sSQL );

          If ( QryAux.FieldByName('IDREGRASRB').AsInteger > 0 ) Then
          Begin

            bReajustaSuplementacao := True;

            sSQLBenefAssoc := MontaSQLBenefAssoc(qryAux, QryAux.FieldByName('NUMORDEMEVENTO').AsInteger);

            sDataRefSRB := '01/'+Copy(sAnoMesRefAux,6,2)+'/'+Copy(sAnoMesRefAux,1,4);

            dValorSRB := 0;
            dValorSRB := ExecutaRegraCalculoSRB(QryAux,
                                                QryAux.FieldByName('IDREGRASRB').AsInteger,
                                                piIdPessJur,
                                                piIdPlanoPrev,
                                                piIdTitular,
                                                1,
                                                piIdBeneficio,
                                                piNumeroProcesso,
                                                QryAux.FieldByName('IDSITFUNC').AsInteger,
                                                QryAux.FieldByName('IDSITPART').AsInteger,
                                                QryAux.FieldByName('IDSITPLANOPREV').AsInteger,

                                                pdValorBase1, pdValorBase2, pdValorBase3,

                                                sSQLBenefAssoc,
                                                sDataRefSRB,  sDataInicioFundSRB, sDataInicioFund,
                                                psDataInicio, sDataInicioFund,
                                                '', '', '0',
                                                False,
                                                0,
                                                sDataInicioAnt,
                                                sValorAnt,
                                                sValorBase1Ant, sValorBase2Ant, sValorBase3Ant,
                                                bErro,
                                                sMsgErro,
                                                piIdCalculo, 0, piTipoMov,
                                                piIdPessoa,
                                                //(piOrigem = 5) //SOL 253577-18114  PPM 1292515
                                                (piOrigem = 6) //Darivaldo Alencar SOL 269873  PPM 1321142
                                                );


          End Else Begin

            bReajustaSRB        := False;
            bPossuiReajusteINSS := False;

          End;

        End Else Begin

           bReajustaSRB := False;
           DVALORSRB    := DVALORSRB;

        End;

      Except

        FrmAguarde.Apaga;

      End;

      FrmAguarde.Apaga;

    End; { If ( }

    { Alterado para casos de resjuste de suplementação em existir INSS. Lembrar }
    { que para reajustar a Suplementação não precisa recalcular o valor, basta  }
    { utilizar o valor passado pelo parametro pdValorEmReal                     }
    If ( pbBenefReferencia ) Then
    begin
      // Edilaine - SIG 21663 - inicio
      if piOrigem = 12 then
         sSQL := 'SELECT IDRGREAJ, MESREAJ FROM REAJINSS WHERE MESREAJ = '''+psAnoMesRef+''''             //WO32055 Leandro
      else
         sSQL := 'SELECT IDRGREAJ, MESREAJ  FROM REAJINSS WHERE MESREAJ = '''+sAnoMesRefAux+'''';         //WO32055 Leandro
    end  // Edilaine - SIG 21663 - fim
    Else Begin
      sSQL := 'SELECT IDRGREAJ, FLGREAJSRB, MESREAJ FROM REAJBENEFICIO '+          //WO32055 Leandro
              'WHERE  MESREAJ     = '''+sAnoMesRefAux+''''+
              ' AND    IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+
              ' AND    IDBENEFICIO = '+IntToSTr(piIdBeneficio)+
              //BRUNO AZEVEDO SOL 131910 KINTANA 754725
              ' AND ( SELECT COUNT(*) FROM BENEFBFCIARIO BF '+
              ' WHERE BF.NUMEROPROCESSO = ' + IntToStr(piNumeroProcesso) +
              '   AND BF.IDPESSJUR      = ' + IntToStr(piIdPessJur) +
              '   AND BF.IDTITULAR      = ' + IntToStr(piIdTitular) +
              '   AND BF.IDPLANOPREV    = REAJBENEFICIO.IDPLANOPREV '+
              '   AND BF.IDBENEFICIO    = REAJBENEFICIO.IDBENEFICIO '+
              '   AND TO_CHAR(BF.DATAINICIOFUND,''YYYY/MM'') = REAJBENEFICIO.MESREAJ) = 0';
              //BRUNO AZEVEDO SOL 131910 KINTANA 754725
    End;

    FazQuery( QryAux, sSQL );

    If ( Not pbBenefReferencia ) And ( Not Qryaux.IsEmpty )
    Then bReajustaSuplementacao := True;

    if (qryaux.fieldbyname('MESREAJ').AsString = psUltMesReajuste) and   //WO32055 Leandro
       (piOrigem = 12)                                             Then  //WO32055 Leandro
    begin
       bReajustaSuplementacao := False;
       //ProcReajuste := false;                                          //WO35613 Leandro - //WO32055 Leandro
    end;
    
    bPossuiReajusteINSS := False;
    sDIBSupl := psDataInicio;

    { Se nao encontrar é porque nao houve reajuste no mes em questao }
    If ( QryAux.IsEmpty )
    Then Begin

      If ( pbBenefReferencia ) Then
      Begin

        If ( bReajustou ) Then
        Begin

          bReajustou := True;
          bErro      := False;
          sMsgErro   := ' ';
          Result     := OraNumero(FloatToStr(dValorTotalReajustado));

          sAnoMesRefAux := ProximoAnoMes(strtoint(copy(sAnoMesRefAux,6,2)), strtoint(copy(sAnoMesRefAux,1,4)));
          sDataInicioAnt := sDataInicioFund;

          Continue;

        End;

        Exit;

      End; { If ( pbBenefReferencia ) Then }

      { Sair somente se não estiver mais no  intervalo entre a DIB e a DIP }
      If ( bReajustou And bReajustaSRB ) And (sAnoMesRefAux >= psAnoMesRef)
      Then Begin

         bReajustou := True;
         bErro      := False;
         sMsgErro   := ' ';
         Result     := OraNumero(FloatToStr(dValorTotalReajustado));

         Exit;

      End;

      { Sendo beneficio de resgate, sair e não reajustar }
      If ( iFlgResgate = 1 ) Then Exit;

      { Se for um beneficio de suplementacao, verificar se a pessoa tem beneficio do INSS   }
      { Se sim, Entao verificar se o INSS foi reajustado                                    }
      { Se sim, entao o beneficio deve ser recalculado para considerar este novo valor      }

      sSQL := ' SELECT BF.NUMEROPROCESSO, DECODE(BF.VALORBASE1,NULL,BA.VALORBASE1, BF.VALORBASE1) VALORBASE1, '+
              ' DECODE(BF.VALORBASE2,NULL,BA.VALORBASE2, BF.VALORBASE2) VALORBASE2, '+
              ' DECODE(BF.VALORBASE3,NULL,BA.VALORBASE3, BF.VALORBASE3) VALORBASE3 '+
              ' FROM   BENEFBFCIARIO BF, BENEFPLANPREV BP, BENEFPLANOPART BA '+
              ' WHERE  BF.IDPESSJUR      = '+IntToStr(piIdPessJur)+
              ' AND    BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
              ' AND    BF.IDTITULAR      = '+IntToStr(piIdTitular)+
              //BRUNO AZEVEDO SOL 165303 KINTANA
              //' AND    BF.IDPESSOA       = '+IntToStr(piIdPessoa)+
              //BRUNO AZEVEDO SOL 165303 KINTANA
              ' AND    BA.IDPESSJUR(+)      = BF.IDPESSJUR '+
              ' AND    BA.IDPLANOPREV(+)    = BF.IDPLANOPREV '+
              ' AND    BA.IDPESSOA(+)       = BF.IDTITULAR '+
              ' AND    BA.IDBENEFICIO(+)    = BF.IDBENEFICIO '+
              ' AND    BA.SEQPROPOSTA(+)    = 1 '+
              ' AND    (                                       '+
              '          ( BF.IDSITBENEFICIO IN (1,2,4,6,7) )  '+
              '          OR                                    '+
              '          ( (BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+') AND (BF.IDSITBENEFICIO = 3) AND (BP.FLGPAGAINSS = 0) ) '+

              '          OR ( (BF.IDSITBENEFICIO = 3) AND TO_CHAR(BF.DATAINICIO,''YYYY/MM'') <= ' + QuotedStr( sAnoMesRefAux )+'  '+
              '               AND ( (TO_CHAR(BF.DATAFINAL,''YYYY/MM'') >= '+ QuotedStr( sAnoMesRefAux ) +') OR '+
              '                     (BF.DATAFINAL IS NULL) ) '+
              '          ) '+
              '        )                                       '+
              ' AND    BP.IDPLANOPREV    = BF.IDPLANOPREV '+
              ' AND    BP.IDBENEFICIO    = BF.IDBENEFICIO '+
              ' AND    BP.FLGREFERENCIA  = 1              ' ;

              //edilaine SIG111471 : inicio
              if (piOrigem = 2) and (piIdTitular <>  piIdPessoa) then
                 sSQL := sSQL  + ' AND    BF.IDPESSOA       = '+IntToStr(piIdPessoa);
              //edilaine SIG111471 : fim

      FazQuery( QryAux, sSQL );

      { Criado parametro para verificar se o inss deve ser reajustado mesmo que     }
      { não exista ainda na tabela benefbfciario, ou seja, não tenha sido requerido }

      If ( QryAux.IsEmpty ) Then
      Begin

        sSQL := 'SELECT FLGREAJINSSNREQ FROM PLANPREV WHERE IDPLANOPREV = '+IntToStr( piIdPlanoPrev );
        FazQuery( QryAux, sSQL );

        If ( QryAux.FieldByName('FLGREAJINSSNREQ').AsInteger = 0 )
        Then Exit;

      End;

      sValorBase1Inss := qryaux.fieldbyname('VALORBASE1').AsString;
      sValorBase2Inss := qryaux.fieldbyname('VALORBASE2').AsString;
      sValorBase3Inss := qryaux.fieldbyname('VALORBASE3').AsString;

      iNumeroProcessoINSS := QryAux.FieldByName('NUMEROPROCESSO').AsInteger;


      sSQL := ' SELECT IDRGREAJ FROM REAJINSS WHERE MESREAJ = '''+sAnoMesRefAux+'''';
      FazQuery( QryAux, sSQL );


      If ( Not qryAux.IsEmpty ) Then
      Begin
        bPossuiReajusteINSS := True;
        sIdRegraReajuste := qryAux.FieldByName('IDRGREAJ').AsString;
      End
      Else
      If ( bReajustaSRB = False ) And ( pbCalculaTudo = False ) Then
      Begin

        { Caso não tenha reajuste mas ainda esteja no intervalo entre  a DIB  }
        { e a DIP, incrementa mês e continua o processo. Caso não esteja mais }
        { no intervalo seta resultado e sai fora.                             }
        If (sAnoMesRefAux < psAnoMesRef) Then Begin
          sAnoMesRefAux := ProximoAnoMes(strtoint(copy(sAnoMesRefAux,6,2)), strtoint(copy(sAnoMesRefAux,1,4)));
          Continue;
        End;

        If bReajustou
        Then Result := OraNumero( FloatToStr( dValorTotalReajustado ) );

        Exit;

      End;

    End
    Else
    Begin

      sDataInicioAnt := sDibBenefAnt;

      If qryAux.FieldByName('IDRGREAJ').AsString = ''  then Exit;

      sIdRegraReajuste := qryAux.FieldByName('IDRGREAJ').AsString;

      If pbBenefReferencia Then
      Begin
        bReajustaSRB := False;
      End
      Else
      If  qryAux.FieldByName('FLGREAJSRB').AsInteger = 1 Then
      Begin
        bReajustaSRB := True
      End
      Else
      Begin
        bReajustaSRB := False;
      End;

      bReajustaSuplementacao := True;

      { Se for beneficio de referencia, buscar DIB da suplementacao para }
      { passar na query da regra                                         }

      If ( pbBenefReferencia ) Then
      Begin

        sSQL := ' SELECT BF.DATAINICIOFUND           '+
                ' FROM   BENEFBFCIARIO BF, BENEFPLANPREV BP, BENEFICIO B '+
                ' WHERE  BF.IDPESSJUR      = '+IntToStr(piIdPessJur)+
                ' AND    BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
                ' AND    BF.IDTITULAR      = '+IntToStr(piIdTitular)+
                ' AND    BF.IDPESSOA       = '+IntToStr(piIdPessoa)+
                ' AND    BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
                ' AND    BP.IDPLANOPREV    = BF.IDPLANOPREV '+
                ' AND    BP.IDBENEFICIO    = BF.IDBENEFICIO '+
                ' AND    BP.FLGREFERENCIA  = 0              '+
                ' AND    B.IDBENEFICIO     = BP.IDBENEFICIO ';

        FazQuery( QryAux, sSQL );

        If ( QryAux.IsEmpty )
        Then sDIBSupl := '          '
        Else sDIBSupl := qryAux.FieldbyName('DATAINICIOFUND').AsString;

      End;

    End;

    { Verificar se o benefício tem no histórico para o MESCALCULO. Se tiver,   }
    { entao o beneficio já foi reajustado. Sair, para nao reajustar novamente. }
    { Se for benefício provisório, é necessário fazer o recálculo              }
    { Só exigir que não tenha linha na HST. se não for um retroativo           }
    { também não pode na migração                                              }

    If ( Not pbRetroativo ) And ( Not pbMigracaoPlano ) Then
    Begin

      sSQL := ' SELECT IDBENEFICIO FROM HSTBENEFBFCIARIO '+
              ' WHERE (IDPESSOA       = '+IntToStr(piIdPessoa)      +' ) '+
              ' AND   (MESREFERENCIA  = '''+sAnoMesRefAux+'''          ) '+
              ' AND   (IDBENEFICIO    = '+IntToStr(piIdBeneficio)+'    ) '+
              ' AND   (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+' ) '+
              ' AND   (FLGDEVOLUCAO   = 0                              ) '+
              ' AND   ((PERCPROVISORIO IS NULL) OR (PERCPROVISORIO = 0)) ' ;
      FazQuery( QryAux, sSQL );

      If ( Not QryAux.IsEmpty ) And ( Not QryAux.FieldByName('IDBENEFICIO').IsNull ) Then Exit;

    End;

    { Buscar valores do SRB E INSS DO HISTORICO para passar para a regra }
    sSQL := ' SELECT BF.ULTMESREAJUSTE, BF.VALORSRB, BF.DATAINICIOFUND,          '+
            '        BF.VLRINFINSS,     BF.VLRCALCINSS, BF.VALORNADIB,           '+
            '        BF.FLGPROVISORIO,  BF.PRAZOPROVISORIO, BF.PERCPROVISORIO,   '+
            '        BP.TPMODALIDADE,   '+
            '        BF.DATAINICIOINSS  '+
            ' FROM   BENEFBFCIARIO BF, BENEFPLANPREV BP                          '+
            ' WHERE  BF.IDPESSJUR          = '+IntToStr(piIdPessJur)              +
            ' AND    BF.IDPLANOPREV        = '+IntToStr(piIdPlanoPrev)            +
            ' AND    BF.IDTITULAR          = '+IntToStr(piIdTitular)              +
            ' AND    BF.SEQPROPOSTA        = 1                                   '+
            ' AND    BF.NUMEROPROCESSO     = '+IntToStr(piNumeroProcesso) ;


    { No Caso de desdobramento não pode buscar informações do  beneficiario }
    { concedido no banco de dados, pois ele ainda não foi incluido.         }
    If piOrigem <> 5 Then { <> de Desdobramento }
      sSQL := sSQL + ' AND    BF.IDPESSOA  = '+IntToStr(piIdPessoa);

    sSQL := sSQL + ' AND    BF.IDBENEFICIO        = '+IntToStr(piIdBeneficio)            +
                   ' AND    BF.IDSITBENEFICIO IN (1,2,3,4,6,7)  '+
                   ' AND    BP.IDPLANOPREV        = BF.IDPLANOPREV                      '+
                   ' AND    BP.IDBENEFICIO        = BF.IDBENEFICIO                      ';

    FazQuery( QryAux, sSQL );

    If QryAux.IsEmpty Then
    Begin
      sValorSRB       := FloatToStr(dValorSRB);
      sUltMesReajuste := '0000/00';
      sVlrInfInss     := '0';
      sVlrCalcInss    := '0';
      sVlrInfINSSDIB  := '0';
      sVlrCalcINSSDIB := '0';

      iFlgProvisorio   := 0;
      iPrazoProvisorio := 0;
      dPercProvisorio  := 0;
      sDataInicioINSS  := '          ';
    End
    Else
    Begin

      sTPMODALIDADE      := QryAux.FieldByName('TPMODALIDADE').AsString;

      if (not pbRetroativo) and (not bReajustaSRB)
      then sValorSRB       := QryAux.FieldByName('VALORSRB').AsString
      else sValorSRB       := FloatToStr(dValorSRB);

      iFlgProvisorio     := QryAux.FieldByName('FLGPROVISORIO').AsInteger;
      iPrazoProvisorio   := QryAux.FieldByName('PRAZOPROVISORIO').AsInteger;
      dPercProvisorio    := QryAux.FieldByName('PERCPROVISORIO').AsFloat;

      sDataInicioINSS    := QryAux.FieldByName('DATAINICIOINSS').AsString;

      if (pbRetroativo or pbMigracaoPlano) and (psUltMesReajuste <> '')
      then sUltMesReajuste :=  psUltMesReajuste
      else sUltMesReajuste := QryAux.FieldByName('ULTMESREAJUSTE').AsString;


      sVlrInfINSSDIB  := QryAux.FieldByName('VLRINFINSS').AsString;


      sVlrCalcINSSDIB := QryAux.FieldByName('VLRCALCINSS').AsString;

      sFlgBenefMinimo := PegaBenefMinimo(qryAux, piIdPessJur, piIdPlanoPrev, piIdTitular,
                                         1, piIdBeneficio);

      sVlrInfINSS := CalcBeneficioINSSAtual( piIdPessJur, piIdPlanoPrev,
                                             piIdTitular, piIdPessoa,
                                             sAnoMesRefAux, sAnoMesRefAux,
                                             sIDTPPAGTOANT,
                                             sFlgBenefMinimo,
                                             qryAux,
                                             iNumeroProcessoINSS,
                                             'I', piOrigem);

      sVlrCalcInss := CalcBeneficioINSSAtual( piIdPessJur, piIdPlanoPrev,
                                              piIdTitular, piIdPessoa,
                                              sAnoMesRefAux, sAnoMesRefAux,
                                              sIDTPPAGTOANT,
                                              sFlgBenefMinimo,
                                              qryAux,
                                              iNumeroProcessoINSS,
                                              'C', piOrigem);
    End;

    dValorSRB := StrToFloat(ClienteNumero(sValorSRB));

    If pbBenefReferencia
    Then BuscaDadosBeneficioAnterior ( qryAux,
                                       piIdPessJur,  piIdPlanoPrev,
                                       piIdTitular,  piIdBeneficio,
                                       1,
                                       psDataInicio, sDataInicioAntINSS,
                                       sValorAntINSS, sNomeBenefAnt,

                                       sIdTpPagtoAntINSS, sUltMesReajAntINSS,
                                       sFlgBenefMinAntINSS, sDataEventoAntINSS,
                                       sCodBeneficioAntINSS,

                                       sValorBase1AntINSS, sValorBase2AntINSS, sValorBase3AntINSS,
                                       sNumProcAntINSS, True,                    // SIG97504 Tiago Von
                                       -1,                                       // SIG97504 Tiago Von
                                       piOrigem);                                // SIG97504 Tiago Von

    if sAnoMesRefAux            = '' then sAnoMesRefAux      := ' ';
    if psDataInicio             = '' then psDataInicio     := ' ';
    if sIdTpPagtoAnt            = '' then sIdTpPagtoAnt    := ' ';
    if sUltMesReajAnt           = '' then sUltMesReajAnt   := '0000/00';
    if sFlgBenefMinAnt          = '' then sFlgBenefMinAnt  := ' ';
    if Trim(sDataEventoAnt)     = '' then sDataEventoAnt   := ' ';
    if Trim(sCodBeneficioAnt)   = '' then sCodBeneficioAnt := ' ';
    if Trim(sDataInicioAnt)     = '' then sDataInicioAnt   := ' ';
    if Trim(sUltMesReajuste)    = '' then sUltMesReajuste := '0000/00';
    if Trim(sDataInicioAntINSS) = '' then sDataInicioAntINSS   := ' ';
    // SOL 99737
    if Trim(sDataInicioINSS) = '' then sDataInicioINSS   := ' ';

    //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - INÍCIO - COLOCAÇÃO DO IF
    if not(bCalculoDeficit) then begin
      { Se o benefício for para beneficiário, passar como VALORATUAL O VALORTOTAL e }
      { depois do reajuste, ratear o valor                                          }
      sSQL := ' SELECT BF.VALORTOTAL , P.DTEVENTO, BF.DIBBENEFANT, '+
              '        BF.DATAINICIOFUND, '+
              '        BF.DATAINICIOINSS, '+
              '        PP.IDSITPLANOPREV, PP.IDSITPART, EL.IDSITFUNC, '+
              '        BF.VALORBENEFANT,  '+
              '        BF.VALORATUAL      '+   //edilaine SIG134721
              ' FROM   PROCESSOBENEF P, BENEFBFCIARIO BF, ELEGPATRO EL, '+
              '        PARTPREVPLAN PP '+
              ' WHERE  BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
              ' AND    BF.IDPESSJUR      = '+IntToStr(piIdPessJur)     +
              ' AND    BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)   +
              ' AND    BF.IDTITULAR      = '+IntToStr(piIdTitular)     +
              ' AND    BF.SEQPROPOSTA    = 1                          '+
              ' AND    BF.IDPESSOA       = '+IntToStr(piIdPessoa)      +
              ' AND    BF.IDBENEFICIO    = '+IntToStr(piIdBeneficio)   +
              ' AND    P.NUMEROPROCESSO  = BF.NUMEROPROCESSO          '+
              ' AND    BF.IDTITULAR      = EL.IDPESSOA  '+
              ' AND    BF.IDPESSJUR      = EL.IDPESSJUR '+
              ' AND    BF.IDTITULAR      = PP.IDPESSOA  '+
              ' AND    BF.IDPESSJUR      = PP.IDPESSJUR '+
              ' AND    BF.IDPLANOPREV    = PP.IDPLANOPREV ';

      FazQuery( QryAux, sSQL );

      If Not QryAux.IsEmpty Then
      Begin
        if piIdTitular <> piIdPessoa then
        begin
          if (sUltMesReajuste < sAnoMesRefAux) and (not ((PIDPLANPREVCONTAB = 2) and (sAnoMesRefAux = '2023/01')))  // Ferrari  SIG132162
          then pdValorEmReal   := qryAux.FieldByName('VALORTOTAL').AsFloat;

          sDataInicioINSS := qryAux.FieldByName('DATAINICIOINSS').AsString;
          if (pbRetroativo = True) and (not ((PIDPLANPREVCONTAB = 2) and (sAnoMesRefAux = '2023/01')))   //edilaine SIG132162
          Then pdValorEmReal := dValorTotal;
        end;

        sDataEvento     := qryAux.FieldByName('DTEVENTO').AsString;
        sDataInicioFund := qryAux.FieldByName('DATAINICIOFUND').AsString;

        rValorAtual     := qryAux.FieldByName('VALORATUAL').AsFloat;  //edilaine SIG134721

        If Trim(sDataInicioAnt) = '' Then
           Begin
                sDataInicioAnt := qryAux.FieldByName('DIBBENEFANT').AsString;

                if Trim(sDataInicioAnt)     = '' then sDataInicioAnt     := ' ';
                if Trim(sDataInicioAntINSS) = '' then sDataInicioAntINSS := sDataInicioAnt;
          End;


        If ( (Trim(sValorAnt) = '') or (Trim(sValorAnt) = '0') ) Then
        Begin
          sValorAnt := qryAux.FieldByName('VALORBENEFANT').AsString;
          if Trim(sValorAnt)  = '' then sValorAnt   := '0';
        End;

        if Trim(sDataEvento) = '' then sDataEvento := psDataInicio;

        sIdSitPart := qryAux.FieldByName('IDSITPART').AsString;
        sIdSitPlan := qryAux.FieldByName('IDSITPLANOPREV').AsString;
        sIdSitFunc := qryAux.FieldByName('IDSITFUNC').AsString;
      End
      Else
      Begin
          if Trim(sDataEvento) = '' then sDataEvento := sDataInicioFund;

          sIdSitPart := ' ';
          sIdSitPlan := ' ';
          sIdSitFunc := ' ';
      End;
    end;
    //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - FIM

    sUltMesReajusteINSS := sUltMesReajuste;

    { Na FUNCEF existe o caso de a suplementação ser concedida antes do INSS.   }

    { Como na Funcef não existe beneficio de referência, pois o INSS é pago     }
    { pela própria, não existe histórico.                                       }

    { O INSS pode ser requerido meses depois, ou até não ser, por isso caso não }
    { ache o valor do INSS para o mês corrente, pegar o valor de concessão e    }
    { atualizar, se for o caso, para passar para a regra de suplementação.      }
    If ( Not pbBenefReferencia)       And
       ( Not bReajustaSuplementacao ) And
       ( Not pbMigracaoPlano ) Then
    Begin
      sSQL := ' SELECT BF.NUMEROPROCESSO, BF.ULTMESREAJUSTE '+
              ' FROM   HSTBENEFBFCIARIO H, BENEFBFCIARIO BF, BENEFPLANPREV BP '+
              ' WHERE  H.IDPESSJUR      = '+IntToStr(piIdPessJur)+
              ' AND    H.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
              ' AND    H.IDTITULAR      = '+IntToStr(piIdTitular)+
              ' AND    H.IDPESSOA       = '+IntToStr(piIdPessoa)+
              ' AND    H.MESREFERENCIA =  '''+sAnoMesRefAux+''' '+
              ' AND    BF.IDPESSJUR      =  H.IDPESSJUR '+
              ' AND    BF.IDPLANOPREV    =  H.IDPLANOPREV '+
              ' AND    BF.IDTITULAR      =  H.IDTITULAR '+
              ' AND    BF.IDPESSOA       =  H.IDPESSOA '+
              ' AND    (                                       '+
              '          ( BF.IDSITBENEFICIO IN (1,2,3,4,6,7) )  '+
              '          OR                                    '+
              '          ( (BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+') AND (BF.IDSITBENEFICIO = 3) AND (BP.FLGPAGAINSS = 0) ) '+
              '        )                                       '+
              ' AND    BP.IDPLANOPREV    = BF.IDPLANOPREV '+
              ' AND    BP.IDBENEFICIO    = BF.IDBENEFICIO '+
              ' AND    BP.FLGREFERENCIA  = 1        ' ;

      FazQuery( QryAux, sSQL );

      If ( QryAux.IsEmpty ) Then
      Begin
        bReajustaInssNConcedido := true;
        pdValorEmReal := strtofloat(clientenumero(sVlrInfINSSDIB));

        If sUltMesReajuste <> '0000/00' Then sUltMesReajusteINSS := '0000/00';

      End;

    End;

    { para casos de migrações de plano, o reajuste deve ser feito em vista da  }
    { NOVA DIB infromada na tela e não pela DIB inserida no benefício          }
    if ((pbMigracaoPlano) and (not pbBenefReferencia))
    then sDataInicioFundAux  := psDataInicio
    else
    begin
     if sDibBenefAnt <> '' then
     sDataInicioFundAux :=  sDibBenefAnt
     else if sDataInicioFundConst <> '' then sDataInicioFundAux := sDataInicioFundConst
     else sDataInicioFundAux := sDataInicioFund ;

    end;


    { Se é suplementacao e não possui reajuste do INSS, rodar reajuste da suplementacao }
    { Senao, rodar regra de CALCULO da suplementacao ( e não de reajuste ).             }
    If pbMigracaoPlano and bPossuiReajusteINSS then
    Begin
      bReajustaSuplementacao := False;
      bReajustaSRB := true;
    End;

    If ( ( bReajustaSRB = False ) Or ( bReajustaSuplementacao = True ) ) And
       ( ( Not bPossuiReajusteINSS ) Or ( bReajustaInssNConcedido ) )
       AND (bProcReajuste)                                                  //WO32055 Leandro
       And (sIdRegraReajuste <> '')
    Then Begin

      // SOL 99737
      if Trim(sDataInicioINSS) = '' then sDataInicioINSS   := ' ';

      // edilaine - SOL 253577-17464 / PPM 955703 - inicio
      {RN025 - Para que o sistema realize o reajuste dos valores referentes ao BS, FAB e Base de Cálculo do Déficit,
               deverão ser passadas na query de entrada da regra de cálculo do reajuste}
      sSQL := ' SELECT BF.VLRBSTOTAL, BF.VLRBSATUAL, BF.VLRFABTOTAL, BF.VLRFABATUAL, BF.VLRBASEDEFICIT '+
              ' FROM   BENEFBFCIARIO BF '+
              ' WHERE  BF.IDBENEFICIO      = '+ IntToStr(piIdBeneficio)    +
              ' AND    BF.IDPESSJUR        = '+ IntToStr(piIdPessJur)      +
              ' AND    BF.IDPLANOPREV      = '+ IntToStr(piIdPlanoPrev)    +
              ' AND    BF.IDTITULAR        = '+ IntToStr(piIdTitular)      +
              ' AND    BF.IDPESSOA         = '+ IntToStr(piIdPessoa)       +
              ' AND    BF.NUMEROPROCESSO   = '+ IntToStr(piNumeroProcesso);

      FazQuery( QryAux, sSQL );
      if not QryAux.isEmpty then
      begin
        sVlrBSAtual     := OraNumero(QryAux.FieldByName('VLRBSATUAL').AsString);
        sVlrBSTotal     := OraNumero(QryAux.FieldByName('VLRBSTOTAL').AsString);
        sVlrFABAtual    := OraNumero(QryAux.FieldByName('VLRFABATUAL').AsString);
        sVlrFABTotal    := OraNumero(QryAux.FieldByName('VLRFABTOTAL').AsString);
        sVlrBaseDeficit := OraNumero(QryAux.FieldByName('VLRBASEDEFICIT').AsString);
      end; // edilaine - SOL 253577/17984 - PPM 1192884 - inicio
      //else
      begin
        sVlrBSAtual     := iff(sVlrBSAtual     = '', 'NULL', sVlrBSAtual);
        sVlrBSTotal     := iff(sVlrBSTotal     = '', 'NULL', sVlrBSTotal);
        sVlrFABAtual    := iff(sVlrFABAtual    = '', 'NULL', sVlrFABAtual);
        sVlrFABTotal    := iff(sVlrFABTotal    = '', 'NULL', sVlrFABTotal);
        sVlrBaseDeficit := iff(sVlrBaseDeficit = '', 'NULL', sVlrBaseDeficit);
      end;  // edilaine - SOL 253577/17984 - PPM 1192884 - fim

      //edilaine - SIG87003 - inicio
      //sSQL := 'SELECT IDTITULAR, IDPESSOA, BENEFSALDADO, SALDOFAB '+
      sSQL := 'SELECT IDTITULAR, IDPESSOA, BENEFSALDADOINSS AS BENEFSALDADO, SALDOFABINSS AS SALDOFAB '+
      //edilaine - SIG87003 - fim
              '  FROM BENEFSALDFAB                                             '+
              ' WHERE IDTITULAR     = '+ IntToStr(piIdTitular) +
              '   AND IDPESSOA      = '+ IntToStr(piIdPessoa)  +
              '   AND MESREFERENCIA = '+ Quotedstr(sUltMesReajuste);   // ??

      FazQuery( QryAux, sSQL );
      if not QryAux.isEmpty then
      begin
        sSaldoFAB     := OraNumero(QryAux.FieldByName('SALDOFAB').AsString);
        sBenefSaldado := OraNumero(QryAux.FieldByName('BENEFSALDADO').AsString);
      end
      else
      begin
        sSaldoFAB     := '0.00';
        sBenefSaldado := '0.00';
      end;
      // edilaine - SOL 253577-17464 / PPM 955703


      If piIdTitular = piIdPessoa Then
      Begin
        sSQL := ' SELECT '+IntToStr(piIdBeneficio)+'     AS IDBENEFICIO,        '+
                           IntToStr(piIdPessJur)  +'     AS IDPESSJUR,          '+
                           IntToStr(piIdPlanoPrev)+'     AS IDPLANOPREV,        '+
                           IntToStr(PIDPLANPREVCONTAB)+' AS IDPLANPREVCONTAB,   '+  // SOL:128981 - Daniel Begnami
                           IntToStr(piIdTitular)  +'     AS IDTITULAR,          '+
                           IntToStr(piIdPessoa)   +'     AS IDPESSOA,           '+
                           IntToStr(piNumeroProcesso)+'  AS NUMEROPROCESSO,     '+
                           IntToStr(piOrigem)     +   '  AS ORIGEM,             '+
                '1                                       AS FLGCONCESSAO,       '+
                '1                                       AS SEQPROPOSTA,        '+
                OraNumero(sValorSRB)              +'     AS VALORSRB,           '+
                ''''+sDIBSupl                     +'''   AS DIBSUPL,            '+
                ''''+sDataInicioAntINSS           +'''   AS DATAINICIOINSSANT,  '+
                ''''+sDataInicioINSS              +'''   AS DATAINICIOINSS,  '+

                ''''+sAnoMesRefAux                +'''   AS MESREAJ,            '+
                ''''+sAnoMesRefAux                +'''   AS MESREFERENCIA,      '+
                OraNumero(IntToStr(iFlgProvisorio))+'    AS FLGPROVISORIO,      '+
                OraNumero(IntToStr(iPrazoProvisorio))+'  AS PRAZOPROVISORIO,    '+
                OraNumero(FloatToStr(dPercProvisorio))+' AS PERCPROVISORIO,     '+
                QuotedStr(sIdSitFunc)      +  ' AS IDSITFUNCATUAL,         '+
                QuotedStr(sIdSitPart)      +  ' AS IDSITPARTATUAL,         '+
                QuotedStr(sIdSitPlan)      +  ' AS IDSITPLANOATUAL ,       '+

                ''''+psDataInicio            +'''     AS DATAINICIO,     '+
                ''''+sDataInicioFundAux      +'''     AS DATAINICIOFUND,   '+

                OraNumero( sUltValorReajuste ) +' AS ULTVALORATUALREAJ, ';

                // edilaine - SOL 253577-18064 / PPM 1240079 - inicio
                if not bCalculaVlrMinimo then
                   sSQL := sSQL + '0 AS FLGBENEFMIN,       '
                else
                   sSQL := sSQL + OraNumero(sFlgBenefMinimo)   +' AS FLGBENEFMIN,       ';

                sSQL := sSQL +   // edilaine - SOL 253577-18064 / PPM 1240079 - fim
                ''''+sIdTpPagtoAnt           +'''     AS IDTPPAGTOANT,   '+
                ''''+sUltMesReajAnt          +'''     AS ULTMESREAJANT,  '+
                ''''+sFlgBenefMinAnt         +'''     AS FLGBENEFMINANT, '+
                '''' +sDataEventoAnt         +'''     AS DATAEVENTOANT,  '+
                '''' +sCodBeneficioAnt       +'''     AS IDBENEFICIOANT, '+
                '''' +sDataInicioAnt         +'''     AS DATAINICIOANT,  '+
                OraNumero(sValorAnt)         +'       AS VLBENEFPGTO,    '+
                OraNumero(sValorAnt)         +'       AS VALORBENEFANT,  ';

                if bReajustaInssNConcedido then
                begin
                   sSQL := sSQL +oranumero(sValorBase1Inss)+' AS VALORBASE1,     '+
                   oranumero(sValorBase2Inss)+' AS VALORBASE2,     '+
                   oranumero(sValorBase3Inss)+' AS VALORBASE3,     ';
                end
                else
                begin
                   sSQL := sSQL +OraNumero(FloatToStr(pdValorBase1))+' AS VALORBASE1,     '+
                   OraNumero(FloatToStr(pdValorBase2))+' AS VALORBASE2,     '+
                   OraNumero(FloatToStr(pdValorBase3))+' AS VALORBASE3,     ';
                end;

                sSQL := sSQL+''''+'01/'+copy(sAnoMesRefAux,6,2)+'/'+copy(sAnoMesRefAux,1,4)+''' AS DATAREF, '+

                OraNumero(FloatToStr(pdValorEmReal))+' AS VALORTOTAL, '+
                OraNumero(FloatToStr(pdValorEmReal))+' AS VALORATUAL, '+

                OraNumero(FloatToStr(rValorAtual))  +' AS VLRATURATEIO, '+        //edilaine SIG134721

                OraNumero(FloatToStr(iPercFamiliar)) + ' AS PERCFAMILIAR, ' +     //edilaine SIG132162    // Ferrari

                // edilaine - SOL 253577-17464 / PPM 955703 - inicio
                sVlrBSAtual     + ' AS VLRBSATUAL,     '+
                sVlrBSTotal     + ' AS VLRBSTOTAL,     '+
                sVlrFABAtual    + ' AS VLRFABATUAL,    '+
                sVlrFABTotal    + ' AS VLRFABTOTAL,    '+
                sVlrBaseDeficit + ' AS VLRBASEDEFICIT, '+
                sSaldoFAB       + ' AS SALDOFAB,       '+
                sBenefSaldado   + ' AS BENEFSALDADO,   '+
                // edilaine - SOL 253577-17464 / PPM 955703 - fim

                ''''+sUltMesReajusteINSS      +''' AS ULTMESREAJUSTE,       '+
                ' EL.VALORBASE1 AS VALORBASE1_ELEG, '+
                ' EL.VALORBASE2 AS VALORBASE2_ELEG, '+
                ' EL.VALORBASE3 AS VALORBASE3_ELEG, '+
                ' EL.VALORBASE4 AS VALORBASE4_ELEG, '+
                ' EL.VALORBASE5 AS VALORBASE5_ELEG, '+
                ' EL.VALORBASE6 AS VALORBASE6_ELEG, '+
                ' EL.IDPESSJUR, EL.IDPESSOA,  EL.MATRICULA,   '+
                ' EL.FLGDIRETOR, '+
                OraNumero(sVlrInfINSSDIB) +' AS VLRINFINSSDIB, '+
                OraNumero(sVlrCalcINSSDIB)+' AS VLRCALCINSSDIB, '+
                OraNumero(sVlrInfInss)         +'       AS VLRINFINSS,    '+
                OraNumero(sVlrCalcInss)        +'       AS VLRCALCINSS    '+
                ' FROM   ELEGPATRO  EL '+
                ' WHERE  EL.IDPESSJUR = '+IntToStr(piIdPessJur)+
                ' AND    EL.IDPESSOA  = '+IntToStr(piIdTitular);
      End
      Else
      Begin
        sSQL := ' SELECT '+IntToStr(piIdBeneficio)+' AS IDBENEFICIO,      '+
                           IntToStr(piIdPessJur)  +'    AS IDPESSJUR,       '+
                           IntToStr(piIdPlanoPrev)+'    AS IDPLANOPREV,     '+
                           IntToStr(PIDPLANPREVCONTAB)+' AS IDPLANPREVCONTAB,   '+  // SOL:129018 - Daniel Begnami
                           IntToStr(piIdTitular)  +'    AS IDTITULAR,       '+
                           IntToStr(piIdPessoa)   +'    AS IDPESSOA,        '+
                           IntToStr(piNumeroProcesso)+' AS NUMEROPROCESSO,  '+
                           IntToStr(piOrigem)     +   ' AS ORIGEM,          '+
                '1 AS FLGCONCESSAO,                                       '+
                '1 AS SEQPROPOSTA,                                        '+
                OraNumero(sValorSRB)         +'   AS VALORSRB,            '+
                ''''+sDIBSupl                +'''     AS DIBSUPL,        '+
                ''''+sDataInicioAntINSS      +'''     AS DATAINICIOINSSANT, '+
                ''''+sDataInicioINSS         +'''   AS DATAINICIOINSS,  '+
                ''''+sAnoMesRefAux           +''' AS MESREAJ,             '+
                ''''+sAnoMesRefAux           +''' AS MESREFERENCIA,       '+
                OraNumero(IntToStr(iFlgProvisorio))+'    AS FLGPROVISORIO,      '+
                OraNumero(IntToStr(iPrazoProvisorio))+'  AS PRAZOPROVISORIO,    '+
                OraNumero(FloatToStr(dPercProvisorio))+' AS PERCPROVISORIO,     '+

                QuotedStr(sIdSitFunc)     +  ' AS IDSITFUNCATUAL,         '+
                QuotedStr(sIdSitPart)     +  ' AS IDSITPARTATUAL,         '+
                QuotedStr(sIdSitPlan)     +  ' AS IDSITPLANOATUAL ,       '+

                ''''+psDataInicio            +'''     AS DATAINICIO,     '+
                ''''+sDataInicioFundAux      +'''     AS DATAINICIOFUND,   '+

                OraNumero( sUltValorReajuste ) +' AS ULTVALORATUALREAJ, ';

                // edilaine - SOL 253577-18064 / PPM 1240079 - inicio
                if not bCalculaVlrMinimo then
                   sSQL := sSQL + '0 AS FLGBENEFMIN,       '
                else
                   sSQL := sSQL + OraNumero(sFlgBenefMinimo)   +' AS FLGBENEFMIN,       ';

                sSQL := sSQL +   // edilaine - SOL 253577-18064 / PPM 1240079 - fim
                ''''+sIdTpPagtoAnt           +''' AS IDTPPAGTOANT,        '+
                ''''+sUltMesReajAnt          +''' AS ULTMESREAJANT,       '+
                ''''+sFlgBenefMinAnt         +''' AS FLGBENEFMINANT,      '+
                '''' +sDataEventoAnt         +''' AS DATAEVENTOANT,       '+
                '''' +sCodBeneficioAnt       +''' AS IDBENEFICIOANT,      '+
                '''' +sDataInicioAnt         +''' AS DATAINICIOANT,       '+
                OraNumero(sValorAnt)         +' AS VLBENEFPGTO,           '+
                OraNumero(sValorAnt)         +' AS VALORBENEFANT,         ';

                if bReajustaInssNConcedido then
                begin
                   sSQL := sSQL +oranumero(sValorBase1Inss)+' AS VALORBASE1,     '+
                   oranumero(sValorBase2Inss)+' AS VALORBASE2,     '+
                   oranumero(sValorBase3Inss)+' AS VALORBASE3,     ';
                end
                else
                begin
                   sSQL := sSQL +OraNumero(FloatToStr(pdValorBase1))+' AS VALORBASE1,     '+
                   OraNumero(FloatToStr(pdValorBase2))+' AS VALORBASE2,     '+
                   OraNumero(FloatToStr(pdValorBase3))+' AS VALORBASE3,     ';
                end;

                sSQL := sSQL +''''+'01/'+copy(sAnoMesRefAux,6,2)+'/'+copy(sAnoMesRefAux,1,4)+''' AS DATAREF, '+
                ''''+sUltMesReajusteINSS      +''' AS ULTMESREAJUSTE,       '+

                OraNumero(FloatToStr(pdValorEmReal))+' AS VALORTOTAL,     '+
                OraNumero(FloatToStr(pdValorEmReal))+' AS VALORATUAL,     '+

                OraNumero(FloatToStr(rValorAtual))  +' AS VLRATURATEIO, '+        //edilaine SIG134721
                
                OraNumero(FloatToStr(iPercFamiliar)) + ' AS PERCFAMILIAR, ' +     //edilaine SIG132162    // Ferrari

                // edilaine - SOL 253577-17464 / PPM 955703 - inicio
                sVlrBSAtual     + ' AS VLRBSATUAL,     '+
                sVlrBSTotal     + ' AS VLRBSTOTAL,     '+
                sVlrFABAtual    + ' AS VLRFABATUAL,    '+
                sVlrFABTotal    + ' AS VLRFABTOTAL,    '+
                sVlrBaseDeficit + ' AS VLRBASEDEFICIT, '+
                sSaldoFAB       + ' AS SALDOFAB,       '+
                sBenefSaldado   + ' AS BENEFSALDADO,   '+
                // edilaine - SOL 253577-17464 / PPM 955703 - fim

                OraNumero(sVlrInfINSSDIB)+' AS VLRINFINSSDIB, '+
                OraNumero(sVlrCalcINSSDIB)+' AS VLRCALCINSSDIB, '+
                ' DP.VALORBASE1 AS VALORBASE1_ELEG,                       '+
                ' DP.VALORBASE2 AS VALORBASE2_ELEG,                       '+
                ' DP.VALORBASE3 AS VALORBASE3_ELEG,                       '+
                ' DP.DATACADASTRO,                                        '+
                ' EL.FLGDIRETOR, '+
                ' EL.IDPESSJUR, EL.IDPESSOA, PF.DATAMORTE, EL.MATRICULA   '+
                ' FROM   PESSOAFISICA PF, ELEGPATRO  EL, DEPENTIT DP      '+
                ' WHERE  EL.IDPESSJUR = '+IntToStr(piIdPessJur)            +
                ' AND    EL.IDPESSOA  = '+IntToStr(piIdTitular)            +
                ' AND    DP.IDTITULAR = EL.IDPESSOA                       '+
                ' AND    DP.IDPESSOA  = '+IntToStr(piIdPessoa)             +
                ' AND    PF.IDPESSOA  = EL.IDPESSOA                       ';
      End;

      With dtmAPrev Do
      Begin

        regraAPrev.RuleName := sIdRegraReajuste;

        qryRegra.Close;
        qryRegra.SQL.Clear;
        qryRegra.SQl.Add(sSQL);
        qryRegra.Open;

        regraAPrev.QueryIn   := dtmAPrev.qryRegra;
        regraAPrev.IdCalculo := piIdCalculo;

        If (Sistema.NomeUsuario = 'AUGUSTO.CM') or (Sistema.NomeUsuario = 'NEIL') Then Begin
          //Henrique Massão
           //regraAPrev.QueryIn.SQL.SaveToFile('C:\TEMP\REGRA-'+regraAPrev.RuleName+'.TXT');
           regraAPrev.QueryIn.SQL.SaveToFile(Sistema.RetornaCaminhoArquivos(Sistema.IdEmpresa) + '\TEMP\REGRA-'+regraAPrev.RuleName+'.TXT');

          regraAPrev.FlgReloadRule := True;
        End;

        regraAPrev.Execute;

        If regraAPrev.Error Then
        Begin
          bErro := True;
          sMsgErro := ' Ocorreu um erro na Regra de Reajuste do Benefício (nº '+sIdRegraReajuste+') ';

          Exit;
        End;

        If UPPERCASE(RegraAPrev.Result) = 'FALSE' Then Exit;

        Try
           pdValorEmReal := StrToFloat(ClienteNumero(RegraAPrev.Result))
        Except
           MsgDlg('O valor retornado pela regra Nº '+sIdRegraReajuste+' não é um valor válido. Verifique. '+
                  '[VALOR = '+RegraAPrev.Result+']','Erro',mtError,[mbOk, mbHelp],0);
           bErro := True;
        End;

        bReajustou := true;

      End; { with dtmAPREV }

      If (bReajustou = True) And (bReajustaInssNConcedido = True) Then
      Begin

       sSQL := 'UPDATE BENEFBFCIARIO SET VLRINFINSS = '+OraNumero(dtmAPrev.regraAPrev.Result)+' '+
               ' WHERE  IDPESSJUR          = '+IntToStr(piIdPessJur)              +
               ' AND    IDPLANOPREV        = '+IntToStr(piIdPlanoPrev)            +
               ' AND    IDTITULAR          = '+IntToStr(piIdTitular)              +
               ' AND    SEQPROPOSTA        = 1                                   '+
               ' AND    IDPESSOA           = '+IntToStr(piIdPessoa)               +
               ' AND    IDBENEFICIO        = '+IntToStr(piIdBeneficio)            +
               ' AND    NUMEROPROCESSO     = '+IntToStr(piNumeroProcesso)         +
               ' AND    IDSITBENEFICIO IN (1,2,3,4,7)  ';

       ExecutarQuery( QryAux, sSQL )

      End;

    End; { if not bPossuiReajusteINSS }

    { Se o reajuste for em cima do SRB, entao o resultado da regra retornou o SRB   }
    { reajustado. Agora, o sistema tem que executar a regra de calculo do beneficio }
    { com este SRB reajustado                                                       }

    If (bReajustaSRB or bPossuiReajusteINSS) and (not pbMigracaoPlano) Then
    Begin

      if bReajustaSRB then
      begin
         if (prmCalculaSRBNoRetroativo = True) Or
            (bReajustaSRB = True) { Caso tenha reajuste  do SRB (BRTPREV), usar para a regra }
                                  { de cálculo do beneficio o novo SRB.                      }
         then sValorSRB       := OraNumero(dtmAPrev.regraAPrev.Result)
         else SVALORSRB       := ORANUMERO(FLOATTOSTR(DVALORSRB));

      end
      else
      begin
         sValorBeneficio := OraNumero(dtmAPrev.regraAPrev.Result);
         if  bReajustaInssNConcedido then   sVlrInfINSS := sValorBeneficio;
      end;

      With dtmAPrev Do
      Begin

        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add(' SELECT EV.IDEVENTOSPREV,  EV.IDSITPLANOATUAL, EV.IDSITPLANONOVO, '+
                   '        EV.IDSITPARTATUAL, EV.IDSITPARTNOVO,   EV.IDSITFUNCATUAL, EV.IDSITFUNCNOVO, '+
                   '        ST.FLGINTERNO,     STA.FLGINTERNO AS FLGINTERNOANT    '+
                   ' FROM   EVENTOSPREV EV,    SITPART ST,  SITPART STA  '+
                   ' WHERE  EV.IDSITPARTATUAL = STA.IDSITPART         '+
                   ' AND    EV.IDSITPARTNOVO  = ST.IDSITPART          '+
                   ' AND    EV.IDEVENTOSPREV IN ( SELECT MAX(IDEVENTOSPREV) FROM EVENTOSPREV    '+
                   '                              WHERE  IDPESSOA    = '+ IntToStr(piIdTitular)   +
                   '                              AND    IDPLANOPREV = '+ IntToStr(piIdPlanoPrev) +
                   '                              AND    IDPESSJUR   = '+ IntToStr(piIdPessJur)   +
                   '                              AND   DATAREGISTRO = ( SELECT MAX(DATAREGISTRO) FROM EVENTOSPREV '+
                   '                                                     WHERE IDPESSOA     = '+IntToStr(piIdTitular)+
                   '                                                     AND   IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                   '                                                     AND   IDPESSJUR    = '+IntToStr(piIdPessJur)+' '+
                   '                              AND    DATAEVENTO  >= TO_DATE('''+sDataEvento+''',''DD/MM/YYYY'')) )');

        qryAux.Open;

        sIdSitPartAntes := qryAux.FieldByName('idsitpartatual').AsString;
        sIdSitPlanAntes := qryAux.FieldByName('idsitplanoatual').AsString;
        sIdSitFuncAntes := qryAux.FieldByName('idsitfuncatual').AsString;

        sIdSitPartAtual := qryAux.FieldByName('idsitpartnovo').AsString;
        sIdSitPlanAtual := qryAux.FieldByName('idsitplanonovo').AsString;
        sIdSitFuncAtual := qryAux.FieldByName('idsitfuncnovo').AsString;

        qryAux.Close;
        qryAux.SQL.Clear;

        { No Caso de desdobramento não pode buscar informações do beneficiario }
        { concedido no banco de dados, pois ele ainda não foi incluido.        }
        If piOrigem <> 5 Then
        Begin { <> de Desdobramento }
          qryAux.SQL.Add(' SELECT BP.IDREGRACALCULO,   BP.IDREGRAPAGAMENTO, P.DTEVENTO,     '+
                         '        BF.DATAINICIOFUND,   BF.DATAINICIOINSS,   BF.DATAINICIO,  '+
                         '        BF.DATAREQUERIMENTO, BF.VLRINFINSS,       BF.VLRCALCINSS, '+
                         '        BF.FLGPOSSUIACOMPINSS,                                    '+
                         '        BP.IDRGVALORTOTAL,                                        '+
                         '        B.NUMORDEMEVENTO                                          '+        
                         ' FROM   BENEFBFCIARIO BF, PROCESSOBENEF P, BENEFPLANPREV BP, BENEFICIO B  '+
                         ' WHERE  BF.NUMEROPROCESSO   = '+IntToStr(piNumeroProcesso)+
                         ' AND    BF.IDPESSJUR        = '+IntToStr(piIdPessJur)+
                         ' AND    BF.IDPLANOPREV      = '+IntToStr(piIdPlanoPrev)+
                         ' AND    BF.IDTITULAR        = '+IntToStr(piIdTitular)+
                         ' AND    BF.IDPESSOA         = '+IntToStr(piIdPessoa)+
                         ' AND    BF.SEQPROPOSTA      = 1 '+
                         ' AND    BF.IDBENEFICIO      = '+IntToStr(piIdBeneficio)+
                         ' AND    P.NUMEROPROCESSO    = BF.NUMEROPROCESSO '+
                         ' AND    BP.IDPLANOPREV      = BF.IDPLANOPREV    '+
                         ' AND    BP.IDBENEFICIO      = BF.IDBENEFICIO    '+
                         ' AND    BP.IDBENEFICIO      = B.IDBENEFICIO     ');                          
          qryAux.Open;
        End
        Else { = de Desdobramento }
        Begin
          qryAux.SQL.Add(' SELECT BP.IDREGRACALCULO,   BP.IDREGRAPAGAMENTO, P.DTEVENTO,     '+
                         '        BF.DATAINICIOFUND,   BF.DATAINICIOINSS,   BF.DATAINICIO,  '+
                         '        BF.DATAREQUERIMENTO, BF.VLRINFINSS,       BF.VLRCALCINSS, '+
                         '        BF.FLGPOSSUIACOMPINSS,                                    '+
                         '        BP.IDRGVALORTOTAL,                                        '+
                         '        B.NUMORDEMEVENTO                                          '+         
                         ' FROM   BENEFBFCIARIO BF, PROCESSOBENEF P, BENEFPLANPREV BP, BENEFICIO B '+  
                         ' WHERE  BF.NUMEROPROCESSO   = '+IntToStr(piNumeroProcesso)+
                         ' AND    BF.IDPESSJUR        = '+IntToStr(piIdPessJur)+
                         ' AND    BF.IDPLANOPREV      = '+IntToStr(piIdPlanoPrev)+
                         ' AND    BF.IDTITULAR        = '+IntToStr(piIdTitular)+
                         ' AND    BF.SEQPROPOSTA      = 1 '+
                         ' AND    BF.IDBENEFICIO      = '+IntToStr(piIdBeneficio)+
                         ' AND    P.NUMEROPROCESSO    = BF.NUMEROPROCESSO '+
                         ' AND    BP.IDPLANOPREV      = BF.IDPLANOPREV    '+
                         ' AND    BP.IDBENEFICIO      = BF.IDBENEFICIO    '+
                         ' AND    BP.IDBENEFICIO       = B.IDBENEFICIO    ');                          

          qryAux.Open;
        End;

      End; { With }

      dValorSRB := StrToFloat(ClienteNumero(sValorSRB));
      dValorAux := StrToFloat(ClienteNumero(sVlrInfINSS));

      sSql := 'SELECT B.NUMORDEMEVENTO, BP.FLGCALCTODOMES, BF.VALORCOTAS, BF.VALORATUAL,'+#13+#10;

      If piIdTitular = piIdPessoa
      Then sSql := sSql + '       BFP.VALORBASE1, BFP.VALORBASE2, BFP.VALORBASE3'+#13+#10
      Else sSql := sSql + '       BF.VALORBASE1, BF.VALORBASE2, BF.VALORBASE3'+#13+#10;

      sSql := sSql + 'FROM BENEFICIO B, BENEFPLANPREV BP, '+#13+#10;

      If piIdTitular = piIdPessoa
      Then sSql := sSql + '     BENEFBFCIARIO BF, BENEFPLANOPART BFP'+#13+#10
      Else sSql := sSql + '     BENEFBFCIARIO BF'+#13+#10;

      sSql := sSql + 'WHERE BF.IDPESSJUR   = '+IntToStr(piIdPessJur)+#13+#10+
                     '  AND BF.IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+#13+#10+
                     '  AND BF.IDTITULAR   = '+IntToStr(piIdTitular)+#13+#10+
                     '  AND BF.IDPESSOA    = '+IntToStr(piIdPessoa)+#13+#10+
                     '  AND B.IDBENEFICIO  = BF.IDBENEFICIO '+#13+#10+
                     '  AND BP.IDPLANOPREV = BF.IDPLANOPREV '+#13+#10+
                     '  AND BP.IDBENEFICIO = BF.IDBENEFICIO '+#13+#10;


      If piIdTitular = piIdPessoa
       Then sSql := sSql + '  AND BFP.IDPESSJUR   = BF.IDPESSJUR'+#13+#10+
                           '  AND BFP.IDPLANOPREV = BF.IDPLANOPREV'+#13+#10+
                           '  AND BFP.IDPESSOA    = BF.IDPESSOA'+#13+#10+
                           '  AND BFP.IDBENEFICIO = BF.IDBENEFICIO'+#13+#10;

      sSql := sSql + 'ORDER BY B.NUMORDEMEVENTO';

      FazQuery(qryAux, sSql);

      sSQLBenefAssoc := MontaSQLBenefAssoc(qryAux, dtmAPrev.qryAux.FieldByName('NUMORDEMEVENTO').AsInteger);


      //edilaine - SIG40210 - inicio
      if (piOrigem = 2) and (iIdTpPagtoBenefic = 2) then  // Andre Imakawa - SIG 44344
      begin
        // Quando for concessão de beneficio continuar com mesmo valor, se estiver errado a área deve revisar o Requerimento
        sValorBeneficio := OraNumero(FloatToStr(dValorTotal));
      end
      else
      //edilaine - SIG40210 - fim
        { Beneficios de Contribuicao definida não recalcular }
        If ( sTPMODALIDADE <> 'CD' ) Then
        Begin

          If piIdTitular = piIdPessoa Then
            dValorAux       := ExecutaRegraCalculoBeneficio( dtmAPrev.qryAux,
                                       dtmAPrev.qryAux.FieldByName('IDREGRACALCULO').AsInteger,
                                       dtmAPrev.qryAux.FieldByName('IDREGRAPAGAMENTO').AsInteger,
                                       piIdPessJur,
                                       piIdPlanoPrev,
                                       piIdTitular,
                                       1,
                                       piIdBeneficio,
                                       piNumeroProcesso,
                                       pdValorBase1, pdValorBase2, pdValorBase3,
                                       sSQLBenefAssoc,
                                       '01/'+copy(sAnoMesRefAux,6,2)+'/'+copy(sAnoMesRefAux,1,4),
                                       dtmAPrev.qryAux.FieldByName('DATAINICIOFUND').AsString,
                                       dtmAPrev.qryAux.FieldByName('DATAINICIOINSS').AsString,
                                       dtmAPrev.qryAux.FieldByName('DATAINICIO').AsString,
                                       dtmAPrev.qryAux.FieldByName('DATAREQUERIMENTO').AsString,
                                       sVlrInfInss, sVlrCalcInss,
                                       '0',
                                       False,
                                       0,
                                       sDataInicioAnt, sValorAnt,
                                       sValorBase1, sValorBase2, sValorBase3,
                                       bErro, sMsgErro,
                                       piIdCalculo,
                                       dtmAPrev.qryAux.FieldByName('FLGPOSSUIACOMPINSS').AsInteger,
                                       StrToFloat(ClienteNumero(sValorSRB)),
                                       sIdSitPartAntes, sIdSitPlanAntes, sIdSitFuncAntes,
                                       sIdSitPartAtual, sIdSitPlanAtual, sIdSitFuncAtual,
                                       '',
                                       iFlgProvisorio, iPrazoProvisorio, dPercProvisorio,
                                       piOrigem )
          Else
            dValorAux := ExecutaRegraValorTotal( dtmAPrev.qryAux,
                                       dtmAPrev.qryAux.FieldByName('IDRGVALORTOTAL').AsInteger,
                                       piIdPessJur, piIdPlanoPrev,    piIdTitular,
                                       1,           piNumeroProcesso, piIdBeneficio,
                                       piNumBenef,
                                       StrToFloat(ClienteNumero(sValorBase1)),
                                       StrToFloat(ClienteNumero(sValorBase2)),
                                       StrToFloat(ClienteNumero(sValorBase3)),
                                       '',
                                       dtmAPrev.qryAux.FieldByName('DTEVENTO').AsString,
                                       dtmAPrev.qryAux.FieldByName('DATAINICIOFUND').AsString,
                                       dtmAPrev.qryAux.FieldByName('DATAINICIOINSS').AsString,
                                       sVlrCalcInss, sVlrInfINSS,
                                       dtmAPrev.qryAux.FieldByName('DATAINICIO').AsString,
                                       '0', '', '', '',
                                       bErro,
                                       sMsgErro,
                                       piIdCalculo,
                                       0,
                                       sDataInicioAnt,
                                       sValorAnt,
                                       StrToFloat(ClienteNumero(sValorSRB)),
                                       piIdPessoa, piIdPessoa,
                                       iFlgProvisorio, iPrazoProvisorio, dPercProvisorio,
                                       '', sAnoMesRefAux, piOrigem );

          sValorBeneficio := OraNumero(FloatToStr(dValorAux));

        End Else Begin
          { Quando beneficio de contribuicao definida, continuar com mesmo valor }
          sValorBeneficio := OraNumero(FloatToStr(dValorTotal));
        End;

    End
    Else { If (bReajustaSRB or bPossuiReajusteINSS) and (not pbMigracaoPlano) Then }
    Begin
      sValorBeneficio := OraNumero(FloatToStr(pdValorEmReal));
    End;

    if bErro then
    begin
      bErro := True;
      sMsgErro := ' Ocorreu um erro na Regra de Reajuste do Benefício (nº '+sIdRegraReajuste+') ';
      Exit;
    end;

    if Trim(sValorBeneficio) = '' then
    begin
      bErro := True;
      sMsgErro := ' A Regra de Reajuste do Benefício (nº '+sIdRegraReajuste+')'+
                  ' retornou um valor em branco. ';
      Exit;
    end;

    qryAux.Close;
    qryAux.Sql.Clear;

    { Somente atualiza se Reajustar - Causava problemas no Retroativo }
    If bReajustou or bReajustaSuplementacao or bPossuiReajusteINSS Then
    Begin
      if piIdTitular = piIdPessoa then
      begin
         sSQL := ' UPDATE BENEFBFCIARIO SET ULTVALORATUALREAJ = VALORATUAL     , ';
         if bAtualizaVlrTotal then // SOL 159426 Kintana 1310837
         begin
            sSQL := sSQL +  '        VALORATUAL     = '+OraNumero(sValorBeneficio)       +','+
                            '        VALORTOTAL     = '+OraNumero(sValorBeneficio)       +','+
                            '        VALORSRB       = '+OraNumero(FloatToStr(dValorSRB)) +','; //TADEU PASSOS SOL 200569 KINTANA 1933307
         end;  // SOL 159426 Kintana 1310837
         sSQL := sSQL +  '        VALORCALCULADO = '+OraNumero(sValorBeneficio)       +','+
                         '        ULTMESREAJUSTE = '''+Trim(sAnoMesRefAux)              +''''+
                         ' WHERE  NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)       +
                         ' AND    IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)          +
                         ' AND    IDTITULAR      = '+IntToStr(piIdTitular)            +
                         ' AND    IDPESSJUR      = '+IntToStr(piIdPessJur)            +
                         ' AND    IDBENEFICIO    = '+IntToSTr(piIdBeneficio)          +
                         ' AND    IDPESSOA       = '+IntToStr(piIdPessoa)             +
                         ' AND    SEQPROPOSTA    = 1                                  ';
      end
      else
      begin

         dValorTotal := StrToFloat(ClienteNumero(sValorBeneficio));

         sSQL := ' UPDATE BENEFBFCIARIO SET ULTVALORATUALREAJ = VALORATUAL          ,';
         if bAtualizaVlrTotal then // SOL 159426 Kintana 1310837
         begin
            sSQL :=  sSQL + '        VALORTOTAL     = '+OraNumero(FloatToStr(dValorTotal)) +','+
                            '        VALORSRB       = '+OraNumero(FloatToStr(dValorSRB))   +','; //TADEU PASSOS SOL 200569 KINTANA 1933307
         end; // SOL 159426 Kintana 1310837

         sSQL :=  sSQL +    '        VALORCALCULADO = '+OraNumero(FloatToStr(dValorTotal)) +','+
                            '        ULTMESREAJUSTE = '''+Trim(sAnoMesRefAux)                +''''+
                            ' WHERE  NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)         +
                            ' AND    IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)            +
                            ' AND    IDTITULAR      = '+IntToStr(piIdTitular)              +
                            ' AND    IDPESSJUR      = '+IntToStr(piIdPessJur)              +
                            ' AND    IDBENEFICIO    = '+IntToSTr(piIdBeneficio)            +
                            ' AND    IDPESSOA       = '+IntToStr(piIdPessoa)               +
                            ' AND    SEQPROPOSTA    = 1                                    ';

      end;

      Try
        ExecutarQuery( QryAux, sSQL );
      Except
        bErro := True;
        sMsgErro := 'Erro na atualização do valor atual do benefício. ';
        Exit;
      End;

      bReajustou := True;

    End; { If bReajustou = True Then Begin }

    { Se for beneficio de referencia, atualizar os campos VLRCALCINSS e      }
    { VLRINFINSS da suplementação                                            }

    If pbBenefReferencia Then
    Begin

      sSQL := ' UPDATE BENEFBFCIARIO SET VLRINFINSS  = '+OraNumero(sValorBeneficio) +','+
              '                          VLRCALCINSS = '+OraNumero(sValorBeneficio) +
              ' WHERE  NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)                +
              ' AND    IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)                   +
              ' AND    IDTITULAR      = '+IntToStr(piIdTitular)                     +
              ' AND    IDPESSJUR      = '+IntToStr(piIdPessJur)                     +
              ' AND    ((IDBENEFICIO    IN (SELECT IDBENEFICIO FROM BENEFPLANPREV  '+
              '                           WHERE  IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+
              '                           AND    IDBENEFREF  = '+IntToSTr(piIdBeneficio)+')) OR '+
              '          (IDBENEFREFEREN = '+IntToSTr(piIdBeneficio)+') )   '+
              ' AND    IDPESSOA       = '+IntToStr(piIdPessoa)               +
              ' AND    SEQPROPOSTA    = 1                                    ';

      Try
        ExecutarQuery( QryAux, sSQL );
      Except
         bErro := True;
         sMsgErro := 'Erro na atualização do valor do inss no benefício. ';
         Exit;
      End;

    End;

    dValorTotal           := StrToFloat(ClienteNumero(sValorBeneficio));
    dValorTotalReajustado := dValorTotal;

    { Se for beneficio de Pensão, rateá-lo }
    If ( piIdTitular <> piIdPessoa ) And ( Not pbMigracaoPlano ) Then
    Begin

      dValorTotalReajustado := dValorTotal;

      sSQL := ' SELECT P.DTEVENTO, BF.DATAINICIO, BF.DATAFINAL, BF.DATAINICIOINSS,         '+
              '        BF.VLRINFINSS, BP.IDREGRAPAGAMENTO,  BP.IDREGRACALCULO,             '+
              '        DP.IDDEPENDENCIA, BTIT.PERCENTUAL, BF.DIBBENEFANT, BF.VALORBENEFANT,'+
              '        BF.VLRCALCINSS, BF.ULTVALORATUALREAJ                                '+
              ' FROM   BENEFPLANPREV BP, DEPENTIT DP, BFCIARIOTITPLAN BTIT, '+
              '        PROCESSOBENEF P,  BENEFBFCIARIO BF    '+
              ' WHERE  BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
              ' AND    BF.IDPESSJUR      = '+IntToStr(piIdPessJur)+
              ' AND    BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
              ' AND    BF.IDTITULAR      = '+IntToStr(piIdTitular)+
              ' AND    BF.SEQPROPOSTA    = 1 ' ;

      { No caso de desdobramento não pode buscar informações do  beneficiario }
      { concedido no banco de dados, pois ele ainda não foi incluido          }
      If piOrigem <> 5 Then { <> de Desdobramento }
      Begin
        sSQL := sSQL + ' AND    BF.IDPESSOA       = '+IntToStr(piIdPessoa);
      End;

      sSQL := sSQL + ' AND    BF.IDBENEFICIO    = '+IntToStr(piIdBeneficio)+
                     ' AND    P.NUMEROPROCESSO  = BF.NUMEROPROCESSO '+
                     ' AND    BP.IDPLANOPREV    = BF.IDPLANOPREV    '+
                     ' AND    BP.IDBENEFICIO    = BF.IDBENEFICIO    '+
                     ' AND    BTIT.IDPESSJUR    = BF.IDPESSJUR      '+
                     ' AND    BTIT.IDPLANOPREV  = BF.IDPLANOPREV    '+
                     ' AND    BTIT.IDTITULAR    = BF.IDTITULAR      '+
                     ' AND    BTIT.IDPESSOA     = BF.IDPESSOA       '+
                     ' AND    BTIT.SEQPROPOSTA  = BF.SEQPROPOSTA    '+
                     ' AND    BTIT.IDBENEFICIO  = BF.IDBENEFICIO    '+
                     ' AND    DP.IDTITULAR      = BTIT.IDTITULAR    '+
                     ' AND    DP.IDPESSOA       = BTIT.IDPESSOA     ';

      FazQuery( QryAux, sSQL );

      if (StrToInt(Copy(qryaux.FieldByName('DATAINICIO').AsString,1,2)) >= 29) and
         (StrToInt(Copy(sAnoMesRefAux,6,2)) = 2)
      then sDataRef := '28/'+copy(sAnoMesRefAux,6,2) + '/'+ copy(sAnoMesRefAux,1,4)
      else sDataRef := copy(qryaux.FieldByName('DATAINICIO').AsString,1,2)+ '/' + copy(sAnoMesRefAux,6,2) + '/' + copy(sAnoMesRefAux,1,4);

      If (Copy(sDataRef,1,2) = '31') And (Pos(Copy(sDataRef,4,2), '04060911') <> 0)
      Then  sDataRef := '30'+Copy(sDataRef,3,9);

      //William Moreira da Silva - SOL 231132 PPM 379249
      if piOrigem <> 5 then
      begin
         dValorRateadoReajustado  := ExecutaRegraCalculoBeneficioBfciario(
                                    qryAux,
                                    qryAux.FieldByName('IDREGRACALCULO').AsInteger,
                                    -1,
                                    piIdPessJur,         piIdPlanoPrev,
                                    piIdTitular,         1,
                                    piIdBeneficio,       piNumeroProcesso,
                                    piNumBenef,
                                    pdValorBase1, pdValorBase2, pdValorBase3,
                                    '',
                                    sDataRef,
                                    qryAux.FieldByName('DATAINICIO').AsString,
                                    qryAux.FieldByName('DATAINICIOINSS').AsString,
                                    OraNumero(FloatToStr(dValorTotalReajustado)),
                                    sVlrInfINSS, sVlrCalcINSS,
                                    '0',
                                    bErro,
                                    sMsgErro,
                                    iIdCalculoGeral,
                                    piIdPessoa,
                                    qryAux.FieldByName('IDDEPENDENCIA').AsString,
                                    qryAux.FieldByName('PERCENTUAL').AsString,
                                    0,
                                    qryAux.FieldByName('DIBBENEFANT').AsString,
                                    qryAux.FieldByName('VALORBENEFANT').AsString,
                                    psAnoMesRef,
                                    -1,
                                    iFlgProvisorio, iPrazoProvisorio, dPercProvisorio,
                                    0, '', piOrigem
                                  );
      end
      else
      begin
                  dValorRateadoReajustado  := ExecutaRegraCalculoBeneficioBfciario(
                                    qryAux,
                                    qryAux.FieldByName('IDREGRACALCULO').AsInteger,
                                    -1,
                                    piIdPessJur,         piIdPlanoPrev,
                                    piIdTitular,         1,
                                    piIdBeneficio,       piNumeroProcesso,
                                    piNumBenef,
                                    pdValorBase1, pdValorBase2, pdValorBase3,
                                    '',
                                    sDataRef,
                                    qryAux.FieldByName('DATAINICIO').AsString,
                                    qryAux.FieldByName('DATAINICIOINSS').AsString,
                                    OraNumero(FloatToStr(dValorTotalReajustado)),
                                    sVlrInfINSS, sVlrCalcINSS,
                                    '0',
                                    bErro,
                                    sMsgErro,
                                    iIdCalculo,
                                    piIdPessoa,
                                    qryAux.FieldByName('IDDEPENDENCIA').AsString,
                                    qryAux.FieldByName('PERCENTUAL').AsString,
                                    0,
                                    qryAux.FieldByName('DIBBENEFANT').AsString,
                                    qryAux.FieldByName('VALORBENEFANT').AsString,
                                    psAnoMesRef,
                                    -1,
                                    iFlgProvisorio, iPrazoProvisorio, dPercProvisorio,
                                    0, '', piOrigem
                                  );
      end;
      //William Moreira da Silva - SOL 231132 PPM 379249

      { Atualizar o campo VALORATUAL com o valor reajustado rateado }

      //BRUNO AZEVEDO SOL 176870 KINTANA 1616173
      if bAtualizaVlrTotal then begin
        sSQL := ' UPDATE BENEFBFCIARIO SET VALORATUAL = '+OraNumero(FloatToStr(dValorRateadoReajustado))+
                ' WHERE  NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
                ' AND    IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
                ' AND    IDTITULAR      = '+IntToStr(piIdTitular)+
                ' AND    IDPESSJUR      = '+IntToStr(piIdPessJur)+
                ' AND    IDBENEFICIO    = '+IntToSTr(piIdBeneficio)+
                ' AND    IDPESSOA       = '+IntToStr(piIdPessoa)+
                ' AND    SEQPROPOSTA    = 1 ';

        Try
          ExecutarQuery( QryAux, sSQL );
        Except
           bErro := True;
           sMsgErro := 'Erro na atualização do valor atual do benefício. ';
           Exit;
        End;
      end;
      //BRUNO AZEVEDO SOL 176870 KINTANA 1616173
    End
    Else dValorRateadoReajustado := StrToFloat(ClienteNumero(sValorBeneficio));

    sAnoMesRefAux := ProximoAnoMes(strtoint(copy(sAnoMesRefAux,6,2)), strtoint(copy(sAnoMesRefAux,1,4)));

  End; { While ( sAnoMesRefAux <= psAnoMesRef ) Do }

  bReajustou := True;
  bErro      := False;

  sMsgErro   := ' ';

  { Retornar o VALOR TOTAL REAJUSTADO, para que possa ser executada a regra de }
  { benefício mimino                                                           }

  Result     := OraNumero( FloatToStr( dValorTotalReajustado ) );

end; { ReajustaBenefConc }

function AcertaBeneficioNoPeriodo   ( qryAux               : TwwQuery;
                                      iNumBenef            : word;
                                      cRetemEncerra        : char;
                                      psDataInicio,
                                      sNovaDataFinal       : string;
                                      piNumeroProcesso,
                                      piIdBeneficio,
                                      piIdPessJur,
                                      piIdPlanoPrev,
                                      piIdTitular,
                                      piIdBeneficiario,
                                      piSeqProposta        : longint;
                                      pdValorAtual         : double;
                                      pdValorTotal         : double;
                                      pbFlgEncerraFale     : boolean;
                                      piIdLoteRetemEncerra : longint;
                                      var sMsgErro         : string;
                                      bAcertaContribuicao  : boolean  ) : boolean;
var
   sAnoMesAtual                      : string;
   sAnoMesInicioFaixa                : string;
   sIdMotivoAux, sAnoMesFinalFaixa                 : string;
   iIdMotivoAux                      : longint;
   dValorBeneficioNoMes              : double;
   dValorTotalNoMes                  : double;
   dValorEmCotasNoMes                : double;
   iIdTpPagto                        : integer;
   iTipoMov                          : integer;
   iFlgDataPrevista                  : longint;
   bErro                             : boolean;
   bReajustou                        : boolean;
   dValorBeneficioIntegral           : double;
   dValorBeneficioIntegralAposMinimo : double;
   dValorPrevAntesMinimo             : double;
   dValorBenefRateado                : double;
   dValorSRB                         : double;
   sDataFolha                        : string;
   sAnoMesPagto                      : string;
   dValorAcerto                      : double;
   iFlgDevolucao                     : integer;
   dValorJaExistente                 : double;
   iCodPortForma                     : longint;
   iIdRegraPrimPagto                 : longint;
   iIdRegraUltPagto                  : longint;
   iIdRegraCalculo                   : longint;
   bBenefReferencia                  : boolean;
   iFlgCalculaTodoMes                : integer;
   sUltMesReajuste                   : string;
   dParcela1                         : double;
   dParcela2                         : double;
   sDataIniPeriodo                   : string;
   sDataFimPeriodo                   : string;
   iSeqBeneficio                     : word;
   iIdNucleoFamiliar                 : longint;
   wPrimeiroPagamento                : boolean;
   dValorAux                         : double; 
   sDataFinalDesteBeneficiario       : string;
begin
   Result := False;
   // **************************************************************************
   // **************************************************************************
   // Objetivo : O objetivo desta rotina é tratar os beneficios dos beneficiarios
   //            restantes em um processo onde um dos beneficiarios foi retirado
   //            por encerramento ou retenção
   // Exemplo :  3 beneficiários com valor total de 900,00 sendo 300,00 para cada um
   //            Beneficiario Encerrado = #01
   //            Data do Encerramento   = 10.06.2003
   //            O mês de junho terá 10 dias com 3 beneficiários e
   //                                20 dias com 2 beneficiários
   //            Acertos =                 Mês      Pago   Devido       Acerto
   //                    Beneficiario #01  06       300    100          -200
   //                    Beneficiario #01  07       300    0            -300
   //
   //                    Beneficiario #02  06       300    400          +100
   //                    Beneficiario #02  07       300    450          +150
   //
   //                    Beneficiario #03  06       300    400          +100
   //                    Beneficiario #03  07       300    450          +150
   //
   //                    Obs. Mes 06 -> 10 dias de 300,00 = 100,00
   //                                 + 20 dias de 450,00 = 300,00
   //                                     Total           = 400,00
   // --------------------------------------------------------------------------
   // **************************************************************************
   // **************************************************************************
   // 0. Preencher variaveis de inicialização da rotina
   // Faixa de Verificacao : sAnoMesInicioFaixa = mes da retencao/encerramento
   //                        sAnoMesFinalFaixa  = mes atual
   // --------------------------------------------------------------------------
   sAnoMesInicioFaixa   := Copy(sNovaDataFinal,7,4)+'/'+Copy(sNovaDataFinal,4,2);

   sAnoMesFinalFaixa    := Copy(FormatDateTime('dd/mm/yyyy', date),7,4) + '/' +   
                           Copy(FormatDateTime('dd/mm/yyyy', date),4,2);          

   sAnoMesAtual         := sAnoMesInicioFaixa;
   dValorBeneficioNoMes := pdValorAtual;
   dValorTotalNoMes     := pdValorTotal;
   dValorEmCotasNoMes   := pdValorAtual;

   if (pbFlgEncerraFale)
   then begin
      if (piIdTitular = piIdBeneficiario)
      then begin
         // Se o parametro prmFLGENVACERTOFALEC for TRUE e o lote for > 0 entao jogar no motivo normal
         // pois significa que a fundação acerta o beneficio diretamente na conta do participante
         if (prmFlgTipoAcertoFL = 1) or (prmFLGENVACERTOFALEC) // ENVIA ACERTO PARA CONTA DO PARTICIPNATE
         then begin
            if prmIdMotivoAcertoFL <= 0
            then begin
               sMsgErro := 'Motivo para Acerto Pós-Morte na Conta do Participante não preenchido.';
               Exit;
            end;
            iIdMotivoAux := prmIdMotivoAcertoFL;
         end
         else begin
            if prmIdMotDevolNaoIden <= 0
            then begin
               sMsgErro := 'Motivo para Pagamento com Recebedor não Identificado não preenchido.';
               Exit;
            end;

            iIdMotivoAux := prmIdMotDevolNaoIden;
         end
      end
      else iIdMotivoAux := prmIdMotDevolNaoIden; 
      // ***
   end
   else iIdMotivoAux := prmIdMotivoDevolBen;

   if cRetemEncerra = 'E'
   then begin
      iTipoMov         := 4; // Encerramento
      iFlgDataPrevista := 0;
   end
   else begin
      iTipoMov         := 3; // Retenção
      iFlgDataPrevista := 1;
   end;

   qryAux.Close;
   qryAux.SQL.Clear;
   qryAux.SQL.Add(' SELECT BP.IDREGRAULTPAGTO, BP.IDREGRACALCULO, BP.FLGREFERENCIA,         '+
                  '        BP.FLGCALCTODOMES,  BF.ULTMESREAJUSTE, BP.IDREGRAPRIMPAGTO,      '+
                  '        BF.VALORSRB, BF.VALORTOTAL, BF.VALORATUAL, BF.CODPORTFORMA,      '+
                  '        BF.DATAFINAL,                                                    '+
                  '        NVL(BF.IDTPPAGTOBENEFIC, B.IDTPPAGTOBENEFIC) AS IDTPPAGTOBENEFIC '+
                  ' FROM   BENEFBFCIARIO BF, BENEFPLANPREV BP, BENEFICIO B                  '+
                  ' WHERE  BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)                  +
                  ' AND    BF.IDPESSJUR      = '+IntToStr(piIdPessJur)                       +
                  ' AND    BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)                     +
                  ' AND    BF.IDTITULAR      = '+IntToStr(piIdTitular)                       +
                  ' AND    BF.IDPESSOA       = '+IntToStr(piIdBeneficiario)                  +
                  ' AND    BF.IDBENEFICIO    = '+IntToStr(piIdBeneficio)                     +
                  ' AND    BP.IDPLANOPREV    = BF.IDPLANOPREV                               '+
                  ' AND    BP.IDBENEFICIO    = BF.IDBENEFICIO                               '+
                  ' AND    B.IDBENEFICIO     = BF.IDBENEFICIO                               ');
   qryAux.Open;
   if qryAux.IsEmpty
   then begin
      Result := True;
      Exit;
   end;
   iIdTpPagto                        := qryAux.FieldByName('IDTPPAGTOBENEFIC').AsInteger;
   dValorBeneficioIntegral           := qryAux.FieldByName('VALORTOTAL').AsFloat;
   dValorBeneficioIntegralAposMinimo := qryAux.FieldByName('VALORTOTAL').AsFloat;
   dValorPrevAntesMinimo             := qryAux.FieldByName('VALORATUAL').AsFloat;
   dValorBenefRateado                := qryAux.FieldByName('VALORATUAL').AsFloat;
   dValorSRB                         := qryAux.FieldByName('VALORSRB').AsFloat;
   iCodPortForma                     := qryAux.FieldByName('CODPORTFORMA').AsInteger;
   iIdRegraUltPagto                  := qryAux.FieldByName('IDREGRAULTPAGTO').AsInteger;
   iIdRegraPrimPagto                 := qryAux.FieldByName('IDREGRAPRIMPAGTO').AsInteger;
   iIdRegraCalculo                   := qryAux.FieldByName('IDREGRACALCULO').AsInteger;
   bBenefReferencia                  := (qryAux.FieldByName('FLGREFERENCIA').AsInteger = 1);
   iFlgCalculaTodoMes                := qryAux.FieldByName('FLGCALCTODOMES').AsInteger;
   sUltMesReajuste                   := qryAux.FieldByName('ULTMESREAJUSTE').AsString;
   sDataFinalDesteBeneficiario       := qryAux.FieldByName('DATAFINAL').AsString; 


   qryAux.Close;
   qryAux.SQL.Clear;
   qryAux.SQL.Add(' SELECT DATAPREPARO, MESREFERENCIA, ');
   qryAux.SQL.Add('        DATAPAGAMENTO '); 
   qryAux.SQL.Add(' FROM CTRLINTERFACE '+
                  ' WHERE  IDLOTE = '+IntToStr(piIdLoteRetemEncerra));
   qryAux.Open;

   if not qryAux.IsEmpty
   then begin
      sAnoMesPagto := qryAux.FieldByName('MESREFERENCIA').AsString;
      sDataFolha   := qryAux.FieldByName('DATAPAGAMENTO').AsString; 
   end
   else begin
      sDataFolha   := CriticaDataCobrancaSit(qryAux,IntToStr(iIdFundacao),'', 'AS',
                                          'P',Copy(sAnoMesFinalFaixa,6,2), Copy(sAnoMesFinalFaixa,1,4));

      if Trim(sDataFolha) = '' then sDataFolha := FormatDateTime('dd/mm/yyyy', date);

      sAnoMesPagto := Copy(sDataFolha,7,4) + '/' + Copy(sDataFolha,4,2);
   end;

   if Trim(sDataFolha) = '' then sDataFolha := FormatDateTime('dd/mm/yyyy', date);

   if sAnoMesFinalFaixa > sAnoMesPagto then sAnoMesFinalFaixa := sAnoMesPagto;
   // **************************************************************************
   // **************************************************************************
   // 1. Acertar valores do beneficiário que ficou no processo com exceção do
   //    abono
   // --------------------------------------------------------------------------
   while sAnoMesAtual <= sAnoMesFinalFaixa do
   begin
       qryAux.Close;
       qryAux.SQL.Clear;
       qryAux.SQL.Add('SELECT VALORTOTAL');
       qryAux.SQL.Add('FROM   HSTBENEFBFCIARIO ');
       qryAux.SQL.Add('WHERE  IDPESSOA       = '+IntToStr(piIdBeneficiario));
       qryAux.SQL.Add('AND    MESREFERENCIA = '''+Copy(sAnoMesAtual,1,4)+'/'+Copy(sAnoMesAtual,6,2)+'''');
       qryAux.SQL.Add('AND    IDBENEFICIO    = '+IntToStr(piIdBeneficio));
       qryAux.SQL.Add('AND    NUMEROPROCESSO = '+IntToStr(piNumeroProcesso));
       qryAux.Open;

       dValorAux := qryAux.FieldByName('VALORTOTAL').AsFloat;
       
       If dValorAux > 0
        Then dValorTotalNoMes := dValorAux;

       // **********************************************************************
       // **********************************************************************
       // 1.1. Acertar Beneficios
       // ----------------------------------------------------------------------
       // Se for o 1o. mês então calcular dois periodos
       // 1o. Periodo = Do inicio do mês até o dia do encerramento com o beneficiario encerrado
       // 2o. Periodo = Do dia apos o encerramento até o final do mes sem o beneficiario encerrado
       if sAnoMesAtual = sAnoMesInicioFaixa
       then begin
          sDataIniPeriodo := '01/'+Copy(sAnoMesAtual,6,2)+'/'+Copy(sAnoMesAtual,1,4);
          sDataFimPeriodo := sNovaDataFinal;

          // Executar o pro-rata de ultimo pagamento para o periodo 1
          dParcela1 := ExecutaRegraPrimUltPagtoBenef( qryAux,
                                                      iIdRegraUltPagto,
                                                      piIdTitular,
                                                      piIdBeneficiario,
                                                      piSeqProposta,
                                                      piIdPessJur,
                                                      piIdPlanoPrev,
                                                      piIdBeneficio,
                                                      iNumBenef+1,
                                                      sDataIniPeriodo,
                                                      sDataFimPeriodo,
                                                      '', // Thiago Melo SOL 208274.15065 Kintana 2043014													  
                                                      OraNumero(FloatToStr(dValorBenefRateado)),
                                                      ' Último ',
                                                      bErro,
                                                      sMsgErro,
                                                      iIdCalculoGeral );

          sDataIniPeriodo := FormatDateTime('dd/mm/yyyy', StrToDate(sNovaDataFinal)+1); 

          sDataFimPeriodo := IntToStr(TrazUltDiaMes(StrToInt(Copy(sNovaDataFinal,4,2)), StrToInt(Copy(sNovaDataFinal,7,4))));
          if StrToInt(sDataFimPeriodo) <= 9
          then sDataFimPeriodo := '0'+sDataFimPeriodo;
          sDataFimPeriodo := sDataFimPeriodo +'/'+Copy(sNovaDataFinal,4,2)+'/'+Copy(sNovaDataFinal,7,4);

          If (piIdTitular <> piIdBeneficiario) And (pbFlgEncerraFale)
           Then sDataFimPeriodo := '';                               

          If((sDataFimPeriodo = '') And                            
             (piIdTitular <> piIdBeneficiario) And                 
             (pbFlgEncerraFale)) Or                                
             (StrToDate(sDataIniPeriodo) < StrToDate(sDataFimPeriodo))
           Then dParcela2 := ExecutaRegraPrimUltPagtoBenef( qryAux,
                                                            iIdRegraPrimPagto,
                                                            piIdTitular,
                                                            piIdBeneficiario,
                                                            piSeqProposta,
                                                            piIdPessJur,
                                                            piIdPlanoPrev,
                                                            piIdBeneficio,
                                                            iNumBenef,
                                                            sDataIniPeriodo,
                                                            sDataFimPeriodo,
                                                            '', // Thiago Melo SOL 208274.15065 Kintana 2043014															
                                                            OraNumero(FloatToStr(dValorBeneficioNoMes)),
                                                            ' Primeiro ',
                                                            bErro,
                                                            sMsgErro,
                                                            iIdCalculoGeral )
           Else dParcela2 := 0;
          dValorBeneficioNoMes := dParcela1 + dParcela2;

       end
       else begin
          dValorBeneficioNoMes := CalculaBeneficioAPagarNoMes( qryAux,
                                                               sAnoMesAtual,
                                                               piIdTitular,
                                                               piIdBeneficiario,
                                                               piSeqProposta,
                                                               piIdPessJur,
                                                               piIdPlanoPrev,
                                                               piNumeroProcesso,
                                                               piIdBeneficio,
                                                               iNumBenef,
                                                               -1, // não precisa pois só roda a de ultimo = piIdRegraPrimPagto
                                                               iIdRegraUltPagto,
                                                               iIdTpPagto,
                                                               psDataInicio,
                                                               sDataFinalDesteBeneficiario,
                                                               sAnoMesFinalFaixa,
                                                               IntToStr(iFlgCalculaTodoMes),
                                                               dValorBeneficioNoMes,
                                                               dValorTotalNoMes,
                                                               dValorEmCotasNoMes,
                                                               True,
                                                               psDataInicio,
                                                               iTipoMov,
                                                               iFlgDataPrevista,
                                                               bErro,
                                                               bReajustou,
                                                               sUltMesReajuste,
                                                               dValorBeneficioIntegral,
                                                               dValorBeneficioIntegralAposMinimo,
                                                               dValorPrevAntesMinimo,
                                                               dValorBenefRateado,
                                                               dValorSRB,
                                                               iIdCalculoGeral,
                                                               sDataFolha);
       end;
       // Verificar se o beneficio já foi pago no mes
       // Se sim, inserir o acerto ( devolução ou pagamento )
       qryAux.Close;
       qryAux.SQL.Clear;
       qryAux.SQl.Add(' SELECT MAX(VALORINTEGRAL) AS VALORINTEGRAL,                                 '+
                   '        SUM(DECODE(FLGDEVOLUCAO,1,-VALORPREV,VALORPREV)) AS VALORPREV,       '+
                   '        SUM(DECODE(FLGDEVOLUCAO,1,-VLBENEFPGTO,VLBENEFPGTO)) AS VLBENEFPGTO  '+
                   ' FROM   HSTBENEFBFCIARIO '+
                   ' WHERE (IDPESSOA       = '+IntToStr(piIdBeneficiario)    +')'+
                   ' AND   (MESREFERENCIA  = '''+sAnoMesAtual                +''')'+
                   ' AND   (IDBENEFICIO    = '+IntToStr(piIdBeneficio)       +')'+
                   ' AND   (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)    +')');
       qryAux.Open;
       if (not qryAux.IsEmpty) and (qryAux.FieldByName('VALORPREV').AsFloat > 0)
       then begin
          if qryAux.FieldByName('VLBENEFPGTO').AsFloat > 0
          then dValorJaExistente := qryAux.FieldByName('VLBENEFPGTO').AsFloat
          else dValorJaExistente := qryAux.FieldByName('VALORPREV').AsFloat;

          if Abs(dValorJaExistente - dValorBeneficioNoMes) < 0.01
          then begin // não há acerto
             sAnoMesAtual := ProximoAnoMes(StrToInt(Copy(sAnoMesAtual, 6,2)), StrToInt(Copy(sAnoMesAtual, 1,4)));
             continue;
          end;

          if dValorJaExistente > dValorBeneficioNoMes
          then begin // cobrar devolucao
             iFlgDevolucao := 1;
             dValorAcerto  := dValorJaExistente - dValorBeneficioNoMes;
          end
          else begin // pagar beneficio
             iFlgDevolucao := 0;
             dValorAcerto  := dValorBeneficioNoMes - dValorJaExistente;
          end;
       end
       else begin // não existe historico para o mes indicado
          if dValorBeneficioNoMes <= 0
          then begin // não há acerto
             sAnoMesAtual := ProximoAnoMes(StrToInt(Copy(sAnoMesAtual, 6,2)), StrToInt(Copy(sAnoMesAtual, 1,4)));
             continue;
          end;
          iFlgDevolucao := 0;
          dValorAcerto  := dValorBeneficioNoMes;
       end;

       iSeqBeneficio := PegaSeqBeneficio( qryAux,
                                          piIdPessJur,   piIdTitular,
                                          piIdPlanoPrev, piIdBeneficiario,
                                          piSeqProposta, piNumeroProcesso,
                                          piIdBeneficio, iIdMotivoAux,
                                          sAnoMesPagto, sAnoMesAtual);


       if not InsereHstBenefBfciario ( qryAux,
                                       iSeqBeneficio,
                                       piNumeroProcesso,
                                       piIdBeneficio,
                                       piIdPessJur,
                                       piIdPlanoPrev,
                                       piIdTitular,
                                       piSeqProposta,
                                       piIdBeneficiario,
                                       iIdRegraCalculo,
                                       iIdMotivoAux,
                                       iCodPortForma,
                                       sAnoMesAtual,
                                       sAnoMesPagto,
                                       '',
                                       '',
                                       '',
                                       dValorAcerto,
                                       dValorAcerto,
                                       dValorBeneficioIntegralAposMinimo,
                                       0, // valorpago
                                       0, // piFlgEnviado
                                       1, // piFlgConcessao
                                       iFlgDevolucao,
                                       piIdLoteRetemEncerra,
                                       sMsgErro,
                                       sDataFolha,

                                       dValorBeneficioIntegralAposMinimo,
                                       dValorSRB )
       then Exit;

       if sAnoMesAtual = sAnoMesFinalFaixa
       then begin
          qryAux.Close;
          qryAux.SQL.Clear;
          qryAux.SQL.Add(' UPDATE BENEFBFCIARIO SET ULTMESPREPARO = '''+sAnoMesAtual+''''+
                         ' WHERE  (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)    +')'+
                         ' AND    (IDPESSJUR      = '+IntToStr(piIdPessJur)         +')'+
                         ' AND    (IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)       +')'+
                         ' AND    (IDTITULAR      = '+IntToStr(piIdTitular)         +')'+
                         ' AND    (SEQPROPOSTA    = '+IntToStr(piSeqProposta)       +')'+
                         ' AND    (IDPESSOA       = '+IntToStr(piIdBeneficiario)    +')'+
                         ' AND    (IDBENEFICIO    = '+IntToStr(piIdBeneficio)       +')');

          try
             qryAux.ExecSQL;
          except
             Exit;
          end;
       end;

       if sAnoMesAtual = sAnoMesInicioFaixa
       then dValorBeneficioNomes := pdValorAtual;

       // **********************************************************************
       // **********************************************************************
       // 1.2. Acertar Contribuições
       // ----------------------------------------------------------------------

       if not bAcertaContribuicao
       then begin
          sAnoMesAtual := ProximoAnoMes(StrToInt(Copy(sAnoMesAtual, 6,2)), StrToInt(Copy(sAnoMesAtual, 1,4)));
          continue;
       end;
       bAcertoPorEncerramentoNucleo := True;

       dtmAPrev.qryContribNucleo.Close;
       dtmAPrev.qryContribNucleo.SQL.Clear;
       dtmAPrev.qryContribNucleo.SQL.Add(' SELECT DISTINCT                                                          '+
            '   CN.IDCONTRIBUICAO, CN.IDNUCLEOFAMILIAR, CN.DATAINICIO,      CN.DATAFINAL,                  '+
            '   CN.ULTMESPREPARO,  CN.FLGCOBRA,         CTP.IDREGRACALCULO,  CTP.IDPLANOPREV,              '+
            '   CTP.IDRUBRICA,      CTP.IDREGRAPRIMPAGTO, CTP.IDREGRAULTPAGTO, CTP.CODPORTFORMA,           '+
            '   CTP.FLGDESCFOLHA,   CTP.FLGNAOEXIGEREC,   CON.NOME,            NF.IDRESPNUCLEO             '+
            ' FROM BENEFBFCIARIO BF, BENEFICIO B, BENEFPLANPREV BPL, SITBENEFICIO S,                       '+
            ' BENEFPLANOPART BPART, BFCIARIOTITPLAN BTIT, PESSOA P, TPPAGTOBENEFICIO TP,                   '+
            ' CONTRIBPREVNUCLEO CN, CM.CONTPREV CTP, CM.CONTRIBUICAO CON, CM.NUCLEOFAMILIAR NF             '+
            ' WHERE  BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)                                        +
            ' AND    BF.IDPESSOA       = P.IDPESSOA                                                        '+
            ' AND    B.IDBENEFICIO     = BF.IDBENEFICIO                                                    '+
            ' AND    BPL.IDBENEFICIO   = BF.IDBENEFICIO                                                    '+
            ' AND    BPL.IDPLANOPREV   = BF.IDPLANOPREV                                                    '+
            ' AND    BF.IDSITBENEFICIO = S.IDSITBENEFICIO(+)                                               '+
            ' AND    BF.IDTITULAR      = BPART.IDPESSOA(+)                                                 '+
            ' AND    BF.SEQPROPOSTA    = BPART.SEQPROPOSTA(+)                                              '+
            ' AND    BF.IDPESSJUR      = BPART.IDPESSJUR(+)                                                '+
            ' AND    BF.IDPLANOPREV    = BPART.IDPLANOPREV(+)                                              '+
            ' AND    BF.IDBENEFICIO    = BPART.IDBENEFICIO(+)                                              '+
            ' AND    BF.IDPLANOORIGEM  = BTIT.IDPLANOORIGEM                                                '+
            ' AND    BF.IDPLANOPREV    = BTIT.IDPLANOPREV                                                  '+
            ' AND    BF.IDTITULAR      = BTIT.IDTITULAR                                                    '+
            ' AND    BF.IDPESSJUR      = BTIT.IDPESSJUR                                                    '+
            ' AND    BF.IDPESSOA       = BTIT.IDPESSOA                                                     '+
            ' AND    BF.IDBENEFICIO    = BTIT.IDBENEFICIO                                                  '+
            ' AND    BF.SEQPROPOSTA    = BTIT.SEQPROPOSTA                                                  '+
            ' AND    BPL.FLGREFERENCIA = 0                                                                 '+
            ' AND    TP.IDTPPAGTOBENEFIC = B.IDTPPAGTOBENEFIC                                              '+
            ' AND    TP.FLGFREQUENCIA <> ''U''                                                             '+
            ' AND    CN.IDNUCLEOFAMILIAR = BTIT.IDNUCLEOFAMILIAR                                           '+
            ' AND    CTP.IDCONTRIBUICAO   = CN.IDCONTRIBUICAO                                              '+
            ' AND    CTP.IDPLANOPREV = BF.IDPLANOPREV                                                      '+
            ' AND    CON.IDCONTRIBUICAO   = CN.IDCONTRIBUICAO                                              '+
            ' AND    NF.IDNUCLEOFAMILIAR = CN.IDNUCLEOFAMILIAR                                             '+
            ' ORDER BY CN.IDNUCLEOFAMILIAR, CN.IDCONTRIBUICAO                                              ');
       dtmAPrev.qryContribNucleo.open;

       while not dtmAPrev.qryContribNucleo.Eof do
       begin
          iIdNucleoFamiliar := dtmAPrev.qryContribNucleo.FieldByName('IDNUCLEOFAMILIAR').AsInteger;

          // Prepara e Abre  Consulta dos Beneficiarios a serem processados
          dtmAPrev.qryBenefNucleo.Close;
          dtmAPrev.qryBenefNucleo.sql.text := ' SELECT BTIT.IDNUCLEOFAMILIAR, BF.NUMEROPROCESSO,    BF.IDPESSJUR,       BF.IDPLANOPREV, '+
               'BF.IDTITULAR, '+
               'BF.IDPESSOA,          BF.SEQPROPOSTA,     BF.IDBENEFICIO, '+
               'BF.CODPORTFORMA,      BF.IDSITBENEFICIO,  BF.IDDEPENDENCIA, '+
               'BF.IDTPPAGTOBENEFIC,  BF.VALORATUAL,      BF.DATAREQUERIMENTO, '+
               'BF.DATAINICIO,        BF.DATAFINAL,        '+
               'BF.FLGFORMAPAGTO,     BF.VALORCALCULADO,  BF.DATAULTREAJUSTE, '+
               'BF.VLRCALCINSS,       BF.VLRINFINSS,      BF.DATAINICIOINSS, '+
               'BF.NUMPROCINSS,       BF.DATAINICIOFUND,  BF.VALORCOTAS, '+
               'BF.VALORTOTAL,        BF.DATACONCESSAO,   BF.FLGPROVISORIO, '+
               'BF.PERCPROVISORIO,    BF.PRAZOPROVISORIO, BF.ULTMESREAJUSTE, '+
               'BF.ULTVALORATUALREAJ, BF.IDAGENCIARESGATE,B.NUMORDEMEVENTO, '+
               'B.NOME,               S.DESCRICAO, '+
               'B.FLGRESGATE,         BF.VALORBASE1,   BF.VALORBASE2, '+
               'BF.VALORBASE3,     P.NOME DEPEN,       BTIT.IDRESPONSAVEL, CN.IDCONTRIBUICAO, '+
               'CN.IDNUCLEOFAMILIAR, CN.DATAINICIO,      CN.DATAFINAL,     '+
               'CN.ULTMESPREPARO,  CN.FLGCOBRA,         CTP.IDREGRACALCULO,  CTP.IDPLANOPREV,   '+
               'CTP.IDRUBRICA,      CTP.IDREGRAPRIMPAGTO, CTP.IDREGRAULTPAGTO, CTP.CODPORTFORMA,  '+
               'CTP.FLGDESCFOLHA,   CTP.FLGNAOEXIGEREC,   CON.NOME,            NF.IDRESPNUCLEO    '+
               'FROM   BENEFBFCIARIO BF, BENEFICIO B, BENEFPLANPREV BPL, SITBENEFICIO S, '+
               'BENEFPLANOPART BPART, BFCIARIOTITPLAN BTIT, PESSOA P, TPPAGTOBENEFICIO TP, '+
               'CONTRIBPREVNUCLEO CN, CM.CONTPREV CTP, CM.CONTRIBUICAO CON, CM.NUCLEOFAMILIAR NF '+
               'WHERE  BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+' '+
               'AND    BF.IDPESSOA       = P.IDPESSOA '+
               'AND    B.IDBENEFICIO     = BF.IDBENEFICIO '+
               'AND    BPL.IDBENEFICIO   = BF.IDBENEFICIO '+
               'AND    BPL.IDPLANOPREV   = BF.IDPLANOPREV '+
               'AND    BF.IDSITBENEFICIO = S.IDSITBENEFICIO(+) '+
               'AND    BF.IDTITULAR      = BPART.IDPESSOA(+) '+
               'AND    BF.SEQPROPOSTA    = BPART.SEQPROPOSTA(+) '+
               'AND    BF.IDPESSJUR      = BPART.IDPESSJUR(+) '+
               'AND    BF.IDPLANOPREV    = BPART.IDPLANOPREV(+) '+
               'AND    BF.IDBENEFICIO    = BPART.IDBENEFICIO(+) '+
               'AND    BTIT.IDNUCLEOFAMILIAR = '+dtmAPrev.qryContribNucleo.fieldbyname('IDNUCLEOFAMILIAR').AsString+' '+
               'AND    BF.IDPLANOORIGEM  = BTIT.IDPLANOORIGEM '+
               'AND    BF.IDPLANOPREV    = BTIT.IDPLANOPREV '+
               'AND    BF.IDTITULAR      = BTIT.IDTITULAR '+
               'AND    BF.IDPESSJUR      = BTIT.IDPESSJUR '+
               'AND    BF.IDPESSOA       = BTIT.IDPESSOA '+
               'AND    BF.IDBENEFICIO    = BTIT.IDBENEFICIO '+
               'AND    BF.SEQPROPOSTA    = BTIT.SEQPROPOSTA '+
               'AND    BPL.FLGREFERENCIA = 0  '+
               'AND    TP.IDTPPAGTOBENEFIC = B.IDTPPAGTOBENEFIC '+
               'AND    TP.FLGFREQUENCIA    <> ''U''  '+
               'AND    CN.IDNUCLEOFAMILIAR = BTIT.IDNUCLEOFAMILIAR '+
               'AND    CN.IDCONTRIBUICAO   = '+dtmAPrev.qryContribNucleo.fieldbyname('IDCONTRIBUICAO').AsString+' '+
               'AND    CTP.IDCONTRIBUICAO  = CN.IDCONTRIBUICAO  '+
               'AND    CTP.IDPLANOPREV     = BF.IDPLANOPREV  '+
               'AND    CON.IDCONTRIBUICAO  = CN.IDCONTRIBUICAO   '+
               'AND    NF.IDNUCLEOFAMILIAR = CN.IDNUCLEOFAMILIAR  '+
               'AND    BF.IDSITBENEFICIO   IN (1,2)                '+
               'ORDER BY B.NOME ,  P.NOME ';
          dtmAPrev.qryBenefNucleo.Open;

          // Controle de Primeiro Pagamento
          wPrimeiroPagamento := True;

          if sAnoMesAtual > sAnoMesInicioFaixa then wPrimeiroPagamento := false;

          dtmAPrev.qryBenefNucleo.First;
          dValorPorNucleoContrib     := 0;
          dValorPrevPorNucleoContrib := 0;
          bInserirHistoricoNucleo    := False;

          while not dtmAPrev.qryBenefNucleo.Eof  do  //loop de todos os benef do nucleo/contrib no mês
          begin
             // Testar se é o mesmo núcleo familiar
             // para acumular valor para lançar apenas uma vez no histórico
             dtmAPrev.qryBenefNucleo.Next; //vê se o próximo registro é de uma núcleo ou contribuição diferente
                                           //caso seja, é hora de inserir no histórico e parar de acumular

             if dtmAPrev.qryBenefNucleo.Eof then bInserirHistoricoNucleo := True;
             sIdMotivoAux := IntToStr(iIdMotivoAux);

             if (Not PreparaContribNucleo(dtmAPrev.qryBenefNucleo, dtmAPrev.qryContribNucleo ,QryAux,
                                 iIdNucleoFamiliar,
                                 dtmAPrev.qryBenefNucleo.FieldByName('IDCONTRIBUICAO').AsInteger,
                                 dtmAPrev.qryBenefNucleo.fieldbyname('NUMEROPROCESSO').AsInteger,
                                 dtmAPrev.qryBenefNucleo.fieldbyname('IDPESSJUR').AsInteger,
                                 dtmAPrev.qryBenefNucleo.fieldbyname('IDPLANOPREV').AsInteger,
                                 dtmAPrev.qryBenefNucleo.fieldbyname('IDTITULAR').AsInteger,
                                 dtmAPrev.qryBenefNucleo.fieldbyname('IDPESSOA').AsInteger,
                                 dtmAPrev.qryBenefNucleo.fieldbyname('IDBENEFICIO').AsInteger,
                                 piIdLoteRetemEncerra, sAnoMesPagto,
                                 sAnoMesAtual, wPrimeiroPagamento, sAnoMesAtual,
                                 sAnoMesFinalFaixa,
                                 sIdMotivoAux, 
                                 piIdLoteRetemEncerra ) )then
             begin
                sMsgErro := 'Erro ao calcular acerto de contribuições do nucleo familiar';
                Exit;
             end;
          end;

          dtmAPrev.qryContribNucleo.next;

       end; //while qryContribNucleo

       bAcertoPorEncerramentoNucleo := False;

       sAnoMesAtual := ProximoAnoMes(StrToInt(Copy(sAnoMesAtual, 6,2)), StrToInt(Copy(sAnoMesAtual, 1,4)));
   end;

   // **************************************************************************
   // **************************************************************************
   // 2. Acertar valores de ABONO do beneficiário que ficou no processo
   // --------------------------------------------------------------------------

   Result := True;
end; // AcertaBeneficioNoMes


Function ProcessaAcertosRetemEncerra( qry, qryAux,
                                      qryBenefRecalculados : TwwQuery;
                                      cRetemEncerra        : Char;
                                      psInscricaoNumero, psMatricula, psCalculaTodoMes,  psDataInicio,
                                      sNovaDataFinal,    psUltMesReajuste     : string;
                                      piNumeroProcesso,  piIdBeneficio,      piIdPessJur,
                                      piIdPlanoPrev,     piIdTitular,        piIdBeneficiario,
                                      piSeqProposta,     piIdRegraUltPagto,  piIdRegraCalculo     : longint;
                                      prValorAtual      : double;
                                      pbBenefReferencia : boolean;
                                      piIdEventoGerador : integer;
                                      psFlgIntEvento    : string;
                                      pbFlgEncerraFale  : boolean;
                                      piIdLoteRetemEncerra : longint;
                                      pbApenasMudouPrevistaParaEfetiva : boolean;
                                      var sMsgErro      : string;
                                      psDataPrevistaAnt : string
                                      ) : boolean;

Var
    sSQL,            sWhereSQLRegra, sAliasSQLRegra, sSQLRegra,       sNome,
    sNovoAnoMesReaj, sAnoMesPagto,   sDataFolha,     sIdRegraCalculo, sDataPagamento,
    sValorIntegral,  sValorTotal,    sSalPart,       sValorRateado,   sIdSitPart : String;
    bTeveContribNoMesDoEncerramento, bTeveContribNoAnoDoEncerramento, bEhAntecipacao,
    bDevolveuContrib, bReajustou, bErro, bPagaAbono, bDevolverAdiantamento : Boolean;
    dValorBase1,      dValorBase2,    dValorBase3,     rValorIntegral,
    rValorRateado,    rValorTotal,    rDevolucao,      dValorAcerto : Double;
    iCodPortForma,    piIdLoteContrib,
    iIdPessoaHstContrib, iOrigem,     iIdRegraAbono,   iIdMotivoAux,
    iSeqBeneficio,       iTipoDevolucao : Integer;
    iFlgDataPrevista, iDifDias : Word;
    dValorPago, dValorDevolver, dPercentual, dValorTotal,  dValorTotalOriginal : Double;
    sAnoMesInicioFaixa,  sAnoMesFinalFaixa,   sAnoMesAposInicioFaixa ,  sAnoMesAtual,
    sFlgDevolucao,       sValorInteiro,       sUltAnoMesAbono,          sAnoMesBuscaAbono,
    sAnoMesRefAbono,     sAnoMesInicioAbono,  sAnoMesFinalAbono,        sAnoMesAtualAbono : String;
    cTipoAbono : Char;  { A - Final do Ano e B - Binal do Beneficio }
    rValorAtualOriginal, rValorAbono, rValorAbonoJaPago, dValorPrevAntesMinimo, dValorDepoisMinimo  : Double;
    sDataEvento, sAnoMesMinimoAbono, sIdLote, sPlanoOrigem, sVlInfoINSS : String;
    dValorDevido, dValorSRBRetorno    : Double;
    // edilaine - SOL 253577-17541 / PPM 978024 - inicio
    rValorBS, rValorFAB, rValorDeficit : double;                          
    sValorBS, sValorFAB, sValorDeficit : string;                          
    rVlrBSAbono, rVlrFABAbono, rVlrDeficitAbono : double;
    sVlrBSAbono, sVlrFABAbono, sVlrDeficitAbono : string;                 
    rVlrDepoisMinBS, rVlrDepoisMinFAB, rVlrDepoisMinDeficit : double;
    sVlrCalcInss, sDibAnt, sVlrBenefAnt, sIdDependencia, sPercent : string;  
    // edilaine - SOL 253577-17541 / PPM 978024 - fim
    sFlgSituacao,
    sFolhaOrigem, sDataInicioPreparoContrib, sFlagProvisorio, StrConcedidos, sMesAbono : String;
    QryAux2 : TwwQuery;
    sFlgEnviado: Integer; //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
Begin

  Result        := False;
  dPercentual   := 0;

  If cRetemEncerra = 'E' Then iOrigem := 4 Else iOrigem := 8;


  FazQuery( QryAux, ' SELECT BFC.FLGPROVISORIO, BFC.IDPLANOORIGEM,  '+
                    '        BFC.FONTEPAGADORA, BFT.PERCENTUAL      '+
                    ' FROM BENEFBFCIARIO BFC, BFCIARIOTITPLAN BFT '+
                    ' WHERE (BFC.IDPESSJUR      ='+ IntToStr(piIdPessJur)     +')'+
                    '   AND (BFC.IDPLANOPREV    ='+ IntToStr(piIdPlanoPrev)   +')'+
                    '   AND (BFC.IDTITULAR      ='+ IntToStr(piIdTitular)     +')'+
                    '   AND (BFC.SEQPROPOSTA    ='+ IntToStr(piSeqProposta)   +')'+
                    '   AND (BFC.IDPESSOA       ='+ IntToStr(piIdBeneficiario)+')'+
                    '   AND (BFC.IDBENEFICIO    ='+ IntToStr(piIdBeneficio)   +')'+
                    '   AND (BFC.NUMEROPROCESSO ='+ IntToStr(piNumeroProcesso)+')'+
                    '   AND (BFC.IDPESSJUR      = BFT.IDPESSJUR)   '+
                    '   AND (BFC.IDPLANOPREV    = BFT.IDPLANOPREV) '+
                    '   AND (BFC.IDTITULAR      = BFT.IDTITULAR)   '+
                    '   AND (BFC.SEQPROPOSTA    = BFT.SEQPROPOSTA) '+
                    '   AND (BFC.IDPESSOA       = BFT.IDPESSOA)    '+
                    '   AND (BFC.IDBENEFICIO    = BFT.IDBENEFICIO) ' );

  sFlagProvisorio := qryAux.FieldByName('FLGPROVISORIO').AsString;
  dPercentual     := qryAux.FieldByName('PERCENTUAL').AsFloat;

  rValorAtualOriginal := prValorAtual;

  if piIdBeneficio <= 0 then
  begin
    Result := True;
    Exit;
  end;

  sMsgErro      := '';

  If cRetemEncerra = 'E'
  Then sNome := 'Encerramento de Benefício'
  Else sNome := 'Retenção de Benefício';

  If (pbFlgEncerraFale) Then
  begin

    if (piIdTitular = piIdBeneficiario) then
    begin
      // Se o parametro prmFLGENVACERTOFALEC for TRUE e o lote for > 0 entao jogar no motivo normal
      // pois significa que a fundação acerta o beneficio diretamente na conta do participante

      if (prmFlgTipoAcertoFL = 1) or (prmFLGENVACERTOFALEC) then
      begin
        if prmIdMotivoAcertoFL <= 0 then
        begin
          sMsgErro := 'Motivo para Acerto Pós-Morte na Conta do Participante não preenchido.';
          Exit;
        end;

        iIdMotivoAux := prmIdMotivoAcertoFL;
        sFolhaOrigem := '';
      end
      else
      begin
        if prmIdMotDevolNaoIden <= 0 then
        begin
          sMsgErro := 'Motivo para Pagamento com Recebedor não Identificado não preenchido.';
          Exit;
        end;

        iIdMotivoAux := prmIdMotDevolNaoIden;
        sFolhaOrigem := 'B'; 
      end
    end
    else begin // Para beneficiário deve ter motivo não identificado (CBS)
      iIdMotivoAux := prmIdMotDevolNaoIden;
      sFolhaOrigem := 'B';
    end;
  End
  Else
  Begin
    iIdMotivoAux := prmIdMotivoDevolBen;
  End; { If (pbFlgEncerraFale) }

  // *********************************************************************************************
  // ***************************  TRATAR BENEFICIOS
  // *********************************************************************************************
  // Verificar benefícios dentro da faixa de meses que precisa de acerto
  // 0. Faixa de Verificacao : sAnoMesInicioFaixa = mes da retencao
  //                           sAnoMesFinalFaixa  = mes atual
  // 1. Calcular valor rateado e integral para acertos a seguir
  // 2. Verificar possiveis problemas para o MES DA RETENCAO
  //    2.1 Se Data da Retencao = Ultimo Dia do Mes
  //        Entao 2.1.1. Pagar Beneficio Integral
  //              2.1.2. Verificar se beneficio já está no historico (preparado)
  //              2.1.3. Se nao estiver, entao inserir beneficio no historico
  //    2.2 Se Data da Retencao = Meio do Mes
  //        Entao 2.2.1. Pagar pro-rata
  //              2.2.2. Verificar se benefício já existe no histórico
  //              2.2.3. Se existir
  //                     Entao 2.2.3.1. Verificar se benefício já foi pago
  //                           2.2.3.2. Se benefício já pago Entao inserir uma devolucao
  //                           2.2.3.3. Se benefício na previa Entao inserir uma devolucao
  //                           2.2.3.4. Se beneficio preparado Entao desfazer preparo do valor
  //                                    integral e inserir valor pro-rata
  // 3. Verificar possiveis problemas para os MESES APOS O MES DA RETENCAO
  //    3.1 Para cada mes apos o mes da retencao fazer :
  //        3.1.1. Verificar se benefício já foi pago
  //        3.1.2. Se benefício já pago Entao inserir uma devolucao
  //        3.1.3. Se benefício na previa Entao inserir uma devolucao
  //        3.1.4. Se beneficio preparado Entao desfazer preparo do valor integral

  // 0. Faixa de Verificacao : sAnoMesInicioFaixa = mes da retencao
  //                           sAnoMesFinalFaixa  = mes atual
  sAnoMesInicioFaixa := Copy(sNovaDataFinal,7,4)+'/'+Copy(sNovaDataFinal,4,2);

  sAnoMesFinalFaixa  := Copy(FormatDateTime('dd/mm/yyyy', date),7,4) + '/' +      
                        Copy(FormatDateTime('dd/mm/yyyy', date),4,2);             

  // Testar se lote está preenchido, pois para encerramento por falecimento o lote será -1
  if piIdLoteRetemEncerra > 0 then
  begin
    sIdLote := IntToStr(piIdLoteRetemEncerra);

    with qryAux do
    begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT DATAPREPARO, DATAPAGAMENTO, MESREFERENCIA FROM CTRLINTERFACE WHERE IDLOTE = '+IntToStr(piIdLoteRetemEncerra));
      Open;

      if not IsEmpty then
      begin
        // A data tem que ser do calendário
        sAnoMesPagto   := FieldByName('MESREFERENCIA').AsString;
        sDataPagamento := FieldByName('DATAPAGAMENTO').AsString; 
        sDataFolha := CriticaDataCobrancaSit( QryAux, IntToStr(iIdFundacao), '', 'AS', 'P',
                                              Copy(sAnoMesPagto,6,2),
                                              Copy(sAnoMesPagto,1,4) );

      end
      else begin
        sDataFolha := CriticaDataCobrancaSit( qryAux,IntToStr(iIdFundacao), '', 'AS',
                                              'P',Copy(sAnoMesFinalFaixa,6,2), Copy(sAnoMesFinalFaixa,1,4) );

        if Trim(sDataFolha) = '' Then sDataFolha := FormatDateTime('dd/mm/yyyy', date); 

        sAnoMesPagto   := Copy(sDataFolha,7,4) + '/' + Copy(sDataFolha,4,2);
        sDataPagamento := sDataFolha;
      end;

      if Trim(sDataFolha) = '' then sDataFolha := FormatDateTime('dd/mm/yyyy', date);   

    end; { with qryAux do }

  end
  else
  begin

    sIdLote := 'NULL';
    sDataFolha := CriticaDataCobrancaSit( qryAux,IntToStr(iIdFundacao),'', 'AS',
                                          'P',Copy(sAnoMesFinalFaixa,6,2), Copy(sAnoMesFinalFaixa,1,4) );

    if Trim(sDataFolha) = ''   then sDataFolha := FormatDateTime('dd/mm/yyyy', date); 

    sAnoMesPagto := Copy(sDataFolha,7,4) + '/' + Copy(sDataFolha,4,2);

    if Trim(sDataFolha) = ''   then sDataFolha := FormatDateTime('dd/mm/yyyy', date); 

  end;



  // 1. Calcular valor rateado e integral para acertos a seguir
  // Verificar se teve reajuste apos o final do beneficio
  // Se sim, o sistema deve desreajustar o beneficio para o valor correspondente
  //         ao último mês

  qryAux.Close;
  qryAux.SQL.Clear;
  if pbBenefReferencia
  then qryAux.SQL.Add( ' SELECT IDRGREAJ      '+
                       ' FROM   REAJINSS '+
                       ' WHERE  MESREAJ     > '''+sAnoMesInicioFaixa+''''+
                       ' AND    MESREAJ     <= '''+sAnoMesFinalFaixa +'''' )

  else qryAux.SQL.Add( ' SELECT IDRGREAJ, FLGREAJSRB      '+
                       ' FROM   REAJBENECFICIO '+
                       ' WHERE  MESREAJ     > '''+sAnoMesInicioFaixa+''''+
                       ' AND    MESREAJ     <= '''+sAnoMesFinalFaixa +''''+
                       ' AND    IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+
                       ' AND    IDBENEFICIO = '+IntToSTr(piIdBeneficio) );
  qryAux.Open;

  If ( Not qryAux.IsEmpty ) Then
  begin

    // Buscar opcoes do beneficio para passar para a regra de reajuste
    with qryAux do
    begin

      Close;
      SQL.Clear;

      If piIdTitular = piIdBeneficiario Then
        SQL.Add(' SELECT VALORBASE1, VALORBASE2, VALORBASE3 FROM BENEFPLANOPART '+
                ' WHERE  IDPESSJUR    = '+IntToStr(piIdPessJur)+
                ' AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                ' AND    IDPESSOA     = '+IntToStr(piIdBeneficiario)+
                ' AND    SEQPROPOSTA  = '+IntToStr(piSeqProposta)+
                ' AND    IDBENEFICIO  = '+IntToStr(piIdBeneficio) )
      Else
        SQL.Add(' SELECT VALORBASE1, VALORBASE2, VALORBASE3 FROM BENEFBFCIARIO '+
                ' WHERE  IDPESSJUR    = '+IntToStr(piIdPessJur)+
                ' AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                ' AND    IDTITULAR    = '+IntToStr(piIdTitular)+
                ' AND    IDPESSOA     = '+IntToStr(piIdBeneficiario)+
                ' AND    SEQPROPOSTA  = '+IntToStr(piSeqProposta)+
                ' AND    IDBENEFICIO  = '+IntToStr(piIdBeneficio) );
      Open;

      if not IsEmpty then
      begin
        dValorBase1 := FieldByName('VALORBASE1').AsFloat;
        dValorBase2 := FieldByName('VALORBASE2').AsFloat;
        dValorBase3 := FieldByName('VALORBASE3').AsFloat;
      end
      else
      begin
        dValorBase1 := 0;
        dValorBase2 := 0;
        dValorBase3 := 0;
      end;

    end; { with qryAux do }

    // Teve reajuste apos o ultimo mes. Logo o valor atual que está na benefbfciario
    // é um valor reajustado. E o ultimo valor antes do reajuste nao necessariamente
    // é o valor que queremos pois podem ter havido vários reajustes.

    // SOMAR TODOS OS VALORES PAGOS INDEPENDENTE DO MOTIVO POIS PODEM HAVER RETROATIVOS
    // esta não é a melhor forma de resolver pois se for um VALORPREV pró-rata, estará pegando o valor errado, sendo que se pegar pelo VALORINTEGRAL estará somando valores errados também
    FazQuery( QryAux, ' SELECT SUM(DECODE(FLGDEVOLUCAO,1,-VALORPREV,VALORPREV)) as VALORPREV '+
                      ' FROM   HSTBENEFBFCIARIO '+
                      ' WHERE  (IDPESSOA       = '+IntToStr(piIdBeneficiario)          +')'+
                      ' AND    (MESREFERENCIA  = '''+sAnoMesInicioFaixa          +''')'+
                      ' AND    (IDBENEFICIO    = '+IntToStr(piIdBeneficio)       +')'+
                      ' AND    (NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)    +')' );

    if (not qryAux.IsEmpty) and (qryAux.FieldByName('VALORPREV').AsFloat > 0) then prValorAtual := qryAux.FieldByName('VALORPREV').AsFloat;

    // Ver qual foi o ultimo reajuste antes da data de encerramento e depois
    // da data de inicio e atualizar a benefbfciario
    qryAux.Close;
    qryAux.SQL.Clear;
    if pbBenefReferencia
    then qryAux.SQL.Add(' SELECT MAX(MESREAJ) AS MESREAJ   '+
                        ' FROM   REAJINSS      '+
                        ' WHERE  MESREAJ     <= '''+sAnoMesInicioFaixa +'''')
    else qryAux.SQL.Add(' SELECT MAX(MESREAJ) AS MESREAJ    '+
                        ' FROM   REAJBENEFICIO '+
                        ' WHERE    MESREAJ     <= '''+sAnoMesInicioFaixa +''''+
                        ' AND    IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+
                        ' AND    IDBENEFICIO = '+IntToSTr(piIdBeneficio));
    qryAux.Open;

    if (not qryAux.IsEmpty) and (qryAux.FieldByName('MESREAJ').AsString <> '')
    then sNovoAnoMesReaj := qryAux.FieldByName('MESREAJ').AsString
    else sNovoAnoMesReaj := '0000/00';

    qryAux.Close;
    qryAux.SQL.Clear;

    qryAux.SQL.Add(' UPDATE BENEFBFCIARIO SET ULTVALORATUALREAJ = '+OraNumero(FloatToStr(prValorAtual))+','+
                   '        VALORATUAL     = '+OraNumero(FloatToStr(prValorAtual))+','+
                   '        ULTMESREAJUSTE = '''+Trim(sNovoAnoMesReaj)+''''+
                   ' WHERE  IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
                   ' AND    IDPESSJUR      = '+IntToStr(piIdPessJur)+
                   ' AND    IDTITULAR      = '+IntToStr(piIdTitular)+
                   ' AND    NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
                   ' AND    IDBENEFICIO    = '+IntToSTr(piIdBeneficio)+
                   ' AND    IDPESSOA       = '+IntToStr(piIdBeneficiario)+
                   ' AND    SEQPROPOSTA    = '+IntToStr(piSeqProposta));
    try
      qryAux.ExecSQL;
    except
      sMsgErro := sNome+' : Erro ao desreajustar o benefício. ';
      Exit;
    end;

  End; { If ( Not qryAux.IsEmpty ) }

  FazQuery( QryAux, ' SELECT MESREFERENCIA, VALORTOTAL, VALORINTEGRAL, '+
                    '        VALORBS, VALORFAB, VLRBASEDEFICIT,  '+   // edilaine - SOL 253577-17541 / PPM 978024
                    '        VALORSRB '+
                    ' FROM HSTBENEFBFCIARIO '+
                    ' WHERE  IDPESSOA        = '+IntToStr(piIdBeneficiario)+
                    ' AND    MESREFERENCIA   <= '''+sAnoMesInicioFaixa+''''+
                    ' AND    IDBENEFICIO     = '+IntToStr(piIdBeneficio)+
                    ' AND    NUMEROPROCESSO  = '+IntToStr(piNumeroProcesso)+
                    ' AND    VALORINTEGRAL > 0 '+
                    ' ORDER BY MESREFERENCIA DESC, DTEFETPGTO DESC, DATAPAGAMENTO DESC ' );

  If ( Not qryAux.IsEmpty ) Then
  Begin

    If piIdTitular = piIdBeneficiario
    Then rValorIntegral := qryAux.FieldbyName('VALORINTEGRAL').AsFloat
    Else rValorIntegral := qryAux.FieldbyName('VALORTOTAL').AsFloat;

    dValorTotalOriginal := qryAux.FieldbyName('VALORTOTAL').AsFloat;
    sValorIntegral      := OraNumero(FloatToStr(rValorIntegral));
    dValorSRBRetorno    := qryAux.FieldbyName('VALORSRB').AsFloat;

    // edilaine - SOL 253577-17541 / PPM 978024 - inicio
    sValorBS         := QryAux.FieldByName('VALORBS').AsString;
    sValorFAB        := QryAux.FieldByName('VALORFAB').AsString;
    sValorDeficit    := QryAux.FieldByName('VLRBASEDEFICIT').AsString;
    // edilaine - SOL 253577-17541 / PPM 978024 - fim

  End
  Else
  Begin

    rValorIntegral      := prValorAtual;
    sValorIntegral      := OraNumero(FloatToStr(prValorATual));
    dValorTotalOriginal := prValorAtual;
    dValorSRBRetorno    := 0;

    // edilaine - SOL 253577-17541 / PPM 978024 - inicio
    {busca valores}
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add(' SELECT BFC.FLGPROVISORIO, BFC.IDPLANOORIGEM,  '+
                   '        BP.FLGAPRESENTABSFAB, BP.FLGAPRESENTADEFICIT, '+
                   '        BFC.VLRFABATUAL, BFC.VLRBSATUAL, BFC.VLRBASEDEFICIT '+
                   '   FROM BENEFBFCIARIO BFC, BENEFPLANPREV BP '+
                   '  WHERE BFC.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
                   '    AND BFC.IDPESSJUR      = '+IntToStr(piIdPessJur)+
                   '    AND BFC.IDTITULAR      = '+IntToStr(piIdTitular)+
                   '    AND BFC.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
                   '    AND BFC.IDBENEFICIO    = '+IntToSTr(piIdBeneficio)+
                   '    AND BFC.IDPESSOA       = '+IntToStr(piIdBeneficiario)+
                   '    AND BFC.SEQPROPOSTA    = '+IntToStr(piSeqProposta) +
                   '    AND BFC.IDPLANOPREV    = BP.IDPLANOPREV '+
                   '    AND BFC.IDBENEFICIO    = BP.IDBENEFICIO ');
    qryAux.Open;

    sValorBS         := QryAux.FieldByName('VLRBSATUAL').AsString;
    sValorFAB        := QryAux.FieldByName('VLRFABATUAL').AsString;
    sValorDeficit    := QryAux.FieldByName('VLRBASEDEFICIT').AsString;
    // edilaine - SOL 253577-17541 / PPM 978024 - fim

  End;
  qryAux.close;   // edilaine - SOL 253577-17541 / PPM 978024

  // Verificar se teve reajuste no ultimo mes
