        SQL.Clear;
        // edilaine - SIG 85197 - inicio
        SQL.Add(' SELECT B.BSDIB, B.FABDIB, B.VLRFABTOTAL, B.VLRBSTOTAL, B.VLRBASEDEFICIT, B.DATAINICIO ' +
                '        , B.VALORNADIB, HB.VALORTOTAL ' +
                ' FROM   BENEFBFCIARIO B '+
                ' JOIN   HSTBENEFBFCIARIO HB ON HB.IDPESSOA = B.IDPESSOA   ' +
                '                           AND HB.IDTITULAR = B.IDTITULAR ' +
                '                           AND HB.IDPLANOPREV = B.IDPLANOPREV '+
                '                           AND HB.IDPESSJUR   = B.IDPESSJUR   '+
                '                           AND HB.SEQPROPOSTA = B.SEQPROPOSTA '+
                '                           AND HB.IDBENEFICIO = B.IDBENEFICIO '+
                '                           AND HB.MESREFERENCIA = TO_CHAR(B.DATAINICIO, ''YYYY/MM'') '+
                ' WHERE  B.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
                ' AND    B.IDPESSOA       = '+IntToStr(piIdBeneficiario)+
                ' AND    B.IDBENEFICIO    = '+IntToStr(piIdBeneficio)
                );
        Open;

        if (not IsEmpty) and (bCalcVlrTotal) then
        begin
          rVlrTotal :=  FieldByName('VALORTOTAL').AsFloat;
          rVlrAtual :=  FieldByName('VALORNADIB').AsFloat;
        end;
        // edilaine - SIG 85197 - inicio


        If (not IsEmpty) and (qryAux.FieldByName('DATAINICIO').AsFloat >= StrToDate(psDataInicio)) Then    //edilaine - SIG94608
        Begin
           sVlrTotalBS    := FieldByName('BSDIB').AsString;
           sVlrTotalFab   := FieldByName('FABDIB').AsString;
           sVlrDeficit    := FieldByName('VLRBASEDEFICIT').AsString;
           Close;
           Exit;
        End;

        if (not IsEmpty) and (FieldByName('VALORTOTAL').AsFloat > 0) then
        begin
           sVlrTotalBS   := FieldByName('VLRBSTOTAL').AsString;
           sVlrTotalFab  := FieldByName('VLRFABTOTAL').AsString;
           sVlrDeficit   := FieldByName('VLRBASEDEFICIT').AsString;
           Close;
           Exit;
        end;
     end;

   finally
     // edilaine - SIG 85197 - inicio
     if bCalcVlrTotal then
     begin
       if sVlrTotalBS <> '' then
       begin
         rValor := StrToFloat(sVlrTotalBS);
         rValor := Arredonda(rValor / rVlrAtual * rVlrTotal, 2);
         sVlrTotalBS := FloatToStr(rValor);
       end;

       if sVlrTotalFab <> '' then
       begin
         rValor := StrToFloat(sVlrTotalBS);
         rValor := Arredonda(rVlrTotal - rValor, 2);
         sVlrTotalFab := FloatToStr(rValor);
       end;

       if sVlrDeficit <> '' then
       begin
         rValor := StrToFloat(sVlrDeficit);
         rValor := Arredonda(rValor / rVlrAtual * rVlrTotal, 2);
         sVlrDeficit := FloatToStr(rValor);
       end;
     end;
     // edilaine - SIG 85197 - fim

   end;
end;
