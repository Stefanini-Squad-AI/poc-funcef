function VerificaSePagaAbonoParticip( qryAux : TwwQuery;
                              piIdPlanoPrev, piIdBeneficio : longInt;
                              psDataInicio,  psDataFinal   : string;
                              var piIdRegraAbono           : longint;
                              var pcTipoAbono              : char; // A - final do Ano e B - final do Beneficio
                              var bErro                    : boolean;
                              var sMsgErro                 : string) : boolean;
begin
   Result         := False;
   bErro          := False;
   sMsgErro       := '';
   piIdRegraAbono := -1;
   pcTipoAbono    := ' ';

   qryAux.Close;
   qryAux.SQL.Clear;
   qryAux.SQL.Add(' SELECT FLGABONOFINALBEN, FLGPOSSUIABONO, IDREGRACALCABONO '+
                  ' FROM   BENEFPLANPREV '+
                  ' WHERE  IDBENEFICIO = '+IntToStr(piIdBeneficio)+
                  ' AND    IDPLANOPREV = '+IntToStr(piIdPlanoPrev) );
   qryAux.Open;

   if qryAux.IsEmpty then Exit; // Nao pagar abono

   if qryAux.FieldByName('flgPossuiAbono').AsString = '0'
   then Exit; // Nao possui abono

   // Possuindo abono, verificar o tipo de abono ( final do ano, final do beneficio )
   if qryAux.FieldByName('flgAbonoFinalBen').AsString = '1'
   then begin // Possui abono no final do beneficio
      pcTipoAbono := 'B';
   end
   else begin // Possui beneficio no final do ano
     pcTipoAbono := 'A';
   end;

   if qryAux.FieldByName('IdRegraCalcAbono').AsString = ''
   then begin
      Exit;
   end
   else piIdRegraAbono := qryAux.FieldByName('IdRegraCalcAbono').AsInteger;

   Result := True;
end; // VerificaSePagaAbonoParticip

function VerificaSePagaAbonoBfciario( qryAux : TwwQuery;
                                      piIdPessJur, piIdPlanoPrev,
                                      piIdTitular, piSeqProposta,
                                      piIdPessoa,
                                      piIdBeneficioBfciario      : longInt;
                                      psDataInicio,  psDataFinal : string;
                                      var piIdRegraAbono         : longint;
                                      var prValorBenefTitular    : double;
                                      var pcTipoAbono            : char; // A - final do Ano e B - final do Beneficio
                                      var bErro                  : boolean;
                                      var sMsgErro               : string) : boolean;
var iAnoAtual,
    iIdBenefTitular      : longint;
    sValorUltBenef,
    sIdTpPagtoAnt,
    sFlgBenefMinimo,
    sAnoMesRef,
    sNomeBeneficio       : string;
    sDataInicioAnt         : string; 
begin
   Result := False;
   prValorBenefTitular := 0;
   pcTipoAbono    := 'B'; // dizer que é no final do beneficio pois será no final
                          // do peculio (que é pagamento unico)

   // Verificar se participante tinha beneficio
   // Se participante tinha beneficio e beneficio do participante pagava abono
   // Entao Se beneficio do bfciario = peculio
   //       Entao pagar abono
   //       Senao nao pagar abono
   // Senao Nao pagar abono
   sAnoMesRef     := Copy(psDataInicio,7,4)+'/'+Copy(psDataInicio,4,2);
   sValorUltBenef := OraNumero(CalcUltimoBeneficio(piIdPessJur,
                                                   piIdPlanoPrev,
                                                   piIdTitular,
                                                   piIdBeneficioBfciario,
                                                   psDataInicio,
                                                   'B',
                                                   sIDTPPAGTOANT,
                                                   sFlgBenefMinimo,
                                                   sDataInicioAnt , 
                                                   qryAux));
   if StrToFloat(ClienteNumero(sValorUltBenef)) > 0
   then begin // Participante tinha beneficio
      // Verificar se beneficio é peculio
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(' SELECT FLGPECULIO FROM BENEFICIO '+
                     ' WHERE  IDBENEFICIO = '+IntToStr(piIdBeneficioBfciario));
      qryAux.Open;
      if qryAux.IsEmpty
      then Result := False
      else if qryAux.FieldByName('FlgPeculio').AsString = '0'
           then Result := False
           else Result := True;
      if Result then prValorBenefTitular := StrToFloat(ClienteNumero(sValorUltBenef));
   end
   else begin // Participante nao tinha beneficio
      Result := False;
   end;

   if Result
   then begin
      iAnoAtual := StrToInt(Copy(FormatDateTime('dd/mm/yyyy', date),7,4));

      // Verificar qual era o beneficio
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(' SELECT BF.IDBENEFICIO, B.NOME  '+
                     ' FROM BENEFBFCIARIO BF, BENEFICIO B '+
                     ' WHERE  (BF.IDPESSJUR   = '+IntToStr(piIdPessJur)+')'+
                     ' AND    (BF.IDPLANOPREV = '+IntToStr(piIdPLANOPREV)+')'+
                     ' AND    (BF.IDPESSOA    = '+IntToStr(piIdTitular)+')'+
                     ' AND    (BF.IDTITULAR   = '+IntToStr(piIdTitular)+')'+
                     ' AND    (BF.DATAINICIO  <= TO_DATE('''+psDataInicio+''',''dd/mm/yyyy'')) '+
                     ' AND    ((BF.DATAFINAL IS NULL) OR '+
                     '         (BF.DATAFINAL  >= TO_DATE('''+psDataInicio+''',''dd/mm/yyyy''))) '+
                     ' AND    (BF.IDBENEFICIO = B.IDBENEFICIO) ');
      qryAux.Open;
      if qryAux.IsEmpty
      then begin
         bErro    := True;
         sMsgErro := 'Benefício do Titular não encontrado. Verifique. ';
         qryAux.Close;
         Exit;
      end;

      iIdBenefTitular := qryAux.FieldByName('IdBeneficio').AsInteger;
      sNomeBeneficio  := qryAux.FieldByName('Nome').AsString;

      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(' SELECT IDREGRACALCABONO FROM BENEFPLANPREV '+
                     ' WHERE  IDBENEFICIO = '+IntToStr(iIdBenefTitular)+
                     ' AND    IDPLANOPREV = '+IntToStr(piIdPlanoPrev) );
      qryAux.Open;
      if qryAux.IsEmpty
      then begin
         bErro    := True;
         sMsgErro := 'O beneficiário tem direito ao abono do '+sNomeBeneficio+'. '+
                     'Porém este benefício não foi encontrado no cadastro de Benefícios do Plano. '+
                     'Verifique. ';

         qryAux.Close;
         Exit;
      end;

      if qryAux.FieldByName('IdRegraCalcAbono').AsString = ''
      then begin
         bErro    := True;
         sMsgErro := 'O beneficiário tem direito ao abono do '+sNomeBeneficio+'. '+
                     'Porém a Regra de Cálculo para este abono não está cadastrada. '+
                     'Verifique. ';
         qryAux.Close;
         Exit;
      end;
      piIdRegraAbono := qryAux.FieldByName('IdRegraCalcAbono').AsInteger;
   end;
end; // VerificaSePagaAbonoBfciario


Function  ExecutaRegraValorAbono( QryAux : TwwQuery;

                                  piIdRegraCalculo, piIdPessJur,
                                  piIdPlanoPrev,    piIdTitular,
                                  piSeqProposta,    piIdPessoa,
                                  piIdBeneficio : LongInt;

                                  psDataInicio, psDataFinal,
                                  psAnoMesAtual : String;

                                  prValorBenef    : double;

                                  psFlgProvisorio : String;

                                  Var bErro       : boolean;
                                  Var sMsgErro    : String;

                                  Var piIdCalculo   : LongInt;

                                  piTipoMov         : Word;
                                  piNumBenef        : Integer;
                                  psDataInicioFund  : String = '';
                                  pdValorTotalBenef : Double = 0;
                                  psAnoMesLote      : String = ' ' ) : Double;
var
  sSQL,
  sDataInicio, sDataFinal,
  sAnoMesReferencia,
  sValorAbono             : string;
  dValorBenefRateado, dValorAbonosPagos, rValorAbono             : double;
  // Dados necessários do benefício anterior
  sDataInicioAnt,  // var. auxiliar apenas para passar para a funcao. A var. utilizada é a psDataInicioAnt
  sValorAnt,       // var. auxiliar apenas para passar para a funcao. A var. utilizada é a psValorBenefAnt
  sNomeBenefAnt,
  sIdTpPagtoAnt,
  sFlgBenefMinAnt,
  sDataEventoAnt,
  sCodBeneficioAnt,
  sNumProcINSS,
  sUltMesReajAnt,
  sValorBase1Ant,
  sValorBase2Ant,
  sValorBase3Ant,  sFlgBenefMinimo,
  sDataInicioInss, sVlrInfINSS, sVlrCalcINSS,
  sDataInicioFund    : string;
  bReferencia : Boolean;
  iDiaInicio, iDiaFim, iMesInicio, iMesFim, iAnoInicio, iAnoFim : Integer;
  sDataInicioPesquisa, sDataFimPesquisa : String;
  sDataInscricaoPart    : string;

  sDataRef : String;

begin
  Result := -1;
  if piIdRegraCalculo <= 0 then Exit;

  // Para a regra de calculo, DATAINICIO = DIB - DATA DE DIREITO = (QUASE SEMPRE) DATA DO EVENTO
  //                          DATAREF    = DATA DO EVENTO
  sDataInicio := psDataInicio;
  sDataFinal  := psDataFinal;
  sDataInicioFund := psDataInicioFund;

  sDataInicioInss := '';

  sAnoMesReferencia := Copy(psAnoMesAtual,1,4)+'/13';

  if Trim(sDataInicio) = '' then sDataInicio := FormatDateTime('dd/mm/yyyy', Date);

  // Se a data final estiver em branco, é porque o benefício é vitalício
  // ou não acabou no ano ainda, então passar a data do ultimo dia do ano
  if Trim(sDataFinal) = '' then sDataFinal := '31/12/'+Copy(sAnoMesReferencia,1,4);

  // Se não for RENOVA e Se o beneficio for de referencia e o parametro
  //    flgdataabono estiver como 1
  // Entao passar como data de inicio a data da suplementacao e não do inss
     qryAux.Close;
     qryAux.SQL.Clear;
     qryAux.SQL.Add(' SELECT BP.FLGREFERENCIA, BP.FLGDATAABONO                    '+
                    ' FROM   BENEFPLANPREV BP                                     '+
                    ' WHERE  BP.IDPLANOPREV = '+IntToStr(piIdPlanoPrev)            +
                    ' AND    BP.IDBENEFICIO = '+IntToStr(piIdBeneficio)            );
     qryAux.Open;

     bReferencia := (qryAux.FieldByName('FLGREFERENCIA').AsInteger = 1);


     if bReferencia   and (qryAux.FieldbyName('FLGDATAABONO').AsInteger = 1)
     then begin
        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add(' SELECT BF.DATAINICIOFUND, BF.DATAINICIOINSS, BP.FLGDATAABONO, PP.INSCRICAODATA, '+ 
                       '        PP.DATAOPCAOIR, PP.TIPOOPCAOIR ' +   
                       ' FROM   BENEFBFCIARIO BF,BENEFPLANPREV BP, BENEFICIO B,       '+
                       '        PARTPREVPLAN PP                                       '+ 
                       ' WHERE  BF.IDPESSJUR      = '+IntToStr(piIdPessJur)          +
                       ' AND    BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)        +
                       ' AND    BF.IDTITULAR      = '+IntToStr(piIdTitular)          +
                       ' AND    BF.IDPESSOA       = '+IntToStr(piIdPessoa)           +
                       ' AND    BF.IDBENEFREFEREN = '+IntToStr(piIdBeneficio)        +
                       ' AND    BP.IDPLANOPREV    =  BF.IDPLANOPREV                ' +
                       ' AND    BP.IDBENEFICIO    =  BF.IDBENEFICIO                ' +
                       ' AND    TO_CHAR(BF.DATAINICIO,''YYYY/MM'') <= '''+psAnoMesAtual+''''+
                       ' AND    ((BF.DATAFINAL IS NULL) OR (TO_CHAR(BF.DATAFINAL,''YYYY/MM'') >= '''+psAnoMesAtual+''''+') )'+
                       ' AND    B.IDBENEFICIO     = BF.IDBENEFICIO                  '+
                       ' AND    B.TIPOBENEFICIO   <> 99                             '+
                       ' AND    PP.IDPESSOA       = BF.IDTITULAR   '+ 
                       ' AND    PP.IDPLANOPREV    = BF.IDPLANOPREV '+ 
                       ' AND    PP.IDPESSJUR      = BF.IDPESSJUR   '+ 
                       ' AND    PP.SEQPROPOSTA    = '+IntToStr(piSeqProposta)); 
        qryAux.Open;

        if not qryAux.IsEmpty then
        begin
           if (qryAux.FieldbyName('FLGDATAABONO').AsInteger = 1) then
               sDataInicio := qryAux.FieldByName('DATAINICIOFUND').AsString;

           sDataInicioInss := qryAux.FieldByName('DATAINICIOINSS').AsString;
           sDataInicioFund :=qryAux.FieldByName('DATAINICIOFUND').AsString;
        end;

     end;

     if bReferencia
     then begin
        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add(' SELECT BF.DATAINICIOFUND, BF.DATAINICIOINSS              '+
                       ' FROM   BENEFBFCIARIO BF, BENEFICIO B                       '+
                       ' WHERE  BF.IDPESSJUR      = '+IntToStr(piIdPessJur)          +
                       ' AND    BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)        +
                       ' AND    BF.IDTITULAR      = '+IntToStr(piIdTitular)          +
                       ' AND    BF.IDPESSOA       = '+IntToStr(piIdPessoa)           +
                       ' AND    BF.IDBENEFICIO = '+IntToStr(piIdBeneficio)        +
                       ' AND    TO_CHAR(BF.DATAINICIO,''YYYY/MM'') <= '''+psAnoMesAtual+''''+
                       ' AND    ((BF.DATAFINAL IS NULL) OR (TO_CHAR(BF.DATAFINAL,''YYYY/MM'') >= '''+psAnoMesAtual+''''+') )'+
                       ' AND    B.IDBENEFICIO     = BF.IDBENEFICIO                  '+
                       ' AND    B.TIPOBENEFICIO   <> 99                             ');
        qryAux.Open;

        if not qryAux.IsEmpty then
        begin
           sDataInicioInss := qryAux.FieldByName('DATAINICIOINSS').AsString;
           sDataInicioFund :=qryAux.FieldByName('DATAINICIOFUND').AsString;
        end;

     end;


//  end;

     BuscaDadosBeneficioAnterior ( qryAux,
                                   piIdPessJur, piIdPlanoPrev, piIdTitular,
                                   piIdBeneficio,
                                   0, // flgreferencia
                                   sDataInicio,
                                   sDataInicioAnt,
                                   sValorAnt,
                                   sNomeBenefAnt,
                                   sIdTpPagtoAnt,
                                   sUltMesReajAnt,
                                   sFlgBenefMinAnt,
                                   sDataEventoAnt,
                                   sCodBeneficioAnt,
                                   sValorBase1Ant, sValorBase2Ant, sValorBase3Ant,
                                   sNumProcINSS,
                                   True);

  if sDataInicioAnt = '' then sDataInicioAnt := '         ';

    //Tratar Abonos já pagos - Somente caso de beneficios rateados

  If piIdTitular <> piIdPessoa Then Begin
    { Tratamento da data de pesquisa,  não somar adiantamentos feitos no mesmo }
    { mês de competência do encerramento. até dia 14 do mês subsequente.       }

    sDataFimPesquisa := psDataFinal;

    If sDataFimPesquisa = '' Then sDataFimPesquisa := '31/12/'+Copy(psAnoMesAtual,1,4);

    iDiaInicio := StrToInt(Copy(sDataFimPesquisa,1,2));
    iMesInicio := StrToInt(Copy(sDataFimPesquisa,4,2));
    iDiaFim    := StrToInt(Copy(sDataFimPesquisa,1,2));
    iMesFim    := StrToInt(Copy(sDataFimPesquisa,4,2));
    iAnoInicio := StrToInt(Copy(sDataFimPesquisa,7,4));
    iAnoFim    := StrToInt(Copy(sDataFimPesquisa,7,4));

    If iDiaInicio < 15 Then Begin
      iMesInicio := (iMesInicio - 1);
      If iMesInicio <= 0 Then Begin
        iAnoInicio := (iAnoInicio - 1);
        iMesInicio := 12;
      End;
    End;

    If iDiaInicio > 15 Then Begin
      iMesFim := (iMesFim + 1);
      If iMesFim > 12 Then Begin
        iMesFim := 1;
        iAnoInicio := (iAnoInicio + 1)
      End;
    End;

    iDiaInicio := 15; iDiaFim := 14;

    sDataInicioPesquisa := FormatFloat('00',iDiaInicio)+'/'+
                           FormatFloat('00',iMesInicio)+'/'+
                           FormatFloat('0000',iAnoInicio);

    sDataFimPesquisa    := FormatFloat('00',iDiaFim)+'/'+
                           FormatFloat('00',iMesFim)+'/'+
                           FormatFloat('0000',iAnoFim);

    sSQL := ' SELECT SUM(DECODE(HST.FLGDEVOLUCAO,1,HST.VALORPREV * -1, HST.VALORPREV)) AS TOTALABONOPAGO '+
            'FROM HSTBENEFBFCIARIO HST, BENEFBFCIARIO BNB '+
            'WHERE HST.IDTITULAR     = '+IntToStr(piIdTitular)     +
            ' AND  HST.IDPLANOPREV   = '+IntToStr(piIdPlanoPrev)   +
            ' AND  HST.MESREFERENCIA = '+QuotedStr(Copy(psAnoMesAtual,1,4)+'/13') +
            ' AND  HST.IDBENEFICIO   = '+IntToStr(piIdBeneficio)   +
            ' AND  (( BNB.DATAFINAL < TO_DATE('+QuotedStr(sDataInicioPesquisa)+',''DD/MM/YYYY'')  '+
            '        OR BNB.DATAFINAL > TO_DATE('+QuotedStr(sDataFimPesquisa)+',''DD/MM/YYYY'') )'+
            '      OR (BNB.DATAFINAL IS NULL)) '+
            ' AND  HST.IDPESSJUR     = BNB.IDPESSJUR   '+
            ' AND  HST.IDTITULAR     = BNB.IDTITULAR   '+
            ' AND  HST.IDPESSOA      = BNB.IDPESSOA    '+
            ' AND  HST.IDBENEFICIO   = BNB.IDBENEFICIO '+
            ' AND  HST.SEQPROPOSTA   = BNB.SEQPROPOSTA '+
            ' AND  HST.NUMEROPROCESSO = BNB.NUMEROPROCESSO ';



    If FazQuery(QryAux,sSQL) Then Begin
      dValorAbonosPagos := QryAux.FieldByName('TOTALABONOPAGO').AsFloat;
    End;

    { Caso não tenha sido passado o VALORTOTAL atualiza com o prValorBenef  }
    If pdValorTotalBenef = 0 Then  pdValorTotalBenef := prValorBenef;

    // Mudando a query auxiliar de lugar para que possa
    // fazer o rateio entre os beneficiários também no caso
    // de não encontrar o 13º pago.

    { Busca dados do beneficio }
    sSQL := 'SELECT '+
            '  BPP.IDREGRACALCULO, PB.DTEVENTO,                          '+
            '  BF.NUMEROPROCESSO,  BF.DIBBENEFANT,    BF.VALORBENEFANT,  '+
            '  BF.DATAINICIO,      BF.DATAINICIOFUND, BF.DATAINICIOINSS, '+
            '  BF.VALORBASE1,      BF.VALORBASE2,     BF.VALORBASE3,     '+
            '  DPT.IDDEPENDENCIA, '+
            '  BTP.PERCENTUAL,     '+
            '  BF.IDPLANPREVCONTAB '+ // Andre Imakawa - SIG 31697
            'FROM   '+
            '  BENEFBFCIARIO BF, BENEFPLANPREV BPP, BFCIARIOTITPLAN  BTP, '+
            '  DEPENTIT DPT, PROCESSOBENEF PB '+
            'WHERE  '+
            '       BF.IDTITULAR    = '+IntToStr(piIdTitular)  +
            '  AND  BF.IDPESSOA     = '+IntToStr(piIdPessoa)   +
            '  AND  BF.IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
            '  AND  BF.IDBENEFICIO  = '+IntToStr(piIdBeneficio)+

            '  AND  BF.IDPLANOPREV  = BPP.IDPLANOPREV  '+
            '  AND  BF.IDBENEFICIO  = BPP.IDBENEFICIO  '+

            '  AND  BF.IDPESSJUR    = BTP.IDPESSJUR    '+
            '  AND  BF.IDPLANOPREV  = BTP.IDPLANOPREV  '+
            '  AND  BF.IDTITULAR    = BTP.IDTITULAR    '+
            '  AND  BF.IDPESSOA     = BTP.IDPESSOA     '+
            '  AND  BF.IDBENEFICIO  = BTP.IDBENEFICIO  '+
            '  AND  BF.SEQPROPOSTA  = BTP.SEQPROPOSTA  '+

            '  AND  BF.IDTITULAR    = DPT.IDTITULAR    '+
            '  AND  BF.IDPESSOA     = DPT.IDPESSOA     '+
            '  AND  BF.NUMEROPROCESSO = PB.NUMEROPROCESSO ' ;

    FazQuery(QryAux,sSQL);

    { Caso não tenha sido pago nada deste abono ainda, não executar acertos }
    If ((dValorAbonosPagos = 0) And (pdValorTotalBenef > 0 ))
         And (piTipoMov = 4)
     Then prValorBenef := pdValorTotalBenef
     Else Begin

      { Busca dados do INSS atual }
      sFlgBenefMinimo := '0';
      sVlrInfINSS := CalcBeneficioINSSAtual (piIdPessJur,
                                             piIdPlanoPrev,
                                             piIdTitular, 
                                             piIdPessoa,
                                             psAnoMesAtual,
                                             psAnoMesAtual,
                                             sIdTpPagtoAnt,
                                             sFlgBenefMinimo,
                                             Dtmaprev.qryAux2,
                                             qryAux.FieldByName('NUMEROPROCESSO').AsInteger,
                                             'I',// André Imakawa - SIG 31697
                                             6   // André Imakawa - SIG 31697
                                             );
      { Buscar o VALORCALCULADO para o caso de Dupla Atividade (FUNCEF) }
      sVlrCalcInss := CalcBeneficioINSSAtual(piIdPessJur,
                                             piIdPlanoPrev,
                                             piIdTitular, 
                                             piIdPessoa,
                                             psAnoMesAtual,
                                             psAnoMesAtual,
                                             sIdTpPagtoAnt,
                                             sFlgBenefMinimo,
                                             Dtmaprev.qryAux2,
                                             qryAux.FieldByName('NUMEROPROCESSO').AsInteger,
                                             'C'
                                             );

      if (StrToInt(Copy(qryaux.FieldByName('DATAINICIO').AsString,1,2)) >= 29) and
         (StrToInt(Copy(psAnoMesAtual,6,2)) = 2)
      then sDataRef := '28/'+copy(psAnoMesAtual,6,2) + '/'+ copy(psAnoMesAtual,1,4)
      else sDataRef := copy(qryaux.FieldByName('DATAINICIO').AsString,1,2)+ '/' + copy(psAnoMesAtual,6,2) + '/' + copy(psAnoMesAtual,1,4);

      If (Copy(sDataRef,1,2) = '31') And (Pos(Copy(sDataRef,4,2), '04060911') <> 0)
      Then  sDataRef := '30'+Copy(sDataRef,3,9);

      //Início - William Santana - SIG 29976
      sVlrInfINSS := stringreplace(sVlrInfINSS,'.',',',[rfReplaceall]);
      //if ( strtoFloat(sVlrInfInss) > 0) then // André Imakawa - SIG 31697
      if ( strtoFloat(sVlrInfInss) > 0) and (qryaux.FieldByName('IDPLANPREVCONTAB').AsString = '2') and (piTipoMov = 13) then // André Imakawa - SIG 31697
      pdValorTotalBenef := pdValorTotalBenef - strtoFloat(sVlrInfINSS);
      //Término - William Santana - SIG 29976

    End;
  End;

   if (copy(psAnoMesAtual,6,2) = '13') then         //William Santana - SIG 29976
    psAnoMesAtual := Copy(psAnoMesAtual,1,5)+'12';   //William Santana - SIG 29976

  // Executa Regra de Cálculo do Valor do Beneficio
  sSQL := ' SELECT    1 FLGCONCESSAO, '+
          IntToStr(piTipoMov)+' AS TIPOMOV, '+
           psFlgProvisorio                     +' AS FLGPROVISORIO,    '+
           ''+IntToStr(piIdPessoa)             +' AS IDPESSOA,         '+
           IntToStr(piIdPessJur)               +' AS IDPESSJUR,        '+
           IntToStr(piIdTitular)               +' AS IDTITULAR,        '+
           IntToStr(piIdPlanoPrev)             +' AS IDPLANOPREV,      '+
           IntToStr(piSeqProposta)             +' AS SEQPROPOSTA,      '+
           IntToStr(piIdBeneficio)             +' AS IDBENEFICIO,      '+
           '''' +   PreparaStrRegra(sDataInicio)          + ''' AS DATAINICIO,    '+
           '''' +   PreparaStrRegra(sDataFinal)           + ''' AS DATAFINAL,     '+
           'LAST_DAY(TO_DATE(''01/'+copy(psAnoMesAtual,6,2)+'/'+
                                    copy(psAnoMesAtual,1,4)+''',''DD/MM/YYYY'')) AS DATAREF,  '+
                     '''' +   PreparaStrRegra(sAnoMesReferencia)    + ''' AS MESREFERENCIA, '+
           '''' +   PreparaStrRegra(sAnoMesReferencia)    + ''' AS ANOMESREF,     '+
           '''' +   PreparaStrRegra(sDataInicioFund)       + ''' AS DATAINICIOFUND, '+
           '''' +   PreparaStrRegra(sDataInicioInss)          + ''' AS DATAINICIOINSS,    '+
           '''' +   PreparaStrRegra(sDataInscricaoPart)       + ''' AS INSCRICAODATA, '+
           OraNumero(FloatToStr(prValorBenef)) + ' AS VLBENEFPGTO,     '+
           OraNumero(FloatToStr(prValorBenef)) + ' AS VALORATUAL,      '+
           '''' +   Trim(sAnoMesReferencia)    + ''' AS ANOREF,        '+
           '''' +   Trim(psAnoMesLote)         + ''' AS ANOMESCOBRANCA, '+

           OraNumero(FloatToStr(pdValorTotalBenef)) + ' AS VALORTOTAL,  '+  // edilaine - SOL 253577-17661 / PPM 1019931

           OraNumero(IntToStr(piNumBenef))     + ' AS NUMBENEF,        '+
           '''' +   PreparaStrRegra(sDataInicioAnt)          + ''' AS DATAINICIOANT ' ;

  If piTipoMov = 3 Then Begin
    sSQL := sSQL + ', 1 AS FLGENCERRAMENTO  ';
  End Else Begin
    sSQL := sSQL + ', 0 AS FLGENCERRAMENTO  ';
  End;

  sSQL := sSQL + ' FROM DUAL ';

  sValorAbono := RegraNumerica( IntToStr(piIdRegraCalculo), sSQL, bErro, piIdCalculo );

  if bErro
   then begin
     bErro := True;
     sMsgErro := ' Ocorreu um erro na Regra de Cálculo do Valor do Abono  (nº '+IntToStr(piIdRegraCalculo)+') ';
     Result  := -1;
     Exit;
  end;

  if Trim(sValorAbono) = ''
  then begin
     bErro := True;
     sMsgErro := ' A Regra de Cálculo do Valor do Abono (nº '+IntToStr(piIdRegraCalculo)+')'+
                 ' retornou um valor em branco. ';
     Result  := -1;
     Exit;
  end;

  try
     rValorAbono := StrToFloat(ClienteNumero(sValorAbono));
  except
     bErro := True;
     sMsgErro := ' A Regra de Cálculo do Valor do Abono (nº '+IntToStr(piIdRegraCalculo)+')' +
                 ' retornou um valor inválido. [Valor Retornado = '+sValorAbono+']';
     Result  := -1;
     Exit;
  end;
  bErro := False;
  sMsgErro := ' ';

  Result := rValorAbono;

End; // ExecutaRegraValorAbono


function BuscaRegraEventoPdv(sTpBenef:Char; iIdPessJur, iIdPlanoPrev,
                             iIdTitular, iSeqProposta : Integer;
                             var iIdBeneficio : Integer; qry:TwwQuery):Integer;
begin
    result := 0;
    iIdBeneficio := 0;
    qry.Close;
    qry.Sql.Clear;
    qry.Sql.Add(' SELECT EP.IDREGRACALCBENEF, EP.IDREGRARESGATE, EP.IDBENEFICIO '+
                ' FROM   EVENTOSPREV  EP, EVENTOGERADOR EV '+
                ' WHERE  EP.IDPESSOA    = '+IntToStr(iIdTitular)  +
                ' AND    EP.IDPLANOPREV = '+IntToStr(iIdPlanoPrev)+
                ' AND    EP.SEQPROPOSTA = '+IntToStr(iSeqProposta)+
                ' AND    EP.IDPESSJUR   = '+IntToStr(iIdPessJur)  +
                ' AND    EV.FLGINTERNO  = ''PD''  '+
                ' AND    EP.IDEVENTOGERADOR = EV.IDEVENTOGERADOR '+
                ' AND    EP.DATAVOLTA IS NOT NULL ');
    qry.Open;

    if qry.IsEmpty
    then begin
         qry.Close;
         Exit;
    end;

    iIdBeneficio := qry.FieldByName('IDBENEFICIO').AsInteger;

    case sTpBenef of    // Beneficio ou Resgate
    'B' : result := qry.FieldByName('IDREGRACALCBENEF').AsInteger;
    'R' : result := qry.FieldByName('IDREGRARESGATE').AsInteger;
    end;
    qry.Close;
end;

function AcertaBeneficio(  qryAux             : TwwQuery;
                           pcTipo,
                           pcFlgFormaPagto    : char; // D - devolucao, A - acerto de pgmto a maior
                           piIdPessJur,
                           piIdPlanoPrev,
                           piIdTitular,
                           piSeqProposta,
                           piIdPessoa,
                           piNumeroProcesso,
                           piIdBeneficio      : longint;
                           piCodPortForma      : longint;
                           psNomeBeneficio,
                           psAnoMesReferencia : string;
                           prDiferenca        : double;
                           piIdLote           : longint;
                           pdValorIntegral : Double = 0;
                           pdValorTotal    : Double = 0;
                           pdPercentual    : double = 0;

                           piTipoMov : Integer= -1;
                           sDataInicioOriginal : string = ''; // Felipe A. Santos SOL 182092/14207 15207 15253 KITANTA 1969056
                           pdValorBS    : String = '';   // fernando xavier - SOL 253577-17664 / PPM 1019932
                           pdValorFAB   : String = '';   // fernando xavier - SOL 253577-17664 / PPM 1019932
                           pdValorDeficit : String = ''; // fernando xavier - SOL 253577-17664 / PPM 1019932
                           piFlgEnviado : integer = 0;   // fernando xavier - SOL 253577-17664 / PPM 1019932
                           piIPerfilInvest : Integer = -1   //edilaine - SIG55933
                           ) : boolean;
var
  sAnoMes,sDataFolha, sMsgErro,
  sDescPreparo : string;
  scodportforma, sSQL,
  sPlanoOrigem  : string;
  sFlgDevolucao : string; 
  sFlagProvisorio : String;
  sDataPagamento : String;

  iSeqBeneficio : Integer;
  pIntFontePagadora : Integer; // Felipe A. Santos SOL 182092/14207 15207 15253 KITANTA 1969056
begin
   Result := False;

  //caso calcule dif. zero, por exemplo no mesmo mês do lote, sair
  if prDiferenca = 0 then
  begin
     result := true;
     exit;
  end;

  qryAux.Close;
  qryAux.SQL.Clear;
  qryAux.SQL.Add(' SELECT BFC.FLGPROVISORIO, BFC.IDPLANOORIGEM,  '+
                 '        BFC.FONTEPAGADORA, BFT.PERCENTUAL      '+
                 ' FROM BENEFBFCIARIO BFC, BFCIARIOTITPLAN BFT '+
                 ' WHERE (BFC.IDPESSJUR      ='+ IntToStr(piIdPessJur)     +')'+
