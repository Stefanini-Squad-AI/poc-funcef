//edilaine - SIG55933 - inicio
function BuscaPerfilInvestimento(pIdPessjur,
                                 pIdTitular,
                                 pIdPlanoPrev,
                                 pSeqProposta,
                                 pIdEvento,
                                 pIdSitPart : longint;
                                 pDataEvento : string;
                                 pbBeneficioINSS,
                                 pbPerfilAnterior : Boolean;
                                 var bPerfilAtivo : boolean;
                                 pIdPlanPrevContab: Integer = -1 // Alterado por FHBS - 09/08/2018 - SIG73169
                                 ) : TRecPerfilInv;
var
  qry : TwwQuery;
begin
  Result.iIdPerfilInvest   := -1;
  Result.iIdPlanPrevContab := -1;

  bPerfilAtivo := false;

  qry := TwwQuery.Create(Application);
  try
    qry.DatabaseName :=  'BaseDados';

    if not pbBeneficioINSS then
    begin
      {busca perfil ativo ou o perfil anterior}
      qry.SQL.Clear;
      qry.SQL.Add('SELECT ROWNUM AS ORDEM, PXE.IDPERFILINVEST, P.FLGATIVO, PXE.DTFIM, ');
      qry.SQL.Add('       PXE.DTINICIO, P.IDPLANPREVCONTAB,                           ');
      qry.SQL.Add('       CASE  ');
      qry.SQL.Add('          WHEN TO_DATE('+QuotedStr(pDataEvento)+', ''DD/MM/YYYY'') >= PXE.DTINICIO  AND PXE.DTFIM IS NULL THEN ''S'' ');
      qry.SQL.Add('          WHEN TO_DATE('+QuotedStr(pDataEvento)+', ''DD/MM/YYYY'') BETWEEN PXE.DTINICIO AND PXE.DTFIM THEN ''S''     ');
      qry.SQL.Add('          ELSE ''N''  ');
      qry.SQL.Add('       END VIGENTE_DIB, ');
      qry.SQL.Add('       CASE ');
      qry.SQL.Add('          WHEN PXE.DTFIM IS NULL OR PXE.DTFIM >= SYSDATE THEN ''S'' ');
      qry.SQL.Add('          WHEN ROWNUM = 1 AND TO_DATE('+QuotedStr(pDataEvento)+', ''DD/MM/YYYY'') BETWEEN PXE.DTINICIO AND PXE.DTFIM THEN ''S'' ');
      qry.SQL.Add('          ELSE ''N''  ');
      qry.SQL.Add('       END VIGENTE    ');
      qry.SQL.Add('  FROM PERFILINVXELEG PXE ');
      qry.SQL.Add('  JOIN PERFILINVEST  P ON P.IDPERFILINVEST = PXE.IDPERFILINVEST ');

      if pIdEvento > 0 then
         qry.SQL.Add('  JOIN PERFILINVXEVENTO  PE ON PE.IDPERFILINVEST = PXE.IDPERFILINVEST ');
      if pIdSitPart > 0 then
         qry.SQL.Add('  JOIN PERFILINVXSITPART PS ON PS.IDPERFILINVEST = PXE.IDPERFILINVEST ');
      qry.SQL.Add(' WHERE PXE.IDPESSJUR   = '+IntToStr(pIdPessjur)   );
      qry.SQL.Add('   AND PXE.IDPLANOPREV = '+IntToStr(pIdPlanoPrev) );
      qry.SQL.Add('   AND PXE.IDPESSOA    = '+IntToStr(pIdTitular)   );
      qry.SQL.Add('   AND PXE.SEQPROPOSTA = '+IntToStr(pSeqProposta) );

      if pIdEvento > 0 then
         qry.SQL.Add('   AND PE.IDEVENTOGERADOR = '+IntToStr(pIdEvento) );
      if pIdSitPart > 0 then
         qry.SQL.Add('   AND PS.IDSITPART = '+IntToStr(pIdSitPart) );

      qry.SQL.Add('ORDER BY PXE.DTINICIO DESC, PXE.DTFIM ');
      qry.open;
      if not qry.eof then
      begin
        {perfil vigente}
        if (not pbPerfilAnterior) then
        begin
          begin
            Result.iIdPerfilInvest   := qry.FieldByName('IDPERFILINVEST').AsInteger;
            Result.iIdPlanPrevContab := qry.FieldByName('IDPLANPREVCONTAB').AsInteger;
            bPerfilAtivo := (qry.FieldByName('FLGATIVO').AsInteger = 1) and
                            (qry.FieldByName('VIGENTE').AsString = 'S');
          end;
        end
        else
        begin
          while not (qry.Eof) and (Result.iIdPerfilInvest = -1) do
          begin
            {localiza o perfil vigente}
            if not (qry.FieldByName('VIGENTE').AsString = 'S') then
            begin
              qry.next;
              Continue;
            end;

            {localizando o perfil vigente, pega o anterior}
            qry.Next;
            if not qry.Eof then
            begin
              Result.iIdPerfilInvest   := qry.FieldByName('IDPERFILINVEST').AsInteger;
              Result.iIdPlanPrevContab := qry.FieldByName('IDPLANPREVCONTAB').AsInteger;
              bPerfilAtivo := qry.FieldByName('FLGATIVO').AsInteger = 1;
            end;
          end;
        end;
      end;
    end
    else
    begin
      {primeiro verifica se existe benefício Funcef ativo. Se existir retorna o Perfil do Benefício}
      qry.SQL.Clear;
      qry.SQL.Add('SELECT BF.IDPERFILINVEST, P.FLGATIVO, P.IDPLANPREVCONTAB ');
      qry.SQL.Add('  FROM BENEFBFCIARIO BF  ');
      qry.SQL.Add('  JOIN PERFILINVEST  P ON P.IDPERFILINVEST = BF.IDPERFILINVEST ');
      qry.SQL.Add(' WHERE BF.IDPESSJUR   = '+IntToStr(pIdPessjur)   );
      qry.SQL.Add('   AND BF.IDPLANOPREV = '+IntToStr(pIdPlanoPrev) );
      qry.SQL.Add('   AND BF.IDPESSOA    = '+IntToStr(pIdTitular)   );
      qry.SQL.Add('   AND BF.SEQPROPOSTA = '+IntToStr(pSeqProposta) );
      qry.SQL.Add('   AND BF.IDSITBENEFICIO = 1 ');
      qry.SQL.Add('   AND BF.FONTEPAGADORA  = 1 ');
      qry.open;
      if not qry.IsEmpty then
      begin
        bPerfilAtivo := qry.FieldByName('FLGATIVO').AsInteger = 1;
        Result.iIdPerfilInvest   := qry.FieldByName('IDPERFILINVEST').AsInteger;
        Result.iIdPlanPrevContab := qry.FieldByName('IDPLANPREVCONTAB').AsInteger;
      end
      else
      begin
        {Se não existe beneficio Funcef Ativo, busca o Perfil Padrão INSS referente ao plano}
        qry.SQL.Clear;
        qry.SQL.Add('SELECT P.IDPERFILINVEST, P.FLGATIVO, P.IDPLANPREVCONTAB ');
        qry.SQL.Add('  FROM PERFILINVEST P  ');
        if pIdEvento > 0 then
           qry.SQL.Add('  JOIN PERFILINVXEVENTO  PE ON PE.IDPERFILINVEST = PXE.IDPERFILINVEST ');
        if pIdSitPart > 0 then
           qry.SQL.Add('  JOIN PERFILINVXSITPART PS ON PS.IDPERFILINVEST = PXE.IDPERFILINVEST ');
        qry.SQL.Add(' WHERE P.IDPLANOPREV = '+IntToStr(pIdPlanoPrev) );
        qry.SQL.Add('   AND P.FLGATIVO = 1' );
        qry.SQL.Add('   AND P.FLGPADRAOINSS = 1' );
        if pIdEvento > 0 then
           qry.SQL.Add('   AND PE.IDEVENTOGERADOR = '+IntToStr(pIdEvento) );
        if pIdSitPart > 0 then
           qry.SQL.Add('   AND PS.IDSITPART = '+IntToStr(pIdSitPart) );

        // Alterado por FHBS - 09/08/2018 - SIG73169
        if (pIdPlanoPrev = 2 ) and (pIdPlanPrevContab > 0) then
           qry.SQL.Add('   AND P.IDPLANPREVCONTAB = '+IntToStr(pIdPlanPrevContab) );
        // Fim - Alterado por FHBS - 09/08/2018 - SIG73169

        qry.SQL.Add(' ORDER BY P.IDPLANPREVCONTAB DESC');                //edilaine - SIG69204
        qry.open;
        if not qry.IsEmpty then
        begin
          bPerfilAtivo := qry.FieldByName('FLGATIVO').AsInteger = 1;
          Result.iIdPerfilInvest   := qry.FieldByName('IDPERFILINVEST').AsInteger;
          Result.iIdPlanPrevContab := qry.FieldByName('IDPLANPREVCONTAB').AsInteger;
