function CalculaBeneficioMinimo ( piNumeroProcesso,
                                  piIdPessJur,
                                  piIdPlanoPrev,
                                  piIdTitular,
                                  piIdPessoa,
                                  piIdBeneficio           : longint;
                                  psValorPrev,
                                  psValorTotal            : string;
                                  piNumBenef              : word;
                                  psAnoMesReferencia,
                                  psDataInicio,
                                  psDataFinal             : string;
                                  var pdValorDepoisMinimo : double;
                                  var sMsgErro            : string ) : boolean;
var sSQL,
    sPercentual,
    sFlgCalcTodoMes,
    sSalarioIntegral,
    sDataRef,
    sValorRegra  : string;
    dValorRegra  : double;
    bErro        : boolean;
begin
   Result := False;

   pdValorDepoisMinimo := 0;
   if prmIdRegraCalcBenefMin <= 0
   then begin
      Result   := True;
      pdValorDepoisMinimo := StrToFloat(ClienteNumero(psValorPrev));
      sMsgErro := '';
      Exit;
   end;


   // Buscar campos auxiliares
   with dtmAPrev.qryAux do
   begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT BTIT.PERCENTUAL        '+
              ' FROM   BFCIARIOTITPLAN BTIT  '+
              ' WHERE  BTIT.IDBENEFICIO = '+IntToStr(piIdBeneficio)+
              ' AND    BTIT.IDPESSJUR   = '+IntToStr(piIdPessJur)+
              ' AND    BTIT.IDPESSOA    = '+IntToStr(piIdPessoa)+
              ' AND    BTIT.IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+
              ' AND    BTIT.IDTITULAR   = '+IntToStr(piIdTitular)+
              ' AND    BTIT.SEQPROPOSTA = 1 ');
      Open;
      if (not IsEmpty) and (FieldByName('PERCENTUAL').AsFloat > 0)
      then sPercentual := FormatFloat('#0.000000', FieldByName('PERCENTUAL').AsFloat)
      else sPercentual := '100';
   end;

   with dtmAPrev.qryAux do
   begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT BP.FLGCALCTODOMES '+
              ' FROM   BENEFPLANPREV BP  '+
              ' WHERE  BP.IDBENEFICIO = '+IntToStr(piIdBeneficio)+
              ' AND    BP.IDPLANOPREV = '+IntToStr(piIdPlanoPrev));
      Open;
      if (not IsEmpty)
      then sFlgCalcTodoMes := FieldByName('FLGCALCTODOMES').AsString
      else sFlgCalcTodoMes := '0';
   end;

   sSalarioIntegral := BuscaSalarioPESSOAINTEGRAL ( dtmAPrev.qryAux,
                                                    piIdPessJur,  piIdPlanoPrev,
                                                    piIdTitular,   1,
                                                    'AS', psAnoMesReferencia );

   if (StrToInt(copy(psDataInicio,1,2)) >= 29) and
      (StrToInt(copy(psAnoMesReferencia,6,2)) = 2)
   then sDataRef := '28/'+copy(psAnoMesReferencia,6,2) + '/' + copy(psAnoMesReferencia,1,4)
   else sDataRef := copy(psDataInicio,1,2)+ '/' + copy(psAnoMesReferencia,6,2) + '/' + copy(psAnoMesReferencia,1,4);

   if (StrToFloat(ClienteNumero(psValorTotal)) <= 0)
   then psValorTotal := psValorPrev;


   sSQL  := ' SELECT '+ OraNumero(sFlgCalcTodoMes) +'  AS FLGBENEFCOTAS,  '+
            '        1                                 AS FLGCONCESSAO,   '+
            '        1                                 AS SEQPROPOSTA,    '+
            IntToStr(piIdPlanoPrev)                +'  AS IDPLANOPREV,    '+
            IntToStr(piIdPessJur)                  +'  AS IDPESSJUR,      '+
            IntToStr(piNumeroProcesso)             +'  AS NUMEROPROCESSO, '+
            IntToStr(piIdTitular)                  +'  AS IDTITULAR,      '+
            IntToStr(piIdPessoa)                   +'  AS IDPESSOA,       '+
            IntToStr(piIdBeneficio)                +'  AS IDBENEFICIO,    '+
            OraNumero(psValorPrev)                 +'  AS VALORATUAL,     '+
            OraNumero(psValorPrev)                 +'  AS VALORPREV,      '+ 
            OraNumero(psValorPrev)                 +'  AS VALORORIGINAL,  '+
            OraNumero(psValorTotal)                +'  AS VALORTOTAL,     '+
            OraNumero(sPercentual)                 +'  AS PERCENTUAL,     '+
            OraNumero(sSalarioIntegral)            +'  AS VALORPROVENTO,  '+
            OraNumero(sSalarioIntegral)            +'  AS SALARIOINTEGRAL,'+ 
            IntToStr(piNumBenef)                   +'  AS NUMBENEF,       '+
            QuotedStr(PreparaStrRegra(psAnoMesReferencia))          +'  AS MESREFERENCIA,  '+
            QuotedStr(PreparaStrRegra(psAnoMesReferencia))          +'  AS ANOMESREF,      '+
            QuotedStr(PreparaStrRegra(psDataInicio))               +'  AS DATAINICIO,     '+
            QuotedStr(PreparaStrRegra(psDataFinal))                 +'  AS DATAFINAL,      '+
            QuotedStr(PreparaStrRegra(sDataRef))                    +'  AS DATAREF,        '+
            QuotedStr('AS')                        +'  AS FLGINTERNO      '+
            ' FROM DUAL ';

   try
     sValorRegra := RegraNumerica(FloatToStr(prmIdRegraCalcBenefMin),sSQL, bErro, iIdCalculoGeral);
   except
     sValorRegra := '0';
     bErro       := True;
   end;


   if bErro
   then begin
      sMsgErro := 'Erro ao Executar a Regra de Cálculo de Benefício Mínimo - Regra Nº '+FloatToStr(prmIdRegraCalcBenefMin)+'.';
      Exit;
   end;

   try
      dValorRegra := StrToFloat(ClienteNumero(sValorRegra));
   except
      sMsgErro := 'Valor Retornado pela Regra de Cálculo de Benefício Mínimo - Regra Nº '+FloatToStr(prmIdRegraCalcBenefMin)+' inválido ['+sValorRegra+'].';
      Exit;
   end;

   pdValorDepoisMinimo := dValorRegra;

   Result := True;
end;

function AcertaBeneficioINSS ( piNumeroProcesso,
                               piIdSuplementacao,
                               piIdPessJur,
                               piIdPlanoPrev,
                               piIdTitular,
                               piIdPessoa,
                               piSeqProposta,
                               piIdLote           : longint;
                               psDataInicioFund,
                               psAnoMesAcerto,
                               psDataPagamento    : string ): boolean;
var dTotalAPagar,
    dTotalPago,
    dValorAcerto        : double;
    sMsgErro,
    sFlgDevolucaoINSS,
    sFlgDevolucaoSUPL   : string;
    iNumeroProcessoacerto,
    iSuplementacaoAcerto : longint;
begin

   // 1. Buscar INSS´s no mês da DIB do benefício que está sendo inserido
   // 2. Se o benefício não for de conversão ( só tem 1 inss ), sair pois
   //    não haverá nenhum acerto a fazer
   // 3. Somar INSS´s encontrados
   // 4. Comparar com o INSS que foi pago
   // 5. Inserir a diferença no INSS e na suplementação para ser pago/descontado
   //    do participante
   // Exemplo :
   //    A pessoa estava em AUXILIO DOENCA desde 01.01.2002. O INSS dela é 91%
   //    do valor total do INSS. Supondo que o INSS seja R$ 1000,00, será concedido
   //    como INSS o valor de R$ 910,00. Vamos supor que o SRB seja de R$ 2.000,00
   //    Logo a SUPLEMENTAÇÃO será de R$ 1.090,00 ( 2000 - 910)
   //    Em 06.07.2002 a pessoa entrou em INVALIDEZ. Para este benefício o INSS
   //    é de 100%, logo será de R$ 1.000,00 e a SUPLEMENTAÇÃO R$ 1.000,00
   //    Analisando o mês 07.2002 temos :
   //    *  5 DIAS DE AUXILIO DOENCA
   //    * 25 DIAS DE INVALIDEZ
   //    * VALOR DO BENEFICIO INSS INTEGRAL    VALOR PRÓ-RATA (5 d)
   //      INSS AUXILIO DEONCA = R$   910,00 ->   151,66
   //      INSS INVALIDEZ      = R$ 1.000,00 ->   833,33
   //                                          ---------
   //      DEVERIA TER SIDO PAGO =                984,99
   //      FOI PAGO              =                910,00
   //      VALOR DO ACERTO       =              -  74,99
   // -----------------------------------------------------------------------------------
   // CONCLUSAO :
   //      FORAM PAGOS 74,99 A MENOS DE INSS, LOGO FOI PAGO R$ 74,99 A MAIS DE
   //      SUPLEMENTAÇÃO. O SISTEMA DEVE ACERTAR ESTA DIFERENCA PARA SER DESCONTADA
   //      DO PARTICIPANTE
   // -----------------------------------------------------------------------------------

   Result := False;

   with dtmAPrev.qryAux do
   begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT COUNT(DISTINCT H.IDBENEFICIO) AS TOTBENEF,                   '+
              '        SUM(DECODE(H.FLGDEVOLUCAO,  1,  -H.VALORPREV,                '+
              '                                         H.VALORPREV ) ) AS SOMAINSS '+
              ' FROM   HSTBENEFBFCIARIO H, BENEFPLANPREV BP                         '+
              ' WHERE  H.IDPESSJUR      = '+IntToStr(piIdPessJur)                    +
              ' AND    H.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)                  +
              ' AND    H.IDTITULAR      = '+IntToStr(piIdTitular)                    +
              ' AND    H.IDPESSOA       = '+IntToStr(piIdPessoa)                     +
              ' AND    H.SEQPROPOSTA    = '+IntToStr(piSeqProposta)                  +
              ' AND    BP.IDPLANOPREV   = H.IDPLANOPREV                             '+
              ' AND    BP.IDBENEFICIO   = H.IDBENEFICIO                             '+
              ' AND    BP.FLGREFERENCIA = 1                                         '+
              ' AND    H.MESREFERENCIA  = '''+Copy(psDataInicioFund,7,4)+'/'+Copy(psDataInicioFund,4,2)+'''');
      Open;

      // Se só houver um beneficio, entao é porque o beneficio não veio de conversão,
      // logo, não há acerto a se fazer
      if (IsEmpty) or (FieldByName('SOMAINSS').AsFloat <= 0) or (FieldByName('TOTBENEF').AsInteger <= 1)
      then begin
         Result := True;
         Close;
         Exit;
      end;

      dTotalAPagar := FieldByName('SOMAINSS').AsFloat;

      Close;
      SQL.Clear;
      SQL.Add(' SELECT BF.NUMEROPROCESSO, BF.IDBENEFICIO, H.MESREFERENCIA,               '+
              '        SUM(DECODE(H.FLGDEVOLUCAO, 1,                                     '+
              '                                  -H.VALORPREV, H.VALORPREV)) AS INSSPAGO '+
              ' FROM   HSTBENEFBFCIARIO H, BENEFBFCIARIO BF, BENEFPLANPREV BP            '+
              ' WHERE  H.IDPESSJUR        = '+IntToStr(piIdPessJur)                       +
              ' AND    H.IDPLANOPREV      = '+IntToStr(piIdPlanoPrev)                     +
              ' AND    H.IDTITULAR        = '+IntToStr(piIdTitular)                       +
              ' AND    H.IDPESSOA         = '+IntToStr(piIdPessoa)                        +
              ' AND    H.SEQPROPOSTA      = '+IntToStr(piSeqProposta)                     +
              ' AND    H.IDBENEFICIO      <> '+IntToStr(piIdSuplementacao)                +
              ' AND    BF.IDPLANOPREV     = H.IDPLANOPREV                                '+
              ' AND    BF.IDBENEFICIO     = H.IDBENEFICIO                                '+
              ' AND    BF.NUMEROPROCESSO  = H.NUMEROPROCESSO                             '+
              ' AND    BF.IDPESSJUR       = H.IDPESSJUR                                  '+
              ' AND    BF.IDTITULAR       = H.IDTITULAR                                  '+
              ' AND    BF.IDPLANOORIGEM   = H.IDPLANOORIGEM                              '+
              ' AND    BF.IDPESSOA        = H.IDPESSOA                                   '+
              ' AND    BF.SEQPROPOSTA     = H.SEQPROPOSTA                                '+
              ' AND    BF.IDSITBENEFICIO  = 3                                            '+
              ' AND    BP.IDPLANOPREV     = H.IDPLANOPREV                                '+
              ' AND    BP.IDBENEFICIO     = H.IDBENEFICIO                                '+
              ' AND    BP.FLGREFERENCIA   = 1                                            '+
              ' AND    H.MESREFERENCIA    = '''+Copy(psDataInicioFund,7,4)+'/'+Copy(psDataInicioFund,4,2)+''''+
              ' AND    H.VLBENEFPGTO      IS NOT NULL                                    '+
              ' AND    H.VLBENEFPGTO      > 0                                            '+
              ' GROUP BY BF.NUMEROPROCESSO, BF.IDBENEFICIO, H.MESREFERENCIA             ');
      Open;

      if (IsEmpty) or (FieldByName('INSSPAGO').AsFloat <= 0)
      then dTotalPago := 0
      else dTotalPago := FieldByName('INSSPAGO').AsFloat;

      if Abs(dTotalPago - dTotalAPagar) <= 0.01
      then begin // não houve diferença
         Close;
         Result := True;
         Exit;
      end;

      dValorAcerto := dTotalPago - dTotalAPagar;
      if dValorAcerto < 0 then dValorAcerto := -dValorAcerto;


      if dTotalPago <  dTotalAPagar
      then begin // INSS foi pago a menor -> Suplementacao foi paga a maior
        sFlgDevolucaoINSS := '0';
        sFlgDevolucaoSUPL := '1';
      end
      else begin // INSS foi pago a maior -> Suplemntacao foi paga a menor
        sFlgDevolucaoINSS := '1';
        sFlgDevolucaoSUPL := '0';
      end
   end;

   // Buscar numero do processo e idbeneficio da suplementacao encerrada
   with dtmAPrev.qryAux do
   begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT BF.NUMEROPROCESSO, BF.IDBENEFICIO, H.MESREFERENCIA                '+
              ' FROM   HSTBENEFBFCIARIO H, BENEFBFCIARIO BF, BENEFPLANPREV BP            '+
              ' WHERE  H.IDPESSJUR        = '+IntToStr(piIdPessJur)                       +
              ' AND    H.IDPLANOPREV      = '+IntToStr(piIdPlanoPrev)                     +
              ' AND    H.IDTITULAR        = '+IntToStr(piIdTitular)                       +
              ' AND    H.IDPESSOA         = '+IntToStr(piIdPessoa)                        +
              ' AND    H.SEQPROPOSTA      = '+IntToStr(piSeqProposta)                     +
              ' AND    H.IDBENEFICIO      <> '+IntToStr(piIdSuplementacao)                +
              ' AND    BF.IDPLANOPREV     = H.IDPLANOPREV                                '+
              ' AND    BF.IDBENEFICIO     = H.IDBENEFICIO                                '+
              ' AND    BF.NUMEROPROCESSO  = H.NUMEROPROCESSO                             '+
              ' AND    BF.IDPESSJUR       = H.IDPESSJUR                                  '+
              ' AND    BF.IDTITULAR       = H.IDTITULAR                                  '+
              ' AND    BF.IDPLANOORIGEM   = H.IDPLANOORIGEM                              '+
              ' AND    BF.IDPESSOA        = H.IDPESSOA                                   '+
              ' AND    BF.SEQPROPOSTA     = H.SEQPROPOSTA                                '+
              ' AND    BF.IDSITBENEFICIO  = 3                                            '+
              ' AND    BP.IDPLANOPREV     = H.IDPLANOPREV                                '+
              ' AND    BP.IDBENEFICIO     = H.IDBENEFICIO                                '+
              ' AND    BP.FLGREFERENCIA   = 0                                            '+
              ' AND    H.MESREFERENCIA    = '''+Copy(psDataInicioFund,7,4)+'/'+Copy(psDataInicioFund,4,2)+''''+
              ' AND    H.VLBENEFPGTO      IS NOT NULL                                    '+
              ' AND    H.VLBENEFPGTO      > 0                                            '+
              ' GROUP BY BF.NUMEROPROCESSO, BF.IDBENEFICIO, H.MESREFERENCIA             ');
      Open;

      if IsEmpty
      then begin
         Close;
         Result := True;
         Exit;
      end;
      iNumeroProcessoacerto := dtmAPrev.qryAux.FieldByName('NUMEROPROCESSO').AsInteger;
      iSuplementacaoAcerto  := dtmAPrev.qryAux.FieldByName('IDBENEFICIO').AsInteger;

   end;

   // O INSS JÁ ESTARÁ ACERTADO
   // INSERIR ACERTO DA SUPLEMENTACAO
   if not InsereHstBenefBfciario(  dtmAPrev.qryAux,
                                   2,
                                   iNumeroProcessoacerto,
                                   iSuplementacaoAcerto,
                                   piIdPessJur,
                                   piIdPlanoPrev,
                                   piIdTitular,
                                   piSeqProposta,
                                   piIdPessoa,
                                   -1,
                                   prmIdMotivoFolhaBen,
                                   -1,
                                   dtmAPrev.qryAux.FieldByName('MESREFERENCIA').AsString,
                                   psAnoMesAcerto,
                                   '',
                                   '',
                                   '',
                                   dValorAcerto,
                                   dValorAcerto,
                                   0,
                                   0,
                                   0,
                                   1,
                                   StrToInt(sFlgDevolucaoSUPL),
                                   piIdLote,
                                   sMsgErro,
                                   psDataPagamento)
   then begin
     Exit;
   end;

   Result := True;
end;


Function InsereHistContrib( QryBenefProc, QryContribProc, QryAux : twwquery ;
                            AnoMesRef, AnoMesCob,  sValorFinal : String;
                            iIdLoteConcessao : LongInt;
                            Var sMotivoAtraso : String;
                            bFazAcerto : Boolean = True ):Boolean;
Var

  sSQL, sSQLValues, wAnoMesRef,  sFlgIntEvento,
  sSitFundacao, piSitRecebimento, sDescPreparo, sAtrasoDevol,
  sFlgVeioDoEvento, sFlgDevolucao, sDataCobranca : String;

  bErro : Boolean;

  wIdMotivo, iNumRecebimento, iParcela:Integer;

  dValorDiferenca,
  dValorDevido, dValorCobrado : double;
Begin

  // O mes de cobrança tem que ser o mês do lote
  AnoMesCob := BuscaMesCobrancaLote( iIdLoteConcessao, AnoMesCob );

  { Caso já esteja com motivo não pede novo }
  If sMotivoAtraso = '' Then Begin
    wIdMotivo := prmIdMotivoContrib;
  End Else begin
    wIdMotivo := StrToInt(sMotivoAtraso);
  End;

  iNumRecebimento := LeUltRegistro(dtmAPrev.qry, 'HSTCONTRIBPREV');

  Result := False;

  // Só gerar lote de contribuicao caso o idlote esteja < 0
  // Caso contrario, usar mesmo lote gerado anteriomente
  if iIdLoteConcessao <= 0 then begin
    sDescPreparo:='Preparo de Contribuição : '+QryContribProc.FieldByName('NOME').AsString;
    sAtrasoDevol:='N';
    iIdLoteConcessao := GeraLOTE(QryBenefProc.FieldbyName('IDPESSJUR').AsInteger,
                        True, // gravar o lote
                        AnoMesRef,
                        'P', sDescPreparo,sAtrasoDevol,
                        '1','0','0','0','0', FormatDateTime('dd/mm/yyyy', Date),'','','',''); 
  end;

  // Calcular número da parcela
  iParcela := 0;
  if iParcela < 0 then iParcela := 0;

  sSQLValues := ''''+AnoMesRef+''''; // MESREFERENCIA
  sSQLValues := sSQLValues+','''+AnoMesCob+'''';

  sSQLValues := sSQLValues+',' +IntToStr(iNumRecebimento);

  if (Trim(QryContribProc.FieldByName('CODPORTFORMA').AsString) <> '') and
     (QryContribProc.FieldByName('CODPORTFORMA').AsInteger > 0)
  then
    sSQLValues := sSQLValues+', ' +QryContribProc.FieldByName('CODPORTFORMA').AsString
  else
    sSQLValues := sSQLValues+', NULL ';

  sDataCobranca   := CriticaDataCobrancaSit(QryAux,
                                            QryBenefProc.FieldbyName('IDPESSJUR').AsString,
                                            QryBenefProc.FieldbyName('IDPLANOPREV').AsString,
                                            'AS',
                                            'N',
                                            Copy(AnoMesCob, 6, 2),
                                            Copy(AnoMesCob, 1, 4) );

  sSQLValues := sSQLValues+', TO_DATE('''+sDataCobranca+''',''DD/MM/YYYY'') ';//DATAPREVISAORECE

  sFlgDevolucao := '0';

  {Caso deseje fazer acerto financeiro com o histórico }
  If ( bFazAcerto = True ) Then
  Begin

    if not bAcertoPorEncerramentoNucleo
    then begin

       // Pesquisa para ver se responsavel já possui Contribuicoes

       { Alteração nas pesquisa para buscar somente                             }
       { os valores recebidos. Seguindo assim o padrão de apagar os valores não }
       { recebidios e lançar novos valores com a diferença para o valor correto }

        sSQL := 'SELECT '+

               { CPrev Augusto 23/11/2007 - Ajustes para quando não houver preparo }
               //'  ( SUM( DECODE( FLGDEVOLUCAO, 1, H.VALORRECEBIDO * -1, H.VALORRECEBIDO ) ) - '+ OraNumero( sValorFinal ) + ' ) AS VALORDIF  '+
               '  SUM( DECODE( FLGDEVOLUCAO, 1, H.VALORRECEBIDO * -1, H.VALORRECEBIDO ) ) AS VALORRECEBIDO  '+

               'FROM   '+
               '  HSTCONTRIBPREV H '+

               'WHERE  '+
               '  H.IDPESSOA       = '+QryContribProc.FieldbyName('IDRESPNUCLEO').AsString    + ' AND ' +
               '  H.IDTITULAR       = '+QryBenefProc.FieldbyName('IDTITULAR').AsString         + ' AND ' +//Fanuel Junior SOL 157444/5301 Kintana 1329006
               '  H.MESREFERENCIA  = '+QuotedStr( AnoMesRef )                                 + ' AND ' +

               '  NVL( H.VALORRECEBIDO, 0 )  > 0 '                                            + ' AND ' +

               '  H.IDCONTRIBUICAO = '+QryContribProc.FieldByName('IDCONTRIBUICAO').AsString  + ' AND ' +
               '  H.SEQPROPOSTA    = '+QryBenefProc.FieldbyName('SEQPROPOSTA').AsString;


       If FazQuery(QryAux,sSQL) Then Begin

          dValorDiferenca := ( qryaux.fieldbyname('VALORRECEBIDO').AsFloat - StrToFloat( ClienteNumero( sValorFinal ) ) );

          { Caso não haja diferença sai fora }
          If ( dValorDiferenca = 0 ) Then Begin

             Result := true;
             Exit;

          end else begin

             If dValorDiferenca > 0 then begin

               sFlgDevolucao := '1';

               sValorFinal := FloatToStr( dValorDiferenca );

             End Else Begin

               sValorFinal := FloatToStr( dValorDiferenca * -1 );

             End;

             { Excluir historicos não recebidos }
             qryaux.close;
             qryaux.sql.Clear;
             qryaux.sql.Add(' DELETE HSTATRASOCONTRIB WHERE NUMRECEBIMENTO IN  '+
                            ' (SELECT NUMRECEBIMENTO FROM HSTCONTRIBPREV H WHERE '+
                            '  H.IDPESSOA       = '+QryContribProc.FieldbyName('IDRESPNUCLEO').AsString    + ' AND ' +
                            '  H.MESREFERENCIA  = '+QuotedStr(AnoMesRef)                                   + ' AND ' +
                            '  H.IDTITULAR        = '+QryBenefProc.FieldbyName('IDTITULAR').AsString       + ' AND ' +//Fanuel Junior SOL 157444/5301 Kintana 1329006
                            '  H.IDCONTRIBUICAO = '+QryContribProc.FieldByName('IDCONTRIBUICAO').AsString  + ' AND ' +
                            '  NVL( H.VALORRECEBIDO, 0 ) = 0 '                                             + ' AND ' +
                            '  H.SEQPROPOSTA    = '+QryBenefProc.FieldbyName('SEQPROPOSTA').AsString       + ') ');
             qryaux.execsql;


             qryaux.close;
             qryaux.sql.text := 'DELETE HSTCONTRIBPREV H WHERE  '+
                                ' H.IDPESSOA       = '+QryContribProc.FieldbyName('IDRESPNUCLEO').AsString    + ' AND ' +
                                ' H.MESREFERENCIA  = '+QuotedStr(AnoMesRef)                                   + ' AND ' +
                                ' H.IDTITULAR      = '+QryBenefProc.FieldbyName('IDTITULAR').AsString         + ' AND ' +// SOL 211974/15342 KTN 2051387
                                ' H.IDCONTRIBUICAO = '+QryContribProc.FieldByName('IDCONTRIBUICAO').AsString  + ' AND ' +
                                ' NVL( H.VALORRECEBIDO, 0 ) = 0 '                                             + ' AND ' +
                                ' H.SEQPROPOSTA    = '+QryBenefProc.FieldbyName('SEQPROPOSTA').AsString       + '     ' ;

             qryaux.execsql;

             { Caso já esteja com motivo não pede novo }
             If sMotivoAtraso = '' Then Begin

               //Pede novo Motivo
               //FrmEscolheMotivo := TFrmEscolheMotivo.Create(application);
               //FrmEscolheMotivo.wIdMotivo := wIdMotivo;
               //FrmEscolheMotivo.ShowModal;
               //wIdMotivo := FrmEscolheMotivo.wIdMotivo;
               wIdMotivo := 3057;
               If wIdMotivo = -1 Then Exit;
               sMotivoAtraso := IntToStr(wIdMotivo);
               //FrmEscolheMotivo.Free;

             End Else begin

               wIdMotivo := StrToInt(sMotivoAtraso);

             End;

          End;

       End;

    end
    else
    begin
       qryAux.Close;
       qryAux.SQL.Clear;
       qryAux.SQL.Add(' SELECT SUM(DECODE(H.FLGDEVOLUCAO,1,-(NVL(H.VALORRECEBIDO,H.VALORESPERADO)), NVL(H.VALORRECEBIDO,H.VALORESPERADO))) AS VALORCOBRADO '+
                      ' FROM   HSTCONTRIBPREV H                                                                                                     '+
                      ' WHERE  H.IDPESSOA       = '+QryContribProc.FieldbyName('IDRESPNUCLEO').AsString    +
                      ' AND    H.IDTITULAR      = '+QryBenefProc.FieldbyName('IDTITULAR').AsString         +//Fanuel Junior SOL 157444/5301 Kintana 1329006
                      ' AND    H.MESREFERENCIA  = '+QuotedStr(AnoMesRef)                                   +
                      ' AND    H.IDCONTRIBUICAO = '+QryContribProc.FieldByName('IDCONTRIBUICAO').AsString  +
                      ' AND    H.SEQPROPOSTA    = '+QryBenefProc.FieldbyName('SEQPROPOSTA').AsString       +
                      ' AND    H.IDMOTIVO       = '+IntToStr(wIdMotivo) );
       qryAux.Open;
       if (not qryAux.IsEmpty) and (qryAux.FieldByName('VALORCOBRADO').AsFloat > 0 )
       then begin
          dValorCobrado := qryAux.FieldByName('VALORCOBRADO').AsFloat;
          dValorDevido  := StrToFloat(ClienteNumero(sValorFinal));
          if dValorDevido > dValorCobrado
          then begin
             sValorFinal   := OraNumero(FloatToStr(dValorDevido-dValorCobrado));
             sFlgDevolucao := '0';
          end
          else begin
             sValorFinal   := OraNumero(FloatToStr(dValorCobrado-dValorDevido));
             sFlgDevolucao := '1';
          end;
       end;

    end;

  End
  Else
  Begin

    { Caso valor passado seja negativo então FLGDESATIVA }
    If ( StrToFloat(ClienteNumero(sValorFinal)) > 0 ) Then
    Begin
      sFlgDevolucao := '0'
    End
    Else
    Begin
      sFlgDevolucao := '1';

      { Valor sempre positivo }
      sValorFinal := OraNumero( FloatToStr( StrToFloat(ClienteNumero(sValorFinal)) * -1 ) );
    End;

  End;

  sSQLValues := sSQLValues+', '+OraNumero(sValorFinal);//VALORESPERADO

  sSQLValues := sSQLValues+', '+OraNumero(sValorFinal);//VALORCALCULADO

  sSQLValues := sSQLValues+', '+sFlgDevolucao;

  sSQLValues := sSQLValues+', '+QryContribProc.FieldByName('IDREGRACALCULO').AsString;  //IDREGRACALCULO

  sSQLValues := sSQLValues+', '+QryContribProc.FieldByName('FLGDESCFOLHA').AsString;

  // IdPessoa = Responsavel pelo Nucleo Familiar
  sSQLValues := sSQLValues+', '+QryContribProc.FieldbyName('IDRESPNUCLEO').AsString;

  sSQLValues := sSQLValues+', '+QryBenefProc.FieldbyName('SEQPROPOSTA').AsString;
  sSQLValues := sSQLValues+', '+QryBenefProc.FieldbyName('IDPESSJUR').AsString;
  sSQLValues := sSQLValues+', '+QryBenefProc.FieldbyName('IDPLANOPREV').AsString;

  sSQLValues := sSQLValues+', '+QryContribProc.FieldByName('IDCONTRIBUICAO').AsString;
  sSQLValues := sSQLValues+', 0'; //FLGCALCRESERVA


  sSQLValues := sSQLValues+', NULL ';


  sSQLValues := sSQLValues+', NULL ';

  sSQLValues := sSQLValues+', NULL ';

  if Trim(QryContribProc.FieldbyName('DATAINICIO').AsString) <> ''
  then sSQLValues := sSQLValues+', TO_DATE('''+QryContribProc.FieldByName('DATAINICIO').AsString+''',''DD/MM/YYYY'') '
  else sSQLValues := sSQLValues+', NULL ';

  if Trim(QryContribProc.FieldbyName('DATAFINAL').AsString) <> ''
  then sSQLValues := sSQLValues+', TO_DATE('''+QryContribProc.FieldByName('DATAFINAL').AsString+''',''DD/MM/YYYY'') '
  else sSQLValues := sSQLValues+', NULL ';

  sSitFundacao:= 'AS' ;
  sSQLValues := sSQLValues+', '''+sSitFundacao+'''';       //FLGSITFUNDACAO

  piSitRecebimento:='0';
  if QryContribProc.FieldByName('FLGNAOEXIGEREC').AsString = '1'
  then sSQLValues := sSQLValues+', '+ '2'               //SITRECEBIMENTO
  else sSQLValues := sSQLValues+', '+QuotedStr(piSitRecebimento); //SITRECEBIMENTO

  sSQLValues := sSQLValues+', ''F''';   //TIPO
  sSQLValues := sSQLValues+', '+IntToStr(iIdLoteConcessao); //IDLOTE
  sSQLValues := sSQLValues+', '+IntToStr(iParcela);        //PARCELA

  if QryContribProc.FieldByName('FLGNAOEXIGEREC').AsString = '1'
  then begin
    sSQLValues := sSQLValues+', '+OraNumero(sValorFinal);   //VALORECEBIDO
    sSQLValues := sSQLValues+', TO_DATE(TO_CHAR('''+AnoMesCob+''',''DD/MM/YYYY''),''DD/MM/YYYY'') '; //DATARECEBIMENTO
  end
  else begin
    sSQLValues := sSQLValues+', NULL';   //VALORECEBIDO
    sSQLValues := sSQLValues+', NULL';   //DATARECEBIMENTO
  end;

  if sSitFundacao = 'AS'
  then sSQLValues := sSQLValues +', 1 '
  else sSQLValues := sSQLValues +', 0 ';

  sFlgVeioDoEvento := '';
  if sFlgVeioDoEvento <> ''
  then sSQLValues := sSQLValues +', 1 '
  else sSQLValues := sSQLValues +', 0 ';

  sSQLValues := sSQLValues +', SYSDATE ';

  sFlgIntEvento:='';
  if Trim(sFlgIntEvento) <> ''
  then sSQLValues := sSQLValues + ', '''+sFlgIntEvento+''''
  else sSQLValues := sSQLValues +', NULL ';

  // Monta linha
  sSQLValues := sSQLValues+',' +IntToStr(wIdMotivo);

  sSQLValues := sSQLValues +', ''B'' ';

  If prmIdMotivoContrib = -1 Then Exit;

  sSQLValues := sSQLValues +','+ RetornaIdTitular(QryContribProc.FieldbyName('IDRESPNUCLEO').AsString,//henrique Sol 108902
  QryBenefProc.FieldbyName('IDPLANOPREV').AsString,iProcessoNumero,iBeneficio);// Fanuel Junior SOL157444/5301 Kintana1329006

  // Inclui Registro no Banco de Dados
  With QryAux Do Begin
    Close;
    SQL.Clear;
    SQL.Add(' INSERT INTO HSTCONTRIBPREV (MESREFERENCIA,MESCOBRANCA,NUMRECEBIMENTO,    '+
            '                             CODPORTFORMA,DATAPREVISAORECE,               '+
            '                             VALORESPERADO,VALORCALCULADO, FLGDEVOLUCAO, IDREGRACALCULO, '+
            '                             FLGDESCFOLHA,IDPESSOA,SEQPROPOSTA,IDPESSJUR,IDPLANOPREV,IDCONTRIBUICAO, '+
            '                             FLGCALCRESERVA,VALOROP1,VALOROP2,VALOROP3,DATAINICIO,DATAFINAL,         '+
            '                             FLGSITFUNDACAO,SITRECEBIMENTO,TIPO,IDLOTE,PARCELA,                      '+
            '                             VALORRECEBIDO, DATARECEBIMENTO, FLGCONCESSAO, FLGEVENTO,                '+
            '                             DATAEMISSCOB,  FLGINTEVENTO, IDMOTIVO, FOLHAORIGEM, IDTITULAR ) '+
            ' VALUES('+ sSQLValues +')');
    Try
       Execsql;
    Except
       //       sMsgErro := 'Erro na gravação do Histórico de Contribuições. ';
       //         MsgDlg('Erro ao inserir registro no Histórico de Contribuições,'+#13
       //                'provavelmente já existe um lancamento desta contribuição em '+
       //                QuotedStr(psMesReferencia)+'.','Erro',mtError, [mbOk, mbHelp],0);
       Raise;
       bErro := True;
       Result:= False;
       Exit;
    End;

  End;



  Result := True;

End;


Function PreparaContribNucleo(QryBenefProc, QryContribProc, QryAux : TwwQuery;
                              idNucleoFamiliar, idcontribuicao,
                              iNumeroProcesso, iIdPessJur,
                              iIdPlanoPrev,iIdTitular, iIdPessoa, iIdBeneficio,
                              iIdLoteConcessao : longint ;
                              sAnoMesLoteConcessao, psAnoMesRefCalculo : String;
                              wPrimeiroPagamento : Boolean;
                              wAnoMesRef, wAnoMesFinal : String;
                              Var sMotivoAtraso : String;
                              iIdLoteRevisao : longint = -1;
                              psDataEncerramento : String = '';
                              piOrigem : Integer = 0):Boolean;
Var
  sSQL  : String;
  bExecutaAcertos, bErro, bEhAbonoEncerramento, bDevolveAdiantamento : Boolean;
  iIdLoteHistorico : LongInt;

  sValorAdiantamento,
  sDataInicio, sValorRegra, sDataRef :String;

  Inteiro:Integer;
  dValorIntegral, dValorAtual, dValorTotalAux, wValorRegra:Double;
  dValorBUA, dValorRegra: Double; //BRUNO AZEVEDO SOL 168512 KINTANA 1494037
Begin
   // Inicia Resultado
   Result := False;
   bEhAbonoEncerramento := False;
   bDevolveAdiantamento := False;

   { passar data de referencia do processo }
   if (StrToInt(copy(QryContribProc.FieldByName('DATAINICIO').AsString,1,2)) >= 29) and
      (StrToInt(copy(wAnoMesRef,6,2)) = 2)
   then sDataRef := '28/'+copy(psAnoMesRefCalculo,6,2) + '/' + copy(psAnoMesRefCalculo,1,4)
   else sDataRef := copy(QryContribProc.FieldByName('DATAINICIO').AsString,1,2)+ '/' +
                    copy(psAnoMesRefCalculo,6,2) + '/' + copy(psAnoMesRefCalculo,1,4);

   { Tratar abono de encerramento }
   if (StrToInt(copy(sDataRef,4,2)) >= 13) and (Trim(psDataEncerramento) <> '')
   then begin
     sDataRef := copy(sDataRef,1,2)+ '/' +copy(psDataEncerramento,4,2) + '/' + copy(sDataRef,7,4);
     bEhAbonoEncerramento := True;
   end;

   if (StrToInt(copy(sDataRef,4,2)) = 13) // SOL 220779 Kintana 2053983
   then begin
     sDataRef := copy(sDataRef,1,2)+ '/' +'11'+ '/' + copy(sDataRef,7,4);
   end; // SOL 220779 Kintana 2053983


   If (Copy(sDataRef,1,2) = '31') And (Pos(Copy(sDataRef,4,2), '04060911') <> 0) Then Begin
     sDataRef := '30'+Copy(sDataRef,3,9)
   End;

   If (Copy(sDataRef,4,2) = '02') And (Copy(sDataRef,1,2) > '28') Then Begin
     sDataRef := '28'+Copy(sDataRef,3,9)
   End;

   { Tratamento de Lote para revisão }
   If ( iIdLoteRevisao <> -1 ) Then Begin

      If ( ( piOrigem = 4 ) And ( bEhAbonoEncerramento = True ) ) Then
      Begin

        { No caso de encerramento devolver o valor pago no adiantamento }

        sSQL := 'SELECT '+
                '  ( SUM( DECODE( FLGDEVOLUCAO,1,H.VALORRECEBIDO * -1, H.VALORRECEBIDO) ) ) AS VALORRECEBIDO  '+

                'FROM   '+
                '  HSTCONTRIBPREV H '+

                'WHERE  '+
                '  H.IDPESSOA       = '+QryContribProc.FieldbyName('IDRESPNUCLEO').AsString    + ' AND ' +
                '  H.MESREFERENCIA  = '+QuotedStr( wAnoMesRef )                                + ' AND ' +
                '  H.IDTITULAR        = '+QryBenefProc.FieldbyName('IDTITULAR').AsString         + ' AND ' +//Fanuel Junior SOL 157444/5301 Kintana 1329006

                '  NVL( H.VALORRECEBIDO, 0 )  > 0 '                                            + ' AND ' +

                '  H.IDCONTRIBUICAO = '+QryContribProc.FieldByName('IDCONTRIBUICAO').AsString  + ' AND ' +
                '  H.SEQPROPOSTA    = '+QryBenefProc.FieldbyName('SEQPROPOSTA').AsString       + '     ' +

                'GROUP BY '+
                '  H.SITRECEBIMENTO ';

        If FazQuery(QryAux,sSQL) Then Begin

          If ( QryAux.FieldByName('VALORRECEBIDO').AsFloat > 0 ) Then
          Begin

            sValorAdiantamento   := OraNumero( QryAux.FieldByName('VALORRECEBIDO').AsString );
            bDevolveAdiantamento := True;

            iIdLoteHistorico     := iIdLoteRevisao;

          End;

        End;

      End Else Begin

        // Para casos de revisão, se o benefício não teve diferença, o sistema não insere o mês
        // no histórico e, esta parte do sistema não recalcula as contribuições por
        // não achar valor no lote de revisão

        // Estou inserindo uma verificação para ver se o sistema inseriu o benefício no mês
        // caso não, como não tem diferença, não passo o lote para que o sistema leia o valor pago
        // anteriormente

        QryAux.Close;
        QryAux.SQL.Clear;

        QryAux.SQL.Add(' SELECT * '+ // Felipe A. Santos SOL 182092/14207 15207 15253 KITANTA 1969056
                       ' FROM   HSTBENEFBFCIARIO H '+
                       ' WHERE  (H.IDPESSJUR        = '+IntToStr(iIdPessJur)   +')   '+
                       ' AND    (H.IDPLANOPREV      = '+IntToStr(iIdPLANOPREV) +')   '+
                       ' AND    (H.IDPESSOA         = '+IntToStr(iIdPESSOA)    +')   '+
                       ' AND    (H.IDTITULAR        = '+IntToStr(iIdTitular)   +')   '+
                       ' AND    (H.MESREFERENCIA    = '''+wAnoMesRef+''') '+
                       ' AND    (H.NUMEROPROCESSO   = '''+IntToStr(iNumeroProcesso)+''')  '+
                       ' AND    (H.IDLOTE           = '''+IntToStr(iIdLoteRevisao)+''')       ');

        QryAux.Open;

        if qryaux.isempty then
          iIdLoteHistorico := -1
        else
        begin
          iIdLoteHistorico := iIdLoteRevisao;
          dValorIntegral := QryAux.FIELDBYNAME('VALORCALCULADO').ASFLOAT; // SOL 234593 PPM 433446  // SOL 235731 PPM 455393
          dValorTotalAux := QryAux.FIELDBYNAME('VALORTOTAL').AsFloat  // SOL 234593 PPM 433446      // SOL 235731 PPM 455393
        end;
      End;

   End Else
      iIdLoteHistorico := iIdLoteConcessao;

   wValorRegra := CalcBeneficioNoMes( dtmAPrev.qry,
                                      iNumeroProcesso,
                                      iIdPessJur,
                                      iIdPlanoPrev,
                                      iIdTitular,
                                      iIdPessoa,
                                      wAnoMesRef,
                                      iIdLoteHistorico,
                                      'S',
                                      'R',
                                      iIdBeneficio); { Valor Prev - Rateado }

   // Felipe A. Santos SOL 182092/14207 15207 15253 KITANTA 1969056
   { Busca valor integral para passar para regra }
   {dValorIntegral := CalcBeneficioNoMes( dtmAPrev.qry,
                                         iNumeroProcesso,
                                         iIdPessJur,
                                         iIdPlanoPrev,
                                         iIdTitular,
                                         iIdPessoa,
                                         wAnoMesRef,
                                         iIdLoteHistorico,
                                         'S',
                                         'I',
                                         iIdBeneficio); { Valor Integral - Pro-Rata
   }

   // Felipe A. Santos SOL 182092/14207 15207 15253 KITANTA 1969056


   //BRUNO AZEVEDO SOL 168512 KINTANA 1494037
   with dtmAPrev.qry do begin
     Close;
     Sql.Clear();
     // SOL 168512.7363 KINTANA 1524288 comentado e incluido nova linha com NVL
     //Sql.Add('SELECT SUM(DECODE(HBF1.FLGDEVOLUCAO,1,-HBF1.VALORPREV,HBF1.VALORPREV)) VALORBUA ');
     Sql.Add(' SELECT NVL(SUM(NVL(DECODE(HBF1.FLGDEVOLUCAO, 1, -HBF1.VALORPREV, HBF1.VALORPREV), 0)), 0) VALORBUA ');// SOL 168512.7363 KINTANA 1524288
     Sql.Add(' FROM   HSTBENEFBFCIARIO HBF1 ');
     Sql.Add(' WHERE (HBF1.IDPESSOA = ' +IntToStr(iIdPessoa)+ ' ) AND ');
     Sql.Add(' (HBF1.IDTITULAR = '+IntToStr(iIdTitular)+') AND ');
     Sql.Add(' (HBF1.IDPLANOPREV = '+IntToStr(iIdPlanoPrev)+') AND ');
     Sql.Add(' (HBF1.IDPESSJUR = '+IntToStr(iIdPessJur)+') AND ');
     Sql.Add(' (HBF1.MESREFERENCIA = '+QuotedStr(wAnoMesRef)+') AND ');
     Sql.Add(' (HBF1.IDBENEFICIO IN (483,518,484,520,508,509,515,507,506,251,327,517,319,252)) ');
     Open;

     dValorBUA := FieldByName('VALORBUA').AsFloat;
   end;
   //BRUNO AZEVEDO SOL 168512 KINTANA 1494037

   //caso na função GeraContribBenef tenha mudado o nucleo ou a contribuição processada,
   //então inserir no histórico o valor acumulado. caso não, acumular valor

   if bInserirHistoricoNucleo then begin

      wValorRegra    :=  wValorRegra + dValorPrevPorNucleoContrib;
      //dValorIntegral :=  dValorIntegral + dValorPorNucleoContrib; // Felipe A. Santos

      sDataInicio := QryContribProc.FieldByName('DATAINICIO').AsString;
      If psDataEncerramento <> '' Then
        sDataInicio := psDataEncerramento
      Else
        psDataEncerramento := ' ';

      //BRUNO AZEVEDO SOL 168512 KINTANA 1494037
      //If not (wPrimeiroPagamento) then begin  //SOL 168512.7363 KINTANA 1524288
        sSQL := 'SELECT 1 AS FLGCONCESSAO,                                       '+
                OraNumero(FloatToStr(wValorRegra))          +' AS VLBENEFPGTO,   '+
                OraNumero(FloatToStr(wValorRegra))          +' AS VALORATUAL,    '+
                OraNumero(FloatToStr(dValorIntegral))       +' AS VALORINTEGRAL, '+
                OraNumero(FloatToStr(wValorRegra))          +' AS VALORPROVENTO, '+
                //BRUNO AZEVEDO SOL 168512 KINTANA 1494037
                OraNumero(FloatToStr(dValorBUA))            +' AS VALORBUARA, '+
                //BRUNO AZEVEDO SOL 168512 KINTANA 1494037
                QuotedStr(PreparaStrRegra(sDataInicio))     +' AS DATAINICIO,  '+
                QuotedStr(PreparaStrRegra(QryContribProc.FieldByName('DATAFINAL').AsString))    +' AS DATAFINAL,   '+
                QuotedStr(wAnoMesRef)    +' AS MESREFERENCIA,   '+
                QuotedStr(wAnoMesRef)    +' AS ANOMESREF,   '+
                IntToStr(iIdPessjur)     +' AS IDPESSJUR,   '+
                IntToStr(iIdPlanoPrev)   +' AS IDPLANOPREV, '+
                IntToStr(iIdTitular)     +' AS IDTITULAR,   '+
                IntToStr(iIdPessoa)      +' AS IDPESSOA,    '+
                IntToStr(iIdBeneficio) +' AS IDBENEFICIO  '+
                ' ,'''+sDataRef+''' DATAREF, '+
                ' '+IntToStr(iNumeroProcesso)+' AS NUMEROPROCESSO,   '+
                QuotedStr(psDataEncerramento)+' AS DATAENCERRAMENTO, '+

                ' '+IntToStr(piOrigem)        +' AS ORIGEM,         '+
                ' '+IntToStr(iIdLoteConcessao)+' AS IDLOTE,         '+
                ' '+IntToStr(iIdLoteRevisao)  +' AS IDLOTEREVISAO,   '+
                ' '+OraNumero(FloatToStr(dValorTotalAux))  +' AS VALORTOTAL   '+  // Felipe A. Santos SOL 182092/14207 15207 15253 KITANTA 1969056 // SOL 234593 PPM 433446 // SOL 235731 PPM 455393
                'FROM DUAL ';

        sValorRegra := RegraNumerica(QryContribProc.FieldByName('IDREGRACALCULO').AsString,
                                     sSQL, bErro, Inteiro );

        Try
          //BRUNO AZEVEDO SOL 168512 KINTANA 1494037
          dValorRegra := StrToFloat(ClienteNumero(sValorRegra));
        Except
          MsgDlg('A Regra de Cálculo  Nº '+QryContribProc.FieldByName('IDREGRACALCULO').AsString+' retornou um valor inválido.',
                 'Erro',mtError,[mbOk,mbHelp],0);
          Exit;
        End;
      //end;

      If (wPrimeiroPagamento = True) And
         (Trim(QryContribProc.FieldByName('IDREGRAPRIMPAGTO').AsString) <> '')
      Then Begin

         sSQL := 'SELECT 1 AS FLGCONCESSAO,     '+
              OraNumero(FloatToStr(wValorRegra))          +' AS VALORREFERENCIA, '+
              OraNumero(FloatToStr(wValorRegra))          +' AS VLBENEFPGTO,   '+
              OraNumero(FloatToStr(wValorRegra))          +' AS VALORATUAL,    '+
              OraNumero(FloatToStr(dValorIntegral))       +' AS VALORINTEGRAL, '+
              OraNumero(FloatToStr(wValorRegra))          +' AS VALORPROVENTO, '+
              //BRUNO AZEVEDO SOL 168512 KINTANA 1494037
              OraNumero(FloatToStr(dValorBUA))            +' AS VALORBUARA, '+
              //BRUNO AZEVEDO SOL 168512 KINTANA 1494037
              QuotedStr(PreparaStrRegra(QryContribProc.FieldByName('DATAINICIO').AsString)) +' AS DATAINICIO,  '+
              QuotedStr(PreparaStrRegra(QryContribProc.FieldByName('DATAFINAL').AsString))  +' AS DATAFINAL,   '+
              IntToStr(iIdPessjur)    +' AS IDPESSJUR,   '+
              IntToStr(iIdPlanoPrev)  +' AS IDPLANOPREV, '+
              IntToStr(iIdTitular) +' AS IDTITULAR,   '+
              IntToStr(iIdPessoa) +' AS IDPESSOA,    '+
              IntToStr(iIdBeneficio) +' AS IDBENEFICIO  '+
              ' ,'''+sDataRef+''' DATAREF, '+
              ' '+IntToStr(iNumeroProcesso)+' NUMEROPROCESSO, '+

              QuotedStr(psDataEncerramento)+' AS DATAENCERRAMENTO, '+
              ' '+IntToStr(piOrigem)        +' AS ORIGEM,         '+
              ' '+IntToStr(iIdLoteConcessao)+' AS IDLOTE,          '+
              ' '+IntToStr(iIdLoteRevisao)  +' AS IDLOTEREVISAO    '+

              'FROM DUAL ';

         { Executa Regra de Primeiro Pagamento }
         sValorRegra := RegraNumerica(QryContribProc.FieldByName('IDREGRAPRIMPAGTO').AsString,
                                      sSQL, bErro, Inteiro );

         Try
           //BRUNO AZEVEDO SOL 168512 KINTANA 1494037
           dValorRegra := StrToFloat(ClienteNumero(sValorRegra));
         Except
           MsgDlg('A Regra de Primeiro Pagamento Nº '+QryContribProc.FieldByName('IDREGRAPRIMPAGTO').AsString+' retornou um valor inválido.',
                  'Erro',mtError,[mbOk,mbHelp],0);
           Exit;
         End;

      End;



      { Executa Regra de Ultimo Pagamento caso seja. }
      If (wAnoMesRef = wAnoMesFinal) And
         (Trim(QryContribProc.FieldByName('IDREGRAULTPAGTO').AsString) <> '')
      Then Begin
         sSQL := 'SELECT 1 AS FLGCONCESSAO,     '+
                   OraNumero(FloatToStr(wValorRegra))          +' AS VALORREFERENCIA, '+
                   OraNumero(FloatToStr(wValorRegra))          +' AS VLBENEFPGTO,   '+
                   OraNumero(FloatToStr(wValorRegra))          +' AS VALORATUAL,    '+
                   OraNumero(FloatToStr(dValorIntegral))       +' AS VALORINTEGRAL, '+
                   OraNumero(FloatToStr(wValorRegra))          +' AS VALORPROVENTO, '+
                   QuotedStr(PreparaStrRegra(QryContribProc.FieldByName('DATAINICIO').AsString))   +' AS DATAINICIO,  '+
                   QuotedStr(PreparaStrRegra(QryContribProc.FieldByName('DATAFINAL').AsString))    +' AS DATAFINAL,   '+
                   IntToStr(iIdPessjur)    +' AS IDPESSJUR,   '+
                   IntToStr(iIdPlanoPrev)  +' AS IDPLANOPREV, '+
                   IntToStr(iIdTitular) +' AS IDTITULAR,   '+
                   IntToStr(iIdPessoa) +' AS IDPESSOA,    '+
                   IntToStr(iIdBeneficio) +' AS IDBENEFICIO  '+
                   ' ,'''+sDataRef+''' DATAREF, '+
                   ' '+IntToStr(iNumeroProcesso)+' NUMEROPROCESSO '+

                   QuotedStr(psDataEncerramento)+' AS DATAENCERRAMENTO, '+
                   ' '+IntToStr(piOrigem)        +' AS ORIGEM,          '+
                   ' '+IntToStr(iIdLoteConcessao)+' AS IDLOTE,          '+
                   ' '+IntToStr(iIdLoteRevisao)  +' AS IDLOTEREVISAO    '+

                   'FROM DUAL ';

         { Executa Regra de Ultimo Pagamento }
         sValorRegra := RegraNumerica(QryContribProc.FieldByName('IDREGRAPRIMPAGTO').AsString,
                                      sSQL, bErro, Inteiro );
         Try
            //BRUNO AZEVEDO SOL 168512 KINTANA 1494037
            dValorRegra := StrToFloat(ClienteNumero(sValorRegra));
         Except
            MsgDlg('A Regra de Ultimo Pagamento Nº '+QryContribProc.FieldByName('IDREGRAULTPAGTO').AsString+' retornou um valor inválido.',
                   'Erro',mtError,[mbOk,mbHelp],0);
            Exit;
         End;
      End;

      If (Trim(psDataEncerramento) = '') Then Begin

        if  (iIdLoteHistorico <> -1) and (iIdLoteConcessao = -1)
        then iIdLoteHistorico  := iIdLoteRevisao
        else if (iIdLoteConcessao <> -1)
        then iIdLoteHistorico  := iIdLoteConcessao
        else  iIdLoteHistorico := iIdLoteRevisao;

      End Else Begin
          iIdLoteHistorico := iIdLoteRevisao
      End;

      If ( ( piOrigem = 4 ) And ( sValorRegra = '0.00' ) )
      Then Begin

        Result := True;

      End Else Begin

        bExecutaAcertos := True;

        If ( ( bEhAbonoEncerramento = True ) or ( piOrigem = 2 ) )Then bExecutaAcertos := False; { CPrev Augusto 16/11/2007 }

        If Not InsereHistContrib(QryBenefProc, QryContribProc, QryAux,
                                 wAnoMesRef, sAnoMesLoteConcessao, sValorRegra,
                                 iIdLoteHistorico, sMotivoAtraso,
                                 bExecutaAcertos ) { Não fazer acerto financeiro }
        Then Begin
          Result := False;
          Exit;
        End;

      End;

      If ( bDevolveAdiantamento = True ) Then
      Begin

        bAcertoPorEncerramentoNucleo := True;

        sValorAdiantamento := OraNumero( FloatToStr( -StrToFloat(ClienteNumero(sValorAdiantamento)) ) );

        If Not InsereHistContrib(QryBenefProc, QryContribProc, QryAux,
                                 wAnoMesRef, sAnoMesLoteConcessao,
                                 sValorAdiantamento, { Negativo para FLGDEVOLUCAO 1 }
                                 iIdLoteHistorico, sMotivoAtraso,
                                 False ) { Não fazer acerto financeiro }
        Then Begin
          Result := False;
          Exit;
        End;

      End;

   end else begin

      dValorPrevPorNucleoContrib := dValorPrevPorNucleoContrib + wValorRegra;
      dValorPorNucleoContrib     := dValorPorNucleoContrib + dValorIntegral;

   end;

   Result := True;
End;



Function GeraContribBenef(QryBenefProc, QryContribProc, QryAux : Twwquery;
                          strConcedidos : String;
                          iNumeroProcesso, iIdLoteConcessao  : LongInt;
                          sAnoMesLoteConcessao, sDataEvento : String;
                          psAnoMesInicio : String = '';
                          sMotivoAtraso : String = '';
                          iIdLoteRevisao : LongInt = -1;
                          psDataEncerramento : String = '';
                          piOrigem : Integer = 0;
                          strContribuicoes : String = '';
                          strBeneficios    : String = '';
                          idLoteProcessado : String ='';
                          bVeioCalcRetroativo : Boolean = False
                          ;iIdSitBeneficio    : Integer = -1 //Renato Visoni SOL 157416 Kintana 1259334
                          ;iIdBeneficio : Integer = -1 //Fanuel Junior SOL 157444/5301 Kintana 1329006
                          ;iIdPessoa : Integer = -1):Boolean;//Fanuel Junior SOL 159581 KINTANA 1314351
Var
  sAnoMesAtual,  sAnoMesInicioLocal, sAnoMesFinal,
  wUltAnoPrep, wUltMesPrep, sSQL, sAnoMesRefCalculo : String;
  wPrimeiroPagamento, bErro : Boolean;
  wIdPlano, wIdTitular, wIdBenef, wIdBeneficio,
  wIdNucleofamiliair, wNumProcesso : Integer;
  bEhMesAbono, bCalculandoAnobo, PossuiNucleo:Boolean;
  sAnoAbonado : String;     // Daniel Begnami SOL:107000

  qryConsultaBeneficio : twwQuery; //Renato Visoni SOL 118834 Kintana 565073
  bProcessa : Boolean; //Renato Visoni SOL 118834 Kintana 565073
  sMesAbonado: String; //Renato Visoni SOL 118834 Kintana 565073
Begin
  Result:=True;

  QryContribProc.close;
  QryContribProc.sql.clear;
  QryContribProc.sql.Add('SELECT DISTINCT  '+
                         '  CN.IDCONTRIBUICAO, CN.IDNUCLEOFAMILIAR,  CN.DATAINICIO,       CN.DATAFINAL,      '+
                         '  CN.ULTMESPREPARO,  CN.FLGCOBRA,          CTP.IDREGRACALCULO,  CTP.IDPLANOPREV,   '+
                         '  CTP.IDRUBRICA,     CTP.IDREGRAPRIMPAGTO, CTP.IDREGRAULTPAGTO, CTP.CODPORTFORMA,  '+
                         '  CTP.FLGDESCFOLHA,  CTP.FLGNAOEXIGEREC,   CON.NOME,            NF.IDRESPNUCLEO    '+
                         'FROM BENEFBFCIARIO BF, BENEFICIO B, BENEFPLANPREV BPL, SITBENEFICIO S,          '+
                         '     BENEFPLANOPART BPART, BFCIARIOTITPLAN BTIT, PESSOA P, TPPAGTOBENEFICIO TP, '+
                         '     CONTRIBPREVNUCLEO CN, CM.CONTPREV CTP, CM.CONTRIBUICAO CON, CM.NUCLEOFAMILIAR NF '+
                         'WHERE  BF.NUMEROPROCESSO = '+IntToStr(iNumeroProcesso)+' '+                         
                         'AND    BF.IDPESSOA       = P.IDPESSOA '+
                         'AND    B.IDBENEFICIO     = BF.IDBENEFICIO '+
                         'AND    BPL.IDBENEFICIO   = BF.IDBENEFICIO '+
                         'AND    BPL.IDPLANOPREV   = BF.IDPLANOPREV '+
                         'AND    BF.IDSITBENEFICIO = S.IDSITBENEFICIO(+) '+
                         'AND    BF.IDTITULAR      = BPART.IDPESSOA(+) '+
                         'AND    BF.SEQPROPOSTA    = BPART.SEQPROPOSTA(+) '+
                         'AND    BF.IDPESSJUR      = BPART.IDPESSJUR(+) '+
                         'AND    BF.IDPLANOPREV    = BPART.IDPLANOPREV(+) '+
                         'AND    BF.IDBENEFICIO    = BPART.IDBENEFICIO(+) '+
                         'AND    BF.IDPLANOORIGEM  = BTIT.IDPLANOORIGEM '+
                         'AND    BF.IDPLANOPREV    = BTIT.IDPLANOPREV '+
                         'AND    BF.IDTITULAR      = BTIT.IDTITULAR '+
                         'AND    BF.IDPESSJUR      = BTIT.IDPESSJUR '+
                         'AND    BF.IDPESSOA       = BTIT.IDPESSOA '+
                         'AND    BF.IDBENEFICIO    = BTIT.IDBENEFICIO '+
                         'AND    BF.SEQPROPOSTA    = BTIT.SEQPROPOSTA '+
                         'AND    BPL.FLGREFERENCIA = 0  '+
                         'AND    TP.IDTPPAGTOBENEFIC = B.IDTPPAGTOBENEFIC '+
                         'AND    TP.FLGFREQUENCIA <> ''U''  '+
                         'AND    CN.IDNUCLEOFAMILIAR = BTIT.IDNUCLEOFAMILIAR '+
                         'AND    CTP.IDCONTRIBUICAO   = CN.IDCONTRIBUICAO  '+
                         'AND    CTP.IDPLANOPREV = BF.IDPLANOPREV  '+
                         'AND    CON.IDCONTRIBUICAO   = CN.IDCONTRIBUICAO   '+
                         'AND    NF.IDNUCLEOFAMILIAR = CN.IDNUCLEOFAMILIAR  ');

       // Fanuel Junior SOL157444/5301 Kintana1329006
       iProcessoNumero  :=  iNumeroProcesso;
       iBeneficio       :=  iIdBeneficio;

       //Fanuel Junior SOL 159581 KINTANA 1314351
       if(iIdPessoa <> -1) then
          QryContribProc.Sql.Add('AND  BF.IDPESSOA = ('+IntToStr(iIdPessoa)+')');


       if trim(strContribuicoes) <> '' then begin
         QryContribProc.Sql.Add('AND CN.IDCONTRIBUICAO IN ('+Trim(strContribuicoes)+')');
       End;

       { Caso seja revisão de beneficio, filtrar a data de inicio da contribuição }
       If ( piOrigem = 6 ) Then Begin

         QryContribProc.Sql.Add('AND ( ( CN.DATAFINAL IS NULL ) OR ( TO_CHAR( CN.DATAFINAL, ''YYYY/MM'' ) >= ' + QuotedStr( psAnoMesInicio )+ ' ) )');

       End;

       If iIdLoteRevisao = -1 Then
         QryContribProc.sql.Add('AND    CN.ULTMESPREPARO <= '+QuotedStr(sAnoMesLoteConcessao)+' ');

       QryContribProc.sql.Add('ORDER BY CN.IDNUCLEOFAMILIAR, CN.IDCONTRIBUICAO ' );

  QryContribProc.open;

  sAnoMesInicioLocal := psAnoMesInicio;
  while not QryContribProc.eof do begin

     sAnoAbonado :=''; //Renato Visoni SOL 154118 Kintana 1169202

     wIdNucleoFamiliair := QryContribProc.FieldByName('IDNUCLEOFAMILIAR').AsInteger;

     // Prepara e abre consulta dos beneficiarios a serem processados
     QryBenefProc.Close;
     QryBenefProc.Sql.Clear;
     QryBenefProc.Sql.Add('SELECT BTIT.IDNUCLEOFAMILIAR, BF.NUMEROPROCESSO,    BF.IDPESSJUR,       BF.IDPLANOPREV, '+
                          'BF.IDTITULAR, '+
                          'BF.IDPESSOA,          BF.SEQPROPOSTA,     BF.IDBENEFICIO, '+
                          'BF.CODPORTFORMA,      BF.IDSITBENEFICIO,  BF.IDDEPENDENCIA, '+
                          'BF.IDTPPAGTOBENEFIC,  BF.VALORATUAL,      BF.DATAREQUERIMENTO, '+
                          'BF.DATAINICIO,        BF.DATAFINAL,        '+
                          'BF.FLGFORMAPAGTO,     BF.VALORCALCULADO,  BF.DATAULTREAJUSTE, '+
                          'BF.VLRCALCINSS,       BF.VLRINFINSS,      BF.DATAINICIOINSS, '+
                          'BF.NUMPROCINSS,       BF.DATAINICIOFUND,  BF.VALORCOTAS, '+
                          'BF.VALORTOTAL,        BF.DATACONCESSAO,   BF.FLGPROVISORIO, '+
                          'BF.PERCPROVISORIO,    BF.PRAZOPROVISORIO, BF.ULTMESREAJUSTE, '+
                          'BF.ULTVALORATUALREAJ, BF.IDAGENCIARESGATE,B.NUMORDEMEVENTO, '+
                          'B.NOME,               S.DESCRICAO, '+
                          'B.FLGRESGATE,         BF.VALORBASE1,      BF.VALORBASE2, '+
                          'BF.VALORBASE3,        P.NOME DEPEN,       BTIT.IDRESPONSAVEL,    CN.IDCONTRIBUICAO, '+
                          'CN.IDNUCLEOFAMILIAR,  CN.DATAINICIO,      CN.DATAFINAL,     '+
                          'CN.ULTMESPREPARO,     CN.FLGCOBRA,        CTP.IDREGRACALCULO,    CTP.IDPLANOPREV,   '+
                          'CTP.IDRUBRICA,        CTP.IDREGRAPRIMPAGTO, CTP.IDREGRAULTPAGTO, CTP.CODPORTFORMA,  '+
                          'CTP.FLGDESCFOLHA,     CTP.FLGNAOEXIGEREC,   CON.NOME,            NF.IDRESPNUCLEO    '+
                          'FROM   BENEFBFCIARIO BF, BENEFICIO B, BENEFPLANPREV BPL, SITBENEFICIO S, '+
                          'BENEFPLANOPART BPART, BFCIARIOTITPLAN BTIT, PESSOA P, TPPAGTOBENEFICIO TP, '+
                          'CONTRIBPREVNUCLEO CN, CM.CONTPREV CTP, CM.CONTRIBUICAO CON, CM.NUCLEOFAMILIAR NF '+
                          'WHERE '+
                          '       BF.IDPESSOA       = P.IDPESSOA '+
                          'AND    B.IDBENEFICIO     = BF.IDBENEFICIO '+
                          'AND    BPL.IDBENEFICIO   = BF.IDBENEFICIO '+
                          'AND    BPL.IDPLANOPREV   = BF.IDPLANOPREV '+
                          'AND    BF.IDSITBENEFICIO = S.IDSITBENEFICIO(+) '+
                          'AND    BF.IDTITULAR      = BPART.IDPESSOA(+) '+
                          'AND    BF.SEQPROPOSTA    = BPART.SEQPROPOSTA(+) '+
                          'AND    BF.IDPESSJUR      = BPART.IDPESSJUR(+) '+
                          'AND    BF.IDPLANOPREV    = BPART.IDPLANOPREV(+) '+
                          'AND    BF.IDBENEFICIO    = BPART.IDBENEFICIO(+) '+
                          'AND    BTIT.IDNUCLEOFAMILIAR = '+QryContribProc.fieldbyname('IDNUCLEOFAMILIAR').AsString+' '+
                          'AND    BF.IDPLANOORIGEM  = BTIT.IDPLANOORIGEM '+
                          'AND    BF.IDPLANOPREV    = BTIT.IDPLANOPREV '+
                          'AND    BF.IDTITULAR      = BTIT.IDTITULAR '+
                          'AND    BF.IDPESSJUR      = BTIT.IDPESSJUR '+
                          'AND    BF.IDPESSOA       = BTIT.IDPESSOA '+
                          'AND    BF.IDBENEFICIO    = BTIT.IDBENEFICIO '+
                          'AND    BF.SEQPROPOSTA    = BTIT.SEQPROPOSTA '+
                          'AND    BPL.FLGREFERENCIA = 0  '+
                          'AND    TP.IDTPPAGTOBENEFIC = B.IDTPPAGTOBENEFIC '+
                          'AND    TP.FLGFREQUENCIA <> ''U''  '+
                          'AND    CN.IDNUCLEOFAMILIAR = BTIT.IDNUCLEOFAMILIAR '+
                          'AND    CN.IDCONTRIBUICAO = '+QryContribProc.fieldbyname('IDCONTRIBUICAO').AsString+' '+
                          'AND    CTP.IDCONTRIBUICAO   = CN.IDCONTRIBUICAO  '+
                          'AND    CTP.IDPLANOPREV = BF.IDPLANOPREV  '+
                          'AND    CON.IDCONTRIBUICAO   = CN.IDCONTRIBUICAO   '+
                          'AND    NF.IDNUCLEOFAMILIAR = CN.IDNUCLEOFAMILIAR  ');

     { Caso seja revisão de beneficio, filtrar os beneficios selecionado na revisão }
     If ( ( piOrigem = 6 ) And ( Trim( strBeneficios ) <> '' ) ) Then Begin
       QryBenefProc.Sql.Add('AND BF.IDBENEFICIO IN ( ' + strBeneficios  +' )' );
     End;

     //Renato Visoni SOL 157416 Kintana 1259334
     if iIdSitBeneficio <> -1 then begin
       QryBenefProc.Sql.Add(' AND BF.IDSITBENEFICIO = '+ intTostr(iIdSitBeneficio));
     end;
     //Renato Visoni SOL 157416 Kintana 1259334
     
     If iIdLoteRevisao = -1 Then
         QryBenefProc.Sql.Add('AND    CN.ULTMESPREPARO <= '+QuotedStr( sAnoMesLoteConcessao )+' ');

     QryBenefProc.Sql.Add(' ORDER BY B.NOME ,  P.NOME ');
     QryBenefProc.Open;

     ExecutarQuery(QryAux,'UPDATE CM.CONTRIBPREVNUCLEO SET '+
                          'FLGCOBRA = 1 '+
                          'WHERE  IDNUCLEOFAMILIAR = '+IntToStr(wIdNucleoFamiliair)+' ');


     { Controle de Primeiro Pagamento }
     wPrimeiroPagamento := True;

     { Guarda ano e mes Inicio }
     If psAnoMesInicio = '' Then Begin
       wUltAnoPrep  := Copy(QryContribProc.FieldByName('DATAINICIO').AsString,7,4);
       wUltMesPrep  := Copy(QryContribProc.FieldByName('DATAINICIO').AsString,4,2);
     End Else Begin
       wUltAnoPrep  := Copy(psAnoMesInicio,1,4);
       wUltMesPrep  := Copy(psAnoMesInicio,6,2);
     End;

     psAnoMesInicio:= wUltAnoPrep+'/'+wUltMesPrep;

     { Guarda ano e mes final }
     sAnoMesFinal := Copy(QryContribProc.FieldByName('DATAFINAL').AsString,7,4)
                     +'/'+
                     Copy(QryContribProc.FieldByName('DATAFINAL').AsString,4,2);

     { Guarda ano de Referencia }
     sAnoMesAtual      := sAnoMesInicioLocal;
     bCalculandoAnobo  := False;
     sAnoMesRefCalculo := sAnoMesAtual;

     { Tratar contribuições com DATAINICIO diferentes }
     If (sAnoMesAtual < Copy(QryContribProc.FieldByName('DATAINICIO').AsString,7,4)+'/'+
                        Copy(QryContribProc.FieldByName('DATAINICIO').AsString,4,2))
     Then Begin
       sAnoMesAtual := Copy(QryContribProc.FieldByName('DATAINICIO').AsString,7,4)+'/'+
                       Copy(QryContribProc.FieldByName('DATAINICIO').AsString,4,2);

       wUltAnoPrep  := Copy(QryContribProc.FieldByName('DATAINICIO').AsString,7,4);
       wUltMesPrep  := Copy(QryContribProc.FieldByName('DATAINICIO').AsString,4,2);

       psAnoMesInicio:= wUltAnoPrep+'/'+wUltMesPrep;
     End;

     { Inicia Processo ate o Ano / Mes de Cobanca (Atual) }
     While (sAnoMesAtual <= sAnoMesLoteConcessao) or (bCalculandoAnobo = True) Do Begin

        if sAnoMesAtual > psAnoMesInicio then wPrimeiroPagamento := false;

        QryBenefProc.first;

        dValorPorNucleoContrib     := 0;
        dValorPrevPorNucleoContrib := 0;
        bInserirHistoricoNucleo    := False;


        { Loop de todos os benef do nucleo/contrib no mês }
        While Not QryBenefProc.eof  Do Begin

           { Guarda dados }
           wIdPlano    := QryBenefProc.FieldByName('IDPLANOPREV').AsInteger;
           wIdTitular  := QryBenefProc.FieldByName('IDTITULAR').AsInteger;
           wIdBenef    := QryBenefProc.FieldByName('IDPESSOA').AsInteger;
           wIdBeneficio:= QryBenefProc.FieldByName('IDBENEFICIO').AsInteger;

           wNumProcesso := QryBenefProc.FieldByName('NUMEROPROCESSO').AsInteger;

           { Testar se é o mesmo núcleo familiar para acumular valor para }
           { lançar apenas uma vez no histórico                           }
           QryBenefProc.next;

           { Nos casos em que exitem mais de um beneficio                               }
           { não podemos testar apenas se existe mais de um registo na consulta         }
           { de beneficios por nucleo, temos que testar tbm se o beneficiário é o mesmo }
           { pois a rotina já calcula a contriuição para todos os beneficios            }
           If (QryBenefProc.Eof) or (wIdBenef = QryBenefProc.FieldByName('IDPESSOA').AsInteger) Then Begin
             bInserirHistoricoNucleo := True;
           End;


           // SOL121126 - Daniel Begnami
           if bVeioCalcRetroativo then
           begin
             //Renato Visoni SOL 118834 Kintana 565073
             bProcessa := True;

             //if Copy(sAnoMesAtual,6,2) <> '13' then  sMesAbonado := sAnoMesAtual;

             if idloteProcessado ='' then idloteProcessado := '-1';
             sMesAbonado := BuscaMesCobrancaLote(strToInt(idloteProcessado), sAnoMesAtual );;

             //sMesAbonado := sMesAnoFinalProcesso;

             if Copy(sAnoMesAtual,6,2) = '13' then begin
               qryConsultaBeneficio               := twwQuery.Create(Application);
               qryConsultaBeneficio.DatabaseName  := 'BaseDados';

               qryConsultaBeneficio.Close;
               qryConsultaBeneficio.SQL.Clear;
               qryConsultaBeneficio.SQL.Add(' SELECT COUNT(*) TOTAL FROM HSTBENEFBFCIARIO');
               qryConsultaBeneficio.SQL.Add(' WHERE IDTITULAR='   + QryBenefProc.FieldByName('IDTITULAR').AsString);
               qryConsultaBeneficio.SQL.Add(' AND IDPESSJUR='     + QryBenefProc.FieldByName('IDPESSJUR').AsString);
               qryConsultaBeneficio.SQL.Add(' AND IDPLANOPREV='   + QryBenefProc.FieldByName('IDPLANOPREV').AsString);
               qryConsultaBeneficio.SQL.Add(' AND IDBENEFICIO='   + QryBenefProc.FieldByName('IDBENEFICIO').AsString);
               qryConsultaBeneficio.SQL.Add(' AND IDPESSOA='      +QryBenefProc.FieldByName('IDPESSOA').AsString);
               qryConsultaBeneficio.SQL.Add(' AND MESREFERENCIA=' + QuotedStr(sAnoMesAtual) );
               qryConsultaBeneficio.SQL.Add(' AND MES=' + QuotedStr(sMesAbonado) );
               qryConsultaBeneficio.SQL.Add(' AND IDMOTIVO ='+ sMotivoAtraso);

               qryConsultaBeneficio.Open;

               bProcessa := (qryConsultaBeneficio.FieldByname('Total').asInteger <> 0);

               qryConsultaBeneficio.Free;
             end;

             if bProcessa then begin //Renato Visoni SOL 118834 Kintana 565073
               if (Not PreparaContribNucleo(QryBenefProc, QryContribProc ,QryAux,
                                            wIdNucleoFamiliair,
                                            QryBenefProc.FieldByName('IDCONTRIBUICAO').AsInteger,
                                            wNumProcesso,
                                            QryBenefProc.fieldbyname('IDPESSJUR').AsInteger,
                                            wIdPlano,
                                            wIdTitular,
                                            wIdBenef,
                                            wIdBeneficio,
                                            iIdLoteConcessao, sAnoMesLoteConcessao, sAnoMesRefCalculo,
                                            wPrimeiroPagamento,  sAnoMesAtual, sAnoMesFinal,
                                            sMotivoAtraso, iIdLoteRevisao,
                                            psDataEncerramento, piOrigem ) ) then
               begin
                  MsgDlg('Erro ao Conceder os Benefícios do Núcleo Familiar.'+#13+
                         'O benefício será mantido como "Pendente de Concessão"  '+
                         'até que o problema seja resolvido. ','Erro',mtError,[mbOk,mbHelp],0);
                  Exit;
               end;
             end;//Renato Visoni

             //Renato Visoni SOL 118834 Kintana 565073
           end
           else
           // SOL121274 KT:42957 - Daniel Begnami
           begin

             if (Not PreparaContribNucleo(QryBenefProc, QryContribProc ,QryAux,
                                          wIdNucleoFamiliair,
                                          QryBenefProc.FieldByName('IDCONTRIBUICAO').AsInteger,
                                          wNumProcesso,
                                          QryBenefProc.fieldbyname('IDPESSJUR').AsInteger,
                                          wIdPlano,
                                          wIdTitular,
                                          wIdBenef,
                                          wIdBeneficio,
                                          iIdLoteConcessao, sAnoMesLoteConcessao, sAnoMesRefCalculo,
                                          wPrimeiroPagamento,  sAnoMesAtual, sAnoMesFinal,
                                          sMotivoAtraso, iIdLoteRevisao,
                                          psDataEncerramento, piOrigem ) ) then
             begin
                MsgDlg('Erro ao Conceder os Benefícios do Núcleo Familiar.'+#13+
                       'O benefício será mantido como "Pendente de Concessão"  '+
                       'até que o problema seja resolvido. ','Erro',mtError,[mbOk,mbHelp],0);
                Exit;
             end;
             // FIM SOL121274

           end;
           // FIM SOf L121126 - Daniel Begnami

        End; { While Not QryBenefProc }

        If bCalculandoAnobo = False Then
        Begin
          // SOL 239916 PPM 528417 para a revisão de beneficio os parametros passados para o metodo EhMesAbono considerava mes de abono
          // qualquer mes passado como parametro que fosse maior que o mes retornado da tabela PLANPREV do campo MESPGABONO
          if piOrigem = 6 then // SOL 239916 PPM 528417 inicio
          begin
             bEhMesAbono  := EhMesAbono(QryAux,
                                        QryBenefProc.fieldbyname('IDPESSJUR').AsInteger,
                                        QryBenefProc.fieldbyname('IDPLANOPREV').AsInteger,
                                        QryBenefProc.fieldbyname('IDBENEFICIO').AsInteger,
                                        sAnoMesAtual,
                                        '', TRUE);

          end
          else // SOL 239916 PPM 528417 Final
          begin
             bEhMesAbono  := EhMesAbono(QryAux,
                                        QryBenefProc.fieldbyname('IDPESSJUR').AsInteger,
                                        QryBenefProc.fieldbyname('IDPLANOPREV').AsInteger,
                                        QryBenefProc.fieldbyname('IDBENEFICIO').AsInteger,
                                        sAnoMesAtual);
          end;
          // Daniel Begnami SOL:107000
          if (sAnoAbonado = Copy(sAnoMesAtual,1,4)) then
            bEhMesAbono := False;
          // Fim

          If (bEhMesAbono = True) Then
          Begin
            bCalculandoAnobo := True;
            { é mes de abono, atualiza data de referencia para 13 }
            sAnoMesAtual:= wUltAnoPrep+'/13';
            sAnoAbonado := Copy(sAnoMesAtual,1,4);  // Daniel Begnami SOL:107000
            Continue;
          End;
        End
        Else
        Begin
          bCalculandoAnobo := False;
        End;

        { Incrementa e Guarda ano e mes do ultimo preparo }
        wUltMesPrep  := IntToStr(StrToInt(wUltMesPrep)+1);

        { Tratamento de avanço na data }
        If StrToInt(wUltMesPrep) < 10  Then wUltMesPrep := '0'+wUltMesPrep;

        If StrToInt(wUltMesPrep) > 12 Then Begin
          wUltAnoPrep := IntToStr(StrToInt(wUltAnoPrep)+1);
          wUltMesPrep := '01';
        End;

        { Remonta Ano Mes }
        sAnoMesAtual:= wUltAnoPrep+'/'+wUltMesPrep;
        sAnoMesRefCalculo := wUltAnoPrep+'/'+wUltMesPrep;
     end; { While - meses a cobrar }


     QryContribProc.next;
  end; { while qrycontribproc }

End;


//******************************************************************************
// Processa Controle de Nucleos Familiares
Function ProcessaNucleoFamiliar(QryDet:TwwQuery; qryNucleoFamiliar: TwwQuery;
                                qryAux: TwwQuery; QryBuscaContrib: TwwQuery;
                                iIdTitular, iIdPessJur, iIdPlanoPrev, iIdEvento : Integer):Boolean;
Var
  bErroRegra,
  bAssociaContrib,
  PossuiNucleo      : boolean;
  sSQLRegra,
  sBeneficiarios, sSQL,
  sBeneficios       : string;
  sIdNucleo : String;
Begin
  sBeneficiarios := '';
  sBeneficios    := '';
  qryDet.First;
  // Preencher beneficios e beneficiarios que estão sendo requeridos neste momento
  while not qryDet.Eof do
  begin
     if Trim(sBeneficiarios) = ''
     then sBeneficiarios := qryDet.FieldByName('IdPessoa').AsString
     else sBeneficiarios := sBeneficiarios+','+qryDet.FieldByName('IdPessoa').AsString;

     if Trim(sBeneficios) = ''
     then sBeneficios := qryDet.FieldByName('IdBeneficio').AsString
     else sBeneficios := sBeneficios+','+qryDet.FieldByName('IdBeneficio').AsString;
     qryDet.Next;
  end;

  //inclui nucleos familiares, pois esta função saiu das telas de cadastro
  //e deve ser feita automaticamente através dos responsáveis cadastrados
  //na bfciariotitplan.
  qryNucleoFamiliar.Close;
  qryNucleoFamiliar.SQL.Clear;
  qryNucleoFamiliar.SQL.Add(' SELECT DISTINCT IDRESPONSAVEL  '+
                            ' FROM   BFCIARIOTITPLAN           '+
                            ' WHERE  IDPESSJUR = '+IntToStr(iIdPessJur)+
                            ' AND    IDPLANOORIGEM = '+IntToStr(iIdPlanoPrev)+
                            ' AND    IDTITULAR   = '+IntToStr(iIdTitular)+' '+
                            ' AND    IDBENEFICIO IN ('+sBeneficios+') '+ 
                            ' AND    IDNUCLEOFAMILIAR IS NULL ');
  qryNucleoFamiliar.Open;

  { Mensagem caso não tenha responsavel cadastrado }
  If (Not qryNucleoFamiliar.isEmpty) and (Trim(qryNucleoFamiliar.fieldbyname('IDRESPONSAVEL').AsString) = '') Then Begin
    MsgDlg('Beneficiario não possui responsável, verifique o cadastro.',
              'Erro', mtError,[mbOk],0);
    Result := False;
    Exit;
  End;

  while not qryNucleoFamiliar.Eof do
  begin
     { Verificar responsavel já possui nucleo }
     sSQL := 'SELECT 1 AS EXISTE FROM CM.NUCLEOFAMILIAR WHERE '+
             ' IDTITULAR    = '+IntToStr(iIdTitular)+' AND '+
             ' IDRESPNUCLEO = '+QryNucleoFamiliar.fieldbyname('IDRESPONSAVEL').AsString;

     If Not FazQuery(QryAux,sSQL) Then Begin
       qryaux.close;
       qryaux.sql.text := ' SELECT SEQNUCLEOFAMILIAR.NEXTVAL AS SEQ FROM DUAL ';
       qryaux.open;
       sIdNucleo := qryaux.fieldbyname('SEQ').AsString;

       qryaux.close;
       qryaux.sql.text := ' INSERT INTO NUCLEOFAMILIAR( IDNUCLEOFAMILIAR, IDRESPNUCLEO, IDTITULAR) '+
                          ' VALUES('''+sIdNucleo+''', '''+qryNucleoFamiliar.fieldbyname('IDRESPONSAVEL').AsString+''', '+
                          ' '''+IntToStr(iIdTitular)+''') ';

       // SOL:109597 Daniel Begnami
       try
         qryaux.execsql;
       except
         MsgDlg('Erro ao inserir na tabela NUCLEOFAMILIAR !','Erro',mtError,[mbOk,mbHelp],0);
         Result := False;
         Exit;
       end;
       // Fim

     End;
     qryNucleoFamiliar.next;
  end;//while

  //ATUALIZA O INDICADOR DO NÚCLEO DO BENEFICIÁRIO
  qryaux.close;
  qryaux.sql.text := ' UPDATE BFCIARIOTITPLAN SET IDNUCLEOFAMILIAR = '+
                     '  (SELECT IDNUCLEOFAMILIAR '+
                     '  FROM NUCLEOFAMILIAR '+
                     '  WHERE IDRESPNUCLEO = BFCIARIOTITPLAN.IDRESPONSAVEL '+
                     '  AND IDTITULAR = BFCIARIOTITPLAN.IDTITULAR  ) '+
                     '  WHERE  IDPESSJUR = '+IntToStr(iIdPessJur)+
                     '  AND    IDPLANOORIGEM = '+IntToStr(iIdPlanoPrev)+
                     '  AND    IDTITULAR   = '+IntToStr(iIdTitular)+' '+
                     '  AND EXISTS '+
                     '  (SELECT IDNUCLEOFAMILIAR '+
                     '  FROM NUCLEOFAMILIAR '+
                     '  WHERE IDRESPNUCLEO = BFCIARIOTITPLAN.IDRESPONSAVEL '+
                     '  AND IDTITULAR = BFCIARIOTITPLAN.IDTITULAR  )';
  // SOL:109597 Daniel Begnami
  try
    qryaux.execsql;
  except
    MsgDlg('Erro ao atualizar a tabela NUCLEOFAMILIAR !','Erro',mtError,[mbOk,mbHelp],0);
    Result := False;
    Exit;
  end;
  // Fim

  Result       := True;
  PossuiNucleo := False;


  // Abrir query com contribuicoes do evento
  QryBuscaContrib.Close;
  QryBuscaContrib.ParamByName('IDEVENTOGERADOR').AsInteger:=iIdEvento;
  QryBuscaContrib.Open;

  // Buscar nucleos familiares existentes para cada beneficiario/beneficio requeridos
  qryNucleoFamiliar.Close;
  qryNucleoFamiliar.SQL.Clear;
  qryNucleoFamiliar.SQL.Add(' SELECT DISTINCT IDNUCLEOFAMILIAR, IDPESSOA'+   //Fanuel Junior SOL 148775/3243 Kintana 1058962
                            ' FROM   BFCIARIOTITPLAN           '+
                            ' WHERE  IDPESSJUR = '+IntToStr(iIdPessJur)+
                            ' AND    IDPLANOORIGEM = '+IntToStr(iIdPlanoPrev)+
                            ' AND    IDTITULAR   = '+IntToStr(iIdTitular)+
                            ' AND    IDPESSOA IN ('+sBeneficiarios+')'+
                            ' AND    IDBENEFICIO IN ('+sBeneficios+')');




  qryNucleoFamiliar.Open;
  qryDet.First;//Fanuel Junior SOL 148775/3243 Kintana 1058962
  // Para cada Nucleo Familiar fazer :
  // 1. Executar regra de associacao da contribuicao
  // 2. Se a regra retornar True, associar contribuicao ao nucleo

  while not qryNucleoFamiliar.Eof do
  begin
     PossuiNucleo := True;
     qryBuscaContrib.First;
     while not qryBuscaContrib.Eof do
     begin
        if qryBuscaContrib.FieldByName('IDREGRAVALIDAASS').AsInteger > 0
        then begin
           sSQLRegra := 'SELECT '+
                        '  BFT.IDPESSJUR,   BFT.IDPLANOPREV,      BFT.IDTITULAR,  BFT.SEQPROPOSTA, BFT.IDPESSOA,'+
                        '  BFT.IDBENEFICIO, BFT.IDNUCLEOFAMILIAR, BFT.PRIORIDADE, BFT.PERCENTUAL,    '+
                        '  PPP.IDSITPLANOPREV '+
                        'FROM  '+
                        '  BFCIARIOTITPLAN BFT, PARTPREVPLAN PPP '+
                        'WHERE '+
                        '      BFT.IDPESSJUR     = '+ IntToStr( iIdPessJur )  +
                        '  AND BFT.IDPLANOORIGEM = '+ IntToStr( iIdPlanoPrev )+
                        '  AND BFT.IDTITULAR     = '+ IntToStr( iIdTitular )  +
                        '  AND BFT.IDPESSOA IN    ('+ sBeneficiarios +')'+
                        '  AND BFT.IDBENEFICIO IN ('+ sBeneficios    +')'+
                        '  AND BFT.IDNUCLEOFAMILIAR = '+ qryNucleoFamiliar.FieldByName('IDNUCLEOFAMILIAR').AsString+
                        '  AND BFT.IDTITULAR     = PPP.IDPESSOA    '+
                        '  AND BFT.IDPLANOORIGEM = PPP.IDPLANOPREV ';

           bAssociaContrib := RegraBooleana(qryBuscaContrib.FieldByName('IDREGRAVALIDAASS').AsString,
                                            sSQLRegra, bErroRegra);
           if bErroRegra
           then Exit;
        end
        else bAssociaContrib := True;

        { Verificar se contribuicao á foi associada }
        sSQL := 'SELECT 1 AS EXISTE FROM CM.CONTRIBPREVNUCLEO WHERE '+
                ' IDCONTRIBUICAO   = '+QryBuscaContrib.FieldByName('IDCONTRIBUICAO').AsString+' AND '+
                ' IDNUCLEOFAMILIAR = '+QuotedStr(QryNucleoFamiliar.FieldByName('IDNUCLEOFAMILIAR').AsString);

        { Caso contribuicao ja tenha sido associada não incluir }
        If FazQuery(QryAux,sSQL) Then Begin
          bAssociaContrib := False;
        End;

       qryDet.Locate('IDPESSOA',qryNucleoFamiliar.FieldByName('IDPESSOA').AsString, []); //Fanuel Junior SOL 148775/3243 Kintana 1058962

        if bAssociaContrib then begin
           qryAux.Close;
           qryAux.SQL.Clear;
           qryAux.SQL.Add(' INSERT INTO CM.CONTRIBPREVNUCLEO       '+
                          ' (IDCONTRIBUICAO, IDNUCLEOFAMILIAR, DATAINICIO, DATAFINAL, '+
                          '  ULTMESPREPARO,  FLGCOBRA) '+
                          'VALUES (    '+
                                  QryBuscaContrib.FieldByName('IDCONTRIBUICAO').AsString+', '+
                                  qryNucleoFamiliar.FieldByName('IDNUCLEOFAMILIAR').AsString+', '+
                               '  TO_DATE('+QuotedStr(qryDet.FieldByName('DATAINICIO').AsString)+',''DD/MM/YYYY''),'+
                               '  TO_DATE('+QuotedStr(qryDet.FieldByName('DATAFINAL').AsString) +',''DD/MM/YYYY''),'+
                               '''0000/00'',0)');
           try
              qryAux.ExecSQL;
           except
              on E:EDBEngineError do
              begin
                Result := False; // SOL:109597
                MostrarErro(E);
                Exit;
              end;

           end;
        end else begin
          If Trim(QryNucleoFamiliar.FieldByName('IDNUCLEOFAMILIAR').AsString) <> '' Then Begin
            qryAux.Close;
            qryAux.SQL.Clear;
            qryAux.SQL.Add('UPDATE CM.CONTRIBPREVNUCLEO SET      '+
                           '  DATAINICIO  =  TO_DATE('+QuotedStr(qryDet.FieldByName('DATAINICIO').AsString)+',''DD/MM/YYYY''), '+
                           '  DATAFINAL   =  TO_DATE('+QuotedStr(qryDet.FieldByName('DATAFINAL').AsString) +',''DD/MM/YYYY'')  '+
                           'WHERE '+
                           '  IDCONTRIBUICAO   = '+QryBuscaContrib.FieldByName('IDCONTRIBUICAO').AsString+' AND '+
                           '  IDNUCLEOFAMILIAR = '+QryNucleoFamiliar.FieldByName('IDNUCLEOFAMILIAR').AsString);

            try
               qryAux.ExecSQL;
            except
               on E:EDBEngineError do
               begin
                 Result := False; // SOL:109597
                 MostrarErro(E);
                 Exit;
               end;
            end;
          End;
        end; // if bAssociaContrib
        qryBuscaContrib.Next;
     end;
     qryNucleoFamiliar.Next;
     qryDet.Next;    //Fanuel Junior SOL 148775/3243 Kintana 1058962
  end;

  if not PossuiNucleo
  then begin
      if MsgDlg('Titular não possui Nucleo Familiar.'+#13+
                'Deseja criar um núcleo para cada beneficiário ?',
                'Confirmação', mtConfirmation,[mbYes,mbNo],0) = mrYes
      then begin
        qryDet.First;
        while not qryDet.EOF do
        begin                                                                                                  
          GeraContribSemNucleo(QryDet, QryBuscaContrib, QryAux,
                               iIdTitular,iIdPessJur ,iIdPlanoPrev,iIdEvento);
          qryDet.Next;
        end;
      end
      else begin
        Result :=False;
        Exit;
      end;
  end;

   Result :=True;

End;

//******************************************************************************
// Gera as Cobtribuicoes dos Nucleos Familiares
Procedure GeraContribSemNucleo(QryDet, QryBuscaContrib, QryAux:TwwQuery;
                               iIdTitular, iIdPessJur, iIdPlanoPrev, iIdEvento : Integer);

Var
  wIdNucleofamiliair : Integer;
Begin
  // Gera Responsavel Caso não seja
  If Not FazQuery(QryAux,'SELECT IDRESPONSAVEL  '+
                         'FROM RESPONSAVEL      '+
                         'WHERE IDRESPONSAVEL = '+QryDet.FieldByName('IDPESSOA').AsString)
  Then Begin
    // Inclui Beneficiario como Responsavel
    ExecutarQuery(QryAux,' INSERT INTO RESPONSAVEL (IDRESPONSAVEL) '+
                         ' VALUES ('+QryDet.FieldByName('IDPESSOA').AsString+')');
  End;

  //------------------------------------------------------------------------------
  // Transforma o Beneficiario em Nucleo Familar

  // Guarda e Gera o Nucleo Familiar
  wIdNucleoFamiliair := LeultRegistro(Nil,'NUCLEOFAMILIAR');

  // Insere na Tebela de NF.
  If Not ExecutarQuery(QryAux,' INSERT INTO CM.NUCLEOFAMILIAR '+
                              '(IDNUCLEOFAMILIAR, IDRESPNUCLEO, IDTITULAR) '+
                              ' VALUES ('+
                              IntToStr(wIdNucleoFamiliair)            +', '+
                              QryDet.FieldByName('IDPESSOA').AsString +', '+
                              QryDet.FieldByName('IDTITULAR').AsString+')')
  Then Begin
    // Caso Tenha Dado Erro Mostra Mensagem
    MsgDlg('Erro na Criação dos Núcleos Familiares. ','Erro',mtError,[mbOk],0);
    Exit;
  End;

  // Busca Contribuicoes associadas ao evento que tem pagador = responsavel
  QryBuscaContrib.Close;
  QryBuscaContrib.ParamByName('IDEVENTOGERADOR').AsInteger:=iIdEvento;
  QryBuscaContrib.Open;

  // Varre arquivo de Contribuicoes por evento para gerar Contribuicoes do Nucleo
  While Not QryBuscaContrib.Eof Do Begin
    ExecutarQuery(QryAux,'INSERT INTO CM.CONTRIBPREVNUCLEO       '+
                         ' (IDCONTRIBUICAO, IDNUCLEOFAMILIAR,    '+
                         '  DATAINICIO, DATAFINAL, ULTMESPREPARO,'+
                         '  FLGCOBRA) '+
                         'VALUES     '+
                         ' ('+QryBuscaContrib.FieldByName('IDCONTRIBUICAO').AsString+', '+
                            IntToStr(wIdNucleofamiliair)+', '+
                         '  TO_DATE('+QuotedStr(QryDet.FieldByName('DATAINICIO').AsString)+',''DD/MM/YYYY''),'+
                         '  TO_DATE('+QuotedStr(QryDet.FieldByName('DATAFINAL').AsString) +',''DD/MM/YYYY''),'+
                         '''0000/00'',0)');

    // Proximo regsitro de Contruibuicoes
    QryBuscaContrib.Next;
  End;
  
End;


function  MontaSQLBenefAssoc (qryBenefAux: TwwQuery; piNumOrdem : longint) : string;
var sValor,
    sSQL : string;

    iNumBenefAssoc : integer;
begin
   Result := '';

   iNumBenefAssoc := 0;
   qryBenefAux.First;
   while not qryBenefAux.Eof do
   begin
      if (qryBenefAux.FieldByName('NumOrdemEvento').AsInteger >= piNumOrdem) or
         ((qryBenefAux.FindField('FLGPECULIO') <> nil) and (qryBenefAux.FieldByName('FLGPECULIO').AsInteger = 1))   // edilaine - SOL 253577-18064 / PPM 1240079
      then begin
         qryBenefAux.Next;
         continue;
      end;
      inc(iNumBenefAssoc);

      if qryBenefAux.FieldByName('FlgCalcTodoMes').AsInteger = 1
      then begin
         if Trim(qryBenefAux.FieldByName('VALORCOTAS').AsString) <> ''
         then sValor := qryBenefAux.FieldByName('VALORCOTAS').AsString
         else sValor := '0';
      end
      else begin
         if Trim(qryBenefAux.FieldByName('VALORATUAL').AsString) <> ''
         then sValor := qryBenefAux.FieldByName('VALORATUAL').AsString
         else sValor := '0';
      end;

      sSQL := sSQL +','+OraNumero(sValor)+' AS VALORASSOCIADO'+IntToStr(iNumBenefAssoc);

      if Trim(qryBenefAux.FieldByName('VALORBASE1').AsString) <> ''
      then sValor := qryBenefAux.FieldByName('VALORBASE1').AsString
      else sValor := '0';
      sSQL := sSQL +','+OraNumero(sValor)+' AS ASSOC'+IntToStr(iNumBenefAssoc)+'OP1';

      if Trim(qryBenefAux.FieldByName('VALORBASE2').AsString) <> ''
      then sValor := qryBenefAux.FieldByName('VALORBASE2').AsString
      else sValor := '0';
      sSQL := sSQL +','+OraNumero(sValor)+' AS ASSOC'+IntToStr(iNumBenefAssoc)+'OP2';

      if Trim(qryBenefAux.FieldByName('VALORBASE3').AsString) <> ''
      then sValor := qryBenefAux.FieldByName('VALORBASE3').AsString
      else sValor := '0';
      sSQL := sSQL +','+OraNumero(sValor)+' AS ASSOC'+IntToStr(iNumBenefAssoc)+'OP3';
      qryBenefAux.Next;
   end; //while
   Result := sSQL;
end; //MontaSQLBenefAssoc


Function PagaMesPagAbono( QryAux:TwwQuery;
                          iIdPessjur, iIdPlanoPrev, iIdBeneficio : Integer;
                          sMesPagAtual : String;
                          Var pbEhAntecipacao : Boolean ) : String;
Begin

  pbEhAntecipacao := False;

  Result := '12';

  qryaux.close;
  qryaux.sql.text := ' SELECT  PERCENTUAL '+
                     ' FROM  PARAMANTECIPABONO '+
                     ' WHERE IDPESSJUR = '+IntToStr(iIdPessjur)+' AND '+
                     ' MES = '''+sMesPagAtual+''' AND '+
                     ' IDPLANOPREV = '+IntToStr(iIdPlanoPrev)+' AND '+
                     ' IDBENEFICIO = '+IntToStr(iIdBeneficio)+' ';
  qryaux.open;

  If Not qryAux.IsEmpty Then begin

     pbEhAntecipacao := False; //Peterson Victor SOL269612 PPM 1302156

     Result := Copy(sMesPagAtual,6,2);
     Exit;
     
  End;

  qryaux.close;
  qryaux.sql.text := ' SELECT MESPGABONO    '+
                     ' FROM PLANPREV      '+
                     ' WHERE IDPLANOPREV = '+IntToStr(iIdPlanoPrev);
  qryaux.open;

  if qryAux.IsEmpty or (qryAux.FieldByName('MESPGABONO').AsString = '')
  then Exit;

  Result := qryaux.fieldbyname('MESPGABONO').AsString;

end;

Function EhMesAbono(QryAux:TwwQuery;
                    iIdPessjur, iIdPlanoPrev, iIdBeneficio : Integer;
                    sMesPagAtual : String;
                    sMesInicial : String = ''
                    ; bLiberacao : Boolean = False //Renato Visoni SOL 152046/3701 Kintana 1129662
                    ) : Boolean;
Var
  sSQL : String;
  bOK  : Boolean; //Renato Visoni SOL 152046/3701 Kintana 1129662
Begin
  Result := False;
  { Verifica se é mes de antecipação de abono, sendo retorna verdadeiro }
  sSQL := ' SELECT  PERCENTUAL      '+
          ' FROM  PARAMANTECIPABONO '+
          ' WHERE ' +
          ' IDPESSJUR   = '+IntToStr(iIdPessjur)   +' AND '+
          ' MES         = '+QuotedStr(sMesPagAtual)+' AND '+
          ' IDPLANOPREV = '+IntToStr(iIdPlanoPrev) +' AND '+
          ' IDBENEFICIO = '+IntToStr(iIdBeneficio) +'     ';
  If FazQuery(QryAux, sSQL) Then begin
    Result := True;
    QryAux.Close;
    Exit;
  End;

  { Verifica se é mes de abono, sendo retorna verdadeiro  }
  sSQL := 'SELECT MESPGABONO   '+
          'FROM PLANPREV       '+
          'WHERE IDPLANOPREV = '+IntToStr(iIdPlanoPrev);;

  //Renato Visoni SOL 152046/3701 Kintana 1129662
  
  if FazQuery(QryAux, sSQL) then begin
    if bLiberacao then begin
      bOK := (Copy(sMesPagAtual,6,2) = QryAux.FieldByName('MESPGABONO').AsString);
    end else begin
      bOK := (Copy(sMesPagAtual,6,2) >= QryAux.FieldByName('MESPGABONO').AsString);
    end;
    If ((bOK) or (sMesInicial = '12')) Then begin // SOL104535
      Result := True;
      QryAux.Close;
      Exit;
    End;
  End;
  //Renato Visoni SOL 152046/3701 Kintana 1129662

  QryAux.Close;
end;

function ExecutaRegraPlanPrevContab(qryAux : TwwQuery;
                                    piIDREGRAPLANPREVCONTAB,
                                    piIdPessJur,   piIdPlanoPrev, piIdTitular,
                                    piSeqProposta, piIdBeneficio : longint;
                                    prOpcao1,      prOpcao2,   prOpcao3           : double;
                                    psDataEvento, psDataInicio, psDataDemissao,
                                    psDataRequerimento,
                                    psFlgInternoAntes,
                                    psFlgInternoAtual,
                                    psIdSitPartAntes,
                                    psIdSitPlanAntes,
                                    psIdSitFuncAntes,
                                    psIdSitPartAtual,
                                    psIdSitPlanAtual,
                                    psIdSitFuncAtual    : string;
                                    piNumBenef          : integer;
                                    piFlgTipoINSS       : integer;
                                    var bErro : boolean;
                                    var sMsgErro : string;
                                    piFlgPossuiAcompINSS : Integer = 0) : Int64;
var sSQLDataDemissao,
    sDataInscFund,
    sDataInicio,
    sSQL,
    sDataRef : string;
    piFlgINSSConcedido,
    iIdCalculo         : integer;

    // DADOS DO BENEFICIO ANTERIOR
    sDataInicioAnt,
    sValorAnt,
    sNomeBenefAnt,
    sIdTpPagtoAnt,
    sUltMesReajAnt,
    sFlgBenefMinAnt,
    sDataEventoAnt,
    sCodBeneficioAnt,
    sNumProcINSS,
    sCodBeneficioINSS,
    sValorBase1Ant, sValorBase2Ant, sValorBase3Ant : string;
begin
  Result := 0;
  if piIDREGRAPLANPREVCONTAB <= 0 then Exit;

  sDataInscFund := CalcDataInscFund(piIdPessJur,   piIdPlanoPrev, piIdTitular,
                                   piSeqProposta,qryAux);

  if Trim(psDataEvento) = ''       then psDataEvento       := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataInicio) = ''       then psDataInicio       := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataRequerimento) = '' then psDataRequerimento := FormatDateTime('dd/mm/yyyy', date);

  sDataInicio := psDataInicio;
  sDataRef := psDataEvento;

   // Traz todas as situaçoes do participante
  if (Trim(psFlgInternoAntes) = '') or (Trim(psFlgInternoAtual) = '')
  then begin
      sSQL := ' SELECT EV.IDEVENTOSPREV, EV.IDSITPLANOATUAL, EV.IDSITPLANONOVO, '+
              '        EV.IDSITPARTATUAL, EV.IDSITPARTNOVO, EV.IDSITFUNCATUAL, EV.IDSITFUNCNOVO, '+
              '        ST.FLGINTERNO,     STA.FLGINTERNO AS FLGINTERNOANT    '+
              ' FROM   EVENTOSPREV EV, SITPART ST,  SITPART STA  '+
              ' WHERE  EV.IDSITPARTATUAL = STA.IDSITPART         '+
              ' AND    EV.IDSITPARTNOVO  = ST.IDSITPART          '+
              ' AND    EV.IDEVENTOSPREV IN ( SELECT MAX(IDEVENTOSPREV)  '+
              '                              FROM   EVENTOSPREV         '+
              '                              WHERE  IDPESSOA    = '+ IntToStr(piIdTitular)   +
              '                              AND    IDPLANOPREV = '+ IntToStr(piIdPlanoPrev) +
              '                              AND    IDPESSJUR   = '+ IntToStr(piIdPessJur)   +
              '                              AND    DATAREGISTRO  IN (SELECT MAX(DATAREGISTRO) '+
              '                                                       FROM  EVENTOSPREV '+
              '                                                       WHERE IDPESSOA    = '+ IntToStr(piIdTitular)+
              '                                                       AND   IDPLANOPREV = '+ IntToSTr(piIdPlanoPrev)+
              '                                                       AND   IDPESSJUR   = '+ IntToStr(piIdPessJur)+') )';
      dtmAPrev.qry.Close;
      dtmAPrev.qry.Sql.Clear;
      dtmAPrev.qry.Sql.Add(sSql);
      dtmAPrev.qry.Open;

      psFlgInternoAntes := dtmAPrev.qry.FieldByName('flginternoant').AsString;
      psFlgInternoAtual := dtmAPrev.qry.FieldByName('flginterno').AsString;

      psIdSitPartAntes := dtmAPrev.qry.FieldByName('idsitpartatual').AsString;
      psIdSitPlanAntes := dtmAPrev.qry.FieldByName('idsitplanoatual').AsString;
      psIdSitFuncAntes := dtmAPrev.qry.FieldByName('idsitfuncatual').AsString;

      psIdSitPartAtual := dtmAPrev.qry.FieldByName('idsitpartnovo').AsString;
      psIdSitPlanAtual := dtmAPrev.qry.FieldByName('idsitplanonovo').AsString;
      psIdSitFuncAtual := dtmAPrev.qry.FieldByName('idsitfuncnovo').AsString;
      // Fim guarda situaçoes
  end;

  if VerificaINSSConcedido ( qryAux,
                             piIdPessJur, piIdPlanoPrev, piIdTitular, piIdTitular,
                             piIdBeneficio, sCodBeneficioINSS )
  then piFlgINSSConcedido := 1
  else piFlgINSSConcedido := 0;

  BuscaDadosBeneficioAnterior ( qryAux,
                                piIdPessJur, piIdPlanoPrev, piIdTitular,
                                piIdBeneficio,
                                0,
                                psDataInicio,
                                sDataInicioAnt,
                                sValorAnt,
                                sNomeBenefAnt,
                                sIdTpPagtoAnt,
                                sUltMesReajAnt,
                                sFlgBenefMinAnt,
                                sDataEventoAnt,
                                sCodBeneficioAnt,
                                sValorBase1Ant, sValorBase2Ant, sValorBase3Ant,
                                sNumProcINSS,
                                False);

  if   psDataDemissao = ''
  then sSQLDataDemissao := 'EL.DATADEMISSAO '
  else sSQLDataDemissao := ''''+Trim(psDataDemissao)+''' AS DATADEMISSAO ';

  sSQL := ' SELECT  PF.DATANASC,  PF.DATAMORTE, PF.SEXO, PF.ESTCIVIL,                '+
          '         EL.TEMPONAOCREDITADO, EL.DATAADMISSAO, EL.IDSITFUNC,             '+
          '         EL.TEMPOSERVTOTAL,    EL.DATADEMISSAO,                           '+
          '         EL.TEMPOSERVTOTMES, EL.TEMPOSERVTOTDIA,                          '+
          '         EL.TEMPOSERVANTERIOR, EL.TEMPOSITESPECIAL, DE.FLGBENEFICIARIO,   '+
          '         PP.FLGDEVEPREVIDENC, PP.FLGDEVEASSISTENC, PP.FLGDEVEEMPRESTIMO,  '+
          '         PP.IDSITPART, PP.IDSITPLANOPREV, PP.IDPESSOA, PP.SEQPROPOSTA,    '+
          '         PP.IDPESSJUR,  PP.IDPLANOPREV,  PP.INSCRICAODATA, SP.FLGINTERNO, '+
          '         PP.IDPESSOA AS IDTITULAR, PP.SALPARTICIPACAO, PP.DTINICIOINSC,   '+
          '         DE.DATACADASTRO,                                                 '+
          sSQLDataDemissao+',                                                        '+
          IntToStr(piNumBenef)           + '   AS NUMBENEF,                          '+
          IntToStr(piFlgINSSConcedido)   + '   AS FLGINSSCONCEDIDO,                  '+
          ''''+sCodBeneficioINSS         + '''   AS CODBENEFICIOINSS,                '+
          '''' + Trim(sDataInicio)       + ''' AS DATAINICIO,                        '+
          '''' + Trim(psDataRequerimento)+ ''' AS DATAREQUERIMENTO,                  '+
          '''' + Trim(psDataEvento)      + ''' AS DATAEVENTO,                        '+
          '''' + Trim(psDataEvento)      + ''' AS DTEVENTO,                          '+
          '''' + sDataInscFund           + ''' AS INSCRICAODATAFUND,                 '+
          '''' + sDataRef                + ''' AS DATAREF,                           '+
          OraNumero(FloatToStr(prOpcao1))+ ' AS VALORBASE1,                          '+
          OraNumero(FloatToStr(prOpcao2))+ ' AS VALORBASE2,                          '+
          OraNumero(FloatToStr(prOpcao3))+ ' AS VALORBASE3,                          '+
          IntToStr(piFlgTipoINSS)        + ' AS FLGTIPOINSS,                         '+
          ''''+psFlgInternoAntes         +''' AS FLGINTERNOANT,                      '+
          ''''+psFlgInternoAtual         +''' AS FLGINTERNO,                         '+
          ''''+psIdSitPartAntes          +''' AS IDSITPARTATUAL,                     '+
          ''''+psIdSitPlanAntes          +''' AS IDSITPLANOATUAL,                    '+
          ''''+psIdSitFuncAntes          +''' AS IDSITFUNCATUAL,                     '+
          ''''+psIdSitPartAtual          +''' AS IDSITPARTNOVO,                      '+
          ''''+psIdSitPlanAtual          +''' AS IDSITPLANONOVO,                     '+
          ''''+psIdSitFuncAtual          +''' AS IDSITFUNCNOVO,                      '+

          ''''+IntToStr(piFlgPossuiAcompINSS) +''' AS FLGPOSSUIACOMPINSS,  '+

          ''''+    sIdTpPagtoAnt           +''' AS IDTPPAGTOANT,     '+
          ''''+    sUltMesReajAnt          +''' AS ULTMESREAJANT,    '+
          ''''+    sFlgBenefMinAnt         +''' AS FLGBENEFMINANT,   '+
          '''' +   Trim(sDataEventoAnt)    +''' AS DATAEVENTOANT,    '+
          '''' +   Trim(sCodBeneficioAnt)  +''' AS CODBENEFICIOANT,  '+
          '''' +   Trim(sDataInicioAnt)    +''' AS DATAINICIOANT,    '+
          OraNumero(sValorAnt)             +' AS VLBENEFPGTO,        '+
          OraNumero(sValorAnt)             +' AS VALORBENEFANT       '+
          ' ,EL.CODVINCULAFUNC   '+
          ' FROM  ELEGPATRO EL, DEPENTIT DE, PESSOAFISICA PF, '+
          '       PARTPREVPLAN PP, SITPART SP                '+
          ' WHERE PP.IDPESSOA    = ' + IntToStr(piIdTitular)  + ' AND ' +
          '       PP.SEQPROPOSTA = ' + IntToStr(piSeqProposta)+ ' AND ' +
          '       PP.IDPLANOPREV = ' + IntToStr(piIdPlanoPrev) + ' AND ' +
          '       PP.IDPESSJUR   = ' + IntToStr(piIdPessJur)   + ' AND ' +
          '       EL.IDPESSOA  = PP.IDPESSOA  AND '+
          '       EL.IDPESSJUR = PP.IDPESSJUR AND '+
          '       SP.IDSITPART = PP.IDSITPART AND '+
          '       DE.IDTITULAR(+) = EL.IDPESSOA  AND '+
          '       DE.IDPESSOA(+)  = EL.IDPESSOA  AND '+
          '       EL.IDPESSOA  = PF.IDPESSOA(+) ';

  with qryAux do
  begin
     Close;
     SQL.Clear;
     SQL.Add(sSQL);
     try
        Open;
     except
        Close;
        bErro := True;
        sMsgErro := ' Ocorreu um erro ao verificar dados para a Regra para Indicar Entidade Contábil/Financeira do Benefício (nº '+IntToStr(piIDREGRAPLANPREVCONTAB)+') ';
        Result := 0;
        Exit;
     end;

     if IsEmpty
     then begin
        Close;
        bErro := True;
        sMsgErro := ' Não há dados para a execução da Regra para Indicar Entidade Contábil/Financeira do Benefício (nº '+IntToStr(piIDREGRAPLANPREVCONTAB)+') ';
        Result := 0;
        Exit;
     end;
  end;

  Result := StrToInt(RegraNumerica(IntToStr(piIDREGRAPLANPREVCONTAB),sSQL, bErro, iIdCalculo));

  if bErro
  then begin
     bErro := True;
     sMsgErro := ' Ocorreu um erro na Regra para Indicar Entidade Contábil/Financeira do Benefício do Benefício (nº '+IntToStr(piIDREGRAPLANPREVCONTAB)+') ';
     Result := 0;
     Exit;
  end;

  sMsgErro := ' ';
end;

// VerificaVALORLimiteBeneficio - Valores de Retorno :
//   0 = não tem limite. pode gravar beneficio normalmente
// - 1 = tem limite e não foi autorizado
// > 0 = id do usuario autorizador
function VerificaVALORLimiteBeneficio ( qry              : TwwQuery;
                                        psTituloRotina   : string;
                                        piNumeroProcesso : longint;
                                        piIdPessJur      : longint;
                                        piIdPlanoPrev    : longint;
                                        piIdTitular      : longint;
                                        piIdPessoa       : longint;
                                        piIdBeneficio    : longint;
                                        pdValorNovo      : double;
                                        pbPedeAutoriza   : boolean;
                                        psMsgAux         : string = ''    ) : longint;
var sUsuario     : string;
    sSenha       : string;
    iIdUsuario   : integer;
    iIdEspAcesso : integer;
    dLimite      : double;

begin
   Result := 0;

   if pdValorNovo <= 0
   then begin
      Result := 0;
      Exit;
   end;

   if Trim(psTituloRotina) = '' then psTituloRotina := 'Recálculo do Valor do Benefício';

   with qry do
   begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT BP.LIMITEALT, BP.PERCENTUALALT, BP.USUARIOALT, B.NOME,   '+
              '        U.NOMEUSUARIO, U.IDESPACESSO                             '+
              ' FROM   BENEFPLANPREV BP, BENEFICIO B, USUARIOSISTEMA U          '+
              ' WHERE  BP.IDPLANOPREV   = '+IntToStr(piIdPlanoPrev)              +
              ' AND    BP.IDBENEFICIO   = '+IntToStr(piIdBeneficio )             +
              ' AND    B.IDBENEFICIO    = BP.IDBENEFICIO                        '+
              ' AND    BP.USUARIOALT    = U.IDUSUARIO(+)                        ');
      Open;
   end;

   // verificar VALOR limite
   if qry.FieldByName('LIMITEALT').AsFloat > 0
   then begin
      if pdValorNovo > qry.FieldByName('LIMITEALT').AsFloat
      then begin
         dLimite := qry.FieldByName('LIMITEALT').AsFloat;
         // No caso de requerimento de beneficio (pbPedeAutoriza = False)
         // só dar mensagem, mas deixar passar
         if not pbPedeAutoriza
         then begin
            MsgDlg(Trim(psMsgAux)+#13+
                   'Benefício "'+qry.FieldByName('NOME').AsString+'" excedeu limite parametrizado. '+#13+
                   '     Valor Limite para Pagamento = '+FormatFloat('#0.00',qry.FieldByName('LIMITEALT').AsFloat)+#13+
                   '     Valor Calculado do Benefício = '+FormatFloat('#0.00',pdValorNovo)+#13+
                   'A concessão deste benefício só será possível com a autorização do usuário '+qry.FieldByName('NOMEUSUARIO').AsString+'.',
                   psTituloRotina,mtInformation,[mbOK],0);
            qry.Close;
            Result := 0;
            Exit;
         end;

         if MsgDlg(Trim(psMsgAux)+#13+
                   'Benefício "'+qry.FieldByName('NOME').AsString+'" excedeu limite parametrizado. '+#13+
                   '     Valor Limite para Pagamento = '+FormatFloat('#0.00',qry.FieldByName('LIMITEALT').AsFloat)+#13+
                   '     Valor Calculado do Benefício = '+FormatFloat('#0.00',pdValorNovo)+#13+
                   'Deseja continuar ? ',psTituloRotina,mtConfirmation,[mbYes,mbNo],0) = mrNo
         then begin
            qry.Close;
            Result := -1;
            Exit;
         end;

         if qry.FieldByName('NOMEUSUARIO').AsString = ''
         then begin
            MsgDlg(Trim(psMsgAux)+#13+
                   'Benefício "'+qry.FieldByName('NOME').AsString+'" excedeu limite parametrizado. '+#13+
                   'Não existe "Usuário Autorizador para Alteração de Valor acima do Limite" parametrizado. Verifique.','Erro',mtError,[mbOK],0);
            Result := -1;
            qry.Close;
            Exit;
         end;

         try
            sUsuario     := qry.FieldByName('NOMEUSUARIO').AsString;
            sSenha       := '';
            iIdUsuario   := qry.FieldByName('USUARIOALT').AsInteger;
            iIdEspAcesso := qry.FieldByName('IDESPACESSO').AsInteger;
            Autorizacao.PedirLogin(sUsuario, sSenha);
            if not ValidaSenhaUsuario(sUsuario, sSenha, iIdUsuario, iIdEspAcesso)
            then begin
               MsgDlg('Usuário/Senha Inválidos.','Erro',mtError,[mbOK],0);
               Result := -1;
               Exit;
            end;

            if iIdUsuario <> qry.FieldByName('USUARIOALT').AsInteger
            then begin
               MsgDlg('Usuário não tem autorização para liberar valor.','Erro',mtError,[mbOK],0);
               Result := -1;
               Exit;
            end;
            Result := iIdUsuario;
            qry.Close;
            qry.SQL.Clear;
            if piIdPessoa = piIdTitular
            then qry.SQL.Add('SELECT EL.MATRICULA FROM ELEGPATRO EL               '+
                             'WHERE  EL.IDPESSJUR = '+IntToStr(piIdPessJur)        +
                             'AND    EL.IDPESSOA  = '+IntToStr(piIdTitular)        )
            else qry.SQL.Add('SELECT NVL(DP.MATRICULA, EL.MATRICULA) AS MATRICULA '+
                             'FROM   ELEGPATRO EL, DEPENTIT DP                    '+
                             'WHERE  EL.IDPESSJUR = '+IntToStr(piIdPessJur)        +
                             'AND    EL.IDPESSOA  = '+IntToStr(piIdTitular)        +
                             'AND    DP.IDTITULAR = EL.IDPESSOA                   '+
                             'AND    DP.IDPESSOA  = '+IntToStr(piIdPessoa)         );
            qry.Open;
            GravaLogTOTALPREV(psTituloRotina+'-Matr.:'+qry.FieldByName('MATRICULA').AsString+'Proc.:'+IntToStr(piNumeroProcesso)+'-Benef.:'+IntToStr(piIdBeneficio)+'-Limite:'+FloatToStr(dLimite)+'-Valor:'+FloatToStr(pdValorNovo)+'-Autorizador:'+sUsuario);
         except
         end;
      end;
   end;
end;

// VerificaPERCLimiteBeneficio - Valores de Retorno :
//   0 = não tem limite. pode gravar beneficio normalmente
// - 1 = tem limite e não foi autorizado
// > 0 = id do usuario autorizador
function VerificaPERCLimiteBeneficio  ( qry              : TwwQuery;
                                        psTituloRotina   : string;
                                        piNumeroProcesso : longint;
                                        piIdPessJur      : longint;
                                        piIdPlanoPrev    : longint;
                                        piIdTitular      : longint;
                                        piIdPessoa       : longint;
                                        piIdBeneficio    : longint;
                                        pdValorAnterior  : double;
                                        pdValorNovo      : double;
                                        pbPedeAutoriza   : boolean;
                                        psMsgAux         : string = ''    ) : longint;
var sUsuario     : string;
    sSenha       : string;
    iIdUsuario   : integer;
    iIdEspAcesso : integer;
    dPercLimite  : double;
    dValorLimite : double;
begin
   Result := 0;

   if pdValorNovo <= 0
   then begin
      Result := 0;
      Exit;
   end;

   if Trim(psTituloRotina) = '' then psTituloRotina := 'Recálculo do Valor do Benefício';

   with qry do
   begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT BP.LIMITEALT, BP.PERCENTUALALT, BP.USUARIOALT, B.NOME,   '+
              '        U.NOMEUSUARIO, U.IDESPACESSO                             '+
              ' FROM   BENEFPLANPREV BP, BENEFICIO B, USUARIOSISTEMA U          '+
              ' WHERE  BP.IDPLANOPREV   = '+IntToStr(piIdPlanoPrev)              +
              ' AND    BP.IDBENEFICIO   = '+IntToStr(piIdBeneficio )             +
              ' AND    B.IDBENEFICIO    = BP.IDBENEFICIO                        '+
              ' AND    BP.USUARIOALT    = U.IDUSUARIO(+)                        ');
      Open;
   end;

   // verificar PERCENTUAL limite
   if qry.FieldByName('PERCENTUALALT').AsFloat > 0
   then begin
      dPercLimite  := qry.FieldByName('PERCENTUALALT').AsFloat;
      dValorLimite := (qry.FieldByName('PERCENTUALALT').AsFloat * pdValorAnterior) / 100;
      if (pdValorNovo - pdValorAnterior) > dValorLimite
      then begin
         // No caso de requerimento de beneficio (pbPedeAutoriza = False)
         // só dar mensagem, mas deixar passar
         if not pbPedeAutoriza
         then begin
            MsgDlg(Trim(psMsgAux)+#13+
                   'Benefício "'+qry.FieldByName('NOME').AsString+'" excedeu percentual limite parametrizado. '+#13+
                   '     % Limite para Alteração de Valor = '+FormatFloat('#0.00',qry.FieldByName('PERCENTUALALT').AsFloat)+#13+
                   '     Valor Antes da Alteração = '+FormatFloat('#0.00',pdValorAnterior)+#13+
                   '     Valor Limite para Pagamento = '+FormatFloat('#0.00',dValorLimite)+#13+
                   '     Valor Calculado do Benefício = '+FormatFloat('#0.00',pdValorNovo)+#13+
                   'A concessão deste benefício só será possível com a autorização do usuário '+qry.FieldByName('NOMEUSUARIO').AsString+'.',
                   psTituloRotina,mtInformation,[mbOK],0);
            qry.Close;
            Result := 0;
            Exit;
         end;

         if MsgDlg(Trim(psMsgAux)+#13+
                   'Benefício "'+qry.FieldByName('NOME').AsString+'" excedeu percentual limite parametrizado. '+#13+
                   '     % Limite para Alteração de Valor = '+FormatFloat('#0.00',qry.FieldByName('PERCENTUALALT').AsFloat)+#13+
                   '     Valor Antes da Alteração = '+FormatFloat('#0.00',pdValorAnterior)+#13+
                   '     Valor Limite para Pagamento = '+FormatFloat('#0.00',dValorLimite)+#13+
                   '     Valor Calculado do Benefício = '+FormatFloat('#0.00',pdValorNovo)+#13+
                   'A concessão deste benefício só será possível com a autorização do usuário '+qry.FieldByName('NOMEUSUARIO').AsString+'.'+#13+
                   'Deseja continuar ? ',psTituloRotina,mtConfirmation,[mbYes,mbNo],0) = mrNo
         then begin
            qry.Close;
            Result := -1;
            Exit;
         end;

         if qry.FieldByName('NOMEUSUARIO').AsString = ''
         then begin
            MsgDlg(Trim(psMsgAux)+#13+
                   'Benefício "'+qry.FieldByName('NOME').AsString+'" excedeu percentual limite parametrizado. '+#13+
                   'Não existe "Usuário Autorizador para Alteração de Valor acima do Limite" parametrizado. Verifique.','Erro',mtError,[mbOK],0);
            Result := -1;
            qry.Close;
            Exit;
         end;

         try
            sUsuario     := qry.FieldByName('NOMEUSUARIO').AsString;
            sSenha       := '';
            iIdUsuario   := qry.FieldByName('USUARIOALT').AsInteger;
            iIdEspAcesso := qry.FieldByName('IDESPACESSO').AsInteger;
            Autorizacao.PedirLogin(sUsuario, sSenha);
            if not ValidaSenhaUsuario(sUsuario, sSenha, iIdUsuario, iIdEspAcesso)
            then begin
               MsgDlg('Usuário/Senha Inválidos.','Erro',mtError,[mbOK],0);
               Result := -1;
               Exit;
            end;

            if iIdUsuario <> qry.FieldByName('USUARIOALT').AsInteger
            then begin
               MsgDlg('Usuário não tem autorização para liberar valor.','Erro',mtError,[mbOK],0);
               Result := -1;
               Exit;
            end;
            Result := iIdUsuario;
            qry.Close;
            qry.SQL.Clear;
            if piIdPessoa = piIdTitular
            then qry.SQL.Add('SELECT EL.MATRICULA FROM ELEGPATRO EL               '+
                             'WHERE  EL.IDPESSJUR = '+IntToStr(piIdPessJur)        +
                             'AND    EL.IDPESSOA  = '+IntToStr(piIdTitular)        )
            else qry.SQL.Add('SELECT NVL(DP.MATRICULA, EL.MATRICULA) AS MATRICULA '+
                             'FROM   ELEGPATRO EL, DEPENTIT DP                    '+
                             'WHERE  EL.IDPESSJUR = '+IntToStr(piIdPessJur)        +
                             'AND    EL.IDPESSOA  = '+IntToStr(piIdTitular)        +
                             'AND    DP.IDTITULAR = EL.IDPESSOA                   '+
                             'AND    DP.IDPESSOA  = '+IntToStr(piIdPessoa)         );
            qry.Open;
            GravaLogTOTALPREV(psTituloRotina+'-Matr.:'+qry.FieldByName('MATRICULA').AsString+'Proc.:'+IntToStr(piNumeroProcesso)+'-Benef.:'+IntToStr(piIdBeneficio)+'-Limite:'+FloatToStr(dValorLimite)+'-Valor:'+FloatToStr(pdValorNovo)+'-Autorizador:'+sUsuario);
         except
         end;
      end;
   end;
end; // VerificaPERCLimiteBeneficio


function BuscaNumDiasBenefAnterior ( qry : TwwQuery;
