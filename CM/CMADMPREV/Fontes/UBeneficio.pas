//    (inclusive 13o.)
// 2. Para o mes da morte fazer :
//    2.1. pedir de volta os dias apos a morte (de um dia depois em diante)
//    2.2. pagar abono proporicional, do inicio do beneficio ate a data da morte
function TrataBeneficioPosMorte ( piNumeroProcesso, piIdPessJur,    piIdPlanoPrev,
                                  piIdTitular,      piSeqProposta,  piIdMotivo,
                                  piNumBenef,       piIdLote       : longint;

                                  psDataMorte,      psDataCobranca : string;
                                  piIdBeneficiario : LongInt = -1;
                                  psIdBeneficiariosEncerrados : String = '') : boolean;
var
  dValorRateado, dValorRateadoOrig, dValorAcertado       : double;

  sCodProvDesc, sIdRubrica, sFlgDesconto, sFlgAtrasoDevol      : string;

  cRecPag : char;

  sTipCodigo,   sCodTipRecDes,    sRecPag,    sCodTipDoc,        sCodPortForma, sCodCentroRespon,
  sCodSubConta, sCodCentroCustoD, sIdEmpresa, sCodCentroCustoC,  sPlaContaD,    sPlano,
  sPlaContaC,   sUnidNegoc,       sIdEmpresaProp,
  sNumProcessoTitular,            sSelectCaso       : string;

  bFazAcerto, bTemOutroRecebedor, bFaltaPercentual   : boolean;

  iIdRecebedor, iIdBeneficio       : Integer;

  sPlaContaDProvis, sPlaContaCProvis, sNrProcesso : String;

  sIdPessoa, sMsgErro : string;
begin
  Result     := False;
  bFazAcerto := True;

  If piIdBeneficiario = -1 Then Begin
    piIdBeneficiario := piIdTitular;
  End;

  {---------------------------------------------------------------------------}
  { Busca Valores que foram pagos indevidamente ao Titular e serão cobrados   }
  { dos beneficiarios                                                         }
  with dtmAPrev.qry do
  begin
    Close;
    SQL.Clear;

    { Esta query foi modificada para verificar se o processo encerrado        }
    { pelo evento de falecimento tinha como recebedor o próprio participante. }
    { Caso o recebedor não seja o próprio então o acerto deve ser feito       }
    { apenas para o recebedor.                                                }

    SQL.Add(' SELECT DISTINCT HST.NUMEROPROCESSO, HST.MESREFERENCIA, HST.IDLOTE,  HST.IDBENEFICIO, '+
            '        HST.VALORPREV, HST.FLGDEVOLUCAO , HST.VALORTOTAL,                             '+
            '        NVL(HST.VALORACERTO, HST.VALORPREV) AS VALORACERTO,                           '+
            '        HST.IDPESSOA, BT.IDRESPONSAVEL                                                '+
            ' FROM   HSTBENEFBFCIARIO HST, BFCIARIOTITPLAN BT                                      '+
            ' WHERE  HST.IDPESSJUR      = '+IntToStr(piIdPessJur)+
            ' AND    HST.IDPLANOPREV    = '+IntToStr(piIDPLANOPREV)+
            ' AND    HST.IDTITULAR      = '+IntToStr(piIDTITULAR)+
            ' AND    HST.SEQPROPOSTA    = '+IntToStr(piSEQPROPOSTA)+
            ' AND    HST.IDPESSOA       = '+IntToStr(piIdBeneficiario)+
            ' AND    (HST.IDMOTIVO = '+IntToStr(prmIdMotDevolNaoIden)+' OR HST.IDMOTIVO = '+ IntToStr(prmIdMotivoAcertoFL)+')'+ 
            ' AND    HST.VLBENEFPGTO    IS NULL '+
            ' AND    HST.FLGENVIADO     = 0 '+

            ' AND    SUBSTR(HST.MESREFERENCIA,6,2)  <> ''13'' '+

            ' AND    HST.IDPESSJUR = BT.IDPESSJUR        '+
            ' AND    HST.IDTITULAR = BT.IDTITULAR        '+
            ' AND    HST.IDPLANOPREV = BT.IDPLANOPREV    '+
            ' AND    HST.IDBENEFICIO = BT.IDBENEFICIO    '+
            ' AND    HST.SEQPROPOSTA = BT.SEQPROPOSTA    ');

    If Trim(psIdBeneficiariosEncerrados) <> ''
    Then SQL.Add(' AND    HST.IDPESSOA NOT IN ('+psIdBeneficiariosEncerrados+')');

    SQL.Add(' ORDER BY HST.MESREFERENCIA' );

    Open;
    if IsEmpty
    then begin
       bFazAcerto := False;
    end;

  end;

  sNumProcessoTitular := dtmAPrev.qry.FieldByName('NUMEROPROCESSO').AsString;

  With dtmAPrev.qry do
  Begin

    If FieldByName('IDPESSOA').AsInteger = FieldByName('IDRESPONSAVEL').AsInteger
    Then sNrProcesso := IntToStr(piNumeroProcesso)
    Else sNrProcesso := FieldByName('NUMEROPROCESSO').AsString;
  End;


  // ***************************************************************************
  // Abrir query com todos os beneficiários que estão recebendo benefício agora
  // ***************************************************************************
  with dtmAPrev.qryBenef do
  begin
    Close;
    SQL.Clear;

    SQL.Add(' SELECT DISTINCT '+
            ' NVL(BTIT.IDRESPONSAVEL,BTIT.IDPESSOA) IDRESPONSAVEL , BTIT.IDPESSOA, '+
            ' NVL(BTIT.PERCENTUAL,0) PERCENTUAL  '+
            ' FROM   BENEFBFCIARIO BF, BFCIARIOTITPLAN BTIT, BENEFPLANPREV BP, BENEFICIO B, TPPAGTOBENEFICIO TP '+
            ' WHERE  BF.NUMEROPROCESSO   = '+sNrProcesso+
            ' AND    BP.IDPLANOPREV      = BF.IDPLANOPREV                       '+
            ' AND    BP.IDBENEFICIO      = BF.IDBENEFICIO                       '+
            ' AND    BP.FLGACEITAACERTO  = 1                                    '+
            ' AND    BTIT.IDPESSJUR      = BF.IDPESSJUR                         '+
            ' AND    BTIT.IDPLANOPREV    = BF.IDPLANOPREV                       '+
            ' AND    BTIT.IDTITULAR      = BF.IDTITULAR                         '+
            ' AND    BTIT.IDPESSOA       = BF.IDPESSOA                          '+
            ' AND    BTIT.SEQPROPOSTA    = BF.SEQPROPOSTA                       '+
            ' AND    BTIT.IDBENEFICIO    = BF.IDBENEFICIO                       '+
            ' AND    B.IDBENEFICIO       = BF.IDBENEFICIO                       '+
            ' AND    B.IDTPPAGTOBENEFIC  = TP.IDTPPAGTOBENEFIC                  '
            );

    If Trim(psIdBeneficiariosEncerrados) <> ''
    Then SQL.Add(' AND    BF.IDPESSOA NOT IN ('+psIdBeneficiariosEncerrados+')');

    Open;
  end;

  if dtmAPrev.qryBenef.isempty then
  begin
    result := true;
    exit;
  end;

  dtmAPrev.qryBenef.First;
  bTemOutroRecebedor := false;
  bFaltaPercentual := false;

  while not dtmAPrev.qryBenef.Eof do
  begin

    //testo se o recebedor é o próprio beneficiário
    //caso haja algum recebdor diferente do próprio, NÃO usar percentual e ratear pelos recebedores
    //caso todos os recebedores sejam os próprios e todos os percentuais estejam preenchidos, usar percentual
    //caso todos os recebedores seja or próprios, retear pelos beneficiários
    if dtmAPrev.qryBenef.FieldByName('IDRESPONSAVEL').AsString <>
       dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString
    then begin
       bTemOutroRecebedor := true;
    end;

    if dtmAPrev.qryBenef.FieldByName('PERCENTUAL').AsFloat <= 0
    then begin
       bFaltaPercentual := True;
    end;

    dtmAPrev.qryBenef.Next;

  end;

  //agora que eu sei o critério de rateio, eu monto a qryBenef

  sSelectCaso := '';

  //divide pelo número de recebedores
  if  bTemOutroRecebedor then
  begin
    sSelectCaso := ' DECODE(BTIT.IDRESPONSAVEL,NULL,BTIT.IDPESSOA,BTIT.IDRESPONSAVEL) IDPESSOA, '+
                   ' 0 PERCENTUAL ';
  end

  //dividir pelos beneficiários
  else if (not bTemOutroRecebedor) and (bFaltaPercentual) then
  begin
    sSelectCaso := ' BTIT.IDPESSOA,  0 PERCENTUAL ';
  end
  //dividir pelos beneficiários usando o percentual
  else if (not bTemOutroRecebedor) and (not  bFaltaPercentual) then
  begin
     sSelectCaso := ' BTIT.IDPESSOA,  NVL(BTIT.PERCENTUAL,0) PERCENTUAL ';
  end;

  with dtmAPrev.qryBenef do
  begin
    Close;
    SQL.Clear;
    SQL.Add(' SELECT DISTINCT '+ sSelectCaso + ', TP.FLGFREQUENCIA '+
            ' FROM   BENEFBFCIARIO BF, BFCIARIOTITPLAN BTIT, BENEFPLANPREV BP, BENEFICIO B, TPPAGTOBENEFICIO TP '+
            ' WHERE  BF.NUMEROPROCESSO   = '+sNrProcesso+
            ' AND    BP.IDPLANOPREV      = BF.IDPLANOPREV                       '+
            ' AND    BP.IDBENEFICIO      = BF.IDBENEFICIO                       '+
            ' AND    BP.FLGACEITAACERTO  = 1                                    '+
            ' AND    BTIT.IDPESSJUR      = BF.IDPESSJUR                         '+
            ' AND    BTIT.IDPLANOPREV    = BF.IDPLANOPREV                       '+
            ' AND    BTIT.IDTITULAR      = BF.IDTITULAR                         '+
            ' AND    BTIT.IDPESSOA       = BF.IDPESSOA                          '+
            ' AND    BTIT.SEQPROPOSTA    = BF.SEQPROPOSTA                       '+
            ' AND    BTIT.IDBENEFICIO    = BF.IDBENEFICIO                       '+
            ' AND    B.IDBENEFICIO       = BF.IDBENEFICIO                       '+
            ' AND    B.IDTPPAGTOBENEFIC  = TP.IDTPPAGTOBENEFIC                  ');

            If Trim(psIdBeneficiariosEncerrados) <> ''
            Then SQL.Add(' AND    BF.IDPESSOA NOT IN ('+psIdBeneficiariosEncerrados+')');

            if bTemOutroRecebedor then
                 SQL.Add(' ORDER BY IDPESSOA, TP.FLGFREQUENCIA ')
            else SQL.Add(' ORDER BY BTIT.IDPESSOA, TP.FLGFREQUENCIA ');

    Open;
  end;


  if bFazAcerto
  then begin

    dtmAPrev.qry.First;

    while not dtmAPrev.qry.Eof do
    begin

      { Verificar se o acerto já foi pago pelo beneficiário }

      If FazQuery( dtmAPrev.qryAux, 'SELECT 1 '+
                                    'FROM TMPDESC '+
                                    'WHERE IDPESSOA      = '+ dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString +' '+
                                    '  AND IDDESCONTO    = '+ dtmAPrev.qry.FieldByName('IDBENEFICIO').AsString + ' ' +
                                    '  AND MESREFERENCIA = '+ QuotedStr( dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString ) )
      Then Begin

        dtmAPrev.qry.Next;
        Continue;

      End;

      // Buscar codigo da rubrica
      dtmAPrev.qryAux.Close;
      dtmAPrev.qryAux.SQL.Clear;
      dtmAPrev.qryAux.SQL.Add(' SELECT BP.IDRUBABONO, BP.IDRUBDESCANTECAB, BP.IDRUBRICAATRASO, BP.IDRUBDEVOLUCAO, BP.IDRUBDEVOLABONO '+
                              ' FROM   BENEFPLANPREV BP '+
                              ' WHERE  BP.IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+
                              ' AND    BP.IDBENEFICIO = '+dtmAPrev.qry.FieldByName('IDBENEFICIO').AsString);
      dtmAPrev.qryAux.Open;

      // Se for um pagamento atrasado, entao usar a rubrica de atraso
      cRecPag      := 'P';
      if dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsInteger = 0
      then begin
         sIdRubrica      := dtmAPrev.qryAux.FieldByName('IDRUBRICAATRASO').AsString;
         sFlgDesconto    := '0';
         sFlgAtrasoDevol := 'A';
      end
      else begin
         sIdRubrica   := dtmAPrev.qryAux.FieldByName('IDRUBDEVOLUCAO').AsString;
         sFlgDesconto := '1';
         sFlgAtrasoDevol := 'D';
      end;

      if Trim(sIdRubrica) = ''
      then begin
         MsgDlg('Rubrica para acerto de benefício não preenchida. Verifique.','Erro',mtError,[mbOk],0);
         Exit;
      end;

      dtmAPrev.qryAux.Close;
      dtmAPrev.qryAux.SQL.Clear;
      dtmAPrev.qryAux.SQL.Add(' SELECT CODPROVDESC FROM PROVDESC WHERE IDPROVENTO = '+sIdRubrica);
      dtmAPrev.qryAux.Open;

      if not dtmAPrev.qryAux.IsEmpty
      then sCodProvDesc := dtmAPrev.qryAux.FieldByName('CODPROVDESC').AsString;

      // O valor na HSTBENEFBFCIARIO já está pro-rateado de acordo com o número de dias
      dValorAcertado    := 0;
      dValorRateadoOrig := dtmAPrev.qry.FieldByName('VALORACERTO').AsFloat;

      dtmAPrev.qryBenef.First;

      sIdPessoa := '-1';

      while not dtmAPrev.qryBenef.Eof do
      begin

        { Acertar somente no primeiro beneficio }
        If sIdPessoa = dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString Then
        Begin
          dtmAPrev.qryBenef.Next;
          Continue;
        End;

        sIdPessoa := dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString;

        if  (not bTemOutroRecebedor) and (not  bFaltaPercentual)
        then  dValorRateado := dValorRateadoOrig * dtmAPrev.qryBenef.FieldByName('PERCENTUAL').AsFloat / 100
        else  dValorRateado := dValorRateadoOrig / dtmAPrev.qryBenef.recordcount;

        // ********************************************************************
        // Preencher Informacoes de Integracao com Financeiro e Contabilidade
        // ********************************************************************
        if (prmIntegraContab = True) or (prmIntegraCAR = True) or
           (prmIntegraCAP = True)
        Then

          if not dtmAPrevIntegraBack.BuscaInfIntegra( piIdPessJur,
                                  piIdPlanoPrev,
                                  piIdTitular,
                                  dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsInteger,
                                  dtmAPrev.qry.FieldByName('IDBENEFICIO').AsInteger,
                                  'B',
                                  'B',
                                  dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsInteger,
                                  Copy(psDataCobranca,7,4)+'/'+Copy(psDatacobranca,4,2),
                                  dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString,
                                  sTipCodigo,
                                  sCodTipRecDes,
                                  sRecPag,
                                  sCodTipDoc,
                                  sCodPortForma,
                                  sCodCentroRespon,
                                  sCodSubConta,
                                  sCodCentroCustoD,
                                  sIdEmpresa,
                                  sCodCentroCustoC,
                                  sPlaContaD,
                                  sPlano,
                                  sPlaContaC,
                                  sPlaContaDProvis,
                                  sPlaContaCProvis,
                                  sUnidNegoc,
                                  sIdEmpresaProp,
                                  'R',
                                  True,
                                  sMsgErro )
          then begin
             MsgDlg('Acerto de Benefício : Erro ao buscar parametrização financeira. Verifique.','Erro',mtError,[mbOk],0);
             Exit;
          end;

        iIdRecebedor := dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsInteger;

        if not InsereTMPDESC ( dtmAPrev.qryAux,
                               '', sCodCentroCustoC, sCodCentroCustoD,
                               sCodCentroRespon, '', '',
                               sCodPortForma, sCodProvDesc, sCodSubConta,
                               sCodTipDoc, sCodTipRecDes, '',
                               psDATACOBRANCA, '', psDATACOBRANCA,
                               'Devolução de Benefício Pós-Morte', '', '',
                               sFlgAtrasoDevol, 'B' , sFlgDesconto,
                               '0',
                               '', 'P', dtmAPrev.qry.FieldByName('IDBENEFICIO').AsString,
                               sIdEmpresaProp,sIdEmpresaProp,sIdEmpresaProp,
                               dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString,
                               IntToStr(iIdFundacao), IntToStr(piIdLote),
                               IntToStr(Sistema.IdModulo), IntToStr(piIdMotivo),
                               IntToStr(piIdPessJur),
                               IntToStr(iidrecebedor),
                               IntToStr(piIDPLANOPREV), IntToStr(piIDPLANOPREV),
                               sIdRubrica, IntToStr(piIDTITULAR), '',
                               '', Copy(psDataCobranca,7,4)+'/'+Copy(psDatacobranca,4,2),
                               dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString,
                               '', '', sPlaContaC,
                               sPlaContaD, sPlano, cRecPag,
                               '***', '1', IntToStr(Sistema.IdModulo),
                               '0',  prmTpOperFolhaBen,  sUnidNegoc, FloatToStr(dValorRateado),
                               '', '', '', '', '')
        then begin
           MsgDlg('Erro ao inserir Devolução de Benefício Pós-Morte.','Erro',mtError,[mbOk],0);
           Exit;
        end;

        dValorAcertado    := dValorAcertado + dValorRateado;
        dtmAPrev.qryBenef.Next;

      end;

      // *******************************************************************************************
      // BAIXAR OS REGISTROS DA HSTBENEFBFCIARIO RELATIVOS AO TITULAR (PARTICIPANTE)
      // Se o valor acertado for todo o valor que existia pendente de acerto, entao baixar a
      // hstbenefbfciario. Senao, entao baixar apenas o valor que foi acertado
      // *******************************************************************************************
      if dtmAPrev.qry.FieldByName('VALORPREV').AsFloat - dValorAcertado <= 0.01
      then begin
        dtmAPrev.qryAux.Close;
        dtmAPrev.qryAux.SQL.Clear;
        dtmAPrev.qryAux.SQL.Add(' UPDATE HSTBENEFBFCIARIO SET VLBENEFPGTO = VALORPREV , FLGENVIADO = ''1'' '+
                                ' WHERE  IDPESSOA       = '+IntToStr(piIDTITULAR)+
                                ' AND    MESREFERENCIA  = '''+dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString+''''+
                                ' AND    IDBENEFICIO    = '+dtmAPrev.qry.FieldByName('IDBENEFICIO').AsString+
                                ' AND    NUMEROPROCESSO = '+dtmAPrev.qry.FieldByName('NUMEROPROCESSO').AsString+
                                ' AND    (IDMOTIVO = '+IntToStr(prmIdMotDevolNaoIden)+' OR IDMOTIVO ='+ IntToStr(prmIdMotivoAcertoFL)+ ')'+
                                ' AND    FLGENVIADO = 0 ');
        try

           dtmAPrev.qryAux.ExecSql;
        except
        //Brunno Mattos - KTN 767861 - SOL 132659 Inicio
        on e:Exception do
        begin
          TratarErro(e.Message);
           MsgDlg('Erro ao atualizar Devolução de Benefício Pós-Morte','Erro',mtError,[mbOk],0);
           Exit;
        end;
        //Brunno Mattos - KTN 767861 - SOL 132659 Fim

        end;
      end
      else
      begin
        dtmAPrev.qryAux.Close;
        dtmAPrev.qryAux.SQL.Clear;
        dtmAPrev.qryAux.SQL.Add(' UPDATE HSTBENEFBFCIARIO SET VALORPREV = '+OraNumero(FormatFloat('#0.00',dtmAPrev.qry.FieldByName('VALORPREV').AsFloat - dValorAcertado ))+
                                  ' WHERE  IDPESSOA       = '+IntToStr(piIDTITULAR)+
                                  ' AND    MESREFERENCIA  = '''+dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString+''''+
                                  ' AND    IDBENEFICIO    = '+dtmAPrev.qry.FieldByName('IDBENEFICIO').AsString+
                                  ' AND    NUMEROPROCESSO = '+dtmAPrev.qry.FieldByName('NUMEROPROCESSO').AsString+
                                  ' AND    (IDMOTIVO       = '+IntToStr(prmIdMotDevolNaoIden)+' OR IDMOTIVO       ='+ IntToStr(prmIdMotivoAcertoFL)+')'+
                                  ' AND    FLGENVIADO     = 0 ');
        try
          dtmAPrev.qryAux.ExecSql;
        except
        //Brunno Mattos - KTN 767861 - SOL 132659 Inicio
        on e:Exception do
        begin
          TratarErro(e.Message);
          MsgDlg('Erro ao atualizar Devolução de Benefício Pós-Morte','Erro',mtError,[mbOk],0);
          Exit;
        end;
        //Brunno Mattos - KTN 767861 - SOL 132659 Fim

        end;

      end;

      dtmAPrev.qry.Next;

    end; // while

  end; // if bFazAcerto

  //verificar se tem abono de pecúlio mesref = 13
  //se houver, da baixa no registro do titular na hstbenefbfciario
  //e lançar o valor rateado pelos beneficiários

  dtmAPrev.qry.Close;
  dtmAPrev.qry.SQL.Clear;
  dtmAPrev.qry.SQL.Add(' SELECT DISTINCT HST.NUMEROPROCESSO, HST.MESREFERENCIA, HST.IDLOTE, '+ #13 +
                       '        HST.IDBENEFICIO, HST.VALORPREV, HST.VALORTOTAL, HST.FLGDEVOLUCAO,  '+ #13 +
                       '        HST.VALORACERTO  '+ #13 +
                       ' FROM   HSTBENEFBFCIARIO HST                              '+ #13 +
                       ' WHERE  HST.IDPESSJUR      = '+IntToStr(piIdPessJur)+ #13 +
                       ' AND    HST.IDPLANOPREV    = '+IntToStr(piIDPLANOPREV)+ #13 +
                       ' AND    HST.IDTITULAR      = '+IntToStr(piIDTITULAR)+ #13 +
                       ' AND    HST.SEQPROPOSTA    = '+IntToStr(piSEQPROPOSTA)+ #13 +
                       ' AND    HST.IDPESSOA       = '+IntToStr(piIdBeneficiario)+ #13 + 
                       ' AND    (HST.IDMOTIVO      = '+IntToStr(prmIdMotDevolNaoIden)+' OR '+ #13 +
                       '         HST.IDMOTIVO      = '+IntToStr(prmIdMotivoAcertoFL)+')'+ #13 + 
                       ' AND    HST.VLBENEFPGTO IS NULL '+ #13 +
                       ' AND    SUBSTR(HST.MESREFERENCIA,6,2)  = ''13'' '+ #13 +
                       ' AND    HST.FLGENVIADO     = 0 '+ #13 +
                       ' ORDER BY HST.MESREFERENCIA' );

  dtmAPrev.qry.Open;
  if dtmAPrev.qry.IsEmpty
  then begin
     Result := True;
     dtmAPrev.qry.Close;
     Exit;
  end;

  dtmAPrev.qry.First;

  while not dtmAPrev.qry.Eof  do
  begin

      { Verificar se o acerto já foi pago pelo beneficiário }

      If FazQuery( dtmAPrev.qryAux, 'SELECT 1 '+
                                    'FROM TMPDESC '+
                                    'WHERE IDPESSOA      = '+ dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString +' '+
                                    '  AND IDDESCONTO    = '+ dtmAPrev.qry.FieldByName('IDBENEFICIO').AsString + ' ' +
                                    '  AND MESREFERENCIA = '+ QuotedStr( dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString )+
                                    '  AND FLGDESCONTO   = '+ dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsString ) //CPREV - Pend. 27076
      Then Begin

        dtmAPrev.qry.Next;
        Continue;

      End;

    // Buscar codigo da rubrica
    dtmAPrev.qryAux.Close;
    dtmAPrev.qryAux.SQL.Clear;
    dtmAPrev.qryAux.SQL.Add(' SELECT BP.IDRUBABONO, BP.IDRUBDESCANTECAB, BP.IDRUBRICAATRASO, BP.IDRUBDEVOLUCAO, BP.IDRUBDEVOLABONO '+
                            ' FROM   BENEFPLANPREV BP '+
                            ' WHERE  BP.IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+
                            ' AND    BP.IDBENEFICIO = '+dtmAPrev.qry.FieldByName('IDBENEFICIO').AsString);
    dtmAPrev.qryAux.Open;

    // Se for um pagamento atrasado, entao usar a rubrica de atraso
    cRecPag      := 'P';
    if dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsInteger = 0
    then begin
       sIdRubrica      := dtmAPrev.qryAux.FieldByName('IDRUBABONO').AsString;
       sFlgDesconto    := '0';
       sFlgAtrasoDevol := 'A';
    end
    else begin
       sIdRubrica      := dtmAPrev.qryAux.FieldByName('IDRUBDEVOLABONO').AsString;
       sFlgDesconto    := '1';
       sFlgAtrasoDevol := 'D';
    end;

    if Trim(sIdRubrica) = ''
    then begin
       MsgDlg('Rubrica para acerto abono de benefício não preenchida. Verifique.','Erro',mtError,[mbOk],0);
       Exit;
    end;

    dtmAPrev.qryAux.Close;
    dtmAPrev.qryAux.SQL.Clear;
    dtmAPrev.qryAux.SQL.Add(' SELECT CODPROVDESC FROM PROVDESC WHERE IDPROVENTO = '+sIdRubrica);
    dtmAPrev.qryAux.Open;

    if not dtmAPrev.qryAux.IsEmpty
    then sCodProvDesc := dtmAPrev.qryAux.FieldByName('CODPROVDESC').AsString;

    // *************************************************************************
    // FAZER RATEIO DO VALOR A DESCONTAR
    // Se a fundação utiliza o percentual da BFCIARIOTITPLAN, ratear pelo percentual
    // Senao, ratear pelo número de beneficiários
    // *************************************************************************
    // Pro-ratear pelo número de dias, se for o mês do falecimento
    dValorAcertado    := 0;
    dValorRateadoOrig := dtmAPrev.qry.FieldByName('VALORACERTO').AsFloat; 

    dtmAPrev.qryBenef.First;
    sIdPessoa := ''; 
    while not dtmAPrev.qryBenef.Eof do
    begin

        If sIdPessoa = dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString
         Then Begin
          dtmAPrev.qryBenef.Next;
          Continue;
         End;
        sIdPessoa := dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString;


       if  (not bTemOutroRecebedor) and (not  bFaltaPercentual)
       then  dValorRateado := dValorRateadoOrig * dtmAPrev.qryBenef.FieldByName('PERCENTUAL').AsFloat / 100
       else  dValorRateado := dValorRateadoOrig / dtmAPrev.qryBenef.recordcount;

       if (prmIntegraContab = True) or (prmIntegraCAR = True) or
          (prmIntegraCAP = True)
       Then
         if not dtmAPrevIntegraBack.BuscaInfIntegra( piIdPessJur,
                                 piIdPlanoPrev,
                                 piIdTitular,
                                 iIdRecebedor,
                                 dtmAPrev.qry.FieldByName('IDBENEFICIO').AsInteger,
                                 'B',
                                 'B',
                                 dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsInteger,
                                 Copy(psDataCobranca,7,4)+'/'+Copy(psDatacobranca,4,2),
                                 dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString,
                                 sTipCodigo,
                                 sCodTipRecDes,
                                 sRecPag,
                                 sCodTipDoc,
                                 sCodPortForma,
                                 sCodCentroRespon,
                                 sCodSubConta,
                                 sCodCentroCustoD,
                                 sIdEmpresa,
                                 sCodCentroCustoC,
                                 sPlaContaD,
                                 sPlano,
                                 sPlaContaC,
                                 sPlaContaDProvis,
                                 sPlaContaCProvis,
                                 sUnidNegoc,
                                 sIdEmpresaProp,
                                 'R',
                                 True,
                                 sMsgErro )
         then begin
            MsgDlg('Acerto de Abono de Benefício : Erro ao buscar parametrização financeira. Verifique.','Erro',mtError,[mbOk],0);
            Exit;
         end;

       iIdRecebedor := dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsInteger;

       if not InsereTMPDESC ( dtmAPrev.qryAux,
                              '', sCodCentroCustoC, sCodCentroCustoD,
                              sCodCentroRespon, '', '',
                              sCodPortForma, sCodProvDesc, sCodSubConta,
                              sCodTipDoc, sCodTipRecDes, '',
                              psDATACOBRANCA, '', psDATACOBRANCA,
                              'Devolução de Benefício Pós-Morte 13', '', '',
                              sFlgAtrasoDevol, 'B' ,
                              sFlgDesconto, 
                              '0',
                              '', 'P', dtmAPrev.qry.FieldByName('IDBENEFICIO').AsString,
                              sIdEmpresaProp,sIdEmpresaProp,sIdEmpresaProp,
                              dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString,
                              IntToStr(iIdFundacao), IntToStr(piIdLote),
                              IntToStr(Sistema.IdModulo), IntToStr(piIdMotivo),
                              IntToStr(piIdPessJur),
                              IntToStr(iidrecebedor), 
                              IntToStr(piIDPLANOPREV), IntToStr(piIDPLANOPREV),
                              sIdRubrica,
                              IntToStr(piIDTITULAR), '',
                              '',
                              Copy(psDataCobranca,7,4)+'/'+Copy(psDatacobranca,4,2),
                              dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString,
                              '', '', sPlaContaC,
                              sPlaContaD, sPlano, cRecPag,
                              '***', '1', IntToStr(Sistema.IdModulo),
                              '0',  prmTpOperFolhaBen,  sUnidNegoc, FloatToStr(dValorRateado),
                              '', '', '', '', '')
       then begin
          MsgDlg('Erro ao inserir Devolução de Benefício Pós-Morte.','Erro',mtError,[mbOk],0);
          Exit;
       end;

       dValorAcertado    := dValorAcertado + dValorRateado;
       dtmAPrev.qryBenef.Next;
    end;

    // *******************************************************************************************
    // BAIXAR OS REGISTROS DA HSTBENEFBFCIARIO RELATIVOS AO TITULAR (PARTICIPANTE)
    // Se o valor acertado for todo o valor que existia pendente de acerto, entao baixar a
    // hstbenefbfciario. Senao, entao baixar apenas o valor que foi acertado
    // *******************************************************************************************
    if dtmAPrev.qry.FieldByName('VALORPREV').AsFloat - dValorAcertado <= 0.01
    then begin
       dtmAPrev.qryAux.Close;
       dtmAPrev.qryAux.SQL.Clear;
       dtmAPrev.qryAux.SQL.Add(' UPDATE HSTBENEFBFCIARIO SET VLBENEFPGTO = VALORPREV , FLGENVIADO = ''1'' '+
                               ' WHERE  IDPESSOA       = '+IntToStr(piIDTITULAR)+
                               ' AND    MESREFERENCIA  = '''+dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString+''''+
                               ' AND    IDBENEFICIO    = '+dtmAPrev.qry.FieldByName('IDBENEFICIO').AsString+
                               ' AND    NUMEROPROCESSO = '+dtmAPrev.qry.FieldByName('NUMEROPROCESSO').AsString+
                               ' AND    (IDMOTIVO      = '+IntToStr(prmIdMotDevolNaoIden)+' OR '+
                               '         IDMOTIVO      = '+IntToStr(prmIdMotivoAcertoFL)+ ')'+
                               ' AND    FLGENVIADO     = 0 '+
                               ' AND    FLGDEVOLUCAO   = '+dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsString); //CPREV - Pend. 27076
       try

          dtmAPrev.qryAux.ExecSql;
       except
       //Brunno Mattos - KTN 767861 - SOL 132659 Inicio
       on e:Exception do
       begin
         TratarErro(e.Message);
          MsgDlg('Erro ao atualizar Devolução de Benefício Pós-Morte','Erro',mtError,[mbOk],0);
          Exit;
       end;
       //Brunno Mattos - KTN 767861 - SOL 132659 Fim

       end;
    end
    else begin
       dtmAPrev.qryAux.Close;
       dtmAPrev.qryAux.SQL.Clear;
       dtmAPrev.qryAux.SQL.Add(' UPDATE HSTBENEFBFCIARIO SET VALORPREV = '+OraNumero(FormatFloat('#0.00',dtmAPrev.qry.FieldByName('VALORPREV').AsFloat - dValorAcertado )) +
                               ' WHERE  IDPESSOA       = '+IntToStr(piIDTITULAR)+
                               ' AND    MESREFERENCIA  = '''+dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString+''''+
                               ' AND    IDBENEFICIO    = '+dtmAPrev.qry.FieldByName('IDBENEFICIO').AsString+
                               ' AND    NUMEROPROCESSO = '+dtmAPrev.qry.FieldByName('NUMEROPROCESSO').AsString+
                               ' AND    (IDMOTIVO      = '+IntToStr(prmIdMotDevolNaoIden)+' OR '+
                               '         IDMOTIVO      = '+IntToStr(prmIdMotivoAcertoFL)+')'+
                               ' AND    FLGENVIADO     = 0 '+
                               ' AND    FLGDEVOLUCAO   = '+dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsString); //CPREV - Pend. 27076
       try

          dtmAPrev.qryAux.ExecSql;
       except
       //Brunno Mattos - KTN 767861 - SOL 132659 Inicio
        on e:Exception do
        begin
          TratarErro(e.Message);
          MsgDlg('Erro ao atualizar Devolução de Benefício Pós-Morte','Erro',mtError,[mbOk],0);
          Exit;
       end;
        //Brunno Mattos - KTN 767861 - SOL 132659 Fim

       end;
    end;

    dtmAPrev.qry.Next;

  end; // while

  Result := True;

end; // TrataBeneficioPosMorte


// 1. Para os meses posteriores a morte, devolver todas as contribuicoes
//    (inclusive 13o.)
// 2. Para o mes da morte fazer :
//    2.1. devolver os dias apos a morte (de um dia depois em diante)
//    2.2. cobrar contrib. sobre 13o. do inicio da contrib. ate a data da morte
function TrataAtrasoDevolContribPosMorte ( piNumeroProcesso, piIdPessJur, piIdPlanoPrev, piIdTitular, piIdPessoa, //William Moreira da Silva - SOL 213329
                                           piSeqProposta, piIdMotivo,       piNumBenef,  piIdLote  : longint;
                                           psDataMorte, psDataCobranca : string;
                                           psIdBeneficiariosEncerrados : String = '') : boolean; 
var

  dValorRateado, dValorAcertado, dValorRateadoOrig   : double;

  sIdRubrica, sCodProvDesc, sFlgDesconto, sFlgAtrasoDevol     : string;

  cRecPag             : char;

  sTipCodigo,           sCodTipRecDes,    sRecPag,           sCodTipDoc,  sCodPortForma,
  sCodCentroRespon,     sCodSubConta,     sCodCentroCustoD,  sIdEmpresa,  sCodCentroCustoC,
  sPlaContaD,           sPlano,           sPlaContaC,        sUnidNegoc,  sIdEmpresaProp,
  sNumProcessoTitular,  sPlaContaDProvis, sPlaContaCProvis,  sSelectCaso  : String;

  bFazAcerto, bTemOutroRecebedor, bFaltaPercentual : Boolean;

  iIdRecebedor, iIdBeneficio : Integer;

  sNrProcesso, sMsgErro : String;


  function AtualizaMesNaoIdentificado(
    asdatacob, asmesref, asmescob: string;
    aidmotivo, ainumreceb: integer): boolean;
  var lssql: string;
  begin
    lssql:=
      'UPDATE HSTCONTRIBPREV '+#13#10+
      'SET MESCOBRANCA = '+quotedstr(copy(asdatacob,7,4)+'/'+copy(asdatacob,4,2))+#13#10+
      'WHERE MESREFERENCIA = '+quotedstr(asmesref)+#13#10+
      'AND MESCOBRANCA = '+QuotedStr(asmescob)+#13#10+
      'AND IDMOTIVO = '+inttostr(aidmotivo)+#13#10+
      'AND NUMRECEBIMENTO = '+inttostr(ainumreceb);

    dtmAPrev.qryAux.Close;
    dtmAPrev.qryAux.SQL.Clear;
    dtmAPrev.qryAux.SQL.Add(lssql);
    try
      dtmAPrev.qryAux.execsql;
      result:=true;
    except
      result:=false;
    end;
  end;


begin
  Result     := False;
  bFazAcerto := True;

  //William Moreira da Silva - SOL 213329
  //if piIdPessoa = 0 then
  //begin
  //     piIdPessoa := piIDTITULAR;
  //end;
  //William Moreira da Silva - SOL 213329

  with dtmAPrev.qry do
  begin
    Close;
    SQL.Clear;
    SQL.Add(' SELECT HST.MESCOBRANCA,   HST.NUMRECEBIMENTO, HST.MESREFERENCIA, HST.IDCONTRIBUICAO, '+
            '        HST.VALORESPERADO, HST.VALORCALCULADO, HST.FLGDEVOLUCAO, '+
            '        HST.IDMOTIVO '+
            ' FROM   HSTCONTRIBPREV  HST                              '+
            ' WHERE  HST.IDPESSJUR      = '+IntToStr(piIdPessJur)+
            ' AND    HST.IDPLANOPREV    = '+IntToStr(piIDPLANOPREV)+
            ' AND    HST.IDTITULAR      = '+IntToStr(piIDTITULAR)+ //Fanuel Junior  SOL 157444/5301 Kintana 1329006
            //William Moreira da Silva - SOL 213329
            //' AND    HST.IDPESSOA       = '+IntToStr(piIDTITULAR)+
            ' AND    HST.IDPESSOA       = '+IntToStr(piIdPessoa)+
            //William Moreira da Silva - SOL 213329
            ' AND    HST.SEQPROPOSTA    = '+IntToStr(piSEQPROPOSTA)+

            ' AND    (( (HST.IDMOTIVO = '+IntToStr(prmIdMotDevolNaoIden)+
            ' OR HST.IDMOTIVO = '+ IntToStr(prmIdMotivoAcertoFL)+') '+
            '            AND (HST.SITRECEBIMENTO = 0)  '+
            '            AND    (HST.MESREFERENCIA  >= '''+Copy(psDataMorte,7,4)+'/'+Copy(psDataMorte,4,2)+''')) '+
            '        OR  ((HST.VALORESPERADO > 0 )  '+
            '              AND    (HST.SITRECEBIMENTO <> ''2'') '+
            '              AND    (HST.SITRECEBIMENTO <> ''4'') '+ 
            '            AND    (HST.SITRECEBIMENTO <> ''5'') '+
            '            AND    (HST.SITRECEBIMENTO <> ''9'') '+
            '            AND    (HST.MESREFERENCIA < '''+Copy(psDataMorte,7,4)+'/'+Copy(psDataMorte,4,2)+''')) '+
            '        OR  ((HST.VALORESPERADO > HST.VALORRECEBIDO )  AND  (HST.SITRECEBIMENTO = ''3'')) ) '+ 
            ' AND    SUBSTR(HST.MESREFERENCIA,6,2)  <> ''13'' '+
            ' ORDER BY HST.MESREFERENCIA' );
    Open;

    if IsEmpty
    then begin
       bFazAcerto := False;
    end;

  end;


  // Esta query tem por finalidade verificar se o processo encerrado
  // pelo evento de falecimento tinha como recebedor o próprio participante.
  // Caso o recebedor não seja o próprio então o acerto deve ser feito
  // apenas para o recebedor.
  With dtmAPrev.qryBenef do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(' SELECT DISTINCT HST.NUMEROPROCESSO, HST.IDPESSOA, BT.IDRESPONSAVEL                   '+
            ' FROM   HSTBENEFBFCIARIO HST, BFCIARIOTITPLAN BT                                      '+
            ' WHERE  HST.IDPESSJUR      = '+IntToStr(piIdPessJur)+
            ' AND    HST.IDPLANOPREV    = '+IntToStr(piIDPLANOPREV)+
            ' AND    HST.IDTITULAR      = '+IntToStr(piIDTITULAR)+
            ' AND    HST.SEQPROPOSTA    = '+IntToStr(piSEQPROPOSTA)+
            ' AND    HST.IDPESSOA       = '+IntToStr(piIDTITULAR)+
            ' AND    (HST.IDMOTIVO      = '+IntToStr(prmIdMotDevolNaoIden)+'  OR '+
            '         HST.IDMOTIVO = '+ IntToStr(prmIdMotivoAcertoFL)+') '+
            ' AND    HST.MESREFERENCIA  >= '''+Copy(psDataMorte,7,4)+'/'+Copy(psDataMorte,4,2)+''''+
            ' AND    SUBSTR(HST.MESREFERENCIA,6,2)  <> ''13'' '+
            ' AND    HST.IDPESSJUR = BT.IDPESSJUR        '+
            ' AND    HST.IDTITULAR = BT.IDTITULAR        '+
            ' AND    HST.IDPLANOPREV = BT.IDPLANOPREV    '+
            ' AND    HST.IDBENEFICIO = BT.IDBENEFICIO    '+
            ' AND    HST.SEQPROPOSTA = BT.SEQPROPOSTA    ');

    If Trim(psIdBeneficiariosEncerrados) <> ''
    Then SQL.Add(' AND    HST.IDPESSOA NOT IN ('+psIdBeneficiariosEncerrados+')');

    Open;

    If FieldByName('IDPESSOA').AsInteger = FieldByName('IDRESPONSAVEL').AsInteger
    Then sNrProcesso := IntToStr(piNumeroProcesso)
    Else sNrProcesso := FieldByName('NUMEROPROCESSO').AsString;
  End;


  // ***************************************************************************
  // Abrir query com todos os beneficiários que estão recebendo benefício agora.
  // ***************************************************************************
  with dtmAPrev.qryBenef do
  begin
    Close;
    SQL.Clear;
    SQL.Add(' SELECT DISTINCT  '+
            ' NVL(BTIT.IDRESPONSAVEL,BTIT.IDPESSOA) IDRESPONSAVEL , BTIT.IDPESSOA, '+
            ' NVL(BTIT.PERCENTUAL,0) PERCENTUAL  '+
            ' FROM   BENEFBFCIARIO BF, BFCIARIOTITPLAN BTIT, BENEFPLANPREV BP, BENEFICIO B, TPPAGTOBENEFICIO TP '+
            ' WHERE  BF.NUMEROPROCESSO   = '+sNrProcesso+
            ' AND    BP.IDPLANOPREV      = BF.IDPLANOPREV                       '+
            ' AND    BP.IDBENEFICIO      = BF.IDBENEFICIO                       '+
            ' AND    BP.FLGACEITAACERTO  = 1                                    '+
            ' AND    BTIT.IDPESSJUR      = BF.IDPESSJUR                         '+
            ' AND    BTIT.IDPLANOPREV    = BF.IDPLANOPREV                       '+
            ' AND    BTIT.IDTITULAR      = BF.IDTITULAR                         '+
            ' AND    BTIT.IDPESSOA       = BF.IDPESSOA                          '+
            ' AND    BTIT.SEQPROPOSTA    = BF.SEQPROPOSTA                       '+
            ' AND    BTIT.IDBENEFICIO    = BF.IDBENEFICIO                       '+
            ' AND    B.IDBENEFICIO       = BF.IDBENEFICIO                       '+
            ' AND    B.IDTPPAGTOBENEFIC  = TP.IDTPPAGTOBENEFIC                  '
           );

    If Trim(psIdBeneficiariosEncerrados) <> ''
    Then SQL.Add(' AND    BF.IDPESSOA NOT IN ('+psIdBeneficiariosEncerrados+')');

    Open;
  end;


  if dtmAPrev.qryBenef.isempty then
  begin
     result := true;
     exit;
  end;

  dtmAPrev.qryBenef.First;

  bTemOutroRecebedor := false;
  bFaltaPercentual   := false;

  while not dtmAPrev.qryBenef.Eof do
  begin

    //testo se o recebedor é o próprio beneficiário
    //caso haja algum recebdor diferente do próprio, NÃO usar percentual e ratear pelos recebedores
    //caso todos os recebedores sejam os próprios e todos os percentuais estejam preenchidos, usar percentual
    //caso todos os recebedores seja or próprios, retear pelos beneficiários
    if dtmAPrev.qryBenef.FieldByName('IDRESPONSAVEL').AsString <>
       dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString
    then begin
       bTemOutroRecebedor := true;
    end;

    if dtmAPrev.qryBenef.FieldByName('PERCENTUAL').AsFloat <= 0
    then begin
       bFaltaPercentual := True;
    end;

    dtmAPrev.qryBenef.Next;

  end;


  //agora que eu sei o critério de rateio, eu monto a qryBenef
  sSelectCaso := '';

  //divide pelo número de recebedores
  if  bTemOutroRecebedor then
  begin
     sSelectCaso := ' DECODE(BTIT.IDRESPONSAVEL,NULL,BTIT.IDPESSOA,BTIT.IDRESPONSAVEL) IDPESSOA, '+
                    ' 0 PERCENTUAL ';
  end
  //dividir pelos beneficiários
  else if (not bTemOutroRecebedor) and (bFaltaPercentual) then
  begin
     sSelectCaso := ' BTIT.IDPESSOA,  0 PERCENTUAL ';
  end
  //dividir pelos beneficiários usando o percentual
  else if (not bTemOutroRecebedor) and (not  bFaltaPercentual) then
  begin
     sSelectCaso := ' BTIT.IDPESSOA,  NVL(BTIT.PERCENTUAL,0) PERCENTUAL ';
  end;


  with dtmAPrev.qryBenef do
  begin
    Close;
    SQL.Clear;
    SQL.Add(' SELECT DISTINCT  '+ sSelectCaso +
            ' FROM   BENEFBFCIARIO BF, BFCIARIOTITPLAN BTIT, BENEFPLANPREV BP, BENEFICIO B, TPPAGTOBENEFICIO TP '+
            ' WHERE  BF.NUMEROPROCESSO   = '+sNrProcesso+
            ' AND    BP.IDPLANOPREV      = BF.IDPLANOPREV                       '+
            ' AND    BP.IDBENEFICIO      = BF.IDBENEFICIO                       '+
            ' AND    BP.FLGACEITAACERTO  = 1                                    '+
            ' AND    BTIT.IDPESSJUR      = BF.IDPESSJUR                         '+
            ' AND    BTIT.IDPLANOPREV    = BF.IDPLANOPREV                       '+
            ' AND    BTIT.IDTITULAR      = BF.IDTITULAR                         '+
            ' AND    BTIT.IDPESSOA       = BF.IDPESSOA                          '+
            ' AND    BTIT.SEQPROPOSTA    = BF.SEQPROPOSTA                       '+
            ' AND    BTIT.IDBENEFICIO    = BF.IDBENEFICIO                       '+
            ' AND    B.IDBENEFICIO       = BF.IDBENEFICIO                       '+
            ' AND    B.IDTPPAGTOBENEFIC  = TP.IDTPPAGTOBENEFIC                  '
           );

    If Trim(psIdBeneficiariosEncerrados) <> ''
    Then SQL.Add(' AND    BF.IDPESSOA NOT IN ('+psIdBeneficiariosEncerrados+')');

    Open;
  end;

  if bFazAcerto
  then begin
      with dtmAPrev.qry do
      begin

         dValorAcertado := 0;
         First;

         while not Eof do
         begin

            // Buscar codigo da rubrica
            dtmAPrev.qryAux.Close;
            dtmAPrev.qryAux.SQL.Clear;
            dtmAPrev.qryAux.SQL.Add(' SELECT CP.IDRUBRICAATRASO, CP.IDRUBRICADEVOLUC, CP.IDRUBDECTERCATRA, CP.IDRUBDECTERCDEVOL '+
                                    ' FROM   CONTPREV  CP '+
                                    ' WHERE  CP.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
                                    ' AND    CP.IDCONTRIBUICAO = '+FieldByName('IDCONTRIBUICAO').AsString);
            dtmAPrev.qryAux.Open;

            // Se for um pagamento atrasado, entao usar a rubrica de atraso
            cRecPag      := 'P';
            if dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsInteger = 0
            then begin
               sIdRubrica   := dtmAPrev.qryAux.FieldByName('IDRUBRICAATRASO').AsString;
               sFlgDesconto := '1';
               sFlgAtrasoDevol := 'A';
            end
            else begin
               sIdRubrica   := dtmAPrev.qryAux.FieldByName('IDRUBRICADEVOLUC').AsString;
               sFlgDesconto := '0';
               sFlgAtrasoDevol := 'D';
            end;

            if Trim(sIdRubrica) = ''
            then begin
               MsgDlg('Rubrica para acerto de contribuição não preenchida. Verifique.','Erro',mtError,[mbOk],0);
               Exit;
            end;

            dtmAPrev.qryAux.Close;
            dtmAPrev.qryAux.SQL.Clear;
            dtmAPrev.qryAux.SQL.Add(' SELECT CODPROVDESC FROM PROVDESC WHERE IDPROVENTO = '+sIdRubrica);
            dtmAPrev.qryAux.Open;

            if not dtmAPrev.qryAux.IsEmpty
            then sCodProvDesc := dtmAPrev.qryAux.FieldByName('CODPROVDESC').AsString;

            dValorRateadoOrig := dtmAPrev.qry.FieldByName('VALORCALCULADO').AsFloat;
            dtmAPrev.qryBenef.First;

            while not dtmAPrev.qryBenef.Eof do
            begin

               if  (not bTemOutroRecebedor) and (not  bFaltaPercentual)
               then  dValorRateado := dValorRateadoOrig * dtmAPrev.qryBenef.FieldByName('PERCENTUAL').AsFloat / 100
               else  dValorRateado := dValorRateadoOrig / dtmAPrev.qryBenef.recordcount;


               // *******************************************************************
               // Preencher Informacoes de Integracao com Financeiro e Contabilidade
               // *******************************************************************
               if (prmIntegraContab = True) or (prmIntegraCAR = True) or
                (prmIntegraCAP = True) Then

                 if not dtmAPrevIntegraBack.BuscaInfIntegra( piIdPessJur,
                                         piIdPlanoPrev,
                                         piIdTitular,
                                         dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsInteger,
                                         dtmAPrev.qry.FieldByName('IDCONTRIBUICAO').AsInteger,
                                         'C',
                                         'B',
                                         dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsInteger,
                                         Copy(psDataCobranca,7,4)+'/'+Copy(psDatacobranca,4,2),
                                         dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString,
                                         sTipCodigo,
                                         sCodTipRecDes,
                                         sRecPag,
                                         sCodTipDoc,
                                         sCodPortForma,
                                         sCodCentroRespon,
                                         sCodSubConta,
                                         sCodCentroCustoD,
                                         sIdEmpresa,
                                         sCodCentroCustoC,
                                         sPlaContaD,
                                         sPlano,
                                         sPlaContaC,
                                         sPlaContaDProvis,
                                         sPlaContaCProvis,
                                         sUnidNegoc,
                                         sIdEmpresaProp,
                                         'R',
                                         True,
                                         sMsgErro )
                 then begin
                    MsgDlg('Acerto de Contribuição : Erro ao buscar parametrização financeira. Verifique.','Erro',mtError,[mbOk],0);
                    Exit;
                 end;

               iIdRecebedor := dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsInteger;

               if not InsereTMPDESC ( dtmAPrev.qryAux,
                                      '', sCodCentroCustoC, sCodCentroCustoD,
                                      sCodCentroRespon, '', '',
                                      sCodPortForma, sCodProvDesc, sCodSubConta,
                                      sCodTipDoc, sCodTipRecDes, '',
                                      psDATACOBRANCA, '', psDATACOBRANCA,
                                      'Atraso/Devolução de Contribuição Pós-Morte',
                                      '', '',
                                      sFlgAtrasoDevol, 'B' , sFlgDesconto,
                                      '0',
                                      '', 'P', dtmAPrev.qry.FieldByName('IDCONTRIBUICAO').AsString,
                                      sIdEmpresaProp,sIdEmpresaProp,sIdEmpresaProp,
                                      dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString,
                                      IntToStr(iIdFundacao),
                                      IntToStr(piIdLote),
                                      IntToStr(Sistema.IdModulo),
                                      IntToStr(piIdMotivo),
                                      IntToStr(piIdPessJur),
                                      IntToStr(iIdRecebedor),
                                      IntToStr(piIDPLANOPREV), '',
                                      sIdRubrica,
                                      IntToStr(piIDTITULAR),
                                      '',
                                      '',
                                      Copy(psDataCobranca,7,4)+'/'+Copy(psDatacobranca,4,2),
                                      dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString,
                                      '', '', sPlaContaC,
                                      sPlaContaD, sPlano, cRecPag,
                                      '***', '1', IntToStr(Sistema.IdModulo),
                                      '0',  prmTpOperFolhaBen,  sUnidNegoc, FloatToStr(dValorRateado),
                                      '', '', '', '', '',
                                      dtmAPrev.qry.FieldByName('NUMRECEBIMENTO').AsInteger)
               then begin
                  MsgDlg('Erro ao inserir Atraso/Devolução de Contribuição Pós-Morte.','Erro',mtError,[mbOk],0);
                  Exit;
               end
               else
                 if not AtualizaMesNaoIdentificado(
                          psDataCobranca,
                          dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString,
                          dtmAPrev.qry.FieldByName('MESCOBRANCA').AsString,
                          dtmAPrev.qry.FieldByName('IDMOTIVO').asinteger,
                          dtmAPrev.qry.FieldByName('NUMRECEBIMENTO').asinteger) then
                 begin
                   MsgDlg('Erro ao atualizar Mês de Cobrança no Histórico '+
                     'de Contribuições Pós-Morte','Erro', mtError, [mbOk], 0);
                   Exit;
                 end;

               dValorAcertado    := dValorAcertado + dValorRateado;
               dtmAPrev.qryBenef.Next;
            end;

            // *******************************************************************************************
            // BAIXAR OS REGISTROS DA HSTCONTRIBPREV RELATIVOS AO TITULAR (PARTICIPANTE)
            // *******************************************************************************************
            if FieldByName('VALORESPERADO').AsFloat - dValorAcertado <= 0.01
            then begin
               dtmAPrev.qryAux.Close;
               dtmAPrev.qryAux.SQL.Clear;
                 dtmAPrev.qryAux.SQL.Add(' UPDATE  HSTCONTRIBPREV SET VALORRECEBIDO = NULL, FOLHAORIGEM = ''B''  '+
                       ' WHERE   MESREFERENCIA  = '''+FieldByName('MESREFERENCIA').AsString+''''+
                       ' AND     MESCOBRANCA    = '''+FieldByName('MESCOBRANCA').AsString+''''+
                       ' AND     (IDMOTIVO      = '+IntToStr(prmIdMotDevolNaoIden)+
                       ' OR IDMOTIVO      ='+ IntToStr(prmIdMotivoAcertoFL)+') '+
                       ' AND     NUMRECEBIMENTO = '+FieldByName('NUMRECEBIMENTO').AsString);
               try
                  dtmAPrev.qryAux.ExecSql;
               except
                  MsgDlg('Erro ao atualizar Atraso/Devolução de Contribuição Pós-Morte','Erro',mtError,[mbOk],0);
                  Exit;
               end;
            end
            else begin
               dtmAPrev.qryAux.Close;
               dtmAPrev.qryAux.SQL.Clear;
               dtmAPrev.qryAux.SQL.Add(' UPDATE  HSTCONTRIBPREV SET VALORESPERADO = '+OraNumero(FormatFloat('#0.00',FieldByName('VALORESPERADO').AsFloat - dValorAcertado))+
                       ' WHERE   MESREFERENCIA  = '''+FieldByName('MESREFERENCIA').AsString+''''+
                       ' AND     MESCOBRANCA    = '''+FieldByName('MESCOBRANCA').AsString+''''+
                       ' AND     (IDMOTIVO      = '+IntToStr(prmIdMotDevolNaoIden)+
                       ' OR IDMOTIVO      ='+ IntToStr(prmIdMotivoAcertoFL)+') '+
                       ' AND     NUMRECEBIMENTO = '+FieldByName('NUMRECEBIMENTO').AsString);
               try
                  dtmAPrev.qryAux.ExecSql;
               except
                  MsgDlg('Erro ao atualizar Atraso/Devolução de Contribuição Pós-Morte','Erro',mtError,[mbOk],0);
                  Exit;
               end;
            end;
            Next; //dtmaprev.qry
         end; // while
      end; // with

  end; // if not bFazAcerto

  with dtmAPrev.qry do
  begin

    //cobra décimo terceiro rateado
    //e dá baixa no registro anterior
    Close;
    SQL.Clear;
    SQL.Add(' SELECT HST.MESCOBRANCA, HST.NUMRECEBIMENTO, HST.MESREFERENCIA, HST.IDCONTRIBUICAO, '+
            '        HST.VALORESPERADO, HST.VALORCALCULADO, HST.FLGDEVOLUCAO, HST.IDMOTIVO '+
            ' FROM   HSTCONTRIBPREV  HST                              '+
            ' WHERE  HST.IDPESSJUR      = '+IntToStr(piIdPessJur)+
            ' AND    HST.IDPLANOPREV    = '+IntToStr(piIDPLANOPREV)+
            ' AND    HST.IDTITULAR      = '+IntToStr(piIDTITULAR)+//Fanuel Junior SOL 157444/5301 Kintana 1329006
            //William Moreira da Silva - SOL 213329
            //' AND    HST.IDPESSOA       = '+IntToStr(piIDTITULAR)+
            ' AND    HST.IDPESSOA       = '+IntToStr(piIdPessoa)+
            //William Moreira da Silva - SOL 213329
            ' AND    HST.SEQPROPOSTA    = '+IntToStr(piSEQPROPOSTA)+
            ' AND    (( (HST.IDMOTIVO = '+IntToStr(prmIdMotDevolNaoIden)+
            ' OR HST.IDMOTIVO = '+ IntToStr(prmIdMotivoAcertoFL)+') '+
            '            AND (HST.SITRECEBIMENTO = 0)  '+
            '            AND    (HST.MESREFERENCIA  >= '''+Copy(psDataMorte,7,4)+'/'+Copy(psDataMorte,4,2)+''')) '+
            '        OR  ((HST.VALORESPERADO > 0 )  AND    (HST.SITRECEBIMENTO <> ''2'') '+
            '              AND    (HST.SITRECEBIMENTO <> ''4'') '+ 
            '            AND    (HST.SITRECEBIMENTO <> ''5'') '+
            '            AND    (HST.SITRECEBIMENTO <> ''9'') '+
            '            AND    (HST.MESREFERENCIA < '''+Copy(psDataMorte,7,4)+'/'+Copy(psDataMorte,4,2)+''')) '+
            '        OR  ((HST.VALORESPERADO > HST.VALORRECEBIDO )  AND  (HST.SITRECEBIMENTO = ''3'')) ) '+ 
            ' AND    SUBSTR(HST.MESREFERENCIA,6,2)  = ''13'' '+
            ' ORDER BY HST.MESREFERENCIA' );

    Open;
    if IsEmpty
    then begin
       Result := True;
       Close;
       Exit;
    end;

    First;
    while not Eof do
    begin
       // Buscar codigo da rubrica
       dtmAPrev.qryAux.Close;
       dtmAPrev.qryAux.SQL.Clear;
       dtmAPrev.qryAux.SQL.Add(' SELECT CP.IDRUBRICAATRASO, CP.IDRUBRICADEVOLUC, CP.IDRUBDECTERCATRA, CP.IDRUBDECTERCDEVOL '+
                               ' FROM   CONTPREV  CP '+
                               ' WHERE  CP.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
                               ' AND    CP.IDCONTRIBUICAO = '+FieldByName('IDCONTRIBUICAO').AsString);
       dtmAPrev.qryAux.Open;

       // Se for um pagamento atrasado, entao usar a rubrica de atraso
       cRecPag      := 'P';
       if dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsInteger = 0
       then begin
          sIdRubrica   := dtmAPrev.qryAux.FieldByName('IDRUBDECTERCATRA').AsString;
          sFlgDesconto := '1';
          sFlgAtrasoDevol := 'A';
       end
       else begin
          sIdRubrica   := dtmAPrev.qryAux.FieldByName('IDRUBDECTERCDEVOL').AsString;
          sFlgDesconto := '0';
          sFlgAtrasoDevol := 'D';
       end;

       if Trim(sIdRubrica) = ''
       then begin
          MsgDlg('Rubrica para acerto de contribuição sobre 13o. não preenchida. Verifique.','Erro',mtError,[mbOk],0);
          Exit;
       end;

       dtmAPrev.qryAux.Close;
       dtmAPrev.qryAux.SQL.Clear;
       dtmAPrev.qryAux.SQL.Add(' SELECT CODPROVDESC FROM PROVDESC WHERE IDPROVENTO = '+sIdRubrica);
       dtmAPrev.qryAux.Open;

       if not dtmAPrev.qryAux.IsEmpty
       then sCodProvDesc := dtmAPrev.qryAux.FieldByName('CODPROVDESC').AsString;

       // ****************************************************************************************
       // FAZER RATEIO DO VALOR A PAGAR
       // Se a fundação utiliza o percentual da BFCIARIOTITPLAN, ratear pelo percentual
       // Senao, ratear pelo número de beneficiários
       // ****************************************************************************************
       // Pro-ratear pelo número de dias, se for o mês do falecimento

       dValorAcertado    := 0;
       dValorRateadoOrig := dtmAPrev.qry.FieldByName('VALORCALCULADO').AsFloat;


       dtmAPrev.qryBenef.First;
       while not dtmAPrev.qryBenef.Eof do
       begin

         if  (not bTemOutroRecebedor) and (not  bFaltaPercentual)
         then  dValorRateado := dValorRateadoOrig * dtmAPrev.qryBenef.FieldByName('PERCENTUAL').AsFloat / 100
         else  dValorRateado := dValorRateadoOrig / dtmAPrev.qryBenef.recordcount;


         // ******************************************************************************
         // Preencher Informacoes de Integracao com Financeiro e Contabilidade
         // ******************************************************************************
         if (prmIntegraContab = True) or (prmIntegraCAR = True) or
            (prmIntegraCAP = True)
         Then
           if not dtmAPrevIntegraBack.BuscaInfIntegra( piIdPessJur,
                                                       piIdPlanoPrev, piIdTitular,
                                                       dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsInteger,
                                                       dtmAPrev.qry.FieldByName('IDCONTRIBUICAO').AsInteger,
                                                       'C', 'B',
                                                       dtmAPrev.qry.FieldByName('FLGDEVOLUCAO').AsInteger,
                                                       Copy(psDataCobranca,7,4)+'/'+Copy(psDatacobranca,4,2),
                                                       dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString,
                                                       sTipCodigo, sCodTipRecDes, sRecPag,
                                                       sCodTipDoc, sCodPortForma, sCodCentroRespon,
                                                       sCodSubConta, sCodCentroCustoD, sIdEmpresa,
                                                       sCodCentroCustoC, sPlaContaD, sPlano,
                                                       sPlaContaC, sPlaContaDProvis, sPlaContaCProvis,
                                                       sUnidNegoc, sIdEmpresaProp, 'R', True, sMsgErro )
           then begin
                MsgDlg('Acerto de Contribuição sobre 13o. : Erro ao buscar parametrização financeira. Verifique.','Erro',mtError,[mbOk],0);
                Exit;
           end;

         iIdRecebedor := dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsInteger;

         if not InsereTMPDESC ( dtmAPrev.qryAux,
                                '', sCodCentroCustoC, sCodCentroCustoD,
                                sCodCentroRespon, '', '',
                                sCodPortForma, sCodProvDesc, sCodSubConta,
                                sCodTipDoc, sCodTipRecDes, '',
                                psDATACOBRANCA, '', psDATACOBRANCA,
                                'Devolução de Contribuição Pós-Morte 13', '', '',
                                sFlgAtrasoDevol, 'B' , sFlgDesconto,
                                '0',
                                '', 'P', dtmAPrev.qry.FieldByName('IDCONTRIBUICAO').AsString,
                                sIdEmpresaProp,sIdEmpresaProp,sIdEmpresaProp,
                                dtmAPrev.qryBenef.FieldByName('IDPESSOA').AsString,
                                IntToStr(iIdFundacao), IntToStr(piIdLote),
                                IntToStr(Sistema.IdModulo), IntToStr(piIdMotivo),
                                IntToStr(piIdPessJur),
                                IntToStr(iIdRecebedor),
                                IntToStr(piIDPLANOPREV), IntToStr(piIDPLANOPREV),
                                sIdRubrica, IntToStr(piIDTITULAR), '',
                                '', Copy(psDataCobranca,7,4)+'/'+Copy(psDatacobranca,4,2),
                                dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString,
                                '', '', sPlaContaC,
                                sPlaContaD, sPlano, cRecPag,
                                '***', '1', IntToStr(Sistema.IdModulo),
                                 '0',  prmTpOperFolhaBen,  sUnidNegoc, FloatToStr(dValorRateado),
                                '', '', '', '', '',
                                dtmAPrev.qry.FieldByName('NUMRECEBIMENTO').AsInteger)
         then begin
            MsgDlg('Erro ao inserir Devolução de Contribuição Pós-Morte.','Erro',mtError,[mbOk],0);
            Exit;
         end
         else
         if not AtualizaMesNaoIdentificado(
                    psDataCobranca,
                    dtmAPrev.qry.FieldByName('MESREFERENCIA').AsString,
                    dtmAPrev.qry.FieldByName('MESCOBRANCA').AsString,
                    dtmAPrev.qry.FieldByName('IDMOTIVO').asinteger,
                    dtmAPrev.qry.FieldByName('NUMRECEBIMENTO').asinteger) then
         begin
             MsgDlg('Erro ao atualizar Mês de Cobrança no Histórico '+
               'de Contribuições Pós-Morte','Erro', mtError, [mbOk], 0);
             Exit;
         end;
         dValorAcertado    := dValorAcertado + dValorRateado;

         dtmAPrev.qryBenef.Next;

       end;

      // *************************************************************************
      // BAIXAR OS REGISTROS DA HSTCONTRIBPREV RELATIVOS AO TITULAR (PARTICIPANTE)
      // *************************************************************************
      if FieldByName('VALORESPERADO').AsFloat - dValorAcertado <= 0.01
      then begin
         dtmAPrev.qryAux.Close;
         dtmAPrev.qryAux.SQL.Clear;
           dtmAPrev.qryAux.SQL.Add(' UPDATE  HSTCONTRIBPREV SET FOLHAORIGEM = ''B''  '+
                 ' WHERE   MESREFERENCIA  = '''+FieldByName('MESREFERENCIA').AsString+''''+
                 ' AND     MESCOBRANCA    = '''+FieldByName('MESCOBRANCA').AsString+''''+
                 ' AND     (IDMOTIVO      = '+IntToStr(prmIdMotDevolNaoIden)+
                 ' OR       IDMOTIVO       ='+ IntToStr(prmIdMotivoAcertoFL)+') '+
                 ' AND     NUMRECEBIMENTO = '+FieldByName('NUMRECEBIMENTO').AsString);
         try
            dtmAPrev.qryAux.ExecSql;
         except
            MsgDlg('Erro ao atualizar Devolução de Contribuição Pós-Morte','Erro',mtError,[mbOk],0);
            Exit;
         end;
      end
      else begin
         dtmAPrev.qryAux.Close;
         dtmAPrev.qryAux.SQL.Clear;
         dtmAPrev.qryAux.SQL.Add(' UPDATE  HSTCONTRIBPREV SET VALORESPERADO = '+OraNumero(FormatFloat('#0.00',FieldByName('VALORESPERADO').AsFloat - dValorAcertado))+
                 ' WHERE   MESREFERENCIA  = '''+FieldByName('MESREFERENCIA').AsString+''''+
                 ' AND     MESCOBRANCA    = '''+FieldByName('MESCOBRANCA').AsString+''''+
                 ' AND     (IDMOTIVO      = '+IntToStr(prmIdMotDevolNaoIden)+
                 ' OR       IDMOTIVO      ='+ IntToStr(prmIdMotivoAcertoFL)+') '+
                 ' AND     NUMRECEBIMENTO = '+FieldByName('NUMRECEBIMENTO').AsString);
         try
            dtmAPrev.qryAux.ExecSql;
         except
            MsgDlg('Erro ao atualizar Devolução de Contribuição Pós-Morte','Erro',mtError,[mbOk],0);
            Exit;
         end;
      end;

      Next;

    end; // while

  end; // with

  Result := True;

end; // TrataDevolContrib

function VerificaUltimoReajuste(qryAux : twwquery;
                                pinumeroprocesso : longint) : string;
begin
  try
    qryaux.sql.text:='select ULTMESREAJUSTE from benefbfciario '+
                     'where numeroprocesso = '+inttostr(pinumeroprocesso);
    qryaux.open;
    if qryaux.isempty then
      result:=''
    else
      result:=qryaux.fields[0].asstring;
  except
    result:='';
  end;
end;

function ExecutaRegraBeneficioMinimo (qryAux : TwwQuery;
                                      piIdRegraBenefMin,
                                      piIdPessJur,
                                      piIdPlanoPrev,
                                      piIdTitular,
                                      piSeqProposta,
                                      piIdBeneficio,
                                      piIdPessoa,
                                      piIdSitFunc,
                                      piIdSitPart,
                                      piIdSitPlano          : longint;
                                      prOpcao1,
                                      prOpcao2,
                                      prOpcao3              : double;
                                      psDataEvento,
                                      psDataInicio,
                                      psDataInicioINSS,
                                      psDataInicioPagto,
                                      psDataRequerimento,
                                      psValorInfINSS,
                                      psValorCalcINSS,
                                      psValorSuplementacao  : string;
                                      psDataInicioAnt,
                                      psValorBenefAnt       : string;
                                      piFlgPossuiAcompINSS  : integer;
                                      var bErro             : boolean;
                                      psValorSRB,
                                      psValorTotal,
                                      psAnoMesRef : string;
                                      pdPercentual : double = 0 ) : boolean;
var bBeneficioMinimo : boolean;
    sSQL             : string;
begin
  Result := False;
  if piIdRegraBenefMin <= 0 then Exit;

  // Para a regra de calculo, DATAINICIO = DIB - DATA DE DIREITO = (QUASE SEMPRE) DATA DO EVENTO
  //                          DATAREF    = DATA DO EVENTO


  if Trim(psDataEvento)       = '' then psDataEvento       := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataInicio)       = '' then psDataInicio       := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataInicioINSS)   = '' then psDataInicioINSS   := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataInicioPagto)  = '' then psDataInicioPagto  := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataRequerimento) = '' then psDataRequerimento := FormatDateTime('dd/mm/yyyy', Date);

  if Trim(psValorBenefAnt)    = '' then psValorBenefAnt    := '0';

  sSQL := ' SELECT  1 FLGCONCESSAO, '                                                                        +
          '        PF.ESTCIVIL, '                                                                            +
          '        PP.SEQPROPOSTA,  '                                                                        +
          '        PP.DATAOPCAOIR, PP.TIPOOPCAOIR, '                                                         +
          '        PP.IDPESSOA AS IDTITULAR,   PP.IDPESSJUR,       PP.IDPLANOPREV,   PP.INSCRICAODATA,     ' +
          '        PP.INSCRICAOTIPO,           PP.DTINICIOINSC,    PF.DATANASC,      PF.SEXO,              ' +
          '        PF.DATAMORTE,               EL.SALTOTAL,        EL.DATAADMISSAO,  EL.TEMPOSERVANTERIOR, ' +
          '        EL.TEMPONAOCREDITADO,       EL.TEMPOSERVTOTAL,  EL.DATADEMISSAO,  SP.FLGINTERNO,        ' +
          '        EL.TEMPOSERVTOTMES,         EL.TEMPOSERVTOTDIA,                                         ' +
          IntToStr(piIdPessoa)                 +  ' AS IDPESSOA,               '                             +
          IntToSTr(piIdBeneficio)              +  ' AS IDBENEFICIO ,           '                             +
          IntToStr(piFlgPossuiAcompINSS)       +  ' AS FLGPOSSUIACOMPINSS,     '                             +
          OraNumero(psValorCalcINSS)           +  ' AS VLRCALCINSS,            '                             +
          OraNumero(psValorInfINSS)            +  ' AS VLRINFINSS,             '                             +
          OraNumero(FloatToStr(prOpcao1))      +  ' AS VALORBASE1,             '                             +
          OraNumero(FloatToStr(prOpcao2))      +  ' AS VALORBASE2,             '                             +
          OraNumero(FloatToStr(prOpcao3))      +  ' AS VALORBASE3,             '                             +
          OraNumero(psValorSRB)                +  ' AS VALORSRB,               '                             +
          OraNumero(psValorTotal)              +  ' AS VALORTOTAL,             '                             +
          IntToStr(piIdSitFunc)                +  ' AS IDSITFUNC,              '                             +
          IntToStr(piIdSitPart)                +  ' AS IDSITPART,              '                             +
          IntToSTr(piIdSitPlano)               +  ' AS IDSITPLANOPREV ,        '                             +
          IntToStr(piIdSitFunc)                +  ' AS IDSITFUNCATUAL,         '                             +
          IntToStr(piIdSitPart)                +  ' AS IDSITPARTATUAL,         '                             +
          IntToSTr(piIdSitPlano)               +  ' AS IDSITPLANOATUAL ,       '                             +
          '''' +   Trim(psDataEvento)          +''' AS DATAREF,                '                             +
          '''' +   Trim(psDataInicio)          +''' AS DATAINICIO,             '                             +
          '''' +   Trim(psDataInicioINSS)      +''' AS DATAINICIOINSS,         '                             +
          '''' +   Trim(psDataInicioPagto)     +''' AS DATAINICIOPAGTO,        '                             +
          '''' +   Trim(psDataRequerimento)    +''' AS DATAREQUERIMENTO,       '                             +
          '''' +   Trim(psDataInicioAnt)       +''' AS DATAINICIOANT,          '                             +
          '''' +   Trim(psAnoMesRef)           +''' AS MESREFERENCIA,          '                             +
          OraNumero(psValorBenefAnt)           +  ' AS VLBENEFPGTO,            '                             +
          OraNumero(psValorBenefAnt)           +  ' AS VALORBENEFANT,          '                             +
          OraNumero(psValorSuplementacao)      +  ' AS VALORORIGINAL,          '                             +
          OraNumero(psValorSuplementacao)      +  ' AS VALORPREV,              '                             +
          OraNumero(FloatToStr(pdPercentual))  +  ' AS PERCENTUAL,             '                             +
          ' BP.FLGCALCTODOMES AS FLGBENEFCOTAS     '                                                         +
          ' FROM   PESSOAFISICA PF,  ELEGPATRO EL, PARTPREVPLAN PP, SITPART SP, '                            +
          ' BENEFPLANPREV BP '                                                                               +
          ' WHERE  PP.IDPESSJUR   = ' + IntToStr(piIdPessJur)                                                +
          ' AND    PP.IDPLANOPREV = ' + IntToStr(piIdPlanoPrev)                                              +
          ' AND    PP.IDPESSOA    = ' + IntToStr(piIdTitular)                                                +
          ' AND    PP.SEQPROPOSTA = ' + IntToStr(piSeqProposta)                                              +
          ' AND    EL.IDPESSJUR   = PP.IDPESSJUR          '                                                  +
          ' AND    EL.IDPESSOA    = PP.IDPESSOA           '                                                  +
          ' AND    PF.IDPESSOA    = EL.IDPESSOA           '                                                  +
          ' AND    SP.IDSITPART   = PP.IDSITPART          '                                                  +
          ' AND    BP.IDBENEFICIO = '+IntToStr(piIdBeneficio)                                                +
          ' AND    BP.IDPLANOPREV = PP.IDPLANOPREV      ';

  bBeneficioMinimo := False;
  bBeneficioMinimo := RegraBooleana(IntToStr(piIdRegraBenefMin),sSQL, bErro );

  if bErro
  then begin
     Result := False;
     Exit;
  end;

  bErro  := False;
  Result := bBeneficioMinimo;
end;

function ExecutaRegraCalculoSRB(qryAux : TwwQuery;
                                piIdRegraCalculo, 
                                piIdPessJur, piIdPlanoPrev, piIdTitular,
                                piSeqProposta, piIdBeneficio, piNumeroProcesso,
                                piIdSitFunc, piIdSitPart, piIdSitPlano : longint;
                                prOpcao1, prOpcao2, prOpcao3           : double;
                                psSQLBenefAssoc,
                                psDataEvento, psDataInicio, psDataInicioINSS,
                                psDataInicioPagto,
                                psDataRequerimento,
                                psValorInfINSS,
                                psValorCalcINSS,
                                psValorReserva      : string;
                                bBeneficioGrupo     : boolean;
                                piFlgTipoInss       : integer;
                                psDataInicioAnt,
                                psValorBenefAnt,
                                psVALORBINSSANT1,
                                psVALORBINSSANT2,
                                psVALORBINSSANT3    : string;
                                var bErro           : boolean;
                                var sMsgErro        : string;
                                var piIdCalculo     : longInt;
                                piFlgPossuiAcompINSS : integer;
                                piTipoMov            : integer = -1;
                                piIdPessoa           : longint = -1;
                                limpaRegra          : Boolean = False // Thiago Melo SOL 210200 Kintana 2027146
                                ) : double;
var
  sDataInicio,
  sDataInicioINSS,
  sDataRef,
  sOp1, sOp2, sOP3,
  sSQL,


  sSALPART,         sREMTOTAL,
  sValorBeneficio,  sDataInscFund,
  sValorReserva,
  sAnoMesRef      : string;
  rValorBeneficio,
  dSomaItemNaDIB,
  dSomaItemNoPBC  : double;

  // Dados necessários do benefício anterior
  sDataInicioAnt,  // var. auxiliar apenas para passar para a funcao. A var. utilizada é a psDataInicioAnt
  sValorAnt,       // var. auxiliar apenas para passar para a funcao. A var. utilizada é a psValorBenefAnt
  sNomeBenefAnt,
  sIdTpPagtoAnt,
  sFlgBenefMinAnt,
  sDataEventoAnt,
  sCodBeneficioAnt,
  sUltMesReajAnt,
  sNumProcINSS, 
  sValorBase1Ant,
  sValorBase2Ant,
  sValorBase3Ant   : string;

  iTotalBenef        : longint;

  // Variaveis para buscar os dados do INSS em vigor
  slValorCalcINSS,
  slValorInfINSS,
  slDataInicioINSS,
  slNumProcINSS,
  slValorBase1INSS,
  slValorBase2INSS,
  slValorBase3INSS,
  sFlgPagaINSS  : string;

  sAux : String;
begin
  Result := -1;
  if piIdRegraCalculo <= 0 then Exit;

  // Para a regra de calculo, DATAINICIO = DIB - DATA DE DIREITO = (QUASE SEMPRE) DATA DO EVENTO
  //                          DATAREF    = DATA DO EVENTO

  if Trim(psDataEvento)      = '' then psDataEvento      := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataInicio)      = '' then psDataInicio      := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataInicioINSS)  = '' then psDataInicioINSS  := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataInicioPagto) = '' then psDataInicioPagto := FormatDateTime('dd/mm/yyyy', date);

  sDataInicio     := psDataInicio;
  sDataInicioINSS := psDataInicioINSS;
  sDataRef        := psDataEvento;

  sAnoMesRef := Copy(psDataEvento,7,4) + '/' + Copy(psDataEvento,4,2);

  BuscaDadosBeneficioAnterior ( qryAux,
                                piIdPessJur, piIdPlanoPrev, piIdTitular,
                                piIdBeneficio,
                                0, 
                                psDataInicio,
                                sDataInicioAnt,
                                sValorAnt,
                                sNomeBenefAnt,
                                sIdTpPagtoAnt,
                                sUltMesReajAnt,
                                sFlgBenefMinAnt,
                                sDataEventoAnt,
                                sCodBeneficioAnt,
                                sValorBase1Ant, sValorBase2Ant, sValorBase3Ant, 
                                sNumProcINSS, 
                                False);

  if psValorInfInss <> ''
  then psValorInfINSS := OraNumero(Trim(psValorInfINSS))
  else psValorInfINSS := '0';

  sSALPART  := ORANUMERO(CalcSalPart( piIdPessJur,
                                      piIdTitular,
                                      SAnoMesAnterior(sAnoMesRef),
                                      qryAux));
  sREMTOTAL := ORANUMERO(CalcREMTOTAL( piIdPessJur,
                                       piIdTitular,
                                       SAnoMesAnterior(sAnoMesRef),
                                       qryAux));

  sDataInscFund := CalcDataInscFund(piIdPessJur, piIdPlanoPrev, piIdTitular,
                                    piSeqProposta,qryAux);


  if Trim(sDataInscFund) = '' then sDataInscFund := FormatDateTime('dd/mm/yyyy', Date); 

  if Trim(psValorInfINSS)  = '' then psValorInfINSS  := '0';
  if Trim(psValorCalcINSS) = '' then psValorCalcINSS := '0';
  if Trim(sSalPart)        = '' then sSalPart        := '0';
  if Trim(sRemTotal)       = '' then sRemTotal       := '0';

  if prOpcao1 >= 0
  then sOp1 := OraNumero(FloatToStr(prOpcao1))
  else sOp1 := '0';

  if prOpcao2 >= 0
  then sOp2 := OraNumero(FloatToStr(prOpcao2))
  else sOp2 := '0';

  if prOpcao3 >= 0
  then sOp3 := OraNumero(FloatToStr(prOpcao3))
  else sOp3 := '0';

  sDataEventoAnt := BuscaUltimoEvento( qryAux,
                                       piIdPessJur,   piIdPlanoPrev,
                                       piIdTitular,   piSeqProposta,
                                       psDataEvento,
                                       'DATAEVENTO');


  if Trim(sValorReserva) = ''      then sValorReserva := '0';

  if Trim(sDataRef) = ''           then sDataRef := FormatDateTime('dd/mm/yyyy', Date);

  if Trim(psValorBenefAnt) = ''     then psValorBenefAnt := '0';

  if Trim(psDataRequerimento) = '' then psDataRequerimento := FormatDateTime('dd/mm/yyyy', Date);
  if Trim(sDataEventoAnt) = ''     then sDataEventoAnt     := FormatDateTime('dd/mm/yyyy', Date);

  // SRB : Verificar se o beneficio calculado utiliza Evolucao Funcional
  // Se sim, então gerar o Resumo Funcional do participante neste momento
  qryAux.Close;
  qryAux.SQL.Clear;
  qryAux.SQL.Add(' SELECT FLGUSAEVOLFUNC FROM BENEFPLANPREV '+
                 ' WHERE  IDPLANOPREV = '+ IntToStr(piIdPlanoPrev)+
                 ' AND    IDBENEFICIO = '+ IntToStr(piIdBeneficio));
  qryAux.Open;

  if (not qryAux.IsEmpty) and (qryAux.FieldByName('FlgUsaEvolFunc').AsInteger = 1)
  then begin
     if not CalculaResumoFuncional ( piIdPessJur, piIdTitular,
                                     psDataInicio,
                                     sMsgErro )
     then begin
        bErro := True;
        sMsgErro := ' Ocorreu um erro na geração do Resumo Funcional. ';
        Result  := -1;
        Exit;
     end;
     dSomaItemNaDib := CalculaTotalResumoFuncional ( piIdPessJur, piIdTitular,dSomaItemNoPBC );
  end;

  // Somar o total de beneficiarios do titular
  with qryAux do
  begin
     Close;
     SQL.Clear;
     SQL.Add(' SELECT COUNT(IDPESSOA) AS TOTALDEPENDENTES '+
             ' FROM   DEPENTIT                            '+
             ' WHERE  IDTITULAR = '+IntToStr(piIdTitular) );
     Open;
     if IsEmpty
     then iTotalBenef := 0
     else iTotalBenef := FieldByName('TOTALDEPENDENTES').AsInteger;
  end;

  // Verificar se o beneficio de INSS já foi requerido.
  // Se sim, entao trazer os dados do INSS já preenchidos
  BuscaDadosINSSEmVigor ( qryAux,
                          piIdPessJur, piIdPlanoPrev, piIdTitular,
                          piIdTitular, piIdBeneficio, psDataInicio,
                          slValorCalcINSS, slValorInfINSS, slDataInicioINSS,
                          slNumProcINSS,
                          slValorBase1INSS, slValorBase2INSS, slValorBase3INSS,
                          sAux, sFlgPagaINSS );


  if Trim(psSQLBenefAssoc) = ''
  then psSQLBenefAssoc := ', 0 AS VALORASSOCIADO, 0 AS ASSOC1OP1, 0 AS ASSOC2OP1, 0 AS ASSOC3OP1, '+
                          '                       0 AS ASSOC1OP2, 0 AS ASSOC2OP2, 0 AS ASSOC3OP2, '+
                          '                       0 AS ASSOC1OP3, 0 AS ASSOC2OP3, 0 AS ASSOC3OP3  ';

  // Executa Regra de Cálculo do Valor do Beneficio
  // Se for revisao, e for beneficio para beneficiario, entao o idpessoa da query tem que ser o idpessoa
  // do beneficiario.
  if (piTipoMov = 13) and (piIdPessoa > 0 ) and (piIdPessoa <> piIdTitular)
  then begin
     sSQL := ' SELECT DISTINCT  1 FLGCONCESSAO,                                                                 '+ 
             '        PF.ESTCIVIL, '+
             '        PP.DATAOPCAOIR, PP.TIPOOPCAOIR, ' + 
             '        PP.SEQPROPOSTA,                                                                           '+ 
             //Helio/Wylliam Leite - SOL Nº 252639 PPM Nº 791162
             //'        BF.IDPESSJUR, BF.IDPLANOPREV, BF.IDPESSOA, BF.IDTITULAR, BF.IDPLANOORIGEM, BF.IDBENEFICIO,'+
             '        BF.IDPESSJUR, BF.IDPLANOPREV, BF.IDPESSOA AS IDENSIONSTA, BF.IDTITULAR AS IDPESSOA, BF.IDTITULAR, BF.IDPLANOORIGEM, BF.IDBENEFICIO,'+
             //FIM Helio/Wylliam Leite - SOL Nº 252639 PPM Nº 791162
             '        PP.INSCRICAODATA,                                                                         '+
             '        PP.INSCRICAOTIPO,     PP.DTINICIOINSC,  PF.DATANASC,      PF.SEXO,                        '+
             '        PF.DATAMORTE,         PP.IDPESSOA AS IDTITULAR,                                           '+
             '        EL.SALTOTAL,          EL.DATAADMISSAO,  EL.TEMPOSERVANTERIOR, EL.TEMPONAOCREDITADO,       '+
             '        EL.TEMPOSERVTOTAL,    EL.DATADEMISSAO,  EL.FLGDIRETOR,        SP.FLGINTERNO,              '+
             '        EL.TEMPOSERVTOTMES,   EL.TEMPOSERVTOTDIA,                                                 '+
             '        PP.IDPESSOA AS IDTITULAR,                                                                 '+
             IntToStr(piFlgPossuiAcompINSS)+' AS FLGPOSSUIACOMPINSS,                                            '+
             IntToSTr(piIdBeneficio)    +  ' AS IDBENEFICIO ,                                                   '+
             IntToSTr(piNumeroProcesso) +  ' AS NUMEROPROCESSO ,                                                '+
             IntToStr(piIdBeneficio)    +  ' AS IDBENEFICIO,                                                    '+
             IntToStr(piNumeroProcesso) +  ' AS NUMEROPROCESSO,                                                 '+
             ''''+sDataInscFund         +''' AS INSCRICAODATAFUND ,                                             '+
             OraNumero(psValorCalcINSS) +  ' AS VLRCALCINSS,                                                    '+
             OraNumero(psValorInfINSS)  +  ' AS VLRINFINSS,                                                     '+
             sSALPART                   +  ' AS VALORPROVENTO,                                                  '+
             sREMTOTAL                  +  ' AS VALORREMTOTAL,                                                  '+
             sOp1                       +  ' AS VALORBASE1,                                                     '+
             sOp2                       +  ' AS VALORBASE2,                                                     '+
             sOp3                       +  ' AS VALORBASE3,                                                     '+
             sValorReserva              +  ' AS VALORRESERVA,                                                   '+
             IntToStr(piIdSitFunc)      +  ' AS IDSITFUNC,                                                      '+
             IntToStr(piIdSitFunc)      +  ' AS IDSITFUNCATUAL,                                                 '+
             IntToStr(piIdSitFunc)      +  ' AS IDSITFUNCNOVO,                                                  '+
             IntToStr(piIdSitPart)      +  ' AS IDSITPART,                                                      '+
             IntToSTr(piIdSitPlano)     +  ' AS IDSITPLANOPREV ,                                                '+
             IntToStr(piIdSitFunc)      +  ' AS IDSITFUNCATUAL,                                                 '+
             IntToStr(piIdSitPart)      +  ' AS IDSITPARTATUAL,                                                 '+
             IntToSTr(piIdSitPlano)     +  ' AS IDSITPLANOATUAL ,                                               '+
             IntToSTr(piFlgTipoInss)    +  ' AS FLGTIPOINSS,                                                    '+
             '''' +   Trim(sDataRef)    +''' AS DATAREF,                                                        '+
             '''' +   Trim(sDataInicio) +''' AS DATAINICIOFUND,                                                 '+ 
             '''' +   Trim(psDataInicioPagto) +''' AS DATAINICIO,                                               '+
             '''' +   Trim(sDataInicioINSS)   +''' AS DATAINICIOINSS,   '+
             '''' +   Trim(psDataInicioPagto) +''' AS DATAINICIOPAGTO,  '+
             '''' +   Trim(psDataRequerimento)+''' AS DATAREQUERIMENTO, '+
             ''''+    sIdTpPagtoAnt           +''' AS IDTPPAGTOANT,     '+ 
             ''''+    sUltMesReajAnt          +''' AS ULTMESREAJANT,    '+ 
             ''''+    sFlgBenefMinAnt         +''' AS FLGBENEFMINANT,   '+ 
             '''' +   Trim(sDataEventoAnt)    +''' AS DATAEVENTOANT,    '+ 
             '''' +   Trim(sCodBeneficioAnt)  +''' AS CODBENEFICIOANT,  '+ 
             '''' +   Trim(psDataInicioAnt)   +''' AS DATAINICIOANT,    '+ 
             OraNumero(psValorBenefAnt)       +' AS VLBENEFPGTO,        '+ 
             OraNumero(psValorBenefAnt)       +' AS VALORBENEFANT,      '+
             OraNumero(psVALORBINSSANT1)      +' AS VALORBINSSANT1,     '+ 
             OraNumero(psVALORBINSSANT2)      +' AS VALORBINSSANT2,     '+ 
             OraNumero(psVALORBINSSANT3)      +' AS VALORBINSSANT3,     '+ 
             IntToStr(iTotalBenef)            +' AS NUMBENEF,           '+ 
             OraNumero(slValorBase1INSS)      +' AS VALORBASE1INSS,     '+
             OraNumero(slValorBase2INSS)      +' AS VALORBASE2INSS,     '+
             OraNumero(slValorBase3INSS)      +' AS VALORBASE3INSS,     '+
             OraNumero(FloatToStr(dSomaItemNoPBC))+' AS SOMAITEMNOPBC,  '+ 
             OraNumero(FloatToStr(dSomaItemNaDIB))+' AS SOMAITEMNADIB,  '+
             '''' +   Trim(sAnoMesRef)    +''' AS MESREF                '+   //edilaine SIG131098
             ', '+IntToSTr(piTipoMov)+ '  AS TIPOMOV                    '+   //edilaine SIG131098
             ', '+IntToSTr(piIdPessoa)+'  AS IDPENSIONSTA   '+ // Jonas Otavio Henrique R. Oliveira  SOL - 136384/11582 KTN - 1797879
             psSQLBenefAssoc+
             ' FROM   ELEGPATRO EL, PARTPREVPLAN PP, PESSOAFISICA PF,  SITPART SP, '+
             '        SITFUNC SF, BENEFPLANOPART BPL, BENEFBFCIARIO BF             '+
             ' WHERE  BF.IDPESSJUR   = ' + IntToStr(piIdPessJur)   + ' AND '+
             '        BF.IDPLANOPREV = ' + IntToStr(piIdPlanoPrev) + ' AND '+
             '        BF.IDTITULAR   = ' + IntToStr(piIdTitular)   + ' AND '+
             '        BF.IDPESSOA    = ' + IntToStr(piIdPessoa)    + ' AND '+
             '        BF.IDBENEFICIO = ' + IntToStr(piIdBeneficio) + ' AND '+
             '        BF.SEQPROPOSTA = ' + IntToStr(piSeqProposta) + ' AND '+
             '        BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso) + ' AND '+
             '        PP.IDPESSJUR      = BF.IDPESSJUR                     AND '+
             '        PP.IDPLANOPREV    = BF.IDPLANOORIGEM                 AND '+
             '        PP.IDPESSOA       = BF.IDTITULAR                     AND '+
             '        PP.SEQPROPOSTA = BF.SEQPROPOSTA                      AND '+
             '        EL.IDPESSJUR   = PP.IDPESSJUR         AND '+
             '        EL.IDPESSOA    = PP.IDPESSOA          AND '+
             '        PF.IDPESSOA    = EL.IDPESSOA          AND '+
             '        EL.IDSITFUNC   = SF.IDSITFUNC(+)      AND '+
             '        PP.IDPESSJUR   = BPL.IDPESSJUR(+)     AND '+
             '        PP.IDPLANOPREV = BPL.IDPLANOPREV(+)   AND '+
             '        PP.IDPESSOA    = BPL.IDPESSOA(+)      AND '+
             '        PP.SEQPROPOSTA = BPL.SEQPROPOSTA(+)   AND '+
             '        SP.IDSITPART   = PP.IDSITPART ';
  end
  else begin
     sSQL := ' SELECT DISTINCT  1 FLGCONCESSAO, '+ 
             '        PF.ESTCIVIL, '+ 
             '        PP.DATAOPCAOIR, PP.TIPOOPCAOIR, ' +
             '        PP.SEQPROPOSTA,  '+ 
             '        PP.IDPESSOA, PP.IDPESSJUR,     PP.IDPLANOPREV,   PP.INSCRICAODATA, '+
             '        PP.INSCRICAOTIPO,     PP.DTINICIOINSC,  PF.DATANASC,      PF.SEXO,          '+
             '        PF.DATAMORTE,         PP.IDPESSOA AS IDTITULAR,                             '+
             '        EL.SALTOTAL,          EL.DATAADMISSAO,  EL.TEMPOSERVANTERIOR, EL.TEMPONAOCREDITADO,  '+
             '        EL.TEMPOSERVTOTAL,    EL.DATADEMISSAO,  EL.FLGDIRETOR,        SP.FLGINTERNO,                         '+
             '        EL.TEMPOSERVTOTMES,   EL.TEMPOSERVTOTDIA,                                     '+
             '        PP.IDPESSOA AS IDTITULAR,                                                   '+
             IntToStr(piFlgPossuiAcompINSS)+' AS FLGPOSSUIACOMPINSS,                              '+
             IntToSTr(piIdBeneficio)    +  ' AS IDBENEFICIO ,                                     '+
             IntToSTr(piNumeroProcesso) +  ' AS NUMEROPROCESSO ,                                  '+
             IntToStr(piIdBeneficio)    +  ' AS IDBENEFICIO,                                      '+
             IntToStr(piNumeroProcesso) +  ' AS NUMEROPROCESSO,                                   '+
             ''''+sDataInscFund         +''' AS INSCRICAODATAFUND ,                               '+
             OraNumero(psValorCalcINSS) +  ' AS VLRCALCINSS,                                      '+
             OraNumero(psValorInfINSS)  +  ' AS VLRINFINSS,                                       '+
             sSALPART                   +  ' AS VALORPROVENTO,                                    '+
             sREMTOTAL                  +  ' AS VALORREMTOTAL,                                    '+
             sOp1                       +  ' AS VALORBASE1,                                       '+
             sOp2                       +  ' AS VALORBASE2,                                       '+
             sOp3                       +  ' AS VALORBASE3,                                       '+
             sValorReserva              +  ' AS VALORRESERVA,                                     '+
             IntToStr(piIdSitFunc)      +  ' AS IDSITFUNC,                                        '+
             IntToStr(piIdSitFunc)      +  ' AS IDSITFUNCATUAL,                                   '+
             IntToStr(piIdSitFunc)      +  ' AS IDSITFUNCNOVO,                                    '+
             IntToStr(piIdSitPart)      +  ' AS IDSITPART,                                        '+
             IntToSTr(piIdSitPlano)     +  ' AS IDSITPLANOPREV ,                                  '+
             IntToStr(piIdSitFunc)      +  ' AS IDSITFUNCATUAL,                                   '+
             IntToStr(piIdSitPart)      +  ' AS IDSITPARTATUAL,                                   '+
             IntToSTr(piIdSitPlano)     +  ' AS IDSITPLANOATUAL ,                                 '+
             IntToSTr(piFlgTipoInss)    +  ' AS FLGTIPOINSS,                                      '+
             '''' +   Trim(sDataRef)    +''' AS DATAREF,                                          '+
             '''' +   Trim(sDataInicio) +''' AS DATAINICIOFUND,  '+
             '''' +   Trim(psDataInicioPagto) +''' AS DATAINICIO,                                 '+
             '''' +   Trim(sDataInicioINSS)   +''' AS DATAINICIOINSS,   '+
             '''' +   Trim(psDataInicioPagto) +''' AS DATAINICIOPAGTO,  '+
             '''' +   Trim(psDataRequerimento)+''' AS DATAREQUERIMENTO, '+
             ''''+    sIdTpPagtoAnt           +''' AS IDTPPAGTOANT,     '+
             ''''+    sUltMesReajAnt          +''' AS ULTMESREAJANT,    '+
             ''''+    sFlgBenefMinAnt         +''' AS FLGBENEFMINANT,   '+
             '''' +   Trim(sDataEventoAnt)    +''' AS DATAEVENTOANT,    '+
             '''' +   Trim(sCodBeneficioAnt)  +''' AS CODBENEFICIOANT,  '+
             '''' +   Trim(psDataInicioAnt)   +''' AS DATAINICIOANT,    '+
             OraNumero(psValorBenefAnt)       +' AS VLBENEFPGTO,        '+
             OraNumero(psValorBenefAnt)       +' AS VALORBENEFANT,      '+
             OraNumero(psVALORBINSSANT1)      +' AS VALORBINSSANT1,     '+
             OraNumero(psVALORBINSSANT2)      +' AS VALORBINSSANT2,     '+
             OraNumero(psVALORBINSSANT3)      +' AS VALORBINSSANT3,     '+
             IntToStr(iTotalBenef)            +' AS NUMBENEF,           '+
             OraNumero(slValorBase1INSS)      +' AS VALORBASE1INSS,     '+
             OraNumero(slValorBase2INSS)      +' AS VALORBASE2INSS,     '+
             OraNumero(slValorBase3INSS)      +' AS VALORBASE3INSS,     '+
             OraNumero(FloatToStr(dSomaItemNoPBC))+' AS SOMAITEMNOPBC,  '+
             OraNumero(FloatToStr(dSomaItemNaDIB))+' AS SOMAITEMNADIB,  '+
             '''' +   Trim(sAnoMesRef)    +''' AS MESREF                '+   //edilaine SIG131098
             ', '+IntToSTr(piTipoMov)+ '  AS TIPOMOV                    '+   //edilaine SIG131098
             ', '+IntToSTr(piIdPessoa)+'  AS IDPENSIONSTA   '+ // Jonas Otavio Henrique R. Oliveira  SOL - 136384/11582 KTN - 1797879
             psSQLBenefAssoc+
             ' FROM   ELEGPATRO EL, PARTPREVPLAN PP, PESSOAFISICA PF,  SITPART SP, SITFUNC SF, BENEFPLANOPART BPL  '+
             ' WHERE  PP.IDPESSJUR   = ' + IntToStr(piIdPessJur)   + ' AND '+
             '        PP.IDPLANOPREV = ' + IntToStr(piIdPlanoPrev) + ' AND '+
             '        PP.IDPESSOA    = ' + IntToStr(piIdTitular)   + ' AND '+
             '        PP.SEQPROPOSTA = ' + IntToStr(piSeqProposta) + ' AND '+
             '        EL.IDPESSJUR   = PP.IDPESSJUR         AND '+
             '        EL.IDPESSOA    = PP.IDPESSOA          AND '+
             '        PF.IDPESSOA    = EL.IDPESSOA          AND '+
             '        EL.IDSITFUNC   = SF.IDSITFUNC(+)      AND '+
             '        PP.IDPESSJUR   = BPL.IDPESSJUR(+)     AND '+
             '        PP.IDPLANOPREV = BPL.IDPLANOPREV(+)   AND '+
             '        PP.IDPESSOA    = BPL.IDPESSOA(+)      AND '+
             '        PP.SEQPROPOSTA = BPL.SEQPROPOSTA(+)   AND '+
             '        SP.IDSITPART   = PP.IDSITPART ';
  end;

  piIdCalculo := -1;//Marcio Sanches Spinosa SOL 229542 PPM 340781
  sValorBeneficio := RegraNumerica(IntToStr(piIdRegraCalculo),sSQL  , bErro, piIdCalculo, True, limpaRegra );  // Thiago Melo SOL 210200 Kintana 2027146

  if bErro
   then begin
     bErro := True;
     sMsgErro := ' Ocorreu um erro na Regra de Cálculo do Valor do Benefício (nº '+IntToStr(piIdRegraCalculo)+') ';
     Result  := -1;
     Exit;
  end;

  if Trim(sValorBeneficio) = ''
  then begin
     bErro := True;
     sMsgErro := ' A Regra de Cálculo do Valor do Benefício (nº '+IntToStr(piIdRegraCalculo)+')'+
                 ' retornou um valor em branco. ';
     Result  := -1;
     Exit;
  end;

  try
     rValorBeneficio := StrToFloat(ClienteNumero(sValorBeneficio));
  except
     bErro := True;
     sMsgErro := ' A Regra de Cálculo do Valor do Benefício (nº '+IntToStr(piIdRegraCalculo)+')' +
                 ' retornou um valor inválido. [Valor Retornado = '+sValorBeneficio+']';
     Result  := -1;
     Exit;
  end;
  bErro := False;
  sMsgErro := ' ';
  Result := rValorBeneficio;
end;

{------------------------------------------------------------------------------}
Function CalculaBeneficioAPagarNoMes( QryAux : TwwQuery;
                                      psAnoMesCalculo : String;
                                      piIdTitular,        piIdBeneficiario,
                                      piSeqProposta,      piIdPessJur,
                                      piIdPlanoPrev,      piNumeroProcesso,
                                      piIdBeneficio,      piTotBeneficiarios,
                                      piIdRegraPrimPagto, piIdRegraUltPagto,
                                      piIdTpPagto : Longint;
                                      psDataInicio,    psDataFinal,
                                      psUltMesCalculo, psCalculaTodoMes : String;
                                      Var dValorEmReal, dValorTotal : Double;
                                      dValorEmCotas : Double;
                                      pbCalculaPrimUltPgto : Boolean;
                                      psDataInicioOriginal : String;
                                      piTipoMov, piFlgDataPrevista : Word;
                                      Var bErro, bReajustou  : Boolean;
                                      Var sUltMesReajuste : String;
                                      Var pdValorBeneficioIntegralOriginal,
                                          pdValorBeneficioIntegralAposMinimo,
                                          pdValorPrevAntesMinimo,
                                          pdValorBenefRateado,
                                          pdValorSRBRetorno : Double;
                                      Var piIdCalculo : LongInt;
                                          psDataPagamento : String;
                                          pbCalculaTudo : Boolean = False;
                                          pbMigracaoPlano : Boolean = False;
                                          pIDPLANPREVCONTAB : integer = -1; // SOL:128981 - Daniel Begnami
                                          bAtualizaVlrTotal : Boolean = True; // SOL 172575 Kintana 1554837  //BRUNO AZEVEDO SOL 156226
                                          bCalculoDeficit : Boolean = False; //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131
                                          bAplicaRateioBenefBfciario : boolean = true;   // edilaine - SOL 253577-18064 / PPM 1240079
                                          bCalcularVlrMinimo : boolean = true  // edilaine - SOL 253577-18064 / PPM 1240079
                                    ) : Double;
Var
   dValorBeneficioNoMes, dValorBase1,         dValorBase2,       dValorBase3,
   dValorEmRealOriginal, dValorTotalOriginal, dValorAReajustar,  dValorDepoisMinimo  : Double;
   bRetroativo,     bPagtoUnico,        bPagaIntegral : Boolean;
   sDataFinal,      sDataRef,
   sVlrCalcInss,    sVlrInfINSS,
   sMsgErro,        lsDataInicio,       sValorFinal,        sDia,
   sDataEvento,     sFlgInternoAntes,   sFlgInternoAtual,   sIdSitPartAntes,
   sIdSitPlanAntes, sIdSitFuncAntes,    sIdSitPartAtual,    sIdSitPlanAtual,
   sIdSitFuncAtual  : String;
   sFlgBenefMinimo, sTPMODALIDADE, sIDTPPAGTOANT : String;
   iIdRegraCalculo,   iIdRegraCalcReserva,   iOrigem,   iIdParticipante,
   iIdTitularBenef,   iIdBeneficiario : Integer;
   bPrimeiroDia : Boolean; //Renato Visoni SOL 158469 Kintana 1285346
   sDataInicioTratada : String;  // SOL 204188 Kintana 1973428
   iIdTpPagtoBenefic : Integer; //SIG60869
Begin

  Result := 0;
  bErro  := False;

  dValorBeneficioNoMes := 0;

  pdValorBeneficioIntegralOriginal   := 0;
  pdValorBeneficioIntegralAposMinimo := 0;
  iIdTpPagtoBenefic:= 0; //SIG60869

  if sUltMesReajuste = ''
  then sUltMesReajuste := VerificaUltimoReajuste(qryAux, piNumeroProcesso);

  dValorEmRealOriginal     := dValorEmReal;
  dValorTotalOriginal      := dValorTotal;

  if (piTipoMov = 6) or (piTipoMov = 12) or (piTipoMov = 13) or
     (piTipoMov = 1)  // edilaine - SOL 253577-18151 / PPM 1318910
  then bRetroativo := True
  else bRetroativo := False;


  { Verificar se o beneficio é pagamento unico }
  qryAux.Close;
  qryAux.SQL.Clear;
  qryAux.SQL.Add(' SELECT T.FLGFREQUENCIA '+
                 ' FROM   TPPAGTOBENEFICIO T   '+
                 ' WHERE  T.IDTPPAGTOBENEFIC = '+IntToStr(piIdTpPagto));
  qryAux.Open;
  if (qryAux.IsEmpty) or (qryAux.FieldByName('FlgFrequencia').AsString <> 'U')
  then bPagtoUnico := False
  else bPagtoUnico := True;

  { Verificar se o beneficio é para pagar integral no último mês de data prevista }
  qryAux.Close;
  qryAux.SQL.Clear;
  qryAux.SQL.Add(' SELECT BP.IDREGRACALCULO, BP.FLGPAGAINTEG, BP.IDREGRAPAGAMENTO,  '+
                 '        BP.TPMODALIDADE '+ 
                 ' FROM   BENEFPLANPREV BP                              '+
                 ' WHERE  BP.IDPLANOPREV   = '+IntToStr(piIdPlanoPrev)   +
                 ' AND    BP.IDBENEFICIO   = '+IntToStr(piIdBeneficio)  );

  qryAux.Open;
  if not (qryAux.IsEmpty) then
  begin
     sTPMODALIDADE := qryAux.FieldByName('TPMODALIDADE').AsString;
     if qryAux.FieldByName('FLGPAGAINTEG').AsInteger > 0
     then bPagaIntegral       := True
     else bPagaIntegral       := False;
     iIdRegraCalculo     := qryAux.FieldByName('IDREGRACALCULO').AsInteger;
     iIdRegraCalcReserva := qryAux.FieldByName('IDREGRAPAGAMENTO').AsInteger;
  end
  else
  begin
     bPagaIntegral       := False;
     iIdRegraCalculo     := -1;
     iIdRegraCalcReserva := -1;
  end;


  // Buscar opcoes do beneficio para passar para a regra de reajuste
  with qryAux do
  begin
     Close;
     SQL.Clear;
     If piIdTitular = piIdBeneficiario Then
       SQL.Add(' SELECT VALORBASE1, VALORBASE2, VALORBASE3 FROM BENEFPLANOPART '+
               ' WHERE  IDPESSJUR    = '+IntToStr(piIdPessJur)+
               ' AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
               ' AND    IDPESSOA     = '+IntToStr(piIdBeneficiario)+
               ' AND    SEQPROPOSTA  = '+IntToStr(piSeqProposta)+
               ' AND    IDBENEFICIO  = '+IntToStr(piIdBeneficio) )
     Else
         SQL.Add(' SELECT VALORBASE1, VALORBASE2, VALORBASE3 FROM BENEFBFCIARIO '+
                 ' WHERE  IDPESSJUR    = '+IntToStr(piIdPessJur)+
                 ' AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                 ' AND    IDTITULAR    = '+IntToStr(piIdTitular)+
                 ' AND    IDPESSOA     = '+IntToStr(piIdBeneficiario)+
                 ' AND    SEQPROPOSTA  = '+IntToStr(piSeqProposta)+
                 ' AND    IDBENEFICIO  = '+IntToStr(piIdBeneficio) );
     Open;
     if not IsEmpty
     then begin
        dValorBase1 := FieldByName('VALORBASE1').AsFloat;
        dValorBase2 := FieldByName('VALORBASE2').AsFloat;
        dValorBase3 := FieldByName('VALORBASE3').AsFloat;
     end
     else begin
        dValorBase1 := 0;
        dValorBase2 := 0;
        dValorBase3 := 0;
     end;
  end;

  // Se o benefício for em cotas
  // Entao converter para real na data de competencia
  // Senao Se houve reajuste no mes
  //       Entao reajusta beneficio conforme tabela de reajuste
  if psCalculaTodoMes = '1'
  then sValorFinal := PegaValorEmReal( qryAux,
                                       piIdTitular,
                                       piIdBeneficiario,
                                       piIdPessJur,
                                       piIdPlanoPrev,
                                       piIdBeneficio,
                                       piSeqProposta,
                                       piTotBeneficiarios,
                                       psDataInicio,
                                       psDataPagamento,
                                       psAnoMesCalculo,
                                       dValorEmCotas,
                                       bErro,
                                       sMsgErro)
  else begin
       if (piTipoMov in [0,1,2,12])
       then lsDataInicio := psDataInicioOriginal
       else lsDataInicio := psDataInicio;

       if piIdTitular = piIdBeneficiario
       then dValorAReajustar := dValorEmReal
       else if (pIDPLANPREVCONTAB = 2) and (psAnoMesCalculo = '2023/01')     //edilaine SIG132162
       then dValorAReajustar := dValorEmReal                                 //edilaine SIG132162
       else dValorAReajustar := dValorTotal;

       // Origem :
       // 0 - Outros ,
       // 1 - Suspensao de contribuicao
       // 2 - Concessao de Beneficio
       // 3 - Renova
       // 4 - Encerramento
       // 5 - Desdobramento
       // 6 - Revisão de Benefícios

       case piTipoMov of
            0  : iOrigem := 3;  //  Renovacao
            1  : iOrigem := 3;  //  Reabertura
            2  : iOrigem := 3;  //  Prorrogacao
            3  : iOrigem := 4;  //  Retencao
            4  : iOrigem := 4;  //  Encerramento
            5  : iOrigem := 5;  //  Desdobramento 
            6  : iOrigem := 0;  //  Reajuste Judicial
            7  : iOrigem := 2;  //  Concessao
            8  : iOrigem := 0;  //  Recalculo de Beneficio Provisorio
            9  : iOrigem := 0;  //  Registro de falecimento de beneficiario
            10 : iOrigem := 0;  //  Desfazer
            11 : iOrigem := 12 {0};  //  Liberacao de pagamento integral     // Edilaine - SIG 21663
            12 : iOrigem := 12 {0};  //  Liberacao de Beneficio Retido       // Edilaine - SIG 21663
            13 : iOrigem := 6;  //  Revisão de Benefícios
            14 : iOrigem := 0;  //  Alteracao de Tipo de Beneficio
       end;

       // SE FOR RETROATIVO, PASSAR ULTMESREAJUSTE
       if bRetroativo
       then
         sValorFinal := ReajustaBenefConc( qryAux,
                                           psAnoMesCalculo,
                                           lsDataInicio,
                                           piIdPessJur,      piIdPlanoPrev, piIdTitular,
                                           piIdBeneficiario, piIdBeneficio, piNumeroProcesso,
                                           piTotBeneficiarios,
                                           dValorAReajustar,
                                           dValorBase1,      dValorBase2,   dValorBase3,
                                           bReajustou,
                                           bErro,            False,         sMsgErro,
                                           dValorTotal,      pdValorSRBRetorno,
                                           piIdCalculo,
                                           bRetroativo,
                                           iOrigem,
                                           sUltMesReajuste,
                                           pbCalculaTudo,    pbMigracaoPlano,
                                           '',
                                           piTipoMov,
                                           pIDPLANPREVCONTAB, // SOL:128981 - Daniel Begnami
                                           '',
                                           bAtualizaVlrTotal, //SOL 172575 Kintana 1554837
                                           bCalculoDeficit,    // edilaine - SOL 253577-18064 / PPM 1240079
                                           bCalcularVlrMinimo  // edilaine - SOL 253577-18064 / PPM 1240079
                                           )
       else
         sValorFinal := ReajustaBenefConc( qryAux,
                                           psAnoMesCalculo,
                                           lsDataInicio,
                                           piIdPessJur,      piIdPlanoPrev,  piIdTitular,
                                           piIdBeneficiario, piIdBeneficio,  piNumeroProcesso,
                                           piTotBeneficiarios,
                                           dValorAReajustar,
                                           dValorBase1,      dValorBase2,    dValorBase3,
                                           bReajustou,
                                           bErro,
                                           False, sMsgErro,
                                           dValorTotal,      pdValorSRBRetorno,
                                           piIdCalculo,
                                           bRetroativo,
                                           iOrigem,
                                           '' ,
                                           False,            pbMigracaoPlano,
                                           '',
                                           piTipoMov,
                                           pIDPLANPREVCONTAB, // SOL:128981 - Daniel Begnami
                                           '',
                                           bAtualizaVlrTotal,  // SOL 172575 Kintana 1554837
                                           bCalculoDeficit,    //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131
                                           bCalcularVlrMinimo  // edilaine - SOL 253577-18064 / PPM 1240079
                                         );


        if (bReajustou) and ((sUltMesReajuste = '') or (psAnoMesCalculo > sUltMesReajuste))
       then sUltMesReajuste := psAnoMesCalculo;

       if (piIdTitular <> piIdBeneficiario) and (not bReajustou)
       then begin
          dValorEmReal := dValorEmRealOriginal;
          dValorTotal  := dValorTotalOriginal;
          if piIdTitular = piIdBeneficiario
          then sValorFinal := FloatToStr(dValorEmRealOriginal)
          else // Andre Imakawa - SIG 62512 - Inicio
            begin
              if (iOrigem = 2) and (bPagtoUnico) then
                sValorFinal := FloatToStr(dValorEmRealOriginal)
              else
                sValorFinal := FloatToStr(dValorTotalOriginal);
            end;
              // Andre Imakawa - SIG 62512 - Fim
       end;

       dValorEmReal := StrToFloat(ClienteNumero(sValorFinal));
  end;

  if bErro then Exit;

  sValorFinal              := OraNumero(sValorFinal);
  dValorBeneficioNoMes     := StrToFloat(ClienteNumero(sValorFinal));


  if (piIdTitular <> piIdBeneficiario) and (not bReajustou)
  then pdValorBeneficioIntegralOriginal := dValorTotal
  else pdValorBeneficioIntegralOriginal := dValorBeneficioNoMes;

  pdValorBeneficioIntegralAposMinimo := pdValorBeneficioIntegralOriginal;

  // ***************************************************************************
  // ********************** TRATAMENTO DE BENEFÍCIO MÍNIMO *********************
  // ***************************************************************************
  // Neste ponto a variavel sValorFinal, dValorTotal e dValorBeneficioNoMes está com o
  // valor do benefício reajustado, sem pro-rata de beneficiarios e sem pro-rata dias
  pdValorPrevAntesMinimo := dValorBeneficioNoMes;

  if not CalculaBeneficioMinimo ( piNumeroProcesso,
                                  piIdPessJur,
                                  piIdPlanoPrev,
                                  piIdTitular,
                                  piIdBeneficiario,
                                  piIdBeneficio,
                                  FloatToStr(dValorBeneficioNoMes),
                                  FloatToStr(pdValorBeneficioIntegralOriginal),
                                  piTotBeneficiarios,
                                  psAnoMesCalculo,
                                  psDataInicioOriginal,
                                  psDataFinal,
                                  dValorDepoisMinimo,
                                  sMsgErro)
  then Exit;

  if dValorDepoisMinimo > 0
  then begin
     sValorFinal                        := FloatToStr(dValorDepoisMinimo);
     dValorBeneficioNoMes               := StrToFloat(ClienteNumero(sValorFinal));
     pdValorBeneficioIntegralAposMinimo := StrToFloat(ClienteNumero(sValorFinal));
  end;

  // ***************************************************************************
  // ********************* FIM DO TRATAMENTO DE BENEFÍCIO MÍNIMO ***************
  // ***************************************************************************

  // ***************************************************************************
  // ********************* TRATAMENTO DE PRO-RATA BENEFICIARIOS  ***************
  // ***************************************************************************
 if ((piIdTitular <> piIdBeneficiario) and
     (bReajustou or (dValorDepoisMinimo > 0)))
     and (not pbMigracaoPlano)
  then begin

      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(' SELECT EV.IDEVENTOSPREV,  EV.IDSITPLANOATUAL, EV.IDSITPLANONOVO, '+
                 '        EV.IDSITPARTATUAL, EV.IDSITPARTNOVO,   EV.IDSITFUNCATUAL, EV.IDSITFUNCNOVO, '+
                 '        ST.FLGINTERNO,     STA.FLGINTERNO AS FLGINTERNOANT    '+
                 ' FROM   EVENTOSPREV EV,    SITPART ST,  SITPART STA  '+
                 ' WHERE  EV.IDSITPARTATUAL = STA.IDSITPART         '+
                 ' AND    EV.IDSITPARTNOVO  = ST.IDSITPART          '+
                 ' AND    EV.IDEVENTOSPREV IN ( SELECT MAX(IDEVENTOSPREV) FROM EVENTOSPREV    '+
                 '                              WHERE  IDPESSOA    = '+ IntToStr(piIdTitular)   +
                 '                              AND    IDPLANOPREV = '+ IntToStr(piIdPlanoPrev) +
                 '                              AND    IDPESSJUR   = '+ IntToStr(piIdPessJur)   +
                 '                              AND   DATAREGISTRO = ( SELECT MAX(DATAREGISTRO) FROM EVENTOSPREV '+
                 '                                                     WHERE IDPESSOA     = '+IntToStr(piIdTitular)+
                 '                                                     AND   IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                 '                                                     AND   IDPESSJUR    = '+IntToStr(piIdPessJur)+' '+
                 '                              AND    DATAEVENTO  >= TO_DATE('''+sDataEvento+''',''DD/MM/YYYY'')) )'); 
      qryAux.Open;

      sFlgInternoAntes := qryAux.FieldByName('flginternoant').AsString;
      sFlgInternoAtual := qryAux.FieldByName('flginterno').AsString;

      sIdSitPartAntes := qryAux.FieldByName('idsitpartatual').AsString;
      sIdSitPlanAntes := qryAux.FieldByName('idsitplanoatual').AsString;
      sIdSitFuncAntes := qryAux.FieldByName('idsitfuncatual').AsString;

      sIdSitPartAtual := qryAux.FieldByName('idsitpartnovo').AsString;
      sIdSitPlanAtual := qryAux.FieldByName('idsitplanonovo').AsString;
      sIdSitFuncAtual := qryAux.FieldByName('idsitfuncnovo').AsString;

      // Buscar INSS INTEGRAL no mes que está sendo processado
      sFlgBenefMinimo := '0';
      sVlrInfINSS := CalcBeneficioINSSAtual( piIdPessJur,
                                             piIdPlanoPrev,
                                             piIdTitular,
                                             piIdBeneficiario,
                                             psAnoMesCalculo,
                                             psAnoMesCalculo,
                                             sIDTPPAGTOANT,
                                             sFlgBenefMinimo,
                                             qryAux,
                                             piNumeroProcesso,
                                             'I', iOrigem);
      { Buscar o VALORCALCULADO para o caso de Dupla Atividade (FUNCEF) }
      sVlrCalcInss := CalcBeneficioINSSAtual(piIdPessJur,
                                             piIdPlanoPrev,
                                             piIdTitular,
                                             piIdBeneficiario,
                                             psAnoMesCalculo,
                                             psAnoMesCalculo,
                                             sIDTPPAGTOANT,
                                             sFlgBenefMinimo,
                                             qryAux,
                                             piNumeroProcesso,
                                             'C',
                                             iOrigem);

      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(' SELECT 1 FLGCONCESSAO, '+
                     '        BF.SEQPROPOSTA,  '+
                     '        P.DTEVENTO, BF.DATAINICIO, BF.DATAFINAL, BF.DATAINICIOINSS,         '+
                     '        BF.VLRINFINSS, BP.IDREGRAPAGAMENTO,  BP.IDREGRACALCULO,             '+
                     '        DP.IDDEPENDENCIA, BTIT.PERCENTUAL, BF.DIBBENEFANT, BF.VALORBENEFANT,'+
                     '        BF.VLRCALCINSS, '+
                     '        BF.IDTITBENEF, BF.IDTITULAR, BF.IDPESSOA '+
                     '        ,IdTpPagtoBenefic '+ //SIG60869
                     ' FROM   BENEFPLANPREV BP, DEPENTIT DP, BFCIARIOTITPLAN BTIT, PROCESSOBENEF P, BENEFBFCIARIO BF    '+
                     ' WHERE  BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
                     ' AND    BF.IDPESSJUR      = '+IntToStr(piIdPessJur)+
                     ' AND    BF.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)+
                     ' AND    BF.IDTITULAR      = '+IntToStr(piIdTitular)+
                     ' AND    BF.SEQPROPOSTA    = 1 '+
                     ' AND    BF.IDPESSOA       = '+IntToStr(piIdBeneficiario)+
                     ' AND    BF.IDBENEFICIO    = '+IntToStr(piIdBeneficio)+
                     ' AND    P.NUMEROPROCESSO  = BF.NUMEROPROCESSO '+
                     ' AND    BP.IDPLANOPREV    = BF.IDPLANOPREV    '+
                     ' AND    BP.IDBENEFICIO    = BF.IDBENEFICIO    '+
                     ' AND    BTIT.IDPESSJUR    = BF.IDPESSJUR      '+
                     ' AND    BTIT.IDPLANOPREV  = BF.IDPLANOPREV    '+
                     ' AND    BTIT.IDTITULAR    = BF.IDTITULAR      '+
                     ' AND    BTIT.IDPESSOA     = BF.IDPESSOA       '+
                     ' AND    BTIT.SEQPROPOSTA  = BF.SEQPROPOSTA    '+
                     ' AND    BTIT.IDBENEFICIO  = BF.IDBENEFICIO    '+
                     ' AND    DP.IDTITULAR      = BTIT.IDTITULAR    '+
                     ' AND    DP.IDPESSOA       = BTIT.IDPESSOA     ');
      qryAux.Open;

      iIdParticipante := QryAux.FieldByName('IDTITBENEF').AsInteger;
      iIdTitularBenef := QryAux.FieldByName('IDTITULAR').AsInteger;
      iIdBeneficiario := QryAux.FieldByName('IDPESSOA').AsInteger;
      iIdTpPagtoBenefic := QryAux.FieldByName('IdTpPagtoBenefic').AsInteger;  //SIG60869
      If (iIdParticipante = 0) Then begin
        iIdParticipante := iIdTitularBenef;
      End;


      if (StrToInt(Copy(qryaux.FieldByName('DATAINICIO').AsString,1,2)) >= 29) and
         (StrToInt(Copy(psAnoMesCalculo,6,2)) = 2)
      then sDataRef := '28/'+copy(psAnoMesCalculo,6,2) + '/'+ copy(psAnoMesCalculo,1,4)
      else sDataRef := copy(qryaux.FieldByName('DATAINICIO').AsString,1,2)+ '/' + copy(psAnoMesCalculo,6,2) + '/' + copy(psAnoMesCalculo,1,4);

      If (Copy(sDataRef,1,2) = '31') And (Pos(Copy(sDataRef,4,2), '04060911') <> 0)
      Then  sDataRef := '30'+Copy(sDataRef,3,9);


      //Darivaldo Alencar SIG60869 --SIG60843 -Inicio
      if (iOrigem = 2) and (iIdTpPagtoBenefic = 2) then
        begin
           pdValorBenefRateado := dValorBeneficioNoMes;
        end
       else begin
      //Darivaldo Alencar SIG60869 --SIG60843 -Fim
      if (qryAux.FieldByName('IDREGRACALCULO').AsInteger > 0) and (bAplicaRateioBenefBfciario)    // edilaine - SOL 253577-18064 / PPM 1240079
      then dValorBeneficioNoMes  := ExecutaRegraCalculoBeneficioBfciario( qryAux,
                                            qryAux.FieldByName('IDREGRACALCULO').AsInteger,
                                            -1,
                                            piIdPessJur,         piIdPlanoPrev,
                                            iIdParticipante,
                                            1,
                                            piIdBeneficio,       piNumeroProcesso,
                                            piTotBeneficiarios,
                                            dValorBase1, dValorBase2, dValorBase3,
                                            '',

                                            sDataRef,

                                            qryAux.FieldByName('DATAINICIO').AsString,
                                            qryAux.FieldByName('DATAINICIOINSS').AsString,
                                            OraNumero(FloatToStr(dValorBeneficioNoMes)),
                                            sVlrInfINSS,
                                            sVlrCalcInss,
                                            '0',
                                            bErro,
                                            sMsgErro,
                                            iIdCalculoGeral,
                                            iIdBeneficiario,
                                            qryAux.FieldByName('IDDEPENDENCIA').AsString,
                                            '', {qryAux.FieldByName('PERCENTUAL').AsString,}     // edilaine - SOL 253577-18064 / PPM 1240079
                                            0,
                                            qryAux.FieldByName('DIBBENEFANT').AsString,
                                            qryAux.FieldByName('VALORBENEFANT').AsString,
                                            psAnoMesCalculo,
                                            iIdBeneficiario,
                                            0,0,0,0,'',iOrigem,
                                            0, 0,                                                                          // edilaine - SOL 253577-18094 / PPM 1269549
                                            (psAnoMesCalculo = Copy(psDataInicio,7,4) + '/' + Copy(psDataInicio,4,2))      // edilaine - SOL 253577-18094 / PPM 1269549
                                            );

      { Guarda o valor do Beneficio "cheio" rateado entre os beneficiarios }
      pdValorBenefRateado := dValorBeneficioNoMes;
  end
  end
  else pdValorBenefRateado := dValorBeneficioNoMes;
  // ***************************************************************************
  // ******************** FIM DO TRATAMENTO DE PRO-RATA BENEFICIARIOS  *********
  // ***************************************************************************

  // Se não reajustou e o beneficio é para beneficiario, a variavel dValorBeneficioNoMes
  // está com o valor TOTAL, sem rateio de beneficiários
  if (piIdTitular <> piIdBeneficiario) And
     { dValorBeneficioNoMes so não seria reateado se dValorDepoisMinimo <= 0}
     ((not bReajustou) And (dValorDepoisMinimo <= 0))
  then begin
     dValorBeneficioNoMes := dValorEmRealOriginal;
     pdValorBenefRateado  := dValorBeneficioNoMes;
  end;

  if not(bRetroativo) then  //William Santana - SIG 29976
  //William Moreira da Silva - SIG 19643
  pdValorBeneficioIntegralAposMinimo := pdValorBenefRateado;
  //William Moreira da Silva - SIG 19643

  // Se for para executar regra de 1o. e ultimo pagamento
  // Entao Inicio
  //    Se for 1o. pagamento
  //    Entao executar regra de 1o pagamento
  //    Senao Se for ultimo pagamento
  //          Entao executar regra de ultimo pagamento
  // Final

   //Renato Visoni SOL 158469 Kintana 1285346
   //bPrimeiroDia := (piTipoMov = 12); //Liberação de Benefício em Exigência   // SOL 157203.13987 Kintana 1942467

  if (pbCalculaPrimUltPgto and (not bPagtoUnico))
  then begin
     // Verificar se é 1o. pagamento
     bPrimeiroDia := false; // SOL 204188 Kintana 1973428
     //bPrimeiroDia := (piTipoMov = 7); //Liberação de Benefício em Exigência   // SOL 157203.13987 Kintana 1942467 // SOL 204188 Kintana 1973428

     if (piTipoMov = 12) then // SOL 204188 Kintana 1973428
        sDataInicioTratada := psDataInicioOriginal
     else
        sDataInicioTratada := psDataInicio; // SOL 204188 Kintana 1973428

     if (psAnoMesCalculo = Copy(psDataInicio,7,4) + '/' + Copy(psDataInicio,4,2))
     then begin

        dValorBeneficioNoMes := ExecutaRegraPrimUltPagtoBenef( qryAux,
                                                               piIdRegraPrimPagto,
                                                               piIdTitular,
                                                               piIdBeneficiario,
                                                               piSeqProposta,
                                                               piIdPessJur,
                                                               piIdPlanoPrev,
                                                               piIdBeneficio,
                                                               piTotBeneficiarios,
                                                               //psDataInicio,      // SOL 157203.13987 Kintana 1942467
                                                               //psDataInicioOriginal, // SOL 157203.13987 Kintana 1942467
                                                               sDataInicioTratada, // SOL 204188 Kintana 1973428
                                                               psDataFinal,
                                                               '', // Thiago Melo SOL 208274.15065 Kintana 2043014															   
                                                               OraNumero(FloatToStr(dValorBeneficioNoMes)),
                                                               ' Primeiro ', bErro, sMsgErro, piIdCalculo
                                                               ,bPrimeiroDia // Renato Visoni SOL 158469 Kintana 1285346
                                                                );

        if bErro then Exit;
     end; // if 1o. pagamento

     // Verificar se é ultimo pagamento
     if ((psAnoMesCalculo = psUltMesCalculo) and (Trim(psDataFinal) <> '') and
        (Copy(psDataFinal,7,4)+'/'+Copy(psDataFinal,4,2) <= psUltMesCalculo) and ( (piFlgDataPrevista = 0) or (not bPagaIntegral) ))
     then begin
        if (StrToInt(Copy(psDataFinal,1,2)) > 28) and (StrToInt(Copy(psAnoMesCalculo,6,2)) = 2)
        then sDataFinal := '28'  + '/'+Copy(psAnoMesCalculo,6,2) + '/' + Copy(psAnoMesCalculo,1,4)
        else if (StrToInt(Copy(psDataFinal,1,2)) > 30) and (
                                                             (StrToInt(Copy(psAnoMesCalculo,6,2)) = 4) or
                                                             (StrToInt(Copy(psAnoMesCalculo,6,2)) = 6) or
                                                             (StrToInt(Copy(psAnoMesCalculo,6,2)) = 9) or
                                                             (StrToInt(Copy(psAnoMesCalculo,6,2)) = 11)
                                                           ) then
                sDataFinal := '30'  + '/'+Copy(psAnoMesCalculo,6,2) + '/' + Copy(psAnoMesCalculo,1,4)
             else // SOL 251166 PPM 724951
                if piTipoMov = 12 then    // SOL 251166 PPM 724951
                   sDataFinal := '30'  + '/'+Copy(psAnoMesCalculo,6,2) + '/' + Copy(psAnoMesCalculo,1,4) // SOL 251166 PPM 724951
                else // SOL 251166 PPM 724951
                   sDataFinal := Copy(psDataFinal,1,2) + '/'+Copy(psAnoMesCalculo,6,2) + '/' + Copy(psAnoMesCalculo,1,4); // SOL 251166 PPM 724951

        dValorBeneficioNoMes := ExecutaRegraPrimUltPagtoBenef(qryAux,
                                   piIdRegraUltPagto,
                                   piIdTitular, piIdBeneficiario, piSeqProposta,
                                   piIdPessJur, piIdPlanoPrev,
                                   piIdBeneficio,  piTotBeneficiarios,
                                   //psDataInicio, // SOL 157203.13987 Kintana 1942467
                                   //psDataInicioOriginal, // SOL 157203.13987 Kintana 1942467
                                   sDataInicioTratada, // SOL 204188 Kintana 1973428
                                   sDataFinal, 
                                   '', // Thiago Melo SOL 208274.15065 Kintana 2043014								   
                                   OraNumero(FloatToStr(dValorBeneficioNoMes)),
                                   ' Último ', bErro, sMsgErro, iIdCalculoGeral);
        if bErro then Exit;

    End; { if ultimo pagamento }

  End; { if pbCalculaPrimUltPgto }

  bErro    := False;

  Result   := dValorBeneficioNoMes;

end; { CalculaBeneficioAPagarNoMes }
{------------------------------------------------------------------------------}

function DesfazRetencaoEncerramento ( qryBenefBeneficiario,
                                      qryLogOcorrencia : TwwQuery;
                                      piNUMEROPROCESSO : longint ): boolean;
var
  sIniFaixaExclusao,
  sFimFaixaExclusao,
  sValorIntegral,
  sSitBeneficio,
  sAnoMesLote,
  sSQL,
  sLotes,
  sUltMesReferencia,
  sIdMovBenefDesfeito,
  sMsgErro                  : string ;
  iUltimaOperacao,
  iUltimaOperacaoNaoINSS    : longint;
  sDocumentos,
  sPlanilhas                : string;
  iCodDocumento, iPlnCodigo : longint;
  i                         : word;
  iIdLoteMov                : longint; 
  sDataFinalAnt,
  sDataFinal,
  sIdSitAnterior            : String;
  CtrlDocumento           : TCtrlDocumento; 
  CtrlLancamento          : TCtrlLancamento;
begin
  Result := False;

  sLotes := '-1';

  with qryBenefBeneficiario do
  begin
     Close;
     SQL.Clear;
     SQL.Add(' SELECT BF.IDPESSOA,         BF.IDTITULAR,        BF.IDPLANOPREV,                  '+
             '       BF.SEQPROPOSTA,    BF.IDPESSJUR,        BF.IDBENEFICIO,      BF.NUMEROPROCESSO,          '+
             '       BF.NUMPROCINSS,    BF.VALORATUAL,       BF.VALORCALCULADO,   BF.VALORCOTAS,              '+
             '       BF.VALORTOTAL,     BF.VLRCALCINSS,      BF.VLRINFINSS,       BF.DATAFINAL,               '+
             '       BF.DATAINICIO,     BF.DATAINICIOFUND,   BF.DATAINICIOINSS,   BF.DATAREQUERIMENTO,        '+
             '       BF.IDSITBENEFICIO, BF.IDTPPAGTOBENEFIC,                                                  '+
             '       BF.ULTMESREAJUSTE, '+
             '       DECODE(BF.IDTITULAR,BF.IDPESSOA,BPP.VALORBASE1,BF.VALORBASE1) VALORBASE1, '+
             '       DECODE(BF.IDTITULAR,BF.IDPESSOA,BPP.VALORBASE2,BF.VALORBASE2) VALORBASE2, '+
             '       DECODE(BF.IDTITULAR,BF.IDPESSOA,BPP.VALORBASE3,BF.VALORBASE3) VALORBASE3, '+
             '       B.NOME,            BP.FLGREFERENCIA,    BP.IDREGRACALCULO,   BP.FLGCALCTODOMES,          '+
             '       BP.IDREGRAULTPAGTO,                     BP.IDBENEFREF,     BP.IDREGRAPRIMPAGTO,          '+
             '       BP.FLGOBRIGANPROC, BP.IDREGRABENEFICIA, BP.IDRGVALORTOTAL,   B.FLGBENEFTEMP,             '+
             '       BF.DATAFINALPREVISTA, P.NOME, PR.IDEVENTOGERADOR  , BF.FLGDATAPREVISTA  ,                '+
             '       PT.IDRUBSALAUXDOENCA,                                                                    '+
             '       BP.FLGREFERENCIA,  BP.FLGPAGAINSS                                                        '+
             ' FROM   PESSOA P, PATRO PT, PROCESSOBENEF PR,BENEFBFCIARIO BF, BENEFPLANOPART BPP, BENEFICIO B, '+
             '        BENEFPLANPREV BP '+
             ' WHERE  (BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+')                                    '+
             ' AND    (BF.IDPESSOA       = P.IDPESSOA)                                                        '+
             ' AND    (BF.IDBENEFICIO    = B.IDBENEFICIO)                                                     '+
             ' AND    (BF.IDPLANOPREV    = BP.IDPLANOPREV)                                                    '+
             ' AND    (BF.IDBENEFICIO    = BP.IDBENEFICIO)                                                    '+
             ' AND    (PR.NUMEROPROCESSO = BF.NUMEROPROCESSO)                                                 '+
             ' AND    (BPP.IDPESSOA(+)   = BF.IDTITULAR)                                                      '+
             ' AND    (BPP.IDPESSJUR(+)  = BF.IDPESSJUR)                                                      '+
             ' AND    (BPP.IDPLANOPREV(+) = BF.IDPLANOPREV)                                                   '+
             ' AND    (BPP.IDBENEFICIO(+) = BF.IDBENEFICIO)                                                   '+
             ' AND    (PT.IDPESSOA        = BF.IDPESSJUR)                                                     '+
             ' ORDER BY BP.FLGREFERENCIA                                                                      ');
     Open;
  end;

  // Abrir query com BENEFBFCIARIO e atualizar o valor original e o sitrecebimento
  qryBenefBeneficiario.First;
  while not qryBenefBeneficiario.Eof do
  begin
     // Se o benefício em questão for de referencia e não for pago então
     // não é necessário desfazer a retenção/encerramento

     with qryLogOcorrencia do
     begin
        Close;
        SQL.Clear;
        SQL.Add(' SELECT IDMOVBENEF, IDPLANOPREV, IDTITULAR, NUMEROPROCESSO, SEQPROPOSTA,  DATAMOV,   '+
                '        VALORTOTAL, DATAINICIO,  IDPESSJUR, IDBENEFICIO,    IDPESSOA,     TIPOMOV,   '+
                '        VALORATUAL, VALORCOTAS,  DATAFINAL,DATAINICIOANT,   DATAFINALANT, VALORATUALANT,  '+
                '        IDSITANTERIOR, FLGDATAPREVANT, IDLOTEMOV, MOTRETENC                               '+
                ' FROM   MOVBENEF                                                                          '+
                ' WHERE  IDMOVBENEF = (SELECT MAX(IDMOVBENEF)                                              '+
                '                      FROM   MOVBENEF                                                     '+
                '                      WHERE  IDPESSJUR       = '+qryBenefBeneficiario.FieldByName('IDPESSJUR').AsString+
                '                      AND    IDPLANOPREV     = '+qryBenefBeneficiario.FieldByName('IDPLANOPREV').AsString+
                '                      AND    IDTITULAR       = '+qryBenefBeneficiario.FieldByName('IDTITULAR').AsString+
                '                      AND    SEQPROPOSTA     = '+qryBenefBeneficiario.FieldByName('SEQPROPOSTA').AsString+
                '                      AND    IDPESSOA        = '+qryBenefBeneficiario.FieldByName('IDPESSOA').AsString+
                '                      AND    IDBENEFICIO     = '+qryBenefBeneficiario.FieldByName('IDBENEFICIO').AsString+
                '                      AND    NUMEROPROCESSO  = '+qryBenefBeneficiario.FieldByName('NUMEROPROCESSO').AsString+
                '                      AND    TIPOMOV         <> 10  '+
                '                      AND    IDDESFAZER IS NULL)    ');
        Open;

        if not IsEmpty then First;
     end;

     if qryLogOcorrencia.IsEmpty
     then begin
        qryBenefBeneficiario.Next;
        continue;
     end

     Else Begin
        sDataFinalAnt  := qryLogOcorrencia.FieldByName('DATAFINALANT').AsString;
        sDataFinal     := qryLogOcorrencia.FieldByName('DATAFINAL').AsString;
        sIdSitAnterior := qryLogOcorrencia.FieldByName('IDSITANTERIOR').AsString;
     End;

     iUltimaOperacao     := qryLogOcorrencia.FieldByName('TIPOMOV').AsInteger;
     sIdMovBenefDesfeito := qryLogOcorrencia.FIeldByName('IDMOVBENEF').AsString;
     iIdLoteMov          := qryLogOcorrencia.FIeldByName('IDLOTEMOV').AsInteger;

     if qryBenefBeneficiario.FieldbyName('FLGREFERENCIA').AsInteger = 0
     then iUltimaOperacaoNaoINSS := iUltimaOperacao;

     if qryBenefBeneficiario.FieldByName('FLGDATAPREVISTA').AsInteger = 0
     then begin
        if Trim(qryBenefBeneficiario.FieldByName('DATAFINAL').AsString) <> ''
        then sIniFaixaExclusao := Copy(qryBenefBeneficiario.FieldByName('DATAFINAL').AsString,7,4)+'/'+Copy(qryBenefBeneficiario.FieldByName('DATAFINAL').AsString,4,2)
        else begin
           MsgDlg('Data Final Efetiva não encontrada. Verifique.','Erro', mtError, [mbOk],0);
           Exit;
        end;
     end
     else begin
        if Trim(qryBenefBeneficiario.FieldByName('DATAFINALPREVISTA').AsString) <> ''
        then sIniFaixaExclusao := Copy(qryBenefBeneficiario.FieldByName('DATAFINALPREVISTA').AsString,7,4)+'/'+Copy(qryBenefBeneficiario.FieldByName('DATAFINAL').AsString,4,2)
        else begin
           MsgDlg('Data Final Prevista não encontrada. Verifique.','Erro', mtError, [mbOk],0);
           Exit;
        end;
     end;

     sFimFaixaExclusao   := Copy(FormatDateTime('dd/mm/yyyy', date),7,4) + '/' +   
                            Copy(FormatDateTime('dd/mm/yyyy', date),4,2);         


     with dtmAPrev.qryAux do
     begin
        Close;
        SQL.Clear;
        //  Verifica se Benefício já foi pago
        SQL.Add(' SELECT COUNT(*) AS TOTAL                               '+
                ' FROM   HSTBENEFBFCIARIO                                '+
                ' WHERE  NUMEROPROCESSO  = '+ IntToStr(piNumeroProcesso)   +
                ' AND    IDPESSOA        = '+qryBenefBeneficiario.FieldByName('IDPESSOA').AsString+
                ' AND    IDBENEFICIO     = '+qryBenefBeneficiario.FieldByName('IDBENEFICIO').AsString+ // Vinicius Ferreira SOL 156062/8562 KINTANA 1608823
                ' AND    MESREFERENCIA   >= '''+sIniFaixaExclusao+''''+
                ' AND    FLGCONCESSAO    = 1 ' );

        if Trim(sFimFaixaExclusao) <> ''
        then SQL.Add(' AND MESREFERENCIA <= '''+sFimFaixaExclusao+'''');

        SQL.Add(' AND    VLBENEFPGTO IS NOT NULL                         '+
                ' AND    VLBENEFPGTO > 0                                 ');

        if iIdLoteMov > 0
        then SQL.Add(' AND IDLOTE = '+IntToStr(iIdLoteMov) )
        else SQL.Add(' AND TRGDTINCLUSAO >= TO_DATE('''+qryLogOcorrencia.FieldByName('DATAMOV').AsString+''',''DD//MM/YYYY'') ' ); 

        Open;
     end;

     if (not dtmAPrev.qryAux.IsEmpty) and (dtmAPrev.qryAux.FieldByName('Total').AsFloat > 0 )
     then begin
        MsgDlg('Benefício já foi pago no período de '+sIniFaixaExclusao+' a '+sFimFaixaExclusao+'.'+#13+
               'Retenção/Encerramento não pode ser desfeita...','Erro ',mtError,[mbOk],0);
        Exit;
     end;

     // Verificar LOTES DO PERIODO
     sSQL :=  'SELECT DISTINCT IDLOTE, MIN(MES) AS MES FROM HSTBENEFBFCIARIO    '+
             ' WHERE  NUMEROPROCESSO = '+ IntToStr(piNumeroProcesso)+
             ' AND    IDPESSOA       = '+ qryBenefBeneficiario.FieldByName('IDPESSOA').AsString+
             ' AND    IDBENEFICIO    = '+ qryBenefBeneficiario.FieldByName('IDBENEFICIO').AsString +
             ' AND    MESREFERENCIA   >= '''+sIniFaixaExclusao+''''+
             ' AND    FLGCONCESSAO    = 1 ' ;

     if Trim(sFimFaixaExclusao) <> ''
     then sSQL := sSQL + ' AND MESREFERENCIA <= '''+sFimFaixaExclusao+'''';

     if iIdLoteMov > 0
     then sSQL := sSQL + ' AND IDLOTE = '+IntToStr(iIdLoteMov)
     else sSQL := sSQL + ' AND TRGDTINCLUSAO >= TO_DATE('''+qryLogOcorrencia.FieldByName('DATAMOV').AsString+''',''DD//MM/YYYY'') ';


     sSQL := sSQL + ' GROUP BY IDLOTE ';

     with dtmAPrev.qryAux do
     begin
        Close;
        SQL.Clear;
        SQL.Add(sSQL);
        Open;
        sLotes := '';
        while not Eof do
        begin
           if sLotes = ''
           then sLotes := FieldByName('IDLOTE').AsString
           else sLotes := sLotes+','+FieldByName('IDLOTE').AsString;
           sAnoMesLote := FieldByName('MES').AsString;
           Next;
        end;
     end;

     if sLotes = '' then sLotes := '-1';

     // Apagar lançamentos que a retencao/encerramento tenha feito na TMPDESC
     sSQL :=  ' DELETE FROM TMPDESC    '+
              ' WHERE  IDPESSOA       = '+qryBenefBeneficiario.FieldByName('IDPESSOA').AsString+
              ' AND    FLGDESCFOLHA   = ''B'' '+
              ' AND    FLGTIPODESC    = ''P'' '+
              ' AND    MESREFERENCIA  >= '''+sIniFaixaExclusao+'''';

     if Trim(sFimFaixaExclusao) <> ''
     then sSQL := sSQL + ' AND ((MESREFERENCIA <= '''+sFimFaixaExclusao+''') OR (IDLOTE IN ('+sLotes+')))';

     if iIdLoteMov > 0
     then sSQL := sSQL + ' AND IDLOTE = '+IntToStr(iIdLoteMov)
     else sSQL := sSQL + ' AND TRGDTINCLUSAO >= TO_DATE('''+qryLogOcorrencia.FieldByName('DATAMOV').AsString+''',''DD//MM/YYYY'') ';

     with dtmAPrev.qryaux do
     begin
        Close;
        SQL.Clear;
        SQL.Add(sSQL);
        try
           ExecSQL;
        except
           on E:EDBEngineError do
           begin
             MostrarErro(E);
             Exit;
           end;
        end;
     end;

     // Apagar lançamentos que a retencao/encerramento tenha feito na HSTBENEFBFCIARIO
     sSQL := ' DELETE FROM HSTBENEFBFCIARIO    '+
             ' WHERE  NUMEROPROCESSO = '+ IntToStr(piNumeroProcesso)+
             ' AND    IDPESSOA       = '+ qryBenefBeneficiario.FieldByName('IDPESSOA').AsString+
             ' AND    IDBENEFICIO    = '+ qryBenefBeneficiario.FieldByName('IDBENEFICIO').AsString +
             ' AND    MES   >= '''+sIniFaixaExclusao+''''+
             ' AND    FLGCONCESSAO    = 1 ' +
             ' AND ((MESREFERENCIA <= '''+sFimFaixaExclusao+''') OR '+
             '      (MESREFERENCIA = '''+Copy(sFimFaixaExclusao,1,5)+'13'+''') OR '+
             '      (IDLOTE IN ('+sLotes+') OR IDLOTE IS NULL) )';

     if iIdLoteMov > 0
     then sSQL := sSQL + ' AND IDLOTE = '+IntToStr(iIdLoteMov)
     else sSQL := sSQL + ' AND TRGDTINCLUSAO >= TO_DATE('''+qryLogOcorrencia.FieldByName('DATAMOV').AsString+''',''DD//MM/YYYY'') ';

     with dtmAPrev.qryaux do  begin
        Close;
        SQL.Clear;
        SQL.Add(sSQL);
        Try
           ExecSQL;
        except
          on E:EDBEngineError do begin
            MostrarErro(E);
            Exit;
          end;
        end;
     end;

     // Verificar ultimo mês de preparo
     sSQL := ' SELECT MAX(MES) AS MESPAGAMENTO FROM HSTBENEFBFCIARIO    '+
             ' WHERE  NUMEROPROCESSO = '+ IntToStr(piNumeroProcesso)+
             ' AND    IDPESSOA       = '+ qryBenefBeneficiario.FieldByName('IDPESSOA').AsString+
             ' AND    IDBENEFICIO    = '+ qryBenefBeneficiario.FieldByName('IDBENEFICIO').AsString ;

     if iIdLoteMov > 0
     then sSQL := sSQL + ' AND IDLOTE = '+IntToStr(iIdLoteMov)
     else sSQL := sSQL + ' AND TRGDTINCLUSAO >= TO_DATE('''+qryLogOcorrencia.FieldByName('DATAMOV').AsString+''',''DD//MM/YYYY'') '; 

     with dtmAPrev.qryaux do
     begin
        Close;
        SQL.Clear;
        SQL.Add(sSQL);
        Open;

        if (IsEmpty) or (FieldByName('MESPAGAMENTO').AsString = '')
        then sUltMesReferencia := '0000/00'
        else sUltMesReferencia := FieldByName('MESPAGAMENTO').AsString;
     end;

     // Atualizar dados do benefício
     qryLogOcorrencia.Locate('IdBeneficio',qryBenefBeneficiario.FieldByName('IDBENEFICIO').AsInteger,[loCaseInsensitive]);

     dtmAPrev.qryAux.Close;
     dtmAPrev.qryAux.SQL.Clear;
     dtmAPrev.qryAux.SQL.Add(' UPDATE BENEFBFCIARIO SET VALORATUAL     = '+OraNumero(qryLogOcorrencia.FieldByName('VALORATUALANT').AsString)+','+
                    '                          DATAINICIO     = TO_DATE('''+qryLogOcorrencia.FieldByName('DATAINICIOANT').AsString+''', ''DD/MM/YYYY''), '+
                    '                          ULTMESPREPARO  = '''+sUltMesReferencia+''', ');

     if Trim(qryLogOcorrencia.FieldByName('DATAFINALANT').AsString) <> ''
     then if qryLogOcorrencia.FieldByName('FLGDATAPREVANT').AsInteger = 0
          then begin
             dtmAPrev.qryAux.SQl.Add('  DATAFINALPREVISTA = NULL, ');
             dtmAPrev.qryAux.SQl.Add('  FLGDATAPREVISTA   = 0,    ');
             dtmAPrev.qryAux.SQl.Add('  DATAFINAL         = TO_DATE('''+qryLogOcorrencia.FieldByName('DATAFINALANT').AsString+''', ''DD/MM/YYYY''), ');
          end
          else begin
             dtmAPrev.qryAux.SQl.Add('  DATAFINAL         = NULL, ');
             dtmAPrev.qryAux.SQl.Add('  FLGDATAPREVISTA   = 1,    ');
             dtmAPrev.qryAux.SQl.Add('  DATAFINALPREVISTA = TO_DATE('''+qryLogOcorrencia.FieldByName('DATAFINALANT').AsString+''', ''DD/MM/YYYY''), ');
          end
     else begin
        dtmAPrev.qryAux.SQl.Add('  DATAFINAL         = NULL, ');
        dtmAPrev.qryAux.SQl.Add('  FLGDATAPREVISTA   = 0,    ');
        dtmAPrev.qryAux.SQl.Add('  DATAFINALPREVISTA = NULL, ');
     end;

     if (Trim(qryBenefBeneficiario.FieldByName('ULTMESREAJUSTE').AsString) <> '') and
        (Trim(qryLogOcorrencia.FieldByName('DATAFINALANT').AsString) <> '')       and
        (Copy(qryLogOcorrencia.FieldByName('DATAFINALANT').AsString,7,4)+'/'+Copy(qryLogOcorrencia.FieldByName('DATAFINALANT').AsString,4,2) = qryBenefBeneficiario.FieldByName('ULTMESREAJUSTE').AsString)
     then dtmAPrev.qryAux.SQl.Add('  ULTMESREAJUSTE = '''+sUltMesReferencia+''', ');


     dtmAPrev.qryAux.SQL.Add('                           IDSITBENEFICIO = '+ qryLogOcorrencia.FieldByName('IDSITANTERIOR').AsString+
                    ' WHERE  IDPESSJUR      = '+qryBenefBeneficiario.FieldByName('IDPESSJUR').AsString   +
                    ' AND    IDPLANOPREV    = '+qryBenefBeneficiario.FieldByName('IDPLANOPREV').AsString +
                    ' AND    IDTITULAR      = '+qryBenefBeneficiario.FieldByName('IDTITULAR').AsString   +
                    ' AND    SEQPROPOSTA    = '+qryBenefBeneficiario.FieldByName('SEQPROPOSTA').AsString +
                    ' AND    IDPESSOA       = '+qryBenefBeneficiario.FieldByName('IDPESSOA').AsString    +
                    ' AND    IDBENEFICIO    = '+qryBenefBeneficiario.FieldByName('IDBENEFICIO').AsString +
                    ' AND    NUMEROPROCESSO = '+qryBenefBeneficiario.FieldByName('NUMEROPROCESSO').AsString);
     try
        dtmAPrev.qryAux.ExecSQL;
     except
        on E:EDBEngineError do
        begin
           MostrarErro(E);
           Exit;
        end;
     end;

     dtmAPrev.qryAux.Close;
     dtmAPrev.qryAux.SQL.Clear;
     dtmAPrev.qryAux.SQL.Add(' SELECT MAX(IDMOVBENEF) AS TIPO10 FROM MOVBENEF ');
     try
        dtmAPrev.qryAux.Open;
     except
        on E:EDBEngineError do
        begin
           MostrarErro(E);
           Exit;
        end;
     end;

     if  sIdMovBenefDesfeito <> ''
     then begin
       dtmAPrev.qryAux.SQL.Clear;
       dtmAPrev.qryAux.SQL.Add(' DELETE FROM MOVBENEF WHERE IDMOVBENEF = '+sIdMovBenefDesfeito );
       if piNUMEROPROCESSO > 0 then // SOL 242331 PPM 570638
          dtmAPrev.qryAux.SQL.Add(' AND NUMEROPROCESSO = '+inttostr(piNUMEROPROCESSO) ); // SOL 242331 PPM 570638
       try
          dtmAPrev.qryAux.ExecSql;
       except
          on E:EDBEngineError do
          begin
             MostrarErro(E);
             Exit;
          end;
       end;
     end;

     qryBenefBeneficiario.Next;
  end; // while not qryBenefBeneficiario.Eof

  // Desfazer lançamentos de devolucao/cobrança enviados para o BackOffice
  sSQL := ' SELECT DISTINCT MESREFERENCIA, CODDOCUMENTOPREV FROM HSTCONTRIBPREV    '+
          ' WHERE  IDPESSJUR      = '+qryBenefBeneficiario.FieldByName('IDPESSJUR').AsString+
          ' AND    IDTITULAR      = '+qryBenefBeneficiario.FieldByName('IDTITULAR').AsString+//Fanuel Junior SOL 157444/5301 Kintana 1329006
          ' AND    IDPESSOA  IN ( SELECT IDTITULAR FROM BENEFBFCIARIO   '+
