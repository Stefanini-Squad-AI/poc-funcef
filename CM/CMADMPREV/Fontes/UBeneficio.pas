                                                    dValorFABIntegral, dValorFABIntegralPosMin,    // edilaine - SOL 253577-17514 / PPM 971383
                                                    dValorFABIntegralAntMin, dValorFABRateado,     // edilaine - SOL 253577-17514 / PPM 971383
                                                    dValorSRB,
