                 '   AND (BFC.IDTITULAR      ='+ IntToStr(piIdTitular)     +')'+
                 '   AND (BFC.SEQPROPOSTA    ='+ IntToStr(piSeqProposta)   +')'+
                 '   AND (BFC.IDPESSOA       ='+ IntToStr(piIdPessoa)      +')'+
                 '   AND (BFC.IDBENEFICIO    ='+ IntToStr(piIdBeneficio)   +')'+
                 '   AND (BFC.NUMEROPROCESSO ='+ IntToStr(piNumeroProcesso)+')'+
                 '   AND (BFC.IDPESSJUR      = BFT.IDPESSJUR)   '+
                 '   AND (BFC.IDPLANOPREV    = BFT.IDPLANOPREV) '+
                 '   AND (BFC.IDTITULAR      = BFT.IDTITULAR)   '+
                 '   AND (BFC.SEQPROPOSTA    = BFT.SEQPROPOSTA) '+
                 '   AND (BFC.IDPESSOA       = BFT.IDPESSOA)    '+
                 '   AND (BFC.IDBENEFICIO    = BFT.IDBENEFICIO) ');
  qryAux.Open;
  sFlagProvisorio := IntToStr(qryAux.FieldByName('FLGPROVISORIO').AsInteger);
  pIntFontePagadora := qryAux.FieldByName('FONTEPAGADORA').AsInteger; // Felipe A. Santos SOL 182092/14207 15207 15253 KITANTA 1969056

  If pdPercentual = 0 Then pdPercentual := QryAux.FieldByName('PERCENTUAL').AsFloat;

   IF pcTipo = 'D' then sflgdevolucao := '1' else sflgdevolucao := '0';
   if prmIdMotivoDevolBen <= 0
   then begin
      MsgDlg(' Motivo padrão para Devolução de Benefício não preenchido. Verifique.','Erro',mtError,[mbOk, mbHelp],0);
      Exit;
   end;
   sDataFolha := CriticaDataCobrancaSit(qryAux,IntToStr(iIdFundacao),'', 'AS',
                                        'P',
                                        Copy(psAnoMesReferencia,6,2),
                                        Copy(psAnoMesReferencia,1,4));

   if Trim(sDataFolha) = '' then sDataFolha := FormatDateTime('dd/mm/yyyy', date); 

    // pdValorIntegral := prDiferenca;
    // pdValorIntegral := prDiferenca;

   if piIdLote < 0
   then begin
      piIdLote := LeUltRegistro(qryAux,'CTRLINTERFACE');
      sAnoMes := Copy(sDataFolha, 7,4) + '/' + Copy(sDataFolha,4,2);

      if pcTipo = 'A'
      then sDescPreparo := ' Benef. pago a menor - Acerto '+
                      ' - Processo n°: ' +IntToStr(piNumeroProcesso)+' - '+
                      psNomeBeneficio
      else sDescPreparo := ' Benef. pago a maior - Devolução '+
                      ' - Processo n°: ' +IntToStr(piNumeroProcesso)+' - '+
                      psNomeBeneficio;

      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(' INSERT INTO CTRLINTERFACE ' +
                     ' (MESREFERENCIA, TIPO, IDPESSOA, FLGIDATMP, FLGVOLTATMP, FLGIDAINTERFACE, FLGVOLTAINTERFACE,' +
                     '  DATAIDATMP, DATAVOLTATMP, DATAIDAINTERFACE, DATAVOLTAINTERFA, IDLOTE, NUMREG, VLRTOTAL, ' +
                     '  FLGEMITIUCC, DATAEMITIUCC, FLGPREPARADO, DESCRICAO, DATAPREPARO) ' +
                     '  VALUES (' + '''' +sAnoMes + '''' + ',' + ' ''B'' ' + ',' +
                        IntToStr(piIdPessJur)+ ',' + ' 0, 0, 0, 0, ' +
                     '  NULL , NULL, NULL, NULL, '+ IntToStr(piIdLote)+ ', 1, ' +
                     OraNumero(FloatToStr(prDiferenca)) + ',' +
                     '  NULL, NULL, 1, ' + '''' + sDescPreparo + '''' + ',' +
                     '  To_Date(''' + FormatDateTime('dd/mm/yyyy', Date) + ''',''dd/mm/yyyy''))');
      try
         qryAux.ExecSQL;
      except
         Exit;
      end;
      sDataPagamento := sDataFolha;
   end
   else begin
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(' SELECT MESREFERENCIA, DATAPAGAMENTO FROM CTRLINTERFACE '+
                     ' WHERE  IDLOTE = '+IntToStr(piIdLote) );

      qryAux.Open;
      sAnoMes := qryAux.FieldByName('MESREFERENCIA').AsString;
      sDataPagamento := qryAux.FieldByName('DATAPAGAMENTO').AsString; 

   end;

   if picodportforma > 0 then
     scodportforma:=inttostr(picodportforma)
   else
     scodportforma:='NULL';

   qryAux.Close;
   qryAux.Sql.Clear;
   qryAux.Sql.Add('SELECT IDPLANOORIGEM   '                            +
                  'FROM BENEFBFCIARIO     '                            +
                  'WHERE NUMEROPROCESSO = '+IntToStr(piNumeroProcesso) +
                   ' AND IDBENEFICIO    = '+IntToStr(piIdBeneficio)    +
                   ' AND IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)    +
                   ' AND IDPESSJUR      = '+IntToStr(piIdPessJur)      +
                   ' AND IDTITULAR      = '+IntToStr(piIdTitular)      +
                   ' AND IDPESSOA       = '+IntToStr(piIdPessoa)       +
                   ' AND SEQPROPOSTA    = '+IntToStr(piSeqProposta))   ;
   qryAux.Open;
   sPlanoOrigem := qryAux.FieldByName('IDPLANOORIGEM').AsString;

   { Verificar se já existe acerto no historico, caso de desdobramento }
   sSQL := 'SELECT HST.FLGDEVOLUCAO   '+
           'FROM HSTBENEFBFCIARIO HST '+
           'WHERE '+
           '  (HST.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+') AND '+
           '  (HST.IDPESSOA       = '+IntToStr(piIdPessoa)      +') AND '+
           '  (HST.IDBENEFICIO    = '+IntToStr(piIdBeneficio)   +') AND '+
           '  (HST.MESREFERENCIA  = '+QuotedStr(psAnoMesReferencia)+') AND '+
           '  (HST.VLBENEFPGTO IS NULL) AND '+
           '  (HST.FLGDEVOLUCAO   = 1) ';

   If FazQuery(QryAux,sSQL) Then Begin
     { Atualizar historico }
     sSQL := ' UPDATE HSTBENEFBFCIARIO SET VALORPREV     = '+OraNumero(FloatToStr(prDiferenca))+','+
             '                             VALORTOTAL    = '+OraNumero(FloatToStr(pdValorTotal))+','+ 

             '                             VALORBS        = '+iif(pdValorBS = '', 'NULL', OraNumero(pdValorBS)) +','+       // fernando xavier - SOL 253577-17664 / PPM 1019932
             '                             VALORFAB       = '+iif(pdValorFAB = '', 'NULL', OraNumero(pdValorFAB))+','+      // fernando xavier - SOL 253577-17664 / PPM 1019932
             '                             VLRBASEDEFICIT = '+iif(pdValorDeficit = '', 'NULL', OraNumero(pdValorDeficit))+','+  // fernando xavier - SOL 253577-17664 / PPM 1019932

             '                             DATAPAGAMENTO = TO_DATE('''+sDataFolha+''',''DD/MM/YYYY''), '+ 
             '                             VALORINTEGRAL = '+OraNumero(FloatToStr(pdValorIntegral))+  
             ' WHERE (IDPESSJUR        = '+IntToStr(piIdPessJur)     +')'+
             ' AND   (IDTITULAR        = '+IntToStr(piIdTitular)     +')'+
             ' AND   (IDPLANOPREV      = '+IntToStr(piIdPlanoPrev)   +')'+
             ' AND   (MES              = '+QuotedStr(sAnoMes)        +')'+
             ' AND   (IDMOTIVO         = '+IntToStr(prmIdMotivoDevolBen) +')'+
             ' AND   (NUMEROPROCESSO   = '+IntToStr(piNumeroProcesso)+')'+
             ' AND   (IDBENEFICIO      = '+IntToStr(piIdBeneficio)   +')'+
             ' AND   (IDPESSOA         = '+IntToStr(piIdPessoa)      +')'+
             ' AND   (MESREFERENCIA    = '+QuotedStr(psAnoMesReferencia)+')'+
             ' AND   (SEQPROPOSTA      = '+IntToStr(piSeqProposta)   +')';

     ExecutarQuery(QryAux, sSQL);

     QryAux.Close;
     Result := True;
     Exit;
   End;

   iSeqBeneficio := PegaSeqBeneficio(qryAux,
                                     piIdPessJur,   piIdTitular,
                                     piIdPlanoPrev, piIdPessoa,
                                     piSeqProposta, piNumeroProcesso,
                                     piIdBeneficio, prmIdMotivoDevolBen,
                                     sAnoMes,
                                     psAnoMesReferencia );

   // Felipe A. Santos SOL 182092/14207 15207 15253 KITANTA 1969056
   if (sDataInicioOriginal <> emptystr) then
   begin
     if (psAnoMesReferencia = FormatDateTime('YYYY/MM', strtodate(sDataInicioOriginal))) then
     begin
       qryaux.close;
       qryaux.sql.clear;
        qryaux.SQL.Add('SELECT BF.VALORTOTAL-');
        qryaux.SQL.Add('       ROUND(((((((SELECT MAX(PERCENTUAL)');
        qryaux.SQL.Add('                     FROM HSTPERCGRUPO HG');
        qryaux.SQL.Add('                    WHERE HG.IDPESSJUR = BF.IDPESSJUR');
        qryaux.SQL.Add('                      AND HG.IDTITULAR = BF.IDTITULAR');
        qryaux.SQL.Add('                      AND HG.IDPLANOORIGEM = BF.IDPLANOORIGEM');
        qryaux.SQL.Add('                      AND HG.IDPESSOA = BF.IDPESSOA');
        qryaux.SQL.Add('                      AND HG.SEQPROPOSTA = BF.SEQPROPOSTA');
        qryaux.SQL.Add('                      AND HG.IDPLANOPREV = BF.IDPLANOPREV');
        qryaux.SQL.Add('                      AND HG.IDBENEFICIO = BF.IDBENEFICIO');
        qryaux.SQL.Add('                      AND HG.NUMEROPROCESSO = BF.NUMEROPROCESSO');
        qryaux.SQL.Add('                      AND HG.DATAFIM = to_date(' +quotedstr(sDataInicioOriginal) +')-1)*(to_number(to_char(to_date('+quotedstr(sDataInicioOriginal) +'),''DD''))-1))/30)+');
        qryaux.SQL.Add('       ((BTT.PERCENTUAL*(31-to_number(to_char(to_date('+quotedstr(sDataInicioOriginal) +'),''DD''))))/30))*BF.VALORTOTAL)/100),2) as diferenca ');
        qryaux.SQL.Add('FROM BENEFBFCIARIO BF');
        qryaux.SQL.Add('     JOIN BFCIARIOTITPLAN BTT ON BTT.IDPESSJUR = BF.IDPESSJUR');
        qryaux.SQL.Add('                             AND BTT.IDTITULAR = BF.IDTITULAR');
        qryaux.SQL.Add('                             AND BTT.IDPLANOORIGEM = BF.IDPLANOORIGEM');
        qryaux.SQL.Add('                             AND BTT.IDPESSOA = BF.IDPESSOA');
        qryaux.SQL.Add('                            AND BTT.SEQPROPOSTA = BF.SEQPROPOSTA');
        qryaux.SQL.Add('                             AND BTT.IDPLANOPREV = BF.IDPLANOPREV');
        qryaux.SQL.Add('                             AND BTT.IDBENEFICIO = BF.IDBENEFICIO');
        qryaux.SQL.Add('WHERE BF.IDPLANOPREV = ' + inttostr(piIdPlanoPrev) +'  AND ');
        qryaux.SQL.Add('      BF.IDBENEFICIO = ' + inttostr(piIdBeneficio) + ' AND ' );
        qryaux.SQL.Add('      BF.NUMEROPROCESSO = ' + inttostr(piNumeroProcesso)+ ' AND');
        qryaux.SQL.Add('      BF.IDPESSJUR = ' + inttostr(piIdPessJur)+ 'AND');
        qryaux.SQL.Add('      BF.IDTITULAR = ' + inttostr(piIdTitular)+ ' AND');
        qryaux.SQL.Add('      BF.IDPLANOORIGEM =' + inttostr(piIdPlanoPrev)+ ' AND');
        qryaux.SQL.Add('      BF.IDPESSOA = ' + inttostr(piIdPessoa)+ 'AND');
        qryaux.SQL.Add('      BF.SEQPROPOSTA = ' + inttostr(piSeqProposta));
        qryaux.open;
        if (qryaux.fieldbyname('diferenca').asString <> '') and (qryaux.fieldbyname('diferenca').asFloat > 0) then     // edilaine - SOL 253577-17664 / PPM 1019932
           prDiferenca := qryaux.fieldbyname('diferenca').asfloat;
     end;
   end;
   // Felipe A. Santos SOL 182092/14207 15207 15253 KITANTA 1969056

   If not InsereHstBenefBfciario( QryAux,
                                  iSeqBeneficio,
                                  piNumeroProcesso, piIdBeneficio,
                                  piIdPessJur,      piIdPlanoPrev,
                                  piIdTitular,      piSeqProposta,
                                  piIdPessoa,
                                  -1,
                                  prmIdMotivoDevolBen,
                                  piCodPortForma,
                                  psAnoMesReferencia,
                                  sAnoMes,
                                  '',
                                  '',
                                  '',
                                  prDiferenca,
                                  prDiferenca,
                                  pdValorIntegral,

                                  0,
                                  piFlgEnviado,  {0, }                 // edilaine - SOL 253577-17664 / PPM 1019932
                                  1,

                                  StrToInt( sFlgDevolucao ),
                                  piIdLote,
                                  sMsgErro,
                                  sDataPagamento, 

                                  pdValorTotal,

                                  0,                      
                                  pdPercentual,           
                                  0,                      

                                  0,                      
                                  0,
                                  0,                      

                                  piIdTitular,
                                  psAnoMesReferencia,
                                  piTipoMov
                                  , '', False                   // fernando xavier - SOL 253577-17664 / PPM 1019932
                                  , pdValorFAB       // fernando xavier - SOL 253577-17664 / PPM 1019932
                                  , pdValorBS        // fernando xavier - SOL 253577-17664 / PPM 1019932
                                  , pdValorDeficit,   // fernando xavier - SOL 253577-17664 / PPM 1019932
                                  0, piIPerfilInvest    //edilaine - SIG55933
                                  )
   Then Begin
     sMsgErro := 'Erro na gravação do benefício no histórico. ';
     Exit;
   End;


   Result := True;
end; 

function PegaValorEmReal(  qryAux             : TwwQuery;
                           piIdTitular,
                           piIdBeneficiario,
                           piIdPessJur,
                           piIdPlanoPrev,
                           piIdBeneficio,
                           piSeqProposta,
                           piTotBeneficiarios : longint;
                           psDataInicio,
                           psDataPagamento,
                           psMesReferencia    : string; 
                           pdValorEmCotas     : double;
                           var bErro          : boolean;
                           var sMsgErro       : string ) : string;
var sSQL,
    sIdRegraReajuste,
    sIndiceReajuste,
    sDataDaCota,
    sValorBeneficio   : string;
    rValorDaCota,
    rValorBeneficio   : double;
begin
  Result := ClienteNumero(FloatToStr(pdValorEmCotas));
  bErro  := False;
  rValorBeneficio := 0;

  if Trim(psDataPagamento) = ''
  then begin
     bErro    := True;
     sMsgErro := 'Erro na conversão do valor em cotas para real : Data de Pagamento não informada.';
     Exit;
  end;

  // Se tiver regra de reajuste
  // Entao utilizar a regra
  // Senao entao converter na cota do indice cadastrado
  qryAux.Close;
  qryAux.SQL.Clear;

  qryAux.SQL.Add(' SELECT INDICEREAJBENEF, IDREGRAREAJBENEF '+
                 ' FROM   BENEFPLANPREV '+
                 ' WHERE  IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+
                 ' AND    IDBENEFICIO = '+IntToStr(piIdBeneficio));
  qryAux.Open;

  if qryAux.IsEmpty
  then begin
     bErro    := True;
     sMsgErro := 'Benefício não encontrado no plano.';
     Exit;
  end;

  sIdRegraReajuste := qryAux.FieldByName('IDREGRAREAJBENEF').AsString;
  sIndiceReajuste  := qryAux.FieldByName('IndiceReajBenef').AsString;
  qryAux.Close;

  if Trim(sIdRegraReajuste) <> ''
  then begin
     sSQL := ' SELECT   1 FLGCONCESSAO, '+ 
             '''' + sIndiceReajuste + '''' + ' AS INDICEREAJBENEF, '+
             '''' + PreparaStrRegra(psDataPagamento) + '''' + ' AS DATAREF, ' +
             '''' + PreparaStrRegra(psDataInicio) + '''' + ' AS DATAINICIO, ' +
             '''' + Copy(psDataPagamento,7,4)+'/'+Copy(psDataPagamento,4,2)+''' AS MESREFERENCIA, '+
             IntToStr(piIdTitular)      + ' AS IDTITULAR, ' +
             IntToStr(piIdBeneficiario) + ' AS IDPESSOA, ' +
             IntToStr(piIdPessJur)      + ' AS IDPESSJUR, ' +
             IntToStr(piIdPlanoPrev)    + ' AS IDPLANOPREV, ' +
             IntToStr(piIdBeneficio)    + ' AS IDBENEFICIO, ' +
             IntToStr(piSeqProposta)    + ' AS SEQPROPOSTA, ' +
             IntToStr(piTotBeneficiarios) + ' AS NUMBENEF, ' +
             OraNumero(FloatToStr(pdValorEmCotas)) + ' AS VALORPREV, ' +
             OraNumero(FloatToStr(pdValorEmCotas)) + ' AS VALORATUAL ' +
             ' FROM DUAL ';

     sValorBeneficio := RegraNumerica(sIdRegraReajuste, sSQL, bErro, iIdCalculoGeral );

     if bErro
     then begin
        bErro := True;
        sMsgErro := ' Ocorreu um erro na Regra de Reajuste do Benefício (nº '+sIdRegraReajuste+') ';
        Exit;
     end;

     if Trim(sValorBeneficio) = ''
     then begin
        bErro := True;
        sMsgErro := ' A Regra de Reajuste do Benefício (nº '+sIdRegraReajuste+')'+
                    ' retornou um valor em branco. ';
        Exit;
     end;

     try
        rValorBeneficio := StrToFloat(ClienteNumero(sValorBeneficio));
     except
        bErro := True;
        sMsgErro := ' A Regra de Reajuste do Benefício (nº '+sIdRegraReajuste+')' +
                    ' retornou um valor inválido. [Valor Retornado = '+sValorBeneficio+']';
        Exit;
     end;
  end
  else begin
     // O beneficio é em cotas -> converter pelo indice


     qryAux.Close;
     qryAux.SQL.Clear;
     qryAux.SQL.Add(' SELECT COTVALOR, COTDATA '+
                    ' FROM   COTACAOMOEDA      '+
                    ' WHERE  (MOECODIGO = '+sIndiceReajuste+')'+
                    ' AND    (TO_CHAR(COTDATA,''YYYY/MM'') <= ''' + psMesreferencia + ''') '+ 
                    ' ORDER BY COTDATA DESC ');
     qryAux.Open;
     if qryAux.IsEmpty
     then begin
        qryAux.Close;
        sMsgErro := 'O índice de conversão do valor do benefício não está cadastrado. '+
                    'Verifique no Cadastro de Cotações da Moeda.';
        bErro := True;
        Exit;
     end;

     qryAux.First;
     rValorDaCota := qryAux.FieldByName('CotValor').AsFloat;

     sDataDaCota   := FormatDateTime('dd/mm/yyyy', qryAux.FieldByName('CotData').AsDateTime); 

     // Converter de cota para real
     if rValorDaCota = 0
     then begin
        qryAux.Close;
        sMsgErro := 'O índice de conversão do valor do benefício está zerado. '+
                    'Verifique no Cadastro de Cotações da Moeda.';
        bErro := True;
     end
     else rValorBeneficio := pdValorEmCotas * rValorDaCota;
  end;

  bErro := False;
  sMsgErro := ' ';
  Result := ClienteNumero(FloatToStr(rValorBeneficio));
end; // PegaValorEmReal

Function ReajustaBenefConc( QryAux : TwwQuery ;
