                                                    bErro,
                                                    bReajustou,
                                                    psUltMesReajuste,
                                                    dValorBSIntegral, dValorBSIntegralPosMin,      // edilaine - SOL 253577-17514 / PPM 971383
                                                    dValorBSIntegraAntMin, dValorBSRateado,        // edilaine - SOL 253577-17514 / PPM 971383
                                                    dValorSRB,
                                                    piIdCalculo,
                                                    sDataFolha,
                                                    False, pbMigracaoPlano,
                                                    -1, True, True //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131
                                                  );

        dValorBSNoMes := rVlrCalculo;                                   // edilaine - SOL 253577-17514 / PPM 971383

     end;  // edilaine - SOL 253577-17464 / PPM 955703

     if (rVlrFABTotal <> '') and (StrToFloat(rVlrFABTotal) > 0)  then   // edilaine - SOL 253577-17464 / PPM 955703
     begin
        //edilaine WO22679 : fim
        if ( piIdTitular <> piIdBeneficiario ) then
        begin
          //edilaine WO18367 : inicio
          rVlrCalculo := StrToFloat(rValorFabTitular);
          rVlrCalculo := CalculaBeneficioAPagarNoMes( qryAux,
                                                      sMesAtual,
                                                      piIdTitular,   piIdBeneficiario,
                                                      piSeqProposta, piIdPessJur,
                                                      piIdPlanoPrev, piNumeroProcesso,
                                                      piIdBeneficio, piTotBeneficiarios,
                                                      piIdRegraPrimPagto, piIdRegraUltPagto,
                                                      piIdTpPagto,
                                                      psDataInicio, psDataFinal,
                                                      sMesFinal,
                                                      psCalculaTodoMes,
                                                      rVlrCalculo, rVlrCalculo,
                                                      dValorEmCotas,
                                                      pbCalculaPrimUltPgto,
                                                      psDataInicioOriginal,
                                                      piTipoMov,
