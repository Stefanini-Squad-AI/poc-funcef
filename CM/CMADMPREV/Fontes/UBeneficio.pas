                              {no momento do insert sempre passar OraNumero, pois quando o valor vem quebrado da erro decorrente da virgula que deve estar como ponto}
  Try
    QryAux.ExecSQL;
  Except on E : Exception do begin

             sResult := E.Message;

             iPos := pos('#',sResult);

             sTrataRaise := Copy(sResult,iPos + 1,length(sResult)-1);

             iPos := pos('#',sTrataRaise);

             Msg := Copy(sTrataRaise,iPos + 1, length(sResult)-1);

             sTrataRaise := Copy(sTrataRaise,1,iPos - 1);

             iPos := pos('#',Msg);

             Msg := Copy(Msg, 1, iPos-1);

             if Trim(sTrataRaise) = 'PR_VALIDA000001' then begin
                MsgDlg(Msg,'Erro',mtError,[mbOk],0);
             end;
             
             Abort;
        end;
  End;

  //Renato Visoni SOL 137663 Kintana 833903
  if piIdLote > 0 then begin
    QryAux.Close;
    QryAux.Sql.Clear;
    QryAux.SQL.Add(' SELECT * FROM CTRLINTERFACE ');
    QryAux.SQL.Add(' WHERE IDLOTE = ' + IntTostr(piIdLote));
    QryAux.SQL.Add(' AND NVL(FLGLOTEPROCESSADO,0) = 1');
