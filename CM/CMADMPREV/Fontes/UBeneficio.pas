  begin

    with qryAux do
    begin

      Close;
      SQL.Clear;
      SQL.Add(' SELECT DP.IDDEPENDENCIA, BTIT.PERCENTUAL, BF.VLRINFINSS, BF.VLRCALCINSS, '+
