  rValor : double;
  rVlrSaldoFAB  : double;
  rVlrBSSaldo   : double;
  sMesFAB : string;          // edilaine - SOL 253577-18064 / PPM 1240079
begin

   // edilaine - SOL 253577-18064 / PPM 1240079 - inicio
   {se a DIB for o 1o dia do mes, considera o mesreferencia como mes anterior}
   //Início - William Santana - SIG 19010 PPM 1376964
   {regra foi alterada para ñãõ pegar o mês anterior caso seja dia primeiro}
   //if copy(psDataIniFund, 1, 2) = '01' then
   //  sMesFAB := FormatDateTime('YYYY/MM', IncMonth(StrToDate(psDataIniFund), -1))
   //else
   //Término - William Santana - SIG 19010 PPM 1376964
     sMesFAB := psMesReferencia;
   // edilaine - SOL 253577-18064 / PPM 1240079 - fim

   //edilaine WO18367 : inicio
   // comentado a consulta e transformada em uma funcao
   {with qryAux do
   begin
     sql.clear;
     // edilaine - SOL 253577-18064 / PPM 1240079 - inicio
     //sql.Add('SELECT NVL(BF.VLRFABTOTAL, BS.SALDOFAB) AS SALDOFAB, ');            //edilaine - SIG87003
     sql.Add('SELECT NVL(BF.VLRFABTOTAL, BS.SALDOFABINSS) AS SALDOFAB, ');          //edilaine - SIG87003
     sql.Add('       CASE                                          ');
     sql.Add('         WHEN BPP.FLGAPRESENTABSFAB = 1 THEN         ');
     //     sql.Add('           NVL(BF.VLRBSTOTAL, BS.BENEFSALDADO)       ');              //edilaine - SIG87003
     sql.Add('           NVL(BF.VLRBSTOTAL, BS.BENEFSALDADOINSS)       ');            //edilaine - SIG87003
     sql.Add('         ELSE                                        ');
     //     sql.Add('           NVL(BF.VALORTOTAL, BS.BENEFSALDADO)       ');              //edilaine - SIG87003
     sql.Add('           NVL(BF.VALORTOTAL, BS.BENEFSALDADOINSS)       ');            //edilaine - SIG87003
     sql.Add('       END BENEFSALDADO                              ');
     //sql.Add('SELECT NVL(BF.VLRFABTOTAL, BS.SALDOFAB) AS SALDOFAB,    ');
     //sql.Add('       NVL(BF.VLRBSTOTAL, BS.BENEFSALDADO) BENEFSALDADO  ');
     // edilaine - SOL 253577-18064 / PPM 1240079 - fim
     sql.Add('  FROM DEPENTIT D                                  ');
     sql.Add('  LEFT JOIN BENEFSALDFAB BS ON  BS.IDTITULAR = D.IDTITULAR ');
     sql.Add('                            AND BS.IDPESSOA  = D.IDPESSOA  ');
     //sql.Add('                            AND BS.MESREFERENCIA = '+ Quotedstr(psMesReferencia) );   // edilaine - SOL 253577-18064 / PPM 1240079
     sql.Add('                            AND BS.MESREFERENCIA = '+ Quotedstr(sMesFAB) );             // edilaine - SOL 253577-18064 / PPM 1240079
     sql.Add('  LEFT JOIN BENEFBFCIARIO BF ON BF.IDTITULAR = D.IDTITULAR  ');
     sql.Add('                            AND BF.IDPESSOA  = D.IDTITULAR   ');
     sql.Add('                            AND BF.IDPESSOA <> '+ IntToStr(piIdPessoa) );
     sql.Add('                            AND BF.IDPLANOPREV = '+ IntToStr(piIdPlanoPrev) );
     sql.Add('                            AND BF.FONTEPAGADORA = ' + sFontePagadora );
     sql.Add('                            AND BF.IDTPPAGTOBENEFIC = '+ IntToStr(iIdTpPagtoBenef) );
     sql.Add('                            AND BF.IDPLANPREVCONTAB = '+ IntToStr(iIdPlanPrevContab) );       // edilaine - SOL 253577-17854 / PPM 1131941
     // edilaine - SOL 253577-18064 / PPM 1240079 - inicio
     sql.Add('  LEFT JOIN BENEFPLANPREV BPP ON BF.IDBENEFICIO = BPP.IDBENEFICIO  ');
     sql.Add('                             AND BF.IDPLANOPREV = BPP.IDPLANOPREV  ');
     // edilaine - SOL 253577-18064 / PPM 1240079 - fim

     sql.Add(' WHERE D.IDTITULAR = '+ IntToStr(piIdTitular) );
     sql.Add('   AND D.IDPESSOA  = '+ IntToStr(piIdTitular) );
     sql.Add(' ORDER BY BS.IDBENEFSALDFAB DESC' );         // edilaine - SOL 253577-17514 / PPM 971383
   end;
   qryAux.Open;

   if not qryAux.eof then
   begin
     rVlrSaldoFAB := qryAux.fieldByName('SALDOFAB').AsCurrency;
     rVlrBSSaldo  := qryAux.fieldByName('BENEFSALDADO').AsCurrency;
   end
   else
   begin
     rVlrSaldoFAB := 0;
     rVlrBSSaldo  := 0;
   end;
   qryAux.close;  }

   if not PegaValorBsFabTitular(qryAux,
                                piIdPlanoPrev,
                                piIdPessJur,
                                piIdPessoa,
                                piIdTitular,
                                piIdBeneficio,
                                sMesFAB,
                                sFontePagadora,
                                iIdTpPagtoBenef,
                                iIdPlanPrevContab,
                                rVlrBSSaldo,
                                rVlrSaldoFAB)
   then begin
      bErro := True;
      sMsgErro := ' Ocorreu um erro na Busca do Valor '+ psTipoCalculo ;
      Result  := -1;
      Exit;
   end;
   //edilaine WO18367 : fim


   if Trim(sSQLBenefAssociado) = '' then
      sSQLBenefAssociado := ', 0 AS VALORASSOCIADO, 0 AS ASSOC1OP1, 0 AS ASSOC2OP1, 0 AS ASSOC3OP1, '+
                            '                       0 AS ASSOC1OP2, 0 AS ASSOC2OP2, 0 AS ASSOC3OP2, '+
                            '                       0 AS ASSOC1OP3, 0 AS ASSOC2OP3, 0 AS ASSOC3OP3  ';

  // Executa Regra de Cálculo do Valor do Beneficio
  sSQL := 'SELECT '+
          '       '+IntToStr(piIdPessJur)     +' AS IDPESSJUR,   '+
          '       '+IntToStr(piIdPessoa)      +' AS IDPESSOA,    '+
          '       '+IntToStr(piIdTitular)     +' AS IDTITULAR,   '+
          '       '+IntToStr(piIdBeneficio)   +' AS IDBENEFICIO, '+
          '       '+OraNumero(FloatToStr(prValorBase1))+' AS VALORBASE1, '+
          '       '+IntToStr(piIdPlanoPrev)   +' AS IDPLANOPREV,         '+
          '       '+OraNumero(CurrToStr(rVlrSaldoFAB))+' AS SALDOFAB,    '+
          '       '+OraNumero(CurrToStr(rVlrBSSaldo))+' AS BENEFSALDADO  '+
          '       '+sSQLBenefAssociado;

  // edilaine WO18367 : inicio
  if psPercPensao <> '' then
  sSQL := sSQL +
          '       , '+psPercPensao+ ' AS PERCFAMILIAR  ';
  // edilaine WO18367 : fim

  sSQL := sSQL +
          '  FROM DUAL';


  piIdCalculo := -1;
  sValor := RegraNumerica(IntToStr(piIdRegraCalculo), sSQL, bErro, piIdCalculo, True );

  if bErro
   then begin
     bErro := True;
     sMsgErro := ' Ocorreu um erro na Regra de Cálculo do Valor do '+ psTipoCalculo +' (nº '+IntToStr(piIdRegraCalculo)+') ';
     Result  := -1;
     Exit;
  end;

  if Trim(sValor) = ''
  then begin
     bErro := True;
     sMsgErro := ' A Regra de Cálculo do Valor do '+ psTipoCalculo +'(nº '+IntToStr(piIdRegraCalculo)+')'+
                 ' retornou um valor em branco. ';
     Result  := -1;
     Exit;
  end;

  try
     rValor := StrToFloat(ClienteNumero(sValor));
  except
     bErro := True;
     sMsgErro := ' A Regra de Cálculo do Valor do '+ psTipoCalculo +'(nº '+IntToStr(piIdRegraCalculo)+')' +
                 ' retornou um valor inválido. [Valor Retornado = '+sValor+']';
     Result  := -1;
     Exit;
  end;

  bErro    := False;
  sMsgErro := ' ';
  Result   := rValor;

end;
