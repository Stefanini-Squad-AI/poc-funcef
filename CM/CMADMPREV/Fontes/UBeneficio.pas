                       '                 AND    ((HST.FLGDEVOLUCAO  = 0) OR (HST.FLGDEVOLUCAO IS NULL))     '+
                       '                 AND    ((HST.VALORRECEBIDO IS NULL) OR (HST.VALORRECEBIDO = 0) )   '+
                       '                 AND    (HST.MESREFERENCIA  = '''+Copy(sAnoMesAtualAbono,1,4)+'/13'+''')'+
                       '                 AND    (CP.IDPLANOPREV     = HST.IDPLANOPREV)                      '+
                       '                 AND    (CP.IDCONTRIBUICAO  = HST.IDCONTRIBUICAO)                   '+
                       '                 AND    (CP.FLGINTERNO      = ''AS'')                               '+
                       '                 AND    (HA.NUMRECEBIMENTO  = HST.NUMRECEBIMENTO)                   '+
                       '                 AND    (HA.MESREFERENCIA   = HST.MESREFERENCIA)                    '+
                       '                 AND    (HA.MESCOBRANCA     = HST.MESCOBRANCA)                      '+
                       '                 AND    (HA.IDMOTIVO        = HST.IDMOTIVO)                         '+
                       '               )                                                                    ');

        try
          qryAux.ExecSQL;
        except
          sMsgErro := ' : Erro na exclusão dos alteradores da contribuição.';
          frmAguarde.Apaga;
          Exit;
        end;

        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add(' DELETE FROM HSTCONTRIBPREV HA '+
                       ' WHERE  (HA.MESREFERENCIA  = '''+Copy(sAnoMesAtualAbono,1,4)+'/13'+''')'+
                       ' AND    (HA.IDPESSJUR      = '+IntToStr(piIdPessJur)          +')  '+
                       ' AND    (HA.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)        +')  '+
                       ' AND    (HA.IDPESSOA       = '+IntToStr(iIdPessoaHstContrib)  +')  '+
                       ' AND    (HA.IDTITULAR      = '+IntToStr(piIdTitular)          +')  '+//Fanuel Junior SOL 157444/5301 Kintana 1329006
                       ' AND    (HA.SEQPROPOSTA    = '+IntToStr(piSeqProposta)        +')  '+
                       ' AND    ((HA.FLGDEVOLUCAO  = 0) OR (HA.FLGDEVOLUCAO IS NULL))     '+
                       ' AND    ((HA.VALORRECEBIDO IS NULL) OR (HA.VALORRECEBIDO = 0) )   '+
                       ' AND EXISTS ( SELECT 1      '+
                       '                 FROM   HSTCONTRIBPREV HST, CONTPREV CP                             '+
                       '                 WHERE  (HST.IDPESSJUR      = '+IntToStr(piIdPessJur)          +')  '+
                       '                 AND    (HST.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)        +')  '+
                       '                 AND    (HST.IDPESSOA       = '+IntToStr(iIdPessoaHstContrib)  +')  '+
                       '                 AND    (HST.IDTITULAR      = '+IntToStr(piIdTitular)          +')  '+//Fanuel Junior SOL 157444/5301 Kintana 1329006
                       '                 AND    (HST.SEQPROPOSTA    = '+IntToStr(piSeqProposta)        +')  '+
                       '                 AND    ((HST.FLGDEVOLUCAO  = 0) OR (HST.FLGDEVOLUCAO IS NULL))     '+
                       '                 AND    ((HST.VALORRECEBIDO IS NULL) OR (HST.VALORRECEBIDO = 0) )   '+
                       '                 AND    (HST.MESREFERENCIA  = '''+Copy(sAnoMesAtualAbono,1,4)+'/13'+''')'+
                       '                 AND    (CP.IDPLANOPREV     = HST.IDPLANOPREV)                      '+
                       '                 AND    (CP.IDCONTRIBUICAO  = HST.IDCONTRIBUICAO)                   '+
                       '                 AND    (CP.FLGINTERNO      = ''AS'')                               '+
                       '                 AND    (HA.MESREFERENCIA   = HST.MESREFERENCIA)                    '+
                       '                 AND    (HA.MESCOBRANCA     = HST.MESCOBRANCA)                      '+
                       '                 AND    (HA.IDMOTIVO        = HST.IDMOTIVO)                         '+
                       '                 AND    (HA.NUMRECEBIMENTO  = HST.NUMRECEBIMENTO)                   '+
                       '               )                                                                    ');
        try
          qryAux.ExecSQL;
        except
          sMsgErro := sNome+' : Erro na exclusão da contribuição.';
          frmAguarde.Apaga;
          Exit;
        end;


      end;

      sSQL := ' SELECT HST.IDPESSJUR,     HST.IDPLANOPREV,                                                    '+
              '        HST.IDPESSOA,      HST.SEQPROPOSTA,   HST.MESREFERENCIA,                               '+
              '        HST.IDCONTRIBUICAO,                                                                    '+
              '        SUM(DECODE(HST.FLGDEVOLUCAO,0,HST.VALORESPERADO, -HST.VALORESPERADO)) AS VALORESPERADO, '+
              '        SUM(DECODE(HST.FLGDEVOLUCAO,0,HST.VALORRECEBIDO, -HST.VALORRECEBIDO)) AS VALORRECEBIDO  '+
              ' FROM   HSTCONTRIBPREV HST, CONTPREV CP             '+
              ' WHERE  (HST.IDPESSJUR      = '+IntToStr(piIdPessJur)           +')'+
              ' AND    (HST.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)         +')'+
              ' AND    (HST.IDTITULAR      = '+IntToStr(piIdTitular)           +')'+//Fanuel Junior SOL 157444/5301 Kintana 1329006
              ' AND    (HST.IDPESSOA       = '+IntToStr(iIdPessoaHstContrib)   +')'+
              ' AND    (HST.SEQPROPOSTA    = '+IntToStr(piSeqProposta)         +')'+
              ' AND    ((HST.FLGDEVOLUCAO  = 0) OR (HST.FLGDEVOLUCAO IS NULL)    )'+
              ' AND    (HST.MESREFERENCIA  = '''+Copy(sAnoMesAtualAbono,1,4)+'/13'+''')'+
              ' AND    (CP.IDPLANOPREV     = HST.IDPLANOPREV)                    '+
              ' AND    (CP.IDCONTRIBUICAO  = HST.IDCONTRIBUICAO)                 '+
              ' AND    (CP.FLGINTERNO = ''AS'')                                  '+
              ' GROUP BY HST.IDPESSJUR,     HST.IDPLANOPREV,                                                    '+
              '        HST.IDPESSOA,      HST.SEQPROPOSTA,   HST.MESREFERENCIA,                                 '+
              '        HST.IDCONTRIBUICAO                                                                       ';
      qry.Close;
      qry.SQL.Clear;
      qry.SQL.Add(sSQL);
      qry.Open;

      While not qry.Eof do
      Begin

        // Se o ano do abono encontrado for posterior ao ano da data final
        // Entao devolver integral
        if StrToInt(Copy(sAnoMesAtualAbono,1,4)) > StrToInt(Copy(sNovaDataFinal,7,4))
        then begin
          dValorDevido := 0;
        end
        else
        begin
          // SE A ROTINA PREPARACONTRIBUICAOASSISTIDO CHAMADA NA PARTE DA
          // ULTIMA CONTRIBUICAO ANTES DO ENCERRAMENTO FOR CHAMADA
          // A CONTRIBUICAO SOBRE 13o. TERÁ SIDO CALCULADA DENTRO DELA
          // E SE FOR RECALCULADA AQUI IRÁ DUPLICAR A COBRANÇA

          sSQL := ' SELECT HST.IDPESSJUR,     HST.IDPLANOPREV,                                                    '+
                  '        HST.IDPESSOA,      HST.SEQPROPOSTA,   HST.MESREFERENCIA,                               '+
                  '        HST.IDCONTRIBUICAO,                                                                    '+
                  '        SUM(DECODE(HST.FLGDEVOLUCAO,0,HST.VALORESPERADO, -HST.VALORESPERADO)) AS VALORESPERADO '+
                  ' FROM   HSTCONTRIBPREV HST, CONTPREV CP             '+
                  ' WHERE  (HST.IDPESSJUR      = '+IntToStr(piIdPessJur)           +')'+
                  ' AND    (HST.IDPLANOPREV    = '+IntToStr(piIdPlanoPrev)         +')'+
                  ' AND    (HST.IDPESSOA       = '+IntToStr(iIdPessoaHstContrib)   +')'+
                  ' AND    (HST.IDTITULAR      = '+IntToStr(piIdTitular)           +')'+//Fanuel Junior SOL 157444/5301 Kintana 1329006
                  ' AND    (HST.SEQPROPOSTA    = '+IntToStr(piSeqProposta)         +')'+
                  ' AND    (HST.IDCONTRIBUICAO = '+qry.FieldByName('IDCONTRIBUICAO').AsString+') '+
                  ' AND    (HST.MESCOBRANCA    = '''+sAnoMesPagto+''') '+
                  ' AND    (HST.MESREFERENCIA  = '''+Copy(sAnoMesAtualAbono,1,4)+'/13'+''')'+
                  ' AND    (HST.FLGCONCESSAO   = 1 ) '+
                  ' AND    (NVL(HST.VALORRECEBIDO,0) <= 0 ) '+
                  ' AND    (CP.IDPLANOPREV     = HST.IDPLANOPREV)                    '+
                  ' AND    (CP.IDCONTRIBUICAO  = HST.IDCONTRIBUICAO)                 '+
                  ' AND    (CP.FLGINTERNO = ''AS'')                                  '+
                  ' GROUP BY HST.IDPESSJUR,     HST.IDPLANOPREV,                     '+
                  '        HST.IDPESSOA,      HST.SEQPROPOSTA,   HST.MESREFERENCIA,  '+
                  '        HST.IDCONTRIBUICAO                                        ';

          qryAux.Close;
          qryAux.SQl.Clear;
          qryAux.SQL.Add(sSQL);
          qryAux.Open;
          if (not qryAux.IsEmpty)
          then begin
             bTeveContribNoAnoDoEncerramento := True;
             qry.Next;
             continue;
          end;


          bTeveContribNoAnoDoEncerramento := True;
          dValorDevido := CalculaContribuicaoACobrarNoMes( qryAux,
                                                           piIdPessJur,
                                                           piIdPlanoPrev,
                                                           piIdBeneficiario,
                                                           piSeqProposta,
                                                           qry.FieldByName('IDCONTRIBUICAO').AsInteger,
                                                           qry.FieldByName('MESREFERENCIA').AsString,
                                                           psFlgIntEvento,
                                                           psDataInicio,
                                                           sNovaDataFinal,
                                                           iIdMotivoAux,
                                                           iOrigem,
                                                           iFlgDataPrevista,
                                                           piNumeroProcesso,
                                                           sMsgErro,
                                                           piIdLoteRetemEncerra);

        end;

        // Tratamento para adiantamento de abono.
        // Devolver todo adiantamento pago caso exista. E cobrar integralmente
        // o abono do ano.


        // Verificar quanto foi pago de contribuicao para proceder a comparacao
        sSQL := 'SELECT '+
                '  HST.MESREFERENCIA, HST.IDPESSOA, HST.IDPESSJUR, HST.IDPLANOPREV, HST.IDCONTRIBUICAO, '+
                '  SUM(DECODE(HST.FLGDEVOLUCAO,0,HST.VALORRECEBIDO,-1 * HST.VALORRECEBIDO)) AS VALORRECEBIDO, '+

                '  CP.FLGINTERNO AS FLGSITFUNDACAO '+

                'FROM   '+
                '  HSTCONTRIBPREV HST, CONTPREV CP '+
                'WHERE  '+
                '     ( HST.IDPESSJUR      = '+ IntToStr(piIdPessJur)             +')'+
                ' AND ( HST.IDPLANOPREV    = '+ IntToStr(piIdPlanoPrev)           +')'+
                ' AND ( HST.IDPESSOA       = '+ IntToStr(piIdBeneficiario)        +')'+
                ' AND ( HST.IDTITULAR      = '+ IntToStr(piIdTitular)             +')'+//Fanuel Junior SOL 157444/5301 Kintana 1329006
                ' AND ( HST.SEQPROPOSTA    = '+ IntToStr(piSeqProposta)           +')'+
                ' AND ( HST.MESREFERENCIA  = '+ QuotedStr( Copy(sAnoMesAtualAbono,1,4)+'/13' )+')'+
                ' AND ( HST.IDCONTRIBUICAO = '+ Qry.FieldByName('IDCONTRIBUICAO').AsString    +')'+

                ' AND ( CP.IDPLANOPREV     = HST.IDPLANOPREV)                   '+
                ' AND ( CP.IDCONTRIBUICAO  = HST.IDCONTRIBUICAO)                '+
                ' AND ( CP.FLGINTERNO = ''AS'')                                 '+
                
                ' AND ( HST.SITRECEBIMENTO IN (2,3,4))                          '+

                'GROUP BY '+
                '  HST.MESREFERENCIA, HST.IDPESSOA, HST.IDPESSJUR,  '+
                '  HST.IDPLANOPREV,   HST.IDCONTRIBUICAO,           '+
                '  CP.FLGINTERNO                                    ';

        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add(sSQL);
        qryAux.Open;

        If ( Abs( QryAux.FieldByName('VALORRECEBIDO').AsFloat - dValorDevido ) <= 0.01 ) Then
        Begin
          qry.Next;
          continue;
        End;

        sFlgDevolucao := '1';
        dValorAcerto  := Abs( QryAux.FieldByName('VALORRECEBIDO').AsFloat );
        sFlgSituacao  := QryAux.FieldByName('FLGSITFUNDACAO').AsString;

        // Inserir devolução do que foi pago
        InsereHstContribPREV(qryAux,
                             qry.FIeldByName('IDPESSOA').AsInteger,
                             1,                                              // SEQPROPOSTA
                             qry.FieldByName('IDPESSJUR').AsInteger,
                             qry.FieldByName('IDPLANOPREV').AsInteger,
                             qry.FieldByName('IDCONTRIBUICAO').AsInteger,
                             iIdMotivoAux,
                             qry.FieldByName('MESREFERENCIA').AsString,
                             sAnoMesPagto,                                   // MESCOBRANCA
                             -1,                                             // CODPORTFORMA
                             sDataFolha,                                     // DATACOBRANCA
                             '',                                             // DATARECEBIMENTO
                             dValorAcerto, dValorAcerto,
                             0, 0, 1,                                        // FLGDESCFOLHA
                             0, 0, 0,                                        // VALORES BASE
                             psDataInicio,
                             '',                                             // DATAFINAL VERIFICAR
                             sFlgSituacao,                                   // SITFUNDACAO
                             0,                                              // SITRECEBIMENTO
                             0,                                              // PARCELA
                             piIdLoteRetemEncerra,                           // LOTE
                             'F',                                            // TIPOPREVIDENCIA
                             0,                                              // FLGCALCRESERVA
                             StrToInt(sFlgDevolucao),
                             1,                                              // FLGCONCESSAO
                             1,                                              // FLGEVENTO
                             sFolhaOrigem);

        sFlgDevolucao := '0';
        // Inserir valor integral da cotribuição
        InsereHstContribPREV(qryAux,
                             qry.FIeldByName('IDPESSOA').AsInteger,
                             1,                                              // SEQPROPOSTA
                             qry.FieldByName('IDPESSJUR').AsInteger,
                             qry.FieldByName('IDPLANOPREV').AsInteger,
                             qry.FieldByName('IDCONTRIBUICAO').AsInteger,
                             iIdMotivoAux,
                             qry.FieldByName('MESREFERENCIA').AsString,
                             sAnoMesPagto,                                   // MESCOBRANCA
                             -1,                                             // CODPORTFORMA
                             sDataFolha,                                     // DATACOBRANCA
                             '',                                             // DATARECEBIMENTO
                             dValorDevido, dValorDevido,
                             0, 0, 1,                                        // FLGDESCFOLHA
                             0, 0, 0,                                        // VALORES BASE
                             psDataInicio,
                             '',                                             // DATAFINAL VERIFICAR
                             sFlgSituacao,                                   // SITFUNDACAO
                             0,                                              // SITRECEBIMENTO
                             0,                                              // PARCELA
                             piIdLoteRetemEncerra,                           // LOTE
                             'F',                                            // TIPOPREVIDENCIA
                             0,                                              // FLGCALCRESERVA
                             StrToInt(sFlgDevolucao),
                             1,                                              // FLGCONCESSAO
                             1,                                              // FLGEVENTO
                             sFolhaOrigem);


        Qry.Next;

      End; // while not qry.Eof do

      // Se não teve contribuicao no mes e o mes é o mes da data final,
      // Entao gerar cobranca da contribuicao
      if (not bTeveContribNoAnoDoEncerramento)  and (sAnoMesAtualAbono = sAnoMesInicioFaixa) and (cTipoAbono = 'B') then
      begin
        bTeveContribNoAnoDoEncerramento := True;
        sSQL := ' SELECT CP.IDCONTRIBUICAO, CP.SEQPROPOSTA, CP.IDCONTRIBUICAO, CP.IDPESSOA,    ' +
                '        CP.CODPORTFORMA, CP.FLGDESCFOLHA, CP.VALORBASE1, CP.VALORBASE2,       ' +
                '        CP.VALORBASE3, CP.DATAINICIO, CP.DATAFINAL, C.NOME, PP.INSCRICAODATA, ' +
                '        PF.DATANASC, CT.ORDEMCALCULO, PP.DTINICIOINSC, CT.FLGINTERNO AS FLGSITFUNDACAO '+
                ' FROM  CONTRIBUICAO C, CONTPREV CT,  PARTPREVPLAN PP, CONTRIBPREVPARTP CP, PESSOAFISICA PF ' +
                ' WHERE CP.IDPESSJUR      = ' + IntToStr(piIdPessJur)   + ' AND ' +
                '       CP.IDPLANOPREV    = ' + IntToStr(piIdPlanoPrev) + ' AND ' +
                '       CP.IDPESSOA       = ' + IntToStr(piIdTitular)   + ' AND ' +
                '       CP.SEQPROPOSTA    = ' + IntToStr(piSeqProposta) + ' AND ' +
                '       CP.FLGCOBRA       = 1 AND '+
                '       CT.FLGCOBRADECTERC = 1 AND '+ 
                '       CT.FLGINTERNO     = ''AS'' AND '+
                '       CP.IDCONTRIBUICAO = C.IDCONTRIBUICAO AND '+
                '       PP.IDPESSJUR      = CP.IDPESSJUR AND '+
                '       PP.IDPLANOPREV    = CP.IDPLANOPREV AND '+
                '       PP.IDPESSOA       = CP.IDPESSOA AND '+
                '       PP.SEQPROPOSTA    = CP.SEQPROPOSTA AND '+
                '       PF.IDPESSOA       = CP.IDPESSOA AND '+
                '       CT.IDPLANOPREV    = CP.IDPLANOPREV AND '+
                '       CT.IDCONTRIBUICAO = CP.IDCONTRIBUICAO '+
                ' ORDER BY CT.ORDEMCALCULO ';
        qry.Close;
        qry.SQL.Clear;
        qry.SQL.Add(sSQL);
        qry.Open;

        while not qry.Eof do
        begin
          sFlgDevolucao := '0';
          dValorAcerto  := CalculaContribuicaoACobrarNoMes( qryAux,
                                                            piIdPessJur,      piIdPlanoPrev,
                                                            piIdBeneficiario, piSeqProposta,
                                                            qry.FieldByName('IDCONTRIBUICAO').AsInteger,
                                                            Copy(sNovaDataFinal,7,4)+'/13',
                                                            psFlgIntEvento,
                                                            psDataInicio, sNovaDataFinal,
                                                            iIdMotivoAux, 2, iFlgDataPrevista,
                                                            piNumeroProcesso,
                                                            sMsgErro,
                                                            piIdLoteRetemEncerra );

          //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
          if (dValorAcerto > 0) then begin
            InsereHstContribPREV( qryAux,
                                  qry.FIeldByName('IDPESSOA').AsInteger,
                                  1,                                          // SEQPROPOSTA
                                  piIdPessJur,
                                  piIdPlanoPrev,
                                  qry.FieldByName('IDCONTRIBUICAO').AsInteger,
                                  iIdMotivoAux,
                                  Copy(sNovaDataFinal,7,4)+'/13',
                                  sAnoMesPagto,                               // MESCOBRANCA
                                  -1,                                         // CODPORTFORMA
                                  sDataFolha,                                 // DATACOBRANCA
                                  '',                                         // DATARECEBIMENTO
                                  dValorAcerto,
                                  dValorAcerto,
                                  0, 0, 1,                                    // FLGDESCFOLHA
                                  0,0,0,                                      // VALORES BASE
                                  psDataInicio,
                                  '',                                         // DATAFINAL VERIFICAR
                                  qry.FieldByName('FLGSITFUNDACAO').AsString, // SITFUNDACAO
                                  0,                                          // SITRECEBIMENTO
                                  0,                                          // PARCELA
                                  piIdLoteRetemEncerra,                       // LOTE
                                  'F',                                        // TIPOPREVIDENCIA
                                  0,                                          // FLGCALCRESERVA
                                  StrToInt(sFlgDevolucao),
                                  1,                                          // FLGCONCESSAO
                                  1,                                          // FLGEVENTO
                                  sFolhaOrigem);
          end;
          //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622
          qry.Next;

        end; // while not qry.Eof do

      end; // (not bTeveContribNoMesDoEncerramento)  and (sAnoMesAtual = sAnoMesInicioFaixa)

      sAnoMesAtualAbono  := ProximoAnoMes(StrToInt(Copy(sAnoMesAtualAbono, 6,2)), StrToInt(Copy(sAnoMesAtualAbono, 1,4)));

    end; //while sAnoMesAtualAbono <= sAnoMesFinalAbono do

  end;

  // **************************************************************************
  // ** FIM DO TRATAMENTO DE CONTRIBUIÇÕES SOBRE 13o.
  // **************************************************************************
  } // edilaine - SOL 253577-17541 / PPM 978024 - fim comentado


  // edilaine - SOL 253577-17541 / PPM 978024 - inicio
  If (ExecutaSP_PreparoContribuicao(piNumeroProcesso, // se der erro retorna true
                                    piIdTitular,
                                    iIdMotivoAux,
                                    piIdLoteRetemEncerra,
                                    'Não',
                                    sAnoMesPagto,
                                    '',
                                    -1, -1, iOrigem )) then          // edilaine - SOL 253577-18152 / PPM 1318911
  begin
     MsgDlg('Erro no preparo das contribuições. Verifique. ','Erro',mtError,[mbOk,mbHelp],0);
     Exit;
  end;
  // edilaine - SOL 253577-17541 / PPM 978024 - fim


  frmAguarde.Mostra('Atualizando Benefícios ...');
  Result := True;
  
end;

function ExecutaRegraPrimUltPagtoDeficit(QryAux : TwwQuery;
                                         piNumeroProcesso,
                                         piIdBeneficio,
                                         piIdPessJur,
                                         piIdPlanoPrev,
                                         piIdTitular,
                                         piSeqProposta,
                                         piIdPessoa : LongInt;
                                         psAnoMesAtual : string;
                                         var sVlrBSTotal,
                                             sVlrFABTotal,
                                             sVlrBCDeficit : string): Boolean;
Var
  sDataInicioBeneficio, sDataFinalBeneficio, sMsgErro: string;
  iIdRegraPrimPagto, iIdRegraUltPagto, iNumBenef : integer;
  rVlrBSTotal, rVlrFABTotal, rVlrBCDeficit : double;
  bErro : boolean;
begin
   result := true;

   with TwwQuery.Create(nil) do
   begin
      DataBaseName := 'Basedados';
      SQL.Add(' SELECT  BP.IDREGRAPRIMPAGTO, BP.IDREGRAULTPAGTO  FROM BENEFPLANPREV BP '+
              ' INNER JOIN BENEFICIO B ON (B.IDBENEFICIO = BP.IDBENEFICIO) '+
              ' WHERE BP.IDBENEFICIO = '+FloatToStr(piIdBeneficio)+
              ' AND BP.IDPLANOPREV   = '+FloatToStr(piIdPlanoPrev) );
      Open;
      iIdRegraPrimPagto := FieldByName('IDREGRAPRIMPAGTO').AsInteger;
      iIdRegraUltPagto  := FieldByName('IDREGRAULTPAGTO').AsInteger;
      Close;
   end;


   with TwwQuery.Create(nil) do
   begin
      DataBaseName := 'Basedados';
      SQL.Add(' SELECT B.DATAFINAL, B.DATAINICIOFUND  FROM BENEFBFCIARIO B  '+
              ' WHERE IDTITULAR    = '+ FloatToStr(piIdTitular) +
              ' AND NUMEROPROCESSO = '+QuotedStr(FloatToStr(piNumeroProcesso))+
              ' AND IDPESSOA       =  '+FloatToStr(piIdPessoa)+
              ' AND IDPLANOPREV    = '+FloatToStr(piIdPlanoPrev)+
              ' AND IDBENEFICIO    =  '+FloatToStr(piIdBeneficio) );
      Open;
      sDataInicioBeneficio := FieldByName('DATAINICIOFUND').AsString;
      sDataFinalBeneficio  := FieldByName('DATAFINAL').AsString;
      Close;
   end;


   if sDataInicioBeneficio <>  '' then
   begin
      if psAnoMesAtual = FormatDateTime('yyyy/mm', strtodate(sDataInicioBeneficio)) then
      begin
         if iIdRegraPrimPagto > 0 then
         begin
             with TwwQuery.Create(nil) do
             begin
                DataBaseName := 'Basedados';
                SQL.Add(' SELECT BF.IDPESSOA FROM BFCIARIOTITPLAN BF, BENEFPLANPREV BP '+
                        ' WHERE  (BF.IDTITULAR   = '+IntToStr(piIdTitular)  +') '+
                        ' AND    (BF.IDPESSJUR   = '+IntToStr(piIdPessJur)  +') '+
                        ' AND    (BF.IDPLANOORIGEM = '+IntToStr(piIdPlanoPrev)+') '+
                        ' AND    (BF.SEQPROPOSTA = '+IntToStr(piSeqProposta)+') '+
                        ' AND    (BF.IDBENEFICIO = '+IntToStr(piIdBeneficio)+') '+
                        ' AND    (BP.IDPLANOPREV    = BF.IDPLANOPREV) '+
                        ' AND    (BP.IDBENEFICIO    = BF.IDBENEFICIO) '+
                        ' AND    ((BP.FLGREFERENCIA = 0) OR ( (BP.FLGREFERENCIA = 1) AND (BP.FLGPAGAINSS = 1) ) )  ' );
                Open;
                iNumBenef := qryAux.RecordCount;
                Close;
             end;


             rVlrBSTotal := ExecutaRegraPrimUltPagtoBenef( qryAux,
                                                           iIdRegraPrimPagto,
                                                           piIdTitular,
                                                           piIdPessoa,
                                                           piSeqProposta,
                                                           piIdPessJur,
                                                           piIdPlanoPrev,
                                                           piIdBeneficio,
                                                           iNumBenef,
                                                           //psDataInicio,      // SOL 157203.13987 Kintana 1942467
                                                           //psDataInicioOriginal, // SOL 157203.13987 Kintana 1942467
                                                           sDataInicioBeneficio, // SOL 204188 Kintana 1973428
                                                           sDataFinalBeneficio,
                                                           '', // Thiago Melo SOL 208274.15065 Kintana 2043014
                                                           OraNumero(sVlrBSTotal),
                                                           ' Primeiro ', bErro, sMsgErro, iIdCalculoGeral
                                                           ,false // Renato Visoni SOL 158469 Kintana 1285346
                                                           );

             sVlrBSTotal :=  FloatToStr(rVlrBSTotal);

             rVlrFABTotal := ExecutaRegraPrimUltPagtoBenef( qryAux,
                                                           iIdRegraPrimPagto,
                                                           piIdTitular,
                                                           piIdPessoa,
                                                           piSeqProposta,
                                                           piIdPessJur,
                                                           piIdPlanoPrev,
                                                           piIdBeneficio,
                                                           iNumBenef,
                                                           //psDataInicio,      // SOL 157203.13987 Kintana 1942467
                                                           //psDataInicioOriginal, // SOL 157203.13987 Kintana 1942467
                                                           sDataInicioBeneficio, // SOL 204188 Kintana 1973428
                                                           sDataFinalBeneficio,
                                                           '', // Thiago Melo SOL 208274.15065 Kintana 2043014
                                                           OraNumero(sVlrFABTotal),
                                                           ' Primeiro ', bErro, sMsgErro, iIdCalculoGeral
                                                           ,false // Renato Visoni SOL 158469 Kintana 1285346
                                                           );

             sVlrFABTotal :=  FloatToStr(rVlrFABTotal);

             rVlrBCDeficit := ExecutaRegraPrimUltPagtoBenef( qryAux,
                                                           iIdRegraPrimPagto,
                                                           piIdTitular,
                                                           piIdPessoa,
                                                           piSeqProposta,
                                                           piIdPessJur,
                                                           piIdPlanoPrev,
                                                           piIdBeneficio,
                                                           iNumBenef,
                                                           //psDataInicio,      // SOL 157203.13987 Kintana 1942467
                                                           //psDataInicioOriginal, // SOL 157203.13987 Kintana 1942467
                                                           sDataInicioBeneficio, // SOL 204188 Kintana 1973428
                                                           sDataFinalBeneficio,
                                                           '', // Thiago Melo SOL 208274.15065 Kintana 2043014
                                                           OraNumero(sVlrBCDeficit),
                                                           ' Primeiro ', bErro, sMsgErro, iIdCalculoGeral
                                                           ,false // Renato Visoni SOL 158469 Kintana 1285346
                                                           );

             sVlrBCDeficit :=  FloatToStr(rVlrBCDeficit);
         end;
      end;
   end;

   if sDataFinalBeneficio <>  '' then
   begin
      if psAnoMesAtual = FormatDateTime('yyyy/mm', strtodate(sDataFinalBeneficio)) then
      begin

         if iIdRegraUltPagto > 0 then
         begin

              rVlrBSTotal := ExecutaRegraPrimUltPagtoBenef(qryAux,
                                                           iIdRegraUltPagto,
                                                           piIdTitular,  piIdPessoa, piSeqProposta,
                                                           piIdPessJur,  piIdPlanoPrev,    piIdBeneficio,
                                                           1,
                                                           sDataInicioBeneficio, sDataFinalBeneficio,
                                                           '', // Thiago Melo SOL 208274.15065 Kintana 2043014
                                                           OraNumero(sVlrBSTotal),
                                                           ' Último ',  bErro,  sMsgErro, iIdCalculoGeral);

              sVlrBSTotal :=  FloatToStr(rVlrBSTotal);

              rVlrFABTotal := ExecutaRegraPrimUltPagtoBenef(qryAux,
                                                           iIdRegraUltPagto,
                                                           piIdTitular,  piIdPessoa, piSeqProposta,
                                                           piIdPessJur,  piIdPlanoPrev,    piIdBeneficio,
                                                           1,
                                                           sDataInicioBeneficio, sDataFinalBeneficio,
                                                           '', // Thiago Melo SOL 208274.15065 Kintana 2043014
                                                           OraNumero(sVlrFABTotal),
                                                           ' Último ',  bErro,  sMsgErro, iIdCalculoGeral);
              sVlrFABTotal :=  FloatToStr(rVlrFABTotal);

              rVlrBCDeficit := ExecutaRegraPrimUltPagtoBenef(qryAux,
                                                           iIdRegraUltPagto,
                                                           piIdTitular,  piIdPessoa, piSeqProposta,
                                                           piIdPessJur,  piIdPlanoPrev,    piIdBeneficio,
                                                           1,
                                                           sDataInicioBeneficio, sDataFinalBeneficio,
                                                           '', // Thiago Melo SOL 208274.15065 Kintana 2043014
                                                           OraNumero(sVlrBCDeficit),
                                                           ' Último ',  bErro,  sMsgErro, iIdCalculoGeral);
              sVlrBCDeficit :=  FloatToStr(rVlrBCDeficit);
         end;
      end;
   end;
   result := true;

end;

{------------------------------------------------------------------------------}
{ Centralizador de inserções no histórico de beneficios                        }
Function InsereHstBenefBfciario ( QryAux : TwwQuery;

                                  piSeqBeneficio,   piNumeroProcesso, piIdBeneficio,
                                  piIdPessJur,      piIdPlanoPrev,    piIdTitular,
                                  piSeqProposta,    piIdPessoa,       piIdRegraCalculo,
                                  piIdMotivo,       piCodPortForma : LongInt;


                                  psAnoMesReferencia, psAnoMesCobranca,
                                  psMatricula,        psInscricaoNumero,
                                  psDescLote  : String;

                                  pdValorPrev,      pdValorCalculado, pdValorIntegral,
                                  pdValorPago  : Double;

                                  piFlgEnviado,     piFlgConcessao,   piFlgDevolucao : Word;

                                  var piIdLote  : LongInt;

                                  var sMsgErro     : String;
                                  psDataPagamento  : String;

                                  pdValorTotal     : Double = -1;
                                  pdValorSRB       : Double =  0;
                                  pdPercentual     : Double =  0;

                                  pdValorPrevAntesMinimo  : Double =  0;
                                  pdValorOp1              : Double =  0;
                                  pdValorOp2              : Double =  0;
                                  pdValorOp3              : Double =  0;

                                  piIdTitBenef            : Integer= -1;

                                  psAnoMesAtual    : String = '';

                                  piTipoMov : Integer= -1;
                                  pSMesCompReem    : String = '';
                                  bEhAdiantamentoAbono : Boolean = False;
                                  prValorFAB           : string = '';        // edilaine - SOL 253577-17464 / PPM 955703
                                  prValorBS            : string = '';        // edilaine - SOL 253577-17464 / PPM 955703
                                  prValorDeficit       : string = '';        // edilaine - SOL 253577-17464 / PPM 955703
                                  piValidaValor : Integer= 0;                // Andre Imakawa - SIG 19600
                                  piPerfilInvestimento : Integer = -1;       // edilaine - SIG55933
                                  psControleDividaBenef : string = 'null';   // edilaine SIG33744
                                  psValorBSTitular : string = '';            // edilaine WO18367
                                  psValorFABTitular : string = ''            // edilaine WO18367
                                ) : Boolean;

Var
  sIdRegraCalculo, sCodPortForma, sValorPago, sIdLote,
  sFontePagadora,  sPlanoOrigem,  sFlagProvisorio,
  sMesCompReem,
  sMes, sMesRef, sAno, sOrigem, //SOL 140042 Kintana 900220
  sSQL, sFlgTipoRegistro : String;
  iMes, iAno: integer; //SOL 140042 Kintana 900220

  sDataRequerimento : String; //Renato Visoni SOL 137663 Kintana 833903

  sVlrBsTotal, sVlrFabTotal, sVlrBCDeficit : string;  // edilaine - SOL 253577-17464 / PPM 955703

  sVlrBSTitular, sVlrFabTitular : string;   //edilaine WO18367

  sPerfilInvestimento : string;    //edilaine - SIG55933

  iPos        : integer;
  sTrataRaise,
  Msg, sResult    : String;

// Thiago Melo SOL 173958  Kintana 1653743 Ini

  function selecionaDataPagamento (Lote : String ) : String;
  var
    QryDtPg : TwwQuery;
  begin
    QryDtPg := TwwQuery.Create(nil);
    QryDtPg.DataBaseName := 'Basedados';

    try
      QryDtPg.Close;
      QryDtPg.Sql.Clear;
      QryDtPg.Sql.Add('SELECT datapagamento FROM CTRLINTERFACE');
      QryDtPg.Sql.Add('WHERE ');
      QryDtPg.Sql.Add('IDLOTE = ' + Lote);
      QryDtPg.Open;

      Result := QryDtPg.FieldByName('datapagamento').AsString;
    finally
      QryDtPg.Close;
      FreeAndNil(QryDtPg);
    end;
  end;
// Thiago Melo SOL 173958  Kintana 1653743 Fim

Begin

  Result       := False;
  sMesCompReem := '';
  sMes         := '';
  sMesRef      := '';

  { Valores zerados não vão ser inseridos no histórico.         }
  { Essa verificação esta inicio da rotina, evitando consultas desnecessárias ao BD. }
  // André Imakawa - SIG 19600
  // Se piValidaValor igual 0, efetua validação do valor pdValorPrev
  if (piValidaValor = 0) then
  begin
    If ( pdValorPrev <= 0 ) Then
    Begin
      Result := True;
      Exit;
    End;
  end;

  try
  {Caso não tenha passado }
  If piSeqBeneficio = -1 Then Begin
    piSeqBeneficio := PegaSeqBeneficio(qryAux,
                                       piIdPessJur,   piIdTitular,
                                       piIdPlanoPrev, piIdPessoa,
                                       piSeqProposta, piNumeroProcesso,
                                       piIdBeneficio, piIdMotivo,
                                       psAnoMesCobranca,
                                       psAnoMesReferencia );
  End;

  except
  end;

  If psAnoMesAtual = '' Then psAnoMesAtual := psAnoMesReferencia;
  If piIdTitBenef <= 0  Then piIdTitBenef  := piIdTitular;

  sFlgTipoRegistro := '0'; { Normal }

  If ( psAnoMesAtual <> '' ) Then Begin

    If ( Pos( '/13', psAnoMesReferencia ) > 0 ) Then Begin

      sFlgTipoRegistro := '1'; { Abono }

      if Copy(psAnoMesCobranca, 1, 4) = Copy(psAnoMesAtual, 1, 4) then        //SOL 253577-18114  PPM 1292515
      begin
        { Nova lógica de pesquisa para verificar se é antecipação de abono : }
        { Caso mês de lançamento seja após PARANANTECIPABONO e antes de MESPAGABONO, é antecipação.      }
        sSQL := 'SELECT PA.MES, PLN.MESPGABONO  FROM PARAMANTECIPABONO PA, PLANPREV PLN '+
                'WHERE PA.MES     <= '+ QuotedStr( psAnoMesAtual ) + ' AND '+
                '  PA.IDPESSJUR   = '+ IntToStr ( piIdPessjur   ) + ' AND '+
                '  PA.IDPLANOPREV = '+ IntToStr ( piIdPlanoPrev ) + ' AND '+
                '  PA.IDBENEFICIO = '+ IntToStr ( piIdBeneficio ) + ' AND '+
                //'  PLN.MESPGABONO > '+ Copy(psAnoMesAtual, 6, 2)  + ' AND '+     psAnoMesCobranca       //SOL 253577-18114  PPM 1292515
                '  PLN.MESPGABONO > '+ Copy(psAnoMesCobranca, 6, 2)  + ' AND '+                           //SOL 253577-18114  PPM 1292515
                '  PA.IDPLANOPREV = PLN.IDPLANOPREV '+
                'ORDER BY PA.MES DESC ';

        If FazQuery( QryAux , sSQL ) Then Begin
          sFlgTipoRegistro := '2'; { Antecipação de abono }
        End;
      end;

    End;

    { Caso seja Revisão usar outros tipos, 3 - Revisão Normal, 4 - Abono revisão, 5 - Adiantamento de abono revisão }
    If piTipoMov = 13 Then sFlgTipoRegistro := IntToStr( StrToInt(sFlgTipoRegistro) + 3 );

  End;

  {Caso não tenha passado o VALORTOTAL usa o VALORINTEGRAL }
  If pdValorTotal = -1 Then pdValorTotal := pdValorIntegral;

  // edilaine - SOL 253577-17464 / PPM 955703
  { Os valores a serem inseridos de BS e FAB tem suas origens no calculo de beneficio a pagar tanto do mes, como retroativo, abono, primeiro e ultimo pagamento.
  }
  qryAux.Close;
  qryAux.SQL.Clear;

  qryAux.SQL.Add(' SELECT BFC.FLGPROVISORIO, BFC.IDPLANOORIGEM,  '+
                 '        BFC.FONTEPAGADORA, BFT.PERCENTUAL,     '+
                 '        BFC.VLRBSTOTAL,    BFC.VLRFABTOTAL, BFC.VLRBASEDEFICIT, '+     // edilaine - SOL 253577-17464 / PPM 955703
                 '        BP.FLGAPRESENTABSFAB, BP.FLGAPRESENTADEFICIT            '+     // william moreira - SOL 268820 / PPM 1271204
                 ' FROM BENEFBFCIARIO BFC, BFCIARIOTITPLAN BFT, BENEFPLANPREV BP  '+     // william moreira - SOL 268820 / PPM 1271204
                 ' WHERE (BFC.IDPESSJUR      ='+ IntToStr(piIdPessJur)      +')'+
                 '   AND (BFC.IDPLANOPREV    ='+ IntToStr(piIdPlanoPrev)    +')'+
                 '   AND (BFC.IDTITULAR      ='+ IntToStr(piIdTitular)      +')'+
                 '   AND (BFC.SEQPROPOSTA    ='+ IntToStr(piSeqProposta)    +')'+
                 '   AND (BFC.IDPESSOA       ='+ IntToStr(piIdPessoa)       +')'+
                 '   AND (BFC.IDBENEFICIO    ='+ IntToStr(piIdBeneficio)    +')'+
                 '   AND (BFC.NUMEROPROCESSO ='+ IntToStr(piNumeroProcesso) +')'+

                 '   AND (BFC.IDPLANOPREV    = BP.IDPLANOPREV) '+      // william moreira - SOL 268820 / PPM 1271204
                 '   AND (BFC.IDBENEFICIO    = BP.IDBENEFICIO) '+      // william moreira - SOL 268820 / PPM 1271204

                 '   AND (BFC.IDPESSJUR      = BFT.IDPESSJUR)   '+
                 '   AND (BFC.IDPLANOPREV    = BFT.IDPLANOPREV) '+
                 '   AND (BFC.IDTITULAR      = BFT.IDTITULAR)   '+
                 '   AND (BFC.SEQPROPOSTA    = BFT.SEQPROPOSTA) '+
                 '   AND (BFC.IDPESSOA       = BFT.IDPESSOA)    '+
                 '   AND (BFC.IDBENEFICIO    = BFT.IDBENEFICIO) ');
  qryAux.Open;

  if qryAux.FieldByName('FONTEPAGADORA').AsString <> '' then
    sFontePagadora  := QuotedStr(qryAux.FieldByName('FONTEPAGADORA').AsString)
  else
    sFontePagadora  := 'NULL';

  sFlagProvisorio := IntToStr(qryAux.FieldByName('FLGPROVISORIO').AsInteger);

  If pdPercentual = 0 Then pdPercentual := QryAux.FieldByName('PERCENTUAL').AsFloat;


  // william moreira - SOL 268820 / PPM 1271204 - inicio
  sVlrBSTotal   := 'NULL';
  sVlrFABTotal  := 'NULL';
  sVlrBCDeficit := 'NULL';

  sVlrBSTitular  := 'NULL';    //edilaine WO18367
  sVlrFabTitular := 'NULL';    //edilaine WO18367

  if qryAux.FieldByName('FLGAPRESENTABSFAB').AsString = '1' then
  begin
    sVlrBSTotal   := iff( Trim(prValorBS)      = '', 'NULL',  OraNumero(prValorBS) );            // edilaine - SOL 253577-17514 / PPM 971383
    sVlrFABTotal  := iff( Trim(prValorFAB)     = '', 'NULL',  OraNumero(prValorFAB) );           // edilaine - SOL 253577-17514 / PPM 971383

    // edilaine WO18367 : inicio
    sVlrBSTitular  := iff( Trim(psValorBsTitular)   = '', 'NULL',  OraNumero(psValorBsTitular) );
    sVlrFabTitular := iff( Trim(psValorFabTitular)  = '', 'NULL',  OraNumero(psValorFabTitular) );
    // edilaine WO18367 : fim
  end;

  if qryAux.FieldByName('FLGAPRESENTADEFICIT').AsString = '1' then
  sVlrBCDeficit := iff( Trim(prValorDeficit) = '', 'NULL',  OraNumero(prValorDeficit) );
  // william moreira - SOL 268820 / PPM 1271204 - fim
  // edilaine - SOL 253577-17464 / PPM 955703

  // edilaine - SIG55933 - inicio
  if piPerfilInvestimento <= 0 then
     sPerfilInvestimento := ' NULL '
  else
     sPerfilInvestimento := IntToStr(piPerfilInvestimento);
  // edilaine - SIG55933 - fim

  if piIdRegraCalculo <= 0
  then sIdRegraCalculo := ' NULL '
  else sIdRegraCalculo := IntToStr(piIdRegraCalculo);

  if piIdLote <= 0
  then sIdLote := 'NULL'
  else sIdLote := IntToStr(piIdLote);

  if picodportforma > 0 Then
    scodportforma:=inttostr(picodportforma)
  else
    scodportforma:='NULL';

  if Trim(psDataPagamento) = '' then psDataPagamento := FormatDateTime('dd/mm/yyyy', date);

  if pdValorPago <= 0 Then
    sValorPago := ' NULL '
  else
    sValorPago := OraNumero(FloatToStr(pdValorPago));

  if not qryAux.IsEmpty then sPlanoOrigem := qryAux.FieldByName('IDPLANOORIGEM').AsString;

  // Thiago Melo SOL 173958  Kintana 1653743 Ini

{   psDataPagamento := CriticaDataCobrancaSit( QryAux, IntToStr(iIdFundacao),
                                             '', 'AS', 'P',
                                             Copy(psAnoMesReferencia,6,2),
                                             Copy(psAnoMesReferencia,1,4) );}

  psDataPagamento := selecionaDataPagamento(sIdLote);

  // Thiago Melo SOL 173958  Kintana 1653743 Fim

  //SOL 140042 Kintana 900220

  //Darivaldo Alencar SIG51392 -inicio
  //if (StrToint(StringREplace(sFontePagadora,'''','',[rfReplaceall])) = 2) and
  if (StrToint(StringREplace(iif(sFontePagadora = 'NULL','0',sFontePagadora),'''','',[rfReplaceall])) = 2) and
  //Darivaldo Alencar SIG51392 -fim

     //BRUNO AZEVEDO SOL 131703-4861 KINTANA 1277622 - NÃO GRAVAR CAMPO MESREEMB QUANDO FORA DO CONVENIO.
     (piFlgEnviado <> 8) then // beneficio de fonte pagadora 2 inss
  begin
    sOrigem       :=  copy(pSMesCompReem,1,1);
    if sOrigem = 'C' then
       pSMesCompReem := copy(pSMesCompReem,2,length(pSMesCompReem));

    if sOrigem = 'U' then
    begin
       sMes := copy(psAnoMesReferencia, length(psAnoMesReferencia) - 1, length(psAnoMesReferencia));
       sAno := copy(psAnoMesReferencia, 1, 4);

       if strtoint(sMes) = 13 then
       begin
           sMes          := inttostr(strtoint(sMes) - 2);
           SMesCompReem  := sAno+'/'+sMes;
       end
       else
          sMesCompReem   := psAnoMesReferencia;
       pSMesCompReem := sMesCompReem;  //SIG126787 Ferrari
    end
    else
    if sOrigem = 'C' then
    begin  // tratamento ja feito na tela do calculo retroativo 'C' Checado 'U' não checado
       //Quando o mês de pagamento for igual ao mês de referência, o mês de competência do reembolso do INSS será igual ao mês de referência.
       if trim(psAnoMesCobranca) = trim(psAnoMesReferencia)   then
       begin
          sMes := copy(psAnoMesReferencia, length(psAnoMesReferencia) - 1, length(psAnoMesReferencia));
          sAno := copy(psAnoMesReferencia, 1, 4);

          if strtoint(sMes) = 13 then
          begin
             sMes          := inttostr(strtoint(sMes) - 2);
             SMesCompReem  := sAno+'/'+sMes;
          end
          else
              sMesCompReem   := psAnoMesReferencia;
       end
       else   //Quando o mês de pagamento for diferente do mês de referência, o mês de competência do reembolso do INSS será igual ao parametro informado na tela.
       begin
          SMesCompReem :=  pSMesCompReem;
       end;
       pSMesCompReem := sMesCompReem;  //SIG126787 Ferrari
    end
    else
    begin
       if  trim(psAnoMesCobranca) <> trim(psAnoMesReferencia)   then
       begin
           // Quando o mês de pagamento for diferente do mês de referência, o mês de competência do reembolso do INSS será igual ao mês de referência - 1 mês.
           sMes    := copy(psAnoMesCobranca, length(psAnoMesCobranca) - 1, length(psAnoMesCobranca));
           sMesRef := copy(psAnoMesReferencia, length(psAnoMesReferencia) - 1, length(psAnoMesReferencia));
           sAno    := copy(psAnoMesCobranca, 1, 4);
           if sMesRef = '13' then
           begin
              if (sAno = copy(psAnoMesReferencia, 1, 4)) and ((strtoint(sMes) = 8) or (strtoint(sMes) = 11)) then // SOL 140042/6321 Kintana 1407997
                 sMesCompReem   := psAnoMesCobranca
              else
              if strtoint(sMes) > 1 then
              begin
                 sMes := inttostr(strtoint(sMes) - 1);
                 if length(sMes) = 1 then
                    sMes := '0'+sMes;
              end
              else
              begin
                 sAno := inttostr(strtoint(sAno) - 1);
                 sMes := '12';
              end;
           end
           else
           if strtoint(sMes) > 1 then
           begin
              sMes := inttostr(strtoint(sMes) - 1);
              if length(sMes) = 1 then
                 sMes := '0'+sMes;
           end
           else
           begin
              sAno := inttostr(strtoint(sAno) - 1);
              sMes := '12';
           end;
           sMesCompReem   := sAno+'/'+sMes;
       end
       else
          sMesCompReem   := psAnoMesCobranca;
    end;
  end //SOL 140042 Kintana 900220
  else
     pSMesCompReem := '';  //edilaine - SIG127800

  QryAux.Close;
  QryAux.Sql.Clear;
  QryAux.Sql.Add(' INSERT INTO HSTBENEFBFCIARIO ' + { Estou na InsereHstBenefBfciario }
                 '       (IDPESSJUR,      IDTITULAR,      IDPESSOA,       '+
                 '        IDPLANOPREV,    IDPLANOORIGEM,  SEQPROPOSTA,    IDMOTIVO,       '+
                 '        NUMEROPROCESSO, IDBENEFICIO,    MES,            '+
                 '        MESREFERENCIA,  SEQBENEFICIO,   VALORPREV,  VALORSRB, '+
                 '        VALORCALCULADO, VALORINTEGRAL,  VALORTOTAL, IDREGRACALCULO, '+
                 '        IDLOTE,         FLGENVIADO,     FLGCONCESSAO,   '+
                 '        FLGDEVOLUCAO,   CODPORTFORMA,   VLBENEFPGTO,    '+
                 '        DATAPAGAMENTO,  FLGPROVISORIO,  VALORACERTO,    '+
                 '        PERCENTUAL,                                     '+
                 '        VALORPREVMIN,   VALOROP1,       VALOROP2,       '+
                 '        VALOROP3,       IDTITBENEF,       '+
                 '        FONTEPAGADORA,  FLGTIPOREGISTRO, MESCOMPREEM ,LOTEORIGINAL, '+
                 '        IDPERFILINVEST, '+                              // edilaine - SIG55933
                 '        IDCONTROLEDIVIDABENEFICIO, '+                   // edilaine SIG33744
                 '        BSTITULAR, FABTITULAR, '+                       // edilaine WO18367
