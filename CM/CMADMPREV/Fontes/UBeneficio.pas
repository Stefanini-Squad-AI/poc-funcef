function GeraMatricula(QryLocal : TwwQuery;
                       piIdCalculo : Integer): String;
Var
  sMatriculaAtual, sProxMat, sSQL, sDv : String;
  bErro : Boolean;
begin

  sSQL := 'SELECT ULTMATRICULA, (ULTMATRICULA+1) AS PROXMAT FROM PARAMAPREV';
  FazQuery(QryLocal,sSQL);
  sMatriculaAtual := QryLocal.FieldbyName('ULTMATRICULA').AsString;
  sProxMat := QryLocal.FieldbyName('PROXMAT').AsString;

  sProxMat := StringOfChar('0',(StrToInt(prmMASCMATPENS)-Length(sProxMat)))+sProxMat;

  While True Do Begin
    ExecutarQuery(QryLocal,'UPDATE PARAMAPREV SET ULTMATRICULA = '+QuotedStr(sProxMat));

    sSQL := 'SELECT IDPESSOA, SUBSTR(MATRICULA,1,'+prmMASCMATPENS+') AS MATRICULA '+
            'FROM DEPENTIT WHERE SUBSTR(MATRICULA,1,'+prmMASCMATPENS+') = '+
            QuotedStr(sProxMat);
    If FazQuery(QryLocal,sSQL) Then Begin
      sProxMat := IntToStr(QryLocal.FieldbyName('MATRICULA').AsInteger+1);
      sProxMat := StringOfChar('0',(StrToInt(prmMASCMATPENS)-Length(sProxMat)))+sProxMat;
    End Else Begin
      Break;
    End;
  End;
  sDv := '';

  if prmIDRGDIGMATPENS > 0 then begin
     sSQL := 'SELECT '+QuotedStr(sProxMat)+' MATRICULA FROM DUAL';

     sDv := RegraNumerica( inttostr(prmIDRGDIGMATPENS), sSQL, bErro, piIdCalculo );
  end;

  Result :=   sProxMat+sDv;
end;


function DesfazRetencaoEncerramentoNOVA ( qryBenefBeneficiario,
                                          qryLogOcorrencia : TwwQuery;
                                          piNUMEROPROCESSO : longint; pidTipoMov : Integer = 0 ): boolean; //  SOL 242331 PPM 570638
var
  iIdLoteMov           : longint;
  iIdPessoaDoMovimento : longint;
  iNumeroProcMovimento : longint;
  iIdMovDesfazer       : longint;
  sDataMovimento       : string;
  sDataFinalAnt        : string;
  sValorAtualAnt       : string;
  sIdSitBenefAnt       : string;
  sFlgDataPrevAnt      : string;
  sValorSRBAnt         : string;
  sUltMesPreparo       : string;
  sSQL                 : string;
  sIniFaixaExclusao    : string;
  sFimFaixaExclusao    : string;
  sMsgErro             : string;
  sUltMesReajuste      : String;
  CtrlDocumento        : TCtrlDocumento; 
  CtrlLancamento       : TCtrlLancamento;
  sIdMovBenefTIPO10, sIdMovBenefDesfeito    : String;   //Robson.andrade - SOL 253577-17489 / PPM 962708
  sMesCobranca, sDtPagto : string;      // edilaine - SIG 20855
begin
  Result := False;

  // ***************************************************************************
  // Tratar beneficiario que foi retido/encerrado
  // Lembrete : quando o encerramento é por falecimento do participante
  //            os acertos ficam com motivo de 'beneficiario não identificado'
  //            e com LOTE NULO
  // ***************************************************************************
  // 1o. Buscar pessoa retida/encerrada
  with qryLogOcorrencia do
  begin
     Close;
     SQL.Clear;
     SQL.Add(' SELECT IDMOVBENEF, IDPLANOPREV, IDTITULAR, NUMEROPROCESSO, SEQPROPOSTA,  DATAMOV,   '+
             '        VALORTOTAL, DATAINICIO,  IDPESSJUR, IDBENEFICIO,    IDPESSOA,     TIPOMOV,   '+
             '        VALORATUAL, VALORCOTAS,  DATAFINAL,DATAINICIOANT,   DATAFINALANT, VALORATUALANT,  '+
             //'        IDSITANTERIOR, FLGDATAPREVANT, IDLOTEMOV, MOTRETENC, FONTEPAGADORA              '+  // edilaine - SIG 20855
             '        IDSITANTERIOR, FLGDATAPREVANT, IDLOTEMOV, MOTRETENC                               '+  // edilaine - SIG 22404
             ' FROM   MOVBENEF                                                                          '+
             ' WHERE  IDMOVBENEF = (SELECT MAX(IDMOVBENEF)                                              '+
             '                      FROM   MOVBENEF                                                     '+
             '                      WHERE  NUMEROPROCESSO  = '+IntToStr(piNumeroProcesso)+
             '                      AND    TIPOMOV         IN (3,4) '+
             '                      AND    IDDESFAZER IS NULL)    ');
     Open;
     if IsEmpty then begin
       result := true;
       Exit;
     end;
     iIdPessoaDoMovimento := FieldByName('IDPESSOA').AsInteger;
     sDataMovimento       := FieldByName('DATAMOV').AsString;
     iIdLoteMov           := FieldByName('IDLOTEMOV').AsInteger;
     iNumeroProcMovimento := FieldByName('NUMEROPROCESSO').AsInteger;
     sIdMovBenefDesfeito  := FIeldByName('IDMOVBENEF').AsString;             //Robson.andrade - SOL 253577-17489 / PPM 962708
  end;

  // 2o. Trazer todos os beneficios do movimento ( pode ter mais de um idmovbenef )
  with qryLogOcorrencia do
  begin
     Close;
     SQL.Clear;
     SQL.Add(' SELECT M.IDMOVBENEF,   M.IDPLANOPREV,    M.IDTITULAR,     M.NUMEROPROCESSO, '+
             '        M.SEQPROPOSTA,  M.DATAMOV,        M.VALORTOTAL,    M.DATAINICIO,     '+
             '        M.IDPESSJUR,    M.IDBENEFICIO,    M.IDPESSOA,      M.TIPOMOV,        '+
             '        M.VALORATUAL,   M.VALORCOTAS,     M.DATAFINAL,     M.DATAINICIOANT,  '+
             '        M.DATAFINALANT, M.VALORATUALANT,  M.IDSITANTERIOR, M.IDDESFAZER,     '+
             '        M.MOTRETENC,    M.FLGDATAPREVANT, M.IDPLANOORIGEM, M.IDLOTEMOV,      '+
             '        M.VALORSRB,     M.VALORSRBANT,    M.FLGVOLTAPATRO, M.USUARIOALT,     '+
             '        P.IDEVENTOGERADOR,                                                   '+
             '        BPP.FLGREFERENCIA,                                                   '+
             '        B.FONTEPAGADORA                                                      '+  // Edilaine - SIG 22404
             ' FROM   MOVBENEF M, PROCESSOBENEF P, BENEFPLANPREV BPP,                      '+
             '        BENEFBFCIARIO B                                                      '+  // Edilaine - SIG 22404
             ' WHERE  M.IDPESSOA  = '+IntToStr(iIdPessoaDoMovimento)                        +
             ' AND    M.DATAMOV   = TO_DATE('''+sDataMovimento+''',''DD/MM/YYYY'')         ');


     if pidTipoMov > 0   //  SOL 242331 PPM 570638
     then SQL.Add(' AND    M.TIPOMOV = '+IntToStr(pidTipoMov)  )  //  SOL 242331 PPM 570638
     else
       SQL.Add(' AND    M.TIPOMOV   IN (3,4)                                               '); //  SOL 242331 PPM 570638

     SQL.Add(' AND    M.IDDESFAZER IS NULL                                                 '+
             ' AND    M.IDPLANOPREV = BPP.IDPLANOPREV                                      '+
             ' AND    M.IDBENEFICIO = BPP.IDBENEFICIO                                      '+
             ' AND    P.NUMEROPROCESSO = M.NUMEROPROCESSO                                  '+
             ' AND    B.IDPESSJUR      = M.IDPESSJUR                                       '+   // Edilaine - SIG 22404  - inicio
             ' AND    B.IDPLANOPREV    = M.IDPLANOPREV                                     '+
             ' AND    B.IDTITULAR      = M.IDTITULAR                                       '+
             ' AND    B.SEQPROPOSTA    = M.SEQPROPOSTA                                     '+
             ' AND    B.IDPESSOA       = M.IDPESSOA                                        '+
             ' AND    B.IDBENEFICIO    = M.IDBENEFICIO                                     '+
             ' AND    B.NUMEROPROCESSO = M.NUMEROPROCESSO                                  ');  // Edilaine - SIG 22404 - fim

     if iIdLoteMov > 0
     then SQL.Add(' AND    M.IDLOTEMOV = '+IntToStr(iIdLoteMov)                             );
     if piNUMEROPROCESSO > 0 //  SOL 242331 PPM 570638
     then SQL.Add(' AND    M.NUMEROPROCESSO = '+IntToStr(piNUMEROPROCESSO)                             );   //  SOL 242331 PPM 570638

     Open;
  end;

  if qryLogOcorrencia.IsEmpty
  then begin
     Result := True;
     Exit;
  end;

  while not qryLogOcorrencia.Eof do
  begin
     sDataFinalAnt       := qryLogOcorrencia.FieldByName('DATAFINALANT').AsString;
     sValorAtualAnt      := qryLogOcorrencia.FIeldByName('VALORATUALANT').AsString;
     sIdSitBenefAnt      := qryLogOcorrencia.FIeldByName('IDSITANTERIOR').AsString;
     sFlgDataPrevAnt     := qryLogOcorrencia.FIeldByName('FLGDATAPREVANT').AsString;
     sValorSRBAnt        := qryLogOcorrencia.FIeldByName('VALORSRBANT').AsString;

     if Length(sIdSitBenefAnt) = 0 then {Robson.andrade - SOL 253577-17489 / PPM 962708 }
       begin
         MsgDlg('Foram encontradas possíveis inconsistencias na Movimentação de Benefícios. Operação Cancelada!','Erro',mtError,[mbOk],0);
         Exit;
       end;


     sIniFaixaExclusao := Copy(qryLogOcorrencia.FieldByName('DATAFINAL').AsString,7,4)+'/'+Copy(qryLogOcorrencia.FieldByName('DATAFINAL').AsString,4,2);

     sFimFaixaExclusao   := Copy(FormatDateTime('dd/mm/yyyy', date),7,4) + '/' +    
                            Copy(FormatDateTime('dd/mm/yyyy', date),4,2);           


     // edilaine - SIG 20855 - inicio
     if VerificaExistePrevia(iIdLoteMov, IntToStr(piNUMEROPROCESSO), sIniFaixaExclusao, sFimFaixaExclusao)
     then begin
        Exit;
     end;
     // edilaine - SIG 20855 - fim


     // Verificar se o beneficio já foi pago
     sSQL := ' SELECT COUNT(*) AS TOTAL                               '+
             ' FROM   HSTBENEFBFCIARIO                                '+
             ' WHERE  NUMEROPROCESSO  = '+ IntToStr(piNumeroProcesso)   +
             ' AND    IDPESSOA        = '+qryLogOcorrencia.FieldByName('IDPESSOA').AsString+
             ' AND    IDBENEFICIO     = '+qryLogOcorrencia.FieldByName('IDBENEFICIO').AsString+
             ' AND    MESREFERENCIA   >= '''+sIniFaixaExclusao+''''+
             ' AND    FLGCONCESSAO    = 1 ' ;
     if Trim(sFimFaixaExclusao) <> ''
     then sSQL := sSQL + ' AND MESREFERENCIA <= '''+sFimFaixaExclusao+'''';

     sSQL := sSQL + ' AND    VLBENEFPGTO IS NOT NULL                         '+
                    ' AND    VLBENEFPGTO > 0                                 ';

     if iIdLoteMov > 0
     then sSQL := sSQL +' AND IDLOTE = '+IntToStr(iIdLoteMov)
     else sSQL := sSQL +' AND TRGDTINCLUSAO >= TO_DATE('''+qryLogOcorrencia.FieldByName('DATAMOV').AsString+''',''DD/MM/YYYY'') ' ; 

     with dtmAPrev.qryAux do
     begin
        Close;
        SQL.Clear;
        SQL.Add(sSQL);
        Open;
        if (not IsEmpty) and (FieldByName('Total').AsFloat > 0 )
        then begin
           MsgDlg('Benefício já foi pago no período de '+sIniFaixaExclusao+' a '+sFimFaixaExclusao+'.'+#13+
                  'Retenção/Encerramento não pode ser desfeito...','Erro ',mtError,[mbOk],0);
           Exit;
        end;
     end;

     // Apagar lançamentos que a retencao/encerramento tenha feito na TMPDESC
     // edilaine - SIG 20855 - inicio
     {sSQL :=  ' DELETE FROM TMPDESC    '+
              ' WHERE  IDPESSOA       = '+qryLogOcorrencia.FieldByName('IDPESSOA').AsString+
              ' AND    FLGDESCFOLHA   = ''B'' '+
              ' AND    FLGTIPODESC    = ''P'' '+
              ' AND    MESREFERENCIA  >= '''+sIniFaixaExclusao+'''';

     if Trim(sFimFaixaExclusao) <> ''
     then sSQL := sSQL + ' AND MESREFERENCIA <= '''+sFimFaixaExclusao+''' ';

     if iIdLoteMov > 0
     then sSQL := sSQL + ' AND IDLOTE = '+IntToStr(iIdLoteMov)
     else sSQL := sSQL + ' AND TRGDTINCLUSAO >= TO_DATE('''+qryLogOcorrencia.FieldByName('DATAMOV').AsString+''',''DD/MM/YYYY'') ';

     with dtmAPrev.qryaux do
     begin
        Close;
        SQL.Clear;
        SQL.Add(sSQL);
        try
           ExecSQL;
        except
           on E:EDBEngineError do
           begin
             MostrarErro(E);
             Exit;
           end;
        end;
     end;
     } // edilaine - SIG 20855 - fim

     // Apagar lançamentos que a retencao/encerramento tenha feito na HSTBENEFBFCIARIO
     sSQL := ' DELETE FROM HSTBENEFBFCIARIO    '+
             ' WHERE  NUMEROPROCESSO = '+ IntToStr(piNumeroProcesso)+
             ' AND    IDPESSOA       = '+ qryLogOcorrencia.FieldByName('IDPESSOA').AsString+
             ' AND    IDBENEFICIO    = '+ qryLogOcorrencia.FieldByName('IDBENEFICIO').AsString +
             ' AND    MES   >= '''+sIniFaixaExclusao+''''+
             ' AND    FLGCONCESSAO    = 1 ' +
             ' AND ((MESREFERENCIA <= '''+sFimFaixaExclusao+''') OR '+
