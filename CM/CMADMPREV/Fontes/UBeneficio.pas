                                                         False, pbMigracaoPlano
                                                         , PerfilAtual.iIdPlanPrevContab //leandro wo3084
                                                         );

    //edilaine - SIG89790 - inicio
    if (bApresentaBSFAB) and ((dValorBSNoMes + dValorFABNoMes) <> dValorBeneficioNoMes) then
    begin
      dValorBeneficioNoMes :=  dValorBSNoMes + dValorFABNoMes;
    end;
    //edilaine - SIG89790 - fim

    sValorFinal   := FloatToStr(dValorBeneficioNoMes);
    sValorInteiro := FloatToStr(dValorBeneficioIntegral);

    //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - INÍCIO
    //COMENTEI A PARTE DE CIMA IMPLEMENTADA PELA EDILAINE E CRIEI AS NOVAS VALIDAÇÕES
    // edilaine - SOL 253577-17514 / PPM 971383 - inicio
    {if dValorBSNoMes > 0 then
       rVlrBSTotal  := FloatToStr(dValorBSNoMes);

    if dValorFABNoMes > 0 then
       rVlrFABTotal  := FloatToStr(dValorFABNoMes);

    if dValorDeficitNoMes > 0 then
       rVlrBCDeficit  := FloatToStr(dValorDeficitNoMes);}
    // edilaine - SOL 253577-17514 / PPM 971383 - fim
    // Andre Imakawa - SIG 60869 - Inicio
     // william moreira - SOL 268820 / PPM 1271204 - inicio
    //if ((rVlrBSTotal {=} <> '') {or} and (dValorBSNoMes > StrToFloat(rVlrBSTotal))) then
    //   rVlrBSTotal  := FloatToStr(dValorBSNoMes);
    if ((rVlrBSTotal {=} <> '') {or} and (dValorBSIntegral > StrToFloat(rVlrBSTotal))) then
      rVlrBSTotal  := FloatToStr(dValorBSIntegral);

    //if ((rVlrFABTotal {=} <> '') {or} and (dValorFABNoMes > StrToFloat(rVlrFABTotal))) then
    //   rVlrFABTotal  := FloatToStr(dValorFABNoMes);
    if ((rVlrFABTotal {=} <> '') {or} and (dValorFABIntegral > StrToFloat(rVlrFABTotal))) then
       rVlrFABTotal  := FloatToStr(dValorFABIntegral);

    //if ((rVlrBCDeficit {=} <> '') {or} and (dValorDeficitNoMes > StrToFloat(rVlrBCDeficit))) then
    //   rVlrBCDeficit  := FloatToStr(dValorDeficitNoMes);
    if ((rVlrBCDeficit {=} <> '') {or} and (dValorDeficitIntegral > StrToFloat(rVlrBCDeficit))) then
      rVlrBCDeficit  := FloatToStr(dValorDeficitIntegral);
    // Andre Imakawa - SIG 60869 - Fim
    //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - FIM

    if (rVlrBSTotal <> '') and (dValorBSRateado > StrtoFloat(rValorBSRateado)) then
       rValorBSRateado  := FloatToStr(dValorBSRateado);

    if (rVlrFABTotal <> '') and (dValorFABRateado > StrtoFloat(rValorFABRateado)) then
       rValorFABRateado := FloatToStr(dValorFABRateado);
    // william moreira - SOL 268820 / PPM 1271204 - fim


    { Neste ponto a variavel dValorBeneficioIntegral está com o valor total    }
    { reajustado ( sem ratear por dias e sem ratear por beneficiarios )        }

    prValorAtualizadoRateado := dValorBenefRateado;
    prValorAtualizadoTotal   := dValorBeneficioIntegral;

    { Tratamento de Quitação Automática }
    dValorQuitado := 0;
    if ( iIdRegraQuitAnt > 0 ) then
    begin
      dValorQuitado := ExecutaRegraQuitacaoAutomatica ( qryAux,
                                                        iIdRegraQuitAnt,
                                                        piIdPessJur,
                                                        piIdPlanoPrev,
                                                        piIdTitular,
                                                        piSeqProposta,
                                                        piIdBeneficiario,
                                                        piIdBeneficio,
                                                        piNumeroProcesso,
                                                        piTotBeneficiarios,
                                                        sDataFolha,
                                                        bErro,
                                                        sMsgErro,
                                                        iIdCalculoGeral);
      if dValorQuitado > 0 then
      begin

        sValorFinal          := FloatToStr(dValorQuitado);
        dValorBeneficioNoMes := dValorQuitado;
        sMesFinal            := sMesAtual;
        sDataQuitacao        := IntToStr(TrazUltDiaMes(StrToInt(Copy(sMesAtual,6,2)), StrToInt(Copy(sMesAtual,1,4))));
        if StrToInt(sDataQuitacao) <= 9
        then sDataQuitacao   := '0'+sDataQuitacao;
        sDataQuitacao        := sDataQuitacao +'/'+Copy(sMesAtual,6,2)+'/'+Copy(sMesAtual,1,4);

        If FazQuery(qryAux, 'SELECT PAP.IDMOTIVOQUITANT FROM PARAMAPREV PAP ') Then
        Begin
          if (qryAux.FieldByName('IDMOTIVOQUITANT').AsInteger = 0) or
             (qryAux.FieldByName('IDMOTIVOQUITANT').IsNull)        Then
          Begin
            bErro    := True;
            sMsgErro := 'É obrigatório a escolha do motivo de quitação automática de benefícios. ';
            Exit;
          End
          Else
            piIdMotivo := qryAux.FieldByName('IDMOTIVOQUITANT').AsInteger;
        End;

      end;

    end;


    { Se ainda nao gravou o lote do registro, gravar }
    If ( Not bJaGravouLote ) Then
    Begin

      sSQL := 'INSERT INTO CTRLINTERFACE ' +
              ' (MESREFERENCIA,     TIPO,             IDPESSOA,         '+
              '  FLGIDATMP,         FLGVOLTATMP,      FLGIDAINTERFACE,  '+
              '  FLGVOLTAINTERFACE, DATAIDATMP,       DATAVOLTATMP,     '+
              '  DATAIDAINTERFACE,  DATAVOLTAINTERFA, IDLOTE,           '+
              '  NUMREG,           VLRTOTAL,         '+
              '  FLGEMITIUCC,       DATAEMITIUCC,     FLGPREPARADO,     '+
              '  DESCRICAO,         DATAPREPARO)  '+
              ' VALUES (' +
              '''' + sMesFinal + ''', ''B'', '+IntToStr(piIdPessJur)+ ',' +
              '  0, 0, 0, 0, NULL , NULL, NULL, NULL, '+
              IntToStr(iIdLote)+ ', 1, ' + OraNumero(sValorFinal) + ',' +
              '  NULL, NULL, 1, ''' + sDescPreparo + ''',' +
              ' TO_DATE(''' + DateTimeToStr(Date) + ''',''DD/MM/YYYY''))';

      If ( Not ExecutarQuery(QryAux, sSQL) ) Then
      Begin
         bErro := True;
         sMsgErro := 'Erro na "Geração do Lote" para o preparo do benefício concedido. ';
         Exit;
      End;
      
      bJaGravouLote   := True;
      bPrimeiroDoLote := True;

    End;

    if (piIdTitular = piIdBeneficiario)
    then dValorTotal := StrToFloat(ClienteNumero(sValorInteiro));

    sFlgDevolucao        := '0';

    { Caso Liberação, excluir preparo existente }
    If ( piTipoMov = 12 ) Then Begin

      sSQL := ' DELETE '+
              ' FROM   HSTBENEFBFCIARIO HBF'+
              ' WHERE  (HBF.IDPESSOA       = '+IntToStr ( piIdBeneficiario ) +')'+
              ' AND    (HBF.MESREFERENCIA  = '+QuotedStr( sMesAtual )        +')'+
              ' AND    (HBF.MES            = '+QuotedStr( sAnoMesLote )      +')'+
              ' AND    (HBF.IDBENEFICIO    = '+IntToStr ( piIdBeneficio )    +')'+
              ' AND    (HBF.NUMEROPROCESSO = '+IntToStr ( piNumeroProcesso ) +')'+
              ' AND    (HBF.VLBENEFPGTO <= 0 OR HBF.VLBENEFPGTO IS NULL) ' ;
      ExecutarQuery(QryAux, sSQL);

    End;

    { Verificar se o historico de benefício já existe no mês }
    with qryAux do
    begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT SUM( DECODE( HBF.FLGDEVOLUCAO, 1, HBF.VALORPREV*-1, HBF.VALORPREV ) ) AS VALORPREV '+
              'FROM HSTBENEFBFCIARIO HBF '+
              'WHERE (HBF.IDPESSOA       = '+IntToStr(piIdBeneficiario) +') '+
              ' AND  (HBF.MESREFERENCIA  = '''+sMesAtual             +''') '+
              ' AND  (HBF.IDBENEFICIO    = '+IntToStr(piIdBeneficio) +'  ) '+
              ' AND  (HBF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+') ');
      Open;

      if (FieldByName('VALORPREV').AsFloat > 0) and (piTipoMov > 2)
         { Na migração INSS apenas gera HST demonstrativo }
         or ( (pbMigracaoPlano) and (sFlgReferencia <> '1') )
      then begin
         sValorFinal := FloatToStr( StrToFloat(ClienteNumero(sValorFinal)) - FieldByName('VALORPREV').AsFloat);

         if Abs(StrToFloat(ClienteNumero(sValorFinal))) < 0.01
         then begin
            sValorFinal := '0';
         end
         else begin
            if StrToFloat(ClienteNumero(sValorFinal)) < 0.01
            then begin
               sFlgDevolucao := '1';
               sValorFinal   := FloatToStr(-StrToFloat(ClienteNumero(sValorFinal)));
            end
            else sFlgDevolucao := '0';
         end;

      end;
    end;

    If ( StrToFloat(ClienteNumero(sValorFinal)) > 0 ) then
    begin

      iSeqBeneficio := PegaSeqBeneficio(qryAux,
                                        piIdPessJur,   piIdTitular,
                                        piIdPlanoPrev, piIdBeneficiario,
                                        piSeqProposta, piNumeroProcesso,
                                        piIdBeneficio, piIdMotivo,
                                        sAnoMesLote,   sMesAtual);

      if piIdRegraCalculo > 0
      then sIdRegraCalculo := IntToStr(piIdRegraCalculo)
      else sIdRegraCalculo := ' NULL ';

      sDataFolha := CriticaDataCobrancaSit(qryAux,IntToStr(iIdFundacao),'', 'AS', 'P',
                                           Copy(sMesAtual,6,2),
                                           Copy(sMesAtual,1,4) );
      if Trim(sDataFolha) = ''
      then begin
        bErro := True;
        sMsgErro := 'Calendário Não Encontrado. Operação Interrompida.';
        Exit;
      end;

      If piIdTitular = piIdBeneficiario
      Then dValorBeneficioIntegralAposMinimo := dValorBeneficioIntegral
      Else dValorBeneficioIntegralAposMinimo := dValorBenefRateado;

      { Caso seja concessão, beneficio do INSS e a fundação pague o beneficio.   }
      { Então entre a DIB e a DIP preparar com FLGENVADO 8 (não pagar)           }
      If ( sFlgReferencia = '1' ) And ( iFlgPagaINSSBP = 1 ) And ( piTipoMov = 7 ) And 
         ( ( sMesAtual < sAnoMesDIP ) Or ( iFlgPagaINSSBF = 0 ) )
      Then iFlgEnviado := 8
      Else iFlgEnviado := 0;

      //BRUNO AZEVEDO SOL 179253 KINTANA 1649151
      bInsere := True;
      if (sFontePagadora = '1') then begin
        if (sMesAtual < sAnoMesDIP) then begin
          bInsere := False;
        end;
      end;

      //MARCELO ALMEIDA - SOL 63067 - KTN 524520
      if (bResgateParcelado) then
      begin
            sValorFinal := FloatToStr(StrToFloat(sValorFinal) / bQtdeParcelas);

      end;

      //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - INÍCIO
      sValorBSNoMes := iif(rVlrBSTotal = '', '', FloatToStr(dValorBSNoMes));
      sValorFABNoMes := iif(rVlrFABTotal = '', '', FloatToStr(dValorFABNoMes));
      sValorDeficitNoMes := iif(rVlrBCDeficit = '', '', FloatToStr(dValorDeficitNoMes));
      //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - FIM

      if (bInsere) then begin
        If not InsereHstBenefBfciario( QryAux,
                                       iSeqBeneficio,
                                       piNumeroProcesso, piIdBeneficio,
                                       piIdPessJur,      piIdPlanoPrev,
                                       piIdTitular,      piSeqProposta,
                                       piIdBeneficiario,
                                       piIdRegraCalculo,
                                       piIdMotivo,       piCodPortForma,
                                       sMesAtual,        sAnoMesLote,
                                       '',
                                       '',
                                       '',
                                       StrToFloat( sValorFinal ),
                                       StrToFloat( sValorFinal ),
                                       dValorBeneficioIntegralAposMinimo,

                                       0,
                                       iFlgEnviado,
                                       1,

                                       StrToInt( sFlgDevolucao ),
                                       iIdLote,
                                       sMsgErro,
                                       sDataPagamento,
                                       StrToFloat( sValorInteiro ),
                                       dValorSRB,
                                       0,
                                       dValorPrevAntesMinimo,

                                       rValorBase1,
                                       rValorBase2,
                                       rValorBase3,

                                       iIdTitBenef,
                                       sMesAtual,
                                       piTipoMov
                                       ,''
                                       , false
                                       //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - INÍCIO
                                       ,sValorFABNoMes//,rVlrFABTotal     // edilaine - SOL 253577-17464 / PPM 955703  - SOL 253577-17541 / PPM 978024
                                       ,sValorBSNoMes//,rVlrBSTotal      // edilaine - SOL 253577-17464 / PPM 955703
                                       ,sValorDeficitNoMes//,rVlrBCDeficit    // edilaine - SOL 253577-17464 / PPM 955703
                                       //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - FIM
                                       ,0 ,piIdPerfilInvest,              //edilaine - SIG55933
                                       'null' ,rValorBsTitMes             //edilaine WO18367
                                       ,rValorFabTitMes                   //edilaine WO18367
                                        )
        Then Begin
          bErro := True;
          sMsgErro := 'Erro na gravação do benefício concedido no histórico. ';
          Exit;
        End;
      end;
      //BRUNO AZEVEDO SOL 179253 KINTANA 1649151
      
      If ( Not bPrimeiroDoLote )
      Then rValorTotalLote := rValorTotalLote + StrToFloat( ClienteNumero( sValorFinal ) )
      Else bPrimeiroDoLote := False;

    End;

    {-----------------------------------------------------------------------------------}
    { Testar condições para pagamento do abono anual de benefício                       }
    {-----------------------------------------------------------------------------------}
    { Se benefício é parametrizado para pagar abono E                                   }
    { [ ( o mês que está sendo calculado neste momento é o mes 12 ) ou                  }
    {   ( Abono é no final do Ano e Estou no mes 12 ) ou                                }
    {   ( Abono é no final do Beneficio e estou no ultimo mes do benefico) ] ou         }
    {   ( Abono é no final do Ano mas o beneficio comecou e acabou no ano anterior ) ou }
    { Entao calcular abono e inserí-lo no historico de beneficio                        }

    If ( bPossuiAbono ) Then
    Begin
      { Verifica se existe o cadastro de mês de pagamento do abono casoexista, }
      { assume-se este mês caso não, asusme-se como o mês 12                   }
      sMesAbono := PagaMesPagAbono( QryAux,
                                    piIdPessjur, piIdPlanoPrev, piIdBeneficio,
                                    sMesAtual,
                                    bEhAntecipacao );

      if sAnoMesDataInicio > copy(sMesAtual,1,5)+sMesAbono then
      sMesAbono :=  copy(sAnoMesDataInicio,6,2);

      if Trim(psDataFinal) = '' then
      begin
        if Copy(sMesAtual,6,2) = sMesAbono
        then bPagaAbono := True
        else bPagaAbono := False;
      end
      else
      begin
        if (sAnoMesDataFinal <= sAnoMesLote) and (sMesAtual = sMesFinal) and
           (Copy(sAnoMesLote,6,2) = sMesAbono) And
           (sMesFinal = Copy(psDataFinal,7,4)+'/'+Copy(psDataFinal,4,2))

           { Cprev Augusto 21/11/2007                                       }
           { Testar se a data é prevista antes de permitir calcular o abono }
           And ( piFlgDataPrevista <> 1 )

        then bPagaAbono := True
        else begin
          if piFlgDataPrevista = 1 // Data Prevista
          then begin
            if (Copy(sMesAtual,1,4) < Copy(sAnoMesDataFinal,1,4)) and (Copy(sMesAtual,6,2) = sMesAbono)
            then bPagaAbono := True
            else if (StrToDate(psDataFinal) >= StrToDate('30/'+sMesAbono+'/'+Copy(sMesAtual,1,4))) and
                    (Copy(sMesAtual,6,2) = sMesAbono)
            then bPagaAbono := True
            else bPagaAbono := False
          end
          else // Data Efetiva
          begin
            if (Copy(sMesAtual,1,4) < Copy(sAnoMesDataFinal,1,4)) and (Copy(sMesAtual,6,2) = sMesAbono)
            then bPagaAbono := True
            else begin
              if (Copy(sAnoMesDataFinal,1,4) < Copy(sMesAtual,1,4)) and (Copy(sMesAtual,6,2) = sMesAbono)
              then bPagaAbono := True
              else begin
                if (cTipoAbono = 'B') and (sMesAtual = sAnoMesDataFinal)
                then bPagaAbono := True
                else
                  if Copy(sMesAtual,6,2) = sMesAbono
                  then bPagaAbono := True
                  else bPagaAbono := False;
              end;
            end
          end;
        end;
      end;

    End;


    //Caso esteja no último mês do processo então 
    //verificar se deve ou não pagar o adiantamento de abono.                 

    bEhAdiantamentoAbono := False;

    If (sMesAtual = sMesFinal) Then
    Begin

      If ( ( bPagaAbono = True ) And ( bEhAntecipacao = True ) ) Then
      Begin

        If FazQuery( QryAux, 'SELECT IDREGRA, PERCENTUAL FROM PARAMANTECIPABONO '+
                             'WHERE IDPESSJUR   = '+ IntToStr( piIdPessjur    ) +' AND '+
                             '      IDPLANOPREV = '+ IntToStr( piIdPlanoPrev  ) +' AND '+
                             '      IDBENEFICIO = '+ IntToStr( piIdBeneficio  ) +' AND '+
                             '      SUBSTR(MES,1,4) = '+ QuotedStr( Copy( sMesAtual, 1, 4 )  ) +' '+
                             'ORDER BY MES DESC ' ) Then
        Begin

          sIdRegraAntecipAbono := QryAux.FieldByName('IDREGRA').AsString;

          If Trim( sIdRegraAntecipAbono ) <> '' Then
          Begin

            { Aplicar a regra de antecipação }

            If Trim( psDataFinal ) = ''
            Then sDataFinalAntecip := ' '
            Else sDataFinalAntecip := psDataFinal;

            sSQL := ' SELECT '+
                    IntToStr( piIdTitular )+      ' AS IDTITULAR,   '+
                    IntToStr( piIdBeneficiario )+ ' AS IDPESSOA,    '+
                    IntToStr( piIdPessJur )+      ' AS IDPESSJUR,   '+
                    IntToStr( piIdPlanoPrev )+    ' AS IDPLANOPREV, '+
                    '1 AS SEQPROPOSTA, '+
                    QryAux.FieldByName('IDREGRA').AsString +' AS REGRANTECIPABONO, '+
                    OraNumero( FormatFloat('#0.00', QryAux.FieldByName('PERCENTUAL').AsFloat) ) + ' AS PERCANTECIPABONO, '+
                    IntToStr( piIdBeneficio )+       ' AS IDBENEFICIO,    '+
                    QuotedStr( psDataInicio )+       ' AS DATAINICIO,     '+
                    QuotedStr( sDIB )+               ' AS DATAINICIOFUND, '+
                    QuotedStr( sDataFinalAntecip )+  ' AS DATAFINAL,      '+
                    QuotedStr( psDataInicio )+       ' AS DATAREF,        '+
                    QuotedStr( sDataFolha )+         ' AS DATAPAGAMENTO,  '+
                    QuotedStr( sMesAtual )+          ' AS MESREFERENCIA,  '+
                    QuotedStr( sMesAtual )+          ' AS ANOMESREF,      '+
                    QuotedStr( sMesAtual )+          ' AS ANOREF,         '+
                    QuotedStr( sAnoMesLote )+        ' AS ANOMESCOBRANCA, '+
                    OraNumero( sVlrInfINSSInicial )+ ' VLRINFINSS,  '+
                    OraNumero( FloatToStr( dValorBenefRateado ) )+ ' AS VLBENEFPGTO, '+
                    OraNumero( FloatToStr( dValorBenefRateado ) )+ ' AS VALORATUAL   '+
                    ' FROM DUAL ';

            Try
              sValorAbono := RegraNumerica( QryAux.FieldByName('IDREGRA').AsString, sSQL ,bErro, iIdCalculoGeral );
            Except
              bErro := True;
              Exit;
            End;

          End Else Begin 

            { Apilcar o percentual direto no valor }

            rValorAbono := ( dValorBenefRateado * (QryAux.FieldByName('PERCENTUAL').AsFloat / 100) );
            sValorAbono := FloatToStr( rValorAbono );


          End; 

          bEhAdiantamentoAbono := True;
          bPagaAbono           := True;

        End; 


      End; 

    End;

    If ( bPagaAbono ) Then
    Begin

      if (cTipoAbono = 'B')        and (sMesAtual = sMesFinal) and
         (Trim(psDataFinal) <> '') and (sAnoMesDataFinal <= sMesFinal)
      then pbPreparaContrib13 := True;

      sDataInicioParaAbono := psDataInicioOriginal;
      { No caso de migração de beneficios, o Abono deve ser calculado com base }
      { na DATAINICIO do beneficios origem da migração.                        }
      If pbMigracaoPlano Then Begin
        sDataInicioParaAbono := sDibBenefAnt;
      End;

      { Caso seja adiantamento (ultimo mês processado) o valor do abono }
      { já foi calculado no adiantamento.                               }
      If bEhAdiantamentoAbono = False Then
      Begin
         //Andre Imakawa - SIG 33822 - Inicio
         If ( piTipoMov = 7 ) Then
         Begin
           if (bApresentaBSFAB) then
           begin
             // Andre Imakawa - SIG 60869 - Inicio
             //rVlrBSTotalAbono   := rVlrBSTotal;
             //rVlrFABTotalAbono  := rVlrFABTotal;
             rVlrBSTotalAbono   := rValorBSRateado;
             rVlrFABTotalAbono  := rValorFABRateado;
             // Andre Imakawa - SIG 60869 - Fim
           end;
           if (bApresentaDeficit) then
             rVlrBCDeficitAbono := rVlrBCDeficit;
         end
         else
         Begin
         //Andre Imakawa - SIG 33822 - Fim

           // Calculo do abono do BS Fab e Deficit
           // edilaine - SOL 253577-17464 / PPM 955703
           qryAux.Close;
           qryAux.SQL.Clear;

           qryAux.SQL.Add(' SELECT BFC.FLGPROVISORIO, BFC.IDPLANOORIGEM,  '+
                          '        BFC.FONTEPAGADORA, BFT.PERCENTUAL,     '+
                          //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - INÍCIO
                          '        BFC.VLRBSATUAL,    BFC.VLRFABATUAL, BFC.VLRBASEDEFICIT '+     // edilaine - SOL 253577-17464 / PPM 955703
                          //BRUNO AZEVEDO SOL 253577/18069 PPM 1241131 - FIM
                          ' FROM BENEFBFCIARIO BFC, BFCIARIOTITPLAN BFT '+
                          ' WHERE (BFC.IDPESSJUR      ='+ IntToStr(piIdPessJur)      +')'+
                          '   AND (BFC.IDPLANOPREV    ='+ IntToStr(piIdPlanoPrev)    +')'+
                          '   AND (BFC.IDTITULAR      ='+ IntToStr(piIdTitular)      +')'+
                          '   AND (BFC.SEQPROPOSTA    ='+ IntToStr(piSeqProposta)    +')'+
                          '   AND (BFC.IDPESSOA       ='+ IntToStr(piIdBeneficiario)       +')'+
                          '   AND (BFC.IDBENEFICIO    ='+ IntToStr(piIdBeneficio)    +')'+
                          '   AND (BFC.NUMEROPROCESSO ='+ IntToStr(piNumeroProcesso) +')'+
                          '   AND (BFC.IDPESSJUR      = BFT.IDPESSJUR)   '+
                          '   AND (BFC.IDPLANOPREV    = BFT.IDPLANOPREV) '+
                          '   AND (BFC.IDTITULAR      = BFT.IDTITULAR)   '+
                          '   AND (BFC.SEQPROPOSTA    = BFT.SEQPROPOSTA) '+
                          '   AND (BFC.IDPESSOA       = BFT.IDPESSOA)    '+
                          '   AND (BFC.IDBENEFICIO    = BFT.IDBENEFICIO) ');
           qryAux.Open;

           // edilaine - SOL 253577-17464 / PPM 955703 - inicio
           rVlrBSTotalAbono   := '';
           rVlrFABTotalAbono  := '';
           rVlrBCDeficitAbono := '';

           rVlrBSTitAbono     := '';    //edilaine WO18367
           rVlrFABTitAbono    := '';    //edilaine WO18367

           if not qryAux.isEmpty then
           begin
             // william moreira - SOL 268820 / PPM 1271204 - inicio
             if (bApresentaBSFAB) then
             begin
