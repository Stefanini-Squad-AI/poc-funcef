function ComparaValorReservaComHistorico(qryAux : TwwQuery; pIdPessoa,pIdPessJur,pIdPlanoPrev : String;
                                         bPedeConfirmacao : boolean = true ) : Boolean;    // edilaine - SOL 253577-18129 / PPM 1303078
var
  bConfirma : boolean;       // edilaine - SOL 253577-18129 / PPM 1303078
Begin

   Result := true;

   // Renato Visoni SOL 123843 Kintana 636875
   If FazQuery(qryAux, ' SELECT h.IDPESSJUR, h.IDPESSOA, h.IDPLANOPREV, h.IDTIPORESERVA, SUM(DECODE(FLGENTRADA,0,VLRCOTAS*-1,VLRCOTAS)), r.valorreserva '+
                       ' FROM HISTMOVRESERVA H, reservapart r                                                                                           '+

                       ' WHERE H.IDTIPORESERVA NOT IN (SELECT IDTIPORESERVA FROM RESERVAXPLANO WHERE NVL(FLGSALDAMENTO,0)=1)                            '+

                       ' AND H.IDPLANOPREV = ' +pIdPlanoPrev  +
                       ' AND H.IDPESSOA = ' +pIdPessoa                                                                +
                       ' AND H.IDPESSJUR = '+pIdPessJur                                                                                                         +
                       ' AND H.IDTIPORESERVA  = R.IDTIPORESERVA                                                                                         '+
                       ' AND H.IDPLANOPREV = R.IDPLANOPREV                                                                                              '+
                       ' AND H.IDPESSOA = R.IDPESSOA                                                                                                    '+
                       ' AND H.IDPESSJUR = R.IDPESSJUR                                                                                                  '+
                       ' AND H.SEQPROPOSTA = R.SEQPROPOSTA                                                                                              '+
                       ' HAVING SUM(DECODE(FLGENTRADA,0,VLRCOTAS*-1,VLRCOTAS)) <> r.valorreserva                                                        '+
                       ' GROUP BY h.IDPESSJUR, h.IDPESSOA, h.IDPLANOPREV, h.IDTIPORESERVA, r.valorreserva                                               ')
   then begin
     if bPedeConfirmacao then  // edilaine - SOL 253577-18129 / PPM 1303078 - inicio
     begin
        bConfirma := MsgDlg('O Valor da Reserva está divergente do valor do Histórico de Alimentação.'+#10+'Deseja atualizar os valores das reservas?', 'Confirmação', mtConfirmation, [mbYes, mbNo],0) = mrYes;
     end
     else
       bConfirma := true;

     if bConfirma then  // edilaine - SOL 253577-18129 / PPM 1303078 - fim
     begin
       qryAux.Close;
       qryAux.SQL.Clear;
       qryAux.SQL.Add(' UPDATE RESERVAPART R '+
                      ' SET R.VALORRESERVA = (SELECT SUM(DECODE(FLGENTRADA, '+
                      '                                        0, '+
                      '                                        VLRCOTAS * -1, '+
                      '                                        VLRCOTAS)) '+
                      '                        FROM HISTMOVRESERVA H '+
                      '                       WHERE H.IDTIPORESERVA = R.IDTIPORESERVA '+
                      '                         AND H.IDPLANOPREV = R.IDPLANOPREV     '+
                      '                         AND H.IDPESSOA = R.IDPESSOA           '+
                      '                         AND H.IDPESSJUR = R.IDPESSJUR         '+
                      '                         AND H.SEQPROPOSTA = R.SEQPROPOSTA     '+
                      '                       GROUP BY IDPESSJUR,                     '+
                      '                                IDPESSOA,                      '+
                      '                                IDPLANOPREV,                   '+
                      '                                IDTIPORESERVA)                 '+
                      ' WHERE r.idpessoa IN ('+pIdPessoa+')'+
                      ' and idtiporeserva NOT IN                                      '+
                      '    (SELECT IDTIPORESERVA                                      '+
                      '       FROM RESERVAXPLANO                                      '+
                      '      WHERE NVL(FLGSALDAMENTO, 0) = 1)                         '+
                      ' AND R.IDPESSJUR ='+ pIdPessJur   +
                      ' AND R.IDPLANOPREV ='+ pIdPlanoPrev);

       qryAux.ExecSQL;
     end else begin
       MsgDlg('Operação não pode ser Concluída.', Sistema.NomeModulo, mtConfirmation, [mbok],0);
       Result := False;
       Exit;
     end;
   end;
   // Renato Visoni SOL 123843 Kintana 636875


end;

Function TemContaResgate(idLote,idpessoa : Integer):Boolean;
var QryAux2 : TQuery;
begin
   Result := True;
   QryAux2 := Tquery.Create( Application );
   QryAux2.databasename := 'BASEDADOS';
    
   //Renato Visoni SOL 135283 Kintana 803604
   qryAux2.close;
   qryAux2.SQL.Clear;
   qryAux2.SQL.Add('SELECT FLGRESGATE FROM CTRLINTERFACE');
   qryAux2.SQL.Add('WHERE IDLOTE = '+ intTostr(idLote));
   qryAux2.SQL.Add('AND NVL(FLGRESGATE,0)=1');
   qryAux2.Open;

   if not qryAux2.IsEmpty then begin
     qryAux2.close;
     qryAux2.SQL.Clear;
     qryAux2.SQL.Add('SELECT * FROM CONTABANCARIA');
     qryAux2.SQL.Add('WHERE IDPESSOA = '+ intTostr(idPessoa));
     qryAux2.SQL.Add('AND NVL(FLGCONTARESGATE,0)=1');
     qryAux2.Open;

     if qryAux2.IsEmpty then begin
       MessageDlg('É necessário uma Conta de Resgate.', mtInformation, [mbOK], 0);
       result := False;
       Exit;
     end;
   end;
  //Renato Visoni SOL 135283 Kintana 803604

  FreeandNil(QryAux2);

end;

function ExecutaRegraCalculoOpcaoTextoBenef(qryAux : TwwQuery;
                                      piIdRegraCalculo, piIdRegraCalcReserva,
                                      piIdPessJur, piIdPlanoPrev, piIdTitular,
                                      piSeqProposta, piIdBeneficio, piNumeroProcesso,
                                      piIdSitFunc, piIdSitPart, piIdSitPlano : longint;
                                      prOpcao1, prOpcao2, prOpcao3           : double;
                                      psDataEvento, psDataInicio, psDataInicioINSS,
                                      psVlrInfINSS,
                                      psDataRequerimento,
                                      psValorCalcINSS,
                                      psValorBase1INSS,
                                      psValorBase2INSS,
                                      psValorBase3INSS : string;
                                      var bErro : boolean;
                                      var sMsgErro : string;
                                      var piIdCalculo : longInt;
                                      psFlgInternoAntes,
                                      psFlgInternoAtual,
                                      psIdSitPartAntes,
                                      psIdSitPlanAntes,
                                      psIdSitFuncAntes,
                                      psIdSitPartAtual,
                                      psIdSitPlanAtual,
                                      psIdSitFuncAtual    : string ;
                                      psValorSRB : String = '0';
                                      psOpcaoTexto1 : String = '';
                                      psOpcaoTexto2 : String = '';
                                      psOpcaoTexto3 : String = '') : String;
var
  sDataInicio,
  sDataInicioINSS,
  sDataRef,
  sOp1, sOp2, sOP3,
  sSQL,
  sSALPART,
  sREMTOTAL,
  sIDTPPAGTOANT,
  sFlgInterno,
  sFlgBenefMinimo,
  sValorOpcao,
  sDataInscFund,
  sValorReserva, sValorUltBenef, sAnoMesRef : string;
  rValorOpcao : double;
  sDataInicioAnt         : string; 
begin
  Result := '';
  if piIdRegraCalculo <= 0 then Exit;

  // Para a regra de calculo, DATAINICIO = DIB - DATA DE DIREITO = (QUASE SEMPRE) DATA DO EVENTO
  //                          DATAREF    = DATA DO EVENTO

  if Trim(psDataEvento) = ''     then psDataEvento     := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataInicio) = ''     then psDataInicio     := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataInicioINSS) = '' then psDataInicioINSS := FormatDateTime('dd/mm/yyyy', date);

  sDataInicio := psDataInicio;
  sDataInicioINSS := psDataInicioINSS;
  sDataRef    := psDataEvento;

  sValorReserva := '0';
  sAnoMesRef := Copy(psDataEvento,7,4) + '/' + Copy(psDataEvento,4,2);
  sValorUltBenef := OraNumero(CalcUltimoBeneficio(piIdPessJur,
                                                  piIdPlanoPrev,
                                                  piIdTitular,
                                                  piIdBeneficio,
                                                  psDataInicio,
                                                  'P',
                                                  sIDTPPAGTOANT,
                                                  sFlgBenefMinimo,
                                                  sDataInicioAnt,
                                                  qryAux));


  if psVlrInfInss <> ''
  then psVlrInfInss := OraNumero(Trim(psVlrInfInss))
  else psVlrInfInss := '0';

  with qryAux do
  begin
     Close;
     SQL.Clear;
     SQL.Add(' SELECT FLGINTERNO FROM SITPART WHERE IDSITPART = '+IntToStr(piIdSitPart));
     Open;
     sFlgInterno := FieldByName('FlgInterno').AsString;
     Close;
  end;

  if sFlgInterno = 'MA'
  then sSALPART  := CalcRUBMANTIDO(piIdPessJur, piIdPlanoPrev, piIdTitular, piSeqProposta,
                                   SAnoMesAnterior(sAnoMesRef), qryAux)
  else if sFlgInterno = 'MP'
       then sSALPART  := CalcRUBPARCIAL(piIdPessJur, piIdPlanoPrev, piIdTitular, piSeqProposta,
                                        SAnoMesAnterior(sAnoMesRef), qryAux)
       else sSALPART  := CalcSalPart( piIdPessJur,
                                      piIdTitular,
                                      SAnoMesAnterior(sAnoMesRef),
                                      qryAux);

  sSalPart := OraNumero(sSalPart);

  sREMTOTAL := ORANUMERO(CalcREMTOTAL( piIdPessJur,
                                       piIdTitular,
                                       SAnoMesAnterior(sAnoMesRef),
                                       qryAux));

  sDataInscFund := CalcDataInscFund(piIdPessJur, piIdPlanoPrev, piIdTitular, piSeqProposta,qryAux);

  if Trim(sDataInscFund) = '' then sDataInscFund := FormatDateTime('dd/mm/yyyy', Date);

  if Trim(sSalPart) = ''   then sSalPart := '0';
  if Trim(sRemTotal) = ''  then sRemTotal := '0';

  if prOpcao1 >= 0
  then sOp1 := OraNumero(FloatToStr(prOpcao1))
  else sOp1 := '0';

  if prOpcao2 >= 0
  then sOp2 := OraNumero(FloatToStr(prOpcao2))
  else sOp2 := '0';

  if prOpcao3 >= 0
  then sOp3 := OraNumero(FloatToStr(prOpcao3))
  else sOp3 := '0';

  if Trim(sValorReserva) = '' then sValorReserva := '0';

  if Trim(sDataRef) = ''   then sDataRef := FormatDateTime('dd/mm/yyyy', Date);

  if Trim(sValorUltBenef) = '' then sValorUltBenef := '0';

  // Executa Regra de Cálculo do Valor do Beneficio
  sSQL := ' SELECT DISTINCT  1 FLGCONCESSAO, '+
          '   PF.ESTCIVIL, '+
          '   PP.DATAOPCAOIR, PP.TIPOOPCAOIR, ' +
          '        PP.SEQPROPOSTA,  '+
          '   PP.IDPESSOA, PP.IDPESSJUR, PP.IDPLANOPREV, PP.INSCRICAODATA, PP.DTINICIOINSC,      '+
          ''''+sDataInscFund+''' AS INSCRICAODATAFUND , PF.DATANASC, PF.SEXO,  PF.DATAMORTE,  '+
          '        EL.SALTOTAL, EL.DATAADMISSAO, EL.TEMPOSERVANTERIOR,                        '+
          '        EL.TEMPONAOCREDITADO, EL.TEMPOSERVTOTAL, EL.TEMPOSERVTOTMES, EL.TEMPOSERVTOTDIA, '+
          sSALPART                   +' AS VALORPROVENTO,  '+
          sREMTOTAL                  +' AS VALORREMTOTAL,  '+
          IntToStr(piIdTitular)      +' AS IDTITULAR,      '+
          IntToStr(piIdBeneficio)    +' AS IDBENEFICIO,    '+
          IntToStr(piNumeroProcesso) +' AS NUMEROPROCESSO, '+
          sOp1                       +' AS VALORBASE1,     '+
          sOp2                       +' AS VALORBASE2,     '+
          sOp3                       +' AS VALORBASE3,     '+
          IntToStr(piIdSitFunc)      +' AS IDSITFUNC,      '+
          IntToStr(piIdSitPart)      +' AS IDSITPART,      '+
          IntToSTr(piIdSitPlano)     +' AS IDSITPLANOPREV, '+
          ''''+psFlgInternoAntes         +''' AS FLGINTERNOANT,   '+
          ''''+psFlgInternoAtual         +''' AS FLGINTERNO,      '+
          ''''+psIdSitPartAntes          +''' AS IDSITPARTATUAL,  '+
          ''''+psIdSitPlanAntes          +''' AS IDSITPLANOATUAL, '+
          ''''+psIdSitFuncAntes          +''' AS IDSITFUNCATUAL,  '+
          ''''+psIdSitPartAtual          +''' AS IDSITPARTNOVO,   '+
          ''''+psIdSitPlanAtual          +''' AS IDSITPLANONOVO,  '+
          ''''+psIdSitFuncAtual          +''' AS IDSITFUNCNOVO,   '+
          sValorReserva              +' AS VALORRESERVA,   '+
          OraNumero(psVlrInfINSS)    +' AS VLRINFINSS,     '+
          OraNumero(psValorCalcINSS) +' AS VLRCALCINSS,    '+
          OraNumero(psValorBase1INSS)+' AS VALORBASE1INSS, '+
          OraNumero(psValorBase2INSS)+' AS VALORBASE2INSS, '+
          OraNumero(psValorBase3INSS)+' AS VALORBASE3INSS, '+
          QuotedStr(Trim(psOpcaoTexto1))   +' AS OPCAOTEXTO1, '+
          QuotedStr(Trim(psOpcaoTexto2))   +' AS OPCAOTEXTO2, '+
          QuotedStr(Trim(psOpcaoTexto3))   +' AS OPCAOTEXTO3, '+
          OraNumero(sValorUltBenef)  +' AS VLBENEFPGTO,    '+
          OraNumero(psValorSRB)      +' AS VALORSRB,       '+
          ''''+sIDTPPAGTOANT         +''' AS IDTPPAGTOANT, '+
          ''''+sFlgBenefMinimo       +''' AS FLGBENEFMIN,  '+
          ''''+Trim(sDataRef)        +''' AS DATAREF,      '+
          ''''+Trim(sDataInicio)     +''' AS DATAINICIO,   '+
          ''''+Trim(sDataInicioINSS) +''' AS DATAINICIOINSS, '+
          ''''+Trim(sDataInicioAnt)  +''' AS DATAINICIOANT,   '+
          ''''+Trim(psDataRequerimento)  +''' AS DATAREQUERIMENTO   '+
          ' ,EL.CODVINCULAFUNC  '+
          ' FROM   ELEGPATRO EL, PARTPREVPLAN PP, PESSOAFISICA PF,  SITFUNC SF, BENEFPLANOPART BPL  '+
          ' WHERE  PP.IDPESSOA    = ' + IntToStr(piIdTitular)   + ' AND '+
          '        PP.IDPESSJUR   = ' + IntToStr(piIdPessJur)   + ' AND '+
          '        PP.IDPLANOPREV = ' + IntToStr(piIdPlanoPrev) + ' AND '+
          '        PP.SEQPROPOSTA = ' + IntToStr(piSeqProposta) + ' AND '+
          '        EL.IDPESSOA    = PP.IDPESSOA          AND '+
          '        EL.IDPESSJUR   = PP.IDPESSJUR         AND '+
          '        PF.IDPESSOA    = EL.IDPESSOA          AND '+
          '        EL.IDSITFUNC   = SF.IDSITFUNC(+)      AND '+
          '        PP.IDPESSOA    = BPL.IDPESSOA(+)      AND '+
          '        PP.IDPESSJUR   = BPL.IDPESSJUR(+)     AND '+
          '        PP.IDPLANOPREV = BPL.IDPLANOPREV(+) ';

  sValorOpcao := RegraString(IntToStr(piIdRegraCalculo),sSQL, bErro, piIdCalculo );

  if bErro
  then begin
     bErro := True;
     sMsgErro := ' Ocorreu um erro na Regra de Cálculo de Texto da Opção do Benefício (nº '+IntToStr(piIdRegraCalculo)+') ';
     Result  := '';
     Exit;
  end;

  if Trim(sValorOpcao) = ''
  then begin
     bErro := True;
     sMsgErro := ' A Regra de Cálculo da Opção de Texto do Benefício (nº '+IntToStr(piIdRegraCalculo)+')'+
                 ' retornou um valor em branco. ';
     Result  := '';
     Exit;
  end;


  bErro := False;
  sMsgErro := ' ';
  Result := sValorOpcao;
end;

