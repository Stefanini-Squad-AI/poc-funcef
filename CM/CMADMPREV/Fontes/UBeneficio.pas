procedure AtualizaBSFAB(QryAux : TwwQuery;
                        rVlrBSAtual, rVlrBSTotal, rVlrFABAtual, rVlrFABTotal : string;
                        iIdPessoa, iIdTitular, iIdPlanoPrev, iIdPessJur, iIdBeneficio,
                        iNumProcesso, iSeqProposta : integer;
                        rVlrBSTitular, rVlrFABTitular, rVlrTotTitular : string);        //edilaine WO18367
begin
  qryAux.Close;
