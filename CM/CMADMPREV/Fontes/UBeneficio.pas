      QryAux.SQL.Add(' WHERE IDPESSJUR     = '+IntToStr(piIdPessJur));
      QryAux.SQL.Add('  AND IDPESSOA       = '+IntToStr(piIdPessoa));
      QryAux.SQL.Add('  AND IDTITULAR      = '+IntToStr(piIdTitular));
      QryAux.SQL.Add('  AND IDPLANOPREV    = '+IntToStr(piIdPlanoPrev));
      QryAux.SQL.Add('  AND IDBENEFICIO    = '+IntToSTr(piIdBeneficio));
      QryAux.SQL.Add('  AND MES            = '+QuotedStr(psAnoMesCobranca));
      QryAux.SQL.Add('  AND IDMOTIVO       = '+IntToStr(piIdMotivo));
      QryAux.SQL.Add('  AND NUMEROPROCESSO = '+IntToStr(piNumeroProcesso));
      QryAux.SQL.Add('  AND MESREFERENCIA  = '+QuotedStr(psAnoMesReferencia));
      QryAux.SQL.Add('  AND SEQBENEFICIO   = '+IntToStr(piSeqBeneficio));
      QryAux.SQL.Add('  AND IDPLANOORIGEM  = '+sPlanoOrigem);
      QryAux.SQL.Add('  AND SEQPROPOSTA    = '+IntToStr(piSeqProposta));
      QryAux.ExecSQL;

      QryAux.Close;
      QryAux.Sql.Clear;
      QryAux.SQL.Add(' SELECT DATAREQUERIMENTO FROM BENEFBFCIARIO');
      QryAux.SQL.Add(' WHERE IDPESSJUR     = '+IntToStr(piIdPessJur));
      QryAux.SQL.Add('  AND IDPESSOA       = '+IntToStr(piIdPessoa));
      QryAux.SQL.Add('  AND IDTITULAR      = '+IntToStr(piIdTitular));
      QryAux.SQL.Add('  AND IDPLANOPREV    = '+IntToStr(piIdPlanoPrev));
      QryAux.SQL.Add('  AND IDBENEFICIO    = '+IntToSTr(piIdBeneficio));
      QryAux.SQL.Add('  AND NUMEROPROCESSO = '+IntToStr(piNumeroProcesso));
      QryAux.Open;

      sDataRequerimento := QryAux.FieldByname('DATAREQUERIMENTO').asString;

      QryAux.Close;
      QryAux.Sql.Clear;
      QryAux.Sql.Add('UPDATE CTRLINTERFACE ');
      QryAux.Sql.Add('   SET FLGVOLTATMP = 1, ');
      QryAux.Sql.Add('       DATAVOLTATMP = ' + QuotedStr(sDataRequerimento));
      QryAux.Sql.Add(' WHERE IDLOTE = '+IntToStr(piIdLote));
      QryAux.ExecSql;
    end;
  end;
  //Renato Visoni SOL 137663 Kintana 833903

  Result := True;

End; { InsereHstBenefBfciario }

