  end;
  bErro := False;
  sMsgErro := ' ';
  Result := rValorBeneficio;
end;

function ExecutaRegraElegibilidadeBfciario( qryAux : TwwQuery;
                                            piIDREGRAELEGIBILI,
                                            piIdPessJur, piIdPlanoPrev, piIdTitular,
                                            piIdPessoa,
                                            piSeqProposta, piIdBeneficio : longint;
                                            prOpcao1, prOpcao2, prOpcao3           : double;
                                            psDataEvento, psDataInicio, psDataDemissao  : string;
                                            var bErro : boolean;
                                            var sMsgErro : string;
                                            piFlgTipoINSS   : integer;
                                            psDataInicioFund : String = '';
                                            piIdChamadorElegibilidade: Integer = 0              // Andre Imakawa - SIG 103584
                                            ) : boolean; 
var sSQLDataDemissao,
    sDataInscFund,
    sDataInicio,
    sSQL,
    sDataRef : string;
    bConcedeBeneficio : boolean;

    // DADOS DO BENEFICIO ANTERIOR
    sDataInicioAnt,
    sValorAnt,
    sNomeBenefAnt,
    sIdTpPagtoAnt,
    sUltMesReajAnt,
    sFlgBenefMinAnt,
    sDataEventoAnt,
    sCodBeneficioAnt,
    sNumProcINSS, 
    sCodBeneficioINSS,
    sValorBase1Ant, sValorBase2Ant, sValorBase3Ant : string;
    piFlgINSSConcedido : word;
    sDataRequerimento : String;
    sTpFrequencia, sTpElegibilidadeConcessao: string; // Andre Imakawa - SIG 103584
begin
  Result := False;
  if piIDREGRAELEGIBILI <= 0
  then begin
     Result := True;
     Exit;
  end;
  sDataRequerimento := '';

  sSql := 'SELECT DATAREQUERIMENTO '+
          'FROM BENEFBFCIARIO '+
          'WHERE IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+
          '  AND IDBENEFICIO = '+IntToStr(piIdBeneficio)+
          '  AND IDTITULAR   = '+IntToStr(piIdTitular)+
          '  AND IDPESSJUR   = '+IntToStr(piIdPessjur)+
          '  AND SEQPROPOSTA = '+IntToStr(piSeqproposta);

  qryAux.SQL.Clear;
  qryAux.SQL.Add(sSql);
  qryAux.Open;

  If not qryAux.IsEmpty
   Then sDataRequerimento :=  'TO_DATE('+QuotedStr(qryAux.FieldByName('DATAREQUERIMENTO').AsString)+
                              ','+QuotedStr('DD/MM/YYYY')+')';

  sDataInscFund := CalcDataInscFund(piIdPessJur, piIdPlanoPrev, piIdTitular, piSeqProposta,qryAux);

  if Trim(psDataEvento) = ''     then psDataEvento := FormatDateTime('dd/mm/yyyy', date);
  if Trim(psDataInicio) = ''     then psDataInicio := FormatDateTime('dd/mm/yyyy', date);

  if Trim(psDataInicioFund) = '' then psDataInicioFund := ' ';

  sDataInicio := psDataInicio;
  sDataRef := psDataEvento;

  // Verificar se algum benefício do INSS está requerido
  if VerificaINSSConcedido ( qryAux,
                             piIdPessJur, piIdPlanoPrev, piIdTitular, piIdPessoa,
                             piIdBeneficio,sCodBeneficioINSS )
  then piFlgINSSConcedido := 1
  else piFlgINSSConcedido := 0;


  if   psDataDemissao = ''
  then sSQLDataDemissao := 'EL.DATADEMISSAO '
  else sSQLDataDemissao := ''''+Trim(psDataDemissao)+''' AS DATADEMISSAO ';

  BuscaDadosBeneficioAnterior ( qryAux,
                                piIdPessJur, piIdPlanoPrev, piIdTitular,
                                piIdBeneficio,
                                0, 
                                psDataInicio,
                                sDataInicioAnt,
                                sValorAnt,
                                sNomeBenefAnt,
                                sIdTpPagtoAnt,
                                sUltMesReajAnt,
                                sFlgBenefMinAnt,
                                sDataEventoAnt,
                                sCodBeneficioAnt,
                                sValorBase1Ant, sValorBase2Ant, sValorBase3Ant,
                                sNumProcINSS,
                                False);

  sTpFrequencia := BuscaTipoFrequenciaPgto(IntToStr(piIdBeneficio)); // Andre Imakawa - SIG 103584
  if piIdChamadorElegibilidade = 1 then
    sTpElegibilidadeConcessao := 'S'
  else
    sTpElegibilidadeConcessao := 'N';

  sSQL := ' SELECT  PF.DATANASC,  PF.DATAMORTE, PF.SEXO, PF.ESTCIVIL,  PP.DTINICIOINSC,  '+
          '         EL.TEMPONAOCREDITADO, EL.DATAADMISSAO, EL.IDSITFUNC,            '+
          '         EL.TEMPOSERVANTERIOR, EL.TEMPOSITESPECIAL, DE.FLGBENEFICIARIO,  '+
          '         EL.TEMPOSERVTOTAL,    EL.DATADEMISSAO,                          '+
          '         EL.TEMPOSERVTOTMES, EL.TEMPOSERVTOTDIA,                         '+
          '         PP.DATAOPCAOIR, PP.TIPOOPCAOIR, ' +  
          '         PP.FLGDEVEPREVIDENC, PP.FLGDEVEASSISTENC, PP.FLGDEVEEMPRESTIMO, '+
          '         PP.IDSITPART, PP.IDSITPLANOPREV, PP.SEQPROPOSTA, PP.IDPESSOA,   '+ 
          '         DE.IDPESSOA AS IDDEPENDENTE,                                    '+ 
          '         PF.INICIOINVALIDEZ, PF.FIMINVALIDEZ,                            '+
          '         PP.IDPESSJUR,  PP.IDPLANOPREV,  PP.INSCRICAODATA,SP.FLGINTERNO, '+
          '         BF.IDTITULAR, PP.SALPARTICIPACAO,                               '+
          '         BF.IDDEPENRESPON, BF.IDRESPONSAVEL, BF.PERCENTUAL,              '+
          '         BF.PRIORIDADE,                                                  '+
          '         DE.IDDEPENDENCIA, D.IDSITDEPENDENTE, DE.IDTITULAR,              '+
          '         DE.DATACADASTRO,                                                '+ 
          '         EL.IDPESSOA AS IDTITULAR,                                       '+ 
          '         PP.IDSITPART AS IDSITPARTATUAL,                                 '+ 
          IntToStr(piIdBeneficio)+' AS IDBENEFICIO,                                 '+ 

          sSQLDataDemissao+','+
          '''' + Trim(sDataInicio)    + ''' AS DATAINICIO,             '+
          '''' + Trim(psDataInicioFund)    + ''' AS DATAINICIOFUND,    '+ 
          '''' + Trim(psDataEvento)   + ''' AS DATAEVENTO,             '+
          '''' + Trim(psDataEvento)   + ''' AS DTEVENTO,               '+
          '''' + sDataInscFund        + ''' AS INSCRICAODATAFUND,      '+
          '''' + sDataRef             + ''' AS DATAREF,                '+
          IntToStr(piFlgTipoINSS)     + ' AS FLGTIPOINSS,              '+
          IntToStr(piFlgINSSConcedido)+ ' AS FLGINSSCONCEDIDO,         '+
          ''''+sCodBeneficioINSS         + '''   AS CODBENEFICIOINSS,  '+
          OraNumero(FloatToStr(prOpcao1))+ ' AS VALORBASE1,            '+
          OraNumero(FloatToStr(prOpcao2))+ ' AS VALORBASE2,            '+
          OraNumero(FloatToStr(prOpcao3))+ ' AS VALORBASE3,            '+
          ''''+    sIdTpPagtoAnt           +''' AS IDTPPAGTOANT,       '+  
          ''''+    sUltMesReajAnt          +''' AS ULTMESREAJANT,      '+  
          ''''+    sFlgBenefMinAnt         +''' AS FLGBENEFMINANT,     '+  
          '''' +   Trim(sDataEventoAnt)    +''' AS DATAEVENTOANT,      '+  
          '''' +   Trim(sCodBeneficioAnt)  +''' AS CODBENEFICIOANT,     '+ 
          '''' +   Trim(sDataInicioAnt)   +''' AS DATAINICIOANT,      '+
          '''' +   sTpFrequencia           +''' AS FLGFREQUENCIA,      '+  // Andre Imakawa - SIG 103584
          '''' +   sTpElegibilidadeConcessao +''' AS FLGCONCESSAO,     '+  // Andre Imakawa - SIG 103584
          OraNumero(sValorAnt)       +' AS VLBENEFPGTO,          '+
          OraNumero(sValorAnt)       +' AS VALORBENEFANT';

  If sDataRequerimento <> ''                                               
   Then sSql := sSql + ', '+sDataRequerimento+' AS DATAREQUERIMENTO  ';    

  sSql:= sSql +
          ' FROM  ELEGPATRO EL, DEPENTIT DE, PESSOAFISICA PF,          '+
          '       PARTPREVPLAN PP, SITPART SP, BFCIARIOTITPLAN BF,     '+
          '       DEPENDENTE D                                         '+
          ' WHERE PP.IDPESSOA    = ' + IntToStr(piIdTitular)   + ' AND '+
          '       PP.SEQPROPOSTA = ' + IntToStr(piSeqProposta) + ' AND '+
          '       PP.IDPLANOPREV = ' + IntToStr(piIdPlanoPrev) + ' AND '+
          '       PP.IDPESSJUR   = ' + IntToStr(piIdPessJur)   + ' AND '+
          '       DE.IDPESSOA    = ' + IntToStr(piIdPessoa )   + ' AND '+
          '       BF.IDBENEFICIO = ' + IntToStr(piIdBeneficio) + ' AND '+
          '       DE.IDPESSOA    = D.IDPESSOA AND                      '+
          '       EL.IDPESSOA  = PP.IDPESSOA  AND                      '+
          '       EL.IDPESSJUR = PP.IDPESSJUR AND                      '+
          '       SP.IDSITPART = PP.IDSITPART AND                      '+
          '       DE.IDTITULAR = EL.IDPESSOA  AND                      '+
          '       DE.IDPESSOA  = PF.IDPESSOA(+) AND                    '+
          '       BF.IDPESSOA  = DE.IDPESSOA AND                       '+
          '       BF.IDTITULAR = DE.IDTITULAR AND                      '+
          '       BF.IDPLANOPREV = PP.IDPLANOPREV AND                  '+
          '       BF.IDPESSJUR  = PP.IDPESSJUR                         ';

  bConcedeBeneficio := RegraBooleana(IntToStr(piIDREGRAELEGIBILI) ,sSQL , bErro);

  if bErro
  then begin
     bErro := True;
     sMsgErro := ' Ocorreu um erro na Regra de Elegibilidade do Benefício (nº '+IntToStr(piIDREGRAELEGIBILI)+') ';
     Result  := False;
     Exit;
  end;

  sMsgErro := ' ';
  Result := bConcedeBeneficio;
end;


function VerificaStatusProcesso(bNumeroProcesso : integer) : integer; //SOL 256744 PPM 999526
begin
   Result := 0;
   if bNumeroProcesso > 0 then
   begin
     with TwwQuery.Create(nil) do
     begin
        DatabaseName:='BaseDados';
        Close;
        SQL.Clear;
        SQL.Add(' SELECT IDSITBENEFICIO FROM BENEFBFCIARIO '+
                   ' WHERE  NUMEROPROCESSO = '+ (IntToStr(bNumeroProcesso)));
        Open;
        Result := FieldByName('IDSITBENEFICIO').Asinteger;
     end;
   end;
end;

function DesfazRequerimentos(qryAux : TwwQuery; psNumerosProcessos : string; bApagaTodos : boolean = false ) : boolean; //TAES - SIG99559
var sIdsHistMovReserva : string;
    iStatusProcesso : integer; //SOL 256744 PPM 999526

    //DGS  - 269399 PPM 1293316
    iUltimaOperacao              : integer;
    iIdLoteMovimento             : integer;
    sSQL,sMesReferencia,sIniFaixaExclusao,sFaixaExclusao,sIdLoteNaoPago,sLotes,sAnoMesLote,sFimFaixaExclusao,sNomeUltimaOperacao   :string;
    QryAuxiliar : Twwquery;
    BbeneficioPg:Boolean;
    //DGS  - 269399 PPM 1293316

begin
    Result := False;

    sIdsHistmovReserva := '';

    frmAguarde.Mostra('Desfazendo Requerimentos de Benefício ...');


    if (sistema.IdModulo = 454)  then //SOL 256744 PPM 999526
    begin

       iStatusProcesso := VerificaStatusProcesso(StrToIntDef(psNumerosProcessos,0)); //SOL 256744 PPM 999526
       //if (iStatusProcesso <> 0) then
       //   psNumerosProcessos := '';
    end;

    if Trim(psNumerosProcessos) <> ''
    then begin

        // Selecionar da MovReservaTemp os movimentos feitos na reserva
        // para devolver os valores a reserva do participante
        with dtmAPrev.qry do
        begin
           Close;
           SQL.Clear;
           SQL.Add(' SELECT IDTIPORESERVA, IDHISTRESERVA, IDPESSOA,IDPESSJUR,        '+
                   '        IDPLANOPREV, SEQPROPOSTA, VLRABATIDO, IDTITULAR,         '+
                   '        VLRORIGINAL                                              '+
                   ' FROM   MOVRESERVATEMP                                           '+
                   ' WHERE  NUMEROPROCESSO IN ('+psNumerosProcessos+')               '+
                   ' AND    (IDTITULAR,IDTIPORESERVA, IDMOVRESERVATMP) IN            '+
                   '        (SELECT IDTITULAR, IDTIPORESERVA, MIN(IDMOVRESERVATMP) AS IDMOVRESERVATMP '+
                   '         FROM   MOVRESERVATEMP                                   '+
                   '         WHERE  NUMEROPROCESSO IN ('+psNumerosProcessos+')       '+
                   '         GROUP BY IDTITULAR,IDTIPORESERVA )                      '+
                   ' ORDER BY IDMOVRESERVATMP                                        ');
           Open;

           if (sistema.IdModulo <> 454)  or ((iStatusProcesso <> 4)  and (sistema.IdModulo = 454)) then //SOL 256744 PPM 999526
           begin
             while not Eof do
             begin
                 qryAux.Close;
                 qryAux.SQL.Clear;
                 qryAux.SQL.Add(' UPDATE RESERVAPART SET VALORRESERVA =  '+OraNumero(FieldByName('VLRORIGINAL').AsString)+
                                ' WHERE  IDPESSOA      = '+FieldByName('IDTITULAR').AsString+
                                ' AND    IDPESSJUR     = '+FieldByName('IdPessJur').AsString+
                                ' AND    IDPLANOPREV   = '+FieldByName('IdPlanoPrev').AsString+
                                ' AND    SEQPROPOSTA   = '+FieldByName('SeqProposta').AsString+
                                ' AND    IDTIPORESERVA = '+FieldByName('IdTipoReserva').AsString);
                 try
                    qryAux.ExecSQL;
                 except
                    on E:EDBEngineError do
                    begin
                       frmAguarde.Apaga;
                       MostrarErro(E);
                       Exit;
                    end;
                 end;
                 if FieldByName('IdHistReserva').AsString <> ''
                 then sIdsHistMovReserva := sIdsHistMovReserva+','+FieldByName('IdHistReserva').AsString;
                 Next;
             end; // while not Eof
           end;
        end; // with


       // Apagar qryMovReservaTemp
       if (sistema.IdModulo <> 454)  or ((iStatusProcesso <> 4)  and (sistema.IdModulo = 454)) then //SOL 256744 PPM 999526
       begin
         qryAux.Close;
         qryAux.SQL.Clear;
         qryAux.SQL.Add(' DELETE FROM MOVRESERVATEMP '+
                        ' WHERE NUMEROPROCESSO IN ('+psNumerosProcessos+')');
         try
            qryAux.ExecSQL;
         except
            on E:EDBEngineError do
            begin
               frmAguarde.Apaga;
               MostrarErro(E);
               Exit;
            end;
         end;
       end;
    end;

    if Trim(sIdsHistMovReserva) <> ''
    then begin
       sIdsHistMovReserva:= Copy(sIdsHistMovReserva,2,length(sIdsHistMovReserva)-1);

       // Apagar qryHistMovReserva
       if (sistema.IdModulo <> 454)  or ((iStatusProcesso <> 4)  and (sistema.IdModulo = 454)) then //SOL 256744 PPM 999526
       begin
         qryAux.Close;
         qryAux.SQL.Clear;
         qryAux.SQL.Add(' DELETE FROM HISTMOVRESERVA  '+
                        ' WHERE IDHISTRESERVA IN ('+sIdsHistMovReserva+')');
         try
            qryAux.ExecSQL;
         except
            on E:EDBEngineError do
            begin
               frmAguarde.Apaga;
               MostrarErro(E);
               Exit;
            end;
         end;
       end;
    end;

    if Trim(psNumerosProcessos) <> ''
    then begin
       // Zerar RESERVA MATEMÁTICA, que só é calculada no REQUERIMENTO
       if (sistema.IdModulo <> 454)  or ((iStatusProcesso <> 4)  and (sistema.IdModulo = 454)) then //SOL 256744 PPM 999526
       begin

           qryAux.Close;
           qryAux.SQL.Clear;
           //BRUNO AZEVEDO SOL 141727 KINTANTA 900601
           qryAux.SQL.Add(' DELETE FROM HISTMOVRESERVA '+
                          ' WHERE  (IDPESSJUR, IDPLANOPREV, IDPESSOA, SEQPROPOSTA, IDEVENTOGERADOR, TO_CHAR(TRGDTINCLUSAO, ''DD/MM/YYYY'')) '+
                          '     IN (SELECT BF.IDPESSJUR, BF.IDPLANOPREV, BF.IDPESSOA, BF.SEQPROPOSTA, P.IDEVENTOGERADOR, BF.DATACONCESSAO '+
                          '         FROM   PROCESSOBENEF P, BENEFBFCIARIO BF                                        '+
                          '         WHERE  P.NUMEROPROCESSO IN ('+psNumerosProcessos+')                             '+
                          '         AND    BF.NUMEROPROCESSO = P.NUMEROPROCESSO )'+
                          ' AND    IDTIPORESERVA   IN (SELECT IDTIPORESERVA FROM RESERVAXPLANO '+
                          '                            WHERE  FLGTIPORESERVA = 1) ');
           //BRUNO AZEVEDO SOL 141727 KINTANTA 900601
           try
              qryAux.ExecSQL;

              if qryAux.RowsAffected > 0
              then begin
                 qryAux.Close;
                 qryAux.SQL.Clear;
                 qryAux.SQL.Add(' UPDATE RESERVAPART SET VALORRESERVA = 0                                  '+
                                ' WHERE  (IDPESSJUR, IDPLANOPREV, IDPESSOA, SEQPROPOSTA)                   '+
                                '     IN (SELECT BF.IDPESSJUR, BF.IDPLANOPREV, BF.IDPESSOA, BF.SEQPROPOSTA '+
                                '         FROM   BENEFBFCIARIO BF                                          '+
                                '         WHERE  BF.NUMEROPROCESSO IN ('+psNumerosProcessos+'))            '+
                                ' AND    IDTIPORESERVA   IN (SELECT IDTIPORESERVA FROM RESERVAXPLANO       '+
                                '                            WHERE  FLGTIPORESERVA = 1) ');
                 qryAux.ExecSQL;
              end;
           except
              on E:EDBEngineError do
              begin
                 frmAguarde.Apaga;
                 MostrarErro(E);
                 Exit;
              end;
           end;

           // Apagar CONTRIBPREVNUCLEO
           qryAux.Close;
           qryAux.SQL.Clear;
           qryAux.SQL.Add(' DELETE FROM CONTRIBPREVNUCLEO C                               '+
                          ' WHERE  EXISTS                                                 '+
                          '        ( SELECT 1                                             '+
                          '          FROM   BENEFBFCIARIO BF, BFCIARIOTITPLAN BTIT        '+
                          '          WHERE  BF.NUMEROPROCESSO IN ('+psNumerosProcessos+') '+
                          '          AND    BTIT.IDPESSJUR     = BF.IDPESSJUR             '+
                          '          AND    BTIT.IDTITULAR     = BF.IDTITULAR             '+
                          '          AND    BTIT.IDPLANOORIGEM = BF.IDPLANOORIGEM         '+
                          '          AND    BTIT.IDPESSOA      = BF.IDPESSOA              '+
                          '          AND    BTIT.SEQPROPOSTA   = BF.SEQPROPOSTA           '+
                          '          AND    BTIT.IDPLANOPREV   = BF.IDPLANOPREV           '+
                          '          AND    BTIT.IDBENEFICIO   = BF.IDBENEFICIO           '+
                          '          AND    C.IDNUCLEOFAMILIAR = BTIT.IDNUCLEOFAMILIAR    '+
                          '          AND    TO_CHAR(C.DATAINICIO,''YYYY/MM/DD'') >= TO_CHAR(BF.DATAINICIO, ''YYYY/MM/DD'') '+
                          '        )                                                      ');
           try
              qryAux.ExecSQL;
           except
              on E:EDBEngineError do
              begin
                 frmAguarde.Apaga;
                 MostrarErro(E);
                 Exit;
              end;
           end;

          // Apagar HSTATRASOCONTRIB   SOL 221079 no desfazer requerimento não excluia a contribuição
          // Somente para o beneficio
          if sistema.IdModulo = 454 then // SOL 234666 PPM 435515
          begin
            qryAux.Close;
            qryAux.SQL.Clear;  // SOL 256744 PPM 999526 refeita a SQL
            qryAux.SQL.Add('DELETE FROM HSTATRASOCONTRIB HAC' + #13#10 +
                           'Where HAC.NUMRECEBIMENTO IN (' + #13#10 +
                           'SELECT HST.NUMRECEBIMENTO FROM BENEFBFCIARIO B' + #13#10 +
                           'INNER JOIN HSTBENEFBFCIARIO H ON (H.IDPESSJUR      = B.IDPESSJUR AND' + #13#10 +
                           '                                  H.IDPLANOPREV    = B.IDPLANOPREV AND' + #13#10 +
                           '                                  H.IDTITULAR      = B.IDTITULAR AND' + #13#10 +
                           '                                  H.IDPESSOA       = B.IDPESSOA AND' + #13#10 +
                           '                                  H.SEQPROPOSTA    = B.SEQPROPOSTA AND' + #13#10 +
                           '                                  H.NUMEROPROCESSO = B.NUMEROPROCESSO AND' + #13#10 +
                           '                                  H.IDBENEFICIO    = B.IDBENEFICIO AND' + #13#10 +
                           '                                  H.IDPLANOORIGEM  = B.IDPLANOORIGEM AND' + #13#10 +
                           '                                  H.FONTEPAGADORA  = B.FONTEPAGADORA' + #13#10 +
                           '                                )' + #13#10 +
                           'INNER JOIN HSTCONTRIBPREV HST ON (HST.IDPESSJUR   = H.IDPESSJUR AND' + #13#10 +
                           '                                  HST.IDPLANOPREV = H.IDPLANOPREV AND' + #13#10 +
                           '                                  HST.IDTITULAR   = H.IDTITULAR AND' + #13#10 +
                           '                                  HST.IDPESSOA    = H.IDPESSOA AND' + #13#10 +
                           '                                  HST.SEQPROPOSTA = H.SEQPROPOSTA AND' + #13#10 +
                           '                                  HST.MESCOBRANCA = H.MES' + #13#10 +
                           '                                 )' + #13#10 +
                           'WHERE B.NUMEROPROCESSO IN ('+psNumerosProcessos+')' + #13#10 +
                           '  AND HST.DATARECEBIMENTO IS NULL' + #13#10 +  // SOL 256342 PPM 838875
                           '  AND HST.VALORRECEBIDO IS NULL' + #13#10 +    // SOL 256342 PPM 838875
                           '  AND HST.FLGSITFUNDACAO = ''AS''' + #13#10 +  // SOL 256342 PPM 838875
                           '  AND HST.SITRECEBIMENTO in (0) )');            // SOL 256342 PPM 838875


             try
                qryAux.ExecSQL;
             except
                on E:EDBEngineError do
                begin
                   frmAguarde.Apaga;
                   MostrarErro(E);
                   Exit;
                end;
             end;

            qryAux.Close;
            qryAux.SQL.Clear; //SOL 256744 PPM 999526 refeita a SQL
            qryAux.SQL.Add('DELETE FROM HSTCONTRIBPREV HAC' + #13#10 +
                           'Where HAC.NUMRECEBIMENTO IN (' + #13#10 +
                           'SELECT HST.NUMRECEBIMENTO FROM BENEFBFCIARIO B' + #13#10 +
                           'INNER JOIN HSTBENEFBFCIARIO H ON (H.IDPESSJUR      = B.IDPESSJUR AND' + #13#10 +
                           '                                  H.IDPLANOPREV    = B.IDPLANOPREV AND' + #13#10 +
                           '                                  H.IDTITULAR      = B.IDTITULAR AND' + #13#10 +
                           '                                  H.IDPESSOA       = B.IDPESSOA AND' + #13#10 +
                           '                                  H.SEQPROPOSTA    = B.SEQPROPOSTA AND' + #13#10 +
                           '                                  H.NUMEROPROCESSO = B.NUMEROPROCESSO AND' + #13#10 +
                           '                                  H.IDBENEFICIO    = B.IDBENEFICIO AND' + #13#10 +
                           '                                  H.IDPLANOORIGEM  = B.IDPLANOORIGEM AND' + #13#10 +
                           '                                  H.FONTEPAGADORA  = B.FONTEPAGADORA' + #13#10 +
                           '                                )' + #13#10 +
                           'INNER JOIN HSTCONTRIBPREV HST ON (HST.IDPESSJUR   = H.IDPESSJUR AND' + #13#10 +
                           '                                  HST.IDPLANOPREV = H.IDPLANOPREV AND' + #13#10 +
                           '                                  HST.IDTITULAR   = H.IDTITULAR AND' + #13#10 +
                           '                                  HST.IDPESSOA    = H.IDPESSOA AND' + #13#10 +
                           '                                  HST.SEQPROPOSTA = H.SEQPROPOSTA AND' + #13#10 +
                           '                                  HST.MESCOBRANCA = H.MES' + #13#10 +
                           '                                 )' + #13#10 +
                           'WHERE B.NUMEROPROCESSO IN ('+psNumerosProcessos+')' + #13#10 +
