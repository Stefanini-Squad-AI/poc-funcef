function BuscaDIB ( psNumerosProcessos : string;
                    qryAux             : TwwQuery  ) : string;
begin
   Result := '';
   if psNumerosProcessos = '' then Exit;
   
   with qryAux do
   begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT MIN(BF.DATAINICIOFUND) AS DATAINICIOFUND '+
              ' FROM BENEFBFCIARIO  BF, BENEFICIO B, TPPAGTOBENEFICIO TP '+
              ' WHERE BF.NUMEROPROCESSO IN ('+psNumerosProcessos+') '+
              ' AND   BF.IDBENEFICIO = B.IDBENEFICIO '+
              ' AND   B.IDTPPAGTOBENEFIC = TP.IDTPPAGTOBENEFIC '+
              ' AND   TP.FLGFREQUENCIA <> ''U'' ');
      Open;
      if (not IsEmpty) and (FieldByName('DataInicioFund').AsString <> '')
      then Result := FieldByName('DataInicioFund').AsString;
   end;
end;

//---------------------------------------------------------------------------------------//
// Tipos de Movimento (TIPOMOV):                    // Valores do campo MOTRETENC

// 0  - Renovacao                                   //   1 - COMPLETOU MAIOR IDADE
// 1  - Reabertura                                  //   2 - FALTA DE RECADASTRAMENTO
// 2  - Prorrogacao                                 //   3 - MUDANÇA DE ESTADO CIVIL
// 3  - Retencao                                    //   4 - CANCELAMENTO PELO INSS
// 4  - Encerramento                                //   5 - CONCLUSÃO DE CURSO SUPERIOR
// 5  - Desdobramento                               //   6 - FALECIMENTO
// 6  - Reajuste Judicial                           //   7 - OUTROS
// 7  - Concessao                                   //   8 - QUITACAO AUTOMATICA TOTALPREV
// 8  - Recalculo de Beneficio Provisorio           //
// 9  - Registro de falecimento de beneficiario     //
// 10 - Desfazer                                    //
// 11 - Liberacao de pagamento integral             //
// 12 - Liberacao de Beneficio Retido               //
// 13 - Revisão de Benefícios                       //
// 14 - Alteracao de Tipo de Beneficio              //
Function CriaLogOcorrencia( sIdPlanoPrev, sIdPessJur,
                            sIdTitular,   sIdBeneficio,
                            sNumProcesso, sIdPessoa,
                            sSeqProposta,
                            sTipoMov,     sDataMov,
                            sValorAtual,  sValorTotal, sValorCotas,
                            sDataInicio,  sDataFinal,
                            sValorAtualAnt,
                            sDataInicioAnt, sDataFinalAnt, sIdSitBenefAnt  : String;
                            iFlgDataPrevAnt : Integer;
                            QryAux : TwwQuery;
                            sMotivo : String;
                            piIdLote : LongInt;
                            Var piIdCalculo : Integer;
                            pbRetornaPatro : Boolean = False;
                            piIdUsuarioAutoriza : longint = -1;
                            piFlgEmprestimo  : Integer = -1;
                            pbRetencEncerramento   : Boolean = False;
                            sVlrBSTitAnt : string = '';         //edilaine WO18367
                            sVlrFABTitAnt : string = '';        //edilaine WO18367
                            sVlrTotTitAnt : string = ''         //edilaine WO18367
                          ) : LongInt;
Var
  SQL, sIdMovBenef : String;
  sIdPlanoOrigem : String;
  sVlrBSTot, sVlrBsAtu   : string;    // edilaine - SOL 253577-17464 / PPM 955703
  sVlrFabTot, sVlrFabAtu : string;    // edilaine - SOL 253577-17464 / PPM 955703
  sFabTitular, sBsTitular,                   // edilaine WO18367
  sVlrTotTit : string;                       // edilaine WO18367
Begin

  sIdMovBenef   := IntToStr(LeUltRegistro(nil,'MOVBENEF'));
  Result        := -1;

  // edilaine - SIG 20864 - INICIO
  {if sIdPessoa = sIdTitular
  then sIdPlanoOrigem := sIdPlanoPrev
  else  }  // edilaine - SIG 20864 - FIM
  begin
     qryAux.Close;
     qryAux.SQl.Clear;
     qryAux.SQl.Add(' SELECT IDPLANOORIGEM FROM BENEFBFCIARIO '+
                    ' WHERE  NUMEROPROCESSO = '+sNumProcesso+
                    ' AND    IDPESSJUR      = '+sIdPessJur+
                    ' AND    IDPLANOPREV    = '+sIdPlanoPrev+
                    ' AND    IDTITULAR      = '+sIdTitular+
                    ' AND    IDPESSOA       = '+sIdPessoa+
                    ' AND    IDBENEFICIO    = '+sIdBeneficio);
     qryAux.Open;

     if not qryAux.IsEmpty
     then sIdPlanoOrigem := qryAux.FieldByName('IDPLANOORIGEM').AsString
     else sIdPlanoOrigem := sIdPlanoPrev;

  end;

  // edilaine - SOL 253577-17464 / PPM 955703 - inicio
  sVlrBSAtu  := '';
  SVlrBSTot  := '';
  sVlrFABAtu := '';
  sVlrFABAtu := '';
  sFabTitular := '';    //edilaine WO18367
  sBsTitular  := '';    //edilaine WO18367
  sVlrTotTit  := '';    //edilaine WO18367

  {RN018 - Na concessão o sistema deverá verificar se o beneficio possui marcações apresentação do BS e FAB e/ou Base de cálculo do déficit.
           e realizar o lançamento na estrutura MOVBENEF informando a concessão de benefícios }
  qryAux.Close;
  qryAux.SQl.Clear;
  if sTipoMov <> '5' then
  begin
     qryAux.SQl.Add(' SELECT BF.VLRBSATUAL, BF.VLRBSTOTAL, BF.VLRFABATUAL, BF.VLRFABTOTAL, '+
                    '        B.FLGAPRESENTABSFAB, B.FLGAPRESENTADEFICIT,     '+
                    '        BF.BSTITULAR, BF.FABTITULAR, BF.VLRTOTALTITULAR '+    //edilaine WO18367
                    ' FROM   BENEFBFCIARIO BF, BENEFPLANPREV B'+
                    ' WHERE  BF.IDBENEFICIO = B.IDBENEFICIO '+
                    ' AND    BF.NUMEROPROCESSO = '+sNumProcesso+
                    ' AND    BF.IDPESSJUR      = '+sIdPessJur+
                    ' AND    BF.IDPLANOPREV    = '+sIdPlanoPrev+
                    ' AND    BF.IDTITULAR      = '+sIdTitular+
                    ' AND    BF.IDPESSOA       = '+sIdPessoa+
                    ' AND    BF.IDBENEFICIO    = '+sIdBeneficio);
  end
  else
  begin  //SOL 253577-18114  PPM 1292515
     qryAux.SQl.Add(' SELECT BF.TIPOMOV,BF.VLRBSATUALNOVO, BF.VLRBSATUALANT, BF.VLRBSTOTALANT, BF.VLRFABATUALANT, BF.VLRBSTOTALNOVO, BF.VLRFABATUALNOVO,BF.VLRFABATUALANT, BF.VLRFABATUALNOVO, '+
                    '        B.FLGAPRESENTABSFAB, BF.VLRFABTOTALANT, B.FLGAPRESENTADEFICIT, '+
                    '        BF.BSTITULAR, BF.FABTITULAR, BF.VLRTOTALTITULAR '+    //edilaine WO18367
                    ' FROM   MOVBENEF BF, BENEFPLANPREV B'+
                    ' WHERE  BF.IDBENEFICIO = B.IDBENEFICIO '+
                    ' AND    BF.NUMEROPROCESSO = '+sNumProcesso+
                    ' AND    BF.IDPESSJUR      = '+sIdPessJur+
                    ' AND    BF.IDPLANOPREV    = '+sIdPlanoPrev+
                    ' AND    BF.IDTITULAR      = '+sIdTitular+
                    ' AND    BF.IDPESSOA       = '+sIdPessoa+
                    ' AND    BF.IDBENEFICIO    = '+sIdBeneficio+
                    ' AND    BF.TIPOMOV  NOT IN (5,10) ');

  end; //SOL 253577-18114  PPM 1292515
  qryAux.Open;

  if (not qryAux.IsEmpty) and
     (qryAux.FieldByName('FLGAPRESENTABSFAB').AsInteger = 1) {or (qryAux.FieldByName('FLGAPRESENTADEFICIT').AsInteger = 1))} then
  begin
    if sTipoMov <> '5' then //SOL 253577-18114  PPM 1292515
    begin
       sVlrBSAtu  := QryAux.FieldByName('VLRBSATUAL').AsString;
       sVlrBSTot  := QryAux.FieldByName('VLRBSTOTAL').AsString;
       sVlrFABAtu := QryAux.FieldByName('VLRFABATUAL').AsString;
       sVlrFABTot := QryAux.FieldByName('VLRFABTOTAL').AsString;
       //edilaine WO18367 : inicio
       sFabTitular:= QryAux.FieldByName('FABTITULAR').AsString;
       sBsTitular := QryAux.FieldByName('BSTITULAR').AsString;
       sVlrTotTit := QryAux.FieldByName('VLRTOTALTITULAR').AsString;
       //edilaine WO18367 : fim
    end
    else
    begin  //SOL 253577-18114  PPM 1292515
       sVlrBSAtu  := QryAux.FieldByName('VLRBSATUALANT').AsString;
       sVlrBSTot  := QryAux.FieldByName('VLRBSTOTALANT').AsString;
       sVlrFABAtu := QryAux.FieldByName('VLRFABATUALANT').AsString;
       sVlrFABTot := QryAux.FieldByName('VLRFABTOTALANT').AsString;
       //edilaine WO18367 : inicio
       sFabTitular := QryAux.FieldByName('FABTITULARANT').AsString;;
       sBsTitular  := QryAux.FieldByName('BSTITULARANT').AsString;;
       sVlrTotTit  := QryAux.FieldByName('VLRTOTALTITULARANT').AsString;;
       //edilaine WO18367 : fim
    end; //SOL 253577-18114  PPM 1292515
  end;

  sVlrBSAtu  := iff( Trim(sVlrBSAtu)  = '', 'NULL',  ClienteNumero(sVlrBSAtu) );
  sVlrBSTot  := iff( Trim(sVlrBSTot)  = '', 'NULL',  ClienteNumero(sVlrBSTot) );
  sVlrFABAtu := iff( Trim(sVlrFABAtu) = '', 'NULL',  ClienteNumero(sVlrFABAtu) );
  sVlrFABTot := iff( Trim(sVlrFABTot) = '', 'NULL',  ClienteNumero(sVlrFABTot) );
  // edilaine - SOL 253577-17464 / PPM 955703 - fim

  //edilaine WO18367 : inicio
  sFabTitular   := iff( Trim(sFabTitular)   = '', 'NULL',  ClienteNumero(sFabTitular));
  sBsTitular    := iff( Trim(sBsTitular)    = '', 'NULL',  ClienteNumero(sBsTitular) );
  sVlrTotTit    := iff( Trim(sVlrTotTit)    = '', 'NULL',  ClienteNumero(sVlrTotTit) );
  sVlrBSTitAnt  := iff( Trim(sVlrBSTitAnt)  = '', 'NULL',  ClienteNumero(sVlrBSTitAnt) );
  sVlrFABTitAnt := iff( Trim(sVlrFABTitAnt) = '', 'NULL',  ClienteNumero(sVlrFABTitAnt) );
  sVlrTotTitAnt := iff( Trim(sVlrTotTitAnt) = '', 'NULL',  ClienteNumero(sVlrTotTitAnt) );
  //edilaine WO18367 : fim

  if Trim(sDataMov) = ''
  then sDataMov := ' NULL '
  else sDataMov := ' TO_DATE('''+sDataMov+''', ''DD/MM/YYYY'')';

  if Trim(sDataInicio) = ''
  then sDataInicio  := ' NULL '
  else sDataInicio  := ' TO_DATE('''+sDataInicio+''', ''DD/MM/YYYY'')';

  if Trim(sDataFinal) = ''
  then sDataFinal    := ' NULL '
  else sDataFinal    := ' TO_DATE('''+sDataFinal+''', ''DD/MM/YYYY'')';

  if Trim(sDataInicioAnt) = ''
  then sDataInicioAnt := ' NULL '
  else sDataInicioAnt := ' TO_DATE('''+sDataInicioAnt+''', ''DD/MM/YYYY'')';

  if Trim(sDataFinalAnt) = ''
  then sDataFinalAnt  := ' NULL '
  else sDataFinalAnt  := ' TO_DATE('''+sDataFinalAnt+''', ''DD/MM/YYYY'')';

  if Trim(sIdSitBenefAnt) = ''
  then sIdSitBenefAnt := ' NULL ';

  if Trim(sMotivo) = ''
  then sMotivo    := ' NULL ';

  sql := 'INSERT INTO MOVBENEF (IDMOVBENEF,   IDPLANOPREV,    IDPLANOORIGEM,    IDPESSJUR,  IDTITULAR,     '+
               '                IDBENEFICIO,  NUMEROPROCESSO, IDPESSOA,         SEQPROPOSTA,               '+
               '                TIPOMOV,      DATAMOV,        VALORATUAL,       VALORTOTAL,                '+
               '                VALORCOTAS,   DATAINICIO,     DATAFINAL,        DATAINICIOANT,             '+
               '                DATAFINALANT, VALORATUALANT,  IDSITANTERIOR,    FLGDATAPREVANT, MOTRETENC, '+
               '                IDLOTEMOV,    FLGVOLTAPATRO,  USUARIOALT,       FLGEMPRESTIMO, IDCALCULO,  '+
               // edilaine - SOL 253577-17464 / PPM 955703 - iniicio
               '                VLRBSATUALANT, VLRBSTOTALANT, VLRBSATUALNOVO, VLRBSTOTALNOVO, VLRFABATUALANT, '+
               '                VLRFABTOTALANT, VLRFABATUALNOVO, VLRFABTOTALNOVO, VALORTOTALANT, '+       // edilaine - SOL 253577-18151 / PPM 1318910
               // edilaine - SOL 253577-17464 / PPM 955703 - fim
               '                FABTITULARANT, FABTITULARNOVO, BSTITULARANT, BSTITULARNOVO, '+            //edilaine WO18367
               '                VLRTOTALTITULARANT, VLRTOTALTITULARNOVO )';                               //edilaine WO18367

  //sql := sql + ' VALUES ('+sIdMovBenef+','+sIdPlanoprev+','+sIdPlanoprev+','+sIdPessjur+','+sIdTitular+',  '; // SOL 269977 PPM 1322229
  sql := sql + ' VALUES ('+sIdMovBenef+','+sIdPlanoprev+','+sIdPlanoOrigem+','+sIdPessjur+','+sIdTitular+',  '; // SOL 269977 PPM 1322229 adicionado o valor correto do parametro idplanoorigem
  sql := sql              +sIdBeneficio+','+sNumProcesso+','+sIdPessoa+','+sSeqProposta+',                 ';
  sql := sql              +sTipoMov                  +','+
                           sDataMov                  +','+
                           OraNumero(sValorAtual)    +','+
                           OraNumero(sValorTotal)    +','+
                           OraNumero(sValorCotas)    +','+
                           sDataInicio               +','+
                           sDataFinal                +','+
                           sDataInicioAnt            +','+
                           sDataFinalAnt             +','+
                           OraNumero(sValorAtualAnt) +','+
                           sIdSitBenefAnt            +','+
                           IntToStr(iFLgDataPrevAnt) +',';
//                           sMotivo                   +',';  // SOL 149847/6241 KINTANA 1405080

  if pbRetencEncerramento then  //inicio SOL 149847/6241 KINTANA 1405080
     SQL := SQL + sMotivo
  else
     SQL := SQL + ' NULL'; //fim SOL 149847/6241 KINTANA 1405080

  if piIdLote > 0
  then SQL := SQL + ', '+IntToStr(piIdLote)
  else SQL := SQL + ', NULL';


  if pbRetornaPatro
  then SQL := SQL + ', 1'
  else SQL := SQL + ', 0';

  if piIdUsuarioAutoriza > 0
  then SQL := SQL + ', '+IntToStr(piIdUsuarioAutoriza)
  else SQL := SQL + ', NULL';

  If piFlgEmprestimo >= 0 Then
     SQL := SQL + ', ' + IntToStr(piFlgEmprestimo)
  Else
     SQL := SQL + ', NULL';

  If piIdCalculo > 0 Then
     SQL := SQL + ', ' + IntToStr( piIdCalculo )
  Else
     SQL := SQL + ', NULL';

  // edilaine - SOL 253577-17464 / PPM 955703 - inicio

  SQL := SQL + ', '+ OraNumero(sVlrBSAtu);     //   VLRBSATUALANT
  SQL := SQL + ', '+ OraNumero(sVlrBSTot);     //   VLRBSTOTALANT
  SQL := SQL + ', '+ OraNumero(sVlrBSAtu);     //   VLRBSATUALNOVO
  SQL := SQL + ', '+ OraNumero(sVlrBSTot);     //   VLRBSTOTALNOVO
  SQL := SQL + ', '+ OraNumero(sVlrFABAtu);    //   VLRFABATUALANT
  SQL := SQL + ', '+ OraNumero(sVlrFABTot);    //   VLRFABTOTALANT
  SQL := SQL + ', '+ OraNumero(sVlrFABAtu);    //   VLRFABATUALNOVO
  SQL := SQL + ', '+ OraNumero(sVlrFABTot);    //   VLRFABTOTALNOVO

  // edilaine - SOL 253577-17464 / PPM 955703 - fim

  SQL := SQL + ', '+ OraNumero(sValorTotal);    //   VALORTOTALANT         // edilaine - SOL 253577-18151 / PPM 1318910

  //edilaine WO18367 : inicio
  SQL := SQL + ', '+ OraNumero(sVlrFABTitAnt);
  SQL := SQL + ', '+ OraNumero(sFabTitular);
  SQL := SQL + ', '+ OraNumero(sVlrBSTitAnt);
  SQL := SQL + ', '+ OraNumero(sBsTitular);
  SQL := SQL + ', '+ OraNumero(sVlrTotTitAnt);
  SQL := SQL + ', '+ OraNumero(sVlrTotTit);
  //edilaine WO18367 : fim

  SQL := SQL + ')';

  qryaux.close;
  qryaux.SQL.clear;
  qryaux.sql.Add(sql);

  try
     qryaux.ExecSQL;
  except
     Exit;
  end;

  Result := StrToInt(sIdMovBenef);

end;

function BenefExistePREVIA ( qryAux : TwwQuery;
                             piIdPessJur,   piIdTitular,
                             piIdPlanoPrev, piIdMotivo, piIdNumeroProcesso,
                             piIdBeneficio, piIdPessoa, piSeqProposta     : longint;
                             psMesPagamento, psMesReferencia       : string ) : boolean;
var sSQL : string;
begin
   Result := False;

   sSQL := ' SELECT P.VALORPROVENTO  '+
           ' FROM   PREVIA P, CTRLINTERFACE C '+
           ' WHERE  P.IDPATRO        = '+IntToSTr(piIdPessJur)+
           ' AND    P.IDTITULAR      = '+IntToSTr(piIdTitular)+
           ' AND    P.IDPLANOPREV    = '+IntToSTr(piIdPlanoPrev)+
           ' AND    P.MESCOBRANCA    = '''+psMesPagamento+''''+
           ' AND    P.MES            = '''+psMesReferencia+''''+
           ' AND    P.FLGTIPODESC    = ''B'' ';
    if piIdMotivo > 0
    then sSQL := sSQL + ' AND    P.IDMOTIVO       = '+IntToSTr(piIdMotivo);

    sSQL := sSQL +' AND    P.NUMEROPROCESSO = '+IntToSTr(piIdNumeroProcesso)+
           ' AND    P.IDBENEFICIO    = '+IntToSTr(piIdBeneficio)+
           ' AND    P.IDPESSOA       = '+IntToSTr(piIdPessoa)+
           ' AND    P.SEQPROPOSTA    = '+IntToSTr(piSeqProposta) +
           ' AND    P.IDLOTE         = C.IDLOTE '+
           ' AND    C.FLGVOLTATMP    = 0 ';

   with qryAux do
   begin
      Close;
      SQL.Clear;
      SQL.Add(sSQL);
      Open;
      if not IsEmpty
      then Result := True;
      Close;
   end;
end; // BenefExistePREVIA

function ContaBeneficiosProcesso ( qry              : TwwQuery;
                                   piNumeroProcesso : longint;
                                   psTipo           : char { S - Suplementacao, I - INSS } ) : integer;
var iQtdeSuplementacoes ,
    iQtdeINSS              : integer;

begin
   Result := 0;

   iQtdeSuplementacoes := 0;
   iQtdeINSS           := 0;

   with qry do
   begin
      if psTipo = 'S'
      then begin
         // Contar as suplementacoes
         Close;
         SQL.Clear;
         SQL.Add(' SELECT COUNT(DISTINCT BF.IDBENEFICIO) AS QTDESUPLEMENTACAO '+
                 ' FROM   BENEFBFCIARIO BF, BENEFPLANPREV BP '+
                 ' WHERE  BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
                 ' AND    BF.IDPLANOPREV    = BP.IDPLANOPREV '+
                 ' AND    BF.IDBENEFICIO    = BP.IDBENEFICIO '+
                 ' AND    BP.FLGREFERENCIA  = 0 ');
         Open;

         if not IsEmpty
         then iQtdeSuplementacoes := FieldByName('QtdeSuplementacao').AsInteger;
      end;


      if psTipo = 'I'
      then begin
         // Contar os beneficios de INSS
         Close;
         SQL.Clear;
         SQL.Add(' SELECT COUNT(DISTINCT BF.IDBENEFICIO) AS QTDEINSS '+
                 ' FROM   BENEFBFCIARIO BF, BENEFPLANPREV BP '+
                 ' WHERE  BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
                 ' AND    BF.IDPLANOPREV    = BP.IDPLANOPREV '+
                 ' AND    BF.IDBENEFICIO    = BP.IDBENEFICIO '+
                 ' AND    BP.FLGREFERENCIA  = 1 '+
                 ' AND    BP.FLGPAGAINSS    = 1 ');
         Open;

         if not IsEmpty
         then iQtdeINSS := FieldByName('QtdeINSS').AsInteger;
      end;

      Close;
   end;

   if psTipo = 'S'
   then Result := iQtdeSuplementacoes
   else Result := iQtdeINSS;
end;


//edilaine SIG131098 : inicio
function BuscaValorBeneficioAnterior( qry : TwwQuery;
                                      psMesCalculo : string;
                                      piIdPessJur, piIdPlanoPrev,
                                      piIdPessoa,  piIdTitular,
                                      piIdBeneficio : integer) : string;
begin
  If piIdPessoa = -1 Then piIdPessoa := piIdTitular;

  if Length(Trim(psMesCalculo)) = 7 then
     psMesCalculo := '01/'+copy(psMesCalculo,6,2)+'/'+copy(psMesCalculo,1,4);

  with qry do
  begin
     Close;
     SQL.Clear;
     SQL.Add(' SELECT HST.VALORTOTAL       '+
             '   FROM HSTBENEFBFCIARIO HST '+
