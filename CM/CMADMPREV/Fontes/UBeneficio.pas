      sDataPagamento := FieldByName('DATAPAGAMENTO').AsString; 
      sDataFolha     := CriticaDataCobrancaSit( qryAux,IntToStr(iIdFundacao),'', 'AS', 'P',

                                                Copy(sAnoMesLote,6,2),
                                                Copy(sAnoMesLote,1,4) );
    end;
