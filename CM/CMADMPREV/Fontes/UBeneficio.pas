  { Caso seja concessão, beneficio do INSS e a fundação pague o beneficio.  }
  { Então sempre preparar desde a DIB.                                      }
  sAnoMesDataInicio := Copy(psDataInicio, 7,4)+'/'+Copy(psDataInicio, 4,2);
  If ( sFlgReferencia = '1' ) And ( piTipoMov = 7 ) And
     ( ( iFlgPagaINSSBP = 1 ) And ( sAnoMesDIB < sAnoMesDIP ) ) Then
  Begin
    sAnoMesDataInicio := Copy(sDIB, 7,4)+'/'+Copy(sDIB, 4,2);
  End;


  { Buscar ANO/MES de pagamento e data prevista para o lote }
  If ( piIdLote > 0 ) Then
  Begin
    with qryAux do
    begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT CIF.DATAPAGAMENTO, CIF.DATAPREPARO, CIF.MESREFERENCIA, '+
              'NVL(CIF.FLGINCLUIMESCONC,1) AS FLGINCLUIMESCONC '+
