                 '        VLRBSATUAL    = ' + iif(rVlrBSTotal = '', 'NULL', OraNumero(rVlrBSAtual)) +
                 '       ,VLRBSTOTAL    = ' + iif(rVlrBSTotal = '', 'NULL', OraNumero(rVlrBSTotal)) +
                 '       ,VLRFABATUAL   = ' + iif(rVlrFABTotal = '', 'NULL', OraNumero(rVlrFABAtual)) +
                 '       ,VLRFABTOTAL   = ' + iif(rVlrFABTotal = '', 'NULL', OraNumero(rVlrFABTotal)) +
                 '       ,BSTITULAR     = ' + iif(rVlrBSTitular = '', 'NULL', OraNumero(rVlrBSTitular)) +       //edilaine WO18367
                 '       ,FABTITULAR    = ' + iif(rVlrFABTitular = '', 'NULL', OraNumero(rVlrFABTitular)) +     //edilaine WO18367
                 '       ,VLRTOTALTITULAR = ' + iif(rVlrTotTitular = '', 'NULL', OraNumero(rVlrTotTitular)) +   //edilaine WO18367
                 ' WHERE SEQPROPOSTA    = ' + IntToStr(iSeqProposta) + ' AND ' +
                 '       IDPLANOPREV    = ' + IntToStr(iIdPlanoPrev) + ' AND ' +
                 '       IDTITULAR      = ' + IntToStr(iIdTitular)   + ' AND ' +
                 '       IDPESSJUR      = ' + IntToStr(iIdPessJur)   + ' AND ' +
                 '       NUMEROPROCESSO = ' + IntToStr(iNumProcesso) + ' AND ' +
                 '       IDBENEFICIO    = ' + IntToStr(iIdBeneficio) + ' AND ' +
                 '       IDPESSOA       = ' + IntToStr(iIdPessoa));
  qryAux.ExecSQL;
end;
