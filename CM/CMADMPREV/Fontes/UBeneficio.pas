function PegaValorTOTAL( qryAux            : TwwQuery;
                            piNumeroProcesso,
                            piIdBeneficio,
                            piIdBeneficiario  : longint;
                            psDataInicio      : string ) : double ;
var sAnoMes : string;
begin
   if Trim(psDataInicio) = '' then psDataInicio := FormatDateTime('dd/mm/yyyy', date);

   sAnoMes := Copy(psDataInicio,7,4) + '/' + Copy(psDataInicio,4,2);
   Result  := 0;

   with qryAux do
   begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT MES, VALORTOTAL '+
              ' FROM   HSTBENEFBFCIARIO '+
              ' WHERE  IDPESSOA       = '+IntToStr(piIdBeneficiario)+
              ' AND    MESREFERENCIA  = '''+sAnoMes+''''+
              ' AND    IDBENEFICIO    = '+IntToStr(piIdBeneficio) +
              ' AND    NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)
              +' ORDER BY MES DESC  ');

      Open;
      if (not IsEmpty) and (FieldByName('VALORTOTAL').AsFloat > 0)
      then begin
         Result := FieldByName('VALORTOTAL').AsFloat;
         Close;
         Exit;
      end
   end;

   with qryAux do
   begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT VALORTOTAL, VALORNADIB, DATAINICIO '+
              ' FROM   BENEFBFCIARIO '+
              ' WHERE  NUMEROPROCESSO = '+IntToStr(piNumeroProcesso)+
              ' AND    IDPESSOA       = '+IntToStr(piIdBeneficiario)+
              ' AND    IDBENEFICIO    = '+IntToStr(piIdBeneficio) );
      Open;

      If qryAux.FieldByName('DATAINICIO').AsFloat > StrToDate(psDataInicio) Then Begin
        Result := FieldByName('VALORNADIB').AsFloat;
        Close;
        Exit;
      End;

      if (not IsEmpty) and (FieldByName('VALORTOTAL').AsFloat > 0)
      then Result := FieldByName('VALORTOTAL').AsFloat;
      Close;
   end;
end;

