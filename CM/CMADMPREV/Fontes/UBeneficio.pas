         Exit;
       end;
     end;
    //edilaine - SIG89790 - fim

    { Rotina que executa o calculo do valor do beneficio no mês sendo processado }
    dValorBeneficioNoMes := CalculaBeneficioAPagarNoMes( qryAux,
                                                         sMesAtual,
                                                         piIdTitular,   piIdBeneficiario,
                                                         piSeqProposta, piIdPessJur,
                                                         piIdPlanoPrev, piNumeroProcesso,
                                                         piIdBeneficio, piTotBeneficiarios,
                                                         piIdRegraPrimPagto, piIdRegraUltPagto,
