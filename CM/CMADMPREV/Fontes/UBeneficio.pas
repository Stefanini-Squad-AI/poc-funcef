function BuscaDadosParticipante(piIdTitular, piIdPessoa, piIdPlanoPrev, piIdPessJur, piSeqProposta, piNumeroProcesso : integer;
                                var sNomeParticipa,
                                    sNomePlano,
                                    sNomePatro : string) : boolean;
var
  qryAux : TwwQuery;
begin
  try
    qryAux := TwwQuery.Create(nil);
    qryAux.DatabaseName := 'BaseDados';

    if  piIdTitular = piIdPessoa then
    begin
       qryAux.Close;
       qryAux.SQL.Clear;
       qryAux.SQL.Add('SELECT P.NOME, PP.NOME AS NOMEPLANO, PAT.NOME AS NOMEPATRO ');
       qryAux.SQL.Add('  FROM BENEFBFCIARIO BF ');
       qryAux.SQL.Add('       JOIN PESSOA P ON P.IDPESSOA = BF.IDPESSOA  ');
       qryAux.SQL.Add('       JOIN PLANPREV PP ON PP.IDPLANOPREV = BF.IDPLANOPREV ');
       qryAux.SQL.Add('       JOIN PESSOA PAT ON PAT.IDPESSOA = BF.IDPESSJUR ');
       qryAux.SQL.Add(' WHERE BF.IDPESSOA    = '+IntToStr(piIdPessoa)    );
       qryAux.SQL.Add('   AND BF.IDPESSJUR   = '+IntToStr(piIdPessJur)   );
       qryAux.SQL.Add('   AND BF.IDPLANOPREV = '+IntToStr(piIdPlanoPrev) );
       qryAux.SQL.Add('   AND BF.SEQPROPOSTA = '+IntToStr(piSeqProposta) );
       qryAux.SQL.Add('   AND BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso) );
       qryAux.SQL.Add('   AND ROWNUM = 1  ');
    end
    else
    begin
       qryAux.Close;
       qryAux.SQL.Clear;
       qryAux.SQL.Add('SELECT P.NOME, PP.NOME AS NOMEPLANO, PAT.NOME AS NOMEPATRO ');
       qryAux.SQL.Add('  FROM BENEFBFCIARIO BF ');
       qryAux.SQL.Add('       JOIN PESSOA P ON P.IDPESSOA = BF.IDTITULAR  ');
       qryAux.SQL.Add('       JOIN PLANPREV PP ON PP.IDPLANOPREV = BF.IDPLANOPREV ');
       qryAux.SQL.Add('       JOIN PESSOA PAT ON PAT.IDPESSOA = BF.IDPESSJUR ');
       qryAux.SQL.Add(' WHERE BF.IDTITULAR   = '+IntToStr(piIdTitular)    );
       qryAux.SQL.Add('   AND BF.IDPESSOA    = '+IntToStr(piIdPessoa)    );
       qryAux.SQL.Add('   AND BF.IDPESSJUR   = '+IntToStr(piIdPessJur)   );
       qryAux.SQL.Add('   AND BF.IDPLANOPREV = '+IntToStr(piIdPlanoPrev) );
       qryAux.SQL.Add('   AND BF.SEQPROPOSTA = '+IntToStr(piSeqProposta) );
       qryAux.SQL.Add('   AND BF.NUMEROPROCESSO = '+IntToStr(piNumeroProcesso) );
       qryAux.SQL.Add('   AND ROWNUM = 1  ');
    end;

    try
      qryAux.Open;
      if not qryAux.eof then
      begin
        sNomeParticipa := qryAux.FieldByName('NOME').AsString;
        sNomePlano     := qryAux.FieldByName('NOMEPLANO').AsString;
        sNomePatro     := qryAux.FieldByName('NOMEPATRO').AsString;
      end
      else
      begin
        sNomeParticipa := '';
        sNomePlano     := '';
        sNomePatro     := '';
      end;

      Result := True;
    except
      Result:= False;
    end;
  finally
    FreeAndNil(qryAux);
  end;
end;


