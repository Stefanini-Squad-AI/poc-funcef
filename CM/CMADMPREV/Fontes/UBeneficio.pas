function  MontaSQLBenefAssoc (iIdTitular : integer) : string;
const  sRelacaoBUA = '506,507,508,509,515';  // relação de benefícios únicos antecipados B.U.A. (RegReplan)
var sValor,
    sSQL : string;
    qryAux : TwwQuery;
    iNumBenefAssoc : integer;
begin
  iNumBenefAssoc := 0;
  sSQL := '';

  try
    qryAux := TwwQuery.Create(Application);
    qryAux.DatabaseName :=  'BaseDados';

    qryAux.close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add('SELECT BF.IDBENEFICIO, BPL.FlgCalcTodoMes, BF.VALORCOTAS, BF.VALORATUAL, ');
    qryAux.SQL.Add('       BF.VALORBASE1, BF.VALORBASE2, BF.VALORBASE3  ');
    qryAux.SQL.Add('  FROM benefbfciario BF, BENEFPLANPREV BPL          ');
    qryAux.SQL.Add('  WHERE BPL.IDBENEFICIO = BF.IDBENEFICIO            ');
    qryAux.SQL.Add('    AND BPL.IDPLANOPREV = BF.IDPLANOPREV            ');
    qryAux.SQL.Add('    AND BF.IDTITULAR = '+ IntToStr(iIdTitular)         );
    qryAux.SQL.Add('    AND BF.IDBENEFICIO in (' + sRelacaoBUA +')      ');
    qryAux.SQL.Add('  ORDER BY BF.NUMEROPROCESSO desc                   ');
    qryAux.Open;
    if not qryAux.eof then
    begin
      inc(iNumBenefAssoc);

      if qryAux.FieldByName('FlgCalcTodoMes').AsInteger = 1
      then begin
         if Trim(qryAux.FieldByName('VALORCOTAS').AsString) <> ''
         then sValor := qryAux.FieldByName('VALORCOTAS').AsString
         else sValor := '0';
      end
      else begin
         if Trim(qryAux.FieldByName('VALORATUAL').AsString) <> ''
         then sValor := qryAux.FieldByName('VALORATUAL').AsString
         else sValor := '0';
      end;

      sSQL := sSQL +','+OraNumero(sValor)+' AS VALORASSOCIADO'+IntToStr(iNumBenefAssoc);

      if Trim(qryAux.FieldByName('VALORBASE1').AsString) <> ''
      then sValor := qryAux.FieldByName('VALORBASE1').AsString
      else sValor := '0';
      sSQL := sSQL +','+OraNumero(sValor)+' AS ASSOC'+IntToStr(iNumBenefAssoc)+'OP1';

      if Trim(qryAux.FieldByName('VALORBASE2').AsString) <> ''
      then sValor := qryAux.FieldByName('VALORBASE2').AsString
      else sValor := '0';
      sSQL := sSQL +','+OraNumero(sValor)+' AS ASSOC'+IntToStr(iNumBenefAssoc)+'OP2';

      if Trim(qryAux.FieldByName('VALORBASE3').AsString) <> ''
      then sValor := qryAux.FieldByName('VALORBASE3').AsString
      else sValor := '0';
      sSQL := sSQL +','+OraNumero(sValor)+' AS ASSOC'+IntToStr(iNumBenefAssoc)+'OP3';

      //qryAux.Next;
    end;
  finally
    qryAux.free;
  end;

  Result := sSQL;

end;


function ExecutaRegraCalculoDeficit(qryAux                : TwwQuery;
                                    piIdRegraCalculo,
                                    piIdPlanoPrev,
                                    piIdPessJur,
                                    piIdPessoa,
                                    piIdTitular,
                                    piIdBeneficio         : longint;
                                    var bErro             : boolean;
                                    var sMsgErro          : string;
                                    var piIdCalculo       : longInt;
                                    prValorBase1          : double;
                                    prValorBase3          : double;
                                    sSQLBenefAssociado    : string;
                                    prValorBS             : double;
                                    prValorTotal          : double;
                                    prValorAtual          : double;
                                    prValorInfINSS        : double;
                                    psPercentual          : string;
                                    piIdSitPlanoPrev      : integer;
                                    psDataReferencia      : string;
                                    psDataIniFund         : string;
                                    piIdPlanPrevContab    : integer
                                    ) : double;
var
  sSQL   : string;
  sValor : string;
  rValor : double;
begin

  if Trim(sSQLBenefAssociado) = '' then
     sSQLBenefAssociado := ', 0 AS VALORASSOCIADO, 0 AS ASSOC1OP1, 0 AS ASSOC2OP1, 0 AS ASSOC3OP1, '+
                           '                       0 AS ASSOC1OP2, 0 AS ASSOC2OP2, 0 AS ASSOC3OP2, '+
                           '                       0 AS ASSOC1OP3, 0 AS ASSOC2OP3, 0 AS ASSOC3OP3  ';

  sSQL := 'SELECT '+
          '       '+IntToStr(piIdPessJur)     +' AS IDPESSJUR,    '+
          '       '+IntToStr(piIdPessoa)      +' AS IDPESSOA,    '+
          '       '+IntToStr(piIdTitular)     +' AS IDTITULAR,   '+
          '       '+IntToStr(piIdBeneficio)   +' AS IDBENEFICIO, '+
          '       '+OraNumero(FloatToStr(prValorBase1))+' AS VALORBASE1, '+
          '       '+OraNumero(FloatToStr(prValorBase1))+' AS VALORBASE3, '+
          '       '+IntToStr(piIdPlanoPrev)   +' AS IDPLANOPREV, '+
          '       '+OraNumero(FloatToStr(prValorBS))+' AS VALORBS, '+
          '       '+OraNumero(FloatToStr(prValorTotal))+' AS VALORTOTAL, '+
          '       '+OraNumero(FloatToStr(prValorAtual))+' AS VALORATUAL, '+
          '       '+OraNumero(FloatToStr(prValorInfINSS))+' AS VLRTOTALINSS, '+
          '       '+OraNumero(psPercentual) +' AS PERCENTUAL, '+
          '       '+IntToStr(piIdSitPlanoPrev) +' AS IDSITPLANOPREV, '+
          '       '+Quotedstr(psDataReferencia)+ ' AS DATAREF, '+
          '       '+Quotedstr(psDataIniFund)+ ' AS DATAINICIOFUND, '+
          '       '+IntToStr(piIdPlanPrevContab) +' AS IDPLANOPREVCONTAB '+
          '       '+sSQLBenefAssociado+
          '  FROM DUAL';


  piIdCalculo := -1;
  sValor := RegraNumerica(IntToStr(piIdRegraCalculo), sSQL, bErro, piIdCalculo, True );

  if bErro
   then begin
     bErro := True;
     sMsgErro := ' Ocorreu um erro na Regra de Cálculo do Valor do Déficit (nº '+IntToStr(piIdRegraCalculo)+') ';
     Result  := -1;
     Exit;
  end;

  if Trim(sValor) = ''
  then begin
     bErro := True;
     sMsgErro := ' A Regra de Cálculo do Valor do Déficit (nº '+IntToStr(piIdRegraCalculo)+')'+
                 ' retornou um valor em branco. ';
     Result  := -1;
     Exit;
  end;

  try
     rValor := StrToFloat(ClienteNumero(sValor));
  except
     bErro := True;
     sMsgErro := ' A Regra de Cálculo do Valor do Déficit (nº '+IntToStr(piIdRegraCalculo)+')' +
                 ' retornou um valor inválido. [Valor Retornado = '+sValor+']';
     Result  := -1;
     Exit;
  end;

  bErro    := False;
  sMsgErro := ' ';
  Result   := rValor;

end;

