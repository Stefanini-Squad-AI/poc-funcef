// edilaine - SOL 253577-18064 / PPM 1240079 - inicio
function BuscaPercentualGrupoFamiliar(sMesReferencia  : string;
                                      sNumeroProcesso : string;
                                      iIdPlanoPrev : integer;
                                      iIdBeneficio : integer;
                                      iIdPessJur   : integer;
                                      iIdTitular   : integer;
                                      iIdPessoa    : integer;
                                      iIdPlanoOrigem : integer;
                                      iSeqProposta : integer;
                                      var sPercentual : string;
                                      bPercentualCheio : boolean = true) : boolean;
var
  qryAux : TwwQuery;
begin
  qryAux := TwwQuery.create(nil);
  qryAux.DatabaseName := 'BaseDados';

  Result := true;

  if (iIdTitular <> iIdPessoa) then//William Moreira da Silva - SOL 268774 PPM 1268561
  begin
  try
    try
       qryAux.close;
       qryAux.Sql.Clear;

       if bPercentualCheio then      // edilaine - SIG 20415 (invercao do if, para considerar 1o o percentual cheio e so depois o abono)
       begin
         {retorna percentual cheio apenas para o Mes}
         qryAux.Sql.Add('SELECT HPG.PERCENTUAL AS PERCGRUPOFAMILIAR '+
                        '  FROM HSTPERCGRUPO HPG  '+
                        ' WHERE HPG.IDPLANOPREV    = '+IntToStr(iIdPlanoPrev) +
                        '   AND HPG.IDBENEFICIO    = '+IntToStr(iIdBeneficio) +
                        '   AND HPG.NUMEROPROCESSO = '+sNumeroProcesso +
                        '   AND HPG.IDPESSJUR      = '+IntToStr(iIdPessJur) +
                        '   AND HPG.IDTITULAR      = '+IntToStr(iIdTitular) +
                        '   AND HPG.IDPESSOA       = '+IntToStr(iIdPessoa) +
                        '   AND HPG.SEQPROPOSTA    = '+IntToStr(iSeqProposta) +
                        '   AND TO_CHAR(HPG.DATAINICIO,''YYYY/MM'') <= '+Quotedstr(sMesReferencia)+
                        '   AND (TO_CHAR(HPG.DATAFIM,''YYYY/MM'') >= '+Quotedstr(sMesReferencia)+' OR HPG.DATAFIM is null)' +
                        ' ORDER BY HPG.DATAINICIO DESC');
       end
       else if pos('/13', sMesReferencia) > 0 then
       begin
         {retorna percentual para 13o}
         qryAux.Sql.Add('SELECT NVL(SUM(HPG.PERCENTUAL * ((( '+
                        '                 CASE  '+
                        '                   WHEN TO_CHAR(HPG.DATAFIM, ''YYYY'') > SUBSTR('+Quotedstr(sMesReferencia)+', 0, 4) OR HPG.DATAFIM IS NULL THEN '+
                        '                     12     '+
                        '                   WHEN TO_CHAR(HPG.DATAFIM, ''YYYY'') = SUBSTR('+Quotedstr(sMesReferencia)+', 0, 4) THEN '+
                        '                     CASE '+
                        '                        WHEN TO_CHAR(HPG.DATAFIM, ''DD'') < ''15'' THEN '+
                        '                           TO_NUMBER(TO_CHAR(HPG.DATAFIM, ''MM'')) - 1 '+
                        '                        ELSE   '+
                        '                           TO_NUMBER(TO_CHAR(NVL(HPG.DATAFIM,''31/12/'' || SUBSTR('+Quotedstr(sMesReferencia)+', 0, 4)),''MM'')) '+
                        '                     END '+
                        '                 END '+
                        '                 - '+
                        '                 CASE                                                                                    '+
                        '                   WHEN TO_CHAR(HPG.DATAINICIO, ''YYYY'') < SUBSTR('+Quotedstr(sMesReferencia)+', 0, 4) THEN              '+
                        '                    1                                                                                          '+
                        '                   WHEN TO_CHAR(HPG.DATAINICIO, ''YYYY'') = SUBSTR('+Quotedstr(sMesReferencia)+', 0, 4) THEN              '+
                        '                    CASE                                                '+
                        '                      WHEN TO_CHAR(HPG.DATAINICIO, ''DD'') >= 16 THEN   '+
                        '                       TO_NUMBER(TO_CHAR(HPG.DATAINICIO, ''MM'')) + 1   '+
                        '                      ELSE                                              '+
                        '                       TO_NUMBER(TO_CHAR(HPG.DATAINICIO, ''MM''))       '+
                        '                    END                                                 '+
                        '                 END) + 1) / 12)),                                      '+
                        '             0)  AS PERCGRUPOFAMILIAR                                   '+
                        '    FROM HSTPERCGRUPO HPG                                               '+
                        '   WHERE HPG.IDPLANOPREV    = '+IntToStr(iIdPlanoPrev) +
                        '     AND HPG.IDBENEFICIO    = '+IntToStr(iIdBeneficio) +
                        '     AND HPG.NUMEROPROCESSO = '+sNumeroProcesso +
                        '     AND HPG.IDPESSJUR      = '+IntToStr(iIdPessJur) +
                        '     AND HPG.IDTITULAR      = '+IntToStr(iIdTitular) +
                        '     AND HPG.IDPLANOORIGEM  = '+IntToStr(iIdPlanoOrigem) +
                        '     AND HPG.IDPESSOA       = '+IntToStr(iIdPessoa) +
                        '     AND HPG.SEQPROPOSTA    = '+IntToStr(iSeqProposta) +
                        '     AND TO_CHAR(HPG.DATAINICIO, ''YYYY'') <= SUBSTR('+Quotedstr(sMesReferencia)+', 0, 4) '+
                        '     AND (TO_CHAR(HPG.DATAFIM, ''YYYY'') >= SUBSTR('+Quotedstr(sMesReferencia)+', 0, 4) or HPG.DATAFIM is null) ');
       end
       else
       begin
         {retorna percentual proporcionalizado para o Mes}
         // SIG51394 Ajuste na SQL Inicio
         // Correção enviada pela Funcef no atendimento do chamado pelo analista sr. Tiago von no documento de teste.
         qryAux.Sql.Add(
                        ' SELECT 100 - ABS(100 - ROUND(SUM(HPG.PERCENTUAL * ' + #13#10 +
//                        '                 (CASE WHEN (EXTRACT(DAY FROM LEAST(HPG.DATAFIM)) < 30 OR HPG.DATAFIM IS NULL) THEN' + #13#10 +
                        '' + #13#10 +
                        '                       ((DECODE(LEAST(NVL(HPG.DATAFIM,' + #13#10 +
                        '                                     LAST_DAY(TO_DATE('+Quotedstr(sMesReferencia)+', ''YYYY/MM''))),' + #13#10 +
                        '                                 LAST_DAY(TO_DATE('+Quotedstr(sMesReferencia)+', ''YYYY/MM''))),' + #13#10 +
                        '                           LAST_DAY(TO_DATE('+Quotedstr(sMesReferencia)+', ''YYYY/MM'')),' + #13#10 +
                        '                           30,' + #13#10 +
                        '                           EXTRACT(DAY FROM' + #13#10 +
                        '                                   LEAST(NVL(HPG.DATAFIM,' + #13#10 +
                        '                                             LAST_DAY(TO_DATE('+Quotedstr(sMesReferencia)+',' + #13#10 +
                        '                                                              ''YYYY/MM''))),' + #13#10 +
                        '                                         LAST_DAY(TO_DATE('+Quotedstr(sMesReferencia)+',' + #13#10 +
                        '                                                          ''YYYY/MM''))))) -' + #13#10 +
                        '                 EXTRACT(DAY FROM' + #13#10 +
                        '                            GREATEST(CASE' + #13#10 +
                        '                                       WHEN (EXTRACT(DAY FROM(HPG.DATAINICIO)) = 31) THEN' + #13#10 +
                        '                                        HPG.DATAINICIO - 1' + #13#10 +
                        '                                       ELSE' + #13#10 +
                        '                                        HPG.DATAINICIO' + #13#10 +
                        '                                     END,' + #13#10 +
                        '                                     (''01'' || SUBSTR('+Quotedstr(sMesReferencia)+', 5, 3)) || ''/'' ||' + #13#10 +
                        '                                     SUBSTR('+Quotedstr(sMesReferencia)+', 0, 4)))) + 1) / 30 ), ' + #13#10 +
                        '             4)) AS PERCGRUPOFAMILIAR' + #13#10 +
{
                        '' + #13#10 +
                        '                    ELSE' + #13#10 +
                        '                      ((DECODE(LEAST(NVL(HPG.DATAFIM,' + #13#10 +
                        '                                     LAST_DAY(TO_DATE('+Quotedstr(sMesReferencia)+', ''YYYY/MM''))),' + #13#10 +
                        '                                 LAST_DAY(TO_DATE('+Quotedstr(sMesReferencia)+', ''YYYY/MM''))),' + #13#10 +
                        '                           LAST_DAY(TO_DATE('+Quotedstr(sMesReferencia)+', ''YYYY/MM'')),' + #13#10 +
                        '                           30,' + #13#10 +
                        '                           EXTRACT(DAY FROM' + #13#10 +
                        '                                   LEAST(NVL(HPG.DATAFIM,' + #13#10 +
                        '                                             LAST_DAY(TO_DATE('+Quotedstr(sMesReferencia)+',' + #13#10 +
                        '                                                              ''YYYY/MM''))),' + #13#10 +
                        '                                         LAST_DAY(TO_DATE('+Quotedstr(sMesReferencia)+',' + #13#10 +
                        '                                                          ''YYYY/MM''))))) -' + #13#10 +
                        '                 EXTRACT(DAY FROM' + #13#10 +
                        '                            GREATEST(CASE' + #13#10 +
                        '                                       WHEN (EXTRACT(DAY FROM(HPG.DATAINICIO)) = 31) THEN' + #13#10 +
                        '                                        HPG.DATAINICIO - 1' + #13#10 +
                        '                                       ELSE' + #13#10 +
                        '                                        HPG.DATAINICIO' + #13#10 +
                        '                                     END,' + #13#10 +
                        '                                     (''01'' || SUBSTR('+Quotedstr(sMesReferencia)+', 5, 3)) || ''/'' ||' + #13#10 +
                        '                                     SUBSTR('+Quotedstr(sMesReferencia)+', 0, 4)))))' + #13#10 +
                        '                                     END / 30)),' + #13#10 +
                        '             4) AS PERCGRUPOFAMILIAR' + #13#10 +
}
                        '' + #13#10 +
                        '  FROM HSTPERCGRUPO HPG' + #13#10 +
                        ' WHERE HPG.IDPLANOPREV    = ' +IntToStr(iIdPlanoPrev) + #13#10 +
                        '   AND HPG.IDBENEFICIO    = ' +IntToStr(iIdBeneficio) + #13#10 +
                        '   AND HPG.NUMEROPROCESSO = ' +sNumeroProcesso + #13#10 +
                        '   AND HPG.IDPESSJUR      = ' +IntToStr(iIdPessJur) + #13#10 +
                        '   AND HPG.IDTITULAR      = ' +IntToStr(iIdTitular) + #13#10 +
                        '   AND HPG.IDPESSOA       = ' +IntToStr(iIdPessoa) + #13#10 +
                        '   AND HPG.SEQPROPOSTA    = ' +IntToStr(iSeqProposta) + #13#10 +
                        '   AND TO_CHAR(HPG.DATAINICIO, ''YYYY/MM'') <= '+Quotedstr(sMesReferencia)+'' + #13#10 +
                        '   AND (TO_CHAR(HPG.DATAFIM, ''YYYY/MM'') >= '+Quotedstr(sMesReferencia)+' OR HPG.DATAFIM is null)' + #13#10 +
                        ' ORDER BY HPG.DATAINICIO DESC');
         // SIG51394 Ajuste na SQL Final
       end;

       qryAux.Open;
       if not qryAux.eof then
          sPercentual := qryAux.FieldByName('PERCGRUPOFAMILIAR').AsString;

       if Trim(sPercentual) = '' then
       begin
         {se não achou na hstpercgrupo busca da titplan}
         qryAux.close;
