        dValorFABNoMes   := rVlrCalculo;                                                           // edilaine - SOL 253577-17514 / PPM 971383

     end;  // edilaine - SOL 253577-17464 / PPM 955703

     if (rVlrBCDeficit <> '')  and (StrToFloat(rVlrBCDeficit) > 0) then   // edilaine - SOL 253577-17464 / PPM 955703
     begin

        rVlrCalculo := StrToFloat(rVlrBCDeficit);
        rVlrCalculo := CalculaBeneficioAPagarNoMes( qryAux,
