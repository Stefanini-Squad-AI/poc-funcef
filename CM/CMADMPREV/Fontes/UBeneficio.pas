                                                         );
        dValorDeficitNoMes   := rVlrCalculo;                                                               // edilaine - SOL 253577-17514 / PPM 971383

     end;   // edilaine - SOL 253577-17464 / PPM 955703


    //edilaine - SIG89790 - inicio
     if (bApresentaBSFAB) and (piTipoMov = 7) and (bReajustou) then
     Begin
       try
          if rValorBsTitular <> '' then
             rVlrTotTitular := FloatToStr(dValorBSTitular + dValorFABTitular);

          AtualizaBSFAB(qryAux, rValorBSRateado, FloatToStr(dValorBSIntegral),
                        rValorFABRateado, FloatToStr(dValorFABIntegral),
                        piIDBeneficiario, piIDTITULAR, piIDPLANOPREV, piIDPESSJUR, piIdBeneficio,
                        piNUMEROPROCESSO, piSEQPROPOSTA,
                        rValorBsTitular, rValorFabTitular, rVlrTotTitular   //edilaine WO18367
                        );
