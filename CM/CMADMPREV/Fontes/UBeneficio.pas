function RetornaNumeroDependentes(iIdTitular, iIdBeneficio : integer; sDataFim : string) : integer;
var
  qry : TwwQuery;
begin
  Result := 0;
  qry := TwwQuery.Create(nil);
  try
    qry.DatabaseName :=  'BaseDados';
    qry.Close;
    qry.SQL.Clear;
    qry.SQL.Add('SELECT DISTINCT (100 / bt.percentual) TOTAL ');
    qry.SQL.Add('  FROM BFCIARIOTITPLAN BT          ');
    qry.SQL.Add(' WHERE(BT.DATAFIMRECEB >= to_date('+QuotedStr(sDataFim)+', ''DD/MM/YYYY'')' );
    qry.SQL.Add('    OR BT.DATAFIMRECEB IS NULL) '                 );
    qry.SQL.Add('   AND BT.IDBENEFICIO = '+ IntToStr(iIdBeneficio) );
    qry.SQL.Add('   AND BT.IDTITULAR   = '+ IntToStr(iIdTitular)   );

    try
      qry.Open;

      if not(qry.IsEmpty) then
        Result := qry.FieldByName('TOTAL').AsInteger;

    except
      result := 0;
    end;

  finally
    FreeAndNil(qry);
  end;
end;


function PegaValorBsFabTitular(qryAux            : TwwQuery;
                               piIdPlanoPrev,
                               piIdPessJur,
                               piIdPessoa,
                               piIdTitular,
                               piIdBeneficio     : longint;
                               psMesReferencia   : string;
                               sFontePagadora    : string;
                               iIdTpPagtoBenef   : integer;
                               iIdPlanPrevContab : integer;
                               var  rVlrBS       : double;
                               var  rVlrFab      : double ) : boolean;
begin

   try
     qryAux.sql.clear;
     qryAux.sql.Add('SELECT NVL(BF.VLRFABTOTAL, BS.SALDOFAB) AS SALDOFAB, ');
     qryAux.sql.Add('       CASE                                          ');
     qryAux.sql.Add('         WHEN BPP.FLGAPRESENTABSFAB = 1 THEN         ');
     qryAux.sql.Add('           NVL(BF.VLRBSTOTAL, BS.BENEFSALDADO)       ');
     qryAux.sql.Add('         ELSE                                        ');
     qryAux.sql.Add('           NVL(BF.VALORTOTAL, BS.BENEFSALDADO)       ');
     qryAux.sql.Add('       END BENEFSALDADO                              ');
     qryAux.sql.Add('  FROM DEPENTIT D                                  ');
     qryAux.sql.Add('  LEFT JOIN BENEFSALDFAB BS ON  BS.IDTITULAR = D.IDTITULAR ');
     qryAux.sql.Add('                            AND BS.IDPESSOA  = D.IDPESSOA  ');
     qryAux.sql.Add('                            AND BS.MESREFERENCIA = '+ Quotedstr(psMesReferencia) );
     qryAux.sql.Add('  LEFT JOIN BENEFBFCIARIO BF ON BF.IDTITULAR = D.IDTITULAR  ');
     qryAux.sql.Add('                            AND BF.IDPESSOA  = D.IDTITULAR   ');
     qryAux.sql.Add('                            AND BF.IDPESSOA        <> '+ IntToStr(piIdPessoa) );
     qryAux.sql.Add('                            AND BF.IDPLANOPREV      = '+ IntToStr(piIdPlanoPrev) );
     qryAux.sql.Add('                            AND BF.FONTEPAGADORA    = '+ sFontePagadora );
     qryAux.sql.Add('                            AND BF.IDTPPAGTOBENEFIC = 1' );  //+ IntToStr(iIdTpPagtoBenef) );
     qryAux.sql.Add('                            AND BF.IDPLANPREVCONTAB = '+ IntToStr(iIdPlanPrevContab) ) ;
     qryAux.sql.Add('  LEFT JOIN BENEFPLANPREV BPP ON BF.IDBENEFICIO = BPP.IDBENEFICIO  ');
     qryAux.sql.Add('                             AND BF.IDPLANOPREV = BPP.IDPLANOPREV  ');
     qryAux.sql.Add(' WHERE D.IDTITULAR = '+ IntToStr(piIdTitular) );
     qryAux.sql.Add('   AND D.IDPESSOA  = '+ IntToStr(piIdTitular) );
     qryAux.sql.Add(' ORDER BY BF.NUMEROPROCESSO desc, BS.IDBENEFSALDFAB DESC' );      // WO26671 Ferrari
     qryAux.Open;

     if not qryAux.eof then
     begin
       rVlrFab := qryAux.fieldByName('SALDOFAB').AsCurrency;
       rVlrBS  := qryAux.fieldByName('BENEFSALDADO').AsCurrency;
     end
     else
     begin
       rVlrFab := 0;
       rVlrBS  := 0;
     end;
     qryAux.close;

     result := true;

   except
     qryAux.close;
     result := false;
   end;

end;
