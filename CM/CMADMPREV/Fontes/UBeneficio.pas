  dValorBeneficioNoMes := dValorEmReal;

   // edilaine - SOL 253577-17464 / PPM 955703   inicio
   { Trazer os valores fora do laço para que a variavel passe para o proximo mes calculado o valor revisado.
   }
   qryAux.Close;
