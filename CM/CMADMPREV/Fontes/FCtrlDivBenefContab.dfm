  object qryAnalitica: TwwQuery
    AfterOpen = qryAnaliticaAfterOpen
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT h.idpessoa,'
      
        '       (select matricula from depentit d where d.idpessoa = c.id' +
        'pessoa and d.idtitular = c.idtitular) as Matrícula,'
      
        '       (select nome from pessoa p where p.idpessoa = c.idpessoa)' +
        ' as Nome,'
      '       (select idplanprevcontab'
      '          from benefbfciario b'
      '         where b.idplanoprev = c.idplanoprev'
      '           and b.idpessoa = c.idpessoa'
      '           and b.idtitular = c.idtitular'
      '           and b.idbeneficio = c.idbeneficio'
      '           and b.idpessjur = c.idpessjur and rownum = 1'
      '       ) as PlanoContab,'
      '       C.Data as DtLancDivida,'
      '       C.Valorbeneficio      as VlrBenef,'
      '       C.Saldodevedorinicial as SaldoDevIni,'
      '       C.Saldodevedoratual   as SaldoDevAtual,'
      '       C.Valorultimaparcela  as UltParcela,'
      '       H.VALORPREVISTO       as VlrParcela,'
      '       DECODE(H.FLGSITUACAO, 0, '#39'Preparada'#39','
      '                             1, '#39'Enviada'#39',  '
      '                             2, '#39'Enviada e Não Recebida'#39','
      '                             3, '#39'Recebida'#39','
      '                             4, '#39'Recebida com Divergência'#39','
      '                             5, '#39'Suspensa'#39', '#39#39') as SituacaoParc,'
      '       C.Mesinicio  as IniCobr,'
      '       C.Mesfim     as FimCobr,'
      '       C.Percentual as Percentual,'
      '       C.Quantidadeparcelaspagas as QtdePagas,'
      '       C.Qtdeparcelas as QtdeParcelas,'
      '       NVL(H.ValorRecebido,0) as VlrRecebido,'
      
        '       NVL((C.Saldodevedoratual - H.ValorRecebido),0) as SldRema' +
        'nescente,'
      '       CASE'
      '         WHEN C.FLGSTATUS = 1 THEN '#39'DÍVIDA ATIVA'#39
      
        '         WHEN C.FLGSTATUS = 2 AND C.FLGACAOJUD = 1 THEN '#39'SUSPENS' +
        'A - JUD'#39
      
        '         WHEN C.FLGSTATUS = 2 AND C.FLGACAOJUD = 0 THEN '#39'SUSPENS' +
        'A - ADM'#39
      
        '         WHEN C.FLGSTATUS = 3 AND C.FLGQUITADO = 1 THEN '#39'DÍVIDA ' +
        'QUITADA'#39
      
        '         WHEN C.FLGSTATUS = 3 AND C.FLGQUITADO = 0 THEN '#39'DÍVIDA ' +
        'ENCERRADA'#39
      '       END as SituacaoDivida,'
      '       C.OBSERVACAO as Motivo,'
      '       H.OBSERVACAO,'
      '       -- provisao de perda'
      '       NVL(PA.PROVPERDA_ANT, 0) as SldProvisaoAnt,'
      '       PP.REVERSAO as ReversaoProv,'
      '       PP.PROVISAO as Provisionar,'
      
        '       NVL(PA.PROVPERDA_ANT, 0) + PP.REVERSAO + PP.PROVISAO as S' +
        'aldoProvisao,'
      ''
      '       -- provisao de baixa'
      '       NVL(PA.PROVBAIXA_ANT, 0) as ProvBaixaDef,'
      '       '
      '       -- parametros contabeis'
      '       CASE'
      '         WHEN C.FLGSTATUS = 1 '
      '           THEN BP.PLACONTACDIVATIVA'
      '         WHEN C.FLGSTATUS = 2 AND C.FLGACAOJUD = 1 '
      '           THEN BP.PLACONTACDIVSUSPJ'
      '         WHEN C.FLGSTATUS = 2 AND C.FLGACAOJUD = 0 '
      '           THEN BP.PLACONTACDIVSUSPA'
      '         WHEN C.FLGSTATUS = 3 AND C.FLGQUITADO = 1 '
      '           THEN BP.PLACONTACDIVQUIT '
      '       END as PLACONTAC,'
      '       '
      '       CASE'
      '         WHEN C.FLGSTATUS = 1 '
      '           THEN BP.PLACONTADDIVATIVA'
      '         WHEN C.FLGSTATUS = 2 AND C.FLGACAOJUD = 1 '
      '           THEN BP.PLACONTADDIVSUSPJ'
      '         WHEN C.FLGSTATUS = 2 AND C.FLGACAOJUD = 0 '
      '           THEN BP.PLACONTADDIVSUSPA'
      '         WHEN C.FLGSTATUS = 3 AND C.FLGQUITADO = 1 '
      '           THEN BP.PLACONTADDIVQUIT '
      '       END as PLACONTAD,'
      '       '
      '       BP.PLACONTACPROVIS,'
      '       BP.PLACONTADPROVIS        '
      '                   '
      '  FROM HSTDIVIDABENEFICIO       H'
      ''
      '  JOIN CONTROLEDIVIDABENEFICIO  C'
      '    ON C.IDCONTROLEDIVIDABENEFICIO = H.IDCONTROLEDIVIDABENEFICIO'
      ''
      '  JOIN BENEFPLANPREV BP'
      '    ON BP.IDBENEFICIO = C.IDBENEFICIO'
      '   AND BP.IDPLANOPREV = C.IDPLANOPREV'
      ''
      '  JOIN (SELECT H2.IDCONTROLEDIVIDABENEFICIO, '
      '               CASE'
      
        '                 WHEN (C2.Saldodevedoratual - H2.ValorRecebido) ' +
        '= 0 '
      '                   THEN H2.ValorRecebido'
      
        '                 WHEN (H2.VALORPREVISTO - H2.ValorRecebido) < 0 ' +
        '    '
      '                   THEN (H2.VALORPREVISTO - H2.ValorRecebido)'
      '                 ELSE  '
      '                   0'
      '               END as REVERSAO,'
      
        '               DECODE(SIGN(H2.VALORPREVISTO - H2.ValorRecebido),' +
        ' '
      
        '                       1, (H2.VALORPREVISTO - H2.ValorRecebido),' +
        ' 0) as PROVISAO'
      '          FROM HSTDIVIDABENEFICIO      H2'
      '          JOIN CONTROLEDIVIDABENEFICIO C2 '
      
        '            ON C2.IDCONTROLEDIVIDABENEFICIO = H2.IDCONTROLEDIVID' +
        'ABENEFICIO'
      '         WHERE H2.MESCOBRANCA = :MESCOBRANCA'
      '       ) PP '
      
        '    ON PP.IDCONTROLEDIVIDABENEFICIO = H.IDCONTROLEDIVIDABENEFICI' +
        'O'
      ''
      '  LEFT '
      '  JOIN (SELECT H1.IDCONTROLEDIVIDABENEFICIO, '
      '                    H1.PROVISAOPERDA AS PROVPERDA_ANT,'
      '                    H1.PROVISAOBAIXA AS PROVBAIXA_ANT'
      '               FROM HSTDIVIDABENEFICIO H1'
      
        '              WHERE H1.MESCOBRANCA = TO_CHAR(ADD_MONTHS(TO_DATE(' +
        ':MESCOBRANCA||'#39'/01'#39', '#39'YYYY/MM/DD'#39'),-1), '#39'YYYY/MM'#39')'
      '       ) PA'
      
        '    ON PA.IDCONTROLEDIVIDABENEFICIO = H.IDCONTROLEDIVIDABENEFICI' +
        'O'
      ' WHERE C.FONTEPAGADORA = 1'
      '   AND H.MESCOBRANCA   = :MESCOBRANCA'
      ' ORDER BY 2   ')
    ValidateWithMask = True
    Left = 633
    Top = 107
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MESCOBRANCA||'#39'/01'#39
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
      end>
  end
