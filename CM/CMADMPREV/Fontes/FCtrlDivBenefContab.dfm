  object qryPlanos: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT PP.*'
      '  FROM PLANPREV PP'
      ' WHERE EXISTS (SELECT 1'
      '                 FROM PLANPREVCONTABIL PC  '
      '                 JOIN PERFILINVEST PI'
      '                   ON PC.IDPLANOPREV = PI.IDPLANPREVCONTAB'
      '                  AND PC.IDPLANOPREVPREV = PP.IDPLANOPREV )'
      'ORDER BY PP.IDPLANOPREV')
    ValidateWithMask = True
    Left = 713
    Top = 147
  end
  object qryContaItens: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      ''
      'SELECT P.* FROM (         '
      
        'SELECT 1 AS ITEM, '#39'FORMASALDO'#39' AS TIPO, PLACONTACDIVSALDO AS PLA' +
        'CONTAC, PLACONTADDIVSALDO AS PLACONTAD, IDPLANOPREV  FROM PLANPR' +
        'EV'
      'UNION'
      
        'SELECT 2 AS ITEM, '#39'REVFORMASALDO'#39' AS TIPO, PLACONTACDIVSLDREV AS' +
        ' PLACONTAC, PLACONTADDIVSLDREV AS PLACONTAD, IDPLANOPREV FROM PL' +
        'ANPREV'
      'UNION'
      
        'SELECT 3 AS ITEM, '#39'BAIXA'#39' AS TIPO, PLACONTACDIVBAIXA AS PLACONTA' +
        'C, PLACONTADDIVBAIXA AS PLACONTAD, IDPLANOPREV   FROM PLANPREV'
      'UNION'
      
        'SELECT 4 AS ITEM, '#39'REVBAIXA'#39' AS TIPO, PLACONTACDIVBAIXAREV AS PL' +
        'ACONTAC, PLACONTADDIVBAIXAREV AS PLACONTAD, IDPLANOPREV    FROM ' +
        'PLANPREV'
      'UNION'
      
        'SELECT 5 AS ITEM, '#39'PROVISAO'#39' AS TIPO, PLACONTACDIVPROVISAO AS PL' +
        'ACONTAC, PLACONTADDIVPROVISAO AS PLACONTAD, IDPLANOPREV    FROM ' +
        'PLANPREV'
      'UNION'
      
        'SELECT 6 AS ITEM, '#39'REVPROVISAO'#39' AS TIPO, PLACONTACDIVPROVREV AS ' +
        'PLACONTAC, PLACONTADDIVPROVREV AS PLACONTAD, IDPLANOPREV    FROM' +
        ' PLANPREV'
      'UNION'
      
        'SELECT 7 AS ITEM, '#39'REAJUSTE'#39' AS TIPO, PLACONTACDIVATUREAJ AS PLA' +
        'CONTAC, PLACONTADDIVATUREAJ AS PLACONTAD, IDPLANOPREV    FROM PL' +
        'ANPREV'
      ') P            '
      'WHERE P.IDPLANOPREV = :IDPLANOPREV             '
      ' ')
    ValidateWithMask = True
    Left = 713
    Top = 215
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end>
  end
