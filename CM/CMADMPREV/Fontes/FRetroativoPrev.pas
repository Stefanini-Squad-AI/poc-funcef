             '        BF.DATAINICIO,     BF.DATAREQUERIMENTO, BF.VLRINFINSS,                                             '+
             '        BF.VLRCALCINSS,    BF.VALORSRB,                                                                    '+
             '        EL.IDSITFUNC,      PP.IDSITPART,        PP.IDSITPLANOPREV,                                         '+
             '        PP.INSCRICAODATA,  PP.DTINICIOINSC,     PP.DATACANCELAMENTO,                                       '+
