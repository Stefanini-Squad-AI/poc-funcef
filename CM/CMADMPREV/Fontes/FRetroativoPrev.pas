procedure TfrmRetroativoPREV.AcrescentaContribuicao;
var sBeneficioFuncefAtivo : String;
fValorAlteradorContrib : Real;
sSQLContribuicao : String;

sSQLStream : TStringStream;

begin
  //Coloca as Contribuições na mesma linha do Beneficio

  QryTotalContrib.Close;
  QryTotalContrib.SQL.Clear;

  if Trim(sSQLRelatorio) <> '' then begin
    sSQLRelatorio := copy(sSQLRelatorio,1,length(sSQLRelatorio)-6);
    sSQLRelatorio := 'SELECT * FROM('+sSQLRelatorio+ ') ORDER BY IDPESSOA ,ORDEM, DESCRICAO, ANOMES DESC ';

    sSQLStream := TStringStream.Create(sSQLRelatorio);
    QryDemonstrativoRel.SQL.LoadFromStream(sSQLStream);

    QryDemonstrativoRel.Open;

    QryDemonstrativoEspelho.First;
    sBeneficioFuncefAtivo :='';
    sSQLContribuicao      :='';
    
    while not QryDemonstrativoEspelho.Eof do begin
      if (QryDemonstrativoEspelho.FieldByname('ANOMES').asString <> '0000/00') and (QryDemonstrativoEspelho.FieldByname('TIPO').asString = 'C') then begin

        QryAux.Close;
        QryAux.SQL.Clear;
        QryAux.SQL.Add(' SELECT IDBENEFICIO FROM BENEFBFCIARIO');
        QryAux.SQL.Add('  WHERE IDPESSOA    =' + QryDemonstrativoEspelho.FieldByname('IDPESSOA').asString);
        QryAux.SQL.Add('  AND FONTEPAGADORA   = 1');
        QryAux.Open;

        //Renato Visoni SOL 142882 Kintana 917865.
        QryAux.First;
        while not QryAux.Eof do begin
          if QryDemonstrativoRel.Locate('ANOMES;IDENTIFICADOR;IDPESSOA;IDPLANOPREV', varArrayOf([QryDemonstrativoEspelho.FieldByname('ANOMES').asstring,QryAux.FieldByname('IDBENEFICIO').asString,QryDemonstrativoEspelho.FieldByname('IDPESSOA').asstring,QryDemonstrativoEspelho.FieldByname('IDPLANOPREV').asstring]),[])
          then begin
            sBeneficioFuncefAtivo := QryAux.FieldByname('IDBENEFICIO').asString;
            Break;
          end;
          QryAux.Next;
        end;
        //Renato Visoni SOL 142882 Kintana 917865.

        sBeneficioFuncefAtivo := QryAux.FieldByname('IDBENEFICIO').asString;


        if QryDemonstrativoRel.Locate('ANOMES;IDENTIFICADOR;IDPESSOA;IDPLANOPREV', varArrayOf([QryDemonstrativoEspelho.FieldByname('ANOMES').asstring,sBeneficioFuncefAtivo,QryDemonstrativoEspelho.FieldByname('IDPESSOA').asstring,QryDemonstrativoEspelho.FieldByname('IDPLANOPREV').asstring]),[]) then begin

          fValorAlteradorContrib:=0;
          if QryDemonstrativoEspelho.FieldByname('TIPO').asString = 'C' then begin
            if DbLkcIncluiAlterador.Text = 'Sim' then begin

               // SOL 197202 KINTANA 1890795
               //If (Copy(QryDemonstrativoEspelho.FieldByName('ANOMES').AsString,6,2) <> '13') Then
                 sAnoMesAtualCalcAlt := QryDemonstrativoEspelho.FieldByName('ANOMES').AsString;
               //else
               //  sAnoMesAtualCalcAlt := Copy(QryDemonstrativoEspelho.FieldByName('ANOMES').AsString,1,5)+'11';
               // SOL 197202 KINTANA 1890795

              sSQL := 'SELECT SUM(HA.VALOR) AS VALOR '+
                          'FROM HSTCONTRIBPREV H, HSTATRASOCONTRIB HA, TIPOALTERADOR T      '+
                          'WHERE     H.IDPLANOPREV    = '+QryDemonstrativoEspelho.FieldByName('IDPLANOPREV').AsString      +' '+
                          '      AND H.IDPESSOA       = '+QryDemonstrativoEspelho.FieldByName('IDPESSOA').AsString         +' '+
                          '      AND H.IDCONTRIBUICAO = '+QryDemonstrativoEspelho.FieldByName('IDENTIFICADOR').AsString    +' '+
                          '      AND H.MESCOBRANCA    = '''+edMesAcerto.Text+''''+
                          '      AND H.MESREFERENCIA  = '+QuotedStr(sAnoMesAtualCalcAlt)+'  '+  // SOL 197202 KINTANA 1890795
                          '      AND H.IDMOTIVO       = '+qryMotivo.FieldByName('IDMOTIVO').AsString               +
                          '      AND H.IDLOTE         = '+qryLote.FieldByName('IDLOTE').AsString                   +
                          '      AND H.NUMRECEBIMENTO = HA.NUMRECEBIMENTO '+
                          '      AND HA.CODALTERADOR  = T.CODALTERADOR ' ;


              If FazQuery(QryAux,sSQL) then Begin
                fValorAlteradorContrib  := QryAux.FieldByname('VALOR').asFloat;
                //if (qryDemonstrativo.FieldByname('VALORDEPOIS').asFloat - qryDemonstrativo.FieldByname('VALORANTES').asFloat) < 0 then begin
                  //fValorAlteradorContrib := fValorAlteradorContrib*-1;
                //end;
              end;
            end;
          end;

          QryDemonstrativoRel.Edit;
          QryDemonstrativoRel.FieldByname('CONTRIBDEVIDA').asFloat     := QryDemonstrativoRel.FieldByname('CONTRIBDEVIDA').asFloat     + QryDemonstrativoEspelho.FieldByname('VALORDEPOIS').asFloat;
          QryDemonstrativoRel.FieldByname('CONTRIBDESCONTADA').asFloat := QryDemonstrativoRel.FieldByname('CONTRIBDESCONTADA').asFloat + QryDemonstrativoEspelho.FieldByname('VALORANTES').asFloat;
          QryDemonstrativoRel.FieldByname('IDCONTRIBUICAO').asString   := QryDemonstrativoEspelho.FieldByname('IDENTIFICADOR').asString;
          QryDemonstrativoRel.FieldByname('ALTERADORCONTRIB').asFloat  := fValorAlteradorContrib;
          QryDemonstrativoRel.Post;

          {
          QryTotalContrib.SQL.Add('SELECT');
          QryTotalContrib.SQL.Add(QryDemonstrativoRel.FieldByname('MATRICULA').asString +' AS MATRICULA,');
          QryTotalContrib.SQL.Add(QryDemonstrativoEspelho.FieldByname('IDENTIFICADOR').asString +' AS IDENTIFICADOR,');
          QryTotalContrib.SQL.Add(QuotedStr(QryDemonstrativoRel.FieldByname('CONTRIBDEVIDA').asString) +' AS DEVIDACONTRIB,' );
          QryTotalContrib.SQL.Add(QuotedStr(QryDemonstrativoRel.FieldByname('CONTRIBDESCONTADA').asString) + ' AS PAGACONTRIB,         ');
          QryTotalContrib.SQL.Add(QuotedStr(FloatTostr(fValorAlteradorContrib)) + ' AS ALTERADORCONTRIB         ');
          QryTotalContrib.SQL.Add('FROM DUAL UNION ALL');
          }

          sSQLContribuicao := sSQLContribuicao + ' SELECT '+ QryDemonstrativoRel.FieldByname('MATRICULA').asString +' AS MATRICULA,';
          sSQLContribuicao := sSQLContribuicao + QryDemonstrativoEspelho.FieldByname('IDENTIFICADOR').asString +' AS IDENTIFICADOR,';
          sSQLContribuicao := sSQLContribuicao + QuotedStr(QryDemonstrativoRel.FieldByname('CONTRIBDEVIDA').asString) +' AS DEVIDACONTRIB,' ;
          sSQLContribuicao := sSQLContribuicao + QuotedStr(QryDemonstrativoRel.FieldByname('CONTRIBDESCONTADA').asString) + ' AS PAGACONTRIB,';
          sSQLContribuicao := sSQLContribuicao + QuotedStr(FloatTostr(fValorAlteradorContrib)) + ' AS ALTERADORCONTRIB';
          sSQLContribuicao := sSQLContribuicao + ' FROM DUAL UNION ALL';

        end;
      end;
      QryDemonstrativoEspelho.Next;
    end;
  end;

  if Trim(sSQLContribuicao) = '' then begin
    QryTotalContrib.SQL.Add('SELECT 0 AS MATRICULA, 0 AS IDENTIFICADOR, 0 AS DEVIDACONTRIB, 0 AS PAGACONTRIB, 0 ALTERADORCONTRIB FROM DUAL');
  end else begin
    sSQLContribuicao         := copy(sSQLContribuicao,1,length(sSQLContribuicao)-10 );

    if sSQLStream <> nil then
      FreeAndNil(sSQLStream);

    sSQLStream := TStringStream.Create(sSQLContribuicao);
    QryTotalContrib.SQL.LoadFromStream(sSQLStream);

  end;
  QryTotalContrib.Open;
  QryDemonstrativoRel.First;


  if sSQLStream <> nil then
  FreeAndNil(sSQLStream);

end;

