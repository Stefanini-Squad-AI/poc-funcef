                  '      AND H.MES           = '''+edMesAcerto.Text+''''+
                  '      AND H.MESREFERENCIA = '+QuotedStr(qryDemonstrativo.FieldByName('ANOMES').AsString)+'  ';
          If FazQuery(QryAux,sSQL) Then Begin
            While Not QryAux.EOF Do Begin
