            qryAux.Sql.Add('       CPP.SEQPROPOSTA = '+qryDadosBeneficio.FieldByName('SEQPROPOSTA').AsString+' AND ');
            qryAux.Sql.Add('       CPP.IDBENEFICIO = '+qryDadosBeneficio.FieldByName('IDBENEFICIO').AsString+' AND ');
