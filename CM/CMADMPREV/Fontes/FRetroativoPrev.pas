// *****************************************************************************
// REAJUSTE DE BENEFICIO RETROATIVO
// *****************************************************************************
function  TfrmRetroativoPREV.ProcessaRevisaoBeneficio ( psAnoMesIni      : string;
                                psAnoMesFim      : string;
                                piIdPessJur      : longint;
                                piIdPlanoPrev    : longint;
                                piIdTitular      : longint;
                                piIdPessoa       : longint;
                                piSeqProposta    : longint;
                                psContribuicoes  : string ) : Integer; // -1 : erro
                                                                       //  0 : ok
                                                                       //  1 : nada encontrado
                                                                       //  2 : cancelado -> avisar
   procedure  PR_apagar_retro(MesRef,sIdMotivo,sAnoMesAcertoRetroativo:string;
                              bBeneficioParaTitular,bExisteRevisao  :Boolean;
                              iIdRespContribuicao,iIdMovBenefExcluir,
                              iProcesso :INTEGER);  // edilaine - SOL 253577-17661 / PPM 1019931
   var qryaux2 : Twwquery;
   begin
     qryaux2 := twwquery.Create(Nil);
     qryaux2.DatabaseName := 'BASEDADOS';
     {Apaga calculos anteriores}
     if bExisteRevisao then
     begin
        Close;
        qryaux2.SQL.Clear;
        qryaux2.SQL.Add(' DELETE HSTATRASOBENEF '+
                        ' WHERE  IDPESSJUR    = '+qryPessoasATratar.FieldByName('IDPESSJUR').AsString+
                        ' AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                        ' AND    IDTITULAR    = '+qryPessoasATratar.FieldByName('IDTITULAR').AsString );

        if rbtnIndividual.Checked then
           qryaux2.SQL.Add(' AND IDPESSOA = '+ IntToStr(iIdPessoa) );

        qryaux2.SQL.Add(' AND    SEQPROPOSTA   = '+qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString+
                        ' AND    IDMOTIVO      = '+sIdMotivo+
                        ' AND    IDBENEFICIO IN ('+sBeneficios+') '+
                        ' AND    MESREFERENCIA = '+QuotedStr(MesRef)+ //Fernando Santana sol 132687
                        ' AND    NUMEROPROCESSO = '+IntToStr(iProcesso) +  // edilaine - SOL 253577-17661 / PPM 1019931
                        ' AND    MES           = '''+edMesAcerto.Text+'''');

        qryaux2.SQL.Add(' AND EXISTS ( SELECT 1                                       '+
                        '              FROM HSTBENEFBFCIARIO  HIN                     '+
                        '              WHERE  HIN.IDPESSJUR     = HSTATRASOBENEF.IDPESSJUR     AND '+
                        '                     HIN.IDPLANOPREV   = HSTATRASOBENEF.IDPLANOPREV   AND '+
                        '                     HIN.IDTITULAR     = HSTATRASOBENEF.IDTITULAR     AND '+
                        '                     HIN.IDPESSOA      = HSTATRASOBENEF.IDPESSOA      AND '+
                        '                     HIN.SEQPROPOSTA   = HSTATRASOBENEF.SEQPROPOSTA   AND '+
                        '                     HIN.IDMOTIVO      = HSTATRASOBENEF.IDMOTIVO      AND '+
                        '                     HIN.IDBENEFICIO   = HSTATRASOBENEF.IDBENEFICIO   AND '+
                        '                     HIN.MESREFERENCIA = HSTATRASOBENEF.MESREFERENCIA AND '+
                        '                     HIN.MES           = HSTATRASOBENEF.MES           AND '+
                        '                     HIN.FLGENVIADO    = 0)                ');



        try
           qryaux2.ExecSQL;
        except
           Exit;
        end;

              //fernando
        qryaux2.Close;
        qryaux2.SQL.Clear;

        if bBeneficioParaTitular then
        begin
           sSQL := 'SELECT 1 FROM HSTATRASOCONTRIB WHERE NUMRECEBIMENTO IN '+
                   ' (SELECT NUMRECEBIMENTO FROM HSTCONTRIBPREV '+
                   '  WHERE  IDPESSJUR    = '+qryPessoasATratar.FieldByName('IDPESSJUR').AsString+
                   '  AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                   '  AND    IDPESSOA     = '+qryPessoasATratar.FieldByName('IDPESSOA').AsString+
                   '  AND    SEQPROPOSTA  = '+qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString+
                   '  AND    IDMOTIVO     = '+sIdMotivo+
                   '  AND    SITRECEBIMENTO = 0 '+
                   '  AND    MESREFERENCIA = '+QuotedStr(MesRef)+ //Fernando Santana sol 132687
                   '  AND    MESCOBRANCA  = '''+edMesAcerto.Text+''')';

           If FazQuery ( qryaux2, sSQL ) Then
           Begin
              qryaux2.Close;
              qryaux2.SQL.Clear;

              qryaux2.SQL.Add(' DELETE HSTATRASOCONTRIB WHERE NUMRECEBIMENTO IN '+
                              ' (SELECT NUMRECEBIMENTO FROM HSTCONTRIBPREV '+
                              '  WHERE  IDPESSJUR    = '+qryPessoasATratar.FieldByName('IDPESSJUR').AsString+
                              '  AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                              '  AND    IDPESSOA     = '+qryPessoasATratar.FieldByName('IDPESSOA').AsString+
                              '  AND    SEQPROPOSTA  = '+qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString+
                              '  AND    IDMOTIVO     = '+sIdMotivo+
                              '  AND    SITRECEBIMENTO = 0 '+
                              '  AND    MESREFERENCIA = '+QuotedStr(MesRef)+ //Fernando Santana sol 132687
                              '  AND    MESCOBRANCA  = '''+edMesAcerto.Text+''')');

              try
                 qryaux2.ExecSQL;
              except
                 Exit;
              end;
           end;

        end
        else
        begin
           qryaux2.SQL.Add(' DELETE  HSTATRASOCONTRIB WHERE NUMRECEBIMENTO IN '+
                           ' (SELECT NUMRECEBIMENTO FROM HSTCONTRIBPREV '+
                           '  WHERE  IDPESSJUR    = '+qryPessoasATratar.FieldByName('IDPESSJUR').AsString+
                           '  AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                           '  AND    IDPESSOA     = '+IntToStr(iIdRespContribuicao)+
                           '  AND    SEQPROPOSTA  = '+qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString+
                           '  AND    IDMOTIVO     = '+sIdMotivo+
                           '  AND    SITRECEBIMENTO = 0 '+
                           '  AND    MESREFERENCIA = '+QuotedStr(MesRef)+ //Fernando Santana sol 132687
                           '  AND    MESCOBRANCA  = '''+edMesAcerto.Text+''')');
           try
              qryaux2.ExecSQL;
           except
              Exit;
           end;

        end;


        qryaux2.Close;
        qryaux2.SQL.Clear;

        if bBeneficioParaTitular Then
        Begin
           sSQL := 'SELECT 1 FROM  HSTCONTRIBPREV '+
                   ' WHERE  IDPESSJUR    = '+qryPessoasATratar.FieldByName('IDPESSJUR').AsString+
                   ' AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                   ' AND    IDPESSOA     = '+qryPessoasATratar.FieldByName('IDPESSOA').AsString+
                   ' AND    SEQPROPOSTA  = '+qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString+
                   ' AND    IDMOTIVO     = '+sIdMotivo+
                   ' AND    SITRECEBIMENTO = 0 '+
                   ' AND    MESREFERENCIA = '+QuotedStr(MesRef)+ //Fernando Santana sol 132687
                   ' AND    MESCOBRANCA  = '''+edMesAcerto.Text+'''';

           If FazQuery ( qryaux2, sSQL ) Then
           Begin
              qryaux2.Close;
              qryaux2.SQL.Clear;

              qryaux2.SQL.Add(' DELETE HSTCONTRIBPREV '+
                              ' WHERE  IDPESSJUR    = '+qryPessoasATratar.FieldByName('IDPESSJUR').AsString+
                              ' AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                              ' AND    IDPESSOA     = '+qryPessoasATratar.FieldByName('IDPESSOA').AsString+
                              ' AND    SEQPROPOSTA  = '+qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString+
                              ' AND    IDMOTIVO     = '+sIdMotivo+
                              ' AND    SITRECEBIMENTO = 0 '+
                              ' AND    MESREFERENCIA = '+QuotedStr(MesRef)+ //Fernando Santana sol 132687
                              ' AND    MESCOBRANCA  = '''+edMesAcerto.Text+'''');

              try
                 qryaux2.ExecSQL;
              except
                 Exit;
              end;

           End;
        End
        Else
        Begin
           qryaux2.SQL.Add(' DELETE HSTCONTRIBPREV H '+
                           ' WHERE  IDPESSJUR    = '+qryPessoasATratar.FieldByName('IDPESSJUR').AsString+
                           ' AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                           ' AND    IDPESSOA     = '+IntToStr(iIdRespContribuicao)+
                           ' AND    SEQPROPOSTA  = '+qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString+
                           ' AND    IDMOTIVO     = '+sIdMotivo+
                           ' AND    SITRECEBIMENTO = 0 '+
                           ' AND    MESREFERENCIA = '+QuotedStr(MesRef)+ //Fernando Santana sol 132687
                           ' AND    MESCOBRANCA  = '''+edMesAcerto.Text+'''');
           try
              qryaux2.ExecSQL;
           except
              Exit;
           end;
        end;

        qryaux2.Close;
        qryaux2.SQL.Clear;
        qryaux2.SQL.Add(' DELETE TMPDESC '+
                        ' WHERE  IDPESSJUR    = '+qryPessoasATratar.FieldByName('IDPESSJUR').AsString+
                        ' AND    IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                        ' AND    IDTITULAR    = '+qryPessoasATratar.FieldByName('IDTITULAR').AsString );

        if rbtnIndividual.Checked then
           qryaux2.SQL.Add(' AND IDPESSOA = '+ IntToStr(iIdPessoa) );

        qryaux2.SQL.Add(' AND    SEQPROPOSTA  = '+qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString+
                        ' AND    IDMOTIVO     = '+sIdMotivo+
                        ' AND    MESREFERENCIA = '+QuotedStr(MesRef)+ //Fernando Santana sol 132687
                        ' AND    MESCOBRANCA  = '''+edMesAcerto.Text+'''');
        try
           qryaux2.ExecSQL;
        except
           Exit;
        end;

        // Apagar PARCELAMENTOS
        qryaux2.Close;
        qryaux2.SQL.Clear;

        If (trim(qryDadosBeneficio.FieldByName('IDRUBRICAREVISAO').AsString) <> '') And
           (trim(qryDadosBeneficio.FieldByName('IDRUBDEVOLUCAO').AsString) <> '')
        Then
        Begin
              { Excluir pelo IDMOVBENEF caso exista }
           if bBeneficioParaTitular then
              qryaux2.SQL.Add(' DELETE RUBRICAINDIV '+
                              ' WHERE  IDPESSOA     = '+ qryPessoasATratar.FieldByName('IDPESSOA').AsString )
           else
              qryaux2.SQL.Add(' DELETE RUBRICAINDIV  '+
                              ' WHERE  IDPESSOA     = '+ IntToStr( iIdRespContribuicao ));

           qryaux2.SQL.Add(' AND  FLGTPRUBMANUT = 1 AND NUMOCORRENCIAS = 0 ' );

           If ( iIdMovBenefExcluir > 0 ) Then
           Begin
              qryaux2.SQL.Add(' AND  IDMOVBENEF = '+ IntToStr( iIdMovBenefExcluir ) + ' ');
              qryaux2.SQL.Add(' AND  ANOMESREF  = ' + QuotedStr( sAnoMesAcertoRetroativo ) + ' ');
           End
           Else
           begin
              qryaux2.SQL.Add(' AND (IDRUBRICA = '+qryDadosBeneficio.FieldByName('IDRUBRICAREVISAO').AsString +' OR '+
                              '      IDRUBRICA = '+qryDadosBeneficio.FieldByName('IDRUBDEVOLUCAO').AsString  +') ');
           end;

           try
              qryaux2.ExecSQL;
           except
           //Brunno Mattos - KTN 767861 - SOL 132659 Inicio
            on e:Exception do
            begin
              TratarErro(e.Message);
              Exit;
           end;
           //Brunno Mattos - KTN 767861 - SOL 132659 Fim

           end;

        End;
     end;
     qryaux2.free;
   end;
var
   sAnoMesAnt, sAnoMesAtual, sAnoMesAtualReal  : string;
   sUltMesCalculo                      : string;
   dValorDevido                        : double;
   iTotBeneficiarios                   : longint;
   iIncluiMesConc                      : word;
   sAnoMesLote                         : string;
   sDataPagamento                      : string;
   sUltMesReajuste                     : string;
   dValorBeneficioIntegralOriginal     : double;
   dValorAbonoDigitadoOriginal         : double; //SIG50008
   bCalculouPrimeiroAbono              : boolean;//SIG50008
   dValorBeneficioIntegralAposMinimo   : double;
   dValorPrevAntesMinimo               : double;
   dValorSRBRetorno                    : double;
   dValorEmReal                        : double;
   dValorNaDIB                         : double;//William Moreira da Silva SOL 204211/14237 KINTANA 1974846
   dValorTotal                         : double;
   dValorEmCotas                       : double;
