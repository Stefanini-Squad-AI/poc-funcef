   if (UpperCase(psCampo) = 'DATADEMISSAO') and (psValorAntes <> '')and (psValorDepois = '')
   then begin
      if not chkGravaDemons.Checked
      then mmResult.Lines.Add('      [ERRO ] Data de Demissão não alterada. Data nula não permitida. ');
