        begin
          MsgDlg(sErro, 'Erro',mtError,[mbOK],0);
          Result := False;
          Exit;
        end;
        //AssignFile(X, sNomeArquivo {edListaPessoas.Text});
        //Reset(X);
        //edilaine WO4459 : fim
     except
        frmAguarde.Apaga;
        MsgDlg('Erro ao abrir arquivo. Verifique.','Erro',mtError,[mbOK],0);
        Result := False;
        Exit;
     end;

     sMatriculas := MontaStringMatriculas;
   end;

   if ( rbRecalcBenef.Checked )and ( rbnLote.Checked )
   then begin
      with qryAux do
      begin
         Close;
         SQL.Clear;

         // Felipe A. Santos SOL 247047 PPM 832618 - início
         if RdBtnMatricula.Checked then
         begin
            SQL.Add(' SELECT  COUNT(DISTINCT HB.IDPESSOA) AS TOTAL '+
                   ' FROM   DEPENTIT DP, BENEFBFCIARIO BF, HSTBENEFBFCIARIO HB  '+
                   ' WHERE  HB.IDBENEFICIO IN ('+sBeneficios+')     ');

