          ' AND    ((BP.FLGREFERENCIA = 0) OR ((BP.FLGREFERENCIA = 1) AND (BP.FLGPAGAINSS = 1) ) ) '+
          ' AND    BP.IDBENEFICIO   = B.IDBENEFICIO                                    ');
