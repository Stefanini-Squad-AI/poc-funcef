       Abort;

  FreeAndNil( CtrlBenefBfciario );

  // SOL189092 KTN 1802931 Otacilio
  if Assigned(sListaDocumentoExcluir) then
    FreeAndNil(sListaDocumentoExcluir);

  lstMes13.Free; //Helio - SOL Nº 228244-16260 PPM Nº 442505

  inherited;

