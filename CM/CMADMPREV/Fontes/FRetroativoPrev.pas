                          sContribuicoes := qryOpcaoContribuicao.FieldbyName('IDCONTRIBUICAO').AsString
                        else
                          sContribuicoes := sContribuicoes +','+ qryOpcaoContribuicao.FieldbyName('IDCONTRIBUICAO').AsString;
