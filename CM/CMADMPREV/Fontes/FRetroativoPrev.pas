function TfrmRetroativoPrev.MontaStringMatriculas : string;
var sMatriculas : string;
    sLinha      : string;
    iCount      : integer;
    sMatriculaAux: String;
begin

   sListaMatricula := TStringList.Create;

   // SOL189092 KTN 1802931 Otacilio
   if Assigned(sListaMatriculaRelatorio) then
     FreeAndNil(sListaMatriculaRelatorio);

   sListaMatriculaRelatorio := TStringList.Create;

   sMatriculas   :='';
   sMatriculaLote := ''; // 140042
   sMatriculaAux :='';
   iCount        :=0 ;
   while not Eof(X) do
   begin
      Readln(X, sLinha);

      //edilaine WO4459 : inicio
      try
        if Trim(sLinha) <> '' then
           StrToFloat(sLinha);
      except
        MsgDlg('Arquivo em formato inválido'+char(13)+char(10)+
               'O arquivo deve conter apenas matrículas, sem cabeçalho. Verifique.','Erro',mtError,[mbOK],0);
        Result := '';
        Abort;
      end;
      //edilaine WO4459 : fim

      // SOL189092 KTN 1802931 Otacilio
      sListaMatriculaRelatorio.Add(Trim(sLinha));

      if Trim(sMatriculas) = '' then
      begin
         sMatriculas := ''''+Trim(sLinha)+'''' ;
         if sMatriculaLote = '' then
            sMatriculaLote := ''+Trim(sLinha)+'' ;
      end
      else
      begin
        //BRUNO AZEVEDO SOL 172514 KINTANA 1553753
        // sMatriculas := sMatriculas+','+''''+Trim(sLinha)+'''';

        if Trim(sMatriculaAux) = ''
        then sMatriculaAux := sMatriculas + ',' + ''''+Trim(sLinha)+''''
        else sMatriculaAux := sMatriculaAux+','+''''+Trim(sLinha)+'''';

        sMatriculas := sMatriculas+','+''''+Trim(sLinha)+'''';

        Inc(iCount);

        //BRUNO AZEVEDO SOL 172514 KINTANA 1553753
        if icount = 999 then begin
          //BRUNO AZEVEDO SOL 165303 KINTANA 1428875
          //sListaMatricula.Add(sMatriculaAux);
          sListaMatricula.Add(sMatriculas);
          //BRUNO AZEVEDO SOL 165303 KINTANA 1428875
          sMatriculaAux := '';
          sMatriculas   := '';
          iCount        := 0;
        end;
      end;
   end;

   if sMatriculaAux <> ''
    then sListaMatricula.Add(sMatriculaAux);

   Result := sMatriculas;

end; // MontaStringMatriculas
