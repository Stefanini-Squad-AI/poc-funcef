function TfrmRetroativoPREV.ValidaArquivo(sNomeArq : string; var sMsgErro : string) : boolean;
var
  sNomeArquivo: string;
begin
  sNomeArquivo  := AnsiUppercase(sNomeArq);
  try
    if Pos('XLS', sNomeArquivo) > 0 then
    begin
      sNomeArquivo := StringReplace(StringReplace(sNomeArquivo, 'XLSX', 'TXT', []), 'XLS', 'TXT', []);
      if FileExists(sNomeArquivo) then
         DeleteFile(sNomeArquivo);
      ConvertExcelFile(sNomeArq, sNomeArquivo, xlTextWindows);
    end
    else if Pos('TXT', sNomeArquivo) = 0 then
    begin
      sMsgErro := 'Tipo de Arquivo inválido. Verifique.';
      Result := False;
    end;
    AssignFile(X, sNomeArquivo);
    Reset(X);
    result := true;
  except
    on E:Exception do
    begin
      result := false;
      sMsgErro := E.Message;
    end;
  end;
end;
