procedure TfrmRetroativoPREV.GravarHistoricoRevisoes;
var
  bmDemonstrativo : TBookmark;
  saldoRevisao : Double;
  valorTotalContrib : String;
  iUltimoIdpessoa,iUltimoIdentificador  : Integer; //Vinicius Ferreira Sol 158847 KINTANA 1296250
  fTotalValorTotalHist, fValorAlteradorHist, fValorAlteradorContribHist, fTotalValorTotalContribHist : Real; //Vinicius Ferreira Sol 158847 KINTANA 1296250

  procedure ExcluirHistoricoRevisao;
  var
    delHistoricoRevisoes : TwwQuery;
  begin
    delHistoricoRevisoes := TwwQuery.Create(nil);
    try
      delHistoricoRevisoes.DatabaseName := 'basedados';
      if (delHistoricoRevisoes.Active) then
      begin
        delHistoricoRevisoes.Close;
      end;

      with delHistoricoRevisoes do
      begin
        SQL.Clear;

        SQL.Add('DELETE hstrevisoes HR');
        SQL.Add(' WHERE HR.idpessoa = '+ QryDemonstrativoRel.FieldByName('IDPESSOA').Asstring);
        SQL.Add('   AND HR.idplanoprev = '+ QryDemonstrativoRel.FieldByName('IDPLANOPREV').Asstring);
        SQL.Add('   AND HR.idbeneficio = '+QryDemonstrativoRel.FieldByName('IDENTIFICADOR').Asstring);
        SQL.Add('   AND HR.idpessjur = '+ QryDemonstrativoRel.FieldByName('IDPESSJUR').Asstring);
        //BRUNO AZEVEDO SOL 171092
        SQL.Add('   AND HR.idlote = '+ qryLote.FieldByName('IDLOTE').AsString);
        SQL.Add('   AND HR.datainicio = ' + QuotedStr(Trim(edAnoMesIni.Text)));
        SQL.Add('   AND HR.datafim = ' + QuotedStr(Trim(edAnoMesFim.Text)));
        //BRUNO AZEVEDO SOL 171092

       { Params.Clear;

        Params.CreateParam(ftFloat, 'IDPESSOA', ptInput);
        Params.ParamByName('IDPESSOA').AsFloat := QryDemonstrativoRel.FieldByName('IDPESSOA').AsFloat;

        Params.CreateParam(ftFloat, 'IDPLANOPREV', ptInput);
        Params.ParamByName('IDPLANOPREV').AsFloat := QryDemonstrativoRel.FieldByName('IDPLANOPREV').AsFloat;

        Params.CreateParam(ftFloat, 'IDBENEFICIO', ptInput);
        Params.ParamByName('IDBENEFICIO').AsFloat := QryDemonstrativoRel.FieldByName('IDENTIFICADOR').AsFloat;

        Params.CreateParam(ftFloat, 'IDPESSJUR', ptInput);
        Params.ParamByName('IDPESSJUR').AsFloat := QryDemonstrativoRel.FieldByName('IDPESSJUR').AsFloat;

        Params.CreateParam(ftString, 'DATAINICIO', ptInput);
        Params.ParamByName('DATAINICIO').AsString := Trim(edAnoMesIni.Text);

        Params.CreateParam(ftString, 'DATAFIM', ptInput);
        Params.ParamByName('DATAFIM').AsString := Trim(edAnoMesFim.Text);}

      end;
      //delHistoricoRevisoes.Prepare;
      delHistoricoRevisoes.ExecSQL;
    finally
      FreeAndNil(delHistoricoRevisoes);
    end;
  end;

  procedure InserirHistoricoRevisao;
  var
    insHistoricoRevisoes,
    qryBenefBfciarioDados : TwwQuery;
  begin
    qryBenefBfciarioDados := TwwQuery.Create(nil);
    try
      qryBenefBfciarioDados.DatabaseName := 'basedados';

      if (qryBenefBfciarioDados.Active) then
      begin
        qryBenefBfciarioDados.Close;
      end;

      with qryBenefBfciarioDados do
      begin
        SQL.Clear;
        SQL.Add('SELECT BB.valoratual,');
        SQL.Add('       BB.valortotal,');
        SQL.Add('       BB.datainiciofund DIB,');
        SQL.Add('       BB.datainicio DIP,');
        SQL.Add('       BB.percentual');
        SQL.Add('  FROM benefbfciario BB');
        SQL.Add(' WHERE BB.idtitular = :IDTITULAR');
        SQL.Add('   AND BB.idplanoprev = :IDPLANOPREV');
        SQL.Add('   AND BB.idpessoa = :IDPESSOA');
        SQL.Add('   AND BB.idbeneficio = :IDBENEFICIO');
        SQL.Add('   AND BB.idpessjur = :IDPESSJUR');
        SQL.Add('   AND BB.idsitbeneficio = 1');

        Params.Clear;
        Params.CreateParam(ftFloat, 'IDTITULAR', ptInput);
        Params.ParamByName('IDTITULAR').AsFloat := QryDemonstrativoRel.FieldByName('IDTITULAR').AsFloat;

        Params.CreateParam(ftFloat, 'IDPLANOPREV', ptInput);
        Params.ParamByName('IDPLANOPREV').AsFloat := QryDemonstrativoRel.FieldByName('IDPLANOPREV').AsFloat;

        Params.CreateParam(ftFloat, 'IDPESSOA', ptInput);
        Params.ParamByName('IDPESSOA').AsFloat := QryDemonstrativoRel.FieldByName('IDPESSOA').AsFloat;

        Params.CreateParam(ftFloat, 'IDBENEFICIO', ptInput);
        Params.ParamByName('IDBENEFICIO').AsFloat := QryDemonstrativoRel.FieldByName('IDENTIFICADOR').AsFloat;

        Params.CreateParam(ftFloat, 'IDPESSJUR', ptInput);
        Params.ParamByName('IDPESSJUR').AsFloat := QryDemonstrativoRel.FieldByName('IDPESSJUR').AsFloat;
      end;
      qryBenefBfciarioDados.Prepare;
      qryBenefBfciarioDados.Open;

      if (not(qryBenefBfciarioDados.IsEmpty)) then
      begin
        insHistoricoRevisoes := TwwQuery.Create(nil);
        try
          insHistoricoRevisoes.DatabaseName := 'basedados';

          if (insHistoricoRevisoes.Active) then
          begin
            insHistoricoRevisoes.Close;
          end;
         // qryDadosBeneficio.Locate('IDBENEFICIO;NUMEROPROCESSO',varArrayOf([qryBenefBfciario.FieldbyName('IDBENEFICIO').AsString,qryBenefBfciario.FieldbyName('numeroprocesso').AsString]),[]);//Renato Visoni SOL 113471 KINTANA 528743
          with insHistoricoRevisoes do
          begin
            SQL.Clear;
            SQL.Add('INSERT INTO CM.HSTREVISOES');
            SQL.Add('(');
            SQL.Add('       IDPESSOA,');
            SQL.Add('       IDPLANOPREV,');
            SQL.Add('       IDBENEFICIO,');
            SQL.Add('       IDPESSJUR,');
            SQL.Add('       IDTIPOMOV,');
            SQL.Add('       VALORATUAL,');
            SQL.Add('       VALORTOTAL,');
            SQL.Add('       DIB,');
            SQL.Add('       DIP,');
            SQL.Add('       PERCENTUAL,');
            SQL.Add('       DESCREVISAO,');
            SQL.Add('       NUMPARC,');
            SQL.Add('       VALORPARC,');
            SQL.Add('       DATAINICIO,');
            SQL.Add('       DATAFIM,');
            SQL.Add('       SLDREVISAO,');
            SQL.Add('       IDMOTIVO,');
            //BRUNO AZEVEDO SOL 171092
            SQL.Add('       IDLOTE');
            SQL.Add(')');
            SQL.Add('VALUES');
            SQL.Add('(');
            SQL.Add('       :IDPESSOA,');
            SQL.Add('       :IDPLANOPREV,');
            SQL.Add('       :IDBENEFICIO,');
            SQL.Add('       :IDPESSJUR,');
            SQL.Add('       :IDTIPOMOV,');
            SQL.Add('       :VALORATUAL,');
            SQL.Add('       :VALORTOTAL,');
            SQL.Add('       :DIB,');
            SQL.Add('       :DIP,');
            SQL.Add('       :PERCENTUAL,');
            SQL.Add('       :DESCREVISAO,');
            SQL.Add('       :NUMPARC,');
            SQL.Add('       :VALORPARC,');
            SQL.Add('       :DATAINICIO,');
            SQL.Add('       :DATAFIM,');
            SQL.Add('       :SLDREVISAO,');
            SQL.Add('       :IDMOTIVO,');
            //BRUNO AZEVEDO SOL 171092
            SQL.Add('       :IDLOTE');
            SQL.Add(')');

            Params.Clear;

            Params.CreateParam(ftFloat, 'IDPESSOA', ptInput);
            Params.ParamByName('IDPESSOA').AsFloat := QryDemonstrativoRel.FieldByName('IDPESSOA').AsFloat;

            Params.CreateParam(ftFloat, 'IDPLANOPREV', ptInput);
            Params.ParamByName('IDPLANOPREV').AsFloat := QryDemonstrativoRel.FieldByName('IDPLANOPREV').AsFloat;

            Params.CreateParam(ftFloat, 'IDBENEFICIO', ptInput);
            Params.ParamByName('IDBENEFICIO').AsFloat := QryDemonstrativoRel.FieldByName('IDENTIFICADOR').AsFloat;

            Params.CreateParam(ftFloat, 'IDPESSJUR', ptInput);
            Params.ParamByName('IDPESSJUR').AsFloat := QryDemonstrativoRel.FieldByName('IDPESSJUR').AsFloat;

            Params.CreateParam(ftFloat, 'IDTIPOMOV', ptInput);
            if (chkTipoIndivTipoBeneficio.Checked) then
            begin
              //Alteração de Tipo de Benefício
              Params.ParamByName('IDTIPOMOV').AsFloat := 14;
            end
            else
            begin
             if (rbRecalcBenef.Checked) then
             begin
               //Revisão de Benefício
               Params.ParamByName('IDTIPOMOV').AsFloat := 13;
             end
             else
             begin
               //Reajuste Judicial
               Params.ParamByName('IDTIPOMOV').AsFloat := 6;
             end;
            end;

            Params.CreateParam(ftFloat, 'VALORATUAL', ptInput);
            Params.ParamByName('VALORATUAL').AsFloat := qryBenefBfciarioDados.FieldByName('VALORATUAL').AsFloat;

            Params.CreateParam(ftFloat, 'VALORTOTAL', ptInput);
            Params.ParamByName('VALORTOTAL').AsFloat := qryBenefBfciarioDados.FieldByName('VALORTOTAL').AsFloat;

            Params.CreateParam(ftDate, 'DIB', ptInput);
            Params.ParamByName('DIB').AsDate := qryBenefBfciarioDados.FieldByName('DIB').AsDateTime;

            Params.CreateParam(ftDate, 'DIP', ptInput);
            Params.ParamByName('DIP').AsDate := qryBenefBfciarioDados.FieldByName('DIP').AsDateTime;

            Params.CreateParam(ftFloat, 'PERCENTUAL', ptInput);

            //Otacilio Aquino SOL: 185332 KINTANA: 1737388
            //Thiago Melo SOL 182479 KINTANA 1716615
            //Params.ParamByName('PERCENTUAL').AsFloat := qryBenefBfciarioDados.FieldByName('percentual').AsFloat;
            //Params.ParamByName('PERCENTUAL').AsFloat := StrToFloat(OraNumero(qryDadosBeneficio.FieldByName('VALORBASE1').AsString));
            Params.ParamByName('PERCENTUAL').AsFloat := qryDadosBeneficio.FieldByName('VALORBASE1').AsFloat;
            //Thiago Melo SOL 182479 KINTANA 1716615
            //Otacilio Aquino SOL: 185332 KINTANA: 1737388

            Params.CreateParam(ftString, 'DESCREVISAO', ptInput);
            Params.ParamByName('DESCREVISAO').AsString := Trim(RetornaObs(edObservacao.Text)); //Renato Visoni SOL 155894


            Params.CreateParam(ftFloat, 'NUMPARC', ptInput);
            Params.CreateParam(ftFloat, 'VALORPARC', ptInput);
            if (FParcelamentoQtdeParcelas > 0) and (FParcelamentoValorParcela > 0) then
            begin
              Params.ParamByName('NUMPARC').AsFloat := FParcelamentoQtdeParcelas;
              Params.ParamByName('VALORPARC').AsFloat := FParcelamentoValorParcela;
            end
            else
            begin
              Params.ParamByName('NUMPARC').AsFloat := 0;
              Params.ParamByName('VALORPARC').AsFloat := 0;
            end;

            Params.CreateParam(ftString, 'DATAINICIO', ptInput);
            Params.ParamByName('DATAINICIO').AsString := Trim(edAnoMesIni.Text);

            Params.CreateParam(ftString, 'DATAFIM', ptInput);
            Params.ParamByName('DATAFIM').AsString := Trim(edAnoMesFim.Text);

            Params.CreateParam(ftFloat, 'SLDREVISAO', ptInput);
            Params.ParamByName('SLDREVISAO').AsFloat := saldoRevisao;

            Params.CreateParam(ftFloat, 'IDMOTIVO', ptInput);
            Params.ParamByName('IDMOTIVO').AsFloat := qryMotivo.FieldByName('IDMOTIVO').AsInteger;

            //BRUNO AZEVEDO SOL 171092
            Params.CreateParam(ftFloat, 'IDLOTE', ptInput);
            Params.ParamByName('IDLOTE').AsFloat := qryLote.FieldByName('IDLOTE').AsFloat;
          end;

          insHistoricoRevisoes.Prepare;
          try
             insHistoricoRevisoes.ExecSQL;
          except
             Showmessage('Existe uma revisão efetuada.');
             abort;
          end;
        finally
          FreeAndNil(insHistoricoRevisoes);
        end;
      end;
    finally
       FreeAndNil(qryBenefBfciarioDados);
    end;
  end;

begin
  // Vinicius Ferreira Sol 158847 KINTANA 1296250 - Inicio
  saldoRevisao := 0;
  fValorAlteradorHist := 0;
  fTotalValorTotalHist := 0;
  fValorAlteradorContribHist := 0;

  if (not(QryDemonstrativoRel.IsEmpty)) then
  begin
    bmDemonstrativo := QryDemonstrativoRel.GetBookmark;
    try
      {
      //Totalizar saldo da revisão, conforme Saldo Revisão (A+B) do demonstrativo de revisão de beneficio.
      QryDemonstrativoRel.First;
      while (not(QryDemonstrativoRel.Eof)) do
      begin
        valorTotalContrib := valorTotalContrib + RoundCM(((qryDemonstrativoRel.FieldByname('ALTERADORCONTRIB').asFloat + (qryDemonstrativoRel.FieldByname('CONTRIBDEVIDA').asFloat-qryDemonstrativoRel.FieldByname('CONTRIBDESCONTADA').asFloat)))*-1, 2);
        saldoRevisao := saldoRevisao + ((QryDemonstrativoRel.FieldByName('VALORDEPOIS').AsFloat-QryDemonstrativoRel.FieldByName('VALORANTES').AsFloat)+QryDemonstrativoRel.FieldByName('ALTERADORBENEF').AsFloat); //Vinicius Ferreira Sol 158847 KINTANA 1296250
        QryDemonstrativoRel.Next;
      end;
      saldoRevisao := (saldoRevisao + valorTotalContrib);
      }

      //Busca os Totais
      fValorAlteradorContribHist      :=0;
      valorTotalContrib               :='0';
      fTotalValorTotalContribHist     :=0;

      QryDemonstrativoRel.First;
       iUltimoIdpessoa := 0;
       iUltimoIdentificador :=0;
      while (not(QryDemonstrativoRel.Eof)) do
      begin
        //Excluir lançamento(s) anterior(es) deste recalculo no historico de revisões.
        ExcluirHistoricoRevisao();

        //Inserir este lançamento no historico de revisões.
        fValorAlteradorContribHist      := qryDemonstrativoRel.FieldByname('ALTERADORCONTRIB').asFloat;
        valorTotalContrib               := Formatfloat('#0.00',RoundCM(((fValorAlteradorContribHist + (qryDemonstrativoRel.FieldByname('CONTRIBDEVIDA').asFloat-qryDemonstrativoRel.FieldByname('CONTRIBDESCONTADA').asFloat)))*-1,2));
        fTotalValorTotalContribHist     := StrTofloat(valorTotalContrib);                                                                         
        if (iUltimoIdpessoa <> QryDemonstrativoRel.FieldByname('IDPESSOA').asInteger) Or (iUltimoIdentificador <> QryDemonstrativoRel.FieldByname('IDENTIFICADOR').asInteger) then begin
          QryAux.Close;
          QryAux.SQL.Clear;
          QryAux.SQL.Add('SELECT SUM(round(VALORDEPOIS,2)) AS VALORDEPOIS, SUM(ROUND(VALORANTES,2)) AS VALOTANTES, SUM(ROUND(VALORDEPOIS,2)) - SUM(ROUND(VALORANTES,2)) AS DIFERENCA,');
          QryAux.SQL.Add('SUM(round(VALORDEPOIS,2)) - SUM(ROUND(VALORANTES,2)) + SUM(ROUND(ALTERADORBENEF,2)) AS TOTALBENEF');
          QryAux.SQL.Add(' FROM (');
          QryAux.SQL.Add(QryDemonstrativoRel.SQL.Text);
          QryAux.SQL.Add(') WHERE TIPO    = '+ QuotedStr(QryDemonstrativoRel.FieldByname('TIPO').asString));
          QryAux.SQL.Add('  AND MATRICULA = '+ QuotedStr(QryDemonstrativoRel.FieldByname('MATRICULA').asString));
          QryAux.Open;
          fTotalValorTotalHist    := QryAux.FieldByname('TOTALBENEF').asFloat;
          saldoRevisao            := 0;
        end;

        saldoRevisao            := (fTotalValorTotalHist+fTotalValorTotalContribHist);
        fTotalValorTotalHist    := saldoRevisao;

        InserirHistoricoRevisao();

        iUltimoIdpessoa := QryDemonstrativoRel.FieldByname('IDPESSOA').asInteger;
        iUltimoIdentificador := QryDemonstrativoRel.FieldByname('IDENTIFICADOR').asInteger;
        QryDemonstrativoRel.Next;
  //Vinicius Ferreira Sol 158847 KINTANA 1296250 - Fim
      end;
    finally
      QryDemonstrativoRel.GotoBookmark(bmDemonstrativo);
      QryDemonstrativoRel.FreeBookmark(bmDemonstrativo);
    end;
  end;
end;


