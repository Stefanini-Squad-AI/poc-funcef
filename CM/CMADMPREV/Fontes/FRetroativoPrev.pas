begin

  try
    if trim(Texto) = '' then begin
      Texto := formatfloat('#0.00', 0);
    end else begin
      Texto := formatfloat('#,##0.00', strTofloat(Texto));
    end;
  except
    Texto :='0.00'
  end;
  
end;

