            qryAux.Sql.Add('                               WHERE BXT.IDBENEFICIO = B.IDBENEFICIO ');
            qryAux.Sql.Add('                                 AND B.NUMEROPROCESSO = '+qryDadosBeneficio.FieldByName('NUMEROPROCESSO').AsString +') ');
