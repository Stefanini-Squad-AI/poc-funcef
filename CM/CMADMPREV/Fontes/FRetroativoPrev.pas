                   ' AND    IDMOTIVO     = '+qryMotivo.FieldByName('IDMOTIVO').AsString + //Eraldo Luis da Silva SOL 159483 KINTANA 1319247
                   // SOL 199422 KTN 1919434 Otacilio ** Inicio **
                   ' AND DECODE(SUBSTR(MESREFERENCIA,6,2),13,SUBSTR(MESREFERENCIA,1,5)||12,MESREFERENCIA) BETWEEN ' + chr(39)+edAnoMesIni.Text+chr(39)+' and '+chr(39)+sAnoMesFim+chr(39);
                   //' AND    MESREFERENCIA between  '+chr(39)+edAnoMesIni.Text+chr(39)+' and '+chr(39)+sAnoMesFim+chr(39);
                   // SOL 199422 KTN 1919434 Otacilio ** Fim **
   try
      qryAux.ExecSQL;
      qryAux.Close; //SOL 144007/2802 Kintana 1003179
   except

      ppParcelamentoBenef.Lines.Add('[AVISO] Erro ao acertar contribuições parceladas. Parcelamento não Processado. Verifique. ');

      if not chkGravaDemons.Checked
      then mmResult.Lines.Add('      [AVISO] Erro ao acertar contribuições parceladas. Parcelamento não Processado. Verifique. ');
      GravaLinhaTXT('      [AVISO] Erro ao acertar contribuições parceladas. Parcelamento não Processado. Verifique. ');
      Exit;
   end;

   //verifica que registros dar como pago
   //caso o usuário tenha feito uma revisão de INSS separada da suplementação
   //e esteja parcelaendo apenas uma delas, o sistema não pode dar como pagos
   //rodos os registros
   sFontePagadora := '';
   if (abs(dTotalINSS) > 0) and (abs(dTotalBenef) >0) then  sFontePagadora := '1,2'
   else if (abs(dTotalINSS) > 0) and (abs(dTotalBenef) <=0) then  sFontePagadora := '2'
   else if (abs(dTotalINSS) <= 0) and (abs(dTotalBenef) >0) then  sFontePagadora := '1';

   //BRUNO AZEVEDO SOL 157417 KINTANA 1268142
   if (edAnoMesFim.Text = qryLote.FieldByName('MESREFERENCIA').AsString) then begin
     sAnoMesFim := DecMonth(StrToInt(Copy(edAnoMesFim.Text,1,4)),StrToInt(Copy(edAnoMesFim.Text,6,2)));
   end else begin
     sAnoMesFim := edAnoMesFim.Text;
   end;
   sAnoMesFimRevisao := sAnoMesFim;

   qryaux.close;
   qryaux.SQL.text := ' UPDATE HSTBENEFBFCIARIO  SET  '+
                      ' DTEFETPGTO = LAST_DAY(TO_DATE(SUBSTR(MESREFERENCIA,1,4)||DECODE(SUBSTR(MESREFERENCIA,5,3),''/13'',''/12'',SUBSTR(MESREFERENCIA,5,3)),''YYYY/MM'')) ,'+
                      ' FLGENVIADO = 1,  VLBENEFPGTO  = VALORPREV '+
                      ' WHERE  IDPESSJUR    = '+qrydadosbeneficio.fieldbyname('IDPESSJUR').AsString+
                      ' AND    IDPLANOPREV  = '+qrydadosbeneficio.fieldbyname('IDPLANOPREV').AsString+
                      ' AND    IDPESSOA     = '+qrydadosbeneficio.fieldbyname('IDPESSOA').AsString+
                      ' AND    IDTITULAR    = '+qrydadosbeneficio.fieldbyname('IDTITULAR').AsString+
                      ' AND    SEQPROPOSTA  = '+qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString +
                      ' AND    IDLOTE       = '+qryLote.FieldByName('IDLOTE').AsString                +
                      ' AND    IDMOTIVO     = '+qryMotivo.FieldByName('IDMOTIVO').AsString+            //BRUNO AZEVEDO SOL 157417 KINTANA 1268142
                      // SOL 199422 KTN 1919434 Otacilio ** Inicio **
                      ' AND DECODE(SUBSTR(MESREFERENCIA,6,2),13,SUBSTR(MESREFERENCIA,1,5)||12,MESREFERENCIA) BETWEEN ' + chr(39)+edAnoMesIni.Text+chr(39)+' and '+chr(39)+sAnoMesFim+chr(39) +
                      //' AND    mesreferencia between  '+chr(39)+edAnoMesIni.Text+chr(39)+' and '+chr(39)+sAnoMesFim+chr(39)+ //Fernando Santana SOL 132687/1961 Kintana 850151
                      // SOL 199422 KTN 1919434 Otacilio ** Fim **
                      ' AND    NUMEROPROCESSO = '+qryDadosBeneficio.FieldByName('NUMEROPROCESSO').AsString +  // edilaine - SOL 253577-17661 / PPM 1019931
                      ' AND    FONTEPAGADORA IN ('+sFontePagadora+') ';
   try
      qryAux.ExecSQL;
      qryAux.Close; //SOL 144007/2802 Kintana 1003179
   except
      //Brunno Mattos - KTN 767861 - SOL 132659 Inicio
   on e:Exception do
   begin
      TratarErro(e.Message);
      Result := False;

      ppParcelamentoBenef.Lines.Add('[AVISO] Erro ao acertar benefícios parcelados. Parcelamento não Processado. Verifique. ');

      if not chkGravaDemons.Checked
      then mmResult.Lines.Add('      [AVISO] Erro ao acertar benefícios parcelados. Parcelamento não Processado. Verifique. ');
      GravaLinhaTXT('      [AVISO] Erro ao acertar benefícios parcelados. Parcelamento não Processado. Verifique. ');
      Exit;
   end;
   //Brunno Mattos - KTN 767861 - SOL 132659 Fim
      
   end;

   Result := True;
   PrintDemonstrativo();   //SOL 176867
end;

