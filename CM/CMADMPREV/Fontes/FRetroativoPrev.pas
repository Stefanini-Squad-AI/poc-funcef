// fernando xavier - SOL 253577-17661 / PPM 1019931 inicio
function TfrmRetroativoPREV.SincronizarBeneficioSelecionado : boolean;
var Frame : TFrame;
    i, iQtdeBeneficio, iQtdBenefSel : integer;
    FrameName : string;
    NamePanel : string;
    Temp, TempAux : TComponent;
    InssChk, InssMes : TComponent;       // Peterson - SOL 269943 / PPM 1323444
    bValorBSFAB : boolean;
    bBenefMarcado : boolean;
    PercPensaoChk, PercPensaoEd : TComponent;   //edilaine WO22176
begin
   result := false;
   iQtdeBeneficio := qryDadosBeneficio.recordcount;
   FrameName :=   'FrameBeneficioRevisar';

   iQtdBenefSel := 0;

   {retorna os dados que foram editados no frame para a qryDadosbeneficio do processo principal}
   for i := 1 to iQtdeBeneficio do
   begin
      Frame := FindComponent ('FrameBeneficioRevisar'+inttostr(i)) as TFrame;
      if Assigned (Frame) then
      begin
         with Frame do
         begin
            TempAux := FindComponent('dbCheckBeneficio');
            if Assigned(TempAux) then
            begin
              {if not TDbCheckBox(TempAux).checked then
                 bBenefMarcado;}
              bBenefMarcado := TDbCheckBox(TempAux).checked;
            end;

            // william moreira - SOL 268941 / PPM 1271559
            if bBenefMarcado then
            begin
                 inc(iQtdBenefSel);
            end;
            // william moreira - SOL 268941 / PPM 1271559

            // Peterson - SOL 269943 / PPM 1323444 - inicio
            {busca componentes na tela}
            InssChk := FindComponent('chkmesreemindiv');
            InssMes := FindComponent('edMesAno');
            // Peterson - SOL 269943 / PPM 1323444 - fim

            //edilaine WO22176 : inicio
            PercPensaoChk := FindComponent('chkPercPensao');
            PercPensaoEd  := FindComponent('edPercPensao');
            //edilaine WO22176 : fim

            Temp := FindComponent('qryFrameDadosBeneficio');
            if Assigned(Temp) then
            begin
               with TwwQuery(temp) do
               begin
                  while not(eof) do
                  begin
                    qryDadosBeneficio.Filtered := False;
                    qryDadosBeneficio.Filter := '(IDBENEFICIO = '+FieldByName('IDBENEFICIO').AsString+') AND (NUMEROPROCESSO = '+FieldByName('NUMEROPROCESSO').AsString+')';
                    qryDadosBeneficio.Filtered := True;

                    // Peterson - SOL 269943 / PPM 1323444 - inicio
                    {se for o beneficio selecionado para processar, pegar os dados}
                    if (FieldByName('FONTEPAGADORA').AsInteger = 2) and (FieldByName('IDBENEFICIO').AsInteger = iIdBeneficio) then
                    begin
                      if Assigned(InssChk) then
                      begin
                        chkmesreemindiv.checked := TCheckBox(InssChk).checked;
                      end;

                      if Assigned(InssMes) then
                      begin
                        edMesAno.text := TMaskEdit(InssMes).text;
