             '        DECODE(DECODE(BF.IDTITULAR, BF.IDPESSOA, SP.FLGINTERNO,''CA''),''CA'',''AS'',DECODE(BF.IDTITULAR, BF.IDPESSOA, SP.FLGINTERNO, ''AS'')) AS FLGINTERNO,   '+ // SOL 256782 PPM 847574
             //Wylliam Leite da Silva - SOL: 255145 PPM: 825471 - Fim
             '        B.FLGBENEFTEMP,    PP.FLGSALVIRTBENEF, B.NOME, PF.VLRENQUADRAMENTO,                                '+
             '        PLP.IDRGENQUADRAMENTO, BP.IDREGRASRB,                                                              '+
             '        BF.FLGPAGAINSS AS BENEFICIOPAGAINSS, BP.FLGPAGAINSS AS PLANOPAGAINSS, '+
             '        PBENEF.NOME AS NOMEBENEF, '+
             '        BF.DIBBENEFANT, BTIT.PERCENTUAL, DP.IDDEPENDENCIA, BP.FLGPAGAINSS, '+
             '        BTIT.IDRESPONSAVEL, BTIT.IDNUCLEOFAMILIAR,BF.DATAINICIOFUND DIB, BF.FONTEPAGADORA '+
             '        , B.FLGPECULIO                                                                                     '+    //Renato Visoni SOL 156139
             // Thiago Melo SOL 208274.15065 Kintana 2043014
             '        , PF.DATAMORTE                                                                                     '+
             // Thiago Melo SOL 208274.15065 Kintana 2043014
             '        , BF.VLRBSATUAL, BF.VLRBSTOTAL, BF.VLRFABATUAL, BF.VLRFABTOTAL, BF.IDPLANOORIGEM                   '+   // fernando xavier - SOL 253577-17661 / PPM 1019931
             '        , BF.IDPERFILINVEST                                                                                '+   // edilaine - SIG55933
             ' FROM   PESSOAFISICA PF, ELEGPATRO EL, PARTPREVPLAN PP, PROCESSOBENEF P, BENEFBFCIARIO BF,                 '+
             '        EVENTOGERADOR EG, BENEFPLANPREV BP, SITPART SP, BENEFICIO B, BENEFPLANOPART BPP,                   '+
             '        PLANPREVPATRO PLP,                                                                                 '+
             '        PLANPREV PL, '+
             '        PESSOA PBENEF,                                                                                     '+
             '        BFCIARIOTITPLAN BTIT, DEPENTIT DP                                                                  '+
