                 //dblkpFormaMantidos.Text   := 'Banco';
                 //dblkpALTAtivos.Text       := 'Não';
                 //dblkpALTMantidos.Text     := 'Não';
                 //DbLkcIncluiAlterador.Text := 'Sim';
                 dblkpFormaAtivos.Text     := 'Banco';
                 dblkpFormaMantidos.Text   := 'Banco';
                 dblkpALTAtivos.Text       := 'Sim';
                 dblkpALTMantidos.Text     := 'Sim';
                 DbLkcIncluiAlterador.Text := 'Sim'; // Fim - Ádler Souza - SOL 143508 KTN 931894

                 { Foi colocado este if para entrar nesse código, somente quando
                   for revisão de benefícios                }
                 If rbRevisaoContribuicao.Checked = False Then
                 Begin


                   { Guarda lista de beneficio utilizados }
                   sBeneficios := '';
                   sNumProcessos := ''; // Renato Visoni SOL 113471 KINTANA 528743
                   qryDadosBeneficio.First;
                   fTotalPROCESSA := 0; //SOL 140042 Kintana 900220
                   while not qryDadosBeneficio.Eof do begin

                      if qryDadosBeneficio.FieldbyName('FONTEPAGADORA').AsInteger = 2 then             // SOL 140042 Kintana 900220
                        fTotalPROCESSA := fTotalPROCESSA + qryDadosBeneficio.FieldbyName('PROCESSA').AsInteger; //SOL 140042 Kintana 900220

                      if qryDadosBeneficio.FieldbyName('PROCESSA').AsInteger = 1 then begin

                        if Trim(sBeneficios) = '' then
                          sBeneficios := qryDadosBeneficio.FieldbyName('IDBENEFICIO').AsString
                        else
                          sBeneficios := sBeneficios +','+ qryDadosBeneficio.FieldbyName('IDBENEFICIO').AsString;

                        // Renato Visoni SOL 113471 KINTANA 528743
                        if Trim(sNumProcessos) = '' then
                          sNumProcessos := qryDadosBeneficio.FieldbyName('NUMEROPROCESSO').AsString
                        else
                          sNumProcessos := sNumProcessos +','+ qryDadosBeneficio.FieldbyName('NUMEROPROCESSO').AsString;
