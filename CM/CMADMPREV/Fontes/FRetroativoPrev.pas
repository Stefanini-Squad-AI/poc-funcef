    else begin
       qryBeneficio.SQL.Add(
          ' SELECT B.IDBENEFICIO, B.TIPOBENEFICIO, B.NOME, B.NOME AS NOMEBENEFICIO,    '+
          '        -1 as IDGRUPOBENEF,                                                 '+
          '        B.FLGDESTBENEF, B.IDEVENTOGERADOR,                                  '+
