procedure TfrmRetroativoPREV.AtualizarHstbenefbfciario(
  IDCONTROLEDIVIDABENEFICIO,DATALOTE: string;
  bFlgDevolucao: Boolean = True);  //William Santana - SIG 23867
var
  query:TwwQuery;
  ii : Integer; //Helio - SOL Nº 228244-16260 PPM Nº 442505
begin

query:=TwwQuery.Create(Self);
query.DataBaseName :='BaseDados';
query.Active:=false;
query.Sql.Clear;

query.SQL.Add('UPDATE HSTBENEFBFCIARIO');
query.SQL.Add('   SET FLGENVIADO = 1');
query.SQL.Add('      ,DTEFETPGTO =DATAPAGAMENTO');
query.SQL.Add('      ,VLBENEFPGTO =VALORPREV');
query.SQL.Add('      ,IDCONTROLEDIVIDABENEFICIO ='+IDCONTROLEDIVIDABENEFICIO);
query.SQL.Add(' WHERE ');
query.SQL.Add('NUMEROPROCESSO         = '+qryDadosBeneficio.FieldByName('NUMEROPROCESSO').TEXT);

if (bFlgDevolucao) then//William Santana - SIG 23867
// query.SQL.Add(' AND FLGDEVOLUCAO = 1 ');//Helio - SOL Nº 228244-16260 PPM Nº 442505

query.SQL.Add('AND    MES             = '+#39+dbedMesLote.text+#39);
query.SQL.Add('AND    IDBENEFICIO     = '+qryDadosBeneficio.FieldByName('IDBENEFICIO').TEXT);
query.SQL.Add('AND    IDPESSOA        = '+qryDadosBeneficio.FieldByName('IDPESSOA').TEXT);
//query.SQL.Add('AND    SEQPROPOSTA     = 1 ');
query.SQL.Add('AND    IDLOTE          =  '+dblkpcmbLoteAcerto.LookupValue);

//Helio - SOL Nº 228244-16260 PPM Nº 442505
//query.SQL.Add(' AND DECODE(SUBSTR(MESREFERENCIA,6,2),13,SUBSTR(MESREFERENCIA,1,5)||12,MESREFERENCIA) BETWEEN ' + chr(39)+edAnoMesIni.Text+chr(39)+' and '+chr(39)+edAnoMesFim.Text+chr(39));////SOL 225783 KINTANA 2059230 Douglas.Siqueira
query.SQL.Add(' AND ((');
query.SQL.Add(' DECODE(SUBSTR(MESREFERENCIA,6,2),13,SUBSTR(MESREFERENCIA,1,5)||12,MESREFERENCIA) BETWEEN ' + chr(39)+edAnoMesIni.Text+chr(39)+' and '+chr(39)+edAnoMesFim.Text+chr(39));////SOL 225783 KINTANA 2059230 Douglas.Siqueira

query.SQL.Add(')');

if lstMes13.Count > 0 then
begin
   query.SQL.Add(' OR MESREFERENCIA IN (');

   for ii := 0 to lstMes13.Count -1 do
   begin
         query.SQL.Add(QuotedStr(lstMes13[ii]));

         if (ii + 1) < lstMes13.Count then
             query.SQL.Add(', ');
   end;

   query.SQL.Add(')');
end; //if lstMes13.Count > 0 then

query.SQL.Add(')');
//FIM Helio - SOL Nº 228244-16260 PPM Nº 442505

query.ExecSQL;
query.CLOSE;
query.Destroy;

end;

function TfrmRetroativoPREV.GetVlDif(_idpessoa,_idtitular,_idbeneficio:integer;var qryDemonstrativoRel:TQuery):double;
var
  query:TwwQuery;
begin

  query:=TwwQuery.Create(Self);
  query.DataBaseName :='BaseDados';
  query.Active:=false;
  query.Sql.Clear;
  query.SQL.Add('SELECT (SUM(VALORDEPOIS))-(SUM(VALORANTES))+ (SUM(ALTERADORBENEF))DIF ,IDPESSOA,IDTITULAR, IDENTIFICADOR ');
  //query.SQL.Add('SELECT (SUM(VALORDEPOIS))-(SUM(VALORANTES))DIF ,IDPESSOA,IDTITULAR, IDENTIFICADOR ');
  query.SQL.Add('FROM (');
  query.SQL.Add(qryDemonstrativoRel.sql.gettext);
  query.SQL.Add(')');
  query.SQL.Add('WHERE IDPESSOA ='+inttostr(_idpessoa));
  query.SQL.Add('AND IDTITULAR='+inttostr(_idtitular));
  query.SQL.Add('AND IDENTIFICADOR ='+inttostr(_idbeneficio));
  query.SQL.Add('GROUP BY 0,IDPESSOA,IDTITULAR,IDENTIFICADOR');
  query.active:=True;
  //result:= query.fieldbyname('DIF').AsFloat;// SOL 226909 KINTANA 2061947         // edilaine - SOL 253577-18149 / PPM 1318909
  result:= query.fieldbyname('DIF').AsFloat + fTotalValorTotalContrib;            // edilaine - SOL 253577-18149 / PPM 1318909
  query.close;
  query.destroy;
  //
  //_query.Sql.
  //query
end;

