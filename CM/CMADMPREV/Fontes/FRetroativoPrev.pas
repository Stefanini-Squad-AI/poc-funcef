            if dblkpcmbPlano.Text <> ''
            then SQL.Add(' AND HB.IDPLANOPREV = '+qryPlano.FieldByName('IDPLANOPREV').AsString );

            SQL.Add(' AND DP.IDPESSOA = BF.IDPESSOA ' +
                    ' AND DP.IDTITULAR = BF.IDTITULAR ' +
                    ' AND BF.IDPESSOA = HB.IDPESSOA ' +
                    ' AND BF.IDTITULAR = HB.IDTITULAR ' +
                    ' AND BF.IDPESSJUR = HB.IDPESSJUR    ' +
                    ' AND BF.IDPLANOPREV = HB.IDPLANOPREV  ' +
