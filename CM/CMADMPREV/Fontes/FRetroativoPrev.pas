procedure TfrmRetroativoPREV.MontaConsultaRelatorioContribuicao;
var fValorAlteradorBenef : Real;
dDataInicial, sMesIni,sMesFim : String;
iIdPessoa : Integer;
sFatorMes12 : string;
sAnoMes12   : String;
bProximo    : Boolean;
sAnoMes     : String;
begin
  QryDemonstrativo.First;

  //edilaine - SIG50850 : inicio
  ppSubAcaoJud.Visible := False;
  qryAcJudDeficit.Close;
  //edilaine - SIG50850 : fim

  while not QryDemonstrativo.eof do
  begin
     if iIdPessoa <> QryDemonstrativo.FieldByname('IDPESSOA').AsInteger then
     begin
        QryDemonstContrib.close;
        QryDemonstContrib.ParamByName('IDPESSOA').AsInteger      := QryDemonstrativo.FieldByname('IDPESSOA').AsInteger;
        QryDemonstContrib.ParamByName('IDPESSJUR').AsInteger     := QryDemonstrativo.FieldByname('IDPESSJUR').AsInteger;
        QryDemonstContrib.ParamByName('IDTITULAR').AsInteger     := QryDemonstrativo.FieldByname('IDTITULAR').AsInteger; //William Santana - SIG 19417 
        QryDemonstContrib.ParamByName('SEQPROPOSTA').AsInteger   := QryDemonstrativo.FieldByname('SEQPROPOSTA').AsInteger;
        QryDemonstContrib.ParamByName('IDPLANOPREV').AsInteger   := QryDemonstrativo.FieldByname('IDPLANOPREV').AsInteger;
        QryDemonstContrib.ParamByName('IDBENEFICIO').AsInteger   := qryDemonstrativo.FieldbyName('IDENTIFICADOR').AsInteger;
        QryDemonstContrib.ParamByName('DTRECALCULO').AsDateTime  := StrToDateTime( sDataInicioRecalculo );
        if qryDemonstrativo.FieldbyName('DATAINICIO').AsString > edAnoMesIni.Text then
           QryDemonstContrib.ParamByName('MESINI').AsString      := qryDemonstrativo.FieldbyName('DATAINICIO').AsString
        else
           QryDemonstContrib.ParamByName('MESINI').AsString      := edAnoMesIni.Text;
        QryDemonstContrib.ParamByName('MESFIM').AsString         := edAnoMesFim.Text;
        QryDemonstContrib.open;

        //edilaine - SIG50850 : inicio
        {so para revisao de beneficio}
        qryAcJudDeficit.close;
        qryAcJudDeficit.SQL.clear;
        if QryDemonstrativo.FieldByname('IDPESSOA').AsInteger = QryDemonstrativo.FieldByname('IDTITULAR').AsInteger then
        begin
          qryAcJudDeficit.SQL.Add('SELECT DISTINCT C.IDCONTRIBUICAO,    ');
          qryAcJudDeficit.SQL.Add('                C.NOME,              ');
          qryAcJudDeficit.SQL.Add('                AC.PERCACJUDDEFICIT, ');
          qryAcJudDeficit.SQL.Add('                AC.ANOMESINIACJUDDEFICIT, ');
          qryAcJudDeficit.SQL.Add('                AC.ANOMESFIMACJUDDEFICIT  ');
          qryAcJudDeficit.SQL.Add('  FROM CONTRIBPARTPACJUDDEFICIT AC        ');
          qryAcJudDeficit.SQL.Add('  JOIN CONTRIBUICAO C ON C.IDCONTRIBUICAO = AC.IDCONTRIBUICAO ');
          qryAcJudDeficit.SQL.Add('  JOIN (SELECT CON.MESREFERENCIA, CON.IDENTIFICADOR AS IDCONTRIBUICAO, :IDPESSJUR AS IDPESSJUR, ');
          qryAcJudDeficit.SQL.Add('               :IDPLANOPREV AS IDPLANOPREV, :SEQPROPOSTA AS SEQPROPOSTA, CON.IDPESSOA       ');
          qryAcJudDeficit.SQL.Add('          FROM (' + QryDemonstContrib.SQL.text + ') CON ');
          qryAcJudDeficit.SQL.Add('       ) HST ON HST.IDCONTRIBUICAO = AC.IDCONTRIBUICAO  ');
          qryAcJudDeficit.SQL.Add('            AND HST.IDPESSJUR = AC.IDPESSJUR ');
          qryAcJudDeficit.SQL.Add('            AND HST.IDPLANOPREV = AC.IDPLANOPREV ');
          qryAcJudDeficit.SQL.Add('            AND HST.IDPESSOA = AC.IDPESSOA ');
          qryAcJudDeficit.SQL.Add('            AND HST.SEQPROPOSTA = AC.SEQPROPOSTA ');
          qryAcJudDeficit.SQL.Add(' WHERE HST.MESREFERENCIA BETWEEN AC.ANOMESINIACJUDDEFICIT AND       ');
          qryAcJudDeficit.SQL.Add('       NVL(AC.ANOMESFIMACJUDDEFICIT, TO_CHAR(SYSDATE, ''YYYY/MM'')) ');
          qryAcJudDeficit.SQL.Add(' ORDER BY C.IDCONTRIBUICAO, AC.ANOMESINIACJUDDEFICIT ');
        end
        else
        begin
          qryAcJudDeficit.SQL.Add('SELECT DISTINCT C.IDCONTRIBUICAO,    ');
          qryAcJudDeficit.SQL.Add('                C.NOME,              ');
          qryAcJudDeficit.SQL.Add('                AC.PERCACJUDDEFICIT, ');
          qryAcJudDeficit.SQL.Add('                AC.ANOMESINIACJUDDEFICIT, ');
          qryAcJudDeficit.SQL.Add('                AC.ANOMESFIMACJUDDEFICIT  ');
          qryAcJudDeficit.SQL.Add('  FROM CONTRIBPREVNUCLEO CP');
          qryAcJudDeficit.SQL.Add('  JOIN CONTRIBNUCLEOACJUDDEFICIT AC');
          qryAcJudDeficit.SQL.Add('    ON AC.IDCONTRIBUICAO   = CP.IDCONTRIBUICAO');
          qryAcJudDeficit.SQL.Add('   AND AC.IDNUCLEOFAMILIAR = CP.IDNUCLEOFAMILIAR');
          qryAcJudDeficit.SQL.Add('  JOIN CONTRIBUICAO C ON C.IDCONTRIBUICAO = AC.IDCONTRIBUICAO ');
          qryAcJudDeficit.SQL.Add('  JOIN (SELECT CON.MESREFERENCIA, CON.IDENTIFICADOR AS IDCONTRIBUICAO, :IDPESSJUR AS IDPESSJUR, ');
          qryAcJudDeficit.SQL.Add('               :IDPLANOPREV AS IDPLANOPREV, :SEQPROPOSTA AS SEQPROPOSTA, CON.IDPESSOA       ');
          qryAcJudDeficit.SQL.Add('          FROM (' + QryDemonstContrib.SQL.text + ') CON ');
          qryAcJudDeficit.SQL.Add('       ) HST ON HST.IDCONTRIBUICAO = AC.IDCONTRIBUICAO  ');
          qryAcJudDeficit.SQL.Add('            AND HST.IDPESSJUR = CP.IDPESSJUR ');
          qryAcJudDeficit.SQL.Add('            AND HST.IDPLANOPREV = CP.IDPLANOPREV ');
          qryAcJudDeficit.SQL.Add('            AND HST.IDPESSOA = CP.IDPESSOA ');
          qryAcJudDeficit.SQL.Add('            AND HST.SEQPROPOSTA = CP.SEQPROPOSTA ');
          qryAcJudDeficit.SQL.Add(' WHERE HST.MESREFERENCIA BETWEEN AC.ANOMESINIACJUDDEFICIT AND       ');
          qryAcJudDeficit.SQL.Add('       NVL(AC.ANOMESFIMACJUDDEFICIT, TO_CHAR(SYSDATE, ''YYYY/MM'')) ');
          qryAcJudDeficit.SQL.Add(' ORDER BY C.IDCONTRIBUICAO, AC.ANOMESINIACJUDDEFICIT ');
        end;

        if Sistema.IdModulo = 454 then
        begin
          qryAcJudDeficit.ParamByName('IDPESSOA').AsInteger      := QryDemonstrativo.FieldByname('IDPESSOA').AsInteger;
          qryAcJudDeficit.ParamByName('IDPESSJUR').AsInteger     := QryDemonstrativo.FieldByname('IDPESSJUR').AsInteger;
          qryAcJudDeficit.ParamByName('IDTITULAR').AsInteger     := QryDemonstrativo.FieldByname('IDTITULAR').AsInteger; //William Santana - SIG 19417
          qryAcJudDeficit.ParamByName('SEQPROPOSTA').AsInteger   := QryDemonstrativo.FieldByname('SEQPROPOSTA').AsInteger;
          qryAcJudDeficit.ParamByName('IDPLANOPREV').AsInteger   := QryDemonstrativo.FieldByname('IDPLANOPREV').AsInteger;
          qryAcJudDeficit.ParamByName('IDBENEFICIO').AsInteger   := qryDemonstrativo.FieldbyName('IDENTIFICADOR').AsInteger;
          qryAcJudDeficit.ParamByName('DTRECALCULO').AsDateTime  := StrToDateTime( sDataInicioRecalculo );
          if qryDemonstrativo.FieldbyName('DATAINICIO').AsString > edAnoMesIni.Text then
             qryAcJudDeficit.ParamByName('MESINI').AsString      := qryDemonstrativo.FieldbyName('DATAINICIO').AsString
          else
             qryAcJudDeficit.ParamByName('MESINI').AsString      := edAnoMesIni.Text;
          qryAcJudDeficit.ParamByName('MESFIM').AsString         := edAnoMesFim.Text;
          qryAcJudDeficit.open;

          ppSubAcaoJud.Visible := (not qryAcJudDeficit.isEmpty);
        end;
        //edilaine - SIG50850 : fim

     end;

    if QryDemonstrativo.FieldByname('ANOMES').asString <> '0000/00' then
    begin
       QryDemonstrativoEspelho.Insert;
       QryDemonstrativoEspelho.FieldByname('ANOMES').asString        :=  QryDemonstrativo.FieldByname('ANOMES').asString;
       QryDemonstrativoEspelho.FieldByname('IDPESSOA').asString      :=  QryDemonstrativo.FieldByname('IDPESSOA').asString;
       QryDemonstrativoEspelho.FieldByname('IDPLANOPREV').asString   :=  QryDemonstrativo.FieldByname('IDPLANOPREV').asString;
       QryDemonstrativoEspelho.FieldByname('TIPO').asString          :=  QryDemonstrativo.FieldByname('TIPO').asString;
       QryDemonstContrib.Locate('MESREFERENCIA',QryDemonstrativo.FieldByname('ANOMES').asString,[loCaseInsensitive]);
       QryDemonstrativoEspelho.FieldByname('IDENTIFICADOR').asString :=  QryDemonstContrib.FieldByname('IDENTIFICADOR').asString;
       QryDemonstrativoEspelho.FieldByname('VALORDEPOIS').asString   :=  QryDemonstContrib.FieldByname('VALORDEPOIS').asString;
       QryDemonstrativoEspelho.FieldByname('VALORANTES').asString    :=  QryDemonstContrib.FieldByname('VALORANTES').asString;
       QryDemonstrativoEspelho.Post;
    end;

     QryDemonstrativo.Next;

     iIdPessoa := QryDemonstrativo.FieldByname('IDPESSOA').AsInteger;
  end;

end;
