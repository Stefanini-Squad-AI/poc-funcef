       qryBeneficio.SQL.Add(
       ' SELECT  B.IDBENEFICIO, B.TIPOBENEFICIO,                                          '+
       '         DECODE(BG.IDBENEFICIO, NULL, B.NOME, ''Grupo ''||G.DESCRICAO) AS NOME ,  '+
