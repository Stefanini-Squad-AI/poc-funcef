                 for i := 0 to sListaMatricula.count -1 do begin
                   if sSQLWhere='' then begin
                     sSQLWhere := 'AND ( ('+sCampo+' IN ('+sListaMatricula[i]+'))';
                   end else begin
                     sSQLWhere := sSQLWhere+ 'OR ('+sCampo+' IN ('+sListaMatricula[i]+'))';
                   end;
                 end;

                 sSQLWhere := sSQLWhere + ')';
                 SQL.Add(sSQLWhere);
