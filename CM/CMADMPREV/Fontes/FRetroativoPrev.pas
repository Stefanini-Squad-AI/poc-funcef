                   sSQLWhere := sSQLWhere+ 'OR ('+sCampo+' IN ('+sListaMatricula[i]+'))';
                 end;
               end;

               sSQLWhere := sSQLWhere + ')';
               SQL.Add(sSQLWhere);
             end;
           end;
           //Renato Visoni SOL 150703 Kintana 1095570
         end; // Felipe A. Santos SOL 247047 PPM 832618 - fim if RdBtnMatricula.Checked then

         Open;
         if (not IsEmpty) and (FieldByName('TOTAL').AsInteger > 0)
