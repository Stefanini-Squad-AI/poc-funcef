procedure TfrmRetroativoPREV.DestroiFrames;
var
   i : integer;
   Frame : TFrame;
   FrameName : string;
begin
  FrameName := 'FrameBeneficioRevisar';

  qryDadosBeneficio.Filtered := False;
  wwRecViewPnlBeneficios.visible := false;
  i := 0;
  qryDadosBeneficio.first;
  while  not(qryDadosBeneficio.eof) do
  begin
     inc(i);
     qryDadosBeneficio.edit;
     qryDadosBeneficio.FieldByName('PROCESSA').AsInteger  := 0;

     Frame := FindComponent (FrameName + IntToStr(i)) as TFrame;
     if Assigned (Frame) then
     begin
        FreeAndNil(Frame);
     end;
     qryDadosBeneficio.next;
  end;
end;
