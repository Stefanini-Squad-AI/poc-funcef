   sSalarioVirtualNoMesAntesReajuste   : string;
   sSalarioVirtualNoMes                : string;
   bRefazendoRetroativo                : boolean;
   sAnoMesInicioAcerto                 : string;
   sAnoMesFimAcerto                    : string;
   sValorReajustado                    : string;
   sEnquadramentoNoMesAntesReajuste    : string;
   sEnquadramentoNoMes                 : string;
   StrConcedidos                       : string;
   dEnquadramento  : double;
   dIndice                             : double;
   dDescBUA, dDescBUAAux               : double;         //edilaine WO22176
   sqldescBua                          : Twwquery;
   iFlgEnviado                         : integer;
   bCalculaTudo, bBeneficioParaTitular   : boolean;
   iNumRecebimento, iIdRespContribuicao, iIdContribuicao  : longint;
   sSQLBenefAssoc                      : string;
   sDataRefInd, sDataRefSRB            : string;
   sDataInicioAnt                      : string;
   sValorAnt                           : string;
   sNomeBenefAnt                       : string; 
   sIdTpPagtoAnt                       : string;
   sUltMesReajAnt                      : string;
   sFlgBenefMinAnt                     : string;
   sDataEventoAnt                      : string;
   sCodBeneficioAnt                    : string;
   sValorBase1Ant                      : string; 
   sValorBase2Ant                      : string;
   sValorBase3Ant                      : string; 
   sNumProcINSS                        : string;
   SMesCompReem                        : string; //SOL 140042 Kintana 900220
   sFlgBenefMinimo, sBeneficiosAux, sVlrCalcInss, sVlrInfInss : string;
   bPrimCont : Boolean;
   sTextoAux, sIdMotivo, sIndiceCorrecao, sAnoMesInicio, sSQLRegraCorrecao,
   sAnoMesAcertoRetroativo : String;
   SavePlace: TBookmark;
   iIdMovBenefExcluir, iIdRetroativoExcluir, iIdUsuarioAutoriza : longint;
   dCorrecaoMonetaria : Currency;
   bHstDiferente, bExisteRevisao, bInssMigrado, bImprimeCabecalhoPessoa,bAtualizou,bDesconto : Boolean;
   bDeletaHstBenefBfCiario : Boolean; //Renato Visoni SOL 141243 Kinatana 890397
   dValorAtualMovBenef, dValorTotalMovBenef : double; //BRUNO AZEVEDO SOL 152831 Kintana 1142640
   vVALORATUALCriaLog, vVALORTOTALCriaLog : String; //Vinicius Ferreira SOL 171681 Kintana 1540588
   bTeveRA: Boolean; //BRUNO AZEVEDO SOL 169308 KINTANA 1500844
   bTeveREB: Boolean; //BRUNO AZEVEDO SOL 169308 KINTANA 1500844
   // fernando xavier - SOL 253577-17661 / PPM 1019931 - inicio
   dValorFABRateado, dValorBSRateado, dValorDeficitRateado, dValorFAB, dValorBS, dValorFABAtu, dValorBSAtu,
   dValorFABDevido, dValorBSDevido, dValorDeficitDevido,
   dValorDeficit, dValorFABAbono, dValorBSAbono, dValorDeficitAbono,
   dValorFABIni, dValorBSIni, dValorDeficitIni, dValorFABAtuIni, dValorBSAtuIni    : double;
   sValorFAB, sValorBS, sValorDeficit, sValorFABAtu, sValorBSAtu,
   sValorFABGrava, sValorBSGrava, sValorDeficitGrava, psPercentual,
   sValorFABReaj, sValorFABAtuReaj, sValorBSReaj, sValorBSAtuReaj, sValorDeficitReaj : String;
   // fernando xavier - SOL 253577-17661 / PPM 1019931 - fim
   sValorSRB, sValorAtuAnt : string;               // Peterson - SOL 269943 / PPM 1323444
   sDataFinalAnt : string;
   //edilaine WO22176 : iniciio
   dVlrTotTit, dVlrTotTitIni, 
   dVlrFabTit, dVlrBsTit, dVlrBsTitIni, dVlrFabTitIni : double;
   sValorBsTitGrava, sValorFabTitGrava,
   sVlrFabTitAnt, sVlrBsTitAnt, sVlrTotTitAnt, sVlrTotTit,
   sVlrFabTit, sVlrBsTit, sVlrFabTitReaj, sVlrBsTitReaj, sVlrTotTitReaj : string;
   rcBsFab : TRecBsFab;
   bApurouBua, bApurouREB, bApurouRA : boolean;
   iPercPensao : integer;
   //edilaine WO22176 : fim
begin
   Result               := -1; { Erro }
   sAnoMesAtual         := psAnoMesIni;
   bRefazendoRetroativo := False;
   bAtualizou           := False;
   dValorAbonoDigitadoOriginal := 0; //SIG50008


   bDeletaHstBenefBfCiario := False; //Renato Visoni SOL 141243 Kinatana 890397

   prmCalculaSRBNoRetroativo := True;
   if rgrpRecalculaBeneficio.ItemIndex = 4  then
     prmCalculaSRBNoRetroativo := False;

   if rbRecalcBenef.Checked
   then iTipoMov := 13
   else iTipoMov := 6;

   //BRUNO AZEVEDO SOL 158747 KINTANA 1292405
   if (edAnoMesFim.Text = qryLote.FieldByName('MESREFERENCIA').AsString) then begin
     sAnoMesFimRevisao := DecMonth(StrToInt(Copy(edAnoMesFim.Text,1,4)),StrToInt(Copy(edAnoMesFim.Text,6,2)));
   end else begin
     sAnoMesFimRevisao := edAnoMesFim.Text;
   end;
   //BRUNO AZEVEDO SOL 158747 KINTANA 1292405

   iIncluiMesConc  := qryLote.FieldByName('FLGINCLUIMESCONC').Asinteger;
   iIdCalculo      := -1;
   iIdCalculoGeral := -1;
   sAnoMesLote     := qryLote.FieldByName('MESREFERENCIA').AsString;

   sDataPagamento  := CriticaDataCobrancaSit(qryAux,
                                             IntToStr(iIdFundacao),
                                             '',
                                             'AS',
                                             'P',
                                             Copy(sAnoMesLote,6,2),
                                             Copy(sAnoMesLote,1,4),
                                             true); 
   bCalculouContribuicoes := False;

   if rbtnIndividual.Checked
   then sAnoMesInicioAcerto := edAnoMesIniAcerto.Text
   else sAnoMesInicioAcerto := edAnoMesIniAcerto.Text;

   if rbtnIndividual.Checked
   then sAnoMesFimAcerto := edAnoMesFimAcerto.Text
   else sAnoMesFimAcerto := edAnoMesFimAcerto.Text;

   if (rgrpRecalculaBeneficio.ItemIndex <> 3) and (bRefazExistentes or rbtnIndividual.checked)
   then begin
      bExisteRevisao := False;
      bHstDiferente  := False;

      // VERIFICAR SE JÁ TEVE RETROATIVO PARA A PESSOA
      with qryAux do
      begin

         // edilaine - SIG 22026 - inicio
         {valida se existe previa para o beneficio}
         Close;
         SQL.Clear;
         sSQL := ' SELECT 1 FROM PREVIA  P'+
                 ' WHERE  P.IDPATRO      = '+qryPessoasATratar.FieldByName('IDPESSJUR').AsString+
                 ' AND    P.IDPLANOPREV  = '+IntToStr(piIdPlanoPrev)+
                 ' AND    P.IDTITULAR    = '+qryPessoasATratar.FieldByName('IDTITULAR').AsString;

         if rbtnIndividual.Checked then sSQL := sSQL + ' AND P.IDPESSOA = '+ IntToStr(iIdPessoa);

         sSQL := sSQL +' AND    P.SEQPROPOSTA    = '+qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString+
                 ' AND    P.NUMEROPROCESSO = '+IntToStr(iNumeroProcesso)+
                 ' AND    P.MESCOBRANCA    = '''+edMesAcerto.Text+''''  +
                 ' AND    not exists (SELECT 1 FROM CTRLINTERFACE C '+
                 '                     WHERE C.IDLOTE = P.IDLOTE    '+
                 '                       AND C.FLGRESGATE = 1)      ';
         try
            If FazQuery(QryAux, sSQL ) Then
            begin
              MsgDlg('Existe prévia processada para o mês do lote. '+#13+
                     'Favor entrar em contato com a área de Pagamento de Benefícios. ','Informação',mtInformation,[mbOk],0);
              exit;
            end;
         except
            Exit;
         end;
         close;
         // edilaine - SIG 22026 - fim


         if rbtnIndividual.Checked then begin //Renato Visoni SOL 156042
           sSQL := 'SELECT 1 '+
                 'FROM HSTBENEFBFCIARIO HST '+
                 'WHERE  HST.MES         = '+ QuotedStr( qryLote.FieldByName('MESREFERENCIA').AsString ) +' '+
                 'AND    HST.IDTITULAR   = '+ qryPessoasATratar.FieldByName('IDTITULAR').AsString        +' '+
                 'AND    HST.IDPESSOA    = '+ IntToStr( iIdPessoa )                                      +' '+
                 'AND    HST.SEQPROPOSTA = '+ qryPessoasATratar.FieldByName('SEQPROPOSTA').AsString      +' '+
                 'AND    HST.IDPESSJUR   = '+ qryPessoasATratar.FieldByName('IDPESSJUR').AsString        +' '+
                 'AND    HST.IDBENEFICIO IN ('+sBeneficios+') '+' '+
                 'AND    NVL(HST.VLBENEFPGTO, 0) = 0 '+' '+
                 'AND    HST.FLGCONCESSAO        = 0 ';

           If ( FazQuery( QryAux, SSQL ) ) Then Begin

             mResult := MsgDlg('O Benefício já está preparado para o mês "'+ qryLote.FieldByName('MESREFERENCIA').AsString + '" ' + #13 +
                               'Deve ser desfeito o preparo antes. '+#13+
                               'Deseja continuar o processo?',
                               'Atenção', mtConfirmation, [mbYes, mbNo], 0) ;




             If ( mResult = mrNo )
             Then Exit;
           End;
         End; //Renato Visoni SOL 156042

         If Not bExisteRevisao Then Begin

           sSQL := 'SELECT '+
                   '  R.IDRETROATIVO,    R.IDPESSJUR,       R.IDPLANOPREV, R.IDTITULAR, '+
                   '  R.IDPESSOA,        R.SEQPROPOSTA,     R.IDMOTIVO,    R.ANOMESACERTO, '+
                   '  R.ANOMESINIACERTO, R.ANOMESFIMACERTO, '+
                   '  M.IDBENEFICIO,     M.DATAMOV,         NVL(M.IDMOVBENEF,0) AS IDMOVBENEF, '+
                   '  DECODE(NF.IDRESPNUCLEO, NULL, R.IDPESSOA, NF.IDRESPNUCLEO) AS IDRESPCONTRIBUICAO, '+
                   '  MOT.DESCRICAO '+
                   'FROM '+
                   '  RETROATIVOPREV R, MOVBENEF M, BFCIARIOTITPLAN BTIT, NUCLEOFAMILIAR NF,  '+
                   '  MOTIVO MOT '+
                   'WHERE '+
                   '     R.IDPESSJUR   = '+qryPessoasATratar.FieldByName('IDPESSJUR').AsString+
                   ' AND R.IDPLANOPREV = '+IntToStr(piIdPlanoPrev)+
                   ' AND R.IDTITULAR   = '+qryPessoasATratar.FieldByName('IDTITULAR').AsString+
