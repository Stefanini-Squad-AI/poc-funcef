                        { do convênio alguma vez.                                      }
                        If (qryDadosBeneficio.FieldbyName('FLGREFERENCIA').AsInteger = 1) And
                           (qryDadosBeneficio.FieldbyName('PLANOPAGAINSS').AsInteger = 1)
