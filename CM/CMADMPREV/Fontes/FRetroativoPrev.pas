       { fazer acerto de INSS.                                                   }
       If ( bJaSaiuConvenio = False ) Then Begin

         bAcertaINSS := True;

       End Else
       { Caso beneficio esteja retido e o Plano pagar INSS e o beneficio não pagar }
       { INSS, então foi desconveniado, portanto não fazer acerto de INSS.         }

