                  query.ExecSQL;

                  {insere movimento de atualização saldo}
                  CriaLogDivida(qrydet.FieldByName('IDCONTROLEDIVIDABENEFICIO').AsString, '7', qrydet.FieldByName('SALDODEVEDORATUAL').AsString );   //edilaine SIG126276

