                 '  PRO.DTDIREITO,        PRO.DTREGISTRO,       PRO.VLBENEFDTDIREITO, PRO.VLBENEFDTPAGTO, '+
                 '  PRO.IDSITPROCESSO,    PRO.TRGDTINCLUSAO,    PRO.TRGUSERINCLUSAO                       '+
                 'FROM   '+
                 '  PROCESSOBENEF PRO '+
                 'WHERE  '+
                 '  PRO.NUMEROPROCESSO = '+qryBeneficiosTrocar.FieldByName('NUMEROPROCESSO').AsString;

        Try
