procedure TfrmRetroativoPrev.MontaDadosFrameBeneficio;
var Frame, Controle: TFrame;
    i, iContaFrame, iframeTop, iframeTopSomar, iDesconto : integer;
    FrameName : string;
    NamePanel : string;
    Temp, TempAux : TComponent;
    rVlrReserva, rVlrReservaCota : double;
begin

   FrameName := 'FrameBeneficioRevisar';
   iContaFrame    := 0;
   iframeTop      := 20;
   iframeTopSomar := 0;

   if (tbsEtapa4Indiv5.TabVisible) and (prmMenuChamadorRetroativo = 'B') then
   begin
      qryDadosBeneficio.first;

      while not(qryDadosBeneficio.eof) do
      begin
         if (qryDadosBeneficio.FieldByName('IDTITULAR').AsInteger <= 0)  and (qryDadosBeneficio.FieldByName('IDBENEFICIO').AsInteger <= 0) then
         begin
            qryDadosBeneficio.next;
            continue;
         end;
         inc(iContaFrame);
         Frame := FindComponent (FrameName + IntToStr(iContaFrame)) as TFrame;
         if Assigned (Frame) then
         begin
            FreeAndNil(Frame);
         end;
         Frame := FrameBenefRevisar.Create (Self);
         Frame.Parent  := wwRecViewPnlBeneficios;
         Frame.Height  := 244;
         Frame.Width   := 1142; 
         Frame.Visible := True;
         Frame.top     := iframeTop;
         Frame.left    := 6;
         Frame.Name    := FrameName + IntToStr(iContaFrame);
         Frame.BringToFront;

         with Frame do
         begin

           iDesconto := 0;

           // se for Funcef descontar do painel o dado referente ao mes cobranca INSS
           if qryDadosBeneficio.FieldByName('FONTEPAGADORA').AsInteger = 1 then
           begin
             TempAux := FindComponent('GbReemindiv');
             if Assigned(TempAux) then
                iDesconto := TGroupBox(TempAux).Height;

             TempAux := FindComponent('GbLegenda');
             if Assigned(TempAux) then
                TGroupBox(TempAux).Height := TGroupBox(TempAux).Height - iDesconto;

             //edilaine WO22176 : inicio
             TempAux := FindComponent('chkPercPensao');
             if Assigned(TempAux) then
                TCheckBox(TempAux).Top := TCheckBox(TempAux).Top - iDesconto;

             TempAux := FindComponent('edPercPensao');
             if Assigned(TempAux) then
                TEdit(TempAux).Top := TEdit(TempAux).Top - iDesconto;
             //edilaine WO22176 : fim
           end;

           TempAux := FindComponent('pnlDados');
           if Assigned(TempAux) then
           begin
             iframeTopSomar := TPanel(TempAux).Height;
             TPanel(TempAux).Height := TPanel(TempAux).Height - iDesconto;
           end;

           Temp := FindComponent('qryFrameDadosBeneficio');
           if Assigned(Temp) then
           begin
              TwwQuery(temp).Close;
              TwwQuery(temp).ParamByName('IDPESSJUR').AsInteger      := qryDadosBeneficio.FieldByName('IDPESSJUR').AsInteger;
              TwwQuery(temp).ParamByName('IDPLANOPREV').AsInteger    := qryDadosBeneficio.FieldByName('IDPLANOPREV').AsInteger;
              TwwQuery(temp).ParamByName('IDTITULAR').AsInteger      := qryDadosBeneficio.FieldByName('IDTITULAR').AsInteger;
              TwwQuery(temp).ParamByName('IDPESSOA').AsInteger       := qryDadosBeneficio.FieldByName('IDPESSOA').AsInteger;
              TwwQuery(temp).ParamByName('SEQPROPOSTA').AsInteger    := qryDadosBeneficio.FieldByName('SEQPROPOSTA').AsInteger;
              TwwQuery(temp).ParamByName('NUMEROPROCESSO').AsString  := qryDadosBeneficio.FieldByName('NUMEROPROCESSO').AsString;
              TwwQuery(temp).ParamByName('IDBENEFICIO').AsInteger    := qryDadosBeneficio.FieldByName('IDBENEFICIO').AsInteger;
              TwwQuery(temp).Open;

              // passa todos beneficios para achar valores associados (calculo déficit)
              TempAux := FindComponent('qryDadosBeneficios');
              if Assigned(TempAux) then
              begin
                TwwQuery(TempAux).Close;
                TwwQuery(TempAux).SQL.Text := qryDadosBeneficio.SQL.text;
                TwwQuery(TempAux).ParamByName('IDPESSJUR').AsInteger      := qryDadosBeneficio.FieldByName('IDPESSJUR').AsInteger;
                TwwQuery(TempAux).ParamByName('IDPLANOPREV').AsInteger    := qryDadosBeneficio.FieldByName('IDPLANOPREV').AsInteger;
                TwwQuery(TempAux).ParamByName('IDTITULAR').AsInteger      := qryDadosBeneficio.FieldByName('IDTITULAR').AsInteger;
                TwwQuery(TempAux).ParamByName('IDPESSOA').AsInteger       := qryDadosBeneficio.FieldByName('IDPESSOA').AsInteger;
                TwwQuery(TempAux).ParamByName('SEQPROPOSTA').AsInteger    := qryDadosBeneficio.FieldByName('SEQPROPOSTA').AsInteger;
                TwwQuery(TempAux).Open;
              end;

              TempAux := FindComponent('qryBenefbfciario');
              if Assigned(TempAux) then
              begin
                TwwQuery(TempAux).Close;
                TwwQuery(TempAux).SQL.Clear;
                TwwQuery(TempAux).SQL.Text := MontaQryBenefBfciario( qryDadosBeneficio.FieldByName('IDBENEFICIO').AsString,
                                                                     qryDadosBeneficio.FieldByName('IDPLANOPREV').AsInteger,
                                                                     qryDadosBeneficio.FieldByName('IDPESSOA').AsInteger,
                                                                     qryDadosBeneficio.FieldByName('IDTITULAR').AsInteger,
                                                                     qryDadosBeneficio.FieldByName('IDPESSJUR').AsInteger,
                                                                     qryDadosBeneficio.FieldByName('SEQPROPOSTA').AsInteger,
                                                                     edAnoMesIni.Text);

                TwwQuery(TempAux).Open;

                // calcula valor da reserva
                rVlrReserva := CalculaReservaParaBeneficio(TwwQuery(TempAux).FieldByName('IDREGRAPAGAMENTO').AsInteger,
                                                           rVlrReservaCota,
                                                           qryLote.FieldByName('MESREFERENCIA').AsString );
              end;

              TempAux := FindComponent('dbCheckBeneficio');
              if Assigned(TempAux) then
              begin
                 TDBCheckBox(TempAux).onclick :=  dbSelBeneficioClick;
              end;

           end;

           DadosFrame.rVlrReserva       := rVlrReserva;
           DadosFrame.rVlrReservaCota   := rVlrReservaCota;
           DadosFrame.sAnoMesAtual      := edAnoMesIni.Text;
           DadosFrame.iTotBeneficiarios := CtrlBenefBfciario.BuscaQtdBeneficiariosAtivos( qryDadosBeneficio.FieldByName('NUMEROPROCESSO').AsInteger,
                                                                                          qryDadosBeneficio.FieldByName('IDBENEFICIO').AsInteger,
                                                                                          edAnoMesIni.Text, edAnoMesIni.Text );
         end;
         Frame.Height := Frame.Height - iframeTopSomar;
         iframeTop := iframeTop + Frame.Height;

         qryDadosBeneficio.next;
      end;
   end;

end;
