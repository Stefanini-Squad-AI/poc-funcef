function TfrmRetroativoPREV.CalculaProximoMes(
  sAnoMesAtual,
  sAnoMesFim,
  sAnoMesLote,
  sMesPagaAbono : String
  ) : String;
var bRevisaAbono: boolean;
begin

  if (Copy(sAnoMesAtual,6,2) = sMesPagaAbono)
     // SOL 166939/7001 KINTANA 1489722 comentado condição abaixo   or ((sAnoMesAtual = sAnoMesFim) and (Copy(sAnoMesFim,6,2) = '12'))
      //or ((sAnoMesAtual = sAnoMesFim) and (Copy(sAnoMesFim,6,2) = '12')) //Renato Visoni SOL 156165
      //BRUNO AZEVEDO E XAVIER SOL 163776 KINTANA 1401488
      //MES ATUAL E MES INICIAL DA REVISAO IGUAL AS 12 E ANO DA DIB < QUE ANO ATUAL
      or ((sAnoMesAtual = edAnoMesIni.Text) and (Copy(edAnoMesIni.Text,6,2) = '12') and (Copy(qryBenefBfciario.fieldbyname('datainiciofund').asstring,7,4) < Copy(edAnoMesIni.Text,1,4)))
      //BRUNO AZEVEDO SOL 162845 KINTANA 1390992 - REGRA ENVIADA PELO HEBIO
      or  ((Copy(qryBenefBfciario.fieldbyname('datainiciofund').asstring,1,5) <= '16/12')
          and (Copy(sAnoMesAtual,6,2) = '12')
          and (Copy(edAnoMesIni.Text,6,2) = '12') // SOL 164055 KINTANA 1406423 incluido a condição
          and (Copy(qryBenefBfciario.fieldbyname('datainiciofund').asstring,7,4) = Copy(sAnoMesAtual,1,4))) // SOL 163343 Kintana 1394598
       //wo41207 - leandro - inicio
       or ( (sAnoMesAtual = edAnoMesFim.Text)
          and(Copy(qryBenefBfciario.fieldbyname('datainiciofund').asstring,7,4) < Copy(edAnoMesFim.Text,1,4))
          and (Copy(qryBenefBfciario.fieldbyname('datafinal').asstring,7,4) = Copy(edAnoMesFim.Text,1,4))
          and (Copy(qryBenefBfciario.fieldbyname('datafinal').asstring,4,2) < sMesPagaAbono)
       )
       //wo41207 - leandro - fim

  then begin
     bRevisaAbono:=false;
     if (copy(sAnoMesAtual,1,4) = copy(sAnoMesLote,1,4)) then
     {estou no ano corrente e se deve verificar se o mês atual é maior ou igual
      ao mês que se paga o abono}
     begin
       try
         {o mês atual é posterior ao mês de pagamento de abono => então revisa abono}
         if (strtoint(Copy(sAnoMesAtual,6,2)) >= strtoint(sMesPagaAbono)) then
         begin
           bRevisaAbono:=true;
         end
         //wo41207 - leandro - inicio
         else
         begin
           if (Copy(qryBenefBfciario.fieldbyname('datafinal').asstring,7,4) = Copy(edAnoMesFim.Text,1,4))
           and (Copy(qryBenefBfciario.fieldbyname('datainiciofund').asstring,1,5) >= '16/01') then
             bRevisaAbono:=true;
         end;
         //wo41207 - leandro - fim
     except
       end;
     end
     else
     begin
       {ano anterior => então revisa abono}
       bRevisaAbono:=true;
     end;

     if bRevisaAbono then
     begin

       // Verificar se a pessoa possui 13o.
       qryAux.Close;
       qryAux.SQL.Clear;

       qryAux.SQL.Add(' SELECT SUM(DECODE(HST.FLGDEVOLUCAO,1,-HST.VALORPREV,HST.VALORPREV)) AS VALORPAGO '+
                      ' FROM   HSTBENEFBFCIARIO HST                                                          '+
                      ' WHERE  HST.MESREFERENCIA  = '''+Copy(sAnoMesAtual,1,5)+'13'+'''                      '+
                      ' AND    HST.IDTITULAR      = '+qryBenefBfciario.FieldByName('IDTITULAR').AsString      +
                      ' AND    HST.IDPESSOA       = '+qryBenefBfciario.FieldByName('IDPESSOA').AsString       +
                      ' AND    HST.SEQPROPOSTA    = '+qryBenefBfciario.FieldByName('SEQPROPOSTA').AsString    +
                      ' AND    HST.IDPESSJUR      = '+qryBenefBfciario.FieldByName('IDPESSJUR').AsString      +
                      ' AND    HST.IDPLANOPREV    = '+qryBenefBfciario.FieldByName('IDPLANOPREV').AsString    +
                      ' AND    HST.NUMEROPROCESSO = '+qryBenefBfciario.FieldByName('NUMEROPROCESSO').AsString +
                      ' AND    HST.IDBENEFICIO    = '+qryBenefBfciario.FieldByName('IDBENEFICIO').AsString    );
       qryAux.Open;

       { Novo controle para os casos em que os calculos }
       { são feitos na própria rotina de revisão.                                   }
       if qryaux.fieldbyname('VALORPAGO').AsFloat <> 0 then begin
         sAnoMesAtual  := Copy(sAnoMesAtual,1,5)+'13';
         lstMes13.Add(sAnoMesAtual); //Helio - SOL Nº 228244-16260 PPM Nº 442505
       end else begin
         //BRUNO AZEVEDO SOL 165899 KINTANA 1441992
         if ( rgrpRecalculaBeneficio.ItemIndex in [0, 1,2] ) and
         //if ( rgrpRecalculaBeneficio.ItemIndex in [1,2] ) and
         //BRUNO AZEVEDO SOL 165899 KINTANA 1441992
            (
              ( (qryBenefBfciario.FieldByName('FLGREFERENCIA').AsInteger = 1) And (sAnoMesAtual <> sAnoMesFim) )
              or
              (qryBenefBfciario.FieldByName('FLGREFERENCIA').AsInteger = 0)
            )
         Then
           sAnoMesAtual  := Copy(sAnoMesAtual,1,5)+'13'
         Else
           sAnoMesAtual  := ProximoAnoMes(StrToInt(Copy(sAnoMesAtual, 6,2)), StrToInt(Copy(sAnoMesAtual, 1,4)));
       end;

     end
     else
       sAnoMesAtual  := ProximoAnoMes(StrToInt(Copy(sAnoMesAtual, 6,2)), StrToInt(Copy(sAnoMesAtual, 1,4)));

  end
  else if Copy(sAnoMesAtual,6,2) = '13'
       then sAnoMesAtual  := IntToStr(StrToInt(Copy(sAnoMesAtual,1,4))+1)+'/01'
       else sAnoMesAtual  := ProximoAnoMes(StrToInt(Copy(sAnoMesAtual, 6,2)), StrToInt(Copy(sAnoMesAtual, 1,4)));

  Result := sAnoMesAtual;
end;

