procedure TfrmRetroativoPREV.AjustaTela;
var Frame : TFrame;
    iContaFrame, iframeTop, iframeTopSomar : integer;
    FrameName : string;
    bPnlDadosVisivel : boolean;
    bBenefProcessa   : boolean;
    Temp, TempAux    : TComponent;
begin
  iframeTop   := 20;
  FrameName   := 'FrameBeneficioRevisar';
  iContaFrame :=0 ;
  qryDadosBeneficio.first;
  while not(qryDadosBeneficio.eof) do
  begin
    if (qryDadosBeneficio.FieldByName('IDTITULAR').AsInteger <= 0)  and (qryDadosBeneficio.FieldByName('IDBENEFICIO').AsInteger <= 0) then
    begin
       qryDadosBeneficio.next;
       continue;
    end;
    inc(iContaFrame);
    Frame := FindComponent (FrameName + IntToStr(iContaFrame)) as TFrame;
    if Assigned (Frame) then
    begin
      with Frame do
      begin
        // verifica status do beneficio ( marcado / desmarcado )
        Temp := FindComponent('dbCheckBeneficio');
        if (Assigned(Temp)) then
        begin
          bBenefProcessa := TDBCheckBox(Temp).checked
        end;

        // se estiver marcado, mudar a cor do beneficio para vermelho
        TempAux := FindComponent('dbChkBeneficio');
        if Assigned(TempAux) then
        begin
          if bBenefProcessa then
             TDbText(TempAux).Font.Color := clRed
          else
             TDbText(TempAux).Font.Color := clBlack;
        end;

        // verifica estado do painel do grid
        TempAux := FindComponent('pnlDados');
        if Assigned(TempAux) then
        begin
          TPanel(TempAux).Height := TPanel(TempAux).Height;
          iframeTopSomar   := TPanel(TempAux).Height;
          bPnlDadosVisivel := TPanel(TempAux).visible;
          TPanel(TempAux).visible := bBenefProcessa;
        end;


        if (bPnlDadosVisivel) and (not bBenefProcessa) then    // painel ativo e beneficio desmarcado, subtrai a altura do painel
           iframeTopSomar := iframeTopSomar * -1
        else if (bPnlDadosVisivel = bBenefProcessa) then       // nao houve alteracao na selecao, permanece do mesmo tamanho
           iframeTopSomar := 0;

      end;
      Frame.top    := iframeTop;
      Frame.Height := Frame.Height + iframeTopSomar;
      iframeTop    := iframeTop + Frame.Height;
    end;
    qryDadosBeneficio.next;
  end;
end;


