  var Text: String);
var
   qryBuscaData : TwwQuery;
begin
  inherited;
     if copy(Text,6,2)= '13' then
     Text := 'Abono Anual'
  else
     begin
        qryBuscaData := TwwQuery.Create(nil);
        qryBuscaData.DatabaseName := 'BaseDados';
        qryBuscaData.Close;
        qryBuscaData.SQL.Clear;
        qryBuscaData.SQL.Add(' SELECT  CASE WHEN ('+QuotedStr(Text)+' = ''2011/13'') THEN '+chr(13)+
                                       QuotedStr('Abono Anual')+CHR(13)+
        ' else '+CHR(13)+
            'TRIM(TO_CHAR(to_date('+QuotedStr(Text)+',''rrrr/mm''),''Month''))||''/''||TO_CHAR(to_date('+QuotedStr(Text)+',''rrrr/mm''),''rrrr'' ) '+CHR(13)+
        ' end  AS ANOMES FROM DUAL ');

        qryBuscaData.Open;
        Text := qryBuscaData.FieldByName('ANOMES').AsString;
     end;

   FreeAndNil(qryBuscaData); // Renato Visoni SOL 158411 Kintana 1281140

end;
