procedure TfrmRetroativoPREV.MultaJurosCorrecao(pmescobranca,
  pmesreferencia: String; pnumrecebimento: Integer; var pMulta,  pJuros,
  pCorrecao: Real);

var QryAux : TwwQuery;
begin

  pMulta    := 0;
  pJuros    := 0;
  pCorrecao := 0;

  QryAux              := TwwQuery.Create(Self);
  QryAux.DatabaseName := 'BaseDados';
  QryAux.Close;
  QryAux.SQL.Clear;
  //QryAux.SQL.Add(' SELECT DECODE(T.RECPAG,''P'',HST.VALOR *-1) AS VALOR, T.DESCRICAO, T.FLGTIPOALTERADOR ');
  QryAux.SQL.Add(' SELECT DECODE(T.RECPAG,''P'',HST.VALOR *-1,HST.VALOR) AS VALOR, T.DESCRICAO, T.FLGTIPOALTERADOR ');
  QryAux.SQL.Add(' FROM HSTATRASOCONTRIB HST, TIPOALTERADOR T             ');
  QryAux.SQL.Add(' WHERE HST.MESCOBRANCA   = ' + QuotedStr(pmescobranca)   );
  QryAux.SQL.Add('  AND HST.MESREFERENCIA  = ' + QuotedStr(pmesreferencia) );
  QryAux.SQL.Add('  AND HST.NUMRECEBIMENTO = ' + intTostr(pnumrecebimento) );
  QryAux.SQL.Add('  AND T.CODALTERADOR = HST.CODALTERADOR                 ');
  QryAux.Open;
  QryAux.First;

  While not QryAux.Eof do begin
    if QryAux.FieldByname('FLGTIPOALTERADOR').asString = 'M' then begin
      pMulta    := pMulta + QryAux.Fieldbyname('Valor').asFloat;
    end else if QryAux.FieldByname('FLGTIPOALTERADOR').asString = 'J' then begin
      pJuros    := pJuros + QryAux.Fieldbyname('Valor').asFloat;
    end else if QryAux.FieldByname('FLGTIPOALTERADOR').asString = 'C' then begin
      pCorrecao := pCorrecao + QryAux.Fieldbyname('Valor').asFloat;
    end;
    QryAux.Next;
  end;

  FreeAndNil(QryAux);

end;

procedure TfrmRetroativoPREV.AlimentaSubTotal(pIdContribuicao : Integer ;pContribuicao : String ;pValorCobrado, pNovoValor,
  pDiferenca, pCorrecaoMonet, pJuros, pMulta, pTotal: Real);
begin

  if QrySubTotalContrib.Locate('IDCONTRIBUICAO',pIdContribuicao,[]) then begin
    QrySubTotalContrib.Edit;
  end else begin
    QrySubTotalContrib.Append;
  end;

  QrySubTotalContrib.FieldByname('IDCONTRIBUICAO').asInteger := pIdContribuicao;
  QrySubTotalContrib.FieldByname('CONTRIBUICAO').asString    := pContribuicao;
  QrySubTotalContrib.FieldByname('VALORCOBRADO').asFloat     := QrySubTotalContrib.FieldByname('VALORCOBRADO').asFloat  + pValorCobrado;
  QrySubTotalContrib.FieldByname('NOVOVALOR').asFloat        := QrySubTotalContrib.FieldByname('NOVOVALOR').asFloat     + pNovoValor;
  QrySubTotalContrib.FieldByname('DIFERENCA').asFloat        := QrySubTotalContrib.FieldByname('DIFERENCA').asFloat     + pDiferenca;
  QrySubTotalContrib.FieldByname('CORRECAOMONET').asFloat    := QrySubTotalContrib.FieldByname('CORRECAOMONET').asFloat + pCorrecaoMonet;
  QrySubTotalContrib.FieldByname('JUROS').asFloat            := QrySubTotalContrib.FieldByname('JUROS').asFloat         + pJuros;
  QrySubTotalContrib.FieldByname('MULTA').asFloat            := QrySubTotalContrib.FieldByname('MULTA').asFloat         + pMulta;
  QrySubTotalContrib.FieldByname('TOTAL').asFloat            := QrySubTotalContrib.FieldByname('TOTAL').asFloat         + pTotal;

  QrySubTotalContrib.Post;
  
end;
