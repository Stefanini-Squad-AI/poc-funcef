function TfrmRetroativoPREV.DecMonth(AYear, AMonth: Integer): String;
var mes, ano: integer;
begin
  mes := AMonth;
  ano := AYear;
  if mes = 1 then begin
    Dec(ano);
    mes := 12;
  end else
    Dec(mes);

  if (mes <= 9) then begin
    result := IntToStr(ano) + '/' + '0' + IntToStr(mes);
  end else begin
    result := IntToStr(ano) + '/' + IntToStr(mes);
  end;

end;

