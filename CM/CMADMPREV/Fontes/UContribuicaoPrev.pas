         SQL.Clear;
         SQL.Add(' SELECT ABS(SUM(DECODE(DEBCRE,''C'',VALOR,VALOR *-1))) AS VALOR ' +
            ' FROM LANCTODOCUM ' +
            ' WHERE  CODDOCUMENTO = ' + IntToStr(QryDocPGA.FieldByname('CODDOCUMENTOPGA').asInteger) +
            ' AND    OPERACAO    IN (''2'',''4'') ');
         Open;
         dValorDocumento := FieldByName('VALOR').AsFloat;
