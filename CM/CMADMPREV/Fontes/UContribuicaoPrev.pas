//Helio - SOL Nº 253577/17819 PPM Nº 1104948
function IncluiContabilidadeProvPerdas(qryContabil,
                                       qryProvPerds : TWWQuery;
                                       CtrlLancamento : TCtrlLancamento;
                                       pReverteProvisao : Boolean;
                                       pValorEnviar : Extended;
                                       pIdTitular,
                                       pIdPessoa,
                                       pIdPessJur,
                                       pIdContribuicao,
                                       pIdPlanoPrev,
                                       pIdPlanoPrevContab,
                                       pNumRecebimento : Integer;
                                       pCodCentroCusto,
                                       pRecPag,
                                       pInscricaoNumero,
                                       pMesReferencia,
                                       pMesCobranca,
                                       pDataPrevisaoReceb,
                                       pDataVencimento,
                                       pdataPrimeiraInadimplencia : String;
                                       var pPlnCodigo : Integer;
                                       var sMsgErro : String) : Boolean;
var
      criouQryAbriuQryProvPerdas,
      bContribFoiProvisionada : Boolean;
begin
    try //finally
    try

      criouQryAbriuQryProvPerdas := False;

      if Not Assigned(qryProvPerds) then
      begin
        qryProvPerds := CriaAbreQryProvPerdas(pIdContribuicao,
                                              pIdPlanoPrev,
                                              pValorEnviar,
                                              pMesReferencia,
                                              pMesCobranca,
                                              pdataPrimeiraInadimplencia);
        criouQryAbriuQryProvPerdas := True;
      end;

      if qryProvPerds.FieldByName('ESTAINADIPLENTE').AsInteger = 0 then
          Raise Exception.Create('Contribuição não está inadimplente.');


      if Not pReverteProvisao then
      if VerificaContribFoiProvisionada(pIdPessJur,
                                        pIdPlanoPrev,
                                        pIdPlanoPrevContab,
                                        pIdContribuicao,
                                        pIdTitular,
                                        pIdPessoa,
                                        pMesCobranca,
                                        pMesReferencia) then

      if Not pReverteProvisao then
      if bContribFoiProvisionada then
          Raise Exception.Create('Já foi provisionada. ');

      if pReverteProvisao then
      if Not bContribFoiProvisionada then
          Raise Exception.Create('Não se pode reverter uma contribuição que já foi provisionada. ');

      if pCodCentroCusto = '' then
           pCodCentroCusto := ObtemCodCentroCustoQryContrib(pIdPessJur,
                                                            pIdPlanoPrev,
                                                            pIdPessoa,
                                                            pIdContribuicao);

      if pdataPrimeiraInadimplencia = '' then
           pdataPrimeiraInadimplencia := ObtemDataPrimeiraInadimplencia(pIdPessJur,
                                                                       pIdPessoa,
                                                                       pIdTitular,
                                                                       pIdPlanoPrev,
                                                                       pIdPlanoPrevContab,
                                                                       pNumRecebimento,
                                                                       pMesReferencia,
                                                                       pMesCobranca);

      //insere dados na qryContabil que serão utilizados posteriormente
      //para incluir a contabilidade
      if Not FazerInsertContabProvPerdas(qryContabil,
                                         pReverteProvisao,
                                         qryProvPerds.FieldByName('VALORPROV').AsFloat,
                                         pIdPessoa,
                                         pIdPessJur,
                                         pIdContribuicao,
                                         pIdPlanoPrev,
                                         pIdPlanoPrevContab,
                                         pCodCentroCusto,
                                         pRecPag,
                                         pInscricaoNumero,
                                         pMesReferencia,
                                         pMesCobranca,
                                         pDataPrevisaoReceb,
                                         pDataVencimento,
                                         sMsgErro) then
               Raise Exception.Create(sMsgErro);


        //inclui contabilidade baseado nos dados da qryContabil
        //carrega pPlnCodigo, se tiver tido sucesso
        IncluiContabilidade(CtrlLancamento,
                            qryContabil,
                            pPlnCodigo,
                            sMsgErro);
        if sMsgErro <> '' then Raise Exception.Create(sMsgErro);


        //historico para ter controle
        //de quais lançamentos foram provisão de perdas
        if Not InsereProvisaoPerdasContribuicao(pIdPessJur,
                                                pIdPlanoPrev,
                                                pIdPlanoPrevContab,
                                                pIdContribuicao,
                                                pIdTitular,
                                                pIdPessoa,
                                                pMesCobranca,
                                                pMesReferencia,
                                                pValorEnviar,
                                                pDataPrimeiraInadimplencia,
                                                qryProvPerds.FieldByName('PERCENTUAL').AsFloat,
                                                qryProvPerds.FieldByName('VALORPROV').AsFloat,
                                                qryProvPerds.FieldByName('DIASATRASO').AsInteger,
                                                pNumRecebimento,
                                                pPlnCodigo,
                                                pReverteProvisao) then
                 Raise Exception.Create('Erro ao tentar incluir InsereProvisaoPerdasContribuicao.');


        if pReverteProvisao then
        if Not DesabilitaProvisaoPerdasContribuicao(pIdPessJur,
                                                    pIdPlanoPrev,
                                                    pIdPlanoPrevContab,
                                                    pIdContribuicao,
                                                    pIdTitular,
                                                    pIdPessoa,
                                                    pMesCobranca,
                                                    pMesReferencia) then
                 Raise Exception.Create('Erro ao atualizar InsereProvisaoPerdasContribuicao.');

        Result := True;
     except
           on E : Exception do
           begin
                 Result := False;
                 sMsgErro := E.Message;
                 Raise Exception.Create(E.Message);
           end;
     end;
     finally
           if (criouQryAbriuQryProvPerdas) And
              (assigned(qryProvPerds)) then
           begin
             qryProvPerds.Close;
             qryProvPerds.Free;
           end;
     end;
end;

