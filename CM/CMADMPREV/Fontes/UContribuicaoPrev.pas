Function BaixaDocumentoPgaNaoPago(CtrlDocumento: TCtrlDocumento;qryAux :TwwQuery ; psAnoMesReferencia: String;
                                  piIdPlanoPrev: longint; psNomeContrib: String;
                                  //BRUNO AZEVEDO SOL 136737 KINTANA 972753
                                  IdDocumentoPai :Integer; pIdContribuicao: Integer;
                                  qryContabil: TwwQuery; CtrlLancamento: TCtrlLancamento; piIdPessJur: longint): Boolean;
var sMsgErro : String;
    iCodAlterador: integer;
    iNumLancto: integer;
    dValorDocumento: double;
    sDebCre: String;
    iPlnCodigo: integer;
    QryDocPGA : TwwQuery;
    sNoDocumento : String;
    //BRUNO AZEVEDO SOL 136737 KINTANA 972753
