  Qry.Open;

  if Qry.RecordCount > 0 then begin
    Qry.Close;
    Qry.SQL.Clear;
    Qry.SQL.Add(' SELECT DECODE(BA.NUMBANCO,NULL,''NULL'',BA.NUMBANCO)  ||'',''|| ');
    Qry.SQL.Add('   DECODE(AG.NUMAGENCIA,NULL,''NULL'',AG.NUMAGENCIA)  ||'',''||  ');
    Qry.SQL.Add('   DECODE(CO.CONTACORRENTE,NULL,''NULL'',CO.CONTACORRENTE) AS BANCOAGENCIACONTA ');
    Qry.SQL.Add(' FROM BANCO BA, AGENCIABANCARIA AG, CONTABANCARIA CO ');
    Qry.SQL.Add(' WHERE BA.IDPESSOA = AG.IDBANCO                      ');
    Qry.SQL.Add(' AND        CO.IDAGENCIA = AG.IDPESSOA               ');
    Qry.SQL.Add(' AND        CO.FLGCONTAPREF = 1                      ');
    Qry.SQL.Add(' AND        CO.IDPESSOA = ' + iIDPESSOA);
    Qry.Open;

    if not Qry.isEmpty then begin
      Result := Qry.FieldByname('BANCOAGENCIACONTA').asString;
    end;
  end;

  FreeAndNil(Qry);


end;
