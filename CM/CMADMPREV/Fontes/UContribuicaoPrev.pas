// edilaine - SOL 253577-17744 / PPM 1063636 - inicio
function VerificaEventoInadimplencia(qry       : TwwQuery;
                                     iIdPessoa : integer;
                                     var sMsgErro : string;
                                     var sDataEvento : string
                                    ) : boolean;
begin
  sDataEvento := '';
  Result      := false;
  sMsgErro    := '';

  try
    try
      // verifica evento de inadimplencia sem data de retorno
      qry.close;
      qry.Sql.clear;
      qry.Sql.Add('SELECT EV.DATAEVENTO ');
      qry.Sql.Add('  FROM EVENTOSPREV EV ');
      qry.Sql.Add('  JOIN EVENTOGERADOR EG ON (EG.IDEVENTOGERADOR = EV.IDEVENTOGERADOR) ');
      qry.Sql.Add(' WHERE EG.FLGINTERNO = ''RI'' ');   // evento de registro de inadimplencia
      qry.Sql.Add('   AND EV.DATAVOLTA  IS NULL   ');
      qry.Sql.Add('   AND EV.IDPESSOA = '+IntToStr(iIdPessoa) );
      qry.open;

      if not qry.eof then
         sDataEvento := qry.FieldByName('DATAEVENTO').AsString;

      result := not qry.eof;

    except
      sMsgErro := 'Erro ao consultar evento de inadimplência';
    end;
  finally
    qry.close;
  end;
end;


function AjustaEventoInadimplencia(qry  : TwwQuery;
                                   iIdPessoa : integer;
                                   var sMsgErro : string;
                                   sDtUltBaixa : string
                                  ) : boolean;
var
  sDataEvento : string;
begin
  Result := false;
  sMsgErro := '';

  try
    try
      // verifica evento de inadimplencia sem data de retorno
      if VerificaEventoInadimplencia(qry, iIdPessoa, sMsgErro, sDataEvento) then
      begin

        // verifica se não existe mais contribuicoes pendentes
        {sitRecebimento <> 2 e recebimento entre data do evento e atual}
        qry.close;
        qry.Sql.clear;
        qry.Sql.Add('SELECT * ');
        qry.Sql.Add('  FROM HSTCONTRIBPREV H ');
        qry.Sql.Add(' WHERE H.SITRECEBIMENTO <> 2 ');
        qry.Sql.Add('   AND H.IDPESSOA = '+IntToStr(iIdPessoa) );
        qry.Sql.Add('   AND H.DATAPREVISAORECE BETWEEN TO_DATE('+Quotedstr(sDataEvento)+', ''DD/MM/YYYY'') AND SYSDATE ');
        qry.open;
        if not qry.eof then
           exit;

        // atualizar datafinal do evento
        if sDtUltBaixa <> '' then
        begin
          qry.close;
          qry.Sql.clear;
          qry.Sql.Add('UPDATE EVENTOSPREV E');
          qry.Sql.Add('   SET E.DATAVOLTA = '+Quotedstr(sDtUltBaixa) );
          qry.Sql.Add(' WHERE E.DATAVOLTA  IS NULL   ');
          qry.Sql.Add('   AND E.IDPESSOA = '+IntToStr(iIdPessoa) );
          qry.Sql.Add('   AND EXISTS (SELECT 1 FROM EVENTOGERADOR EG ');
          qry.Sql.Add('                WHERE EG.IDEVENTOGERADOR = E.IDEVENTOGERADOR ');
          qry.Sql.Add('                  AND EG.FLGINTERNO = ''RI'') ');   // evento de registro de inadimplencia
          qry.ExecSQL;

          // se houver parametro pessoa = 209, ajustar tambem datafim
          qry.close;
          qry.Sql.clear;
          qry.Sql.Add('UPDATE PESSOAPARAM P');
          qry.Sql.Add('   SET P.DATAFIM = '+Quotedstr(sDtUltBaixa) );
          qry.Sql.Add(' WHERE P.DATAFIM  IS NULL   ');
          qry.Sql.Add('   AND P.IDPESSOA = '+IntToStr(iIdPessoa) );
          qry.Sql.Add('   AND P.IDPARAM = 209 ');
          qry.ExecSQL;

        end;
      end;

      Result := true;

    except
      sMsgErro := 'Erro na atualização da data de retorno da inadimplência. ';
      Exit;
    end;

  finally
    qry.close;
  end;

end;
