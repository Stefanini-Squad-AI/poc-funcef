     FazerInsertContab(qryContabil,
//               qryAux.FieldByName('PLACONTA').AsString,
//               qryAux.FieldByName('CODCENTROCUSTO').AsString,
               qryAuxEst.FieldByName('contadeb').AsString,
               qryAuxEst.FieldByName('CODCENTROCUSTO').AsString,
               'D',
               '2',
               IntToStr(piCodDocumentoPrev),
               'Contabilização estorno',
               '',
               '', '', '',
               prmUnidNegoc,
               0,
               dValorDocumento,
               0,
               Date,
               '',
               piIdPessJur,   //IDPESSJUR
               piIdPlanoPrev,
               qryAuxEst.FieldByName('contacre').AsString);


     //edilaine SIG113618 : inicio
     {qryAux.Close;
     qryAux.Sql.Clear;
     qryAux.Sql.Add('select * from lanctodocum where coddocumento =  ' + IntToStr(piCodDocumentoPrev) + ' and plncodigo is not null');
     qryAux.Open;
     iPlnCodigoAnt := qryAux.FieldByName('plncodigo').AsInteger;

     qryAux.Close;
     qryAux.Sql.Clear;
     qryAux.Sql.Add('select * from lancamento where plncodigo =  ' + IntToStr(iPlnCodigoAnt) + ' and lacdebcre = ''C''');
     qryAux.Open;
     }//edilaine SIG113618 : fim

     inc(iLacNumLanc);

     IncluiContabilidade(CtrlLancamento, qryContabil, iPlnCodigo, sMsgErro, qryAuxEst.FieldByName('contacre').AsString, iLacNumLanc);

     qryAuxEst.Next;
   end;

   qryAuxEst.close;
   FreeAndNil(QryAuxEst);
   //wo38661 - Leandro - fim

   qryAux.Close;
   qryAux.SQL.Clear;
   qryAux.SQL.Add(' UPDATE LANCTODOCUM SET PLNCODIGO = ' + IntToStr(iPlnCodigo) +
                  '  WHERE CODDOCUMENTO = ' + IntToStr(piCodDocumentoPrev) +
                  '    AND CODALTERADOR = ' + IntToStr(iCodAlterador));
   qryAux.ExecSql;
   //BRUNO AZEVEDO SOL 136737 KINTANA 972753

   BaixaDocumentoPgaNaoPago(CtrlDocumento,qryAux,psAnoMesReferencia,piIdPlanoPrev,psNomeContrib,piCodDocumentoPrev, pIdContribuicao, qryContabil, CtrlLancamento, piIdPessJur);//Renato Visoni SOL 132353 Kintana 762829


   Result := True;
