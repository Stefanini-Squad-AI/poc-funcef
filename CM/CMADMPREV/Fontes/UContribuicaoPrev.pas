    End;

    //BRUNO AZEVEDO SOL 136737 KINTANA 972753
   iPlnCodigo := 0;

   qryAux.Close;
   qryAux.Sql.Clear;
   qryAux.Sql.Add('SELECT * FROM TIPOALTERADOR WHERE CODALTERADOR = ' + IntToStr(iCodAlterador));
