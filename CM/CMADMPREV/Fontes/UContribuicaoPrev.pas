      '        CPP.PLANO13,          CPP.PLACONTAC13,        CPP.PLACONTAD13,        ' + #13 +
      '        CPP.CODCENTROCUSTOC13, CPP.IDEMPRESA13,       CPP.CODCENTROCUSTOD13,  ' + #13 +
