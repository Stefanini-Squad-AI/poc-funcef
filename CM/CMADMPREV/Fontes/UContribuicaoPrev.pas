//Higor Nayde 162126*RE01 KINTANA 792563
   if (piIdPlanoContabil <> '')then
   sSQLValues := sSQLValues +  ', '+ (piIdPlanoContabil)
   else
   sSQLValues := sSQLValues +  ', NULL ';
//Higor Nayde 162126*RE01 KINTANA 792563

  // Paulo Nobre - WO6161 - Inicio
  If (piIdPessoaOrigem <> 0) Then
    sSQLValues := sSQLValues + ', ' + inttostr(piIdPessoaOrigem)
  Else
    sSQLValues := sSQLValues + ', NULL ';
  // Paulo Nobre - WO6161 - Fim

   With qryAux Do
      Begin
         Close;
         SQL.Clear;
         SQL.Add(' INSERT INTO HSTCONTRIBPREV (MESREFERENCIA,MESCOBRANCA,NUMRECEBIMENTO,IDMOTIVO,' +
            '                             CODPORTFORMA,DATAPREVISAORECE,DATARECEBIMENTO, ' +
            '                             VALORESPERADO,VALORCALCULADO,VALORRECEBIDO,IDREGRACALCULO, ' +
            '                             FLGDESCFOLHA,IDPESSOA,SEQPROPOSTA,IDPESSJUR,IDPLANOPREV,IDCONTRIBUICAO, ' +
            '                             FLGCALCRESERVA,VALOROP1,VALOROP2,VALOROP3,DATAINICIO,DATAFINAL,         ' +
            '                             FLGSITFUNDACAO,SITRECEBIMENTO,TIPO,IDLOTE,PARCELA,FLGDEVOLUCAO,FLGCONCESSAO, ' +
            '                             FLGEVENTO, FOLHAORIGEM, IDMOVBENEF, IDTITULAR, NUMBANCO,NUMAGENCIA,CONTACORRENTE, DATAEMISSCOB,IDPLANPREVCONTAB, ' + //Higor Nayde Ferreira SOL 162126*RE01 KINTANA 792563 //Renato Visoni SOL 153051 Kintana 1165364
            '                             IDPESSOAORIGEM) ' + // Paulo Nobre - WO6161
            ' VALUES(' + sSQLValues + ')');
         Try
            Execsql;
         Except

            Exit;
         End;
      End; //with
   Result := iNumRecebimento;
End;


