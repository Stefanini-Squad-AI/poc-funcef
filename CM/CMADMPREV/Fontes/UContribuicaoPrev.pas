   //BRUNO AZEVEDO SOL 136737 KINTANA 972753
   iPlnCodigo := 0; 

   //wo38661 - Leandro - inicio
   //qryAux.Close;
   //qryAux.Sql.Clear;
   //qryAux.Sql.Add('SELECT * FROM TIPOALTERADOR WHERE CODALTERADOR = ' + IntToStr(iCodAlterador));
   //qryAux.Open;

   iLacNumLanc := 0;

   qryAuxEst := TwwQuery.Create(application);
   qryAuxEst.DatabaseName := qryAux.DatabaseName;

   qryAuxEst.Close;
   qryAuxEst.SQL.Clear;
//   qryAuxEst.SQL.Add(' SELECT ABS(SUM(DECODE(DEBCRE,''C'',VALOR,VALOR *-1))) AS VALOR ' +
//                     ' FROM LANCTODOCUM ' +
//                     ' WHERE  CODDOCUMENTO = ' + IntToStr(piCodDocumentoPrev) +
//                     ' AND    OPERACAO    IN (''2'',''4'') AND DEBCRE = ''D'' ' +
//                     ' group by numlancto');

   qryAuxEst.SQL.Add(' select d.plncodigo, ' +
                     '        d.valor,     ' +
                     '        d.operacao,  ' +
                     '        d.codalterador, ' +
                     '        d.valor,        ' +
                     '        t.codcentrocusto, ' +
                     '        (select distinct placonta from lancamento where plncodigo = d.plncodigo and lacdebcre = ''C'') as contacre, ' +
                     '        (select distinct placonta from lancamento where plncodigo = d.plncodigo and lacdebcre = ''D'') as contadeb  ' +
                     ' from lanctodocum d                                                                                      ' +
                     '      left join tipoalterador t on d.codalterador = t.codalterador                                       ' +
                     ' where d.coddocumento = ' + IntToStr(piCodDocumentoPrev) +
                     ' AND    D.OPERACAO    IN (''2'',''4'') AND DEBCRE = ''D''');

   qryAuxEst.Open;

   while not qryAuxEst.Eof do
