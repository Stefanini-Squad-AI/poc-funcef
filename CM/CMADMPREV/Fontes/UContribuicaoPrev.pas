      qryCont.Sql.Add('       HST.DATAPAGAMENTO,                    ');
      qryCont.Sql.Add('       C.IDTPCONTRIBUICAO,                   ');
      qryCont.Sql.Add('       TPC.FLGDEFICIT,                       ');  // edilaine - SIG32303
      qryCont.Sql.Add('       NVL(MB.TIPOMOV, -1) AS TIPOMOV        ');  // edilaine - SOL 253577-18070  PPM 1240812
      qryCont.Sql.Add('       ,BF.IDSITBENEFICIO                    ');  // Helen - WO11898
      // edilaine - SOL 263032 / PPM 1102465 - inicio
      {qryCont.Sql.Add('  FROM BENEFXTAXA BT, BENEFBFCIARIO BF, HSTBENEFBFCIARIO HST, bfciariotitplan BTIT, ');
      qryCont.Sql.Add('       CONTRIBUICAO C,                          ');
      qryCont.Sql.Add('       (SELECT DISTINCT IDPESSOA, 1 AS ACAOJUD  ');
      qryCont.Sql.Add('          FROM PESSOAPARAM PP                   ');
      qryCont.Sql.Add('         WHERE PP.IDPARAM = 122                 ');
      qryCont.Sql.Add('           --AND PP.IDPESSOA = 220534           ');
      qryCont.Sql.Add('           AND PP.VALOR = ''S''                 ');
      qryCont.Sql.Add('       ) P                                      ');
      qryCont.Sql.Add(' WHERE BT.IDBENEFICIO = BF.IDBENEFICIO          ');
      qryCont.Sql.Add('   AND BT.IDBENEFICIO = HST.IDBENEFICIO         ');
      qryCont.Sql.Add('   AND BF.IDBENEFICIO = HST.IDBENEFICIO         ');
      qryCont.Sql.Add('   AND BF.NUMEROPROCESSO = HST.NUMEROPROCESSO   ');
      qryCont.Sql.Add('   AND BF.IDPESSJUR = BTIT.IDPESSJUR            ');
      qryCont.Sql.Add('   AND BF.IDPESSOA  = BTIT.IDPESSOA             ');
      qryCont.Sql.Add('   AND BF.IDTITULAR = BTIT.IDTITULAR            ');
      qryCont.Sql.Add('   AND BF.SEQPROPOSTA = BTIT.SEQPROPOSTA        ');
      qryCont.Sql.Add('   AND BT.IDCONTRIBUICAO = C.IDCONTRIBUICAO     ');
      qryCont.Sql.Add('   AND BF.IDPESSOA = P.IDPESSOA(+)              '); }

      qryCont.Sql.Add(' FROM BENEFXTAXA BT     ');
      qryCont.Sql.Add(' JOIN BENEFBFCIARIO BF ON BT.IDBENEFICIO = BF.IDBENEFICIO              ');
      qryCont.Sql.Add(' JOIN HSTBENEFBFCIARIO HST ON BF.IDBENEFICIO = HST.IDBENEFICIO         ');
      qryCont.Sql.Add('                          AND BF.NUMEROPROCESSO = HST.NUMEROPROCESSO   ');
      qryCont.Sql.Add('                          AND BF.IDPLANOPREV = HST.IDPLANOPREV         ');
      qryCont.Sql.Add('                          AND BF.IDPESSJUR = HST.IDPESSJUR             ');
      qryCont.Sql.Add('                          AND BF.IDTITULAR = HST.IDTITULAR             ');
      qryCont.Sql.Add('                          AND BF.IDPLANOORIGEM = HST.IDPLANOORIGEM     ');
      qryCont.Sql.Add('                          AND BF.IDPESSOA = HST.IDPESSOA               ');
      qryCont.Sql.Add('                          AND BF.SEQPROPOSTA = HST.SEQPROPOSTA         ');
      qryCont.Sql.Add(' JOIN BFCIARIOTITPLAN BTIT ON BTIT.IDPESSJUR = BF.IDPESSJUR            ');
      qryCont.Sql.Add('                          AND BTIT.IDTITULAR = BF.IDTITULAR            ');
      qryCont.Sql.Add('                          AND BTIT.IDPLANOORIGEM = BF.IDPLANOORIGEM    ');
      qryCont.Sql.Add('                          AND BTIT.IDPESSOA = BF.IDPESSOA              ');
      qryCont.Sql.Add('                          AND BTIT.SEQPROPOSTA = BF.SEQPROPOSTA        ');
      qryCont.Sql.Add('                          AND BTIT.IDPLANOPREV = BF.IDPLANOPREV        ');
      qryCont.Sql.Add('                          AND BTIT.IDBENEFICIO = BF.IDBENEFICIO        ');
      qryCont.Sql.Add(' JOIN CONTRIBUICAO C ON BT.IDCONTRIBUICAO = C.IDCONTRIBUICAO           ');

      qryCont.Sql.Add(' LEFT JOIN TPCONTRIBUICAO TPC ON C.IDTPCONTRIBUICAO = TPC.IDTPCONTRIBUICAO  ');   // edilaine - SIG32303

      // edilaine - SOL 253577-18070  PPM 1240812 - inicio
      qryCont.Sql.Add(' LEFT JOIN MOVBENEF MB on  bf.IDPLANOPREV = mb.idplanoprev and         ');
      qryCont.Sql.Add('                           bf.IDBENEFICIO = mb.idbeneficio and         ');
      qryCont.Sql.Add('                           bf.NUMEROPROCESSO = mb.numeroprocesso and   ');
      qryCont.Sql.Add('                           bf.IDPESSJUR = mb.idpessjur and             ');
      qryCont.Sql.Add('                           bf.IDTITULAR = mb.idtitular and             ');
      qryCont.Sql.Add('                           bf.IDPLANOORIGEM = mb.idplanoorigem and     ');
      qryCont.Sql.Add('                           bf.IDPESSOA = mb.idpessoa and               ');
      qryCont.Sql.Add('                           bf.SEQPROPOSTA = mb.seqproposta AND         ');
      qryCont.Sql.Add('                           HST.IDLOTE = MB.IDLOTEMOV                    ');
      // edilaine - SOL 253577-18070  PPM 1240812 - fim
      qryCont.Sql.Add(' LEFT JOIN (SELECT DISTINCT IDPESSOA, 1 AS ACAOJUD                     ');
      qryCont.Sql.Add('            FROM PESSOAPARAM PP                                        ');
      qryCont.Sql.Add('            WHERE PP.IDPARAM = 122                                     ');
      qryCont.Sql.Add('              AND PP.VALOR = ''S'' ) P ON BF.IDPESSOA = P.IDPESSOA     ');
      qryCont.Sql.Add('WHERE ');
      // edilaine - SOL 263032 / PPM 1102465 - fim
      qryCont.Sql.Add('      exists (select 1                         ');
      qryCont.Sql.Add('                from contprev cp           ');
      qryCont.Sql.Add('                where cp.idcontribuicao = c.idcontribuicao and  ');
      qryCont.Sql.Add('                      cp.idplanoprev = bf.idplanoprev and       ');
      qryCont.Sql.Add('                      cp.flgdescfolha = 1)                      ');
      qryCont.Sql.Add('   AND BF.NUMEROPROCESSO = '+IntToStr(iNumProcesso)     );

      // helio - SOL 253577-17666 - incio
      if iIdPessoa <> -1 then
         qryCont.Sql.Add('   AND BF.IDPESSOA       = '+IntToStr(iIdPessoa)        );

      qryCont.Sql.Add('   AND BF.IDTITULAR      = '+IntToStr(iIdTitular)        );

      // edilaine - SOL 271311 / PPM 1361303 - inicio
      if (iTipoMov <> 14) then
        qryCont.Sql.Add('   AND HST.MES           = '+QuotedStr(smescobranca)    )
      else
      begin
        qryCont.Sql.Add('AND (HST.MES = '+QuotedStr(smescobranca)+' OR HST.FLGTIPOREGISTRO <> 2) ');//William Santana - SIG 30313
        qryCont.Sql.Add('   AND HST.MES = (SELECT MAX(HB1.MES)                            ');
        qryCont.Sql.Add('                    FROM HSTBENEFBFCIARIO HB1                    ');
        qryCont.Sql.Add('                   WHERE HB1.IDPLANOPREV = HST.IDPLANOPREV       ');
        qryCont.Sql.Add('                     AND HB1.IDBENEFICIO = HST.IDBENEFICIO       ');
        qryCont.Sql.Add('                     AND HB1.NUMEROPROCESSO = HST.NUMEROPROCESSO ');
        qryCont.Sql.Add('                     AND HB1.IDPESSJUR = HST.IDPESSJUR           ');
        qryCont.Sql.Add('                     AND HB1.IDTITULAR = HST.IDTITULAR           ');
        qryCont.Sql.Add('                     AND HB1.IDPLANOORIGEM = HST.IDPLANOORIGEM   ');
        qryCont.Sql.Add('                     AND HB1.IDPESSOA = HST.IDPESSOA             ');
        qryCont.Sql.Add('                     AND HB1.SEQPROPOSTA = HST.SEQPROPOSTA       ');
        qryCont.Sql.Add('                     AND HB1.MESREFERENCIA = HST.MESREFERENCIA)  ');
      end;
      // edilaine - SOL 271311 / PPM 1361303 - fim

      if (smesreferencia <> '') then
      begin
         if (iTipoMov <> 14) then   // edilaine - SOL 271311 / PPM 1361303
            qryCont.Sql.Add('   AND HST.MESREFERENCIA = '+QuotedStr(smesreferencia)  )
         else
            //qryCont.Sql.Add('   AND HST.MESREFERENCIA BETWEEN '+QuotedStr(smesreferencia)+' AND '+QuotedStr(smesreferenciaFim)  );       // edilaine - SOL 271311 / PPM 1361303 // Andre Imakawa - SIG 33915
            // Andre Imakawa - SIG 33915 - Inicio
            begin
              qryCont.Sql.Add('   AND ((HST.MESREFERENCIA BETWEEN '+QuotedStr(smesreferencia)+' AND '+QuotedStr(smesreferenciaFim)+' )'  );
              qryCont.Sql.Add(' OR (TO_NUMBER(SUBSTR('+ QuotedStr(smesreferenciaFim) + ',6,2)) >= 11 AND HST.MESREFERENCIA = SUBSTR(' + QuotedStr(smesreferenciaFim) + ' ,1,5) || ''13''))' );
            end;
            // Andre Imakawa - SIG 33915 - Fim
      end;
      // helio - SOL 253577-17666 - fim

      if (iTipoMov <> 14) then         // edilaine - SOL 271311 / PPM 1361303
         qryCont.Sql.Add('   AND HST.IDLOTE        = '+IntToStr(iIdLote)          );

      //edilaine SIG121019 : inicio
      if (iTipoMov = 12) then
         qryCont.Sql.Add('   AND NVL(HST.FLGDEVOLUCAO,0) <> 1 ');
      //edilaine SIG121019 : fim

      qryCont.Sql.Add('ORDER BY BF.IDPESSOA, BT.IDCONTRIBUICAO, HST.MESREFERENCIA ');  // edilaine - SOL 253577-17570 / PPM 978024

      qryCont.open;
      if (not qryCont.eof) then
      begin

        while (not qryCont.eof) do
        begin

          // edilaine - SOL 263032 / PPM 1102465 - inicio
          { inserido o update do nucleo dentro looping }

          if (iTipoMov <> 14) then //SIG32714 - Peterson Victor
          begin

            // atualiza FLGCOBRA do nucleo familiar para pensoes
            if qryCont.FieldByName('IDPESSOA').AsString <> qryCont.FieldByName('IDTITULAR').AsString then
            begin
              if sNucleo.IndexOf(  qryCont.FieldByName('IDNUCLEOFAMILIAR').AsString ) = -1 then
              begin
                ExecutarQuery(QryAux,'UPDATE CM.CONTRIBPREVNUCLEO SET '+
                                     'FLGCOBRA = 1 '+
                                     'WHERE  IDNUCLEOFAMILIAR = '+qryCont.FieldByName('IDNUCLEOFAMILIAR').AsString+' ');

                sNucleo.Add(qryCont.FieldByName('IDNUCLEOFAMILIAR').AsString);
              end;
            end
            else   // edilaine - SOL 253577-17570 / PPM 989569 - inicio
            begin
              if (IdPessoaAux <> qryCont.FieldByName('IDPESSOA').AsInteger) or
