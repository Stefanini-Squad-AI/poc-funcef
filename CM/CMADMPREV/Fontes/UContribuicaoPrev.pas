      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(' UPDATE DOCUMENTO SET STATUS = ''2'' WHERE CODDOCUMENTO = ' + IntToStr(QryDocPGA.FieldByname('CODDOCUMENTOPGA').asInteger));
      qryAux.ExecSQL;
      qryAux.Close;
    Except
