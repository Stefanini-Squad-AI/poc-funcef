//construi query que valida se a contribuicao
//esta inadiplente e traz percentual e valor
//de inadiplencia quando for inadiplente
function ConstroiSQLProvPerdas(pValorEnviar,
                               pDiasAtraso,
                               pIdPlanoPrev,
                               pIdContribuicao,
                               pMesReferencia,
                               pMesCobranca : String;
                               trazSomenteId : Boolean = False) : String;
var
    sSQL,
    colunas : String;
begin

       if trazSomenteId then
            colunas := '        F.IDFAIXASPROVISAOPERDACONTRIB'
       else
       begin
            colunas := '        PERCENTUAL, ' +#13+
                       '        ' + pValorEnviar + '/100 * PERCENTUAL AS VALORPROV, ' +#13+
                       '        ' + pDiasAtraso + ' AS DIASATRASO, ' +#13+
                       '        1 ESTAINADIPLENTE ';
       end;


        sSQL := sSQL + ' SELECT ' +#13+

                       colunas +#13+

                       ' FROM FAIXASPROVISAOPERDACONTRIB F ' +#13+
                       ' WHERE F.INICIOVIGENCIA <= SYSDATE ' +#13+
                       ' AND (F.FIMVIGENCIA IS NULL OR F.FIMVIGENCIA >= SYSDATE) ' +#13+
                       ' AND F.FAIXAINICIAL <= ' + pDiasAtraso +#13+
                       ' AND F.FAIXAFINAL >= ' + pDiasAtraso +#13+
                       //' AND IDPLANOPREV = ' + IntToStr(pIdPlanoPrev) +#13+
                       //' AND IDCONTRIBUICAO = ' + IntToStr(pIdContribuicao) +#13+
                       {helio aqui remover}{' AND EXISTS(SELECT 1 FROM PARAMAPREV P ' +#13+
                       '              WHERE IDFUNDACAO = 1 ' +#13+
                       '              AND IDMOTIVODIVERG = ' + IntToStr(pIdMotivo) + ') ' +#13+}
                       ' AND ' + pMesReferencia + ' <> ' + pMesCobranca +#13+
                       'AND EXISTS (SELECT 1 FROM FAIXASPROVISAOPERDACONTRIB F1 ' + #13 +
                       '            WHERE F.INICIOVIGENCIA = F1.INICIOVIGENCIA ' + #13 +
                       '            AND (F.FIMVIGENCIA = F1.FIMVIGENCIA OR (F1.FIMVIGENCIA IS NULL AND F.FIMVIGENCIA IS NULL)) ' + #13 +
                       '            AND F.FAIXAINICIAL = F1.FAIXAINICIAL ' + #13 +
                       '            AND F.FAIXAFINAL = F1.FAIXAFINAL ' + #13 +
                       '            AND F.PERCENTUAL = F1.PERCENTUAL ' + #13 +
                       '            AND IDPLANOPREV = ' + pIdPlanoPrev +') ' + #13 +
                       'AND EXISTS (SELECT 1 FROM FAIXASPROVISAOPERDACONTRIB F2 ' + #13 +
                       '            WHERE F.INICIOVIGENCIA = F2.INICIOVIGENCIA ' + #13 +
                       '            AND (F.FIMVIGENCIA = F2.FIMVIGENCIA OR (F2.FIMVIGENCIA IS NULL AND F.FIMVIGENCIA IS NULL)) ' + #13 +
                       '            AND F.FAIXAINICIAL = F2.FAIXAINICIAL ' + #13 +
                       '            AND F.FAIXAFINAL = F2.FAIXAFINAL ' + #13 +
                       '            AND F.PERCENTUAL = F2.PERCENTUAL ' + #13 +
                       '            AND IDCONTRIBUICAO = ' + pIdContribuicao + ') ' +#13+
                       'AND ROWNUM = 1 ';

        Result := sSQL;
end;

//Helio - SOL Nº 253577/17819 PPM Nº 1104948
function CriaAbreQryProvPerdas(pIdContribuicao,
                               pIdPlanoPrev : Integer;
                               pValorEnviar : Extended;
                               pMesReferencia,
                               pMesCobranca,
                               pDataPrevisaoReceb : String) : TWWQuery;
var
    qryProvPerds : TWWQuery;
    dataPrevisao,
    dataAtual : TDateTime;
    strValorEnviar,
    strDataAtua : String;
    diasAtraso : Integer;
    invalidoMesDiferente : Boolean;
begin

      invalidoMesDiferente := false;
      invalidoMesDiferente := pMesReferencia = pMesCobranca;

      dataAtual := Date;
      strDataAtua := FormatDateTime('dd/mm/yyy', dataAtual);
      dataPrevisao := StrToDate(pDataPrevisaoReceb);
      diasAtraso := DiasUteis.IntervaloDias(dataPrevisao, dataAtual);
      strValorEnviar := FloatToStr(pValorEnviar);
      strValorEnviar := StringReplace(strValorEnviar, ',', '.', [rfIgnoreCase, rfReplaceAll]);

      qryProvPerds := TWWQuery.Create(Application);
      try
          qryProvPerds.DatabaseName := 'BaseDados';

          qryProvPerds.SQL.Text := ConstroiSQLProvPerdas(strValorEnviar,
                                                         IntToStr(diasAtraso),
                                                         IntToStr(pIdPlanoPrev),
                                                         IntToStr(pIdContribuicao),
                                                         Quotedstr(pMesReferencia),
                                                         Quotedstr(pMesCobranca));

          if Not invalidoMesDiferente then
               qryProvPerds.Open;

          if (qryProvPerds.IsEmpty) Or
             (invalidoMesDiferente) then
          begin
              qryProvPerds.Close;
              qryProvPerds.SQL.Text := 'SELECT 0 AS PERCENTUAL,' + #13#10 +
                                       '       0 AS VALORPROV,'  + #13#10 +
                                 '       0 AS DIASATRASO,' + #13#10 +
                                 '       0 AS ESTAINADIPLENTE' + #13#10 +
                                 'FROM DUAL';
              qryProvPerds.Open;
          end;

      finally
          Result := qryProvPerds;
      end;
end;

//Helio - SOL Nº 253577/17819 PPM Nº 1104948
procedure CarregaContasInadiplencia(var pContaCInad : String;
                                    var pContaDInad : String;
                                    pReverteProvisao : Boolean;
                                    pMesReferencia : String;
                                    pIdContribuicao,
                                    pIdPlanoPrev,
                                    pIdPessJur : Integer;
                                    trataDivergencia : Boolean);
var
    qryTemp : TWWQuery;
    nomeContaCredito,
    nomeContaCredito13,
    nomeContaDebito,
    nomeContaDebito13 : String;
begin
        pContaCInad := '';
        pContaDInad := '';
        qryTemp := TWWQuery.Create(Nil);

        if pReverteProvisao then
        begin
            nomeContaCredito := 'PLACONTACREVERSAO';
            nomeContaDebito  := 'PLACONTAPROVPERDA';
        end else
        begin
            nomeContaCredito := 'PLACONTAPROVPERDA';
            nomeContaDebito  := 'PLACONTADREVERSAO';
        end;

        if trataDivergencia then nomeContaCredito := 'PLACONTATRATDIVER';
        nomeContaCredito13 := nomeContaCredito + '13';
        nomeContaDebito13  := nomeContaDebito  + '13';

        try
            qryTemp.DatabaseName := dtmBaseDados.dbBaseDados.DataBaseName;

            qryTemp.SQL.Text := ' SELECT ' + nomeContaCredito + ', ' + nomeContaCredito13 + ', ' +
                                '        ' + nomeContaDebito + ', ' + nomeContaDebito13 + ' ' +#13+
                                ' FROM CONTPLANPATRO' +
                                ' WHERE IDPESSJUR = ' + IntToStr(pIdPessJur) +#13+
                                '   AND IDPLANOPREV = ' + IntToStr(pIdPlanoPrev) +#13+
                                '   AND IDCONTRIBUICAO = ' + IntToStr(pIdContribuicao);

            qryTemp.Open;
            if Not qryTemp.IsEmpty then
            begin
                  if copy(pMesReferencia, 6, 2) <> '13' then
                  begin
                        pContaCInad := qryTemp.FieldByName(nomeContaCredito).AsString;
                        pContaDInad := qryTemp.FieldByName(nomeContaDebito).AsString;
                  end else
                  begin
                        pContaCInad := qryTemp.FieldByName(nomeContaCredito13).AsString;
                        pContaDInad := qryTemp.FieldByName(nomeContaDebito13).AsString;
                  end;
            end;

        except
           qryTemp.Close;
           FreeAndNil(qryTemp);
           raise;
        end;

        qryTemp.Close;
        FreeAndNil(qryTemp);
end;


