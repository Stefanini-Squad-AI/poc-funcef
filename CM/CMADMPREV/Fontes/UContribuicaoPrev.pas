         0, // Numlancto
         dValorDocumento, // Vlrliquido
         0, // ValorOM
         dValorDocumento, // Valor
         prmUnidNegoc, // Unidnegoc
         iPlnCodigo, // liPlncodigo
         -1, // Numlotemanual
         Sistema.IdUsuario, // Idusuarioinclusao
         Sistema.IdEmpresa, // Idpessoa
         -1, // Idnflivro,
         -1, // Estorno
         -1, // Codtipdoc
         -1, // Coddocinss
         iCodAlterador, // Codalterador
         '4', // Operacao
         '', // NumRecibo
         '', // Numnf
         '', // Numfatura
         'Baixa de Documento não Pago - Tratamento Divergência AdmPREV', // HistoricoCompl
         '', // Flgtipofatura
         'N', // Flgrecebeunf
         '', // Flgfatemitida
         sDebCre, // Debcre
         Sistema.IdModulo, // IdModulo
         IntegraBack.Plano, // PlanoConta
         True, // UsaPlanoPatro
         True, // Contabiliza    //BRUNO AZEVEDO SOL 136737 KINTANA 972753
         -1, // iCodPortForma
         0, // DiasFloat
         '', // ContaBaixa
         0 // SubContaBaixa
