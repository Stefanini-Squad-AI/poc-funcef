      ' AND    PL.IDPLANOPREV = HST.IDPLANOPREV                                      ' +
      ' AND    D.CODDOCUMENTO = HST.CODDOCUMENTOPREV                                 ' +
      ' AND    P.CODPORTFORMA = D.CODPORTFORMA                                       ' +
      ' AND    NVL(P.FLGATIVO, ''S'') = ''S''                                        ' +
      ' AND    FUND.IDPESSOA  = ' + IntToStr(iIdFundacao) +
      sFiltro + // Peterson Victor SIG 25787
