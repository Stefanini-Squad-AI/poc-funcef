   FazerInsertContab(qryContabil,
               qryAux.FieldByName('PLACONTA').AsString,
               qryAux.FieldByName('CODCENTROCUSTO').AsString,
               'D',
               '2',
               IntToStr(QryDocPGA.FieldByname('CODDOCUMENTOPGA').asInteger),
