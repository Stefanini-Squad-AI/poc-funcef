                              sMensagensVerso[5],
                              sMensagensVerso[6],
                              sMensagensVerso[7],
                              sMensagensVerso[8],
                              sMensagensVerso[9],
                              sMensagensVerso[10],
                              sMensagensVerso[11],
                              sMensagensVerso[12],
                              sMensagensVerso[13],
                              sMensagensVerso[14],
                              sMensagensVerso[15],
                              sMensagensVerso[16],
                              sMensagensVerso[17],
                              sMensagensVerso[18],
                              sMensagensVerso[19],
                              sMensagensVerso[20])
                              Then Begin
                                 Result := False;
                                 Exit;
                              End;
                        End;

                  End; // else-if not bFlgMensagemVerso


               For X := 0 To iNumCampos Do
                  lValoresGrupo[x] := Qry.FieldByName(sCamposParaGrupo[X]).AsString;

               Qry.Next;
            End;
            // Inicio SIG 127545 Ferrari
            // Reagrupar mensagens do boleto
            if Not bFlgMensagemVerso then
              begin
                sMsgAgrup := StringReplace(sMsgAgrup, 'Contribuição', 'Contrib.', [rfReplaceAll]);
                sMensagens[3] := ''; sMensagens[4] := '';
                sMensagens[5] := ''; sMensagens[6] := '';
                sMensagens[7] := ''; sMensagens[8] := '';
                sMensagens[9] := ''; sMensagens[10] := '';
                iPos := 1;
                inc(iProxLinha);
                For iContLinhas := iProxLinha To 10 Do
                   Begin
                      sLinha := Copy(sMsgAgrup, iPos, 69);
                      iPos := iPos + 69;
                      // Se estiver na ultima linha e nao der para mostrar a mensagem
                      // inteira, acrescentar na linha a soma do resto
                      If (iContLinhas = 10) And (iPos < Length(Trim(sMsgAgrup)))
                         Then sLinha := Copy(sLinha, 1, 60) + '[+Outros]';
                      sMensagens[iContLinhas] := sLinha;
                   End;
                iSeqGrupo := LeultRegistro(Nil, 'GRUPOCNAB');
                qryAux.Close;
                qryAux.SQL.Clear;
                qryAux.SQL.Add(' UPDATE DOCUMENTO SET CODGRUPOCNAB = ' + IntToStr(iSeqGrupo));
                qryAux.SQL.Add(' WHERE CODDOCUMENTO = ' + Qry.FieldByName('CODDOCUMENTO').AsString);
                Try
                   qryAux.ExecSQL;
                Except
                   Exit;
                End;
                If Not CtrlDocumento.IntBanco.SetaMensagensCNAB(-1,
                   iSeqGrupo,
                   sMensagens,
                   true)

                Then Begin
                      Result := False;
                      Exit;
                   End;
                // Fim
              end;
         Result := True;
      End;

   lValoresGrupo.Free;
   Qry.Close;
End;

