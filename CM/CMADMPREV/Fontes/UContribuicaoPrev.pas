   sSQL2 := ' SELECT HST.MESREFERENCIA,    HST.NUMRECEBIMENTO,     HST.MESCOBRANCA,        ' + #13 +
      '         HST.IDMOTIVO,         HST.VALORESPERADO,      HST.IDREGRAALIMRESER,   ' + #13 +
