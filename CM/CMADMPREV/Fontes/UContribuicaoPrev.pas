function fct_InsertLista(sLista : String):Boolean;
var sNumRec, sBloco : string;
    iPos,icont : Integer;
begin

  if Trim(sLista) <> '' then
  begin

     icont := 0;
     sBloco := '';

     while pos(',' , sLista) > 0 do
     begin

        iPos := pos(',' , sLista);

        sNumRec := Copy(sLista,1,iPos - 1);

        //edilaine SIG129287 : inicio
        //sBloco := sBloco + ' INSERT INTO EXTRATOINSTREL (IDPESSOA,IDPLANO) ' +
        //                   ' VALUES( ' + sNumRec + ', ' + IntToStr(iIdFundacao) + ' ); ' + #13;

        sBloco := sBloco + iff(sBloco = '', '', ' union ') + ' SELECT '+sNumRec+' AS IDPESSOA, '+IntToStr(iIdFundacao)+ ' AS IDPLANO FROM DUAL ';
        //edilaine SIG129287 : fim

        sNumRec := sNumRec + ',';
        sLista := StringReplace(sLista, sNumRec, '', []);

        icont := icont + 1;

        if icont = 200 then
        begin

           if Trim(sBloco) <> '' then
           begin
              qryAux.Close;
              qryAux.SQL.Clear;
              //edilaine SIG129287 : inicio
              //qryAux.SQL.Add('begin  ' + #13 + sBloco +  #13 + 'End ;');
              //qryAux.SQL.Add('INSERT INTO EXTRATOINSTREL (IDPESSOA,IDPLANO) SELECT D.* FROM ('+sBloco+') D' );
              qryAux.SQL.Add('INSERT INTO EXTRATOINSTREL (IDPESSOA,IDPLANO) '+sBloco );
              //edilaine SIG129287 : fim

              Try
                 qryAux.ExecSQL;

              Except
                 Exit;
              End;
           end;

           icont := 0;
           sBloco := '';
        end;
     end;

     if Trim(sLista) <> '' then
     begin
        //edilaine SIG129287 : inicio
        //sBloco := sBloco + ' INSERT INTO EXTRATOINSTREL (IDPESSOA,IDPLANO) ' +
         //                  ' VALUES( ' + sLista + ', ' + IntToStr(iIdFundacao) + ' ); ' + #13;

        sBloco := sBloco + iff(sBloco = '', '', ' union ') + ' SELECT '+sLista+' AS IDPESSOA, '+IntToStr(iIdFundacao)+ ' AS IDPLANO FROM DUAL';
        //edilaine SIG129287 : fim
     end;

     if Trim(sBloco) <> '' then
     begin
        qryAux.Close;
        qryAux.SQL.Clear;
        //edilaine SIG129287 : inicio
        //qryAux.SQL.Add('begin  ' + #13 + sBloco +  #13 + 'End ;');
        //sBloco := 'INSERT INTO EXTRATOINSTREL (IDPESSOA,IDPLANO) SELECT D.* FROM ('+sBloco+') D' ;
        sBloco := 'INSERT INTO EXTRATOINSTREL (IDPESSOA,IDPLANO) '+sBloco ;
        qryAux.SQL.Add( sBloco );
        //edilaine SIG129287 : fim

        Try
           qryAux.ExecSQL;

        Except
           Exit;
        End;
     end;
  end;
end;





