  object qryValida: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT AC.IDCONTRIBACJUDDEFICIT,'
      '       AC.IDNUCLEOFAMILIAR,'
      '       AC.IDCONTRIBUICAO,'
      '       AC.FLGPREPARO,'
      '       AC.PERCACJUDDEFICIT,'
      
        '       TO_DATE(AC.ANOMESINIACJUDDEFICIT, '#39'YYYY/MM'#39')  as DATAINIC' +
        'IO,'
      
        '       TO_DATE(AC.ANOMESFIMACJUDDEFICIT, '#39'YYYY/MM'#39')  as DATAFINA' +
        'L,'
      '       AC.ANOMESINIACJUDDEFICIT,'
      '       AC.ANOMESFIMACJUDDEFICIT,'
      '       AC.IDMOTIVOACJUDDEFICIT,'
      '       AC.OBSACJUDDEFICIT'
      'FROM   CONTRIBNUCLEOACJUDDEFICIT AC'
      'WHERE  AC.IDNUCLEOFAMILIAR = :IDNUCLEO'
      'AND    AC.IDCONTRIBUICAO   = :IDCONTRIB'
      
        'AND    ((AC.IDCONTRIBACJUDDEFICIT = :IDACAOJUD) or (:IDACAOJUD =' +
        ' 1))'
      '')
    UpdateObject = updValida
    ValidateWithMask = True
    Left = 480
    Top = 119
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDNUCLEO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDCONTRIB'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDACAOJUD'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDACAOJUD'
        ParamType = ptUnknown
      end>
  end
  object qryMotivo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDMOTIVO, DESCRICAO'
      'FROM   MOTIVO'
      'WHERE  FLGTIPO = '#39'P'#39' '
      'ORDER BY DESCRICAO')
    ValidateWithMask = True
    Left = 529
    Top = 204
  end
