  inherited qry: TwwQuery
    BeforePost = qryBeforePost
    SQL.Strings = (
      ''
      'SELECT AC.IDCONTRIBACJUDDEFICIT,'
      '       AC.IDNUCLEOFAMILIAR,'
      '       AC.IDCONTRIBUICAO,'
      '       DECODE (AC.FLGPREPARO, 0,'#39'Prepara e Não Envia'#39','
      '                              1,'#39'Não Prepara'#39','
      '                              2,'#39'Prepara e Envia'#39') AS TIPOACAO,'
      '       AC.FLGPREPARO,'
      '       AC.PERCACJUDDEFICIT,'
      
        '       TO_DATE(AC.ANOMESINIACJUDDEFICIT, '#39'YYYY/MM'#39')  as DATAINIC' +
        'IO,'
      
        '       LAST_DAY(TO_DATE(AC.ANOMESFIMACJUDDEFICIT, '#39'YYYY/MM'#39'))  a' +
        's DATAFINAL,'
      '       AC.ANOMESINIACJUDDEFICIT,'
      '       AC.ANOMESFIMACJUDDEFICIT,'
      '       M.DESCRICAO, '
      '       AC.IDMOTIVOACJUDDEFICIT,'
      '       SUBSTR(AC.OBSACJUDDEFICIT, 1, 100) OBSACJUDDEFICIT'
      'FROM   CONTRIBNUCLEOACJUDDEFICIT AC'
      'JOIN   MOTIVO M ON M.IDMOTIVO = AC.IDMOTIVOACJUDDEFICIT'
      'WHERE  AC.IDNUCLEOFAMILIAR = :IDNUCLEO'
      'AND    AC.IDCONTRIBUICAO   = :IDCONTRIB'
      'ORDER BY AC.ANOMESINIACJUDDEFICIT DESC'
      ''
      ' '
      ' ')
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDNUCLEO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDCONTRIB'
        ParamType = ptUnknown
      end>
  end
  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'UPDATE CONTRIBNUCLEOACJUDDEFICIT SET'
      '  FLGPREPARO = :FLGPREPARO,'
      '  PERCACJUDDEFICIT = :PERCACJUDDEFICIT,'
      '  ANOMESINIACJUDDEFICIT = :ANOMESINIACJUDDEFICIT,'
      '  ANOMESFIMACJUDDEFICIT = :ANOMESFIMACJUDDEFICIT,'
      '  IDMOTIVOACJUDDEFICIT = :IDMOTIVOACJUDDEFICIT,'
      '  OBSACJUDDEFICIT = :OBSACJUDDEFICIT'
      'WHERE  IDCONTRIBACJUDDEFICIT = :OLD_IDCONTRIBACJUDDEFICIT'
      '')
    InsertSQL.Strings = (
      'INSERT INTO CONTRIBNUCLEOACJUDDEFICIT'
      '( IDCONTRIBACJUDDEFICIT,'
      '  IDNUCLEOFAMILIAR,'
      '  IDCONTRIBUICAO,'
      '  FLGPREPARO,'
      '  PERCACJUDDEFICIT,'
      '  ANOMESINIACJUDDEFICIT,'
      '  ANOMESFIMACJUDDEFICIT,'
      '  IDMOTIVOACJUDDEFICIT,'
      '  OBSACJUDDEFICIT'
      ')'
      'VALUES'
      '( :IDCONTRIBACJUDDEFICIT,'
      '  :IDNUCLEOFAMILIAR,'
      '  :IDCONTRIBUICAO,'
      '  :FLGPREPARO,'
      '  :PERCACJUDDEFICIT,'
      '  :ANOMESINIACJUDDEFICIT,'
      '  :ANOMESFIMACJUDDEFICIT,'
      '  :IDMOTIVOACJUDDEFICIT,'
      '  :OBSACJUDDEFICIT'
      ')'
      '')
    DeleteSQL.Strings = (
      'DELETE FROM CONTRIBNUCLEOACJUDDEFICIT'
      'WHERE IDCONTRIBACJUDDEFICIT = :OLD_IDCONTRIBACJUDDEFICIT'
      ''
      '')
  end
