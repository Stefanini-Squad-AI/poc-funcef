  object qryExporta: TwwQuery
    DatabaseName = 'BaseDados'
    ValidateWithMask = True
    Left = 457
    Top = 359
  end
  object Cds: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 262
    Top = 379
  end
  object Sql: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '     LC.CODDOCUMENTO,'
      '     PP.CODALTERADORBAIXA AS CODALTERADOR,'
      '     LC.ESTORNO,'
      '     LC.PLNCODIGO,'
      '     LC.NUMLANCTO,'
      '     A.DESCRICAO,'
      '     LC.DATALANCTO,'
      '     LC.VALOROUTRAMOEDA,'
      '     TT.VALOR,'
      '     LC.HISTORICOCOMPL,'
      '     LC.DEBCRE,'
      
        '     RTRIM(TO_CHAR(D.NODOCUMENTO)) || '#39' '#39' || D.COMPLDOCUMENTO AS' +
        ' DOCCOMPL,'
      '     D.DATAPROGRAMADA,'
      '     nvl( D.DATADISPONIB, D.DATAPROGRAMADA ) as DATADOC,'
      '     P.RAZAOSOCIAL,'
      '     D.MOECODIGO,'
      '     D.PLACONTA,'
      '     D.CODCENTROCUSTO,'
      '     D.CODSUBCONTA,'
      '     D.IDMODULO,'
      '     LC.VLRLIQUIDO,'
      '     LC.UNIDNEGOC,'
      '     LC.IDPESSOA,'
      '     C.CODEXTERNO,'
      '     LC.IDDESPESAORC,'
      '     A.FLGOBRIGARESERVA,'
      '     A.ACRESDECRES,'
      '     LC.IDRATEIODOCUM,'
      '     D.IDFORCLI,'
      '     0 AS IDALTXCCXPRGXCONTA,'
      '     0 AS IDRATEIO_ORCAMENTO,'
      '     0 aS TipoDespesa,'
      '     '#39'          '#39' CentroCusto'
      '    , LC.VALORBASERETENCAO'
      '    , LC.IDTIPOSERVICO'
      '    , LC.IDPROCESSO'
      '    , A.FLGLANCANFS'
      '    ,A.FLGVALORBASE , LC.IDENVIODOCUMENTO'
      'FROM'
      '     LANCTODOCUM LC,'
      '     TIPOALTERADOR A,'
      '     DOCUMENTO D,'
      '     PESSOA P,'
      '     CENTCUST C,'
      '     PLANPREV PP, --aqui'
      
        '     (SELECT LA.CODDOCUMENTO, SUM(DECODE(LA.DEBCRE, '#39'D'#39', valor, ' +
        #39'C'#39', -VALOR)) AS VALOR'
      '       FROM LANCTODOCUM LA'
      '       WHERE LA.CODDOCUMENTO = :CODDOCUMENTO'
      '       -- GROUP BY LA.CODDOCUMENTO) as TT --WO28156 Leandro'
      '       GROUP BY LA.CODDOCUMENTO)  TT -- WO28156 Leandro'
      'WHERE'
      '     (D.CODDOCUMENTO = :CODDOCUMENTO) AND'
      '     (LC.NUMLANCTO = :NUMLANCTO) AND'
      '     (D.IDPESSOA = :IDPESSOA) AND'
      '     (D.RECPAG = :RECPAG) AND'
      '     (PP.IDPLANOPREV = :IDPLANOPREV) AND'
      '     (PP.CODALTERADORBAIXA = A.CODALTERADOR) AND'
      '     (D.CODDOCUMENTO = TT.CODDOCUMENTO) AND'
      '     (D.CODDOCUMENTO = LC.CODDOCUMENTO) AND'
      '     (D.IDFORCLI = P.IDPESSOA) AND'
      '     (C.CODCENTROCUSTO(+) = D.CODCENTROCUSTO)'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ClientDataSet = Cds
    Left = 302
    Top = 363
  end
