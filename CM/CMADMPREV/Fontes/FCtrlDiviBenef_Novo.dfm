  object qryPlanilha: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DP.MATRICULA, '
      '       CD.IDCONTROLEDIVIDABENEFICIO AS CODDIVIDA,'
      '       CD.SALDOPROVPERDA  AS VALOR'
      '  FROM CONTROLEDIVIDABENEFICIO CD'
      '  JOIN DEPENTIT  DP'
      '    ON DP.IDPESSOA = CD.IDPESSOA'
      ' WHERE CD.FLGSTATUS <> 3  '
      '   AND DP.MATRICULA IS NOT NULL '
      ' ORDER BY 1')
    ValidateWithMask = True
    Left = 125
    Top = 443
  end
