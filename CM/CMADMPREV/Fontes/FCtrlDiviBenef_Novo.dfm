  object qryBoleto: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   R.NAME,'
      '   R.IDREPORTS,'
      '   R.ORIGEMCM,'
      '   R.TEMPLATE'
      'FROM'
      '  REPORTS R'
      'JOIN'
      '  CONFIGBARRAS C ON C.IDREPORTS = R.IDREPORTS'
      '                AND NVL(C.ORIGEMCM,0) = R.ORIGEMCM'
      'WHERE'
      '  C.IDCONFIGBARRAS = :iIdConfigBarra'
      ' ')
    ValidateWithMask = True
    Left = 909
    Top = 207
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'iIdConfigBarra'
        ParamType = ptUnknown
      end>
  end
