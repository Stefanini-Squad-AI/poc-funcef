  object qryRegionais: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT EL.IDESTAB, P2.NOME AS REGIONAL, EL.IDPESSJUR'
      'FROM   PESSOA P2,  ELEGPATRO EL, PATRO PT'
      'WHERE (P2.IDPESSOA = EL.IDESTAB)'
      'AND   PT.IDPESSOA = EL.IDPESSJUR'
      'AND   PT.IDFUNDACAO = :IDFUNDACAO'
      'ORDER BY 2'
      ' ')
    ValidateWithMask = True
    Left = 424
    Top = 194
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDFUNDACAO'
        ParamType = ptUnknown
      end>
  end
  object qryPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDRUBSALPARTICIP, IDRUBSALMANUT, IDRUBSALMANUTPARC'
      'FROM PATRO'
      'WHERE IDPESSOA = :IDPESSJUR')
    ValidateWithMask = True
    Left = 458
    Top = 194
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end>
  end
