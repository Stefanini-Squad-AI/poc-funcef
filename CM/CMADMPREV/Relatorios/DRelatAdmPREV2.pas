function TdtmRelatAdmPrev2.MostraParam(Form: string): boolean;
var frm : TForm;
begin
   if (UPPERCASE(Form) = 'FRMPARAMRELRESUMOFUNC')            // Consulta ao Resumo Funcional
   then frm := TfrmParamRelResumoFunc.Create(Application)
   else if (UPPERCASE(Form) = 'FRMPRELHISTCONTRIBANALIT')    // Historico Mensal de Contribuicoes - Analitico
   then frm := TfrmPRelHistContribAnalit.Create(Application)
   else if (UPPERCASE(Form) = 'FRMPARAMRELCERT')             // Certificado de Inscrição
   then frm := TfrmParamRelCert.Create(Application)
   else if (UPPERCASE(Form) = 'FRMPARAMRELOCOR')             // Relatorio de Alteracoes de Situacao de Beneficios (Ocorrencias)
   then frm := TfrmParamRelOcor.Create(Application)
   else if (UPPERCASE(Form) = 'FRMPARAMRELPARTICIPSITUACAO')
   then frm := TFrmParamRelParticipSituacao.Create(Application)
   else if (UPPERCASE(Form) = 'FRMPRELEVGERXPARTICIP')
   then frm := TfrmPRelEvGerXParticip.Create(Application)
   else if (UPPERCASE(Form) = 'FRMPRELQUADROSALARIOS')
   then frm := TfrmPRelQuadroSalarios.Create(Application)
   else if (UPPERCASE(Form) = 'FRMPRELTOTEVENTOS')
   then frm := TfrmPRelTotEventos.Create(Application)
   else if (UPPERCASE(Form) = 'FRMESTATISTICOBENEFICIO')
   then frm := TfrmEstatisticoBeneficio.Create(Application)
   else if (UPPERCASE(Form) = 'FRMPARAMCONTRIBPLANO')        //William Santana - SIG 26803
   then frm := TfrmParamContribPlano.Create(Application)     //William Santana - SIG 26803
   else frm := nil;

   if frm = nil
   then Result := false
   else begin
      with frm do
      begin
         Result := (ShowModal = mrOk);
         Free;
      end;
   end;
end; // MostraParam

