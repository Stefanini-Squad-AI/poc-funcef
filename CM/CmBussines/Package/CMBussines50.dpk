package CmBussines50;

{$R *.RES}
{$R CMBUSSINES50_RES.RES}

{$R '..\Source\CMPendencia.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Componentes de Negócio'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  Vclx50,
  Vcldb50,
  Vclbde50,
  CMAdd50,
  ip50_d5,
  Indy50,
  Vclmid50,
  CmCompo50;

contains
  CMPendencia in '..\Source\CMPendencia.pas',
  CMBussinesObject in '..\Source\CMBussinesObject.pas',
  RegCmBussines50 in '..\Source\RegCmBussines50.pas';

end.
