package CmRegra50MT;

{$R *.RES}
{$R CMREGRA50MT_RES.RES}

{$R 'CmRegra50MT.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Componentes de Regra MT'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CmCompo50,
  dclocx50;

contains
  uTiposRegraMT in '..\Source\uTiposRegraMT.pas',
  UCalcIrrfMT in '..\Source\uCalcIrrfMT.pas',
  uFormulasMT in '..\Source\uFormulasMT.pas',
  uCtrlRegra in '..\Source\uCtrlRegra.pas',
  FInputVarMT in '..\Source\FInputVarMT.pas' {FrmInputVarMT},
  FPassoaPassoMT in '..\Source\FPassoaPassoMT.pas' {FrmPassoAPassoMT},
  FMostraPassosMT in '..\Source\FMostraPassosMT.pas' {FrmMostraPassosMT},
  uRegraMT in '..\Source\uRegraMT.pas',
  uFuncoesRegraMT in '..\Source\uFuncoesRegraMT.pas',
  UDiasUteisInvestMT in '..\Source\UDiasUteisInvestMT.pas',
  uFormulasAtuariaisMT in '..\Source\uFormulasAtuariaisMT.pas';

end.
