  object LstDlgPath: TCMListDialog
    ListDialogType = ldtPathList
    Caption = 'Diretório de Fontes'
    Text = 'Lista de Diretórios Selecionados'
    ItemSeparator = ';'
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -11
    Font.Name = 'MS Sans Serif'
    Font.Style = [fsBold]
    AllowEmptyList = False
    MessageForEmptyList = 'É obrigatório a indicação do Dietório dos Fontes'
    FileFilter = 'Todos os Arquivos|*.*'
    Left = 137
    Top = 4
  end
  object QryBpl: TwwQuery
    DatabaseName = 'BaseSad'
    SQL.Strings = (
      'SELECT '
      '   LOWER(NOMEPROJETO) AS BPL'
      'FROM '
      '   MODULO '
      'WHERE '
      '   DPL = 1 '
      
        '   AND IDMODULO NOT IN (322, 319, 67, 302, 369, 324, 330, 339, 1' +
        '41, 104)'
      'ORDER BY '
      '   NOMEPROJETO   ')
    ValidateWithMask = True
    Left = 105
    Top = 4
  end
end
