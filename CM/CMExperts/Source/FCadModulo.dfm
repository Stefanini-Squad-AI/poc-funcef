  object upd: TUpdateSQL
    ModifySQL.Strings = (
      'update MODULO'
      'set'
      '  IDMODULO = :IDMODULO,'
      '  NOMEMODULO = :NOMEMODULO,'
      '  NOMEPROJETO = :NOMEPROJETO,'
      '  DIRFONTES = :DIRFONTES,'
      '  PATHFONTES = :PATHFONTES,'
      '  DPL = :DPL,'
      '  USADPL = :USADPL,'
      '  FLGGRUPODESENV = :FLGGRUPODESENV,'
      '  USURESPONSAVEL = :USURESPONSAVEL,'
      '  EMAIL = :EMAIL,'
      '  GERENTEPROJETO = :GERENTEPROJETO,'
      '  EMAILGERENTE = :EMAILGERENTE,'
      '  DPLFRONT = :DPLFRONT,'
      '  LISTABPL = :LISTABPL'
      'where'
      '  IDMODULO = :OLD_IDMODULO')
    InsertSQL.Strings = (
      'insert into MODULO'
      
        '  (IDMODULO, NOMEMODULO, NOMEPROJETO, DIRFONTES, PATHFONTES, DPL' +
        ', USADPL, '
      
        '   FLGGRUPODESENV, USURESPONSAVEL, EMAIL, GERENTEPROJETO, EMAILG' +
        'ERENTE, '
      '   DPLFRONT, LISTABPL)'
      'values'
      
        '  (:IDMODULO, :NOMEMODULO, :NOMEPROJETO, :DIRFONTES, :PATHFONTES' +
        ', :DPL, '
      
        '   :USADPL, :FLGGRUPODESENV, :USURESPONSAVEL, :EMAIL, :GERENTEPR' +
        'OJETO, '
      '   :EMAILGERENTE, :DPLFRONT, :LISTABPL)')
    DeleteSQL.Strings = (
      'delete from MODULO'
      'where'
      '  IDMODULO = :OLD_IDMODULO')
    Left = 245
    Top = 3
  end
