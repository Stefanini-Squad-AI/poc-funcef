  object QryColunas: TQuery
    CachedUpdates = True
    DatabaseName = 'BussinesObject'
    SQL.Strings = (
      'SELECT'
      '  COLUMN_NAME,'
      '  DATA_TYPE,'
      '  DATA_LENGTH,'
      '  DECODE(NULLABLE,'#39'Y'#39','#39'N'#39','#39'Y'#39') AS NULLABLE,'
      '  '#39'N'#39' AS KEY,'
      '  '#39'Y'#39' AS OK,'
      '  '#39'Y'#39' AS NULLIFZERO,'
      '  '#39'N'#39' AS READONLY,'
      '  COLUMN_NAME AS SEQUENCENAME,'
      '  COLUMN_NAME AS DISPLAYLABEL'
      'FROM'
      '  ALL_TAB_COLUMNS'
      'WHERE'
      '  TABLE_NAME = :TABLE_NAME'
      'ORDER BY'
      '  COLUMN_NAME'
      ' ')
    UpdateObject = UpdColunas
    Left = 382
    Top = 128
    ParamData = <
      item
        DataType = ftString
        Name = 'TABLE_NAME'
        ParamType = ptUnknown
      end>
