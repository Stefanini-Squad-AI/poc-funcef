  object QrySelPrimary: TQuery
    DatabaseName = 'BussinesObject'
    SQL.Strings = (
      'SELECT '
      '  SUBSTR(CC.COLUMN_NAME,1,25) AS COLUMN_NAME'
      'FROM '
      '  ALL_CONS_COLUMNS CC, ALL_CONSTRAINTS C '
      'WHERE'
      '  C.CONSTRAINT_TYPE = '#39'P'#39' AND'
      '  C.TABLE_NAME = :TABLE_NAME AND'
      '  CC.CONSTRAINT_NAME = C.CONSTRAINT_NAME AND'
      '  CC.OWNER = C.OWNER')
    Left = 426
    Top = 128
    ParamData = <
      item
        DataType = ftString
        Name = 'TABLE_NAME'
        ParamType = ptUnknown
      end>
  end
