package CMExperts;

{$R *.RES}
{$R CMEXPERTS_RES.RES}

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - CM Experts'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  Vclx50,
  FirstClass2000_vcl5,
  CmCompo50,
  CmBussines50,
  CMResource50,
  CMPrincipal50;

contains
  CMConversor in '..\Source\CMConversor.pas',
  CMExpert in '..\Source\CMExpert.pas',
  SADExperts in '..\Source\SADExperts.pas',
  fConversorWiz in '..\Source\fConversorWiz.pas' {frmConversorWiz},
  DelphiParsers in '..\Source\DelphiParsers.pas',
  PascalParser in '..\Source\PascalParser.pas',
  CMXptAbout in '..\Source\CMXptAbout.pas' {frmCMEntrada},
  CMAppWizard in '..\Source\CMAppWizard.pas',
  fCMAppWiz in '..\Source\fCMAppWiz.pas' {frmCMAppWiz},
  CMFormWizards in '..\Source\CMFormWizards.pas',
  CMOTAFile in '..\Source\CMOTAFile.pas',
  CMModuleCreator in '..\Source\CMModuleCreator.pas',
  fLiberaVersao in '..\Source\fLiberaVersao.pas' {frmLiberaVersao},
  dSAD in '..\Source\dSAD.pas' {dmSAD: TDataModule},
  PSCHideComps in '..\Source\PSCHideComps.pas',
  CMAppWizExpert in '..\Source\CMAppWizExpert.pas',
  CMDialogExpert in '..\Source\CMDialogExpert.pas',
  CMReleaseVers in '..\Source\CMReleaseVers.pas',
  CMRepositoryExpert in '..\Source\CMRepositoryExpert.pas',
  CMAppWizConsts in '..\Source\CMAppWizConsts.pas',
  fAchaTroca in '..\Source\fAchaTroca.pas' {frmAchaTroca},
  fEscolheArquivos in '..\Source\fEscolheArquivos.pas' {frmEscolheArquivos},
  FCadModulo in '..\Source\FCadModulo.pas' {FrmCadModulo},
  FResourceCM in '..\Source\FResourceCM.pas' {frmResourceCM},
  uSad in '..\Source\uSad.pas',
  fScripAutoriza in '..\Source\fScripAutoriza.pas' {frmScriptAutoriza},
  fSelecionaDir in '..\Source\fSelecionaDir.pas' {FrmSelecionaDir},
  fObjExpert in '..\Source\fObjExpert.pas' {FrmObjExpert},
  FSADExpert in '..\Source\FSADExpert.pas' {FrmSADExpert},
  FLocalizaUnitPacote in '..\Source\FLocalizaUnitPacote.pas' {frmLocalizaUnitPacote};

end.

