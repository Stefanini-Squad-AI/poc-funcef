package CMTotalPrev50;

{$R *.RES}
{$R CMTOTALPREV50_RES.RES}

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Componentes e Forms da Solução TotalPrev'}
{$IMPLICITBUILD OFF}

requires
  Vcl50,
  TB97_d5,
  ip50d_d5,
  CmBack50,
  CMRegra50,
  CmRelatsOld50,
  CMFBCOMUM50;

contains
  UConsPart in '..\source\UConsPart.pas',
  uFiario in '..\source\uFiario.pas',
  FConsPessoaGeral in '..\source\FConsPessoaGeral.pas' {frmConsPessoaGeral},
  FTitulares in '..\source\FTitulares.pas' {FrmTitulares},
  uRegTotalPrev in '..\source\uRegTotalPrev.pas',
  uCtrlTempoServico in '..\Source\uCtrlTempoServico.pas',
  dConsPart in '..\Source\dConsPart.pas' {dtmConsPart: TDataModule},
  fconspart in '..\Source\fconspart.pas' {FRMconspart},
  dRelTempoServicoMT in '..\Source\dRelTempoServicoMT.pas' {dtmRelTempoServicoMT},
  FPRelHisFuncionalMT in '..\Source\FPRelHisFuncionalMT.pas' {frmPRelHisFuncionalMT},
  dConsPart1 in '..\Source\dConsPart1.pas' {DtmconsPart1: TDataModule},
  FConsEnderGeral in '..\Source\FConsEnderGeral.pas' {frmConsEnderGeral},
  FHistMolestia in '..\Source\FHistMolestia.pas' {FrmHistMolestia},
  FHistIR in '..\Source\FHistIR.pas' {FrmHistIR};

end.
