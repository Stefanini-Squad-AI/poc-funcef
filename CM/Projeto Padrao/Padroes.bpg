#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = CMProject.exe CmBussines50.bpl CmCompo50.bpl CmForms50.bpl \
  CMRegra50.bpl CMAdd50.bpl DJCL50.bpl CMExperts.bpl CMTotalPrev50.bpl \
  CMOld50.bpl CmBack50.bpl GlobalCM.exe CmParser50.bpl CmRelatsOld50.bpl \
  TSDG5201.bpl TSG5201.bpl TSGDCLD5.bpl TSGEDCLD5.bpl ProjectBuilder.exe \
  Halcyon6D5.bpl CentSvr.bpl webcm.exe SAD.exe TB97_d5.bpl mailto.exe CmSql50.bpl \
  Report.exe ip50_d5.bpl VCLBDE50.bpl Mensageiro.exe CMPadroesSrvr50.dll \
  CMGuardian.exe
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------


CMProject.exe: ..\..\ProjetoCM\Fontes\CMProject.dpr
  $(DCC)

CmBussines50.bpl: ..\CMBussines\Package\CMBussines50.dpk
