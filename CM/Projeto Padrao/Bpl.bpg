#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = CMCompo50.bpl CMForms50.bpl CMBussines50.bpl CmRelatsOld50.bpl \
  CMExperts.bpl CmBack50.bpl CMIntBanco50.bpl CmGlobalObj50.bpl CMContabObj50.bpl \
  CMCfinanObj50.bpl CMCapCarObj50.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

CMCompo50.bpl: ..\ComponentesCM\Package\CMCompo50.dpk
  $(DCC)

CMForms50.bpl: ..\Forms\Package\CMForms50.dpk
  $(DCC)

CMBussines50.bpl: ..\CmBussines\Package\CMBussines50.dpk
  $(DCC)

CMExperts.bpl: ..\CMExperts\Package\CMExperts.dpk
  $(DCC)

CmRelatsOld50.bpl: ..\Relats\Package\CmRelatsOld50.dpk
  $(DCC)

CmBack50.bpl: ..\..\CmBack\Package\CmBack50.dpk
  $(DCC)

CMIntBanco50.bpl: ..\..\CobrancaEletronica\Package\CMIntBanco50.dpk
  $(DCC)

CmGlobalObj50.bpl: ..\..\CMGlobalObj50\Package\CmGlobalObj50.dpk
  $(DCC)

CMContabObj50.bpl: ..\..\CMContabObj50\Package\CMContabObj50.dpk
  $(DCC)

CMCfinanObj50.bpl: ..\..\CMCfinanObj50\Package\CMCfinanObj50.dpk
  $(DCC)

CMCapCarObj50.bpl: ..\..\CMCapCarObj50\Package\CMCapCarObj50.dpk
  $(DCC)


