    SQL.Strings = (
      'SELECT'
      '   AUTORIZA.IDESPACESSO,'
      '   AUTORIZA.IDOPERFUNC,'
      '   AUTORIZA.IDPESSOA,'
      '   OPERFUNC.IDOPERACAO,'
      '   OPERFUNC.IDFUNCAO'
      'FROM'
      '   AUTORIZA, OPERFUNC'
      'WHERE'
      '   (OPERFUNC.IDMODULO = :IdModulo) AND'
      '   (AUTORIZA.IDOPERFUNC = OPERFUNC.IDOPERFUNC)  AND'
      '   (AUTORIZA.IDESPACESSO = :IdEspAcesso) AND'
      '   (AUTORIZA.IDPESSOA = :IdPessoa)'
      '')
    ClientDataSet = CdsAutorizaAtu
    Left = 141
    Top = 126
  end
  object SQLGrupoXCargoXFuncaoXCCusto: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   g.IDGRUPO,'
      '   g.NOMEGRUPO,'
      '   g.DESCRICAO,'
      '   g.IDESPACESSO,'
      '   g.NOMEGRUPO AS DESCRICAO2'
      'FROM'
      '   FUNCIONARIO    f,'
      '   GRUPOACESSO    g,'
      '   CARGOXGRUPOXCC c'
      'WHERE'
      '   f.IDPESSOA        = :IDPESSOA        AND'
      '   c.IDCARGO         = f.IDCARGO        AND'
      '   c.IDFUNCAO        = f.IDFUNCAO       AND'
      '   c.CODCENTROCUSTO  = f.CODCENTROCUSTO AND'
      '   c.IDESPACESSO     = g.IDESPACESSO'
      'ORDER BY'
      '   g.NOMEGRUPO'
      ' '
      ' ')
    ClientDataSet = CdsGrupoXCargoXFuncaoXCCusto
    Left = 371
    Top = 149
  end
