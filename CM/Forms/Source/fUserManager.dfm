  object SqlPesqGrupo: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   IDGRUPO, '
      '   NOMEGRUPO, '
      '   DESCRICAO,'
      '   IDESPACESSO,'
      '   NOMEGRUPO AS DESCRICAO2 ,'
      '   NOMEGRUPO AS DESCRICAO3'
      'FROM '
      '   GRUPOACESSO '
      'ORDER BY '
      '   NOMEGRUPO')
    ClientDataSet = CdsPesqGrupo
    Left = 27
    Top = 29
  end
