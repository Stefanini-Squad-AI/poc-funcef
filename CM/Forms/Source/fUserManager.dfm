  object SQLOperFunc: TCMSqlParams
    SQL.Strings = (
      'SELECT OPERACAO.NOMEOPERACAO , OPERACAO.IDOPERACAO,'
      '               FORM.NOMEFORM, FROBFNOP.IDFORM,'
      '               OBJETO.NOMEOBJETO, FROBFNOP.IDOBJETO,'
      '               OPERFUNC.IDMODULO,'
      '               OPERFUNC.IDOPERFUNC,'
      '               OPERFUNC.IDOPERACAO,'
      '               OPERFUNC.IDFUNCAO'
      'FROM FORM, OBJETO, OPERACAO, OPERFUNC, FROBFNOP'
      'WHERE (OPERFUNC.IDFUNCAO=:IdFuncao)'
      '      AND (OPERFUNC.IDMODULO = :IdModulo)'
      
        '      AND (OPERFUNC.IDOPERACAO = :IdOperacao or :IdOperacao is n' +
        'ull) '
      '      AND (OPERFUNC.IDOPERFUNC= FROBFNOP.IDOPERFUNC)'
      '      AND (FORM.IDFORM=FROBFNOP.IDFORM)'
      '      AND (OBJETO.IDOBJETO=FROBFNOP.IDOBJETO)'
      '      AND (OPERACAO.IDOPERACAO=OPERFUNC.IDOPERACAO)'
      'ORDER BY OPERACAO.NOMEOPERACAO,FORM.NOMEFORM,OBJETO.NOMEOBJETO'
      ''
      ' '
      ' ')
    ClientDataSet = CdsOperFunc
    Left = 437
    Top = 29
  end
