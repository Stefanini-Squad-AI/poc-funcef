  object SqlPesqUsuario: TCMSqlParams
    SQL.Strings = (
      'SELECT U.NOMEUSUARIO,'
      '       P.NOME NOME_COMPLETO,'
      
        '       DECODE(U.FLGTIPOUSU, 1, C.TITULO, 2, U.DESCRICAO) CARGO_T' +
        'IPO,'
      
        '       DECODE(U.FLGTIPOUSU, 1, CC.NOME, 2, PE.RAZAOSOCIAL) LOTAC' +
        'AO_EMPRESA,'
      '       DECODE(U.DESATIVADO,'#39'N'#39','#39'ATIVO'#39','#39'INATIVO'#39') STATUS,'
      '       U.IDUSUARIO,       '
      '       U.IDESPACESSO       '
      '  FROM USUARIOSISTEMA U'
      
        '  JOIN PESSOA P ON U.IDUSUARIO = P.IDPESSOA AND U.DESATIVADO IN ' +
        '( '#39'N'#39', :desativado )'
      '  LEFT JOIN FUNCIONARIO F ON F.IDPESSOA = P.IDPESSOA'
      '  LEFT JOIN CARGO C ON C.IDCARGO = NVL(F.IDFUNCAO, F.IDCARGO)'
      '  LEFT JOIN CENTCUST CC ON CC.CODCENTROCUSTO = F.CODCENTROCUSTO'
      '  LEFT JOIN PESSOA PE ON PE.IDPESSOA = U.IDFORCLI'
      'ORDER BY U.NOMEUSUARIO'
      ''
      ' ')
    ClientDataSet = CdsPesqUsuario
    Left = 83
    Top = 29
  end
