  object SQLDataViewAcesso: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   A.IDESPACESSO,'
      '   A.IDDATAVIEW,'
      '   A.ORIGEMCMDV,'
      '   D.NAME'
      'FROM'
      '   DATAVIEWACESSO A, DATAVIEW D'
      'WHERE'
      '   A.IDDATAVIEW = D.IDDATAVIEW'
      '   AND A.ORIGEMCMDV = D.ORIGEMCMDV'
      '   AND A.IDESPACESSO = :IDESPACESSO ')
    ClientDataSet = CdsDataViewAcesso
    Left = 141
    Top = 29
  end
