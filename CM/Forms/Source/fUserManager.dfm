  object SqlPesqTelaUsuario: TCMSqlParams
    SQL.Strings = (
      ''
      'SELECT P.NOME NOME_COMPLETO,'
      '       P.EMAIL,'
      '       C.TITULO CARGO,'
      '       CC.NOME AREA'
      '  FROM FUNCIONARIO F'
      '  JOIN PESSOA P ON P.IDPESSOA = F.IDPESSOA'
      '  JOIN CARGO C ON C.IDCARGO = NVL(F.IDFUNCAO, F.IDCARGO)'
      '  JOIN CENTCUST CC ON CC.CODCENTROCUSTO = F.CODCENTROCUSTO'
      ' WHERE F.IDPESSOA = :IDPESSOA')
    ClientDataSet = cdsPesqTelaUsuario
    Left = 784
    Top = 40
  end
