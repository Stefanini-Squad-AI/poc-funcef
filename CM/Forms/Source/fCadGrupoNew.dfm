  object sqlVerifRelac: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '  GAC.IDGRUPO, '
      '  GAC.IDESPACESSO '
      'FROM CARGOXGRUPOXCC CXGXCC, GRUPOACESSO GAC'
      'WHERE CXGXCC.IDESPACESSO = GAC.IDESPACESSO AND'
      '      GAC.IDGRUPO = :idgrupo')
    ClientDataSet = cdsVerifRelac
    Left = 216
    Top = 344
  end
