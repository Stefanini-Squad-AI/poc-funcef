  object pNPermitido: TCMSqlParams
    SQL.Strings = (
      'SELECT TABLE_NAME'
      '  FROM (SELECT SUBSTR(TABLE_NAME, 12) AS TABLE_NAME'
      '          FROM ALL_TABLES'
      '         WHERE OWNER = '#39'LOGPLANUS'#39
      '           AND TABLE_NAME LIKE '#39'LOG_PLANUS%'#39')           '
      ' WHERE TABLE_NAME NOT IN (SELECT NOMETABELA'
      '                            FROM logplanus.USUARIOXTABELA'
      '                           WHERE IDUSUARIO = :IDUSUARIO)'
      '                           ORDER BY TABLE_NAME'
      ''
      ''
      '')
    ClientDataSet = cdsNpermitido
    Left = 504
    Top = 120
  end
