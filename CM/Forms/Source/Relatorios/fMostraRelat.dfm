    SQL.Strings = (
      'SELECT'
      '   R.IDREPORTS,'
      '   R.ORIGEMCM,'
      '   R.NAME ,'
      '   R.IDMODULO ,'
      '   R.IDDATAVIEW,'
      '   R.DESCRIPTION ,'
      '   R.TEMPLATE AS REPORTTEMPLATE,'
      '   R.IDGRUPORELATORIO ,'
      '   R.FLGFILTROMANUAL ,'
      '   R.FORMEVENTOS ,'
      '   R.FORMPARAMREL ,'
      '   R.PPREPORT,'
      '   R.FLGSUBREPORT,'
      '   R.IDSUBDATAVIEW1,'
      '   R.IDSUBDATAVIEW2,'
      '   R.IDSUBDATAVIEW3,'
      '   R.IDSUBDATAVIEW4,'
      '   R.IDSUBDATAVIEW5,'
      '   R.IDSUBDATAVIEW6,'
      '   V.CLASSNAME,'
      '   V.CLASSDESCRIPTION,'
      '   V.DESCRIPTION,'
      '   V.TEMPLATE AS DATAVIEWTEMPLATE,'
      '   SUB1.TEMPLATE AS DATAVIEWTEMPLATESUB1,'
      '   SUB2.TEMPLATE AS DATAVIEWTEMPLATESUB2,'
      '   SUB3.TEMPLATE AS DATAVIEWTEMPLATESUB3,'
      '   SUB4.TEMPLATE AS DATAVIEWTEMPLATESUB4,'
      '   SUB5.TEMPLATE AS DATAVIEWTEMPLATESUB5,'
      '   SUB6.TEMPLATE AS DATAVIEWTEMPLATESUB6,'
      '   R.FLGEXPORTAMANUAL, R.FLGEXPORTAMANUALSUB,'
      '   R.FLGUSARADO'
      'FROM'
      '   REPORTS R,'
      '   DATAVIEW V,'
      '   DATAVIEW SUB1,'
      '   DATAVIEW SUB2,'
      '   DATAVIEW SUB3,'
      '   DATAVIEW SUB4,'
      '   DATAVIEW SUB5,'
      '   DATAVIEW SUB6'
      'WHERE'
      '   (R.IDREPORTS = :IDREPORTS) AND'
      '   (R.ORIGEMCM = :IDORIGEMCM) AND'
      '   (R.IDDATAVIEW = V.IDDATAVIEW(+)) AND'
      '   (R.ORIGEMCMDV = V.ORIGEMCMDV(+)) AND'
      '   (R.IDSUBDATAVIEW1 = SUB1.IDDATAVIEW(+)) AND'
      '   (R.ORIGEMCMDV1    = SUB1.ORIGEMCMDV(+)) AND'
      '   (R.IDSUBDATAVIEW2 = SUB2.IDDATAVIEW(+)) AND'
      '   (R.ORIGEMCMDV2    = SUB2.ORIGEMCMDV(+)) AND'
      '   (R.IDSUBDATAVIEW3 = SUB3.IDDATAVIEW(+)) AND'
      '   (R.ORIGEMCMDV3    = SUB3.ORIGEMCMDV(+)) AND'
      '   (R.IDSUBDATAVIEW4 = SUB4.IDDATAVIEW(+)) AND'
      '   (R.ORIGEMCMDV4    = SUB4.ORIGEMCMDV(+)) AND'
      '   (R.IDSUBDATAVIEW5 = SUB5.IDDATAVIEW(+)) AND'
      '   (R.ORIGEMCMDV5    = SUB5.ORIGEMCMDV(+)) AND'
      '   (R.IDSUBDATAVIEW6 = SUB6.IDDATAVIEW(+)) AND'
      '   (R.ORIGEMCMDV6    = SUB6.ORIGEMCMDV(+))'
      ''
      ' ')
    ClientDataSet = CdsReport
    Left = 232
    Top = 200
  end
