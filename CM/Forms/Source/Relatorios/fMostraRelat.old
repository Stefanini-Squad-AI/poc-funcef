implementation

uses FPreview, uString, dReports, uDataBase, DBaseDados;

{$R *.DFM}

procedure TfrmMostraRelat.MontaArvoreRelatorio;
Var
    SOldNome, SOldGrupo: String;
    TreePai, TreeFilho, TreeGrupo: TTreeNode;
Begin
  FazQuery(DtmBaseDados.Qry,'Select R.IdReports, R.OrigemCm, M.NomeModulo, R.Name, G.Descricao ' +
                 'From Reports R, Modulo M, GrupoRelatorio G ' +
                 'Where '+
                 ' ((R.IdModulo = ' + IntToStr(Sistema.IdModulo) + ') Or ' +
                 '  ((R.IdModulo = 2) And (R.IdDataView Is Not Null))) And ' +
                 ' (R.IdModulo = M.IdModulo) And ' +
                 ' (R.IdGrupoRelatorio = G.IdGrupoRelatorio(+)) And ' +
                 ' (R.OrigemCmGr = G.OrigemCmGr(+)) ' +
                 'Order By M.NomeModulo, G.Descricao, R.Name');

  sOldNome := '';
  sOldGrupo := '';
  TreePai := nil;
  TreeGrupo := nil;

  TreeReports.Items.Clear;
  ListaReports.Clear;

  While Not DtmBaseDados.Qry.Eof Do
  Begin
     If SoldNome <> DtmBaseDados.Qry.FieldByName('NOMEMODULO').AsString Then
     Begin
      TreePai := TreeReports.Items.Add(nil,DtmBaseDados.Qry.FieldByName('NOMEMODULO').AsString);
      TreePai.ImageIndex := 0;
      TreePai.SelectedIndex := 0;
      ListaReports.Add('0/' + DtmBaseDados.Qry.FieldByName('IdReports').AsString + '-' +
                       DtmBaseDados.Qry.FieldByName('OrigemCm').AsString);

      sOldGrupo := '';
     End;

     If SoldGrupo <> DtmBaseDados.Qry.FieldByName('DESCRICAO').AsString Then
     Begin
      TreeGrupo := TreeReports.Items.AddChild(TreePai,DtmBaseDados.Qry.FieldByName('DESCRICAO').AsString);
      TreeGrupo.ImageIndex := 3;
      TreeGrupo.SelectedIndex := 3;
      ListaReports.Add('3/' +DtmBaseDados.Qry.FieldByName('IdReports').AsString + '-' +
                       DtmBaseDados.Qry.FieldByName('OrigemCm').AsString);
     End;


     TreeFilho := TreeReports.Items.AddChild(TreeGrupo,DtmBaseDados.Qry.FieldByName('NAME').AsString);
     TreeFilho.ImageIndex := 1;
     TreeFilho.SelectedIndex := 2;
     ListaReports.Add('1/' + DtmBaseDados.Qry.FieldByName('IdReports').AsString + '-' +
                       DtmBaseDados.Qry.FieldByName('OrigemCm').AsString);


     SOldNome := DtmBaseDados.Qry.FieldByName('NOMEMODULO').AsString;
     sOldGrupo := DtmBaseDados.Qry.FieldByName('DESCRICAO').AsString;
     DtmBaseDados.Qry.Next;
  End;
  DtmBaseDados.Qry.Close;
end;

procedure TfrmMostraRelat.FormCreate(Sender: TObject);
begin
  inherited;
  //Abre Tabelas e Inicializa Gerentes de Reports e Dataviews
  SemRelatorio := True;
  btnTelaUnica.Enabled := not SemRelatorio;
  If Not qryReport.Prepared Then qryReport.Prepare;
  LstTipoDeDado := TStringList.Create;
  ListaReports  := TStringList.Create;
  MontaArvoreRelatorio;
  ArquivoSaida := TppArchiveDevice.Create(self);
  ppRegisterForm(TppCustomPreviewer, TFrmPreview);
  ppRegisterForm(TfrmSairAjuda, TFrmMostraRelat);
  RelatManual := TppReport.Create(self);
                 RelatManual.Device := dvScreen;
                 RelatManual.Language := lgPortugueseBrazil;

  RelatGerador := TppReport.Create(self);
                 RelatGerador.Device := dvScreen;
                 RelatGerador.Language := lgPortugueseBrazil;
end;

procedure TfrmMostraRelat.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  inherited;
  qryReport.Close;
  If qryReport.Prepared Then qryReport.UnPrepare;
  QrySql.Close;
end;

Function TfrmMostraRelat.FiltraRegistrosManual: TFrResult;
Begin
     Result := FrFull;
     if qryReport.FieldByName('flgFiltroManual').AsString = 'S' then
       Try
        QrySql.Filtered := False;
        QrySql.FilterOptions := [];
        QrySql.Filter := '';

        Application.CreateForm(TFrmFiltraSql,FrmFiltraSql);
        FrmFiltraSql.QryOrigem := QrySql;

        Case FrmFiltraSql.ShowModal of
          MrOk:    Result := FrFiltrado;
          MrAbort: Result := FrError;
        Else
                   Result := FrFull;
        End;

        FrmFiltraSql.Free;

       Except
        Result := FrError;       
        If QrySql.Active Then QrySql.Close;
        QrySql.Filtered := False;
        QrySql.FilterOptions := [];
        QrySql.Filter := '';

        FrmFiltraSql.Free;
       End;
end;

Procedure TfrmMostraRelat.VisualizaRelatorio;
Var
  Mostra : boolean;
//  qry : TwwQuery;
  dtm : TdtmReports;
begin
    //Verifica Qual item da lista foi selecionado
    with qryReport do
    begin
         If (TreeReports.Selected <> Nil) and (TreeReports.Selected.ImageIndex = 1) Then
         begin
              If (UPPERCASE(TRIM(FieldByName('CLASSNAME').AsString)) = 'TDVQRYMANUAL') Or
                 (UPPERCASE(TRIM(FieldByName('CLASSNAME').AsString)) = 'TDVQUERYWZD') Then
                 TipoReport := trQryManual
              else if TRIM(FieldByName('CLASSNAME').AsString) = '' Then
                 TipoReport := trDataModulo
              else
                 TipoReport := trGerador;

              dtm := nil;
//              qry := nil;

              case TipoReport of
                   trQryManual :
                   begin
                        with RelatManual do
                        begin
                             CloseDataPipelines;

                             QrySql.Close;
                             QrySql.Sql.Clear;
                             QrySql.Sql.Text := (FieldByName('DATAVIEWTEMPLATE').AsString);

                             Template.SaveTo := stDatabase;
                             SaveAsTemplate := True;
                             AllowPrintToArchive := True;
                             AllowPrintToFile := True;
                             Template.DatabaseSettings.Name := TreeReports.Selected.Text;
                             Template.DatabaseSettings.DataPipeline := dpReport;
                             Template.DatabaseSettings.NameField := 'NAME';
                             Template.DatabaseSettings.TemplateField := 'REPORTTEMPLATE';
                             Template.LoadFromDatabase;
                             Datapipeline := PpSql;
                        end;
                   end;

                   trDataModulo :
                   begin
                        try
                           dtm := TdtmReports(Application.FindComponent(FieldByName('FORMEVENTOS').AsString));
                           ppViewer1.Report := TppReport(dtm.FindComponent(FieldByName('ppReport').AsString));
//                           qry := TwwQuery(TppBDEPipeline(TppReport(dtm.FindComponent(FieldByName('ppReport').AsString)).DataPipeline).DataSource.DataSet);
                           ppViewer1.Report.Device := dvScreen;
                           ppViewer1.Report.Language := lgPortugueseBrazil;
                        except
                              MsgDlg('Não encontrei o Report: '+
                              UPPERCASE(FieldByName('ppReport').AsString)+
                              ' em '+ UPPERCASE(FieldByName('FORMEVENTOS').AsString)+#10#13+
                              'Possivelmente os dados cadastrados na tabela "REPORTS" estão desatualizados',
                              'Relatorios com eventos', mtError, [mbOK],0);
                              exit;
                        end;
                   end;
              end;
                 Caption := 'Visualizar Relatórios ' +  TreeReports.Selected.Text;
                 Mostra := false;

                 case TipoReport of
                      trQryManual  :
                           Mostra  := (FiltraRegistrosManual <> FrError);
                      trDataModulo :
                           begin
                                Mostra := (FiltraRegistrosManual <> FrError) And
                                          dtm.MostraParam(qryReport.FieldByName('FORMPARAMREL').AsString);
                           end;
                 end;

                 if Mostra then  MostraRelat;

                 SemRelatorio := (ppViewer1.Report = nil);
                 btnTelaUnica.Enabled := not SemRelatorio;
             end;
    end;
End;

procedure TfrmMostraRelat.BtnVisualizarClick(Sender: TObject);
begin
  inherited;
  PreviewRelatorio;
end;

procedure TfrmMostraRelat.TreeReportsDblClick(Sender: TObject);
begin
