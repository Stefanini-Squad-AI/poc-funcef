  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT'
      '   GRUPOACESSO.IDESPACESSO, '
      '   GRUPOACESSO.NOMEGRUPO , '
      '   GRUPOACESSO.IDGRUPO '
      'FROM '
      '   GRUPOACESSO '
      'WHERE'
      '   GRUPOACESSO.IDGRUPO = :IdGrupo'
      'ORDER BY GRUPOACESSO.NOMEGRUPO')
    Left = 631
