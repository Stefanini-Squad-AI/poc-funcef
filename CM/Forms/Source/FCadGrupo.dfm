  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update GRUPOACESSO'
      'set'
      '  IDESPACESSO = :IDESPACESSO,'
      '  NOMEGRUPO = :NOMEGRUPO,'
      '  IDGRUPO = :IDGRUPO'
      'where'
      '  IDGRUPO = :OLD_IDGRUPO')
    InsertSQL.Strings = (
      'insert into GRUPOACESSO'
      '  (IDESPACESSO, NOMEGRUPO, IDGRUPO)'
      'values'
      '  (:IDESPACESSO, :NOMEGRUPO, :IDGRUPO)')
    DeleteSQL.Strings = (
      'delete from GRUPOACESSO'
      'where'
      '  IDGRUPO = :OLD_IDGRUPO')
    Left = 633
    Top = 272
  end
