  object qryAcesso: TwwQuery
    CachedUpdates = True
    OnCalcFields = qryAcessoCalcFields
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT'
      '    FPAI.NOMEFUNCAO AS NOMEFUNCAOPAI,'
      '    FUNCAO.NOMEFUNCAO,'
      '    OPERACAO.NOMEOPERACAO ,'
      '    FUNCAO.IDFUNCAO,'
      '    FUNCAO.IDFUNCAOPAI,'
      '    OPERACAO.IDOPERACAO'
      'FROM'
      '    FUNCAO,  OPERACAO, OPERFUNC, FUNCAO FPAI'
      'WHERE'
      '            (OPERFUNC.IDFUNCAO= FUNCAO.IDFUNCAO)'
      '    AND (FUNCAO.IDMODULO = :IDMODULO)'
      '    AND (FUNCAO.IDFUNCAOPAI = FPAI.IDFUNCAO(+))'
      '    AND (OPERACAO.IDOPERACAO=OPERFUNC.IDOPERACAO)'
      'ORDER BY'
      '   FUNCAO.IDFUNCAOPAI,'
      '   FUNCAO.IDFUNCAO'
      ''
      '')
    UpdateObject = updAcesso
    ControlType.Strings = (
      'Checado;CheckBox;true;false')
    ValidateWithMask = True
    Left = 309
    Top = 271
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDMODULO'
        ParamType = ptUnknown
      end>
