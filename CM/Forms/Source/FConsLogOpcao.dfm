  object qryLogOpcao: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT L.IDLOGOPCAO, P.NOME AS USUARIO,'
      '       L.NOMEOPCAO, L.DATALOG'
      'FROM PESSOA P,'
      '     LOGOPCAO L'
      'WHERE (L.IDPESSOA = :IDPESSOA)'
      '  AND (L.IDMODULO = :IDMODULO)'
      '  AND (1 = 2)'
      '  AND (1 = 2)'
      '  AND (1 = 2)'
      '  AND (P.IDPESSOA = L.IDUSUARIO)'
      'ORDER BY L.DATALOG, L.IDLOGOPCAO'
      ' '
      ' ')
    ValidateWithMask = True
    Left = 176
    Top = 92
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDMODULO'
        ParamType = ptUnknown
      end>
    object qryLogOpcaoDATALOG: TDateTimeField
      DisplayLabel = 'Data'
      DisplayWidth = 12
      FieldName = 'DATALOG'
      Origin = 'BASEDADOS.LOGOPCAO.DATALOG'
    end
