      DisplayWidth = 10
      FieldName = 'IDLOGOPCAO'
      Origin = 'BASEDADOS.LOGOPCAO.IDLOGOPCAO'
    end
  end
  object dsLogOpcao: TwwDataSource
    DataSet = qryLogOpcao
    Left = 258
    Top = 132
  end
  object qryUsuario: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT P.NOME AS USUARIO, L.IDUSUARIO'
      'FROM PESSOA P,'
      '     LOGOPCAO L'
      'WHERE (L.IDPESSOA = :IDPESSOA)'
      '  AND (L.IDMODULO = :IDMODULO)'
      '  AND (P.IDPESSOA = L.IDUSUARIO)'
      'ORDER BY P.NOME'
      '')
    ValidateWithMask = True
    Left = 411
    Top = 120
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDMODULO'
        ParamType = ptUnknown
      end>
  end
