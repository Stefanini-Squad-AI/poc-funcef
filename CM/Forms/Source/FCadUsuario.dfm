  object qryAcesso: TwwQuery
    CachedUpdates = True
    OnCalcFields = qryAcessoCalcFields
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT'
      '    FPAI.NOMEFUNCAO AS NOMEFUNCAOPAI,'
      '    FUNCAO.NOMEFUNCAO,'
      '    OPERACAO.NOMEOPERACAO ,'
      '    FUNCAO.IDFUNCAO,'
      '    FUNCAO.IDFUNCAOPAI,'
      '    OPERACAO.IDOPERACAO'
      'FROM'
      '    FUNCAO,  OPERACAO, OPERFUNC, FUNCAO FPAI'
      'WHERE'
      '        (OPERFUNC.IDFUNCAO= FUNCAO.IDFUNCAO)'
      '    AND (FUNCAO.IDMODULO = :IDMODULO)'
      '    AND (FUNCAO.IDFUNCAOPAI = FPAI.IDFUNCAO(+))'
      '    AND (OPERACAO.IDOPERACAO=OPERFUNC.IDOPERACAO)'
      'ORDER BY'
      '   FUNCAO.IDFUNCAOPAI, '
      '   FUNCAO.IDFUNCAO'
      '')
    UpdateObject = UpAcesso
    ControlType.Strings = (
      'Checado;CheckBox;true;false')
    ValidateWithMask = True
    Left = 569
    Top = 182
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDMODULO'
        ParamType = ptUnknown
      end>
    object qryAcessoChecado: TBooleanField
      DisplayLabel = ' '
      DisplayWidth = 2
      FieldKind = fkCalculated
      FieldName = 'Checado'
      OnChange = qryAcessoChecadoChange
      Calculated = True
    end
    object qryAcessoNOMEFUNCAO: TStringField
      DisplayLabel = 'F'
      DisplayWidth = 30
      FieldName = 'NOMEFUNCAO'
      Origin = 'FUNCAO.NOMEFUNCAO'
      Size = 60
    end
    object qryAcessoNOMEOPERACAO: TStringField
      DisplayLabel = 'O'
      DisplayWidth = 20
      FieldName = 'NOMEOPERACAO'
