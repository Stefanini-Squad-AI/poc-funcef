  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update USUARIOSISTEMA'
      'set'
      '  IDUSUARIO = :IDUSUARIO,'
      '  NOMEUSUARIO = :NOMEUSUARIO,'
      '  SENHA = :SENHA,'
      '  IDESPACESSO = :IDESPACESSO'
      'where'
      '  IDUSUARIO = :OLD_IDUSUARIO')
    InsertSQL.Strings = (
      'insert into USUARIOSISTEMA'
      '  (IDUSUARIO, NOMEUSUARIO, SENHA, IDESPACESSO)'
      'values'
      '  (:IDUSUARIO, :NOMEUSUARIO, :SENHA, :IDESPACESSO)')
    DeleteSQL.Strings = (
      'delete from USUARIOSISTEMA'
      'where'
      '  IDUSUARIO = :OLD_IDUSUARIO')
    Left = 301
    Top = 280
  end
