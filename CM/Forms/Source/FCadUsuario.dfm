  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT '
      '   U.SENHA , '
      '   U.IDESPACESSO,'
      '   U.NOMEUSUARIO , '
      '   U.IDUSUARIO, '
      '   PESSOA.NOME'
      'FROM '
      '   USUARIOSISTEMA U, '
      '   PESSOA '
      'WHERE '
      '    (PESSOA.IDPESSOA = :IdUsuario)'
      '   AND'
      '  (U.IDUSUARIO(+) = PESSOA.IDPESSOA ) '
      'ORDER '
      'BY '
      'U.NOMEUSUARIO')
    PictureMasks.Strings = (
      'NOMEUSUARIO'#9'*!'#9'T'#9'F')
    Left = 464
    Top = 320
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IdUsuario'
        ParamType = ptUnknown
      end>
    object qrySENHA: TStringField
      FieldName = 'SENHA'
      Size = 15
    end
    object qryIDESPACESSO: TFloatField
      FieldName = 'IDESPACESSO'
    end
    object qryNOMEUSUARIO: TStringField
      FieldName = 'NOMEUSUARIO'
    end
    object qryIDUSUARIO: TFloatField
      FieldName = 'IDUSUARIO'
    end
    object qryNOME: TStringField
      FieldName = 'NOME'
      Size = 60
    end
  end
