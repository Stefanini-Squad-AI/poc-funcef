  object qryOperFunc: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseSAD'
    SQL.Strings = (
      'SELECT'
      '    FUNCAO.NOMEFUNCAO,'
      '    FUNCAO.IDFUNCAO,'
      '    FUNCAO.IDFUNCAOPAI,'
      '    FUNCAO.IDMODULO,'
      '    OPERACAO.NOMEOPERACAO ,'
      '    OPERACAO.IDOPERACAO,'
      '    FORM.NOMEFORM,'
      '    FROBFNOP.IDFORM,'
      '    OBJETO.NOMEOBJETO,'
      '    FROBFNOP.IDOBJETO,'
      '    OPERFUNC.IDMODULO,'
      '    OPERFUNC.IDOPERFUNC,'
      '    OPERFUNC.IDOPERACAO,'
      '    OPERFUNC.IDFUNCAO'
      'FROM'
      '    FORM, OBJETO, OPERACAO, OPERFUNC, FROBFNOP, FUNCAO'
      'WHERE'
      '        (OPERFUNC.IDFUNCAO= FUNCAO.IDFUNCAO)'
      '    AND (FUNCAO.IDMODULO = :IdModulo)'
      '    AND (OPERFUNC.IDOPERFUNC= FROBFNOP.IDOPERFUNC)'
      '    AND (FORM.IDFORM=FROBFNOP.IDFORM)'
      '    AND (OBJETO.IDOBJETO=FROBFNOP.IDOBJETO)'
      '    AND (OPERACAO.IDOPERACAO=OPERFUNC.IDOPERACAO)'
      'ORDER BY'
      
        '   FUNCAO.IDFUNCAOPAI, OPERACAO.NOMEOPERACAO,FORM.NOMEFORM,OBJET' +
        'O.NOMEOBJETO')
