  object Sql: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   WORKFLOW.IDWORKFLOW , '
      '   WORKFLOW.IDMODULO , '
      '   WORKFLOW.DESCWORKFLOW'
      'FROM '
      '   WORKFLOW'
      'WHERE '
      '    ( WORKFLOW.IDWORKFLOW = :IDWORKFLOW )')
    ClientDataSet = Cds
    Left = 447
    Top = 58
  end
  object SQLPassoFluxoper: TCMSqlParams
    SQL.Strings = (
      'SELECT PASSOWORKFLOW.IDWORKFLOW , '
      ' PASSOWORKFLOW.ORDEM , '
      ' PASSOWORKFLOW.DESCPASSO , '
      ' PASSOWORKFLOW.NOMEPASSO , '
      ' PASSOWORKFLOW.ITEMMENU'
      'FROM PASSOWORKFLOW '
      'WHERE ( PASSOWORKFLOW.IDWORKFLOW = :IdWorkflow )')
    ClientDataSet = CdsPassoFluxoper
    Left = 608
    Top = 58
  end
  object SqlFluxOperUsuario: TCMSqlParams
    SQL.Strings = (
      'SELECT WORKFLOWUSUARIO.IDWORKFLOW , '
      ' WORKFLOWUSUARIO.IDUSUARIO , '
      ' USUARIOSISTEMA.NOMEUSUARIO'
      'FROM WORKFLOWUSUARIO, USUARIOSISTEMA'
      'WHERE ( WORKFLOWUSUARIO.IDWORKFLOW = :IdWorkFlow )'
      '  AND'
      ' ( WORKFLOWUSUARIO.IDUSUARIO = USUARIOSISTEMA.IDUSUARIO)'
      '')
    ClientDataSet = CdsFluxOperUsuario
    Left = 560
    Top = 58
  end
  object SqlUsuario: TCMSqlParams
    SQL.Strings = (
      'SELECT USUARIOSISTEMA.IDUSUARIO , '
      ' USUARIOSISTEMA.NOMEUSUARIO'
      'FROM USUARIOSISTEMA '
      'ORDER BY'
      ' USUARIOSISTEMA.NOMEUSUARIO')
    ClientDataSet = CdsUsuario
    Left = 496
    Top = 58
  end
