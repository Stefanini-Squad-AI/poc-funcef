  object SQLCentroCusto: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '  CODCENTROCUSTO, IDEMPRESA, NOME, STATUSGRUPOCDC '
      'FROM '
      '  CENTCUST'
      'WHERE'
      '  (IDEMPRESA = :IDEMPRESA) AND'
      '  (ATIVO = '#39'S'#39' OR ATIVO IS NULL)'
      'ORDER BY'
      '  CODCENTROCUSTO, STATUSGRUPOCDC, NOME')
    ClientDataSet = CdsCentroCusto
    Left = 312
    Top = 111
  end
