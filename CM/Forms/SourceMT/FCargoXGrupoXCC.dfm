  object SQL: TCMSqlParams
    SQL.Strings = (
      'SELECT * FROM'
      '('
      'SELECT'
      '  (1) AS SELECIONADO,'
      '  (1) AS IMAGEINDEX,'
      '  C.IDESPACESSO,'
      '  GA.NOMEGRUPO'
      'FROM'
      '  CARGOXGRUPOXCC C,'
      '  GRUPOACESSO GA'
      'WHERE'
      '  C.IDEMPRESA = :IDEMPRESA AND'
      '  C.CODCENTROCUSTO = :CODCENTROCUSTO AND'
      '  C.IDCARGO = :IDCARGO AND'
      '  C.IDFUNCAO :IDFUNCAO AND'
      '  C.IDESPACESSO = GA.IDESPACESSO'
      'UNION'
      'SELECT'
      '  (0) AS SELECIONADO,'
      '  (0) AS IMAGEINDEX,'
      '  GA.IDESPACESSO,'
      '  GA.NOMEGRUPO'
      'FROM'
      '  GRUPOACESSO GA'
      'WHERE'
      '  GA.IDESPACESSO NOT IN'
      '    ('
      '     SELECT'
      '       C.IDESPACESSO'
      '     FROM'
      '       CARGOXGRUPOXCC C,'
      '       GRUPOACESSO GA'
      '     WHERE'
      '       C.IDEMPRESA = :IDEMPRESA AND'
      '       C.CODCENTROCUSTO = :CODCENTROCUSTO AND'
      '       C.IDCARGO = :IDCARGO AND'
      '       C.IDFUNCAO :IDFUNCAO AND'
      '       C.IDESPACESSO = GA.IDESPACESSO'
      '     )'
      ')'
      'ORDER BY NOMEGRUPO')
    OnFormartParam = SQLFormartParam
    ClientDataSet = Cds
    Left = 260
    Top = 115
  end
