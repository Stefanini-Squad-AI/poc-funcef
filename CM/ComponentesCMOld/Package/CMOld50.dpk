package CmOld50;

{$R *.RES}
{$R CMOLD50_RES.RES}

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Componentes para compatibilidade anterior'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  Vclx50,
  Vcldb50,
  Vclbde50,
  ip50_d5,
  CmCompo50;

contains
  Wwdbgrd2 in '..\Source\wwdbgrd2.pas',
  cmseldlg in '..\Source\cmseldlg.pas',
  CMStrGrd in '..\Source\cmstrgrd.pas',
  cmstrgrd2 in '..\Source\cmstrgrd2.pas',
  DBCtrls2 in '..\Source\Dbctrls2.pas',
  DBGrid2 in '..\Source\DBGrid2.pas',
  FSele in '..\Source\FSele.pas' {frmSelec},
  Grids2 in '..\Source\Grids2.pas',
  OpenArqText in '..\Source\OpenArqText.pas',
  RegCmOld50 in '..\Source\RegCmOld50.pas',
  TEdNum in '..\Source\TEdNum.pas',
  CMFRMPROP in '..\Source\CMFrmProp.pas';

end.
