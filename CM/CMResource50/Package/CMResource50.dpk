package CMResource50;

{$R *.RES}
{$R CMRESOURCE50_RES.RES}

{$R 'CMResource50.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Componentes para manipulação de arquivos de Resource'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  dclaxserver50;

contains
  PJResWriterStreams in '..\Fontes\PJResWriterStreams.pas',
  PJStreamWrapper in '..\Fontes\PJStreamWrapper.pas',
  rxtypes in '..\Fontes\rxtypes.pas',
  ExeImage in '..\Fontes\exeimage.pas',
  uResource in '..\Fontes\uResource.pas';

end.
{CM$ALT
