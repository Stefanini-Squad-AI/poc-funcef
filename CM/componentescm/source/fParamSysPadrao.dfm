          Width = 175
          Height = 162
          Alignment = taCenter
          BorderStyle = bsNone
          Enabled = False
          Lines.Strings = (
            'O Sistema Planus está '
            'disponível em 3 idiomas:'
            'Português, Espanhol e '
            'Inglês.'
            'Isso permite que você '
            'configure dinamicamente o '
            'Idioma das telas dos seus'
            'Sistemas de acordo com '
            'o perfil de cada usuário'
            'da sua equipe.'
            ' ')
          ReadOnly = True
          TabOrder = 0
        end
      end
