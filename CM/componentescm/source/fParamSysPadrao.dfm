        object Memo5: TMemo
          Left = 9
          Top = 118
          Width = 171
          Height = 237
          BorderStyle = bsNone
          Enabled = False
          Lines.Strings = (
            'Aqui você configura a '
            'atualização automática do '
            'Sistema Planus instalados em '
            'seu computador a partir de '
            'um Diretório centralizado.'
            'Este diretório deve possuir '
            'as seguintes pastas com os '
            'seguintes arquivos:'
            'Bin - Nesta pasta devem ser '
            'instalados os executáveis'
            'Alt - Arquivos do tipo ALT'
            'Help - Arquivos do tipo HELP'
            'Lib - Contém os arquivos do '
            'InstalaCM e AtualizaCM.'
            'A chave de atualização de '
            'versão deve sempre apontar '
            'para a pasta Bin dentro do '
            'Diretório Centralizado.')
          ReadOnly = True
          TabOrder = 0
        end
