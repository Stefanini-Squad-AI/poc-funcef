        object Memo1: TMemo
          Left = 7
          Top = 113
          Width = 178
          Height = 262
          Alignment = taCenter
          BorderStyle = bsNone
          Enabled = False
          Lines.Strings = (
            'Através desta tela você'
            'configura de forma rápida e '
            'segura os parâmetros '
            'referentes ao Sistema Planus'
            'instalados em seu computador.'
            'Esses parâmetros podem ser '
            'comuns a todos os Sistemas '
            'ou podem ser específicos ao'
            'Sistema que está sendo '
            'executado.'
            'As informações aqui '
            'parametrizadas são essenciais '
            'para o perfeito funcionamento'
            'do Sistema Planus, sendo '
            'assim só altere tais '
            'configurações '
            'se você tiver absoluta'
            'certeza das informações a '
            'serem alteradas.'
            ' ')
          ReadOnly = True
          TabOrder = 0
        end
      end
