package VCLBDE502;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Borland BDE Database Components'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  vcldb50;

contains
  Bde,
  BdeConst in '..\..\..\arquivos de programas\borland\delphi5\Source\Vcl\BdeConst.pas',
  DBPWDlg in '..\..\..\arquivos de programas\borland\delphi5\Source\Vcl\DBPWDlg.pas',
  DBTables in '..\..\..\arquivos de programas\borland\delphi5\Source\Vcl\DBTables.pas',
  SMIntf in '..\..\..\arquivos de programas\borland\delphi5\Source\Vcl\SMIntf.pas',
  DBInpReq in '..\..\..\arquivos de programas\borland\delphi5\Source\Vcl\DBInpReq.pas';

end.
