package CmRelatsOld50;

{$R *.RES}
{$R CMRELATSOLD50_RES.RES}

{$R 'CmRelatsOld50.Dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Componentes e Forms QuickReport'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CmCompo50,
  dclqrt50,
  CMPrincipal50;

contains
  cmRepBtn in '..\Source\cmRepBtn.pas',
  FCMPreview in '..\Source\FCMPreview.pas' {frmCMPreview},
  RPai in '..\Source\RPai.pas' {relPai},
  FCMParamRel in '..\Source\FCMParamRel.pas' {CMParamRel},
  RHeadFoot in '..\Source\RHeadFoot.pas' {relHeadFoot},
  RSimples in '..\Source\RSimples.pas' {relSimples},
  RMestreDet in '..\Source\RMestreDet.pas' {relMestreDet};

end.
