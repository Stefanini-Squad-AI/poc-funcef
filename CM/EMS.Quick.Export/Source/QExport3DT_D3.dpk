package QExport3DT_D3;

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $00400000}
{$DESCRIPTION 'EMS Quick Export Component Suite 3.0'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl30,
  QExport3RT_D3;

contains
  QExport3Reg,
  QExport3Dsgn,
  fuQExport3ColumnsEditor,
  fuQExport3HTMLTemplateEditor,
  fuQExport3SourceList,
  fuQExport3XLSEditor;

end.
