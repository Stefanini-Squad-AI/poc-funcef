package ADO_QExport3DT_D5;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Planus - Componentes para Exportação de Dados 3.0'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  ADO_QExport3RT_D5,
  QExport3DT_D5;

contains
  ADO_QExport3Dsgn in 'ADO_QExport3Dsgn.pas',
  ADO_QExport3Reg in 'ADO_QExport3Reg.pas';

end.
