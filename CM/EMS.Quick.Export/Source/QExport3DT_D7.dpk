package QExport3DT_D7;

{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'EMS Quick Export Component Suite 3.0'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl,
  QExport3RT_D7,
  designide;

contains
  QExport3Reg in 'QExport3Reg.pas',
  QExport3Dsgn in 'QExport3Dsgn.pas',
  fuQExport3ColumnsEditor in 'fuQExport3ColumnsEditor.pas' {fmQExport3ColumnsEditor},
  fuQExport3HTMLTemplateEditor in 'fuQExport3HTMLTemplateEditor.pas' {fmQExport3HTMLTemplateEditor},
  fuQExport3SourceList in 'fuQExport3SourceList.pas' {fmQExport3SourceList},
  fuQExport3XLSEditor in 'fuQExport3XLSEditor.pas' {fmQExport3XLSEditor};

end.
