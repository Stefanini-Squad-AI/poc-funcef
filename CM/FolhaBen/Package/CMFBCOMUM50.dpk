{$DESCRIPTION 'CM - Componentes e Objetos da Folha Comum a Outros Modulos'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CmForms50;

contains
  fFrameConsultaHistorico in '..\source\fFrameConsultaHistorico.pas' {frmFrameConsultaHistorico: TFrame},
  uComumFolha in '..\source\uComumFolha.pas';

end.
