{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Objetos da Folha MT'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CmCompo50;

contains
  uCtrl2ViaContraCheque in '..\source\uCtrl2ViaContraCheque.pas';

end.
