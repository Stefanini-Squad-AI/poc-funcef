package CMRegra50;

{$R *.RES}
{$R CMREGRA50_RES.RES}

{$R 'regra50.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Componentes de Regra'}
{$IMPLICITBUILD OFF}

requires
  TB97_d5,
  CmCompo50,
  dclocx50;

contains
  URegra in '..\Source\URegra.pas',
  Fpassoapasso in '..\Source\fpassoapasso.pas' {FrmPassoAPasso},
  Fpegatab in '..\Source\fpegatab.pas' {frmpegatab},
  UCalcIrrf in '..\Source\ucalcirrf.pas',
  uFormulas in '..\Source\uFormulas.pas',
  uPilha in '..\Source\upilha.pas',
  FInputVar in '..\Source\finputvar.pas' {frmInputVar},
  FMostraPassos in '..\Source\FMostraPassos.pas' {FrmMostraPassos},
  uFuncoesRegra in '..\Source\uFuncoesRegra.pas',
  UDiasUteisInvest in '..\Source\UDiasUteisInvest.pas';

end.
