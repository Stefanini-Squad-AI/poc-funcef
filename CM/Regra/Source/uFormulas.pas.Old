  O meu pedido final

  Não deixe o samba morrer...

}


{
  ** Query maiores Valores **
SELECT
  *
FROM (SELECT
        MAX(NVL(SALPARTICIPACAO,0)), ROWNUM
      FROM
        PARTPREVPLAN
      GROUP BY
        ROWNUM
      ORDER BY
        MAX(NVL(SALPARTICIPACAO,0)) DESC )
WHERE
  ROWNUM <= 4
}







