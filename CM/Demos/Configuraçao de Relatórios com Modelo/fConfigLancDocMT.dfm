  inherited SqlDados: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   P.RAZAOSOCIAL, D.NODOCUMENTO, L.DATALANCTO, L.VALOR'
      'FROM'
      '  PESSOA P, DOCUMENTO D,  LANCTODOCUM L'
      'WHERE'
      '  (L.DATALANCTO BETWEEN :DATAINI AND :DATAFIM) AND'
      '  (D.CODDOCUMENTO = L.CODDOCUMENTO) AND'
      '  (D.OPERACAO = L.OPERACAO) AND'
      '  (D.IDFORCLI = P.IDPESSOA)')
  end
end
