package CMRad50;

{$R *.RES}
{$R CMRAD50_RES.RES}

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CmForms50,
  ip50client_d5;

contains
  uCtrlRAD in '..\CtrlObjetos\uCtrlRAD.pas',
  uDbRadAutorizacao in '..\DBObjetos\uDbRADAutorizacao.pas',
  uDbRADEtapa in '..\DBObjetos\uDbRADEtapa.pas',
  uDbRadObjeto in '..\DBObjetos\uDbRadObjeto.pas',
  uDbRADProcesso in '..\DBObjetos\uDbRADProcesso.pas',
  DRAD in '..\Source\DRAD.pas' {DtmRAD: TDataModule},
  FMTAcompProc in '..\Source\FMTAcompProc.pas' {FrmMTAcompProc},
  fMTAtuObjRAD in '..\Source\fMTAtuObjRAD.pas' {frmMTAtuObjRAD},
  FMTExecEtapa in '..\Source\FMTExecEtapa.pas' {FrmMTExecEtapa},
  FMTFinalizarEtapa in '..\Source\FMTFinalizarEtapa.pas' {FrmMTFinalizarEtapa},
  FMTGeraProc in '..\Source\FMTGeraProc.pas' {FrmMTGeraProc},
  FMTProcPend in '..\Source\FMTProcPend.pas' {FrmMTProcPend},
  uRAD in '..\Source\uRAD.pas',
  uCtrlEtapa in '..\CtrlObjetos\uCtrlEtapa.pas',
  uDbRadEtapaNovo in '..\DBObjetos\uDbRadEtapaNovo.pas',
  uDbRadEtapaCond in '..\DBObjetos\uDbRadEtapaCond.pas',
  uDbRadEtapaDest in '..\DBObjetos\uDbRadEtapaDest.pas',
  uCtrlRadTipoProc in '..\CtrlObjetos\uCtrlRadTipoProc.pas',
  uCtrlRadEtapaCond in '..\CtrlObjetos\uCtrlRadEtapaCond.pas',
  uCtrlRadEtapaDest in '..\CtrlObjetos\uCtrlRadEtapaDest.pas',
  fGeraProcesso in '..\Source\fGeraProcesso.pas',
  uCtrlRadEtapa in '..\CtrlObjetos\uCtrlRadEtapa.pas',
  uCtrlRADPlus in '..\CtrlObjetos\uCtrlRADPlus.pas',
  uDbRadTipoProc in '..\DBObjetos\uDbRadTipoProc.pas',
  uRADDataHora in '..\Source\uRADDataHora.pas',
  uCtrlRadInstProcesso in '..\CtrlObjetos\uCtrlRadInstProcesso.pas',
  fProcessosRad in '..\Source\fProcessosRad.pas' {frmProcessosRad},
  fPropAprovaRAD in '..\Source\fPropAprovaRAD.pas' {frmPropAprovaRAD},
  FRADConsultaDoc in '..\Source\FRADConsultaDoc.pas' {frmRADConsultaDoc},
  uCtrlRadConsModulos in '..\CtrlObjetos\uCtrlRadConsModulos.pas',
  uCtrlRADParam in '..\CtrlObjetos\uCtrlRADParam.pas',
  uDbRADParam in '..\DBObjetos\uDbRADParam.pas',
  FConsultaRAD in '..\Source\FConsultaRAD.pas' {frmConsultaRAD},
  FRADConsultaLote in '..\Source\FRADConsultaLote.pas' {frmRADConsultaLote},
  uDbRadAnexo in '..\DBObjetos\uDbRadAnexo.pas',
  uCtrlRadAnexo in '..\CtrlObjetos\uCtrlRadAnexo.pas',
  FRADConsultaOC in '..\Source\FRADConsultaOC.pas' {frmRADConsultaOC},
  FRADConsultaCotacaoComp in '..\Source\FRADConsultaCotacaoComp.pas' {frmRADConsultaCotacaoComp},
  FRADConsultaSoliComp in '..\Source\FRADConsultaSoliComp.pas' {frmRADConsultaSoliComp},
  FRADConsultaReqMat in '..\Source\FRADConsultaReqMat.pas' {frmRADConsultaReqMat},
  FRADConsultaDestacamento in '..\Source\FRADConsultaDestacamento.pas' {frmRADConsultaDestacamento};

end.
