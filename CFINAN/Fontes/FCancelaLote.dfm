      FieldName = 'DATAPROGRAMADA'
      Origin = 'DOCUMENTO.DATAPROGRAMADA'
    end
    object QryGridIDPESSOA: TFloatField
      FieldName = 'IDPESSOA'
      Origin = 'DOCUMENTO.IDPESSOA'
    end
    object QryGridDATAVENCTO: TDateTimeField
      FieldName = 'DATAVENCTO'
      Origin = 'DOCUMENTO.DATAVENCTO'
    end
    object QryGridNODOCUMENTO: TFloatField
