      Size = 15
    end
    object qryLotePagtoFAVORECIDO: TStringField
      FieldName = 'FAVORECIDO'
      Origin = '"CM.LOTEPAGTO".FAVORECIDO'
      Size = 60
    end
    object qryLotePagtoFLAGEMISSAO: TStringField
      FieldName = 'FLAGEMISSAO'
      Origin = '"CM.LOTEPAGTO".FLAGEMISSAO'
      Size = 1
    end
