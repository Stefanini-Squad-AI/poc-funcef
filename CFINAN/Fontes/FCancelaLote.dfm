      Origin = '"CM.LOTEPAGTO".IDUSUARIOINCLUSAO'
    end
    object qryLotePagtoDATAEMISSAO: TDateTimeField
      FieldName = 'DATAEMISSAO'
      Origin = '"CM.LOTEPAGTO".DATAEMISSAO'
    end
    object qryLotePagtoNUMCHQBORDERO: TStringField
