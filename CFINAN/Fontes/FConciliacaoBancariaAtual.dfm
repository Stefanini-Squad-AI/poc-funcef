    Top = 283
  end
  object SQLBloqueios: TCMSqlParams
    SQL.Strings = (
      'SELECT *'
      '  FROM (SELECT '#39'C'#39' AS TIPOBLOQ,'
      '               M.CODLANCFINANC,'
      '               M.DATALANCFINAN DATALANC,'
      '               M.CODPORTADOR,'
      '               M.SITBLOQUEIOLANC SITBLOQDESBLOQ,'
      '               M.NUMCHQBORDERO NUMDOCUMENTO,'
      '               M.ENTRADASAIDA,'
      '               M.VALORLANCFINAN,'
      '               M.HISTORICO,'
      '               M.DATADISPFINANC DATADISPONIB,'
      '               M.HISTPADFINAN,'
      '               -1 IDPLANPREVCTBPATR,'
      '               '#39#39' CODCENTRORESPON,'
      '               M.IDLANCCONCILIADO,     '
      '               M.DATADESBLOQUEIO'
      '          FROM MOVIMFINANC M, PORTADORCONTA C'
      '         WHERE DATADISPFINANC > '#39'20/01/2012'#39
      '           AND M.CODPORTADOR = 3'
      '           AND M.SITBLOQUEIOLANC = 1'
      '           AND M.HISTPADFINAN = 14'
      '           AND ((C.FLGSTATUS = '#39'A'#39') OR (C.FLGSTATUS is null))'
      '           AND C.CODPORTADOR = M.CODPORTADOR'
      '        UNION'
      '        SELECT '#39'J'#39' AS TIPOBLOQ,'
      '               0 CODLANCFINANC,'
      '               M.DATALANCTO DATALANC,'
      '               M.CODPORTADOR,'
      '               M.SITBLOQDESBLOQ,'
      '               M.NUMDOCUMENTO,'
      '               M.TIPOLANCTO ENTRADASAIDA,'
      '               ABS(M.VALORLANCTO) AS VALORLANCFINAN,'
      '               M.HISTORICO,'
      '               M.DATADISPONIB,'
      '               0 HISTPADFINAN,'
      '               M.IDPLANPREVCTBPATR,'
      '               M.CODCENTRORESPON,'
      '              0 IDLANCCONCILIADO,        '
      '               NULL DATADESBLOQUEIO'
      '          FROM MOVFINBLOQJUDICIAIS M'
      '         WHERE M.DATALANCTO <= '#39'20/01/2012'#39
      '           AND M.CODPORTADOR = 3'
      '           AND M.SITBLOQDESBLOQ = 1)'
      ' ORDER BY CODPORTADOR, TIPOBLOQ, DATALANC'
      ''
      ''
      ''
      ''
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ClientDataSet = CdsBloqueios
    Left = 876
    Top = 357
  end
