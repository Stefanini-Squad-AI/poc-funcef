  object SQLMovFinAConciliar: TCMSqlParams
    SQL.Strings = (
      'SELECT M.CODLANCFINANC,'
      '       M.NUMCHQBORDERO,'
      '       M.DATALANCFINAN,'
      '       M.ENTRADASAIDA,'
      '       M.HISTORICO,'
      '       M.CONCILIADO,'
      '       M.IDLANCCONCILIADO,'
      '       M.SITBLOQUEIOLANC,'
      '       M.DATADISPFINANC,'
      '       M.HISTPADFINAN,'
      '       M.DATADESBLOQUEIO,'
      
        '       DECODE(M.ENTRADASAIDA, '#39'S'#39', -M.VALORLANCFINAN, M.VALORLAN' +
        'CFINAN) AS VALORLANCFINAN'
      'FROM MOVIMFINANC M, PORTADORCONTA C'
      'WHERE ((C.FLGSTATUS = '#39'A'#39') OR (C.FLGSTATUS is null))'
      '      AND (M.DATALANCFINAN = '#39'20/01/2012'#39' )'
      '      AND (M.CODPORTADOR = 3)'
      '      AND M.CONCILIADO = '#39'N'#39
      '      AND (C.CODPORTADOR = M.CODPORTADOR)'
      'ORDER BY M.CODPORTADOR, M.DATALANCFINAN, M.CODLANCFINANC'
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ClientDataSet = CdsMovFinAConciliar
    Left = 604
    Top = 352
  end
