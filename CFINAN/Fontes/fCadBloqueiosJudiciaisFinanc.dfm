  object qryBancoFiltro: TwwQuery
    DatabaseName = 'BaseDados'
    ParamCheck = False
    SQL.Strings = (
      'SELECT B.NUMBANCO, C.NOCONTACORR, C.DESCRICAO, C.CODPORTADOR'
      'FROM BANCO B, PORTADORCONTA C'
      'WHERE B.IDPESSOA = C.IDBANCO  AND'
