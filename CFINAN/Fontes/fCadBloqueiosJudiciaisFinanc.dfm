  object updMovBloqJudAberto: TUpdateSQL
    ModifySQL.Strings = (
      'update MOVFINBLOQJUDICIAIS'
      'set'
      '  IDMOVFINBLOQJUDICIAIS = :IDMOVFINBLOQJUDICIAIS,'
      '  CODPORTADOR = :CODPORTADOR,'
      '  SITBLOQDESBLOQ = :SITBLOQDESBLOQ,'
      '  DATALANCTO = :DATALANCTO,'
      '  DATADISPONIB = :DATADISPONIB,'
      '  NUMDOCUMENTO = :NUMDOCUMENTO,'
      '  TIPOLANCTO = :TIPOLANCTO,'
      '  VALORLANCTO = :VALORLANCTO,'
      '  HISTORICO = :HISTORICO,'
      '  IDPLANPREVCTBPATR = :IDPLANPREVCTBPATR,'
      '  CODCENTRORESPON = :CODCENTRORESPON,'
      '  HISTPADFINAN = :HISTPADFINAN,'
      '  IDMOVFINBLOQJUDICIAISPAI = :IDMOVFINBLOQJUDICIAISPAI,'
      '  SITDESBLOQ = :SITDESBLOQ'
      'where'
      '  IDMOVFINBLOQJUDICIAIS = :OLD_IDMOVFINBLOQJUDICIAIS')
    InsertSQL.Strings = (
      'insert into MOVFINBLOQJUDICIAIS'
      
        '  (IDMOVFINBLOQJUDICIAIS, CODPORTADOR, SITBLOQDESBLOQ, DATALANCT' +
        'O, DATADISPONIB, '
      
        '   NUMDOCUMENTO, TIPOLANCTO, VALORLANCTO, HISTORICO, IDPLANPREVC' +
        'TBPATR, '
      
        '   CODCENTRORESPON, HISTPADFINAN, IDMOVFINBLOQJUDICIAISPAI, SITD' +
        'ESBLOQ)'
      'values'
      
        '  (:IDMOVFINBLOQJUDICIAIS, :CODPORTADOR, :SITBLOQDESBLOQ, :DATAL' +
        'ANCTO, '
      
        '   :DATADISPONIB, :NUMDOCUMENTO, :TIPOLANCTO, :VALORLANCTO, :HIS' +
        'TORICO, '
      
        '   :IDPLANPREVCTBPATR, :CODCENTRORESPON, :HISTPADFINAN, :IDMOVFI' +
        'NBLOQJUDICIAISPAI, '
      '   :SITDESBLOQ)')
    DeleteSQL.Strings = (
      'delete from MOVFINBLOQJUDICIAIS'
      'where'
      '  IDMOVFINBLOQJUDICIAIS = :OLD_IDMOVFINBLOQJUDICIAIS')
    Left = 68
    Top = 236
  end
