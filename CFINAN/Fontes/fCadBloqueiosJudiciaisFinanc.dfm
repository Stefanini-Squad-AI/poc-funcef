    SQL.Strings = (
      
        ' SELECT idmovfinbloqjudiciais, codportador, sitbloqdesbloq, DECO' +
        'DE(sitbloqdesbloq, 1, '#39'Bloqueio'#39', '#39'Desbloqueio'#39') dscSitBloqDesbl' +
