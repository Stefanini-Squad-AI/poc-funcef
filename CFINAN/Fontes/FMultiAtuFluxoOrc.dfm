  object qryCriaFluxo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'INSERT INTO FluxoOrcado FO (FO.IDPESSOA ,'
      '                            FO.DATAPROGRAMADA ,'
      '                            FO.CODTIPRECDES,'
      '                            FO.RECPAG ,'
      '                            FO.UNIDNEGOC ,'
      '                            FO.CODCENTRORESPON ,'
      '                            FO.PRAZO ,'
      '                            FO.MOECODIGO ,'
      '                            FO.VALOR ,'
      '                            FO.VALOROUTRAMOEDA ,'
      '                            FO.LOTETRANSMISSAO ,'
      '                            FO.IDEMPRESA ,'
      '                            FO.CODCENTROCUSTO ,'
      '                            FO.IDFLUXOORCADO ,'
      '                            FO.FLGSIMULAATIVO ,'
      '                            FO.IDPLANOPREV ,'
      '                            FO.IDPATRO ,'
      '                            FO.IDPROGRAMA,'
      '                            FO.CODTIPDOC)'
      ''
      '                     SELECT FOrc.IDPESSOA ,'
      '                            FOrc.DATAPROGRAMADA ,'
      '                            FOrc.CODTIPRECDES,'
      '                            FOrc.RECPAG ,'
      '                            FOrc.UNIDNEGOC ,'
      '                            FOrc.CODCENTRORESPON ,'
      '                            :FluxoDestino AS PRAZO ,'
      '                            FOrc.MOECODIGO ,'
      '                            FOrc.VALOR ,'
      '                            FOrc.VALOROUTRAMOEDA ,'
      '                            FOrc.LOTETRANSMISSAO ,'
      '                            FOrc.IDEMPRESA ,'
      '                            FOrc.CODCENTROCUSTO ,'
      
        '                            SeqFluxoOrcado.NextVal AS IDFLUXOORC' +
        'ADO ,'
      '                            FOrc.FLGSIMULAATIVO ,'
      '                            FOrc.IDPLANOPREV ,'
      '                            FOrc.IDPATRO ,'
      '                            FOrc.IDPROGRAMA,'
      '                            FOrc.CODTIPDOC'
      '                      FROM FluxoOrcado FOrc'
      '                      WHERE (FOrc.Prazo= :FluxoOrigem) AND'
      '                            (FOrc.IDPESSOA = :IDPESSOA) AND'
      
        '                            (FOrc.DataProgramada >= To_Date( :Da' +
        'taInicial, '#39'dd/mm/yyyy'#39')) AND'
      
        '                            (FOrc.DataProgramada <= To_Date( :Da' +
        'taFinal  , '#39'dd/mm/yyyy'#39'))'
      ''
      ''
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 24
    Top = 104
    ParamData = <
      item
        DataType = ftString
        Name = 'FluxoDestino'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'FluxoOrigem'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
  end
  object qryExcluiLancamentos: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'DELETE FluxoOrcado FOrc'
      'WHERE (FOrc.IDPESSOA = :IDPESSOA) AND'
      '      (FOrc.Prazo= :FluxoDestino) AND'
      
        '      (FOrc.DataProgramada >= To_Date( :DataInicial, '#39'dd/mm/yyyy' +
        #39')) AND'
      
        '      (FOrc.DataProgramada <= To_Date( :DataFinal  , '#39'dd/mm/yyyy' +
        #39'))')
    ValidateWithMask = True
    Left = 120
    Top = 104
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'FluxoDestino'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
  end
  object qryMinMax: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   Min(FOrc.DataProgramada) AS DtMenor,'
      '   Max(FOrc.DataProgramada) AS DtMaior'
      'FROM'
      '   FluxoOrcado FOrc'
      'WHERE'
      '   (FOrc.Prazo= :FluxoOrigem) AND'
      '   (FOrc.IDPESSOA = :IDPESSOA)'
      ''
      ' '
      ' ')
    ValidateWithMask = True
    Left = 144
    Top = 24
    ParamData = <
      item
        DataType = ftString
        Name = 'FluxoOrigem'
        ParamType = ptInput
      end
      item
        DataType = ftFloat
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
    object qryMinMaxDTMENOR: TDateTimeField
      FieldName = 'DTMENOR'
      Origin = 'BASEDADOS.FLUXOORCADO.DATAPROGRAMADA'
    end
    object qryMinMaxDTMAIOR: TDateTimeField
      FieldName = 'DTMAIOR'
      Origin = 'BASEDADOS.FLUXOORCADO.DATAPROGRAMADA'
    end
  end
