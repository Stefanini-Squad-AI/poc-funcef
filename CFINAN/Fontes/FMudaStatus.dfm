  object updAltStatus: TUpdateSQL
    ModifySQL.Strings = (
      'update movimfinanc'
      'set'
      '  CODLANCFINANC = :CODLANCFINANC,'
      '  STATUSCONCILIA = :STATUSCONCILIA,'
      '  DATACONCILIACAO = :DATACONCILIACAO'
