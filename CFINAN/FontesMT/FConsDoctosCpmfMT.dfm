  object QryLotes: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      ''
      'SELECT'
      '  pessoa.nome,'
      '  documento.nodocumento ,'
      '  documento.compldocumento,'
      '  documento.dataprogramada,'
      '  lanctodocum.datalancto,'
      '  lanctodocum.valor,'
      '  decode(documento.status,'#39'2'#39','#39'Baixado'#39','#39'Aberto'#39') as Status'
      ''
      'FROM'
      '  documento,lanctodocum,pessoa'
      'WHERE'
      ' 1=2 and'
      ' not exists'
      ' (select 1 from documento d,lanctodocum lan where'
      '  documento.coddocumento=lan.coddocumento and'
      ' lan.operacao='#39'4 '#39' and d.coddocumento=lan.coddocumento )'
      '')
    ValidateWithMask = True
    Left = 169
    Top = 245
