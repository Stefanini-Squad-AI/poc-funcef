  object sqlQuadro: TCMSqlParams
    SQL.Strings = (
      
        'SELECT        '#39'          '#39' AS PERIODO,        0 AS PREVISTO,    ' +
        '    '
      '0 AS REALIZADO,        0 AS PERCENTUAL, '
      '100 AS REFERENCIA   '
      '110 AS FXLIMITESUP,'
      '90 AS FXLIMITEINF'
      'FROM DUAL')
