  object qryCompara: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '       0  AS ORDEM,'
      
        '       '#39'                                                        ' +
        '    '#39' AS QUEBRA,'
      '       '#39'          '#39' AS PERIODO,'
      '       '#39'          '#39' AS BUSCA,'
      '       '#39'                    '#39' AS USUARIO,'
      
        '       '#39'                                                        ' +
        '    '#39' AS TIPORECDES,'
      '       0 AS VALOR,'
      '       0 AS GRUPODOC,'
      
        '       '#39'                                                        ' +
        '    '#39' AS DESEMBOLSO,'
      '       '#39'                    '#39' AS CODTIPRECDES,'
      '       0 AS VLRBAIXA,'
      '       '#39'                    '#39'  AS CODDOCUMENTO,      '
      
        '       '#39'                                                        ' +
        '    '#39' AS FORCLI,'
      '       0 AS VLRRATEIO'
      '  FROM DUAL'
      ' '
      ' ')
    UpdateObject = updCompara
    ValidateWithMask = True
    Left = 106
    Top = 62
  end
