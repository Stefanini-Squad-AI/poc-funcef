  object sqlSelecionados: TCMSqlParams
    SQL.Strings = (
      'SELECT D.CODDOCUMENTO,'
      '       D.NODOCUMENTO,'
      '       P.RAZAOSOCIAL,'
      '       D.DATAPROGRAMADA,'
      '       L.VALOR,'
      
        '       DECODE(D.RECPAG, '#39'P'#39', '#39'Contas a Pagar'#39', '#39'R'#39', '#39'Contas a Re' +
        'ceber'#39') ORIGEM_DOCUMENTO, '
      '       D.RECPAG'
      '  FROM CM.DOCUMENTO D'
      '  JOIN CM.PESSOA P ON P.IDPESSOA = D.IDFORCLI'
      
        '  JOIN CM.LANCTODOCUM L ON L.CODDOCUMENTO = D.CODDOCUMENTO AND L' +
        '.OPERACAO = 2'
      ' WHERE D.CODDOCUMENTO = -1')
    ClientDataSet = cdsSelecionados
    Left = 129
    Top = 431
  end
