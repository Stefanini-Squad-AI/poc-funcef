  object CmpSelLotePagto: TCmParamReport
    Caption = 'Seleção de Lotes Para Baixa Automática'
    DataBaseName = 'BaseDados'
    Params = <
      item
        Caption = 'Contas/Caixas x Forma Pagamento'
        Controle = tcLookupCombo
        TipodeDado = tdInteger
        LookupSettings.SQL.Strings = (
          'SELECT '
          '   DESCRICAO,'
          '   CODPORTFORMA, '
          '   DMAIS, '
          '   LANCAFINANC, '
          '   PLANO, '
          '   PLACONTA,  '
          '   PLACONTACONTABCHQ, '
          '   PLANOCONTABCHQ, '
          '   FLGCONTABEMISCHQ '
          'FROM '
          '   PORTADORFORMA '
          'WHERE '
          '   RECPAG = '#39'P'#39' AND '
          '   PORTADORFORMA.IDPESSOA = 1'
