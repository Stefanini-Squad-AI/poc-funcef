  object Ds: TDataSource
    DataSet = cds
    Left = 544
    Top = 72
  end
  object CMSqlParams1: TCMSqlParams
    SQL.Strings = (
      'SELECT  '#39'N'#39' AS FLGEXCLUIR, I.DATARETENCAO, I.VLRRETIDO, '
      '   D.DATAEMISSAO,  D.NODOCUMENTO, '
      '   D.DATAPROGRAMADA,              '
      '   D.STATUS, '
      
        '   T1.CODLANCFINANCS, T1.CODLANCFINANCE, T1.IDIMPOSTORETIDO, T1.' +
        'DATATRANSF, I.CODDOCLANCADO,'
      '   SAIDA.PLNCODIGO,'
      '   SAIDA.VALORLANCFINAN,'
      '   SAIDA.BAGCONTA AS CONTAORIGEM,'
      
        '   ENTRADA.BAGCONTA AS CONTADESTINO, ENTRADA.CODPORTADOR, entrad' +
        'a.CODLANCTRANSF'
      'FROM TRANSFFUNDOS T1, IMPOSTORETIDO I, DOCUMENTO D,'
      '('
      
        'SELECT TRIM(B.NUMBANCO) || '#39' - '#39' || TRIM(A.NUMAGENCIA) || '#39' - '#39' ' +
        '|| TRIM(P.NOCONTACORR) AS BAGCONTA, '
      '       T.CODLANCFINANCE,'
      '       M.PLNCODIGO,'
      '       M.VALORLANCFINAN,'
      '       M.CODPORTADOR, M.CODLANCTRANSF'
      ' '
      
        'FROM MOVIMFINANC M, TRANSFFUNDOS T, PORTADORCONTA P, AGENCIABANC' +
        'ARIA A, BANCO B'
      'WHERE M.CODLANCFINANC = T.CODLANCFINANCE AND'
      '      M.CODPORTADOR = 81 AND'
      '      P.CODPORTADOR = M.CODPORTADOR AND'
      '      A.IDPESSOA = P.IDAGENCIA AND '
      
        '      P.IDBANCO = B.IDPESSOA AND                                ' +
        '  '
      '      B.IDPESSOA = A.IDBANCO'
      ') ENTRADA,'
      '('
      
        'SELECT TRIM(B.NUMBANCO) || '#39' - '#39' || TRIM(A.NUMAGENCIA) || '#39' - '#39' ' +
        '|| TRIM(P.NOCONTACORR) AS BAGCONTA, '
      '       T.CODLANCFINANCS,'
      '       M.PLNCODIGO,'
      '       M.VALORLANCFINAN '
      
        'FROM MOVIMFINANC M, TRANSFFUNDOS T, PORTADORCONTA P, AGENCIABANC' +
        'ARIA A, BANCO B'
      'WHERE M.CODLANCFINANC = T.CODLANCFINANCS AND'
      '      M.CODPORTADOR = 40 AND'
      '      P.CODPORTADOR = M.CODPORTADOR AND'
      '      A.IDPESSOA = P.IDAGENCIA AND '
      '      P.IDBANCO = B.IDPESSOA AND '
      '      B.IDPESSOA = A.IDBANCO'
      ') SAIDA'
      'WHERE'
      '  T1.CODLANCFINANCE = ENTRADA.CODLANCFINANCE AND'
      '  T1.CODLANCFINANCS = SAIDA.CODLANCFINANCS AND'
      '  I.IDIMPOSTORETIDO = T1.IDIMPOSTORETIDO AND'
      '  I.CODDOCLANCADO = D.CODDOCUMENTO '
      '')
    ClientDataSet = cds
    Left = 472
    Top = 64
  end
