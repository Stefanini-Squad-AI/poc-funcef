  object CMSqlParams1: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT'
      '       I.IDINDICADOR,    I.DESCRICAO,     I.TIPODADO,'
      '       I.TIPOVALOR,      I.UNIDADE,       I.FLGSUBGRPAPURACAO,'
      '       I.FLGGRPAPURACAO, I.FLGCONTRATO,   I.TIPOINDICADOR,'
      '       I.PERIODICIDADE,  I.NIVELVERIFICA, I.IDREGRA,'
      '       I.QRYREGRA,       I.IDGRPPADRAO,   I.IDSUBGRPPADRAO'
      '  FROM INDINDICADOR I,'
      '       INDGRPINDICADOR GI,'
      '       INDSUBTIPOINDICADOR ST'
      ' WHERE I.IDINDICADOR = GI.IDINDICADOR(+)'
      '   AND GI.IDSUBTIPO  = ST.IDSUBTIPO(+)'
      '   AND 1=2'
      ''
      ''
      ''
      '/*'
      'SELECT IDGRPAPURACAO, DESCRICAO, TIPOGRUPO'
      '  FROM INDGRPAPURACAO'
      ' WHERE 1=2'
      '*/')
    ClientDataSet = Cds
    Left = 600
    Top = 1
  end
