  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      'SELECT AP.IDIMOVEL,'
      '       CL.NOMCONTRATO,'
      '       I.DESCRICAO AS DSC_INDICADOR,'
      '       SUM(NVL(AP.VLRAPURACAONUM,0)) AS VLRAPURACAO'
      '  FROM INDAPURACAO AP, INDCONTRATOLOJA CL, INDINDICADOR I'
      ' WHERE AP.IDIMOVEL = CL.IDIMOVEL'
      '   AND AP.IDINDICADOR = I.IDINDICADOR'
      '   AND AP.MESCOMPETENCIA = 1'
      '   AND AP.ANOCOMPETENCIA = 2002'
      '   AND AP.IDINDICADOR = 30'
      ' GROUP BY AP.IDIMOVEL, CL.NOMCONTRATO, I.DESCRICAO  '
      ' ORDER BY CL.NOMCONTRATO  ')
  end
