  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      '/* SELECT VENDAS E ALUGUÉIS por franquia */'
      ''
      'SELECT '#39'Fevereiro / 2002'#39'   AS DSC_COMPETENCIA,'
      '       IM.IMONOME,'
      '       MARCA.IDMARCA,'
      '       MARCA.MRCNOME,'
      '       MIN(M.MOESIGLA)      AS MOESIGLA,'
      '       MIN(CM.COTVALOR)     AS COTVALOR,'
      '       MIN(ABL.VLRAPURACAO) AS QTDEABL,'
      
        '       ROUND( (SUM(AM.VLRAPURACAO) / SUM(ABL.VLRAPURACAO) / MIN(' +
        'CM.COTVALOR)), 2) AS MINUPVM2,'
      
        '       ROUND( (SUM(VE.VLRAPURACAO) / SUM(ABL.VLRAPURACAO) / MIN(' +
        'CM.COTVALOR)), 2) AS VENUPVM2,'
      ''
      
        '       ROUND( (SUM(DECODE( LEAST(ROUND((VE.VLRAPURACAO - (NVL(AM' +
        '.VLRAPURACAO,0) / (AM.PERALUGVARIAVEL / 100))) * (AM.PERALUGVARI' +
        'AVEL / 100),2), 0), 0,'
      
        '                           ROUND((VE.VLRAPURACAO - (NVL(AM.VLRAP' +
        'URACAO,0) / (AM.PERALUGVARIAVEL / 100))) * (AM.PERALUGVARIAVEL /' +
        ' 100),2), 0 ) )'
      
        '               / SUM(ABL.VLRAPURACAO) / MIN(CM.COTVALOR) ), 2) A' +
        'S OVERUPVM2,'
      '       ( 0 ) AS VARMESANT,'
      '       ( 0 ) AS VARANOANT'
      ''
      '  FROM'
      '       IMOVEL IM,'
      '       MOEDA M,                                '
      '       COTACAOMOEDA CM,'
      '       ('
      '        SELECT DISTINCT CL.IDIMOVEL, M.IDMARCA, M.MRCNOME'
      '          FROM INDCONTRATOLOJA CL, MARCAS M'
      '         WHERE CL.IDMARCA = M.IDMARCA(+)'
      '--           AND CL.IDIMOVEL = 1227'
      '        ) MARCA,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDCONTRATO, CL.IDMARCA, AP.IDINDI' +
        'CADOR, SUM(AP.VLRAPURACAONUM) AS VLRAPURACAO'
      '          FROM INDAPURACAO AP, INDCONTRATOLOJA CL'
      '         WHERE AP.IDCONTRATO = CL.IDCONTRATO'
      '           AND AP.IDINDICADOR = 32                /* vendas */'
      '--           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 1'
      '           AND AP.ANOCOMPETENCIA = 2002'
      
        '         GROUP BY AP.IDIMOVEL, AP.IDCONTRATO, CL.IDMARCA, AP.IDI' +
        'NDICADOR'
      '        ) VE,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDCONTRATO, CL.IDMARCA, CL.PERALU' +
        'GVARIAVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONUM) AS VLRAPURACAO'
      '          FROM INDAPURACAO AP, INDCONTRATOLOJA CL'
      '         WHERE AP.IDCONTRATO = CL.IDCONTRATO'
      
        '           AND AP.IDINDICADOR = 33                /* aluguel mín' +
        'imo */'
      '--           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 1'
      '           AND AP.ANOCOMPETENCIA = 2002'
      
        '         GROUP BY AP.IDIMOVEL, AP.IDCONTRATO, CL.IDMARCA, CL.PER' +
        'ALUGVARIAVEL, AP.IDINDICADOR'
      '        ) AM,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, CL.IDMARCA, AP.IDINDICADOR, SUM(AP.V' +
        'LRAPURACAONUM) AS VLRAPURACAO'
      '          FROM INDAPURACAO AP,'
      '               INDCONTRATOLOJA CL'
      '         WHERE AP.IDCONTRATO  = CL.IDCONTRATO'
      '           AND AP.IDINDICADOR = 9'
      '--           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 1'
      '           AND AP.ANOCOMPETENCIA = 2002'
      '         GROUP BY AP.IDIMOVEL, CL.IDMARCA, AP.IDINDICADOR'
      '        ) ABL'
      ''
      'WHERE MARCA.IDIMOVEL  = IM.IDIMOVEL'
      '  AND M.MOECODIGO     = 6'
      '  AND CM.MOECODIGO    = M.MOECODIGO'
      '  AND CM.COTMESREF    = '#39'012002'#39
      '  AND MARCA.IDIMOVEL  = VE.IDIMOVEL(+)'
      '  AND MARCA.IDMARCA   = VE.IDMARCA(+)  '
      '  AND MARCA.IDIMOVEL  = AM.IDIMOVEL(+)'
      '  AND MARCA.IDMARCA   = AM.IDMARCA(+)  '
      '  AND MARCA.IDIMOVEL  = ABL.IDIMOVEL(+)'
      '  AND MARCA.IDMARCA   = ABL.IDMARCA(+)'
      ''
      'GROUP BY IM.IMONOME, MARCA.IDMARCA, MARCA.MRCNOME'
      ''
      'ORDER BY MRCNOME, IMONOME'
      '')
  end
