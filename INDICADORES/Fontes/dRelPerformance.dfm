  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      'SELECT IM.IMONOME,  '
      '       M.MOESIGLA,  '
      '       CM.COTVALOR, '
      
        '       LTRIM(TO_CHAR(MESES.MESCOMPETENCIA,'#39'09'#39')) || '#39'/'#39' || LTRIM' +
        '(TO_CHAR(MESES.ANOCOMPETENCIA,'#39'0999'#39')) AS DSC_MESANO, '
      '       MESES.MESCOMPETENCIA, '
      '       MESES.ANOCOMPETENCIA, '
      '       NVL(ANCABL.VLRAPURACAO,0) AS ANC_ABL, '
      '       NVL(SATABL.VLRAPURACAO,0) AS SAT_ABL, '
      '       NVL(QUIABL.VLRAPURACAO,0) AS QUI_ABL, '
      
        '       NVL(ANCABL.VLRAPURACAO,0)+NVL(SATABL.VLRAPURACAO,0)+NVL(Q' +
        'UIABL.VLRAPURACAO,0) AS TOT_ABL,   '
      '       DECODE( NVL(CM.COTVALOR,0), 0 , 0, '
      '               DECODE( NVL(ANCABL.VLRAPURACAO,0), 0, 0, '
      
        '                       ROUND(NVL(ANCVENDA.VLRAPURACAO,0) / ANCAB' +
        'L.VLRAPURACAO / CM.COTVALOR, 2) ) ) AS ANC_VENDAM2, '
      '       DECODE( NVL(CM.COTVALOR,0), 0 , 0, '
      '               DECODE( NVL(SATABL.VLRAPURACAO,0), 0, 0, '
      
        '                       ROUND(NVL(SATVENDA.VLRAPURACAO,0) / SATAB' +
        'L.VLRAPURACAO / CM.COTVALOR, 2) ) ) AS SAT_VENDAM2, '
      '       DECODE( NVL(CM.COTVALOR,0), 0 , 0, '
      '               DECODE( NVL(QUIABL.VLRAPURACAO,0), 0, 0, '
      
        '                       ROUND(NVL(QUIVENDA.VLRAPURACAO,0) / QUIAB' +
        'L.VLRAPURACAO / CM.COTVALOR, 2) ) ) AS QUI_VENDAM2, '
      '       DECODE( NVL(CM.COTVALOR,0), 0 , 0, '
      
        '               DECODE( NVL(ANCABL.VLRAPURACAO,0)+NVL(SATABL.VLRA' +
        'PURACAO,0)+NVL(QUIABL.VLRAPURACAO,0), 0, 0, '
      
        '                       ROUND((NVL(ANCVENDA.VLRAPURACAO,0)+NVL(SA' +
        'TVENDA.VLRAPURACAO,0)+NVL(QUIVENDA.VLRAPURACAO,0)) / '
      
        '                             (NVL(ANCABL.VLRAPURACAO,0)+NVL(SATA' +
        'BL.VLRAPURACAO,0)+NVL(QUIABL.VLRAPURACAO,0)) / CM.COTVALOR, 2) )' +
        ' ) AS TOT_VENDAM2, '
      '       DECODE( NVL(CM.COTVALOR,0), 0 , 0, '
      
        '               DECODE( NVL(ANCABL.VLRAPURACAO,0)+NVL(SATABL.VLRA' +
        'PURACAO,0)+NVL(QUIABL.VLRAPURACAO,0), 0, 0, '
      '                       ROUND((NVL(AMIN.VLRAPURACAO,0)) / '
      
        '                             (NVL(ANCABL.VLRAPURACAO,0)+NVL(SATA' +
        'BL.VLRAPURACAO,0)+NVL(QUIABL.VLRAPURACAO,0)) / CM.COTVALOR, 2) )' +
        ' ) AS TOT_AMINM2, '
      '       DECODE( NVL(CM.COTVALOR,0), 0 , 0, '
      
        '               DECODE( NVL(ANCABL.VLRAPURACAO,0)+NVL(SATABL.VLRA' +
        'PURACAO,0)+NVL(QUIABL.VLRAPURACAO,0), 0, 0, '
      
        '                       ROUND((NVL(AMIN.VLRAPURACAO,0)+NVL(OVER.V' +
        'LRAPURACAO,0)) / '
      
        '                             (NVL(ANCABL.VLRAPURACAO,0)+NVL(SATA' +
        'BL.VLRAPURACAO,0)+NVL(QUIABL.VLRAPURACAO,0)) / CM.COTVALOR, 2) )' +
        ' ) AS TOT_ALUGM2, '
      '       ( 0 ) AS ANC_VARMESANT, '
      '       ( 0 ) AS ANC_VARANOANT, '
      '       ( 0 ) AS SAT_VARMESANT, '
      '       ( 0 ) AS SAT_VARANOANT, '
      '       ( 0 ) AS QUI_VARMESANT, '
      '       ( 0 ) AS QUI_VARANOANT  '
      '  FROM IMOVEL IM, '
      '       MOEDA M, '
      '       COTACAOMOEDA CM, '
      '      ( '
      
        '        SELECT DISTINCT IDIMOVEL, MESCOMPETENCIA, ANOCOMPETENCIA' +
        ' '
      '          FROM INDAPURACAO '
      '         WHERE 1=1 '
      
        '           AND LTRIM(TO_CHAR(ANOCOMPETENCIA,'#39'0999'#39')) || LTRIM(TO' +
        '_CHAR(MESCOMPETENCIA,'#39'09'#39')) BETWEEN '#39'200201'#39' AND '#39'200207'#39
      '           AND IDIMOVEL = 1227'
      '       ) MESES, '
      '      ( '
      
        '        SELECT A.IDIMOVEL, A.MESCOMPETENCIA, A.ANOCOMPETENCIA, S' +
        'UM(A.VLRAPURACAONUM) AS VLRAPURACAO '
      '          FROM INDAPURACAO A, '
      '               INDCONTRATOLOJA CL '
      '         WHERE A.IDCONTRATO = CL.IDCONTRATO '
      '           AND CL.TIPOCONTRATO = '#39'A'#39' '
      '           AND A.IDINDICADOR = 9'
      
        '           AND LTRIM(TO_CHAR(A.ANOCOMPETENCIA,'#39'0999'#39')) || LTRIM(' +
        'TO_CHAR(A.MESCOMPETENCIA,'#39'09'#39')) BETWEEN '#39'200201'#39' AND '#39'200207'#39
      '           AND A.IDIMOVEL = 1227'
      '         GROUP BY A.IDIMOVEL,A.MESCOMPETENCIA,A.ANOCOMPETENCIA '
      '       ) ANCABL, '
      '       ( '
      
        '        SELECT A.IDIMOVEL, A.MESCOMPETENCIA, A.ANOCOMPETENCIA, S' +
        'UM(A.VLRAPURACAONUM) AS VLRAPURACAO '
      '          FROM INDAPURACAO A, '
      '               INDCONTRATOLOJA CL '
      '         WHERE A.IDCONTRATO = CL.IDCONTRATO '
      '           AND CL.TIPOCONTRATO = '#39'A'#39' '
      '           AND A.IDINDICADOR = 32'
      
        '           AND LTRIM(TO_CHAR(A.ANOCOMPETENCIA,'#39'0999'#39')) || LTRIM(' +
        'TO_CHAR(A.MESCOMPETENCIA,'#39'09'#39')) BETWEEN '#39'200201'#39' AND '#39'200207'#39
      '           AND A.IDIMOVEL = 1227'
      '         GROUP BY A.IDIMOVEL,A.MESCOMPETENCIA,A.ANOCOMPETENCIA '
      '       ) ANCVENDA, '
      '      ( '
      
        '        SELECT A.IDIMOVEL, A.MESCOMPETENCIA, A.ANOCOMPETENCIA, S' +
        'UM(A.VLRAPURACAONUM) AS VLRAPURACAO '
      '          FROM INDAPURACAO A, '
      '               INDCONTRATOLOJA CL '
      '         WHERE A.IDCONTRATO = CL.IDCONTRATO '
      '           AND CL.TIPOCONTRATO = '#39'S'#39' '
      '           AND A.IDINDICADOR = 9'
      
        '           AND LTRIM(TO_CHAR(A.ANOCOMPETENCIA,'#39'0999'#39')) || LTRIM(' +
        'TO_CHAR(A.MESCOMPETENCIA,'#39'09'#39')) BETWEEN '#39'200201'#39' AND '#39'200207'#39
      '           AND A.IDIMOVEL = 1227'
      '         GROUP BY A.IDIMOVEL,A.MESCOMPETENCIA,A.ANOCOMPETENCIA '
      '       ) SATABL, '
      '       ( '
      
        '        SELECT A.IDIMOVEL, A.MESCOMPETENCIA, A.ANOCOMPETENCIA, S' +
        'UM(A.VLRAPURACAONUM) AS VLRAPURACAO '
      '          FROM INDAPURACAO A, '
      '               INDCONTRATOLOJA CL '
      '         WHERE A.IDCONTRATO = CL.IDCONTRATO '
      '           AND CL.TIPOCONTRATO = '#39'S'#39' '
      '           AND A.IDINDICADOR = 32'
      
        '           AND LTRIM(TO_CHAR(A.ANOCOMPETENCIA,'#39'0999'#39')) || LTRIM(' +
        'TO_CHAR(A.MESCOMPETENCIA,'#39'09'#39')) BETWEEN '#39'200201'#39' AND '#39'200207'#39
      '           AND A.IDIMOVEL = 1227'
      '         GROUP BY A.IDIMOVEL,A.MESCOMPETENCIA,A.ANOCOMPETENCIA '
      '       ) SATVENDA, '
      '      ( '
      
        '        SELECT A.IDIMOVEL, A.MESCOMPETENCIA, A.ANOCOMPETENCIA, S' +
        'UM(A.VLRAPURACAONUM) AS VLRAPURACAO '
      '          FROM INDAPURACAO A, '
      '               INDCONTRATOLOJA CL '
      '         WHERE A.IDCONTRATO = CL.IDCONTRATO '
      '           AND CL.TIPOCONTRATO = '#39'Q'#39' '
      '           AND A.IDINDICADOR = 9'
      
        '           AND LTRIM(TO_CHAR(A.ANOCOMPETENCIA,'#39'0999'#39')) || LTRIM(' +
        'TO_CHAR(A.MESCOMPETENCIA,'#39'09'#39')) BETWEEN '#39'200201'#39' AND '#39'200207'#39
      '           AND A.IDIMOVEL = 1227'
      '         GROUP BY A.IDIMOVEL,A.MESCOMPETENCIA,A.ANOCOMPETENCIA '
      '       ) QUIABL, '
      '       ( '
      
        '        SELECT A.IDIMOVEL, A.MESCOMPETENCIA, A.ANOCOMPETENCIA, S' +
        'UM(A.VLRAPURACAONUM) AS VLRAPURACAO '
      '          FROM INDAPURACAO A, '
      '               INDCONTRATOLOJA CL '
      '         WHERE A.IDCONTRATO = CL.IDCONTRATO '
      '           AND CL.TIPOCONTRATO = '#39'Q'#39' '
      '           AND A.IDINDICADOR = 32'
      
        '           AND LTRIM(TO_CHAR(A.ANOCOMPETENCIA,'#39'0999'#39')) || LTRIM(' +
        'TO_CHAR(A.MESCOMPETENCIA,'#39'09'#39')) BETWEEN '#39'200201'#39' AND '#39'200207'#39
      '           AND A.IDIMOVEL = 1227'
      '         GROUP BY A.IDIMOVEL,A.MESCOMPETENCIA,A.ANOCOMPETENCIA '
      '       ) QUIVENDA, '
      '       ( '
      
        '        SELECT A.IDIMOVEL, A.MESCOMPETENCIA, A.ANOCOMPETENCIA, S' +
        'UM(A.VLRAPURACAONUM) AS VLRAPURACAO '
      '          FROM INDAPURACAO A, '
      '               INDCONTRATOLOJA CL '
      '         WHERE A.IDCONTRATO = CL.IDCONTRATO '
      '           AND A.IDINDICADOR = 33'
      '         GROUP BY A.IDIMOVEL,A.MESCOMPETENCIA,A.ANOCOMPETENCIA '
      '       ) AMIN, '
      '       ( '
      
        '        SELECT A.IDIMOVEL, A.MESCOMPETENCIA, A.ANOCOMPETENCIA, S' +
        'UM(A.VLRAPURACAONUM) AS VLRAPURACAO '
      '          FROM INDAPURACAO A, '
      '               INDCONTRATOLOJA CL '
      '         WHERE A.IDCONTRATO = CL.IDCONTRATO '
      '           AND A.IDINDICADOR = 29'
      '         GROUP BY A.IDIMOVEL,A.MESCOMPETENCIA,A.ANOCOMPETENCIA '
      '       ) OVER '
      ' WHERE M.MOECODIGO          = 143'
      '   AND CM.MOECODIGO(+)      = 143'
      
        '   AND CM.COTMESREF(+)      = (LTRIM(TO_CHAR(MESES.MESCOMPETENCI' +
        'A,'#39'09'#39')) || LTRIM(TO_CHAR(MESES.ANOCOMPETENCIA,'#39'0999'#39'))) '
      '   AND MESES.IDIMOVEL       = IM.IDIMOVEL                '
      '   AND MESES.IDIMOVEL       = ANCABL.IDIMOVEL(+)         '
      '   AND MESES.MESCOMPETENCIA = ANCABL.MESCOMPETENCIA(+)   '
      '   AND MESES.ANOCOMPETENCIA = ANCABL.ANOCOMPETENCIA(+)   '
      '   AND MESES.IDIMOVEL       = ANCVENDA.IDIMOVEL(+)       '
      '   AND MESES.MESCOMPETENCIA = ANCVENDA.MESCOMPETENCIA(+) '
      '   AND MESES.ANOCOMPETENCIA = ANCVENDA.ANOCOMPETENCIA(+) '
      '   AND MESES.IDIMOVEL       = SATABL.IDIMOVEL(+)         '
      '   AND MESES.MESCOMPETENCIA = SATABL.MESCOMPETENCIA(+)   '
      '   AND MESES.ANOCOMPETENCIA = SATABL.ANOCOMPETENCIA(+)   '
      '   AND MESES.IDIMOVEL       = SATVENDA.IDIMOVEL(+)       '
      '   AND MESES.MESCOMPETENCIA = SATVENDA.MESCOMPETENCIA(+) '
      '   AND MESES.ANOCOMPETENCIA = SATVENDA.ANOCOMPETENCIA(+) '
      '   AND MESES.IDIMOVEL       = QUIABL.IDIMOVEL(+)         '
      '   AND MESES.MESCOMPETENCIA = QUIABL.MESCOMPETENCIA(+)   '
      '   AND MESES.ANOCOMPETENCIA = QUIABL.ANOCOMPETENCIA(+)   '
      '   AND MESES.IDIMOVEL       = QUIVENDA.IDIMOVEL(+)       '
      '   AND MESES.MESCOMPETENCIA = QUIVENDA.MESCOMPETENCIA(+) '
      '   AND MESES.ANOCOMPETENCIA = QUIVENDA.ANOCOMPETENCIA(+) '
      '   AND MESES.IDIMOVEL       = AMIN.IDIMOVEL(+)           '
      '   AND MESES.MESCOMPETENCIA = AMIN.MESCOMPETENCIA(+)     '
      '   AND MESES.ANOCOMPETENCIA = AMIN.ANOCOMPETENCIA(+)     '
      '   AND MESES.IDIMOVEL       = OVER.IDIMOVEL(+)           '
      '   AND MESES.MESCOMPETENCIA = OVER.MESCOMPETENCIA(+)   '
      '   AND MESES.ANOCOMPETENCIA = OVER.ANOCOMPETENCIA(+)   '
      ''
      
        '  ORDER BY IM.IMONOME, MESES.ANOCOMPETENCIA DESC, MESES.MESCOMPE' +
        'TENCIA DESC'
      '')
  end
