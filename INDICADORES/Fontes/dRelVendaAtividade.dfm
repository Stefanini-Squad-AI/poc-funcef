  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      '/* SELECT VENDAS E ALUGUÉIS */'
      ''
      'SELECT '#39'Fevereiro / 2002'#39'   AS DSC_COMPETENCIA,'
      '       IM.IMONOME,'
      '       ATIV.IDATIVIDADE,'
      '       ATIV.ATVDESCRICAO,'
      '       MIN(M.MOESIGLA)      AS MOESIGLA,'
      '       MIN(CM.COTVALOR)     AS COTVALOR,'
      '       MIN(ABL.VLRAPURACAO) AS QTDEABL,'
      
        '       ROUND( (SUM(AM.VLRAPURACAO) / SUM(ABL.VLRAPURACAO) / MIN(' +
        'CM.COTVALOR)), 2) AS MINUPVM2,'
      
        '       ROUND( (SUM(VE.VLRAPURACAO) / SUM(ABL.VLRAPURACAO) / MIN(' +
        'CM.COTVALOR)), 2) AS VENUPVM2,'
      ''
      
        '       ROUND( (SUM(DECODE( LEAST(ROUND((VE.VLRAPURACAO - (NVL(AM' +
        '.VLRAPURACAO,0) / (AM.PERALUGVARIAVEL / 100))) * (AM.PERALUGVARI' +
        'AVEL / 100),2), 0), 0,'
      
        '                           ROUND((VE.VLRAPURACAO - (NVL(AM.VLRAP' +
        'URACAO,0) / (AM.PERALUGVARIAVEL / 100))) * (AM.PERALUGVARIAVEL /' +
        ' 100),2), 0 ) )'
      
        '               / SUM(ABL.VLRAPURACAO) / MIN(CM.COTVALOR) ), 2) A' +
        'S OVERUPVM2,'
      '       ( 0 ) AS VARMESANT,'
      '       ( 0 ) AS VARANOANT'
      ''
      '  FROM'
      '       IMOVEL IM,'
      '       MOEDA M,'
      '       COTACAOMOEDA CM,'
      '       ('
      
        '        SELECT DISTINCT CL.IDIMOVEL, A.IDATIVIDADE, A.ATVDESCRIC' +
        'AO'
      '          FROM INDCONTRATOLOJA CL, ATIVIDADE A'
      '         WHERE CL.IDATIVIDADE = A.IDATIVIDADE(+)'
      '--           AND CL.IDIMOVEL = 1227'
      '        ) ATIV,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDCONTRATO, CL.IDATIVIDADE, AP.ID' +
        'INDICADOR, SUM(AP.VLRAPURACAONUM) AS VLRAPURACAO'
      '          FROM INDAPURACAO AP, INDCONTRATOLOJA CL'
      '         WHERE AP.IDCONTRATO = CL.IDCONTRATO'
      '           AND AP.IDINDICADOR = 32                /* vendas */'
      '--           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 1'
      '           AND AP.ANOCOMPETENCIA = 2002'
      
        '         GROUP BY AP.IDIMOVEL, AP.IDCONTRATO, CL.IDATIVIDADE, AP' +
        '.IDINDICADOR'
      '        ) VE,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDCONTRATO, CL.IDATIVIDADE, CL.PE' +
        'RALUGVARIAVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONUM) AS VLRAPUR' +
        'ACAO'
      '          FROM INDAPURACAO AP, INDCONTRATOLOJA CL'
      '         WHERE AP.IDCONTRATO = CL.IDCONTRATO'
      
        '           AND AP.IDINDICADOR = 33                /* aluguel mín' +
        'imo */'
      '--           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 1'
      '           AND AP.ANOCOMPETENCIA = 2002'
      
        '         GROUP BY AP.IDIMOVEL, AP.IDCONTRATO, CL.IDATIVIDADE, CL' +
        '.PERALUGVARIAVEL, AP.IDINDICADOR'
      '        ) AM,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, CL.IDATIVIDADE, AP.IDINDICADOR, SUM(' +
        'AP.VLRAPURACAONUM) AS VLRAPURACAO'
      '          FROM INDAPURACAO AP,'
      '               INDCONTRATOLOJA CL'
      '         WHERE AP.IDCONTRATO  = CL.IDCONTRATO'
      '           AND AP.IDINDICADOR = 9'
      '--           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 1'
      '           AND AP.ANOCOMPETENCIA = 2002'
      '         GROUP BY AP.IDIMOVEL, CL.IDATIVIDADE, AP.IDINDICADOR'
      '        ) ABL'
      ''
      'WHERE ATIV.IDIMOVEL    = IM.IDIMOVEL'
      '  AND M.MOECODIGO      = 34'
      '  AND CM.MOECODIGO     = M.MOECODIGO'
      '  AND CM.COTMESREF     = '#39'012002'#39
      '  AND ATIV.IDIMOVEL    = VE.IDIMOVEL(+)'
      '  AND ATIV.IDIMOVEL    = AM.IDIMOVEL(+)'
      '  AND ATIV.IDIMOVEL    = ABL.IDIMOVEL(+)'
      '  AND ATIV.IDATIVIDADE = ABL.IDATIVIDADE(+)'
      ''
      'GROUP BY IM.IMONOME, ATIV.IDATIVIDADE, ATIV.ATVDESCRICAO'
      ''
      'ORDER BY IMONOME, ATVDESCRICAO'
      ' '
      ' ')
    ClientDataSet = nil
  end
