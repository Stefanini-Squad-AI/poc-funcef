  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      '/* SELECT ENERGIA NUMÉRICO */'
      ''
      'SELECT 2001 AS ANOREF,'
      '       IM.IDIMOVEL,'
      '       IM.IMONOME,'
      '       IND.DSC_INDICADOR,'
      '       IND.UNIDADE,'
      '       IND.ORDEM,'
      '       NVL(AP01.VLRAPURACAONUM,0) AS VLRJAN,'
      '       NVL(AP02.VLRAPURACAONUM,0) AS VLRFEV,'
      '       NVL(AP03.VLRAPURACAONUM,0) AS VLRMAR,'
      '       NVL(AP04.VLRAPURACAONUM,0) AS VLRABR,'
      '       NVL(AP05.VLRAPURACAONUM,0) AS VLRMAI,'
      '       NVL(AP06.VLRAPURACAONUM,0) AS VLRJUN,'
      '       NVL(AP07.VLRAPURACAONUM,0) AS VLRJUL,'
      '       NVL(AP08.VLRAPURACAONUM,0) AS VLRAGO,'
      '       NVL(AP09.VLRAPURACAONUM,0) AS VLRSET,'
      '       NVL(AP10.VLRAPURACAONUM,0) AS VLROUT,'
      '       NVL(AP11.VLRAPURACAONUM,0) AS VLRNOV,'
      '       NVL(AP12.VLRAPURACAONUM,0) AS VLRDEZ'
      ''
      '  FROM'
      '       IMOVEL IM,'
      '       ('
      
        '        SELECT I.IDINDICADOR, I.DESCRICAO AS DSC_INDICADOR, I.UN' +
        'IDADE, GI.ORDEM'
      '          FROM INDGRPINDICADOR GI,'
      '               INDINDICADOR I'
      '         WHERE GI.IDSUBTIPO = 12'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND GI.IDINDICADOR = I.IDINDICADOR'
      '        ) IND,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 1'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP01,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 2'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP02,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 3'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '       ) AP03,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 4'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP04,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 5'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP05,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 6'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP06,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 7'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP07,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 8'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP08,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 9'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP09,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 10'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP10,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 11'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP11,'
      '       ('
      
        '        SELECT AP.IDIMOVEL, AP.IDINDICADOR, SUM(AP.VLRAPURACAONU' +
        'M) AS VLRAPURACAONUM'
      '          FROM INDAPURACAO AP,'
      '               INDINDICADOR I          '
      '         WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '           AND I.TIPODADO = '#39'N'#39
      '           AND AP.IDIMOVEL = 1227'
      '           AND AP.MESCOMPETENCIA = 12'
      '           AND AP.ANOCOMPETENCIA = 2001'
      '        GROUP BY AP.IDIMOVEL, AP.IDINDICADOR'
      '        ) AP12'
      ''
      ' WHERE IND.IDINDICADOR = AP01.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP02.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP03.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP04.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP05.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP06.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP07.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP08.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP09.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP10.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP11.IDINDICADOR(+)'
      '   AND IND.IDINDICADOR = AP12.IDINDICADOR(+)'
      
        '   AND (IM.IDIMOVEL = AP01.IDIMOVEL OR IM.IDIMOVEL = AP02.IDIMOV' +
        'EL OR'
      
        '        IM.IDIMOVEL = AP03.IDIMOVEL OR IM.IDIMOVEL = AP04.IDIMOV' +
        'EL OR'
      
        '        IM.IDIMOVEL = AP05.IDIMOVEL OR IM.IDIMOVEL = AP06.IDIMOV' +
        'EL OR'
      
        '        IM.IDIMOVEL = AP07.IDIMOVEL OR IM.IDIMOVEL = AP08.IDIMOV' +
        'EL OR'
      
        '        IM.IDIMOVEL = AP09.IDIMOVEL OR IM.IDIMOVEL = AP10.IDIMOV' +
        'EL OR'
      
        '        IM.IDIMOVEL = AP11.IDIMOVEL OR IM.IDIMOVEL = AP12.IDIMOV' +
        'EL)'
      ''
      'ORDER BY IMONOME, ORDEM'
      ''
      ' ')
    ClientDataSet = nil
  end
