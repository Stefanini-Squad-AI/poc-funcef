  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      '/* SELECT LOJAS LIVRES */'
      ''
      'SELECT '#39'Fevereiro / 2002'#39' AS DSC_COMPETENCIA,'
      '       IM.IMONOME,'
      '       L.NUMLOJA,'
      '       L.PISO,'
      '       L.QTDEABL,'
      '       VLR_DESPM2,'
      '       (L.QTDEABL * VLR_DESPM2) AS VLR_ENCARGOS'
      '  FROM INDLOJA L,'
      '       IMOVEL IM,'
      '       ('
      
        '        SELECT DES.IDIMOVEL, (DES.TOT_DESPESAS / ABL.VLRABL) AS ' +
        'VLR_DESPM2'
      '          FROM ('
      
        '                SELECT AP.IDIMOVEL, SUM(AP.VLRAPURACAONUM) AS VL' +
        'RABL'
      '                  FROM INDAPURACAO AP'
      '                 WHERE AP.IDINDICADOR    = 9'
      '                   AND AP.IDIMOVEL       = 1227'
      '                   AND AP.MESCOMPETENCIA = 1'
      '                   AND AP.ANOCOMPETENCIA = 2001'
      '                 GROUP BY AP.IDIMOVEL'
      '                ) ABL,'
      '               ('
      
        '                SELECT IDIMOVEL, SUM(AP.VLRAPURACAONUM) AS TOT_D' +
        'ESPESAS'
      '                  FROM INDINDICADOR I,'
      '                       INDGRPINDICADOR GI,'
      '                       INDSUBTIPOINDICADOR ST,'
      '                       INDAPURACAO AP'
      '                 WHERE AP.IDINDICADOR = I.IDINDICADOR'
      '                   AND GI.IDINDICADOR = I.IDINDICADOR'
      '                   AND GI.IDSUBTIPO   = ST.IDSUBTIPO'
      '                   AND I.TIPOVALOR  = '#39'D'#39
      '                   AND AP.TIPOLANCA = '#39'R'#39
      '                   AND GI.TIPOLANCA = '#39'R'#39
      '                   AND ST.IDREPORTS = 3435'
      '                   AND AP.IDIMOVEL       = 1227'
      '                   AND AP.MESCOMPETENCIA = 1'
      '                   AND AP.ANOCOMPETENCIA = 2001'
      '                 GROUP BY IDIMOVEL'
      '               ) DES'
      '         WHERE DES.IDIMOVEL = ABL.IDIMOVEL'
      '       ) DESPM2'
      ''
      ' WHERE L.IDIMOVEL = 1227'
      '   AND L.IDIMOVEL = IM.IDIMOVEL'
      '   AND L.IDIMOVEL = DESPM2.IDIMOVEL'
      '   AND L.IDLOJA NOT IN ( SELECT CXL.IDLOJA'
      '                           FROM INDCONTRATOLOJA CL,'
      '                                INDCONTRATOXLOJA CXL'
      '                          WHERE CL.IDCONTRATO = CXL.IDCONTRATO'
      
        '                            AND (     (CL.DATINICIO <= TO_DATE('#39 +
        '01/01/2002'#39') AND CL.DATTERMINO >= TO_DATE('#39'31/01/2002'#39'))'
      
        '                                   OR (CL.DATINICIO >= TO_DATE('#39 +
        '01/01/2002'#39') AND CL.FLGINDETERMINADO = '#39'S'#39')  )'
      '                          )'
      ''
      'ORDER BY IMONOME, NUMLOJA, PISO'
      '')
    ClientDataSet = nil
  end
