  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      '/* SELECT VENDAS E ALUGUÉIS */'
      ''
      'SELECT '#39'Fevereiro / 2002'#39' AS DSC_COMPETENCIA,'
      '       IM.IMONOME,'
      '       CL.LOJAS,'
      '       CL.NOMCONTRATO,'
      '       CL.DATULTAUDITORIA,'
      '       M.MOESIGLA,'
      '       CM.COTVALOR,'
      '       AM.VLRAPURACAO AS VLRALUGMIN,'
      '       CL.PERALUGVARIAVEL,'
      '       ABL.VLRAPURACAO AS QTDEABL,'
      
        '       ROUND( (VE.VLRAPURACAO / ABL.VLRAPURACAO / CM.COTVALOR), ' +
        '2) AS VENUPVM2,'
      
        '       ROUND( (VE.VLRAPURACAO / (AM.VLRAPURACAO / (CL.PERALUGVAR' +
        'IAVEL / 100)) * 100),0 ) AS PTOEQUILIBRIO,'
      ''
      '       ROUND( ((NVL(AM.VLRAPURACAO,0) +'
      
        '                DECODE( LEAST(ROUND((VE.VLRAPURACAO - (NVL(AM.VL' +
        'RAPURACAO,0) / (CL.PERALUGVARIAVEL / 100))) * (CL.PERALUGVARIAVE' +
        'L / 100),2), 0), 0,'
      
        '                        ROUND((VE.VLRAPURACAO - (NVL(AM.VLRAPURA' +
        'CAO,0) / (CL.PERALUGVARIAVEL / 100))) * (CL.PERALUGVARIAVEL / 10' +
        '0),2), 0 ) )'
      
        '                / ABL.VLRAPURACAO / CM.COTVALOR), 2) AS ALUGUPVM' +
        '2,'
      '                  '
      '       (0) AS RANKVEND,'
      '       (0) AS RANKALUG,'
      '       (0) AS RANKPTO,'
      '       (0) AS RANKCO                    '
      ''
      '  FROM'
      '       IMOVEL IM,'
      '       MOEDA M,'
      '       COTACAOMOEDA CM,'
      '       ('
      '        SELECT CL.*'
      '          FROM INDCONTRATOLOJA CL'
      '         WHERE CL.DATINICIO  <= TO_DATE('#39'01/01/2002'#39')'
      
        '           AND CL.DATTERMINO >= TO_DATE('#39'31/01/2002'#39') OR CL.DATT' +
        'ERMINO IS NULL'
      '        ) CL,'
      '       ('
      
        '        SELECT AP.IDCONTRATO, AP.IDINDICADOR, SUM(AP.VLRAPURACAO' +
        'NUM) AS VLRAPURACAO'
      '          FROM INDAPURACAO AP'
      '         WHERE AP.IDINDICADOR = 32'
      '           AND AP.MESCOMPETENCIA = 1'
      '           AND AP.ANOCOMPETENCIA = 2002'
      '         GROUP BY AP.IDCONTRATO, AP.IDINDICADOR'
      '        ) VE,'
      '       ('
      
        '        SELECT AP.IDCONTRATO, AP.IDINDICADOR, SUM(AP.VLRAPURACAO' +
        'NUM) AS VLRAPURACAO'
      '          FROM INDAPURACAO AP'
      '         WHERE AP.IDINDICADOR = 33'
      '           AND AP.MESCOMPETENCIA = 1'
      '           AND AP.ANOCOMPETENCIA = 2002'
      '         GROUP BY AP.IDCONTRATO, AP.IDINDICADOR'
      '        ) AM,'
      '       ('
      
        '        SELECT AP.IDCONTRATO, AP.IDINDICADOR, SUM(AP.VLRAPURACAO' +
        'NUM) AS VLRAPURACAO'
      '          FROM INDAPURACAO AP'
      '         WHERE AP.IDINDICADOR = 9'
      '           AND AP.MESCOMPETENCIA = 1'
      '           AND AP.ANOCOMPETENCIA = 2002'
      '         GROUP BY AP.IDCONTRATO, AP.IDINDICADOR'
      '        ) ABL'
      ''
      'WHERE CL.IDIMOVEL = IM.IDIMOVEL'
      '  AND M.MOECODIGO   = 34'
      '  AND CM.MOECODIGO  = M.MOECODIGO'
      '  AND CM.COTMESREF  = '#39'012002'#39
      '  AND CL.IDCONTRATO = VE.IDCONTRATO(+)'
      '  AND CL.IDCONTRATO = AM.IDCONTRATO(+)'
      '  AND CL.IDCONTRATO = ABL.IDCONTRATO(+)'
      ''
      'ORDER BY IMONOME, NOMCONTRATO')
    ClientDataSet = nil
  end
  object ppRanking: TppReport
    AutoStop = False
    DataPipeline = ppl
    PrinterSetup.BinName = 'Default'
    PrinterSetup.DocumentName = 'Report'
