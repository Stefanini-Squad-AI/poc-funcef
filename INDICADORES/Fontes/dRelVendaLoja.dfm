  object CMspLojasVagas: TCMSqlParams
    SQL.Strings = (
      '/* SELECT TOTAL DE LOJAS VAGAS */'
      ''
      'SELECT IM.IMONOME,'
      '       COUNT(*)     AS QTDELOJASVAGAS,'
      '       SUM(QTDEABL) AS QTDEABLVAGAS'
      '  FROM INDLOJA L,'
      '       IMOVEL IM'
      ' WHERE /* L.IDIMOVEL = 1227'
      '   AND */ L.IDIMOVEL = IM.IDIMOVEL'
      '   AND L.IDLOJA NOT IN ( SELECT CXL.IDLOJA'
      '                           FROM INDCONTRATOLOJA CL,'
      '                                INDCONTRATOXLOJA CXL'
      '                          WHERE CL.IDCONTRATO = CXL.IDCONTRATO'
      
        '                            AND ( (CL.DATINICIO <= TO_DATE('#39'01/0' +
        '1/2002'#39') AND CL.DATTERMINO >= TO_DATE('#39'31/01/2002'#39'))'
      '                                   OR CL.DATTERMINO IS NULL )'
      '                          )'
      'GROUP BY IM.IMONOME'
      ''
      ''
      '')
    Left = 349
    Top = 8
  end
