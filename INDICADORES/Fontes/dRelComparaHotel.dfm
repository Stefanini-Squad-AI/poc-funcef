  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      'SELECT I.IDINDICADOR, '
      '       GI.ORDEM,'
      '       I.DESCRICAO  AS DSC_INDICADOR, '
      
        '       DECODE(I.TIPOVALOR,'#39'R'#39','#39'RECEITAS'#39','#39'D'#39','#39'DESPESAS'#39','#39'DESEMPE' +
        'NHO'#39') AS DSC_TIPOVALOR, '
      '       NVL(AP01.VLRAPURACAONUM,0)  AS VLR01, '
      '       NVL(AP02.VLRAPURACAONUM,0)  AS VLR02, '
      '       NVL(AP03.VLRAPURACAONUM,0)  AS VLR03, '
      '       NVL(AP04.VLRAPURACAONUM,0)  AS VLR04, '
      '       NVL(AP05.VLRAPURACAONUM,0)  AS VLR05, '
      
        '       NVL(AP06.VLRAPURACAONUM,0)  AS VLR06,                    ' +
        '                '
      '       NVL(AP07.VLRAPURACAONUM,0)  AS VLR07'
      '       '
      'FROM '
      '       INDINDICADOR I, '
      '       INDGRPINDICADOR GI,'
      '       INDSUBTIPOINDICADOR ST,'
      '       ( '
      
        '        SELECT IDIMOVEL, IDINDICADOR, NVL(IDGRPAPURACAO,0) AS ID' +
        'GRPAPURACAO, SUM(NVL(VLRAPURACAONUM,0)) AS VLRAPURACAONUM '
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 1 '
      '           AND ANOCOMPETENCIA = 2002'
      '           AND IDIMOVEL = 1234'
      '         GROUP BY IDIMOVEL, IDINDICADOR, IDGRPAPURACAO '
      '        ) AP01, '
      '       ( '
      
        '        SELECT IDIMOVEL, IDINDICADOR, NVL(IDGRPAPURACAO,0) AS ID' +
        'GRPAPURACAO, SUM(NVL(VLRAPURACAONUM,0)) AS VLRAPURACAONUM '
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 1 '
      '           AND ANOCOMPETENCIA = 2002'
      '           AND IDIMOVEL = 677'
      '         GROUP BY IDIMOVEL, IDINDICADOR, IDGRPAPURACAO '
      '       ) AP02, '
      '       ( '
      
        '        SELECT IDIMOVEL, IDINDICADOR, NVL(IDGRPAPURACAO,0) AS ID' +
        'GRPAPURACAO, SUM(NVL(VLRAPURACAONUM,0)) AS VLRAPURACAONUM '
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 1 '
      '           AND ANOCOMPETENCIA = 2002'
      '           AND IDIMOVEL = 677'
      '         GROUP BY IDIMOVEL, IDINDICADOR, IDGRPAPURACAO '
      '       ) AP03, '
      '       ( '
      
        '        SELECT IDIMOVEL, IDINDICADOR, NVL(IDGRPAPURACAO,0) AS ID' +
        'GRPAPURACAO, SUM(NVL(VLRAPURACAONUM,0)) AS VLRAPURACAONUM '
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 1 '
      '           AND ANOCOMPETENCIA = 2002'
      '           AND IDIMOVEL = 677'
      '         GROUP BY IDIMOVEL, IDINDICADOR, IDGRPAPURACAO '
      '       ) AP04, '
      '       ( '
      
        '        SELECT IDIMOVEL, IDINDICADOR, NVL(IDGRPAPURACAO,0) AS ID' +
        'GRPAPURACAO, SUM(NVL(VLRAPURACAONUM,0)) AS VLRAPURACAONUM '
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 1 '
      '           AND ANOCOMPETENCIA = 2002'
      '           AND IDIMOVEL = 677'
      '         GROUP BY IDIMOVEL, IDINDICADOR, IDGRPAPURACAO '
      '       ) AP05, '
      '       ( '
      
        '        SELECT IDIMOVEL, IDINDICADOR, NVL(IDGRPAPURACAO,0) AS ID' +
        'GRPAPURACAO, SUM(NVL(VLRAPURACAONUM,0)) AS VLRAPURACAONUM '
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 1 '
      '           AND ANOCOMPETENCIA = 2002'
      '           AND IDIMOVEL = 677'
      '         GROUP BY IDIMOVEL, IDINDICADOR, IDGRPAPURACAO '
      '       ) AP06, '
      '       ( '
      
        '        SELECT IDIMOVEL, IDINDICADOR, NVL(IDGRPAPURACAO,0) AS ID' +
        'GRPAPURACAO, SUM(NVL(VLRAPURACAONUM,0)) AS VLRAPURACAONUM '
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 1 '
      '           AND ANOCOMPETENCIA = 2002'
      '           AND IDIMOVEL = 677'
      '         GROUP BY IDIMOVEL, IDINDICADOR, IDGRPAPURACAO '
      '       ) AP07 '
      '         '
      'WHERE ST.IDREPORTS   = 3759'
      '  AND ST.IDSUBTIPO   = GI.IDSUBTIPO'
      '  AND GI.IDINDICADOR = I.IDINDICADOR'
      ''
      '  AND I.IDINDICADOR    = AP01.IDINDICADOR(+)'
      '  AND I.IDINDICADOR    = AP02.IDINDICADOR(+)  '
      '  AND I.IDINDICADOR    = AP03.IDINDICADOR(+)'
      '  AND I.IDINDICADOR    = AP04.IDINDICADOR(+)  '
      '  AND I.IDINDICADOR    = AP05.IDINDICADOR(+)'
      '  AND I.IDINDICADOR    = AP06.IDINDICADOR(+)  '
      '  AND I.IDINDICADOR    = AP07.IDINDICADOR(+)    '
      '  '
      'ORDER BY DSC_TIPOVALOR, ORDEM, DSC_INDICADOR'
      '')
  end
