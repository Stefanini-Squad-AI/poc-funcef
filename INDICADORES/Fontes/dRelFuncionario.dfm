  inherited CMsp: TCMSqlParams
    SQL.Strings = (
      '/* SELECT FUNCIONÁRIOS */'
      ''
      'SELECT IM.IMONOME,'
      '       CC.DESCRICAO AS DSC_CCUSTO,'
      '       FU.DESCRICAO AS DSC_FUNCAO,'
      '       I.DESCRICAO  AS DSC_INDICADOR,'
      '       CCI.ANOCOMPETENCIA AS ANOCOMPETENCIA,'
      '       NVL(AP01.VLRAPURACAONUM,0) AS VLR01,'
      '       NVL(AP02.VLRAPURACAONUM,0) AS VLR02,'
      '       NVL(AP03.VLRAPURACAONUM,0) AS VLR03,'
      '       NVL(AP04.VLRAPURACAONUM,0) AS VLR04,'
      '       NVL(AP05.VLRAPURACAONUM,0) AS VLR05,'
      '       NVL(AP06.VLRAPURACAONUM,0) AS VLR06,'
      '       NVL(AP07.VLRAPURACAONUM,0) AS VLR07,'
      '       NVL(AP08.VLRAPURACAONUM,0) AS VLR08,'
      '       NVL(AP09.VLRAPURACAONUM,0) AS VLR09,'
      '       NVL(AP10.VLRAPURACAONUM,0) AS VLR10,'
      '       NVL(AP11.VLRAPURACAONUM,0) AS VLR11,'
      '       NVL(AP12.VLRAPURACAONUM,0) AS VLR12'
      ''
      'FROM'
      '       IMOVEL IM,'
      '       INDINDICADOR I,'
      '       INDGRPAPURACAO CC,'
      '       INDGRPAPURACAO FU,'
      '       ('
      
        '        SELECT DISTINCT AP.IDIMOVEL, AP.IDGRPAPURACAO, AP.IDSUBG' +
        'RPAPURACAO, AP.IDINDICADOR, AP.ANOCOMPETENCIA'
      '          FROM INDAPURACAO AP, INDGRPINDICADOR GI'
      '         WHERE AP.IDINDICADOR = GI.IDINDICADOR'
      '           AND GI.IDSUBTIPO = 4'
      '           AND ANOCOMPETENCIA = 2001'
      '        ) CCI,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 1'
      '           AND ANOCOMPETENCIA = 2001'
      '        ) AP01,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 2'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP02,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 3'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP03,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 4'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP04,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 5'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP05,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 6'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP06,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 7'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP07,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 8'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP08,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 9'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP09,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 10'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP10,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 11'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP11,'
      '       ('
      
        '        SELECT IDIMOVEL, IDINDICADOR, IDGRPAPURACAO, IDSUBGRPAPU' +
        'RACAO, VLRAPURACAONUM'
      '          FROM INDAPURACAO'
      '         WHERE MESCOMPETENCIA = 12'
      '           AND ANOCOMPETENCIA = 2001'
      '       ) AP12'
      ''
      'WHERE CCI.IDIMOVEL          = IM.IDIMOVEL'
      '  AND CCI.IDGRPAPURACAO     = CC.IDGRPAPURACAO'
      '  AND CCI.IDSUBGRPAPURACAO  = FU.IDGRPAPURACAO'
      '  AND CCI.IDINDICADOR       = I.IDINDICADOR'
      '  AND CCI.IDIMOVEL          = AP01.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP01.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP01.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP01.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP02.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP02.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP02.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP02.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP03.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP03.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP03.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP03.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP04.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP04.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP04.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP04.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP05.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP05.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP05.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP05.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP06.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP06.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP06.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP06.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP07.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP07.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP07.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP07.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP08.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP08.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP08.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP08.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP09.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP09.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP09.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP09.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP10.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP10.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP10.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP10.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP11.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP11.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP11.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP11.IDINDICADOR(+)'
      '  AND CCI.IDIMOVEL          = AP12.IDIMOVEL(+)'
      '  AND CCI.IDGRPAPURACAO     = AP12.IDGRPAPURACAO(+)'
      '  AND CCI.IDSUBGRPAPURACAO  = AP12.IDSUBGRPAPURACAO(+)'
      '  AND CCI.IDINDICADOR       = AP12.IDINDICADOR(+)'
      ''
      ''
      'ORDER BY IMONOME, DSC_INDICADOR, DSC_CCUSTO, DSC_FUNCAO'
      ''
      ''
      ''
      ' ')
    ClientDataSet = nil
  end
