  object CMSqlParams1: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT'
      '       T.IDTIPOINVEST, '
      '       T.IDTIPOOPERACAO, '
      '       T.DESCTIPOOPERACAO, '
      '       I.DESCTIPOINVEST, '
      '       T.FLGTRANSF, '
      '       T.FLGMOVCOTA, '
      '       CASE WHEN (T.NATUREZAOPERACAO = '#39'A'#39') THEN '#39'(+)'#39
      '            WHEN (T.NATUREZAOPERACAO = '#39'D'#39') THEN '#39'(-)'#39
      '            WHEN (T.NATUREZAOPERACAO = '#39'N'#39') THEN '#39'(+/-)'#39
      '            ELSE  T.NATUREZAOPERACAO '
      '       END AS FLGCOTA '
      'FROM '
      '     TIPOOPERACAO T, '
      '     TIPOINVEST I, '
      '     TIPOFUNDOINVEST F '
      'WHERE '
      '      I.IDTIPOINVEST = T.IDTIPOINVEST '
      '  AND I.IDTIPOINVEST = F.IDTIPOINVEST '
      ''
      'UNION ALL '
      ''
      'SELECT '
      '       T.IDTIPOINVEST, '
      '       T.IDTIPOOPERACAO, '
      '       T.DESCTIPOOPERACAO, '
      '       I.DESCTIPOINVEST, '
      '       T.FLGTRANSF, '
      '       T.FLGMOVCOTA, '
      '       CASE WHEN (T.NATUREZAOPERACAO = '#39'A'#39') THEN '#39'(+)'#39
      '            WHEN (T.NATUREZAOPERACAO = '#39'D'#39') THEN '#39'(-)'#39
      '            WHEN (T.NATUREZAOPERACAO = '#39'N'#39') THEN '#39'(+/-)'#39
      '            ELSE  T.NATUREZAOPERACAO '
      '       END AS FLGCOTA '
      'FROM '
      '     TIPOOPERACAO T, '
      '     TIPOINVEST I '
      'WHERE '
      '      I.IDTIPOINVEST = 1 '
      '  AND I.IDTIPOINVEST = T.IDTIPOINVEST '
      ''
      'UNION ALL '
      ''
      'SELECT '
      '       T.IDTIPOINVEST, '
      '       T.IDTIPOOPERACAO, '
      '       T.DESCTIPOOPERACAO, '
      '       I.DESCTIPOINVEST, '
      '       T.FLGTRANSF, '
      '       T.FLGMOVCOTA, '
      '       CASE WHEN (T.NATUREZAOPERACAO = '#39'A'#39') THEN '#39'(+)'#39
      '            WHEN (T.NATUREZAOPERACAO = '#39'R'#39') THEN '#39'(+)'#39
      '            WHEN (T.NATUREZAOPERACAO = '#39'D'#39') THEN '#39'(-)'#39
      '            WHEN (T.NATUREZAOPERACAO = '#39'N'#39') THEN '#39'(+/-)'#39
      '       ELSE  T.NATUREZAOPERACAO '
      '       END AS FLGCOTA '
      'FROM '
      '     TIPOOPERACAO T, '
      '     TIPOINVEST I '
      'WHERE '
      '      I.IDTIPOINVEST IN (2,8) '
      '  AND I.IDTIPOINVEST = T.IDTIPOINVEST '
      '  AND ((T.FLGOPGERENC <> '#39'S'#39') OR (T.FLGOPGERENC IS NULL)) '
      '  AND T.NATUREZAOPERACAO IN ('#39'A'#39','#39'D'#39','#39'N'#39','#39'R'#39') '
      ''
      'ORDER BY DESCTIPOINVEST, DESCTIPOOPERACAO'
      '')
    ClientDataSet = Cds
    Left = 416
    Top = 1
  end
  object cdsDespXTipoOper: TCMClientDataSet
