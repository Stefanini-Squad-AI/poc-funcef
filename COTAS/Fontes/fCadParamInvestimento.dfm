  end
  object sqpDespXTipoOper: TCMSqlParams
    SQL.Strings = (
      'SELECT TD.DESCTIPODESPINV, '
      '       CASE WHEN (DT.RECPAG = '#39'P'#39') THEN '#39'(+)'#39
      '            WHEN (DT.RECPAG = '#39'R'#39') THEN '#39'(-)'#39
      '            ELSE (DT.RECPAG) '
      '       END AS FLGCOTA, TP.FLGMOVCOTA'
      ''
      'FROM DESPESASXTIPOOPER DT, TIPODESPINVEST TD, TIPOOPERACAO TP'
      'WHERE DT.IDTIPODESPINVEST = TD.IDTIPODESPINVEST'
      '  AND DT.IDTIPOOPERACAO = TP.IDTIPOOPERACAO'
      '  AND TD.IDTIPODESPINVEST NOT IN (-4, -5)'
      '  AND DT.IDTIPOOPERACAO = 2'
      ''
      'UNION '
      ''
      'SELECT '#39'Lucro / Prejuízo'#39' AS DESCTIPODESPINV, '
      '       '#39'(+/-)'#39' AS FLGCOTA, '#39'R'#39' AS FLGMOVCOTA'
      'FROM DUAL'
      'WHERE EXISTS (SELECT IDTIPODESPINVEST'
      '              FROM DESPESASXTIPOOPER'
      '              WHERE IDTIPODESPINVEST IN (-4, -5)'
      '                AND IDTIPOOPERACAO = 2) '
      ' ')
    ClientDataSet = cdsDespXTipoOper
    Left = 648
    Top = 9
  end
  object CMSqlParams2: TCMSqlParams
