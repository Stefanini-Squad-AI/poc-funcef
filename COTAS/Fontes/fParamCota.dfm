  object wwQuery1: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  P.*,'
      '  PP.NOME AS PRE,   -- PRESIDENTE'
      '  PD.NOME AS DIR,   -- DIRETOR FINANCEIRO'
      '  PA.NOME AS ADM,   -- ADMINISTRADOR RESPONSAVEL'
      '  PR.NOME AS RIN,   -- RESPONSÁVEL PELA INFORMAÇÃO'
      '  PJR.NOME AS PJR,  -- RESPONSÁVEL PJ RISCO'
      '  PFR.NOME AS PFR,  -- RESPONSÁVEL PF RISCO'
      '  PJC.NOME AS PJC,  -- RESPONSÁVEL PJ CONSOLIDAÇÃO'
      '  PFC.NOME AS PFC,  -- RESPONSÁVEL PF CONSOLIDAÇÃO'
      '  PJA.NOME AS PJA,  -- RESPONSÁVEL PJ AUDITORIA'
      '  PFA.NOME AS PFA,  -- RESPONSÁVEL PF AUDITORIA'
      '  PCU.NOME AS PCU   -- CUSTODIANTE'
      'FROM'
      '  PARAMCOTA P,'
      '  PESSOA PP,'
      '  PESSOA PD,'
      '  PESSOA PA,'
      '  PESSOA PR,'
      '  PESSOA PJR,'
      '  PESSOA PFR,'
      '  PESSOA PJC,'
      '  PESSOA PFC,'
      '  PESSOA PJA,'
      '  PESSOA PFA,'
      '  PESSOA PCU'
      'WHERE'
      '  ( P.IDPRESIDENTE = PP.IDPESSOA(+) )'
      '  AND ( P.IDDIRFINANCEIRO = PD.IDPESSOA(+) )'
      '  AND ( P.IDADMINRESPON = PA.IDPESSOA(+) )'
      '  AND ( P.IDRESPONINF = PR.IDPESSOA(+) )'
      '  AND ( P.IDPJRISCO = PJR.IDPESSOA(+) )'
      '  AND ( P.IDPFRISCO = PFR.IDPESSOA(+) )'
      '  AND ( P.IDPJCONSOLID = PJC.IDPESSOA(+) )'
      '  AND ( P.IDPFCONSOLID = PFC.IDPESSOA(+) )'
      '  AND ( P.IDPJAUDITORIA = PJA.IDPESSOA(+) )'
      '  AND ( P.IDPFAUDITORIA = PFA.IDPESSOA(+) )'
      '  AND ( P.IDCUSTODIANTE = PCU.IDPESSOA(+) )'
      '')
    ValidateWithMask = True
    Left = 624
    Top = 192
  end
  object DataSetProvider1: TDataSetProvider
    DataSet = wwQuery1
    Constraints = True
    Left = 624
    Top = 240
  end
