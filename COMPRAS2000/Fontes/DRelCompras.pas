Function TDtmRelCompras.CalcPrazoPgtoOC : String;
Var
   sAux : String;
begin
  sAux := '';
  If Not qryPrazoOC.IsEmpty Then
     Begin
         qryPrazoOC.First;
         sAux := IntToStr(qryPrazoOCPRAZOPGTO.AsInteger) +'d = '+ Format('%8.2f',[qryPrazoOCTOTOC.asFloat*qryPrazoOCPERCPAGTO.asFloat/100]);
         Repeat
            qryPrazoOC.Next;
            If ( Not qryPrazoOC.EOF)  And ( Pos( IntToStr( qryPrazoOCPRAZOPGTO.AsInteger )+'d', sAux ) = 0 ) Then
               sAux := sAux +'/ '+IntToStr(qryPrazoOCPRAZOPGTO.AsInteger) +'d = '+ Format('%8.2f',[qryPrazoOCTOTOC.asFloat*qryPrazoOCPERCPAGTO.asFloat/100]);
         Until qryPrazoOC.EOF;
     End;
  Result :=  sAux;
End;

