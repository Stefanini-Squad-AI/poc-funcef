function TDtmRelCompras.MostraParam(Form: string): boolean;
var
   frm : TForm;
begin
     If (UPPERCASE(Form) = 'FRMPARAMIMPCXPEQ') then
          frm := TFrmParamImpCxPeq.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMIMPCXPEQR') then
          frm := TFrmParamImpCxPeqR.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMSOLICOMP') then
          frm := TfrmParamSoliComp.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMCOTPRODXFORN') then
          frm := TFrmParamCotProdxForn.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMSOLPREPRONTA') then
          frm := TFrmParamSolPrePronta.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMCADSOLPREPRONTA') then
          frm := TFrmParamCadSolPrePronta.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMCONTROLEOC') then
          frm := TFrmParamControleOC.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMCOTFORN') then
          frm := TFrmParamCotForn.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMCOLETA') then
          frm := TFrmParamColeta.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMCOTPROD') then
          frm := TFrmParamCotProd.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMRESUMOCOT') then
          frm := TFrmResumoCot.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMFORNSEMCOMP') then
          frm := TFrmParamFornSemComp.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMACOMPPROC') then
          frm := TFrmParamAcompProc.Create(Application)
     Else
     If (UPPERCASE(Form) = 'FRMPARAMIMPOC') then
         Begin
            FrmMostraRelat.TipoNomeEmpresa := tnNomeFantasia;
            frm := TFrmParamImpOC.Create(Application);
            iModelo := 0;
         End
     Else
     If (UPPERCASE(Form) = 'FRMPARAMIMPOCM1') then
         Begin
            FrmMostraRelat.TipoNomeEmpresa := tnNomeFantasia;
            frm := TFrmParamImpOC.Create(Application);
            iModelo := 1;
         End
     Else
     If (UPPERCASE(Form) = 'FRMPARAMIMPOCM2') then
         Begin
            FrmMostraRelat.TipoNomeEmpresa := tnNomeFantasia;
            frm := TFrmParamImpOC.Create(Application);
            iModelo := 2;
         End
     Else
        frm := nil;
     if frm = nil then
        Result := false
     else
     begin
        with frm do
          begin
             Result := (ShowModal = mrOk);
             free;
          End;
     End;
End;
procedure TDtmRelCompras.Lb4UltPrint(Sender: TObject);
Var
   x : LongInt;
begin
  inherited;
  LbFornA.Caption := '';
  LbTelA.Caption  := '';
  LbFornB.Caption := '';
  LbTelB.Caption  := '';
  LbFornC.Caption := '';
  LbTelC.Caption  := '';
  LbFornD.Caption := '';
  LbTelD.Caption  := '';
  x := 0;
  If qryUltForn.Active Then
     Begin
        qryUltForn.First;
        While Not qryUltForn.Eof Do
          Begin
              Inc(x);
              Case x Of
                 1 : Begin
                        LbFornA.Caption := qryUltFornFORNECEDOR.AsString;
                        LbTelA.Caption  := qryUltFornTELEFONE.AsString;
                     End;
                 2 : Begin
                        LbFornB.Caption := qryUltFornFORNECEDOR.AsString;
                        LbTelB.Caption  := qryUltFornTELEFONE.AsString;
                     End;
                 3 : Begin
                        LbFornC.Caption := qryUltFornFORNECEDOR.AsString;
                        LbTelC.Caption  := qryUltFornTELEFONE.AsString;
                     End;
                 4 : Begin
                        LbFornD.Caption := qryUltFornFORNECEDOR.AsString;
                        LbTelD.Caption  := qryUltFornTELEFONE.AsString;
                     End;
              End;
              qryUltForn.Next;
          End;
     End;
end;

