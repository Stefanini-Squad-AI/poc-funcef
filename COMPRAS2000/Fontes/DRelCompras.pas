   End;
end;

procedure TDtmRelCompras.ppOCPrintingComplete(Sender: TObject);
begin
  inherited;
  Try
      StartTransacao;
      qryOC.First;
      While Not qryOC.EOF Do
         Begin
            If Not ExecutarQuery(DtmBaseDados.qry,'UPDATE OC SET FLGIMPRESSA = ''T'' WHERE (NUMOC = '+IntToStr(qryOCNUMOC.asInteger)+') ') Then
               Abort;
            qryOC.Next;
         End;
      CommitTransacao;
  Except
      RollBackTransacao;
  End;

end;

