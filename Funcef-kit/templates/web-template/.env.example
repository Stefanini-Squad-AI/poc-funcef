# Copie para .env.local e preencha: cp .env.example .env.local
# Cenário 1 (Consumidor TKF2)? Converta com a CLI: pnpm dlx @funcef-componentes/cli scenario apply consumidor-tkf2

# --- App ---
# Origem pública da app (auth e URLs absolutas derivam dela).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Prefixo quando a app roda sob um path (ex.: /sistema-x). Vazio = raiz.
NEXT_PUBLIC_BASE_PATH=/dev

# --- Backend ---
# API de negócio — consumida SÓ no servidor (rota BFF /api/bff). Sem backend
# real: `pnpm mock` (json-server na 3001).
API_URL=http://localhost:3001

# --- Autenticação (Entra ID + Better Auth) ---
# App registration no Entra ID.
MICROSOFT_CLIENT_ID=seu-client-id
# Credencial do client — exatamente um dos modos:
#   com valor  → modo secret (padrão em dev);
#   comentada  → modo federated (client assertion): no Azure a assertion vem da
#                managed identity; localmente, do az login / service principal
#                (variáveis AZURE_*) — o FIC do app registration precisa
#                confiar nessa identidade.
MICROSOFT_CLIENT_SECRET=seu-client-secret
# Federated com user-assigned managed identity no Web App (opcional).
# AZURE_MANAGED_IDENTITY_CLIENT_ID=client-id-da-identidade
# Modo certificado (sem client secret, fora do Azure): caminhos dos PEMs.
# Gere localmente (openssl) e cadastre o cert público no app registration.
# MICROSOFT_CLIENT_CERT_PATH=./certs/dev-cert.pem
# MICROSOFT_CLIENT_KEY_PATH=./certs/dev-key.pem
TENANT_ID=seu-tenant-id
# Audience da API protegida — vira o escopo `${AUDIENCE_API}/.default`.
AUDIENCE_API=api://sua-api
# Assina cookies/sessões do Better Auth. Gere um: openssl rand -base64 32
BETTER_AUTH_SECRET=seu-segredo

# Redis (opcional): persiste sessões, foto de perfil e rate-limit.
# Sem ele a app roda stateless, com degradação graciosa.
# REDIS_URL=redis://localhost:6379

# Domínio dos cookies de sessão em produção (ex.: .funcef.com.br). Usado pela
# factory (emissão) E pelo proxy (deleção órfã ?stale=1) — os dois juntos.
# Sem ele, cookies host-only (ok para app em host único).
# COOKIE_DOMAIN=.funcef.com.br

# TTL em segundos do cache do cookie de sessão (opcional; default 300).
# COOKIE_MAX_AGE=300
