# Impede que artefatos locais e segredos de desenvolvimento entrem no contexto de build.
# Sem este arquivo, o "COPY . ." do Dockerfile leva .git/, bin/, obj/, *.user e qualquer
# appsettings.Development.json com DirectConnectionString preenchida para dentro das camadas.
#
# ATENCAO: nao ignore tests/ nem *.csproj — o Dockerfile copia o .csproj de teste e o
# "dotnet restore TemplateBase.slnx" resolve todos os projetos da solucao, inclusive o de teste.

# Controle de versao
.git
.gitignore
.gitattributes
.github

# Saidas de build (em qualquer nivel)
**/bin/
**/obj/
**/out/
**/publish/
**/TestResults/
**/coverage/
artifacts/
*.binlog

# IDE / usuario
.vs/
.vscode/
.idea/
**/*.user
**/*.suo
**/*.userosscache
*.sln.docstates

# Segredos e configuracao local (o container recebe config por env var / Key Vault)
**/appsettings.Development.json
**/appsettings.Local.json
**/secrets.json
**/*.pfx
**/*.p12
**/*.key
**/*.pem
.env
.env.*

# Docker
Dockerfile
.dockerignore
docker-compose*.yml

# Documentacao (nao faz parte do runtime)
docs/
*.md
