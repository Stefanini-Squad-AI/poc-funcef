<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TemplateBase.Application</RootNamespace>
    <AssemblyName>TemplateBase.Application</AssemblyName>
    <NoWarn>$(NoWarn);CS1591;CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FUNCEF.Build" PrivateAssets="all" />
    <PackageReference Include="FUNCEF.Abstractions" />
    <PackageReference Include="FUNCEF.Essenciais" />
    <!--
      FUNCEF.NoSql NÃO é referenciado aqui de propósito: cache (ICacheStore) e documentos
      (IDocumentStore<T>) são infraestrutura. A Application declara apenas o contrato
      (IOrdemHistoricoService) e o modelo de leitura (OrdemHistoricoDocumento, POCO sem atributos
      do driver); a implementação e o mapeamento Bson ficam na Infrastructure.
    -->
    <PackageReference Include="FUNCEF.ORM" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplateBase.Domain\TemplateBase.Domain.csproj" />
  </ItemGroup>

</Project>
