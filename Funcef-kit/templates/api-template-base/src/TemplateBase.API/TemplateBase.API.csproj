<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>TemplateBase.API</RootNamespace>
    <AssemblyName>TemplateBase.API</AssemblyName>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573;CS1574;CS1587</NoWarn>
    <!-- Sem apphost (.exe): a regra ASR corporativa do Defender ("Block executable files unless
         they meet a prevalence, age, or trusted list criterion", GUID 01443614-CD74-433A-B99E-2ECDC07BFC25)
         bloqueia com "Acesso negado" o .exe recém-compilado e não assinado nas estações FUNCEF.
         Com UseAppHost=false, `dotnet run` e o Visual Studio executam via dotnet.exe (assinado,
         confiável para a regra). Nada muda no deploy: o Dockerfile já publica com
         /p:UseAppHost=false e o entrypoint é `dotnet TemplateBase.API.dll`. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplateBase.Application\TemplateBase.Application.csproj" />
    <ProjectReference Include="..\TemplateBase.Infrastructure\TemplateBase.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FUNCEF.Autenticacao" />
    <PackageReference Include="FUNCEF.Build" PrivateAssets="all" />
    <PackageReference Include="FUNCEF.Abstractions" />
    <PackageReference Include="FUNCEF.Essenciais" />
    <PackageReference Include="FUNCEF.NoSql" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
  </ItemGroup>

</Project>
