<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TemplateBase.Domain</RootNamespace>
    <AssemblyName>TemplateBase.Domain</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FUNCEF.Build" PrivateAssets="all" />
    <!-- FUNCEF.Essenciais: exceções tipadas (BusinessException/ConflictException) lançadas pelas
         invariantes das entidades ricas, já mapeadas para HTTP pelo GlobalExceptionMiddleware.
         Decisão pragmática do template: o Domain já depende de FUNCEF.ORM pelos atributos de
         mapeamento/auditoria — as exceções da plataforma seguem o mesmo racional. -->
    <PackageReference Include="FUNCEF.Essenciais" />
    <PackageReference Include="FUNCEF.ORM" />
  </ItemGroup>

  <ItemGroup>
    <!-- Setters e construtores das entidades são internal (encapsulamento DDD): produção cria/
         altera entidades apenas pelos métodos de negócio; os testes mantêm acesso direto para
         montar cenários (ex.: definir Id que em produção é identity do banco). -->
    <InternalsVisibleTo Include="TemplateBase.Tests" />
  </ItemGroup>

</Project>
