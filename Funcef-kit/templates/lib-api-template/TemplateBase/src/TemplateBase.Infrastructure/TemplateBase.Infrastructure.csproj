<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TemplateBase.Infrastructure</RootNamespace>
    <AssemblyName>TemplateBase.Infrastructure</AssemblyName>
    <NoWarn>$(NoWarn);CS1591;CS0219;CS1572;CS1573;CS1574;CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FUNCEF.Autenticacao" />
    <PackageReference Include="FUNCEF.Build" PrivateAssets="all" />
    <PackageReference Include="FUNCEF.Abstractions" />
    <PackageReference Include="FUNCEF.Cofre" />
    <PackageReference Include="FUNCEF.Essenciais" />
    <PackageReference Include="FUNCEF.NoSql" />
    <PackageReference Include="FUNCEF.ORM" />
    <PackageReference Include="FUNCEF.Armazenamentos" />
    <!-- Referência explícita (não transitiva): DeveloperUserCredential usa TokenCredential/
         DefaultAzureCredential diretamente. Ver Credentials/DeveloperUserCredential.cs. -->
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplateBase.Domain\TemplateBase.Domain.csproj" />
    <ProjectReference Include="..\TemplateBase.Application\TemplateBase.Application.csproj" />
  </ItemGroup>

</Project>
