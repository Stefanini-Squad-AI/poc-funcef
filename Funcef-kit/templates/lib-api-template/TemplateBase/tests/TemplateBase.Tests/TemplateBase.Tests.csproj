<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TemplateBase.Tests</RootNamespace>
    <AssemblyName>TemplateBase.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TemplateBase.Domain\TemplateBase.Domain.csproj" />
    <ProjectReference Include="..\..\src\TemplateBase.Application\TemplateBase.Application.csproj" />
    <ProjectReference Include="..\..\src\TemplateBase.Infrastructure\TemplateBase.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\TemplateBase.API\TemplateBase.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\TemplateBase.API\appsettings.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.json" />
    <Content Include="..\..\src\TemplateBase.API\appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.Development.json" />
    <Content Include="..\..\src\TemplateBase.API\appsettings.Homologation.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.Homologation.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FUNCEF.Build" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

</Project>
