  object CMSqlParams1: TCMSqlParams
    SQL.Strings = (
      
        'SELECT P.IDPARAMCOTAINVEST, P.IDCARTEIRAINVEST, P.DATAULTFECH, P' +
        '.DATAINICIAL, P.DATAENCERRAMENTO,'
      
        '       P.QTDDECQTD, P.QTDDECVLR, P.VLRCOTAINICIAL, P.MOECODIGO, ' +
        'P.PERCTXPERFORM, PERCTXADM,        '
      
        '       C.DESCCARTINVEST, M.MOEDESC FROM PARAMCOTAINVEST P, CARTE' +
        'IRAINVEST C, MOEDA M '
      'WHERE  '
      '     C.IDCARTEIRAINVEST = P.IDCARTEIRAINVEST '
      'AND  M.MOECODIGO(+)     = P.MOECODIGO'
      'ORDER BY P.DATAULTFECH, C.DESCCARTINVEST')
    ClientDataSet = CdsConsulta
    Left = 328
    Top = 256
  end
