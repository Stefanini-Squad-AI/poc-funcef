  object qryIntegraRubXPlano: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDPESSJUR,IDRUBRICA,IDPLANOPREV,TIPCODIGO,CODTIPRECDES,'
