  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT'
      
        '  X.IDLOCALATENDXCPU, X.IDCPUATEND, X.IDLOCALATEND, C.DESCCPUATE' +
        'ND, L.DESCLOCALATEND, L.IDLOCALATEND AS IDLOCAL, T.NOME AS NOMET' +
        'IPOATEND '
      'FROM'
      '  LOCALATENDXCPU X, CPUATEND C, LOCALATEND L, TIPOATEND T'
      'WHERE'
      '  (X.IDCPUATEND = C.IDCPUATEND(+)) AND'
      '  (X.IDLOCALATEND(+) = L.IDLOCALATEND) AND'
      '  (L.IDTIPOATEND =T.IDTIPOATEND(+))'
      'ORDER BY'
      '  L.DESCLOCALATEND,'
      '  C.DESCCPUATEND')
    object qryIDLOCALATENDXCPU: TFloatField
      FieldName = 'IDLOCALATENDXCPU'
      Origin = 'LOCALATENDXCPU.IDLOCALATENDXCPU'
    end
    object qryIDCPUATEND: TFloatField
      FieldName = 'IDCPUATEND'
      Origin = 'LOCALATENDXCPU.IDCPUATEND'
    end
    object qryIDLOCALATEND: TFloatField
      FieldName = 'IDLOCALATEND'
      Origin = 'LOCALATENDXCPU.IDLOCALATEND'
    end
    object qryDESCCPUATEND: TStringField
