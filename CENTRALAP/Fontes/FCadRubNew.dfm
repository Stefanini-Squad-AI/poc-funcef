  object qrypartprevplan: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'select'
      '  a.IDSITPART, a.IDSITPLANOPREV ,b.IDSITFUNC ,c.FLGINTERNO'
      'from'
      '  partprevplan a ,elegpatro b ,sitpart c'
      'where'
      'a.IDPESSJUR   = :IDPESSJUR  and'
      'a.IDPESSOA   =  :IDPESSOA   and'
      'a.IDPLANOPREV   = :IDPLANOPREV and'
      'b.idpessoa = a.idpessoa   and'
      'b.IDPESSJUR   = a.IDPESSJUR   and'
      'c.IDSITPART = a.IDSITPART and'
      'a.SEQPROPOSTA = 1'
      ''
      ''
      ''
      ''
      '                                      '
      ' ')
