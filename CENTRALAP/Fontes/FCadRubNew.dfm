  object UpdRubxBenef: TUpdateSQL
    ModifySQL.Strings = (
      'update RUBXBENEFICIO'
      'set'
      '  IDBENEFICIO = :IDBENEFICIO'
      'where'
      '  IDBENEFICIO = :OLD_IDBENEFICIO')
    InsertSQL.Strings = (
      'insert into RUBXBENEFICIO'
      '  (IDBENEFICIO)'
      'values'
      '  (:IDBENEFICIO)')
    DeleteSQL.Strings = (
      'delete from RUBXBENEFICIO'
