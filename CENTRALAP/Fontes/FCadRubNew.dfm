  object QryRubxBenef: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      ' R.IDBENEFICIO,'
      ' B.NOME,'
      ' ('#39'B'#39') AS T,'
      ' ('#39'   '#39') AS OK,'
      ' R.IDSITBENEF,'
      ' S.DESCRICAO'
      'FROM'
      '  RUBXBENEFICIO R, BENEFICIO B, SITBENEF S'
      'WHERE'
      '  1=2')
    UpdateObject = UpdRubxBenef
    ValidateWithMask = True
