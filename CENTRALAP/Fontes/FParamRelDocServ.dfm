  object qryPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT PT.IDPESSOA, PJ.NOME'
      'FROM PESSOA PJ, PATRO PT'
      'WHERE PT.IDPESSOA = PJ.IDPESSOA'
      'ORDER BY PJ.NOME')
    ValidateWithMask = True
    Left = 99
    Top = 57
  end
  object qryPlano: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDPLANOPREV, NOME'
      'FROM PLANPREV'
      'ORDER BY NOME')
    ValidateWithMask = True
    Left = 429
    Top = 72
  end
  object qryServ: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDSERVICOS,NOME, '#39'S'#39' AS TIPO'
      'FROM SERVICO'
      'ORDER BY NOME')
    ValidateWithMask = True
    Left = 280
    Top = 235
  end
  object qrySit: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  IDSITBENEF, DESCRICAO       '
      'FROM SITBENEF'
      'ORDER BY DESCRICAO'
      '')
    ValidateWithMask = True
    Left = 289
    Top = 385
  end
end
