#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = CMCapCarObj50.bpl CMAdmPrev.bpl CMIRRFobj50.bpl CadastroPrev.exe \
  BeneficioPrev.exe ContribuicaoPREV.exe Impostos.exe Folha.exe
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

Folha.exe: FOLHA\Fontes\Folha.dpr
  $(DCC)

CMIRRFobj50.bpl: CMIRRFOBJ50\Package\CMIRRFobj50.dpk
  $(DCC)

CadastroPrev.exe: CADASTROPREV\Fontes\CadastroPrev.dpr
  $(DCC)

BeneficioPrev.exe: BENEFICIOPREV\Fontes\BeneficioPrev.dpr
  $(DCC)

ContribuicaoPREV.exe: CONTRIBUICAOPREV\Fontes\ContribuicaoPREV.dpr
  $(DCC)

Impostos.exe: IRRF\Fontes\Impostos.dpr
  $(DCC)

CMAdmPrev.bpl: Cm\CMADMPREV\Package\CMAdmPrev.dpk
  $(DCC)

CMCapCarObj50.bpl: CMCAPCAROBJ50\Package\CMCapCarObj50.dpk
  $(DCC)


