  object qryLkpObjProcesso: TwwQuery
    AutoRefresh = True
    DatabaseName = 'BaseDados'
    DataSource = dsCondenacao
    SQL.Strings = (
      'SELECT O.CODTIPOOBJETO, T.DESCRICAO'
      'FROM OBJPROCTRAB O, '
      '     TIPOOBJPROCTRAB T'
      'WHERE O.NUMPROCTRAB =:NUMPROCTRAB AND'
      '      O.CODTIPOOBJETO = T.CODTIPOOBJETO'
      'ORDER BY T.DESCRICAO'
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    PictureMasks.Strings = (
      'VALORDESPESAADM'#9'###,###,#00.00'#9'T'#9'T')
    ValidateWithMask = True
    Left = 455
    Top = 60
    ParamData = <
      item
        DataType = ftFloat
        Name = 'NUMPROCTRAB'
        ParamType = ptUnknown
      end>
