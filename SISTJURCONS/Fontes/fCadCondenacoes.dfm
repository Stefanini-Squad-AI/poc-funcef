    RequestLive = True
    SQL.Strings = (
      'SELECT'
      '  ETP.IDTPDESDOBRAMENTO ,'
      '  ETP.NUMPROCTRAB       ,'
      '  ETP.CODTIPORECURSO    ,'
      '  ETP.NUMSEQ            ,'
      '  ETP.TPDESDOBRAMENTO   ,'
      '  ETP.DATADEPOSITO      ,'
      '  ETP.VLRCREDITADO      ,'
      '  ETP.TPIMPUGCALCULO    ,'
      '  ETP.IDCBANCARIA       ,'
      '  ETP.CODPORTADOR       ,'
      '  ETP.VLRCALCCONTADORIA ,'
      '  ETP.FORMACORRECAO     ,'
      '  ETP.CLASSIFICACAO     ,'
      '  ETP.INSTANCIA         ,'
      '  ETP.DATASETENCA       ,'
      '  ETP.FONTECUSTEIO      ,'
      '  ETP.FORMACUSTEIO      ,'
      '  ETP.APORTECONTRIB     ,'
      '  ETP.CODTIPOOBJETO     ,'
      '  ETP.DATAREVOGACAO     ,'
      '  ETP.OBSCONDENACAO'
      'FROM ETPDESDOBRAMENTO ETP'
      'WHERE ETP.IDTPDESDOBRAMENTO = 999999999999'
      ''
