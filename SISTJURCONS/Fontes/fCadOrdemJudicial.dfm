  object qryLkpBeneficDisp: TwwQuery
    AutoRefresh = True
    DatabaseName = 'BaseDados'
    DataSource = dsOrdem_Partes
    SQL.Strings = (
      
        'SELECT D.IDTITULAR, (P.NOME || '#39' - ('#39' || LOWER(N.DESCRICAO) || '#39 +
        ')'#39' ) NOME,'
      '       D.IDPESSOA, '
      '       flgbeneficiario, '
      '       flgdeplegal'
      'FROM DEPENTIT D,'
      '     PESSOA P,'
      '     DEPEN N'
      'WHERE D.IDTITULAR =:IDPARTE'
      '      AND D.IDPESSOA <> D.IDTITULAR'
      '      AND D.IDDEPENDENCIA <> '#39'OUT'#39
      '      AND D.IDPESSOA = P.IDPESSOA'
      '      AND D.IDDEPENDENCIA = N.IDDEPENDENCIA'
      'ORDER BY NOME'
      ''
      ' '
      ' '
      ' '
      ' '
      ' ')
    PictureMasks.Strings = (
      'VALORDESPESAADM'#9'###,###,#00.00'#9'T'#9'T')
