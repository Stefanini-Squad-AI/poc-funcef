  object UpdCadMovArrematacao: TUpdateSQL
    ModifySQL.Strings = (
      'update ETAPA_DETALHAMENTO'
      'set'
      '  NUMPROCTRAB = :NUMPROCTRAB,'
      '  CODTIPORECURSO = :CODTIPORECURSO,'
      '  NUMSEQ = :NUMSEQ,'
      '  DTPRIPUBLICACAO = :DTPRIPUBLICACAO,'
      '  VLRPRIPUBLICACAO = :VLRPRIPUBLICACAO,'
      '  DSCPRIJORNAL = :DSCPRIJORNAL,'
      '  DTSEGPUBLICACAO = :DTSEGPUBLICACAO,'
      '  VLRSEGPUBLICACAO = :VLRSEGPUBLICACAO,'
      '  DSCSEGJORNAL = :DSCSEGJORNAL,'
      '  DTTERPUBLICACAO = :DTTERPUBLICACAO,'
      '  VLRTERPUBLICACAO = :VLRTERPUBLICACAO,'
      '  DSCTERJORNAL = :DSCTERJORNAL,'
      '  DTHASTA1 = :DTHASTA1,'
      '  VLRAVALJUD1 = :VLRAVALJUD1,'
      '  VLRAVALFUNCEF1 = :VLRAVALFUNCEF1,'
      '  FLGHOUVEARREMATACAO1 = :FLGHOUVEARREMATACAO1,'
      '  FLGARREMATADOPOR1 = :FLGARREMATADOPOR1,'
      '  DTARREMATACAO1 = :DTARREMATACAO1,'
      '  VLRARREMATADO1 = :VLRARREMATADO1,'
      '  DTCARTAARREMAT1 = :DTCARTAARREMAT1,'
      '  VLRHONORLEILOEIRO1 = :VLRHONORLEILOEIRO1,'
      '  DTHASTA2 = :DTHASTA2,'
      '  VLRLANCTOINICIAL2 = :VLRLANCTOINICIAL2,'
      '  VLRAVALFUNCEF2 = :VLRAVALFUNCEF2,'
      '  FLGHOUVEARREMATACAO2 = :FLGHOUVEARREMATACAO2,'
      '  FLGARREMATADOPOR2 = :FLGARREMATADOPOR2,'
      '  DTARREMATACAO2 = :DTARREMATACAO2,'
      '  VLRARREMATADO2 = :VLRARREMATADO2,'
      '  DTCARTAARREMAT2 = :DTCARTAARREMAT2,'
      '  DTAVERBACAO2 = :DTAVERBACAO2,'
      '  VLRHONORLEILOEIRO2 = :VLRHONORLEILOEIRO2,'
      '  FLGHOUVEEMBARGO = :FLGHOUVEEMBARGO,'
      '  DTEMBARGO = :DTEMBARGO,'
      '  FLGFUNCEFIMITIDA = :FLGFUNCEFIMITIDA,'
      '  DTIMITIDA = :DTIMITIDA,'
      '  FLGAJUIZAREINTEGRACAO = :FLGAJUIZAREINTEGRACAO,'
      '  DTAJUIZAREINTEGRACAO = :DTAJUIZAREINTEGRACAO,'
      '  VLRDEBCONDOMINIAIS = :VLRDEBCONDOMINIAIS,'
      '  VLRTAXAS = :VLRTAXAS,'
      '  VLRIMPOSTOS = :VLRIMPOSTOS,'
      '  VLROUTROS = :VLROUTROS,'
      '  VLRITBI = :VLRITBI,'
      '  DTTRANSFCARTEIRAS = :DTTRANSFCARTEIRAS,'
      '  FLGEMBARGOTERCEIROS = :FLGEMBARGOTERCEIROS'
      'where'
      '  NUMPROCTRAB = :OLD_NUMPROCTRAB and'
      '  CODTIPORECURSO = :OLD_CODTIPORECURSO and'
      '  NUMSEQ = :OLD_NUMSEQ')
    InsertSQL.Strings = (
      'insert into ETAPA_DETALHAMENTO'
      
        '  (NUMPROCTRAB, CODTIPORECURSO, NUMSEQ, DTPRIPUBLICACAO, VLRPRIP' +
        'UBLICACAO, '
      
        '   DSCPRIJORNAL, DTSEGPUBLICACAO, VLRSEGPUBLICACAO, DSCSEGJORNAL' +
        ', DTTERPUBLICACAO, '
      
        '   VLRTERPUBLICACAO, DSCTERJORNAL, DTHASTA1, VLRAVALJUD1, VLRAVA' +
        'LFUNCEF1, '
      
        '   FLGHOUVEARREMATACAO1, FLGARREMATADOPOR1, DTARREMATACAO1, VLRA' +
        'RREMATADO1, '
      
        '   DTCARTAARREMAT1, VLRHONORLEILOEIRO1, DTHASTA2, VLRLANCTOINICI' +
        'AL2, VLRAVALFUNCEF2, '
      
        '   FLGHOUVEARREMATACAO2, FLGARREMATADOPOR2, DTARREMATACAO2, VLRA' +
        'RREMATADO2, '
      
        '   DTCARTAARREMAT2, DTAVERBACAO2, VLRHONORLEILOEIRO2, FLGHOUVEEM' +
        'BARGO, '
      
        '   DTEMBARGO, FLGFUNCEFIMITIDA, DTIMITIDA, FLGAJUIZAREINTEGRACAO' +
        ', DTAJUIZAREINTEGRACAO, '
      
        '   VLRDEBCONDOMINIAIS, VLRTAXAS, VLRIMPOSTOS, VLROUTROS, VLRITBI' +
        ', DTTRANSFCARTEIRAS, '
      '   FLGEMBARGOTERCEIROS)'
      'values'
      
        '  (:NUMPROCTRAB, :CODTIPORECURSO, :NUMSEQ, :DTPRIPUBLICACAO, :VL' +
        'RPRIPUBLICACAO, '
      
        '   :DSCPRIJORNAL, :DTSEGPUBLICACAO, :VLRSEGPUBLICACAO, :DSCSEGJO' +
        'RNAL, :DTTERPUBLICACAO, '
      
        '   :VLRTERPUBLICACAO, :DSCTERJORNAL, :DTHASTA1, :VLRAVALJUD1, :V' +
        'LRAVALFUNCEF1, '
      
        '   :FLGHOUVEARREMATACAO1, :FLGARREMATADOPOR1, :DTARREMATACAO1, :' +
        'VLRARREMATADO1, '
      
        '   :DTCARTAARREMAT1, :VLRHONORLEILOEIRO1, :DTHASTA2, :VLRLANCTOI' +
        'NICIAL2, '
      
