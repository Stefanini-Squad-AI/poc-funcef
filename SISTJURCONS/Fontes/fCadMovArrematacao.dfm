        'DTARREMATACAO2, '
      
        '   :VLRARREMATADO2, :DTCARTAARREMAT2, :DTAVERBACAO2, :VLRHONORLE' +
        'ILOEIRO2, '
      
        '   :FLGHOUVEEMBARGO, :DTEMBARGO, :FLGFUNCEFIMITIDA, :DTIMITIDA, ' +
        ':FLGAJUIZAREINTEGRACAO, '
      
        '   :DTAJUIZAREINTEGRACAO, :VLRDEBCONDOMINIAIS, :VLRTAXAS, :VLRIM' +
        'POSTOS, '
      
        '   :VLROUTROS, :VLRITBI, :DTTRANSFCARTEIRAS, :FLGEMBARGOTERCEIRO' +
        'S)')
    DeleteSQL.Strings = (
      'delete from ETAPA_DETALHAMENTO'
      'where'
      '  NUMPROCTRAB = :OLD_NUMPROCTRAB and'
      '  CODTIPORECURSO = :OLD_CODTIPORECURSO and'
