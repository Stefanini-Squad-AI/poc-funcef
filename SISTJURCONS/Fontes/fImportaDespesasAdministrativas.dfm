  object qryMovTemp: TwwQuery
    AutoCalcFields = False
    OnCalcFields = qryMovTempCalcFields
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT *'
      'FROM MOVDESPADMJURWEB M'
      'WHERE M.CODESTADO = '#39'RJ'#39
      '      AND M.IDPESSOA = '#39'1111805'#39
      '      AND M.NUMPROCTRAB = '#39'25311'#39
      '      AND TO_CHAR(M.DATAFECHAMENTO,'#39'DD/MM/YYYY'#39') = '#39'29/07/2010'#39
      '      AND M.NUMLOTE = '#39'4'#39
      
        'ORDER BY M.CODESTADO, M.IDPESSOA, M.NUMPROCTRAB, M.IDMOVDESPWEB ' +
        '  '
      '')
    PictureMasks.Strings = (
      'VALORDESPESAADM'#9'###,###,#00.00'#9'T'#9'T')
    ValidateWithMask = False
    Left = 579
    Top = 166
