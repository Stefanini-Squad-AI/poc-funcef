  object qryHonorario: TwwQuery
    AutoCalcFields = False
    DatabaseName = 'BaseDados'
    ParamCheck = False
    SQL.Strings = (
      'SELECT         IDHONORCONTRATUALJUR,'
      '               DESCHONORCONTRATUAL,'
      '               VLRPRINCIPAL,'
      '               QTDEPARTES,'
      '               DATAVIGENCIA,'
      '               OBSERVACAO,'
      
        '               DECODE(CLASSJURHONORCONTRATUAL,0,'#39'HONORÁRIO EVENT' +
        'UAL'#39',1,'#39'PROVIDENCIAS ADMINISTRATIVAS'#39',2,'#39'HONORÁRIO FIXO'#39') as CLA' +
        'SSJURHONORCONTRATUAL'
      ''
      '          FROM HONORCONTRATUALJUR'
      '          order by  CLASSJURHONORCONTRATUAl asc'
      '')
    PictureMasks.Strings = (
      'VALORDESPESAADM'#9'###,###,#00.00'#9'T'#9'T'
      'VALORDESPESAAPAGAR'#9'###,###,#00.00'#9'T'#9'T')
