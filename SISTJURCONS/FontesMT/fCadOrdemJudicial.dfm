  object qryLkpBeneficario: TwwQuery
    AutoCalcFields = False
    DatabaseName = 'BaseDados'
    DataSource = dsOrdem
    SQL.Strings = (
      
        'SELECT (P.RAZAOSOCIAL || '#39' - ('#39' || LOWER(N.DESCRICAO) || '#39')'#39' ) N' +
        'OME,'
      '       P.IDPESSOA, flgbeneficiario, flgdeplegal'
      'FROM DEPENTIT D,'
      '     PESSOA P,'
      '     DEPEN N'
      'WHERE D.IDTITULAR =:IDPARTEATIVA'
      '      AND D.IDDEPENDENCIA <> '#39'OUT'#39
      '      AND D.IDPESSOA <> D.IDTITULAR'
      '      AND D.IDPESSOA = P.IDPESSOA'
      '      AND D.IDDEPENDENCIA = N.IDDEPENDENCIA'
      'ORDER BY NOME'
      ''
      ' '
      ' '
      ' '
      ' '
      ' ')
    PictureMasks.Strings = (
      'VALORDESPESAADM'#9'###,###,#00.00'#9'T'#9'T')
    ValidateWithMask = True
