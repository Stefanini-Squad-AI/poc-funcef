  object sqlFolhaFreqEscala: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      
        '  '#39'1234567890123456789012345678901234567890123456789012345678901' +
        '234567890'#39' AS ESTAB,'
      
        '  '#39'1234567890123456789012345678901234567890123456789012345678901' +
        '234567890'#39' AS ENDERECO,'
      '  '#39'12345678901234567890'#39' AS UF,'
      '  '#39'12345678901234567890'#39' AS MATRICULA,'
      '  '#39'12345678901234567890'#39' AS REFERENCIA,'
      
        '  '#39'1234567890123456789012345678901234567890123456789012345678901' +
        '234567890'#39' AS EMPREGADO,'
      
        '  '#39'1234567890123456789012345678901234567890123456789012345678901' +
        '234567890'#39' AS CARGO,'
      
        '  '#39'1234567890123456789012345678901234567890123456789012345678901' +
        '234567890'#39' AS C_CUSTO,'
      '  '#39'1234567890'#39' AS DATAADMISSAO,'
      
        '  '#39'1234567890123456789012345678901234567890123456789012345678901' +
        '234567890'#39' AS NOMEHORARIO,'
      '  0 AS NUM_DIAS_MES,'
      '  '#39'99-99'#39' AS ENTRADA01, '#39'99-99'#39' AS SAIDA01,'
      '  '#39'99-99'#39' AS ENTRADA02, '#39'99-99'#39' AS SAIDA02,'
      '  '#39'99-99'#39' AS ENTRADA03, '#39'99-99'#39' AS SAIDA03,'
      '  '#39'99-99'#39' AS ENTRADA04, '#39'99-99'#39' AS SAIDA04,'
      '  '#39'99-99'#39' AS ENTRADA05, '#39'99-99'#39' AS SAIDA05,'
      '  '#39'99-99'#39' AS ENTRADA06, '#39'99-99'#39' AS SAIDA06,'
      '  '#39'99-99'#39' AS ENTRADA07, '#39'99-99'#39' AS SAIDA07,'
      '  '#39'99-99'#39' AS ENTRADA08, '#39'99-99'#39' AS SAIDA08,'
      '  '#39'99-99'#39' AS ENTRADA09, '#39'99-99'#39' AS SAIDA09,'
      '  '#39'99-99'#39' AS ENTRADA10, '#39'99-99'#39' AS SAIDA10,'
      '  '#39'99-99'#39' AS ENTRADA11, '#39'99-99'#39' AS SAIDA11,'
      '  '#39'99-99'#39' AS ENTRADA12, '#39'99-99'#39' AS SAIDA12,'
      '  '#39'99-99'#39' AS ENTRADA13, '#39'99-99'#39' AS SAIDA13,'
      '  '#39'99-99'#39' AS ENTRADA14, '#39'99-99'#39' AS SAIDA14,'
      '  '#39'99-99'#39' AS ENTRADA15, '#39'99-99'#39' AS SAIDA15,'
      '  '#39'99-99'#39' AS ENTRADA16, '#39'99-99'#39' AS SAIDA16,'
      '  '#39'99-99'#39' AS ENTRADA17, '#39'99-99'#39' AS SAIDA17,'
