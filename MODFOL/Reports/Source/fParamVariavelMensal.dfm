    object Memo1: TMemo
      Left = 0
      Top = 0
      Width = 410
      Height = 249
      Align = alTop
      Lines.Strings = (
        
          'Com  relação às somas e subtrações das rubricas selecionadas, o ' +
          'sistema considera '
        'da seguinte forma:'
        ''
        'Proventos e Outros = Somam'
        'Descontos = Subtraem'
        ''
        
          'Caso exista alguma rubrica que deve ter o sinal invertido em rel' +
          'ação a este padrão, '
        
          'coloque um sinal de menos (-), na relação dos códigos, à esquerd' +
          'a do código da '
        'rubrica em questão. '
        'Após colocar o sinal, tecle "Marcar" para ficar registrado.'
        ''
        'Exemplo:'
        ''
        '0001,0002,-0003,0004'
        ''
        
          'Neste exemplo, a rubrica 0003, se for Provento ou Outro, será su' +
          'btraída em vez de '
        
          'ser somada, e se for Desconto será somada em vez de subtraída (v' +
          'eja que, mesmo '
        'neste caso, o sinal a ser usado é o sinal de Menos).')
      ReadOnly = True
      TabOrder = 1
    end
  end
