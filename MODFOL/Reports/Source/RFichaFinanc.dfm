  object sqlEstab: TCMSqlParams
    SQL.Strings = (
      'SELECT PJ.IDPESSOA AS IDESTAB,'
      '       RTRIM(PJ.RAZAOSOCIAL) AS EMPRESA,'
      
        '       DECODE(PJ.NUMDOCUMENTO, NULL, '#39#39', '#39'CNPJ: '#39' || PJ.NUMDOCUM' +
        'ENTO) AS CGC,'
      '       ES.CODESTADO AS UF,'
      '       RTRIM(DECODE(RTRIM(ESTADUAL.NUMDOCUMENTO), '#39#39','
      '             DECODE(RTRIM(MUNICIPAL.NUMDOCUMENTO), '#39#39', '#39#39','
      '             '#39'Inscrição Municipal: '#39' || MUNICIPAL.NUMDOCUMENTO),'
      
        '             '#39'Inscrição Estadual: '#39' || ESTADUAL.NUMDOCUMENTO)) A' +
        'S ESTADUALMUNICIPAL,'
      '       RTRIM(E.LOGRADOURO) || '#39', '#39' || E.NUMERO ||'
      
        '         DECODE(RTRIM(E.COMPLEMENTO), NULL, '#39#39', '#39' - '#39' || RTRIM(E' +
        '.COMPLEMENTO)) ||'
      
        '         DECODE(RTRIM(E.BAIRRO), NULL, '#39#39', '#39' - '#39' || RTRIM(E.BAIR' +
        'RO)) ||'
      
        '         DECODE(RTRIM(CIDADES.NOME), NULL, '#39#39', '#39' - '#39' || RTRIM(CI' +
        'DADES.NOME)) ||'
      
        '         '#39' - CEP: '#39' || RTRIM(SUBSTR(E.CEP, 1, 5)) || '#39'-'#39' || RTRI' +
        'M(SUBSTR(E.CEP, 6, 3)) AS ENDERECO'
      '  FROM PESSOA PJ,'
      '       ENDPESS E,'
      '       CIDADES,'
      '       ESTADO ES,'
      '       (SELECT D.IDPESSOA,'
      '               TD.CODDOCUMENTO,'
      '               D.NUMDOCUMENTO,'
      '               UPPER(TD.SIGLADOCUMENTO)'
      '          FROM DOCPESSOA D, TIPODOCOFICIAL TD'
      '         WHERE (TD.SIGLADOCUMENTO = '#39'MUNICIPAL:'#39')'
      '           AND (TD.IDDOCUMENTO = D.IDDOCUMENTO)) ESTADUAL,'
      '       (SELECT D.IDPESSOA,'
      '               TD.CODDOCUMENTO,'
      '               D.NUMDOCUMENTO,'
      '               UPPER(TD.SIGLADOCUMENTO)'
      '          FROM DOCPESSOA D, TIPODOCOFICIAL TD'
      '         WHERE (TD.SIGLADOCUMENTO = '#39'ESTADUAL:'#39')'
      '           AND (TD.IDDOCUMENTO = D.IDDOCUMENTO)) MUNICIPAL'
      ' WHERE (PJ.IDPESSOA in (94099))'
      '   AND (PJ.IDENDCOMERCIAL = E.IDENDERECO)'
      '   AND (PJ.IDPESSOA = E.IDPESSOA)'
      '   AND (E.IDCIDADES = CIDADES.IDCIDADES)'
      '   AND (CIDADES.IDESTADO = ES.IDESTADO)'
      '   AND (PJ.IDPESSOA = ESTADUAL.IDPESSOA(+))'
      '   AND (PJ.IDPESSOA = MUNICIPAL.IDPESSOA(+))')
    ClientDataSet = cdsEstab
    Left = 109
    Top = 124
  end
