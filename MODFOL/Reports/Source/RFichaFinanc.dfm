  object sqlFichaFinanc: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  0 AS IDESTAB,'
      '  '#39'1234567890123'#39' AS MATRICULA,'
      
        '  '#39'123456789012345678901234567890123456789012345678901234567890'#39 +
        ' AS FUNCIONARIO,'
      '  '#39'123456789012345678901234567890'#39' AS NOMECENTROCUSTO,'
      
        '  '#39'12345678901234567890123456789012345678901234567890'#39' AS NOMECA' +
        'RGO,'
      '  '#39'123456789'#39' AS PROVENTODESCONTO,'
      
        '  '#39'123456789012345678901234567890123456789012345678901234567890'#39 +
        ' AS RUBRICA,'
      '  0 AS TIPORUBRICA,'
      
