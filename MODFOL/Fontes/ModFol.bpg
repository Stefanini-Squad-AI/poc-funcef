#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = ModFol.exe CmRHObj50.bpl CMCapCarObj50.bpl CMAdmPrev.bpl \
  CMIntegraEP50.bpl CmCapCarUtilObj50.bpl CMPlaneOrcObj50.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

ModFol.exe: ModFol.dpr
  $(DCC)

CmRHObj50.bpl: ..\..\CMRHObj50\Package\CmRHObj50.dpk
  $(DCC)

CMCapCarObj50.bpl: ..\..\CMCapCarObj50\Package\CMCapCarObj50.dpk
  $(DCC)

CMAdmPrev.bpl: ..\..\Cm\CMAdmPrev\Package\CMAdmPrev.dpk
  $(DCC)

CMIntegraEP50.bpl: ..\..\EmprestimoBPL\Integra\Package\CMIntegraEP50.dpk
  $(DCC)

CmCapCarUtilObj50.bpl: ..\..\CmCapCarUtilObj50\Package\CmCapCarUtilObj50.dpk
  $(DCC)

CMPlaneOrcObj50.bpl: ..\..\CMPlaneOrcObj50\Package\CMPlaneOrcObj50.dpk
  $(DCC)


