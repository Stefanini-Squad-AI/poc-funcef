  object qryCampo: TwwQuery
    Tag = 5
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '      G.CODGRUPOARQUIVO,C.IDCAMPO,C.NOMEDOCAMPO,'
      '      C.DESCRICAODOCAMPO, G.DESCGRUPOARQUIVO'
      'FROM'
      '    GRPARQUIVO G, CMPBDGRP CG, CMPBD C'
      'WHERE'
      '     (C.CAMPODOBANCO >= 1) AND (C.IDCAMPO = CG.IDCAMPO) AND'
      '     (CG.CODGRUPOARQUIVO = G.CODGRUPOARQUIVO)'
      'ORDER BY'
      '      CG.CODGRUPOARQUIVO,C.DESCRICAODOCAMPO')
    ValidateWithMask = True
    Left = 88
    Top = 64
  end
  object qryVariavel: TwwQuery
    Tag = 5
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '      IDCAMPO, DESCRICAODOCAMPO, '#39'Variáveis'#39' DESCR'
      'FROM'
      '    CMPBD'
      'WHERE'
      '   (CAMPODOBANCO = 0)'
      'ORDER BY'
      '      DESCRICAODOCAMPO')
    ValidateWithMask = True
    Left = 143
    Top = 64
  end
  object qryFormula: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '      C.CODTABELA AS CODGRUPOFORMULA,'
      '      C.CODCAMPO AS IDFORMULA,'
      '      C.DESCRICAO AS DESCRICAOFORMULA,'
      '      '#39'(Genérica) '#39' || RTRIM(T.DESCRICAO) AS DESCGRUPOFORMULA'
      'FROM'
      '    CAMPOTABGENER C, TABGENER T'
      'WHERE'
      '     (C.CODTABELA = T.CODTABELA)'
      'UNION'
      'SELECT'
      '      T.DESCRICAO  AS CODGRUPOFORMULA,'
      '      C.DESCRICAO  AS IDFORMULA,'
      '      C.DESCRICAO  AS DESCRICAOFORMULA,'
      '      '#39'(Longa)    '#39' || RTRIM(T.DESCRICAO) AS DESCGRUPOFORMULA'
      'FROM'
      '    LONGCMPTABGENER C, LONGTABGENER T'
      'WHERE'
      '     (C.IDTABELA = T.IDTABELA)'
      'ORDER BY'
      '      DESCGRUPOFORMULA,DESCRICAOFORMULA'
      ''
      ' ')
    ValidateWithMask = True
    Left = 201
    Top = 64
  end
  object dsFormula: TwwDataSource
    DataSet = qryFormula
    Left = 201
    Top = 52
  end
  object dsVariavel: TwwDataSource
    DataSet = qryVariavel
    Left = 143
    Top = 52
  end
  object dsCampo: TwwDataSource
    DataSet = qryCampo
    Left = 88
    Top = 52
  end
