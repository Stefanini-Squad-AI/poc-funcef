#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = AdminImob.exe Alienacao.exe Compras.exe Almoxarifado.exe \
  BeneficioPrev.exe CadastroPrev.exe Caf.exe CentralAP.exe Impostos.exe \
  CFINAN.exe Contab.exe contrato.exe ContribuicaoPREV.exe ContasaPagar.exe \
  ContasaReceber.exe emprestimo.exe Folha.exe GlobalCM.exe Indicadores.exe \
  Investimentos.exe InvestImob.exe ModAsm.exe ModAuto.exe ModAva.exe ModBen.exe \
  ModCes.exe ModCon.exe ModFol.exe ModRes.exe ModTrn.exe Orcamento.exe \
  ParamPrev.exe Regra.exe RelatoriosCm.exe SistJurCons.exe ProcJud.exe
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

AdminImob.exe: ADMINIMOB\Fontes\AdminImob.dpr
  $(DCC)

Alienacao.exe: ALIENACAO\Fontes\Alienacao.dpr
  $(DCC)

Almoxarifado.exe: Almoxarifado\Fontes\Almoxarifado.dpr
