#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = CmGlobalObj50.bpl CmBack50.bpl CMContabObj50.bpl CMRegra50MT.bpl \
  CMRegra50.bpl CMCfinanObj50.bpl CMPlaneOrcObj50.bpl CMCapCarObj50.bpl \
  CMIntBancoMT50.bpl CmCapCarUtilObj50.bpl CMFBCOMUM50.bpl CMTotalPrev50.bpl \
  CMPrevMT50.bpl CMWebComum50.bpl CMIntegraEP50.bpl CMAdmPrev.bpl \
  CMIRRFobj50.bpl CMFBOBJ50.bpl CMFolhaObjMT.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------


CmGlobalObj50.bpl: CMGLOBALOBJ50\Package\CmGlobalObj50.dpk
  $(DCC)

CmBack50.bpl: CMBACK\Package\CmBack50.dpk
  $(DCC)

CMContabObj50.bpl: CMCONTABOBJ50\Package\CMContabObj50.dpk
  $(DCC)

CMRegra50MT.bpl: CM\RegraMT\Package\CMRegra50MT.dpk
  $(DCC)

CMRegra50.bpl: CM\Regra\Package\CMRegra50.dpk
  $(DCC)

CMCfinanObj50.bpl: CMCFINANOBJ50\Package\CMCfinanObj50.dpk
  $(DCC)

CMPlaneOrcObj50.bpl: CMPLANEORCOBJ50\Package\CMPlaneOrcObj50.dpk
  $(DCC)

CMCapCarObj50.bpl: CMCAPCAROBJ50\Package\CMCapCarObj50.dpk
  $(DCC)

CMIntBancoMT50.bpl: CMINTBANCOMT50\Package\CMIntBancoMT50.dpk
  $(DCC)

CmCapCarUtilObj50.bpl: CMCAPCARUTILOBJ50\Package\CmCapCarUtilObj50.dpk
  $(DCC)

CMFBCOMUM50.bpl: FOLHA\CMFbComum50\Package\CMFBCOMUM50.dpk
  $(DCC)

CMTotalPrev50.bpl: CM\TotalPrev\Package\CMTotalPrev50.dpk
  $(DCC)

CMPrevMT50.bpl: CM\CMPrevMT50\Package\CMPrevMT50.dpk
  $(DCC)

CMWebComum50.bpl: AUTOATENDIMENTO\CMWebComum50\Package\CMWebComum50.dpk
  $(DCC)

CMIntegraEP50.bpl: EMPRESTIMOBPL\Integra\Package\CMIntegraEP50.dpk
  $(DCC)

CMAdmPrev.bpl: CM\CMADMPREV\Package\CMAdmPrev.dpk
  $(DCC)

CMIRRFobj50.bpl: CMIRRFOBJ50\Package\CMIRRFobj50.dpk
  $(DCC)

CMFBOBJ50.bpl: FOLHA\CMFbObj50\Package\CMFBOBJ50.dpk
  $(DCC)

CMFolhaObjMT.bpl: FOLHA\CMFolhaObjMt\Package\CMFolhaObjMT.dpk
  $(DCC)

