package CMPrevMT50;

{$R *.RES}
{$R CMPREVMT50_RES.RES}

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Biblioteca de Classes Previdenciárias'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CmCompo50,
  CmForms50,
  CmGlobalObj50,
  CMRegra50MT;

contains { PFC-75 (Migração NEXUS): cláusula contains reduzida às units alcançadas por CONTRIBUIÇÃO, FOLHA e BENEFICIOPREV; 29 unit(s) não alcançada(s) removida(s) — ver Migração NEXUS/INVENTARIO.md }
  uDbConjuntorubrica in '..\DBObjects\uDbConjuntoRubrica.pas',
  UCtrlConjuntoRubrica in '..\CtrlObjects\UCtrlConjuntoRubrica.pas',
  FCadConjuntoRubrica in '..\Source\FCadConjuntoRubrica.pas' {FrmCadConjuntoRubrica},
  FAssociaConjuntoxRubrica in '..\Source\FAssociaConjuntoxRubrica.pas' {FrmAssociaConjuntoxRubrica},
  UFuncoesPrevMT50 in '..\Source\UFuncoesPrevMT50.pas',
  uDbBenefbfciario in '..\DBObjects\uDbBenefbfciario.pas',
  UCtrlBenefBfciario in '..\CtrlObjects\UCtrlBenefBfciario.pas',
  uDbBenefplanopart in '..\DBObjects\uDbBenefPlanoPart.pas',
  UCtrlHstBenefBfciario in '..\CtrlObjects\UCtrlHstBenefBfciario.pas',
  uDbHstbenefbfciario in '..\DBObjects\uDbHstbenefbfciario.pas',
  UCtrlMotivo in '..\CtrlObjects\UCtrlMotivo.pas',
  uDbConjuntorubxrub in '..\DBObjects\uDbConjuntoRubxRub.pas',
  uDbMotivo in '..\DBObjects\uDbMotivo.pas';

end.
