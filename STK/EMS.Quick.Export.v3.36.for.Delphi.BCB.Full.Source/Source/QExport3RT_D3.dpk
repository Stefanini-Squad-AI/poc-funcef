package QExport3RT_D3;

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $00400000}
{$DESCRIPTION 'EMS Quick Export Component Suite 3.0'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl30,
  Vcldb30,
  vclx30;

contains
  QExport3,
  QExport3LaTeX,
  QExport3XML,
  QExport3RTFList,
  QExport3RTF,
  QExport3HTML,
  QExport3SQL,
  QExport3HTMLTemplates,
  QExport3ASCII,
  QExport3Clipboard,
  QExport3DBF,
  QExport3XLS,
  QExport3StrIDs,
  QExport3Common,
  fuQExport3XLSColorEditor,
  fuQExport3About,
  fuQExport3Progress,
  QExport3PDF,
  QExport3Options,
  QExport3XLSFile,
  QExport3XLSUtils,
  QExport3XLSCommon,
  QExport3XLSConsts,
  QExport3Dialog,
  QExport3CustomSource,
  QExport3Types,
  fuQExport3License;

end.
