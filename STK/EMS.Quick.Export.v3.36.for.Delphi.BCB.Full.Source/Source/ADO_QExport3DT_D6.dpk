package ADO_QExport3DT_D6;

{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'EMS Quick Export Component Suite for ADO 3.0'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  designide,
  dbrtl,
  vcldb,
  adortl,
  QExport3DT_D6,
  QExport3RT_D6,
  ADO_QExport3RT_D6;

contains
  ADO_QExport3Dsgn in 'ADO_QExport3Dsgn.pas',
  ADO_QExport3Reg in 'ADO_QExport3Reg.pas';

end.
