    procedure TemporizadorTimer(Sender: TObject);


  private { Private declarations }

  public { Public declarations }
   bTempo: boolean;

  end;



var
  dtmImobiliario: TdtmImobiliario;



implementation

uses uFuncoesImob;

{$R *.DFM}



procedure Temporiza(i: integer);
begin
   dtmImobiliario.bTempo := False;

   dtmImobiliario.Temporizador.Interval := i * 1000;
   dtmImobiliario.Temporizador.Enabled  := True;

   repeat
      Application.ProcessMessages;
   until
      dtmImobiliario.bTempo;

   dtmImobiliario.Temporizador.Enabled  := False;
end;


procedure TdtmImobiliario.TemporizadorTimer(Sender: TObject);
begin
   bTempo := True;
end;



end.
