  object upd: TUpdateSQL
    ModifySQL.Strings = (
      'update COTACAOMOEDA'
      'set'
      '  MOECODIGO = :MOECODIGO'
      'where'
      '  MOECODIGO = :OLD_MOECODIGO')
    InsertSQL.Strings = (
      'insert into COTACAOMOEDA'
      '  (MOECODIGO)'
      'values'
      '  (:MOECODIGO)')
    DeleteSQL.Strings = (
      'delete from COTACAOMOEDA'
      'where'
      '  MOECODIGO = :OLD_MOECODIGO')
    Left = 216
    Top = 168
  end
  object qry: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    Constrained = True
    SQL.Strings = (
      'SELECT'
      '   M.MOECODIGO, C.COTVALOR, C.COTMESREF,'
      '   M.MOEDESC, M.MOESIGLA, C.COTDATA,'
      '   C.NUMDIASPRAZO,'
      ''
      '   SUBSTR(C.COTMESREF, 1, 2) AS MES,'
      '   SUBSTR(C.COTMESREF, 3, 4) AS ANO,'
      ''
      '   0 AS ACUMULADO,'
      '   0 AS DOZEMESES'
      ''
      'FROM'
      '   COTACAOMOEDA C, MOEDA M'
      ''
      'WHERE'
      '   ( C.MOECODIGO =:MOEDA )'
      
        '   AND ( (SUBSTR(C.COTMESREF, 3, 4)||SUBSTR(C.COTMESREF, 1, 2)) ' +
        '>=:DATAINI )'
      
        '   AND ( (SUBSTR(C.COTMESREF, 3, 4)||SUBSTR(C.COTMESREF, 1, 2)) ' +
        '<=:DATAFIM )'
      '   AND ( C.MOECODIGO = M.MOECODIGO )'
      ''
      'ORDER BY'
      '   C.COTDATA'
      ' ')
    UpdateObject = upd
