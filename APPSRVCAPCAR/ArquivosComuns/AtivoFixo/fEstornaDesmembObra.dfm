  object qryObraFilhos: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT D.IDOBRARESULT, O.DESCCAFOBRA, D.TIPOPROPORCAO,'
      
        '       DECODE(D.TIPOPROPORCAO,0,'#39'%'#39','#39'$'#39') AS STIPOPROPORCAO, D.PR' +
        'OPORCAO,'
      '       OL.QTDLANC'
      'FROM CAFOBRADESMEMB D,'
      '     CAFOBRA O,'
      '     (SELECT IDCAFOBRA, IDPESSOA, COUNT(IDOBRALANC) AS QTDLANC'
      '      FROM CAFOBRALANC'
      '      WHERE (FLGDESMEMBOBRA = 0)'
      '        AND (IDPESSOA = :IDPESSOA)'
      '      GROUP BY IDCAFOBRA, IDPESSOA) OL'
      'WHERE (D.IDCAFOBRA = :IDCAFOBRA)'
