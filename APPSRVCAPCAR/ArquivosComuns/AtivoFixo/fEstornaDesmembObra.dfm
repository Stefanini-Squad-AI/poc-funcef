  object qryVerObraLanc: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT D.IDOBRARESULT, O.DESCCAFOBRA, D.TIPOPROPORCAO,'
      
        '       DECODE(D.TIPOPROPORCAO,0,'#39'%'#39','#39'$'#39') AS STIPOPROPORCAO, D.PR' +
        'OPORCAO'
      'FROM CAFOBRADESMEMB D,'
      '     CAFOBRA O'
      'WHERE (D.IDCAFOBRA = :IDCAFOBRA)'
      '  AND (D.IDPESSOA = :IDPESSOA)'
      '  AND (D.IDOBRARESULT = O.IDCAFOBRA)'
      '  AND (D.IDPESSOA = O.IDPESSOA)'
      'ORDER BY D.IDOBRARESULT'
      ' '
      ' '
      ' ')
