  object UpdParametroContabil: TUpdateSQL
    ModifySQL.Strings = (
      'update CONTABJURID'
      'set'
      '  IDCONTABJURID = :IDCONTABJURID,'
      '  CONTADEBITO = :CONTADEBITO,'
      '  IDPLANO1 = :IDPLANO1,'
      '  CONTACREDITO = :CONTACREDITO,'
      '  IDPLANO2 = :IDPLANO2,'
      '  INDMATERIA = :INDMATERIA,'
      '  INDPRINCIPAL = :INDPRINCIPAL,'
      '  IDTIPOPROC_DE = :IDTIPOPROC_DE,'
      '  IDTIPOPROC_PARA = :IDTIPOPROC_PARA,'
      '  FLGPARTE_DE = :FLGPARTE_DE,'
      '  FLGPARTE_PARA = :FLGPARTE_PARA,'
      '  INDOPERACAO = :INDOPERACAO,'
      '  IDEMPRESA = :IDEMPRESA,'
      '  CODCENTROCUSTO = :CODCENTROCUSTO,'
      '  FLGUSAPADRAO = :FLGUSAPADRAO,'
      '  TIPCODIGO = :TIPCODIGO'
      'where'
      '  IDCONTABJURID = :OLD_IDCONTABJURID')
    InsertSQL.Strings = (
      'insert into CONTABJURID'
      
        '  (IDCONTABJURID, CONTADEBITO, IDPLANO1, CONTACREDITO, IDPLANO2,' +
        ' '
      'INDMATERIA, '
      '   INDPRINCIPAL, IDTIPOPROC_DE, IDTIPOPROC_PARA, FLGPARTE_DE, '
      'FLGPARTE_PARA, '
      '   INDOPERACAO, IDEMPRESA, CODCENTROCUSTO, FLGUSAPADRAO, '
      'TIPCODIGO)'
      'values'
      
        '  (:IDCONTABJURID, :CONTADEBITO, :IDPLANO1, :CONTACREDITO, :IDPL' +
        'ANO2, '
      ':INDMATERIA, '
      
        '   :INDPRINCIPAL, :IDTIPOPROC_DE, :IDTIPOPROC_PARA, :FLGPARTE_DE' +
        ', '
      ':FLGPARTE_PARA, '
      '   :INDOPERACAO, :IDEMPRESA, :CODCENTROCUSTO, :FLGUSAPADRAO, '
      ':TIPCODIGO)')
    DeleteSQL.Strings = (
      'delete from CONTABJURID'
      'where'
      '  IDCONTABJURID = :OLD_IDCONTABJURID')
    Left = 230
    Top = 361
  end
