  object qryLkpCentroCusto: TwwQuery
    DatabaseName = 'BaseDados'
    Constrained = True
    SQL.Strings = (
      'SELECT UPPER(CC.NOME) NOME, CC.CODCENTROCUSTO'
      'FROM CENTCUST CC'
      'WHERE CC.IDEMPRESA = 1 AND'
      '      CC.STATUSGRUPOCDC = '#39'A'#39' AND'
      '      CC.IDPLANCENTCUST = 3'
      'ORDER BY UPPER(CC.NOME), CC.CODCENTROCUSTO'
