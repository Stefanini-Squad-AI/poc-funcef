  object qryParametroContabil: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    Constrained = True
    SQL.Strings = (
      'SELECT CJ.*, TP.NOMETIPOPROC, T.TIPDESCRICAO,'
      
        ' DECODE(CJ.INDPRINCIPAL,0,'#39'Principal'#39', 1,'#39'Correção Monetária'#39', 2' +
        ','#39'Juros'#39') AS TIPO'
      ' FROM CONTABJURID CJ, TIPOPROCESSO TP, TIPOPER T'
      ' WHERE CJ.IDTIPOPROC_DE = TP.IDTIPOPROC'
      '       AND CJ.TIPCODIGO = T.TIPCODIGO (+)'
      ' ORDER BY TP.NOMETIPOPROC, T.TIPDESCRICAO, TIPO DESC'
      ' '
      ' '
      ' '
      ' '
      ' ')
    UpdateObject = UpdParametroContabil
    ValidateWithMask = True
    Left = 231
    Top = 228
    object qryParametroContabilIDCONTABJURID: TFloatField
      FieldName = 'IDCONTABJURID'
    end
