  object SqlDet: TCMSqlParams
    SQL.Strings = (
      'SELECT ET.*,'
      '       TP.DESCRICAO AS ETAPA,'
      '       TP.VALORHONOR,'
      '       TP.FLGPENHORA,'
      '       TP.FLGENCERRAMENTO,'
      '       DECODE(NVL(ET.INDPENHORA, 0),'
      '              1,'
      '              '#39'Imóvel'#39','
      '              2,'
      '              '#39'Ativo'#39','
      '              3,'
      '              '#39'Invest.'#39','
      '              4,'
      '              '#39'Numer.'#39','
      '              '#39#39') AS TIPOPENH,'
      '       PENH.BEMPENHORADO,'
      '       SP.DESCPENHORA'
      '  FROM ETAPAPROCTRAB ET,'
      '       TIPORECTRAB TP,'
      '       SITUACAOPENHORA SP,'
      '       (SELECT DESBEM AS BEMPENHORADO, ET.NUMPROCTRAB, ET.NUMSEQ'
      '          FROM BEM B, ETAPAPROCTRAB ET'
      '         WHERE (B.IDBEM = ET.IDBEM)'
      '           AND (ET.NUMPROCTRAB = 19567)'
      '        UNION'
      
        '        SELECT DESCCONJUNTO AS BEMPENHORADO, ET.NUMPROCTRAB, ET.' +
        'NUMSEQ'
      '          FROM CONJUNTO C, ETAPAPROCTRAB ET'
      '         WHERE (C.IDCONJUNTO = ET.IDCONJUNTO)'
      '           AND (ET.NUMPROCTRAB = 19567)'
      '        UNION'
      
        '        SELECT IMONOME AS BEMPENHORADO, ET.NUMPROCTRAB, ET.NUMSE' +
        'Q'
      '          FROM IMOVEL I, ETAPAPROCTRAB ET'
      '         WHERE (I.IDIMOVEL = ET.IDIMOVEL)'
      '           AND (ET.NUMPROCTRAB = 19567)'
      '        UNION'
      
        '        SELECT DESCINVESTIMENTO AS BEMPENHORADO, ET.NUMPROCTRAB,' +
        ' ET.NUMSEQ'
      '          FROM INVESTIMENTO I, ETAPAPROCTRAB ET'
      '         WHERE (I.IDINVESTIMENTO = ET.IDINVESTIMENTO)'
      '           AND (ET.NUMPROCTRAB = 19567)'
      '        UNION'
      
        '        SELECT DESCFUNDOINVEST AS BEMPENHORADO, ET.NUMPROCTRAB, ' +
        'ET.NUMSEQ'
      '          FROM FUNDOINVEST I, ETAPAPROCTRAB ET'
      '         WHERE (I.IDFUNDOINVEST = ET.IDFUNDOINVEST)'
      '           AND (ET.NUMPROCTRAB = 19567)'
      '        UNION'
      
        '        SELECT '#39'Numerário = '#39' || TO_CHAR(VALORREC) AS BEMPENHORA' +
        'DO,'
      '               ET.NUMPROCTRAB,'
      '               ET.NUMSEQ'
      '          FROM ETAPAPROCTRAB ET'
      '         WHERE (ET.INDPENHORA = 4)'
      '           AND (ET.NUMPROCTRAB = 19567)) PENH'
      ' WHERE (ET.NUMPROCTRAB = 19567)'
      '   AND (ET.CODTIPORECURSO = TP.CODTIPORECURSO)'
      '   AND (ET.NUMPROCTRAB = PENH.NUMPROCTRAB(+))'
      '   AND (ET.NUMSEQ = PENH.NUMSEQ(+))'
      '   AND (ET.IDSITPENHORA = SP.IDSITUACAO(+))'
      ' ORDER BY ET.NUMSEQ'
      ' ')
    ClientDataSet = CdsDet
    Left = 515
    Top = 119
  end
