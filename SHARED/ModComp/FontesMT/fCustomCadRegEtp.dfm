  object CMSqlParams3: TCMSqlParams
    SQL.Strings = (
      
        'SELECT H.NUMPROCTRAB, H.NUMSEQ, T.CODTIPORECURSO, T.MOECODIGO, H' +
        '.DATAATU,'
      
        '       TO_CHAR(H.DATAATU,'#39'DD/MM/YYYY'#39') AS DATA_ULTIMA_ATUALIZACA' +
        'O,'
      '       H.VALORATU ULTIMO_VALOR_ATUALIZADO,'
      '       H.VALORATUCUSTAS ULTIMA_CUSTAS_ATUALIZADA,'
      '       '#39' '#39'  TIPO_AJUSTE,'
      '       H.TRGDTINCLUSAO,'
      '       H.TRGUSERINCLUSAO'
      '       FROM'
      '       HSTETAPAPROCTRAB H,'
      '       TIPORECTRAB T,'
      '       ETAPAPROCTRAB E,'
      '       MOEDA M'
      '       WHERE H.NUMPROCTRAB = 19567   AND'
      '       H.NUMSEQ         = 4    AND'
      '       H.CODTIPORECURSO = 360 AND'
      '       H.NUMPROCTRAB    = E.NUMPROCTRAB     AND'
      '       H.NUMSEQ         = E.NUMSEQ          AND'
      '       T.CODTIPORECURSO = H.CODTIPORECURSO  AND'
      '       T.MOECODIGO      = M.MOECODIGO'
      '       ORDER BY H.NUMPROCTRAB, H.NUMSEQ, H.DATAATU ')
    ClientDataSet = cdsHistoricoEtapas
    Left = 417
    Top = 317
  end
