  object qryTipoDesembolso: TwwQuery
    AutoCalcFields = False
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT T.CODTIPRECDES, T.RECPAG, T.PLANO, T.PLACONTA, T.PLACONTA' +
        'CREDITO, T.DESCRICAO, J.IDPROGRAMA'
      'FROM JUR_ETAPA_DESEMBOLSO J, TIPORECEBDESEMB T'
      'WHERE J.CODTIPRECDES = T.CODTIPRECDES'
      '      AND J.RECPAG = T.RECPAG'
      '      AND J.CODTIPORECURSO = 1043'
      '      AND J.RECPAG = '#39'P'#39
      ' '
      ' '
      ' '
      ' ')
    PictureMasks.Strings = (
      'VALORDESPESAADM'#9'###,###,#00.00'#9'T'#9'T')
    ValidateWithMask = True
    Left = 907
    Top = 404
    object qryTipoDesembolsoCODTIPRECDES: TStringField
      FieldName = 'CODTIPRECDES'
      Origin = 'BASEDADOS.TIPORECEBDESEMB.CODTIPRECDES'
      FixedChar = True
      Size = 15
    end
    object qryTipoDesembolsoRECPAG: TStringField
