  object CMSqlParams2: TCMSqlParams
    SQL.Strings = (
      
        'select e.numproctrab, e.codtiporecurso, p.IDPLANOPREV, p.IDPATRO' +
        ','
      'e.DATAREALOCOR, e.DATAPREVPAGTO, o.codtipoobjeto, '
      
        ' o.idtipoproc, o.tipcodigo, c.NOMETIPOPROC, T.TIPDESCRICAO, b.de' +
        'scricao   '
      
        'from Processotrab p, etapaproctrab e, JUR_ETAPAXOBJETOPROC J, ob' +
        'jproctrab o, TIPOPROCESSO c, TIPOPER T, tipoobjproctrab b '
      ' WHERE e.NUMPROCTRAB = 1'
      ' AND e.NUMSEQ = 1'
      ' AND e.CODTIPORECURSO = 1'
      '      And e.numproctrab = p.numproctrab'
      '      And e.numproctrab = j.numproctrab  '
      '      And e.codtiporecurso = j.codtiporecurso '
      '      And e.numseq = j.numseq                        '
      '      And j.numproctrab = o.numproctrab             '
      '      And j.codtipoobjeto = o.codtipoobjeto         '
      '      And o.IDTIPOPROC = c.IDTIPOPROC               '
      '      And o.TIPCODIGO = T.TIPCODIGO                 '
      '      and o.codtipoobjeto = b.codtipoobjeto         '
      ' ORDER BY CODTIPOOBJETO'
      ' '
      ' ')
    ClientDataSet = cdsEtapaxObjetos
    Left = 663
    Top = 211
  end
