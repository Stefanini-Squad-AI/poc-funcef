  object qry: TwwQuery
    Tag = 5
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '       ED.IDTPDESDOBRAMENTO,'
      '       ED.NUMPROCTRAB,'
      '       ED.CODTIPORECURSO,'
      '       ED.NUMSEQ,'
      '       ED.TPDESDOBRAMENTO,'
      '       CASE ED.TPDESDOBRAMENTO'
      '         WHEN 1 THEN '#39'Controverso'#39
      '       WHEN 2 THEN '#39'Incontroverso'#39
      '       END DESCDESDOBRAMENTO,'
      '       ED.DATADEPOSITO,'
      '       ED.VLRCREDITADO,'
      '       ED.TPIMPUGCALCULO,'
      '       CASE ED.TPIMPUGCALCULO'
      '       WHEN 1 THEN '#39'Interno'#39
      '       WHEN 2 THEN '#39'Externo'#39
      '       END DESCTPIMPUGCALCULO,'
      '       ED.IDCBANCARIA,'
      '       ED.CODPORTADOR,'
      
        '       (SELECT PC.IDBANCO ||'#39#39' / '#39#39'||PC.IDAGENCIA||'#39#39' / '#39#39'||PC.N' +
        'OCONTACORR FROM PORTADORCONTA PC'
      '       WHERE PC.CODPORTADOR = ED.CODPORTADOR) AS DESCPORTADOR,'
      
        '       (SELECT CB.IDAGENCIA||'#39#39' / '#39#39'||CB.CONTACORRENTE FROM CONT' +
        'ABANCARIA CB'
      '       WHERE CB.IDCBANCARIA = ED.IDCBANCARIA) AS DESCBANCARIA,'
      '       ED.VLRCALCCONTADORIA, ED.DATACONTADORIA'
      'FROM'
      '       ETPDESDOBRAMENTO ED'
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' ')
    PictureMasks.Strings = (
      'VLRCREDITADO'#9'###,###,##0.00'#9'T'#9'T'
      'VLRCALCCONTADORIA'#9'###,###,##0.00'#9'T'#9'T'
      'DATADEPOSITO'#9'DD/MM/YYYY'#9'T'#9'F')
    ValidateWithMask = True
    Left = 312
    Top = 78
