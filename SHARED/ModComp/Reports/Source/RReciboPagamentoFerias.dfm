  object sqlReciboPagamento: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  /* ---------------------------------- */'
      '  /* Dados da Primeira Página ou Pessoa */'
      '  /* ---------------------------------- */'
      '  LPAD('#39'1'#39',20,'#39'1'#39')  AS MESANO,      -- SOL 217186-15443'
