  object sqlCracha: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT'
      '  ('#39'Praia Clube Sociedade Civil'#39')  AS EMPRESA,'
      '  RTRIM(PF.NOME) AS NOME, F.MATRICULA, PJ.IDIMAGEM AS IDLOGO,'
      
        '  PF.IDIMAGEM, PF.IDPESSOA, RTRIM(PF.HOMEPAGE) AS APELIDO, PEFIS' +
        '.TIPOSANG,'
      '  PEFIS.DATANASC, PEFIS.NOMEPAI, PEFIS.NOMEMAE,'
      '  RG.NUMDOCUMENTO AS NUMCARTIDENT, RG.DATAEMISSAO, RG.ORGAO,'
      '  RTRIM(ST.DESCRICAO) AS SITUACAO,'
      '  RTRIM(F.MATRICULA) AS CODBARRA,'
      '  TO_CHAR(F.DATAADMISSAO, '#39'DD/MM/YYYY'#39') AS DATAADMISSAO,'
      '  DECODE(PEFIS.SEXO,'#39'F'#39','#39'Feminino'#39','#39'M'#39','#39'Masculino'#39','#39#39') AS SEXO,'
      '  PEFIS.ESTCIVIL AS ESTCIVIL,'
      '  F.TIPOCONTRATO AS VINCULO,'
      '  E.LOGRADOURO, E.BAIRRO, E.CEP, E.NUMERO, CI.NOME AS CIDADE,'
      
        '  (CI.NOME ||'#39#39'-'#39#39'|| ES.CODESTADO) AS CIDADE_UF, ES.CODESTADO, E' +
        '.COMPLEMENTO, '
      
        '  PJ.NOME AS ESTAB, SUBSTR(C.TITULO,INSTR(C.TITULO,'#39'/'#39')+1,30) AS' +
        ' CARGO,'
      
        '  PR.DESCRICAO AS PROFISSAO, NVL(F.SALARIOATUAL,0) AS SALARIOATU' +
        'AL,  '
      '  DECODE(CCE.CCUSTOESP,NULL,CC.NOME,CCE.CCUSTOESP) AS C_CUSTO,'
      '  F.TIPOPAGAMENTO,   '
      '  GR.DESCRICAO AS GRINSTR '
      'FROM'
      
        '  PESSOA PJ, PESSOA PF, PESSOAFISICA PEFIS, ENDPESS E, FUNCIONAR' +
        'IO F,  '
      
        '  SITFUNC ST, CIDADES CI, CARGO C, PROFISS PR, CENTCUST CC, GRIN' +
        'STR GR,  '
      '  ESTADO ES,'
      '  (SELECT D.IDPESSOA, D.NUMDOCUMENTO, D.DATAEMISSAO, D.ORGAO   '
      '     FROM DOCPESSOA D, TIPODOCOFICIAL T '
      '    WHERE (T.CODDOCUMENTO = '#39'25'#39') AND  '
      '       (D.IDDOCUMENTO  = T.IDDOCUMENTO)) RG,  '
      '  (SELECT D.IDPESSOA, D.NUMDOCUMENTO AS CCUSTOESP '
      '   FROM   DOCPESSOA D, TIPODOCOFICIAL T '
      '   WHERE (T.SIGLADOCUMENTO = '#39'LOTACAO:'#39') AND'
      '         (T.IDDOCUMENTO    = D.IDDOCUMENTO)) CCE'
      'WHERE'
      '  (PF.IDPESSOA         = PEFIS.IDPESSOA) AND'
      '  (PF.IDPESSOA         = F.IDPESSOA) AND  '
      '  (ST.IDSITFUNC        = F.IDSITFUNC) AND'
      '  (F.IDESTAB           = PJ.IDPESSOA) AND  '
      '  (F.IDCARGO           = C.IDCARGO(+)) AND'
      '  (PEFIS.IDPROFISS     = PR.IDPROFISS(+)) AND'
      '  (F.CODCENTROCUSTO    = CC.CODCENTROCUSTO(+)) AND'
      '  (F.IDEMPRESA         = CC.IDEMPRESA(+)) AND'
      '  (PEFIS.IDGRINSTR     = GR.IDGRINSTR(+)) AND'
      '  (PF.IDPESSOA         = RG.IDPESSOA(+)) AND'
      '  (PF.IDPESSOA         = CCE.IDPESSOA(+)) AND'
      '  (PF.IDPESSOA         = E.IDPESSOA(+)) AND'
      '  (PF.IDENDRESIDENCIAL = E.IDENDERECO(+)) AND'
      '  (E.IDCIDADES         = CI.IDCIDADES(+)) AND'
      '  (CI.IDESTADO         = ES.IDESTADO(+))')
    ClientDataSet = CdsCracha
    Left = 204
    Top = 200
  end
