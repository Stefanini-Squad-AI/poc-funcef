  object sqlDemonstrativoDBC: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  /* ---------------------------------- */'
      '  /* Dados da Primeira Página ou Pessoa */'
      '  /* ---------------------------------- */'
      '  LPAD('#39'1'#39',20,'#39'1'#39')  AS MESANO,      -- SOL 217186-15443'
      '  LPAD('#39'1'#39',60,'#39'1'#39') AS EMPREGADO,'
      '  0 AS PAGINA,'
      '  LPAD('#39'1'#39',20,'#39'1'#39') AS MATRICULA,'
      '  LPAD('#39'1'#39',50,'#39'1'#39') AS C_CUSTO,'
      '  LPAD('#39'1'#39',60,'#39'1'#39') AS CARGO,'
      '  LPAD('#39'1'#39',60,'#39'1'#39') AS EMPRESA,'
      '  LPAD('#39'1'#39',25,'#39'1'#39') AS CGC,'
      '  LPAD('#39'1'#39',25,'#39'1'#39') AS CPF,'
      '  LPAD('#39'1'#39',25,'#39'1'#39') AS PIS,'
      '  LPAD('#39'1'#39',15,'#39'1'#39') AS NUMCONTASALARIO,'
      '  LPAD('#39'1'#39',15,'#39'1'#39') AS NUMAGENCIA,'
      '  LPAD('#39'1'#39',15,'#39'1'#39') AS NUMBANCO,'
      '  '#39'1234567890'#39' AS CODCENTROCUSTO,'
      '  '#39'E'#39' AS TIPOCONTRATO,'
      '  0 AS NUMDEPIRRF,'
      '  0 AS NUMDEPSALF,'
      '  /* 1º LINHA */'
      
        '  '#39'1234567890'#39' AS CODRUBRICA1, LPAD('#39'1'#39',60,'#39'1'#39') AS RUBRICA1, '#39'12' +
        '34567890'#39' AS REFERENCIA1, 0 AS PROVENTO1, 0 AS DESCONTO1, 0 AS V' +
        'ALOR1,'
      '  /* 2º LINHA */'
      
        '  '#39'1234567890'#39' AS CODRUBRICA2, LPAD('#39'1'#39',60,'#39'1'#39') AS RUBRICA2, '#39'12' +
