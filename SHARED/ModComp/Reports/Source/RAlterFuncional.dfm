  object sqlAlterFuncional: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT'
      '  '#39'1234567890'#39' AS IDPESSOA,'
      
        '  '#39'1234567890123456789012345678901234567890123456789012345678901' +
        '234567890'#39' AS EMPRESA,'
