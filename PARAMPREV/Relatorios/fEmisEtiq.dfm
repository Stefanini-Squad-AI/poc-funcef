  object QryModelo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      'IDETIQUETA, MODELOETIQ, IDREPORTS, ORIGEMCM    '
      'FROM ETIQUETA'
      'ORDER BY MODELOETIQ')
