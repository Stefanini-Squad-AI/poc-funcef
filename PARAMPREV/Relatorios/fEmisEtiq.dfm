  object QryPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '
      '  P.IDPESSOA, '
      
        '  DECODE(PE.RAZAOSOCIAL,NULL,PE.NOME,PE.RAZAOSOCIAL) AS NOMEPESS' +
        'OA'
      'FROM'
      '  PESSOA PE, PATRO P'
      'WHERE'
      '  P.IDPESSOA = PE.IDPESSOA'
      'ORDER BY'
      '  PE.RAZAOSOCIAL'
      '')
    ValidateWithMask = True
    Left = 584
    Top = 52
