  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT'
      ' PESSOA.IDPESSOA ,'
      ' PESSOA.IDIMAGEM,'
      ' PESSOA.NOME ,'
      ' PESSOA.TIPO ,'
      ' PESSOA.RAZAOSOCIAL ,'
      ' PESSOA.NUMDOCUMENTO ,'
      ' PESSOA.IDDOCUMENTO ,'
      ' PESSOA.EMAIL ,'
      ' PESSOA.IDGRUPO,'
      ' PESSOA.IDENDCOMERCIAL,'
      ' PESSOA.IDENDRESIDENCIAL,'
      ' PESSOA.IDENDENTREGA,'
      ' PESSOA.IDENDCOBRANCA,'
      ' PESSOA.IDENDCORRESP,'
      ' G.NOME AS NOMEGRUPO,'
      ' PESSOA.HOMEPAGE,'
      ' PESSOA.IDMODULORESPON,'
      ' MODULO.NOMEMODULO'
      ''
      'FROM PESSOA, PESSOA g, MODULO'
      'WHERE ( PESSOA.IDPESSOA =:IdPessoa )  AND'
      '         ( PESSOA.IDMODULORESPON = MODULO.IDMODULO(+)  ) AND'
      '      ( PESSOA.IDGRUPO = G.IDPESSOA(+)   ) '
      '    '
      ' '
      ' ')
    Left = 551
  end
  inherited CmeDetalhe: TCmEventosCadastro
    Left = 314
  end
  inherited updSubTipo: TUpdateSQL
    ModifySQL.Strings = (
      'update FUNDACAO'
      'set'
      '  FLGTIPOPREVIDENC = :FLGTIPOPREVIDENC,'
      '  IDRUBLIQEMPRESTI = :IDRUBLIQEMPRESTI,'
      '  IDRUBLIQASSISTEN = :IDRUBLIQASSISTEN,'
      '  IDRUBLIQPREVIDEN = :IDRUBLIQPREVIDEN,'
      '  DIAFOLHA = :DIAFOLHA,'
      '  FLGUTILFOLHA = :FLGUTILFOLHA,'
      '  FLGANTERIORFOLHA = :FLGANTERIORFOLHA,'
      '  FLGMESFOLHA = :FLGMESFOLHA,'
      '  IDRUBBENEFLIQUIDO = :IDRUBBENEFLIQUIDO,'
      '  IDCALENDARIO = :IDCALENDARIO,'
      '  CODFUNDSPC = :CODFUNDSPC,'
      '  IDRGMATRICDEP = :IDRGMATRICDEP,'
      '  FLGENVACERTOFALEC = :FLGENVACERTOFALEC,'
      '  FLGENVACFALBF = :FLGENVACFALBF'
      'where'
      '  IDPESSOA = :OLD_IDPESSOA')
    InsertSQL.Strings = (
      'insert into FUNDACAO'
      
        '  (IDPESSOA, FLGTIPOPREVIDENC, IDRUBLIQEMPRESTI, IDRUBLIQASSISTE' +
        'N,'
      'IDRUBLIQPREVIDEN,'
      '   DIAFOLHA, FLGUTILFOLHA, FLGANTERIORFOLHA, FLGMESFOLHA,'
      'IDRUBBENEFLIQUIDO,'
      
        '   IDCALENDARIO, CODFUNDSPC, IDRGMATRICDEP, FLGENVACERTOFALEC, F' +
        'LGENVACFALBF)'
      'values'
      '  (:IDPESSOA, :FLGTIPOPREVIDENC, :IDRUBLIQEMPRESTI,'
      ':IDRUBLIQASSISTEN,'
      
        '   :IDRUBLIQPREVIDEN, :DIAFOLHA, :FLGUTILFOLHA, :FLGANTERIORFOLH' +
        'A,'
      ':FLGMESFOLHA,'
      
        '   :IDRUBBENEFLIQUIDO, :IDCALENDARIO, :CODFUNDSPC, :IDRGMATRICDE' +
        'P,'
      ':FLGENVACERTOFALEC, :FLGENVACFALBF )'
      ' ')
    DeleteSQL.Strings = (
      'delete from FUNDACAO'
      'where'
      '  IDPESSOA = :OLD_IDPESSOA')
    Left = 603
    Top = 74
  end
  inherited qrySubTipo: TwwQuery
    BeforePost = qrySubTipoBeforePost
    SQL.Strings = (
      'SELECT FUNDACAO.IDPESSOA,'
      '       FUNDACAO.FLGTIPOPREVIDENC,'
      '       FUNDACAO.IDRUBLIQEMPRESTI,'
      '       FUNDACAO.IDRUBLIQASSISTEN,'
      '       FUNDACAO.IDRUBLIQPREVIDEN,'
      '       FUNDACAO.DIAFOLHA,'
      '       FUNDACAO.FLGUTILFOLHA,'
      '       FUNDACAO.FLGANTERIORFOLHA,'
      '       FUNDACAO.FLGMESFOLHA,'
      '       FUNDACAO.IDRUBBENEFLIQUIDO,'
      '       FUNDACAO.IDCALENDARIO,'
      '       FUNDACAO.CODFUNDSPC,'
      '       FUNDACAO.IDRGMATRICDEP,'
      '       FUNDACAO.FLGENVACERTOFALEC,'
      '       FUNDACAO.FLGENVACFALBF'
      'FROM   FUNDACAO'
      'WHERE  (FUNDACAO.IDPESSOA =:IdPessoa)'
      ''
      ' '
      ' ')
    Left = 541
    Top = 77
  end
