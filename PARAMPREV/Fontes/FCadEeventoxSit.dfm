  object qrysitfunc: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT  SIT.DESCRICAO , SIT.IDSITFUNC'
      'FROM SITFUNC SIT '
      'WHERE '
      'SIT.IDSITFUNC '
      'NOT IN ( SELECT  E.IDSITFUNC FROM EVENTOXSITFUNC E'
      'WHERE  E.IDEVENTOGERADOR = :IDEVENTO)'
      'AND SIT.FLGUSO IN ('#39'G'#39','#39'P'#39')'
      'ORDER BY SIT.DESCRICAO')
    ValidateWithMask = True
    Left = 275
    Top = 85
    ParamData = <
      item
        DataType = ftString
        Name = 'IDEVENTO'
        ParamType = ptUnknown
      end>
  end
  object dssitfunc: TwwDataSource
    AutoEdit = False
    DataSet = qrysitfunc
    Left = 323
    Top = 77
  end
  object qrysitfuncrel: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT SIT.DESCRICAO , SIT.IDSITFUNC , SIT.FLGINTERNO'
      'FROM SITFUNC SIT , EVENTOXSITFUNC E'
      'WHERE '
      'SIT.FLGUSO IN ('#39'G'#39','#39'P'#39')'
      'AND SIT.IDSITFUNC = E.IDSITFUNC'
      'AND E.IDEVENTOGERADOR = :IDEVENTO'
      'ORDER BY SIT.DESCRICAO')
    ValidateWithMask = True
    Left = 643
    Top = 245
    ParamData = <
      item
        DataType = ftString
        Name = 'IDEVENTO'
        ParamType = ptUnknown
      end>
  end
