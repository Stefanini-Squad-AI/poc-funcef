  object qryCargo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select distinct C.TITULO as TITULO'
      'from CARGO C, FUNCIONARIO F, PROCESSOTRAB P'
      'where  C.IDCARGO  = F.IDCARGO'
      'and    F.IDPESSOA = P.IDRECLAMANTE'
      'order by upper(TITULO)')
    ValidateWithMask = True
    Left = 417
    Top = 84
  end
