  object qryCidade: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select C.IDCIDADES, E.IDESTADO, E.CODESTADO, C.NOME'
      'from CIDADES C, ESTADO E'
      'where'
      '     (C.IDESTADO = E.IDESTADO)'
      'and'
      '     (1 = 1)'
      'order by upper(C.NOME)')
    ValidateWithMask = True
    Left = 25
    Top = 320
