  object qryAdvog1: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select IDPESSOA, NOME from PESSOA '
      'where IDPESSOA in '
      '          (Select distinct IDADVOGRECDA from PROCESSOTRAB '
      '           Where IDADVOGRECDA is Not Null)'
      'order by upper(NOME)')
