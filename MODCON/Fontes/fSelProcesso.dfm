  object tblEstab: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select IDPESSOA, NOME from PESSOA '
      'where (IDGRUPO = :IdEmpresaProp ) '
      'OR    (IDGRUPO IN (SELECT IDPESSOA FROM PESSOA '
      '          WHERE IDGRUPO = :IdEmpresaProp ))'
      'OR   (IDGRUPO IN (SELECT IDPESSOA FROM PESSOA '
      '         WHERE IDGRUPO  IN (SELECT IDPESSOA FROM PESSOA '
      
        '                                                WHERE IDGRUPO = ' +
        ':IdEmpresaProp )))'
      'OR   (IDGRUPO IN (SELECT IDPESSOA FROM PESSOA '
      '         WHERE IDGRUPO  IN (SELECT IDPESSOA FROM PESSOA '
      
        '                                                WHERE IDGRUPO IN' +
        ' '
      
        '                                               (SELECT IDPESSOA ' +
        'FROM PESSOA '
      
        '                                                WHERE IDGRUPO = ' +
        ':IdEmpresaProp ))))'
      'order by upper(NOME)')
    ValidateWithMask = True
    Left = 100
    Top = 363
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IdEmpresaProp'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IdEmpresaProp'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IdEmpresaProp'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IdEmpresaProp'
        ParamType = ptUnknown
      end>
  end
