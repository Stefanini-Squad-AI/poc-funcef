unit FCadUsrxCCustoMT;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  FCadastroMT, Grids, Wwdbigrd, Wwdbgrid, Buttons, StdCtrls, MontaSelect,
  Db, DBClient, uCMClientDataSet, CmEventosCadastro, ImgList, Wwdatsrc,
  IvDictio, IvMulti, IvEMulti, MAHlpBtn, TB97Tlbr, TB97Ctls, TB97, ExtCtrls,
  uCtrlUsrCCusto
{$IFNDEF VERSAO0505}
  , uCmTypes
{$ENDIF}
;

type
  TFrmCadUsrxCCustoMT = class(TFrmCadastroMT)
    EdUsu: TEdit;
    Label1: TLabel;
    plnTransf: TPanel;
    grdTranf: TwwDBGrid;
    grgCCusto: TwwDBGrid;
    Panel1: TPanel;
    Panel2: TPanel;
    CdsCCusto: TCMClientDataSet;
    DsCCusto: TwwDataSource;
    BtnAdicionaTudo: TSpeedButton;
    btnAdiciona: TSpeedButton;
    BtnRemove: TSpeedButton;
    btnRemoveTudo: TSpeedButton;
    procedure FormCreate(Sender: TObject);
    procedure CmeCadastroFind(Sender: TObject);
    procedure CmeCadastroInsert(Sender: TObject);
    procedure CmeCadastroCancel(Sender: TObject);
    procedure btnAdicionaClick(Sender: TObject);
    procedure BtnRemoveClick(Sender: TObject);
    procedure bbtnConfirmarClick(Sender: TObject);
    procedure CmeCadastroAbortConfirma(sender: TObject;
      OrigemAbortConfirma: TOrigemAbortConfirma);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure BtnAdicionaTudoClick(Sender: TObject);
    procedure btnRemoveTudoClick(Sender: TObject);
    procedure CmeCadastroApplyEdit(sender: TObject; var Accept: Boolean);
  private
    { Private declarations }
     Procedure Seleciona( IdUsuario: Double );
  public
    { Public declarations }
    iIdUsuario: Double;
    UsrCCusto: TCtrlUsrCCusto;
  end;

var
  FrmCadUsrxCCustoMT: TFrmCadUsrxCCustoMT;

implementation

{$R *.DFM}

Uses uMensErro, dBasedados, uSistema, uMidasUtil;

Procedure TFrmCadUsrxCCustoMT.Seleciona( IdUsuario: Double );
Begin
  cds.Data := UsrCCusto.ListaUsrCCusto( Sistema.IdEmpresa, IdUsuario );

  If IdUsuario = -1 Then
     cdsCCusto.Data := UsrCCusto.ListaUsrCCustoUsr( IdUsuario, IdUsuario )
  Else
     cdsCCusto.Data := UsrCCusto.ListaUsrCCustoUsr( Sistema.IdEmpresa, IdUsuario );
end;

procedure TFrmCadUsrxCCustoMT.FormCreate(Sender: TObject);
begin
  inherited;
  UsrCCusto := TCtrlUsrCCusto.Create;
  UsrCCusto.Initialize( DtmBaseDados.dbBaseDados, True, Sistema.ConnectionType,
                        Sistema.ConnectionSide, Sistema.AppRemoteServer, True );
  UsrCCusto.cds := cds;

  CmeCadastro.RepetirInsert := False;
  iIdUsuario := -1;
  Seleciona( iIdUsuario );
  EdUsu.Clear;
end;

procedure TFrmCadUsrxCCustoMT.CmeCadastroFind(Sender: TObject);
begin
  inherited;
  If MontaSelect.RetornouValor Then Begin
     iIdUsuario := StrToFloat( MontaSelect.ValoresChave[ 0 ] );
     edUsu.Text := MontaSelect.ValoresChave[ 1 ];
     Seleciona( iIdUsuario );
  End;
end;

procedure TFrmCadUsrxCCustoMT.CmeCadastroInsert(Sender: TObject);
begin
  If Trim( edUsu.Text ) = '' Then Begin
     MsgDlg( 'Não há Nenhum Usuário selecionado', 'Atenção', mtWarning, [mbOk], 0 );
     bbtnCancelar.Click;
  End;
end;

procedure TFrmCadUsrxCCustoMT.CmeCadastroCancel(Sender: TObject);
begin
  inherited;
  If Trim( edUsu.Text ) <> '' Then Begin
     Seleciona( iIdUsuario );
  End Else Begin
     Seleciona( -1 );
     edUsu.Clear;
  End;
end;

procedure TFrmCadUsrxCCustoMT.btnAdicionaClick(Sender: TObject);
begin
  inherited;
  If CmeCadastro.Operacao in [ opInserir, opAlterar ] Then Begin
     If Not CdsCCusto.IsEmpty Then Begin
        With Cds Do Begin
             Append;
             FieldByName( 'IDUSUARIO' ).AsFloat       := iIdUsuario;
             FieldByName( 'IDPESSOA' ).AsFloat        := Sistema.IdEmpresa;
             FieldByName( 'CODCENTROCUSTO' ).asString := CdsCCusto.FieldByName( 'CODCENTROCUSTO' ).asString;
             FieldByName( 'IDEMPRESA' ).asFloat       := CdsCCusto.FieldByName( 'IDEMPRESA' ).asFloat;
             FieldByName( 'NOME' ).asString           := CdsCCusto.FieldByName( 'NOME' ).asString;
             Post;
        End;

        CdsCCusto.Delete;
     End;
  End;
end;

procedure TFrmCadUsrxCCustoMT.BtnRemoveClick(Sender: TObject);
begin
  inherited;
  If CmeCadastro.Operacao in [ opInserir, opAlterar ] Then Begin
     If Not Cds.IsEmpty Then Begin
        With CdsCCusto Do Begin
             Append;
             FieldByName( 'CODCENTROCUSTO' ).asString := Cds.FieldByName( 'CODCENTROCUSTO' ).asString;
             FieldByName( 'IDEMPRESA' ).asFloat       := Cds.FieldByName( 'IDEMPRESA' ).asFloat;
             FieldByName( 'NOME' ).asString           := Cds.FieldByName( 'NOME' ).asString;
             Post;
        End;

        Cds.Delete;
     End;
  End;
end;

procedure TFrmCadUsrxCCustoMT.bbtnConfirmarClick(Sender: TObject);
begin
  inherited;
  bbtnCancelar.Click;
end;

procedure TFrmCadUsrxCCustoMT.CmeCadastroAbortConfirma(sender: TObject;
  OrigemAbortConfirma: TOrigemAbortConfirma);
begin
  inherited;
  MsgDlg( UsrCCusto.MessageInfo, 'Erro', mtError, [ mbOK ], 0 );
end;

procedure TFrmCadUsrxCCustoMT.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  inherited;
  UsrCCusto.Free;
end;

procedure TFrmCadUsrxCCustoMT.BtnAdicionaTudoClick(Sender: TObject);
begin
  inherited;
  cdsCCusto.First;

  While Not cdsCCusto.Eof Do
        btnAdiciona.Click;
end;

procedure TFrmCadUsrxCCustoMT.btnRemoveTudoClick(Sender: TObject);
begin
  inherited;
  cds.First;

  While Not cds.Eof Do
        btnRemove.Click;
end;

procedure TFrmCadUsrxCCustoMT.CmeCadastroApplyEdit(sender: TObject;
  var Accept: Boolean);
begin
  inherited;
  UsrCCusto.Gravar;
  Seleciona( iIdUsuario );
end;

end.

