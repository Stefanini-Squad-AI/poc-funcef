unit FCadMoedaMT;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  FCadastroMT, wwdbdatetimepicker, CMDateTimePicker, StdCtrls, TREdit,
  wwdblook, ExtCtrls, DBCtrls, wwdbedit, Mask, Wwdotdot, Wwdbcomb,
  MontaSelect, Db, DBClient, uCMClientDataSet, CmEventosCadastro, ImgList,
  Wwdatsrc, IvDictio, IvMulti, IvEMulti, MAHlpBtn, Buttons, TB97Tlbr,
  TB97Ctls, TB97, uCtrlMoeda
{$IFNDEF VERSAO0505}
  , uCmTypes
{$ENDIF}
;

type
  TFrmCadMoedaMT = class(TFrmCadastroMT)
    lblMoeSigla: TLabel;
    lblMoeDesc: TLabel;
    lblMoePeriodicidade: TLabel;
    Label5: TLabel;
    cmbPeriodo: TwwDBComboBox;
    dbedMoeSigla: TwwDBEdit;
    dbedMoeDesc: TwwDBEdit;
    pnlMoeInativo: TPanel;
    DBCkbInativa: TDBCheckBox;
    dbRdgpTipo: TDBRadioGroup;
    GroupBox1: TGroupBox;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    Label4: TLabel;
    dblkMoeRef: TwwDBLookupCombo;
    dbredFator: TDBRealEdit;
    dbdtIni: TCMDateTimePicker;
    dbdtFim: TCMDateTimePicker;
    DbEdTaxa: TwwDBEdit;
    CdsMoedaRef: TCMClientDataSet;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure CmeCadastroFind(Sender: TObject);
    procedure CmeCadastroApplyInsert(sender: TObject; var Accept: Boolean);
    procedure CmeCadastroApplyEdit(sender: TObject; var Accept: Boolean);
    procedure CmeCadastroApplyDelete(sender: TObject; var Accept: Boolean);
    procedure CmeCadastroAbortConfirma(sender: TObject;
      OrigemAbortConfirma: TOrigemAbortConfirma);
    procedure CmeCadastroInsert(Sender: TObject);
    procedure CmeCadastroEdit(Sender: TObject);
    procedure CmeCadastroBeforeConfirma(sender: TObject;
      var Accept: Boolean);
  private
    { Private declarations }
    Moeda: TCtrlMoeda;
    Procedure Seleciona( IdMoeda: Double = 0 );
  public
    { Public declarations }
  end;

var
  FrmCadMoedaMT: TFrmCadMoedaMT;

implementation

{$R *.DFM}

Uses uMensErro, dBasedados, uSistema, uMidasUtil;

procedure TFrmCadMoedaMT.Seleciona( IdMoeda: Double = 0 );
begin
  Cds.Data := Moeda.ListaMoeda( IdMoeda, True );
end;

procedure TFrmCadMoedaMT.FormCreate(Sender: TObject);
begin
  inherited;
  Moeda := TCtrlMoeda.Create;
  Moeda.Initialize( DtmBaseDados.dbBaseDados, True, Sistema.ConnectionType,
                    Sistema.ConnectionSide, Sistema.AppRemoteServer, True );
  Moeda.cds := cds;
  CdsMoedaRef.Data := Moeda.ListaMoeda();
  Seleciona( -1 );
end;

procedure TFrmCadMoedaMT.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  inherited;
  Moeda.Free;
end;

procedure TFrmCadMoedaMT.CmeCadastroFind(Sender: TObject);
begin
  inherited;
  IF MontaSelect.RetornouValor Then Begin
     Seleciona( StrToFloat( MontaSelect.ValoresChave[ 0 ] ) );
     CdsMoedaRef.Data := Moeda.ListaMoeda( StrToFloat( MontaSelect.ValoresChave[ 0 ] ) );
  End;
end;

procedure TFrmCadMoedaMT.CmeCadastroApplyInsert(sender: TObject;
  var Accept: Boolean);
begin
  inherited;
  Cds.FieldByName( 'IdUsuarioInclusao' ).AsFloat := Sistema.IdUsuario;
  Accept := Moeda.Gravar;
end;

procedure TFrmCadMoedaMT.CmeCadastroApplyEdit(sender: TObject;
  var Accept: Boolean);
begin
  inherited;
  Accept := Moeda.Gravar;
end;

procedure TFrmCadMoedaMT.CmeCadastroApplyDelete(sender: TObject;
  var Accept: Boolean);
begin
  inherited;
  Accept := Moeda.Gravar;
end;

procedure TFrmCadMoedaMT.CmeCadastroAbortConfirma(sender: TObject;
  OrigemAbortConfirma: TOrigemAbortConfirma);
begin
  inherited;
  MsgDlg( Moeda.MessageInfo, 'Erro', mtError, [ mbOK ], 0 );
end;

procedure TFrmCadMoedaMT.CmeCadastroInsert(Sender: TObject);
begin
  inherited;
  Cds.FieldByName( 'MoePeriodicidade' ).AsString := 'D';
  Cds.FieldByName( 'MoeInativo' ).AsString       := 'A';
  Cds.FieldByName( 'FlgPercValor' ).AsString     := 'V';
  Cds.FieldByName( 'IdUsuarioInclusao' ).AsFloat := Sistema.IdUsuario;
  dbedMoeSigla.SetFocus;
end;

procedure TFrmCadMoedaMT.CmeCadastroEdit(Sender: TObject);
begin
  inherited;
  dbedMoeSigla.SetFocus;
end;

procedure TFrmCadMoedaMT.CmeCadastroBeforeConfirma(sender: TObject;
  var Accept: Boolean);
var
  cdsaux: TClientDataset;
begin
  inherited;
  If CmeCadastro.Operacao In [ OpInserir, OpAlterar ] Then Begin
     CdsAux := TClientDataset.Create( Self );

     If CmeCadastro.Operacao = OpInserir Then
        CdsAux.Data := Moeda.GetDataPacket( 'Select MoeCodigo From Moeda Where Upper( MoeSigla ) = ' +
                                            QuotedStr( UpperCase( Cds.FieldByName( 'MoeSigla' ).AsString ) ) )
     Else
        CdsAux.Data := Moeda.GetDataPacket( 'Select MoeCodigo From Moeda Where Upper( MoeSigla ) = ' +
                                            QuotedStr( UpperCase( Cds.FieldByName( 'MoeSigla' ).AsString ) ) +
                                            ' And MoeCodigo <> ' + Cds.FieldByName( 'MoeCodigo' ).AsString );

     If Not CdsAux.IsEmpty Then Begin
        Moeda.MessageInfo := 'Existe outra Moeda cadastrada com esta sigla.';
        Accept := False;
        dbedMoeSigla.SetFocus;
     End;

     CdsAux.Close;
     CdsAux.Free;
  End;
end;

end.
