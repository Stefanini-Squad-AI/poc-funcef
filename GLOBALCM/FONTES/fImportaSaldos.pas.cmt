unit fImportaSaldos;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  FImporta, OpenArqText, Db, DBTables, wwQuery, MAHlpBtn, StdCtrls,
  Buttons, TB97, ComCtrls, wwdblook, ExtCtrls, uSistema, TB97Tlbr,
  IvDictio, IvMulti, IvEMulti;

type
  TfrmImportaSaldos = class(TfrmImporta)
    Label2: TLabel;
    edPlano: TEdit;
    Label3: TLabel;
    qryPlano: Twwquery;
    dblkExercicio: TwwDBLookupCombo;
    Label4: TLabel;
    qryExercicio: Twwquery;
    procedure FormActivate(Sender: TObject);
    procedure btnImportaClick(Sender: TObject);
    procedure OutrosSERPROSSaldos(Var sSQLImp,sSQLValues : String; qryAuxImp : TQuery);
  private
    { Private declarations }
   sMascara, sMascPict : String;
   lNivel      : Array [0..20] of Integer;
   iSoma, ind, iProxCod: Integer;
   sPai   : String;
  public
    { Public declarations }
  end;

var
  frmImportaSaldos: TfrmImportaSaldos;

implementation

uses DBaseDados,UAutorizacao,UMensErro, UPlanoContas;

{$R *.DFM}



procedure TfrmImportaSaldos.FormActivate(Sender: TObject);
begin
  inherited;
  qryPlano.SQL.Clear;
  qryPlano.SQL.Text := 'SELECT PARAM.PLANO,PLN.DESCPLANO,PLN.MASCARA FROM PARAMCONTAB PARAM,PLANO PLN WHERE IDPESSOA = '{ivlm} + InttoStr(Sistema.IdEmpresa) + ' AND PLN.PLANO = PARAM.PLANO'{ivlm};
  qryPlano.Open;
  edPlano.Text := qryPlano.FieldByName('DESCPLANO'{ivlm}).AsString;
  sMascara := qryPlano.FieldByName('MASCARA'{ivlm}).AsString;
  qryExercicio.SQL.Clear;
  qryExercicio.SQL.Text := 'SELECT DISTINCT PEREXERCICIO FROM PERIODO WHERE IDPESSOA = '{ivlm}+ InttoStr(Sistema.IdEmpresa);
  qryExercicio.Open;
end;

procedure TfrmImportaSaldos.btnImportaClick(Sender: TObject);
Var
  i,iMaxList,iZeros,iGrau : Integer;
  sSQLImp,
  sSQLValues, sPlaconta   : String;
  qryAuxImp               : TQuery;
  lChecked,lProblema      : Boolean;
begin
  inherited;
  lProblema := false;
  prgbrImportar.Visible := true;
  prgbrImportar.Max     := mmTxt.Lines.Count;  
  mmTxt.Clear;
  mmTxt.Lines.Add(Translate('Contas Contábeis não Importadas'));
  If StrtoInt(dblkExercicio.LookupValue) = 0 Then Begin
     MsgDlg('Escolha o exercício',LerMensagem(2),mtWarning,[mbOk],0);
     exit;
  end;

  if not VerificaMascara(sMascara,sMascPict,lNivel,iSoma,ind) Then Begin
     MsgDlg('Máscara do Plano de Contas Inconsistente',LerMensagem(2),mtWarning,[mbOk],0);
     exit;
  end;
  lChecked   := False;
  sSQLImp    := '';
  if not opDlgTxt.AbreArquivo('L'{ivlm}) then Begin
     MsgDlg('Arquivo Texto com formato incompatível',LerMensagem(2),mtWarning,[mbOk],0);
     exit;
  end;
  qryAuxImp := TQuery.Create( Application );
  qryAuxImp.DataBaseName := 'BaseDados'{ivlm};
  dtmBaseDados.dbBaseDados.StartTransaction;
  if rdgrpContas.ItemIndex = 0 Then Begin
     Try
       qryAuxImp.SQL.Text := 'DELETE FROM '{ivlm} + sEntidade + ' WHERE PEREXERCICIO = '{ivlm}+ (dblkExercicio.LookupValue) +' AND PLANO = '{ivlm} + InttoStr(qryPlano.FieldByName('PLANO'{ivlm}{ivlm}).AsInteger) + ' AND PERNUMERO IS NULL'{ivlm};
       qryAuxImp.Open;
     Except
       MsgDlg('Não é possível Sobrescrever este arquivo de Saldos',LerMensagem(2),mtWarning,[mbOk],0);
       rdgrpContas.SetFocus;
       qryAuxImp.Free;
       exit;
     end;
  end;

  for i:= 1 to prgbrImportar.Max Do Begin
    qryAuxImp.Close;
    qryAuxImp.SQL.Clear;
    qryAuxImp.SQL.Text := 'SELECT SEQPLANOSALDO.NEXTVAL  AS proximo FROM DUAL';
    try
      qryAuxImp.Open;
    Except
      MsgDlg('Problema na geração de sequência de importação',LerMensagem(2),mtWarning,[mbOk],0);
      dtmBaseDados.dbBaseDados.RollBack;
      qryAuxImp.Close;
      qryAuxImp.Free;
      exit;
    end;
    iProxCod := qryAuxImp.FieldByName( 'Proximo' ).AsInteger;

    sSQLImp    := 'INSERT INTO ' + sEntidade + ' (';
    sSQLValues := ' VALUES(';
    prgbrImportar.Stepit;
    opDlgTxt.LeLinha;
    for iMaxList := 0 to lvCampos.Items.count - 1 Do Begin
        if lvCampos.Items[iMaxList].Checked  = true Then Begin
           sSQLImp    := sSQLImp + lvCampos.Items[iMaxList].SubItems[0];
           if lvCampos.Items[iMaxList].SubItems[0] = 'PLACONTA' Then
              Begin
                sPlaconta := OpDlgTxt.LeCampo(lvCampos.Items[iMaxList].SubItems[0]);
                for iZeros := 10 Downto 1 Do Begin
                  if copy(sPlaconta,iZeros,1) <> '0' Then Begin
                     sPlaconta  := Copy(sPlaconta,1,iZeros);
                     Break;
                  end;
                end;
                iGrau := CalcGrau(sPlaconta,lNivel,ind,sPai);
                While igrau = 0 Do Begin // problema com a retirada de zeros a direita da conta
                   sPlaconta := sPlaConta + '0';
                   iGrau := CalcGrau(sPlaconta,lNivel,ind,sPai);
                end;
                sSQLValues := sSQLValues + '''' + sPlaconta + '''';
              end
           else Begin
              if Trim(lvCampos.Items[iMaxList].SubItems[1]) = 'STRING' Then
                 sSQLValues := sSQLValues + '''' + OpDlgTxt.LeCampo(lvCampos.Items[iMaxList].SubItems[0]) + ''''
              else
                 sSQLValues := sSQLValues + OpDlgTxt.LeCampo(lvCampos.Items[iMaxList].SubItems[0]);
           end;
           lChecked := True;
           if iMaxList <> lvCampos.Items.count - 1 Then Begin
              sSQLImp    := sSQLImp    + ', ';
              sSQLValues := sSQLValues + ', ';
           end;
        end;
    end;
    if not lChecked Then Begin
       MsgDlg('Escolha ao menos um campo para Importar',LerMensagem(2),mtWarning,[mbOk],0);
       rdgrpContas.SetFocus;
       exit;
    end;
    qryAuxImp.SQL.Clear;
    qryAuxImp.SQL.Text := 'SELECT PLACONTA FROM PLANOCONTA  WHERE PLANO = ' + InttoStr(qryPlano.FieldByName('PLANO').AsInteger) + ' AND PLACONTA = ' + sPlaconta;
    qryAuxImp.Open;
    if not qryAuxImp.EOF Then Begin
       OutrosSERPROSSaldos(sSQLImp,sSQLValues,qryAuxImp);
       sSQLImp := sSQLImp + ')' + sSQLValues + ')';
       qryAuxImp.SQL.Clear;
       qryAuxImp.SQL.Text := sSQLImp;
       try
         qryAuxImp.ExecSQL;
       Except
         MsgDlg('Operação não concluída - Verifique => '+ sSQLImp,LerMensagem(2),mtError,[mbOk],0);
         dtmBaseDados.dbBaseDados.RollBack;
         lProblema := true;
         Break;
       end;
    end
    else    // conta não existe no Plano de Contas
       mmTxt.Lines.Add(sPlaconta);
  end;
  prgbrImportar.Visible := false;
  if not lProblema Then
  try
    dtmBaseDados.dbBaseDados.Commit;
    MsgDlg('Operação concluída com sucesso',LerMensagem(2),mtWarning,[mbOk],0);
  except
    MsgDlg('Operação não concluída - Verifique',LerMensagem(2),mtError,[mbOk],0);
    dtmBaseDados.dbBaseDados.RollBack;
  end;
  qryAuxImp.Close;
  qryAuxImp.Free;
end;

Procedure TfrmImportaSaldos.OutrosSERPROSSaldos(Var sSQLImp,sSQLValues : String; qryAuxImp : TQuery);
Var
   sSubConta : String;
   fValor : Real;
Begin
   // Campos Obrigatorios nao preenchidos anteriormente
   sSQLImp    := sSQLImp + ', IDPLANOSALDO';
   sSQLValues := sSQLValues + ',' + InttoStr(iProxCod);
   fValor := StrtoFloat(OpDlgTxt.LeCampo('SALDOANT'));
   If fValor < 0 Then
      sSQLImp := sSQLImp + ',PLSCREDITOCORRENTE'
   else
      sSQLImp := sSQLImp + ',PLSDEBITOCORRENTE';
   sSQLValues := sSQLValues + ',' + FloattoStr(abs(fValor));
   sSQLImp    := sSQLImp + ', PLANO,PEREXERCICIO,PERNUMERO,IDPESSOA,IDUSUARIOINCLUSAO';
   sSQLValues := sSQLValues + ',' + InttoStr(qryPlano.FieldByName('PLANO').AsInteger);
   sSQLValues := sSQLValues + ',' + (dblkExercicio.LookupValue) + ',NULL';
   sSQLValues := sSQLValues + ',' + InttoStr(Sistema.IdEmpresa);
   sSQLValues := sSQLValues + ',' + InttoStr(Sistema.idUsuario);
   sSubConta  := OpDlgTxt.LeCampo('CONTAAUX');
   if StrtoInt(sSubConta) <> 0 Then Begin
      sSQLImp    := sSQLImp + ', CODSUBCONTA';
      //sSQLValues := sSQLValues + ',' + sSubConta;
      qryAuxImp.SQL.Clear;
      qryAuxImp.SQL.Text := 'SELECT CODSUBCONTA FROM SUBCONTAAUX WHERE IDPESSOA = ' + InttoStr(Sistema.IdEmpresa)  + ' AND CONTAAUX = '+ sSubConta;
      try
        qryAuxImp.Open;
        sSQLValues := sSQLValues + ',' + InttoStr(qryAuxImp.FieldByName('CODSUBCONTA').AsInteger);
      Except
        MsgDlg('SubConta não cadastrada -> '+sSubConta,LerMensagem(2),mtError,[mbOk],0);
      end;

   end;
End;


end.
