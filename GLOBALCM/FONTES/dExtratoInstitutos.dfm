                  object ppMemo17: TppMemo
                    UserName = 'Memo17'
                    Caption = 'Memo17'
                    CharWrap = False
                    Font.Charset = DEFAULT_CHARSET
                    Font.Color = clBlack
                    Font.Name = 'Arial'
                    Font.Size = 8
                    Font.Style = []
                    Lines.Strings = (
                      
                        'O benefício de prestação continuada decorrente da opção pelo BPD' +
                        ' corresponderá ao Saldo de Conta dividido pelo fator atuarial ca' +
                        'lculado na data de entrada do requerimento do benefício de prest' +
                        'ação continuada. O saldo de conta acima se refere à situação atu' +
                        'al e será atualizado de acordo com o valor da cota do plano.'
                      ' ')
                    Transparent = True
                    mmHeight = 11906
                    mmLeft = 2117
                    mmTop = 100806
                    mmWidth = 187855
                    BandType = 4
                    mmBottomOffset = 0
                    mmOverFlowOffset = 0
                    mmStopPosition = 0
                    mmLeading = 0
                  end
                  object ppMemo21: TppMemo
                    UserName = 'Memo21'
                    Caption = 'Memo21'
                    CharWrap = False
                    Font.Charset = DEFAULT_CHARSET
                    Font.Color = clBlack
                    Font.Name = 'Arial'
                    Font.Size = 8
                    Font.Style = []
                    Lines.Strings = (
                      
                        'O benefício de risco corresponderá ao saldo de conta divido pelo' +
                        ' fator atuarial. No caso do risco de invalidez o benefício será ' +
                        'devido desde que o participante esteja aposentado por invalidez ' +
                        'no Órgão Oficial de Previdência. No caso de morte o benefício se' +
                        'rá devido desde que o dependente esteja habilitado na FUNCEF. O ' +
                        'valor mensal da pensão será recalculado sempre que ocorrer habil' +
                        'itação de dependentes não previstos no fator atuarial da data da' +
                        ' concessão do benefício, sendo os efeitos financeiros devidos a ' +
                        'partir da nova habilitação. O benefício será rateado entre os de' +
                        'pendentes, em partes iguais; na hipótese de cessação do direito ' +
                        'de um dos dependentes, a cota correspondente será revertida em f' +
                        'avor dos demais. Com a extinção da cota do último dependente ext' +
                        'ingue-se o benefício a cargo da FUNCEF.'
                      ' ')
                    Transparent = True
                    mmHeight = 29898
                    mmLeft = 2381
                    mmTop = 119856
                    mmWidth = 187590
                    BandType = 4
                    mmBottomOffset = 0
                    mmOverFlowOffset = 0
                    mmStopPosition = 0
                    mmLeading = 0
                  end
