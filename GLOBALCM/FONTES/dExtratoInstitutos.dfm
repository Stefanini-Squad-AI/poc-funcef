                  object ppMemo24: TppMemo
                    UserName = 'Memo24'
                    Caption = 'Memo24'
                    CharWrap = False
                    Font.Charset = DEFAULT_CHARSET
                    Font.Color = clBlack
                    Font.Name = 'Arial'
                    Font.Size = 8
                    Font.Style = []
                    Lines.Strings = (
                      
                        'O valor corresponderá ao saldo de conta divido pelo fator atuari' +
                        'al. No caso do risco de invalidez o benefício será devido desde ' +
                        'que o participante esteja aposentado por invalidez no Órgão Ofic' +
                        'ial de Previdência. No caso de morte o benefício será devido des' +
                        'de que o dependente esteja habilitado na FUNCEF. O valor mensal ' +
                        'da pensão será recalculado sempre que ocorrer habilitação de dep' +
                        'endentes não previstos no fator atuarial da data da concessão do' +
                        ' benefício, sendo os efeitos financeiros devidos a partir da nov' +
                        'a habilitação. O benefício será rateado entre os dependentes, em' +
                        ' partes iguais; na hipótese de cessação do direito de um dos dep' +
                        'endentes, a cota correspondente será revertida em favor dos dema' +
                        'is.'
                      ' ')
                    TextAlignment = taFullJustified
                    Transparent = True
                    mmHeight = 24606
                    mmLeft = 3175
                    mmTop = 117211
                    mmWidth = 192352
                    BandType = 4
                    mmBottomOffset = 0
                    mmOverFlowOffset = 0
                    mmStopPosition = 0
                    mmLeading = 0
                  end
