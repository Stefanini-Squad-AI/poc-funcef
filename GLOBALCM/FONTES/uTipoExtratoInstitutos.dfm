  object qryGrid: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      ''
      'SELECT 1 AS SELECIONADO,       '
      '       PLP.NOME, '
      '       SITF.DESCRICAO,      '
      '       SITP.DESCRICAO,       '
      '       SITPP.DESCRICAO,'
      '       SITF.DESCRICAO,      '
      '       PPP.INSCRICAODATA,'
      '       ELG.DATADEMISSAO,'
      '       PPP.DATACANCELAMENTO,'
      '       trunc(sysdate) SEMDATADEMISSAO,'
      '       PPP.IDPESSOA,'
      '       PPP.IDPLANOPREV,'
      '       PPP.IDSITPLANOPREV'
      '  FROM PARTPREVPLAN PPP,'
      '       SITPLANOPREV SITPP,'
      '       ELEGPATRO    ELG,'
      '       PLANPREV     PLP,'
      '       SITPART      SITP,'
      '       SITFUNC      SITF'
      ' WHERE PPP.IDPESSOA = :IDPESSOA'
      
        '   AND (((ELG.DATADEMISSAO IS NOT NULL)  AND (:TIPO = 1))  OR (:' +
        'TIPO = 0))'
      '   AND SITPP.FLGINTERNO = '#39'NO'#39
      '   AND PPP.IDPESSJUR = ELG.IDPESSJUR'
      '   AND PPP.IDPESSOA = ELG.IDPESSOA'
      '   AND PPP.IDSITPART = SITP.IDSITPART'
      '   AND SITF.IDSITFUNC = ELG.IDSITFUNC'
      '   AND PPP.IDPLANOPREV = PLP.IDPLANOPREV'
      '   AND PPP.IDSITPLANOPREV = SITPP.IDSITPLANOPREV'
      ' ORDER BY PLP.IDPLANOPREV'
      ''
      ''
      '/*select * from depentit'
      'where matricula = '#39'0348298'#39'*/')
    UpdateObject = upd
    ControlType.Strings = (
      'SELECIONADO;CheckBox;1;0')
    ValidateWithMask = True
    Left = 553
    Top = 219
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'TIPO'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'TIPO'
        ParamType = ptInput
      end>
  end
