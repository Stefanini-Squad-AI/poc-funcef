  object qryGridResultado: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT 1 AS SELECIONADO,'
      '       P.NOME, '
      '       E.MATRICULA,       '
      '       P.NUMDOCUMENTO,'
      '       PF.DATANASC,'
      '       PL.NOME AS PLANO,'
      '       SITF.DESCRICAO SITPATRO,         '
      '       SITPT.DESCRICAO SITFUND,                   '
      '       SITPP.DESCRICAO SITPLANO,       '
      '       PPP.INSCRICAODATA ,      '
      '       E.DATAADMISSAO,'
      '       E.IDPESSOA,'
      '       PL.IDPLANOPREV,'
      '       PPP.IDSITPLANOPREV  '
      '  FROM ELEGPATRO E'
      ' INNER JOIN PESSOA P'
      '    ON (E.IDPESSOA = P.IDPESSOA)'
      ' INNER JOIN PESSOA PJ '
      '    ON (E.IDPESSJUR  = PJ.IDPESSOA)'
      ' INNER JOIN PESSOAFISICA PF'
      '    ON (E.IDPESSOA = PF.IDPESSOA)'
      ' INNER JOIN PARTPREVPLAN PPP'
      '    ON (PPP.IDPESSOA = E.IDPESSOA)'
      ' INNER JOIN PLANPREV PL'
      '    ON (PL.IDPLANOPREV = PPP.IDPLANOPREV)'
      ' INNER JOIN SITPLANOPREV SITPP'
      '    ON (SITPP.IDSITPLANOPREV = PPP.IDSITPLANOPREV)'
      ' INNER JOIN SITPART SITPT'
      '    ON (SITPT.IDSITPART = PPP.IDSITPART)'
      ' INNER JOIN SITFUNC SITF'
      '    ON (SITF.IDSITFUNC = E.IDSITFUNC)'
      ' WHERE SITPT.FLGEXTINST <> 0'
      '   /*AND (PPP.IDPLANOPREV ='
      '       (SELECT MAX(PPP2.IDPLANOPREV)'
      '           FROM PARTPREVPLAN PPP2'
      '          WHERE PPP2.FLGDESATIVADO = 0'
      '            AND PPP2.IDPESSOA = PPP.IDPESSOA) OR'
      '       (PPP.FLGDESATIVADO = 1 AND NOT EXISTS'
      '        (SELECT 1'
      '            FROM PARTPREVPLAN PPP1          '
      '           WHERE PPP1.IDPESSOA = PPP.IDPESSOA'
      '             AND PPP1.FLGDESATIVADO = 0) AND'
      '        (PPP.IDSITPLANOPREV = 25 OR        '
      '        (PPP.IDPLANOPREV ='
      '        (SELECT MAX(PPP1.IDPLANOPREV)'
      '              FROM PARTPREVPLAN PPP1            '
      
        '             WHERE PPP1.IDPESSOA = PPP.IDPESSOA                 ' +
        ' '
      
        '               AND NVL(PPP1.DATACANCELAMENTO, TRIM(SYSDATE)) =  ' +
        '                '
      
        '                   (SELECT NVL(MAX(PPP2.DATACANCELAMENTO), TRIM(' +
        'SYSDATE))                    '
      '                      FROM PARTPREVPLAN PPP2                    '
      
        '                     WHERE PPP2.IDPESSOA = PPP1.IDPESSOA)       ' +
        '           '
      '               AND NOT EXISTS (SELECT 1'
      '                      FROM PARTPREVPLAN PPP2                    '
      
        '                     WHERE PPP2.IDPESSOA = PPP1.IDPESSOA        ' +
        '                  '
      '                       AND PPP2.IDSITPLANOPREV = 25))))))*/'
      '   AND E.MATRICULA IN (:SMATRICULAS) '
      ' ')
    UpdateObject = updResultado
    ControlType.Strings = (
      'SELECIONADO;CheckBox;1;0')
    ValidateWithMask = True
    Left = 561
    Top = 291
    ParamData = <
      item
        DataType = ftString
        Name = 'SMATRICULAS'
        ParamType = ptInput
      end>
  end
  object updResultado: TUpdateSQL
    Left = 600
    Top = 288
  end
