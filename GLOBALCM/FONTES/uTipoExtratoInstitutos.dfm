  object QryRelExtInstitutos: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      ''
      'idrelatorio,'
      'idsessao,'
      'matricula,'
      'cpf,'
      'trim(nome) as nome,'
      'sexo,'
      'trim(patro) as patro,'
      'trim(plano) as plano,'
      'to_char(dtdemissao,'#39'dd/mm/yyyy'#39') as dtdemissao,'
      'to_char(dtadplano,'#39'dd/mm/yyyy'#39') as dtadplano,'
      'trim(to_char(idade)) as idade,'
      'to_char(dtatual,'#39'dd/mm/yyyy'#39') as dtatual,'
      'elegivel1,'
      'saldoconta,'
      'respoup,'
      'elegivel2,'
      'vlraserportado,'
      'vlrportado,'
      'totportado,'
      'elegivel3,'
      'vlrtrib,'
      'vlrnaotrib,'
      'resgbruto,'
      'elegivel4,'
      'salpart,'
      'vlrinipart,'
      'percpart,'
      'vlrinipatro,'
      'percpatro,'
      'vlrinicadm,'
      'perccadm,'
      'vlrinicrisco,'
      'perccrisco,'
      'trgdtinclusao,'
      'trguserinclusao,'
      'observacao,'
      'idplanoprev,'
      'idpessoa,'
      'idpessjur'
      '  FROM RELEXTRATODOSINSTITUTOS'
      'WHERE  OBSERVACAO IS NULL'
      'AND        IDSESSAO = :IDSESSAO'
      'order by Idpessoa, idplanoprev'
      ' ')
    ValidateWithMask = True
    Left = 392
    Top = 560
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDSESSAO'
        ParamType = ptUnknown
      end>
  end
