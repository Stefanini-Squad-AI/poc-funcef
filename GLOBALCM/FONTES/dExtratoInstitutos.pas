{$R *.DFM}
function TdtmRelExtratoInstitutos.MostraParam(Form: String): Boolean;
var frm : TForm;
begin

  if (LowerCase(Form) <> '') then begin
    frm := TfrmTipoExtratoInstitutos.Create(Application);
  end else begin
    frm := nil;
  end;

  if frm = nil then begin
    Result := False;
    Exit;
  end;

  with frm do begin
    Result := (ShowModal = mrOk);
    Result := bMostraRelatorio;
    Free;
  end;
end;
