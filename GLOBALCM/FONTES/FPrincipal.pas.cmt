end;

initialization
   Sistema.NomeModulo := 'Global';    // Nome do Módulo
   Sistema.IdModulo := 2;             // IdModulo cadastrado no SAD
   Sistema.Versao := '3.07.00';
   Sistema.NomeAplicativo := 'Global CM';
   Sistema.UsaLogOperacoes := True;
   Modulo := TModulo.Create;

finalization
   Modulo.free;
   IntegraBack.free;

end.

