  object qryFuncionarios: TQuery
    DatabaseName = 'dbprincipal'
    SQL.Strings = (
      'SELECT DISTINCT'
      #9'F.IDEMPRESA,'
      #9'F.IDPESSOA,'
      #9'P.NOME,'
      '        F.IDCARGO'
      'FROM'
      #9'FUNCIONARIO F,'
      #9'PESSOA P'
      'WHERE'
      #9'F.IDEMPRESA IS NOT NULL AND'
      #9'F.IDPESSOA IS NOT NULL  AND'
      #9'P.IDPESSOA = F.IDPESSOA AND'
      '        F.IDCARGO NOT IN (74,200201) '
      'ORDER BY F.IDEMPRESA,F.IDPESSOA'
      ''
      ' '
      ' ')
    Left = 59
    Top = 41
  end
