  object ds: TwwDataSource
    DataSet = Cds
    Left = 245
    Top = 349
  end
  object SqlParams: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   P.NOME AS FAVORECIDO, '
      '   DECODE(C.NOME,NULL,'#39'Entrada Manual'#39',C.NOME) AS CONTRIBUINTE, '
      '   F.IDDARF, '
      '   F.DATAEMISDARF, '
      '   F.CODDOCUMENTO, '
      '   F.VLRTOTAL, '
      '   F.DATAVENCDARF, '
      '   '#39'S'#39' AS FLGEXCLUI, '
      '   F.CODNATUREZA '
      'FROM '
      '   PESSOA P, '
      '   PESSOA C, '
      '   DOCUMENTO D, '
      '   DARF F, '
      '   LANCIRRF L '
      'WHERE '
      '      P.IDPESSOA     =  D.IDFORCLI '
      'AND   L.IDBENEFIRRF  = C.IDPESSOA'
      'AND   D.CODDOCUMENTO = F.CODDOCUMENTO '
      'AND   F.CODNATUREZA IN (7416,7431) '
      'AND   F.IDDARF       = L.IDDARF(+) '
      
        'AND   F.DATAEMISDARF BETWEEN TO_DATE('#39'01/12/2006'#39','#39'DD/MM/YYYY'#39') ' +
        'AND TO_DATE('#39'31/12/2006'#39','#39'DD/MM/YYYY'#39') ')
    ClientDataSet = Cds
    Left = 336
    Top = 376
  end
