        UserName = 'Memo1'
        Caption = 
          'Notas:'#13#10'1- A inexatidão das declarações desta comunicação implic' +
          'ará nas sanções previstas nos artigos. 171 e 299 do Código Penal' +
          '.'#13#10'2- A comunicação de acidente do trabalho deverá ser feita até' +
          ' o 1° dia útil após o acidente, sob pena de multa, na forma prev' +
          'ista no art. 22 da Lei nº 8.213/91. '#13#10
        CharWrap = False
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clBlack
        Font.Name = 'Arial'
