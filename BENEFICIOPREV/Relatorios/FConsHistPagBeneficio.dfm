  object qrybeneficio: TwwQuery
    AfterScroll = qrybeneficioAfterScroll
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT BN.NOME AS BENEFICIO, BN.IDBENEFICIO, PL.NOME AS PLANO  ,' +
        ' B.IDSITBENEFICIO,'
      'S.DESCRICAO'
      'FROM BENEFBFCIARIO B, PLANPREV PL, BENEFICIO BN, SITBENEFICIO S'
      'WHERE   B.IDPESSOA    = :IDPESSOA'
      '  AND  BN.IDBENEFICIO = B.IDBENEFICIO'
      '  AND  PL.IDPLANOPREV = B.IDPLANOPREV'
      '  AND S.IDSITBENEFICIO = B.IDSITBENEFICIO'
      '  AND B.FONTEPAGADORA = 1'
      '  AND B.IDTPPAGTOBENEFIC = 1'
      'ORDER BY B.IDSITBENEFICIO'
      ''
      ''
      ''
      ''
      ' '
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 226
    Top = 217
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptInput
      end>
  end
  object qryplano: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT PP.NOME, PA.IDPLANOPREV'
      'FROM PARTPREVPLAN PA, PLANPREV PP'
      'WHERE PA.IDPLANOPREV = PP.IDPLANOPREV'
      
        'AND   PA.IDPESSOA in (SELECT DISTINCT IDTITULAR FROM DEPENTIT WH' +
        'ERE MATRICULA = :MATRICULA )'
      'AND   PA.FLGDESATIVADO = 0'
      '')
    ValidateWithMask = True
    Left = 356
    Top = 210
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'MATRICULA'
        ParamType = ptUnknown
      end>
  end
