  object qryCargo: TwwQuery
    AfterScroll = qryCargoAfterScroll
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT C.IDCARGOEXT,C.CODIGO, C.TITULO, C.TIPO, C.JORNADA, C.FLG' +
        'ATIVO,'
      '       C.NOMERESUMIDO, C.CBO,'
      
        '       DECODE(C.FLGATIVO, 1, '#39'Ativa'#39', 0, '#39'Desativada'#39', 2 , '#39'Em E' +
        'xtinção'#39') AS SITUACAO,'
      
        '       CAR.CODIGO AS CODCARREIRA, CAR.NOME AS NOMECARREIRA, PCS.' +
        'CODIGO AS CODPCS, N.CODIGO AS NIVEL,'
      '       N.IDNIVEL, PCS.NOME AS NOMEPCS,'
      '       MAX(CN.DATAVIGENCIA) AS DATAVIGENCIA'
      
        'FROM   CARGOEXT C, CARREIRA CAR, PCS PCS, NIVEL N, CARGOXNIVEL C' +
        'N'
      'WHERE  C.IDPESSJUR   = :IDPESSJUR'
      'AND    C.IDCARGOEXT  = :IDCARGOEXT'
      'AND    C.TIPO        = '#39'C'#39
      'AND    CAR.IDCARREIRA(+)  = C.IDCARREIRA'
      'AND    PCS.IDPCS(+)       = C.IDPCS'
      'AND    CN.IDPESSJUR(+)    = C.IDPESSJUR'
      'AND    CN.IDCARGOEXT(+)   = C.IDCARGOEXT'
      'AND    CN.IDNIVEL      = N.IDNIVEL(+)'
      
        'GROUP BY C.IDCARGOEXT,C.CODIGO, C.TITULO, C.TIPO, C.JORNADA, C.F' +
        'LGATIVO,'
      
        '         C.NOMERESUMIDO, C.CBO, C.FLGATIVO, CAR.CODIGO,CAR.NOME,' +
        ' PCS.CODIGO, N.IDNIVEL,'
      '         PCS.NOME , N.CODIGO'
      'ORDER BY C.CODIGO'
      ''
      ''
      ''
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 223
    Top = 329
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
        Value = 91008
      end
      item
        DataType = ftInteger
        Name = 'IDCARGOEXT'
        ParamType = ptUnknown
      end>
  end
