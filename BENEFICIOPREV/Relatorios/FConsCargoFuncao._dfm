  object qryFuncao: TwwQuery
    AfterScroll = qryFuncaoAfterScroll
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT C.IDCARGOEXT,C.CODIGO, C.TITULO, C.TIPO, C.JORNADA, C.FLG' +
        'ATIVO,'
      '       C.DATACRIACAO,'
      '       C.NOMERESUMIDO, C.CBO, C.FLGPCC,'
      
        '       DECODE(C.FLGATIVO, 1, '#39'Ativa'#39', 0, '#39'Desativada'#39', 2 , '#39'Em E' +
        'xtinção'#39') AS SITUACAO,'
      '       G.IDGRUPOFUNC AS IDGRUPOINI,'
      '       G.CODIGO AS CODGRUPOINI, G.NOME AS NOMEGRUPOINI,'
      '       T.DESCRICAO AS TIPOFUNC,'
      '       MIN(GE.DATAVIGENCIA) AS DATAVIGENCIA '
      'FROM   CARGOEXT C, GRUPOFUNC G, GRUPOCARGOEXT GE, TIPOFUNC T'
      'WHERE  C.IDPESSJUR    = :IDPESSJUR'
      'AND    C.IDCARGOEXT   = :IDCARGOEXT'
      'AND    C.TIPO         = '#39'F'#39
      'AND    GE.IDPESSJUR   = C.IDPESSJUR'
      'AND    GE.IDCARGOEXT  = C.IDCARGOEXT'
      'AND    GE.DATAVIGENCIA IN (SELECT MIN(DATAVIGENCIA)'
      '                           FROM   GRUPOCARGOEXT'
      '                           WHERE  IDPESSJUR  = :IDPESSJUR'
      '                           AND    IDCARGOEXT = :IDCARGOEXT )'
      'AND    G.IDGRUPOFUNC  = GE.IDGRUPOFUNC '
      'AND    C.IDTIPOFUNC   = T.IDTIPOFUNC(+)'
      
        'GROUP BY C.IDCARGOEXT,  C.CODIGO, C.TITULO, C.TIPO, C.JORNADA, C' +
        '.FLGATIVO,'
      '         C.DATACRIACAO, C.NOMERESUMIDO, C.CBO, C.FLGPCC,'
      '         G.IDGRUPOFUNC, G.CODIGO, G.NOME ,'
      '         T.DESCRICAO '
      'ORDER BY C.CODIGO'
      ''
      ''
      ' '
      ' ')
    ValidateWithMask = True
    Left = 37
    Top = 321
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
        Value = 91008
      end
      item
        DataType = ftInteger
        Name = 'IDCARGOEXT'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDCARGOEXT'
        ParamType = ptUnknown
      end>
  end
  object dsFuncao: TwwDataSource
    DataSet = qryFuncao
    Left = 42
    Top = 303
  end
  object qryOutrosGrupos: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT * FROM'
      '( SELECT     G.CODIGO AS CODGRUPO, G.NOME AS NOMEGRUPO,'
      
        '             GREATEST(GE.DATAVIGENCIA, F.DATAEFETIVACAO) AS DATA' +
        'VALOR,'
      '             DECODE(C.FLGPCC, 1, F.VALOR, 0 ) AS VALORPCC,'
      '             DECODE(C.FLGPCC, 0, F.VALOR, 0 ) AS VALORNAOPCC,'
      
        '             NVL(DECODE(C.FLGPCC, 1, F.PISOMERCADO , 0), 0) AS P' +
        'ISOMERCADO,'
      
        '             NVL(DECODE(C.FLGPCC, 1, F.PISOMERCADOLIC, 0), 0) AS' +
        ' PISOMERCADOLIC,'
      '             DECODE(GE.DATAFIM, NULL, 0,'
      
        '                                     DECODE( GREATEST(GE.DATAFIM' +
        ', F.DATAEFETIVACAO) , F.DATAEFETIVACAO, 1, 0) ) AS ACABOU'
      '  FROM   CARGOEXT C, GRUPOFUNC G, GRUPOCARGOEXT GE, FAIXAGRUPO F'
      '  WHERE  C.IDPESSJUR   = :IDPESSJUR'
      '  AND    C.IDCARGOEXT  = :IDCARGOEXT'
      '  AND    GE.IDPESSJUR  = C.IDPESSJUR'
      '  AND    GE.IDCARGOEXT = C.IDCARGOEXT'
      '  AND    G.IDPESSJUR   = GE.IDPESSJUR'
      '  AND    G.IDGRUPOFUNC = GE.IDGRUPOFUNC'
      '  AND    F.IDPESSJUR   = G.IDPESSJUR'
      '  AND    F.IDGRUPOFUNC = G.IDGRUPOFUNC'
      '  AND   ( (F.DATAEFETIVACAO >= GE.DATAVIGENCIA) OR'
      
        '          (F.DATAEFETIVACAO IN (SELECT MAX(F2.DATAEFETIVACAO) FR' +
        'OM FAIXAGRUPO F2'
      
        '                               WHERE  F2.IDGRUPOFUNC = GE.IDGRUP' +
        'OFUNC'
      
        '                               AND    F2.DATAEFETIVACAO < GE.DAT' +
        'AVIGENCIA ) ) )'
      '  UNION'
      '  SELECT '#39' '#39' AS CODGRUPO, '#39'Sem Grupo'#39'  AS NOMEGRUPO,'
      '          F.DATAEFETIVACAO AS DATAVALOR,'
      '          DECODE(C.FLGPCC, 1, F.VALOR, 0 ) AS VALORPCC,'
      
        '          DECODE(C.FLGPCC, 0, F.VALOR, 0 ) AS VALORNAOPCC, 0 AS ' +
        'ACABOU,'
      '          0 AS PISOMERCADO, 0 AS PISOMERCADOLIC'
      '   FROM   CARGOEXT C, FAIXAFUNCAO F'
      '   WHERE  C.IDPESSJUR     = :IDPESSJUR'
      '   AND    C.IDCARGOEXT    = :IDCARGOEXT'
      '   AND    F.IDPESSJUR     = C.IDPESSJUR'
      '   AND    F.IDCARGOEXT    = C.IDCARGOEXT'
      '  )'
      ' ORDER BY  DATAVALOR DESC'
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 33
    Top = 261
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDCARGOEXT'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDCARGOEXT'
        ParamType = ptUnknown
      end>
