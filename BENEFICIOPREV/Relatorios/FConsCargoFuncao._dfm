  object qryNivelCargo: TwwQuery
    AfterScroll = qryFuncaoAfterScroll
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT N.CODIGO, FN.DATAEFETIVACAO, FN.VALOR'
      'FROM   NIVEL N, CARGOXNIVEL CN, FAIXANIVEL FN'
      'WHERE  CN.IDPESSJUR  = :IDPESSJUR'
      'AND    CN.IDCARGOEXT = :IDCARGOEXT'
      'AND    N.IDNIVEL     = CN.IDNIVEL'
      'AND    N.IDPESSJUR = CN.IDPESSJUR'
      'AND    FN.IDPESSJUR  = CN.IDPESSJUR'
      'AND    FN.IDNIVEL    = CN.IDNIVEL'
      'ORDER BY FN.DATAEFETIVACAO DESC'
      ' '
      ' ')
    ValidateWithMask = True
    Left = 217
    Top = 234
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
