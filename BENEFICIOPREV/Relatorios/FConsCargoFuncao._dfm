  object qryFuncoesCorresp: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      ' SELECT 1 AS ORDEM, '#39'Corresp. Fundação   '#39' AS TIPOCORRESP,'
      '        CCORRESP.CODIGO, CCORRESP.TITULO'
      ' FROM   CARGOEXT C, CARGOEXT CCORRESP'
      ' WHERE  C.IDPESSJUR = :IDPESSJUR'
      ' AND    RTRIM(C.CODIGO) = :CODIGO'
      ' AND    C.IDCARGOCORRESP = CCORRESP.IDCARGOEXT(+)'
      ' UNION'
      ' SELECT 2 AS ORDEM, '#39'Função Patrocinadora'#39' AS TIPOCORRESP,'
      
        '       DECODE(CP.CODPATRO,   NULL, CP2.CODPATRO, CP.CODPATRO) AS' +
        ' CODPATRO,'
      '       DECODE(CPATRO.TITULO, NULL,'
      
        '                             DECODE(CP2.CODPATRO, NULL, NULL, C.' +
        'TITULO),'
      '                             CPATRO.TITULO) AS TITULO'
      
        ' FROM  CARGOEXT C, CARGOEXT CPATRO, CARGOEXTXPESS CP, CARGOEXTXP' +
        'ESS CP2'
      ' WHERE C.IDPESSJUR            = :IDPESSJUR'
      ' AND   RTRIM(C.CODIGO)        = :CODIGO'
      ' AND   RTRIM(CP.CODPATRO(+))  = RTRIM(C.CODIGO)'
      ' AND   CPATRO.IDCARGOEXT(+)   = CP.IDCARGOEXT'
      ' AND   CP.IDCARGOEXT(+)       <> C.IDCARGOEXT'
      ' AND   CP2.IDPESSJUR(+)       = C.IDPESSJUR'
      ' AND   CP2.IDCARGOEXT(+)      = C.IDCARGOEXT'
      ' UNION'
      ' SELECT 3 AS ORDEM, '#39'Função Fundação     '#39' AS TIPOCORRESP,'
      '        CPATRO.CODIGO, CPATRO.TITULO'
      ' FROM   CARGOEXT C, CARGOEXT CPATRO, CARGOEXTXPESS CP'
      ' WHERE C.IDPESSJUR = :IDPESSJUR'
      ' AND   RTRIM(C.CODIGO) = :CODIGO'
      ' AND   RTRIM(CP.CODPATRO(+)) = RTRIM(C.CODIGO)'
      ' AND   CPATRO.IDCARGOEXT(+) = CP.IDCARGOEXT'
      ' AND   CP.IDCARGOEXT(+) <> C.IDCARGOEXT'
      ' ORDER BY ORDEM'
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 118
    Top = 242
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'CODIGO'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'CODIGO'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'CODIGO'
        ParamType = ptUnknown
      end>
  end
