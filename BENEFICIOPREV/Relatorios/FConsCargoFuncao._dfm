  object qryHistGrupo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        ' SELECT G.CODIGO AS CODGRUPO, G.NOME AS NOMEGRUPO, GE.DATAVIGENC' +
        'IA'
      ' FROM   CARGOEXT C, GRUPOFUNC G, GRUPOCARGOEXT GE'
      ' WHERE  C.IDPESSJUR     = :IDPESSJUR'
      ' AND    C.IDCARGOEXT    = :IDCARGOEXT'
      ' AND    GE.IDPESSJUR    = C.IDPESSJUR'
      ' AND    GE.IDCARGOEXT   = C.IDCARGOEXT'
      ' AND    G.IDPESSJUR     = GE.IDPESSJUR'
      ' AND    G.IDGRUPOFUNC   = GE.IDGRUPOFUNC'
      ' ORDER BY GE.DATAVIGENCIA DESC  ')
    ValidateWithMask = True
    Left = 129
    Top = 338
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
        Value = '91008'
