  object dsRelFaixaVigente: TwwDataSource
    DataSet = qryRelFaixaVigente
    Left = 432
    Top = 399
  end
  object qryRelFaixaVigente: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  '
      ''
      
        'DECODE(P.IDFUNCIONALIDADE, 1, '#39'Cálculo Retroativo de Benefícios'#39 +
        ', 2, '#39'Desdobramento de Benefícios'#39') AS NOMEFUNCIONALIDADE,'
      
        'DECODE(P.FONTEPAGADORA, 1, '#39'Funcef'#39', 2, '#39'INSS'#39') AS NOMEFONTEPAGA' +
        'DORA, '
      'P.*'
      ''
      'FROM PARAMPARCDIVIDABENEFICIO P '
      'WHERE P.DTFIMVIGENCIA IS NULL OR P.DTFIMVIGENCIA > SYSDATE')
    ValidateWithMask = True
    Left = 432
    Top = 431
  end
  object dsRelFundacao: TwwDataSource
    DataSet = qryRelFundacao
    Left = 352
    Top = 378
  end
  object qryRelFundacao: TwwQuery
    DatabaseName = 'basedados'
    SQL.Strings = (
      'SELECT P.NOME , P.RAZAOSOCIAL, E.LOGRADOURO,'
      '       E.NUMERO, E.COMPLEMENTO, E.BAIRRO,'
      '       C.NOME AS CIDADE, C.CODESTADO, E.CEP, I.IMAGEM'
      'FROM PESSOA P, ENDPESS E, IMAGENS I, CIDADES C'
      'WHERE (P.IDPESSOA = :pFundacao) AND '
      '      (E.IDPESSOA(+) = P.IDPESSOA) AND'
      '      (E.IDCIDADES   = C.IDCIDADES(+))  AND'
      '      (I.IDIMAGEM(+) = P.IDIMAGEM)')
    ValidateWithMask = True
    Left = 352
    Top = 419
    ParamData = <
      item
        DataType = ftInteger
        Name = 'pFundacao'
        ParamType = ptUnknown
        Value = 1
      end>
  end
