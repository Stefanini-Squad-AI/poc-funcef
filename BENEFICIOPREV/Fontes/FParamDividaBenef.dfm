  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update PARAMPARCDIVIDABENEFICIO'
      'set'
      '  IDPARAMPARCDIVIDABENEFICIO = :IDPARAMPARCDIVIDABENEFICIO,'
      '  IDFUNCIONALIDADE = :IDFUNCIONALIDADE,'
      '  FONTEPAGADORA = :FONTEPAGADORA,'
      '  VLRINICIOFAIXA = :VLRINICIOFAIXA,'
      '  VLRFIMFAIXA = :VLRFIMFAIXA,'
      '  PERCENTUAL = :PERCENTUAL,'
      '  QTDEPARCINICIAL = :QTDEPARCINICIAL,'
      '  QTDEPARCFINAL = :QTDEPARCFINAL,'
      '  DTINICIOVIGENCIA = :DTINICIOVIGENCIA,'
      '  DTFIMVIGENCIA = :DTFIMVIGENCIA'
      'where'
      '  IDPARAMPARCDIVIDABENEFICIO = :OLD_IDPARAMPARCDIVIDABENEFICIO')
    InsertSQL.Strings = (
      'insert into PARAMPARCDIVIDABENEFICIO'
      '  (IDPARAMPARCDIVIDABENEFICIO, IDFUNCIONALIDADE, FONTEPAGADORA, '
      'VLRINICIOFAIXA, '
      '   VLRFIMFAIXA, PERCENTUAL, QTDEPARCINICIAL, QTDEPARCFINAL, '
      'DTINICIOVIGENCIA, '
      '   DTFIMVIGENCIA)'
      'values'
      
        '  (SEQIDPARAMPARCDIVIDABENEFICIO.NEXTVAL, :IDFUNCIONALIDADE, :FO' +
        'NTEPAGADORA, '
      ':VLRINICIOFAIXA, '
      '   :VLRFIMFAIXA, :PERCENTUAL, :QTDEPARCINICIAL, :QTDEPARCFINAL, '
      ':DTINICIOVIGENCIA, '
      '   :DTFIMVIGENCIA)')
    DeleteSQL.Strings = (
      'delete from PARAMPARCDIVIDABENEFICIO'
      'where'
      '  IDPARAMPARCDIVIDABENEFICIO = :OLD_IDPARAMPARCDIVIDABENEFICIO')
  end
