  object qryBeneficio: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT BP.IDBENEFICIO, BP.IDPLANOPREV, BP.FLGOBRIGANPROC'
      'FROM   BENEFPLANPREV BP, BENEFICIO B'
      'WHERE  BP.IDPLANOPREV = :IDPLANOPREV'
      'AND    BP.IDBENEFICIO = :IDBENEFICIO'
      'AND    BP.IDBENEFICIO = B.IDBENEFICIO')
    ValidateWithMask = True
    Left = 357
    Top = 13
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDBENEFICIO'
        ParamType = ptUnknown
      end>
  end
