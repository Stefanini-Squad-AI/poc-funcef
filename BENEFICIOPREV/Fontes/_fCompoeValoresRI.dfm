      FieldName = 'RUBRICAINSS'
      Origin = 'BASEDADOS.RUBRICAXINSS.RUBRICAINSS'
    end
  end
  object qryRubParticipanteAcertadas: TwwQuery
    CachedUpdates = True
    AfterOpen = qryRubParticipanteAcertadasAfterOpen
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   SUBSTR(DESCRICAO,1,30) RUBRICA,'
      '   PD.CODPROVDESC,'
      '   DECODE(PD.FLGDESCONTO,0,VALORINSS, -1 * VALORINSS) VALOR,'
      ''
      '   PPC.NOME AS PLANOCONTABIL,'
      ''
      '   D.*,'
      '   0  AS  FLGPROCESSA'
      ''
      'FROM'
      '   DETCONCINSS      D,'
      '   PROVDESC         PD,'
      '   PLANPREVCONTABIL PPC'
      ''
      'WHERE'
      '       D.NUMPROCINSS       =:NUMPROCINSS'
      
        '   AND (D.MESCOBRANCA      = :MESCOBRANCA OR D.MESREFERENCIA = :' +
        'MESCOBRANCA)'
      '   AND PD.IDPROVENTO       = D.IDRUBRICA'
      '   AND D.FLGTRATADO        = 1'
      '   AND D.FLGMANUAL         = 4'
      '   AND D.IDPLANOPREV       = PPC.IDPLANOPREV(+)'
      ''
      'ORDER BY'
      '   D.MESREFERENCIA DESC, PD.FLGDESCONTO ASC, VALORINSS DESC')
    ValidateWithMask = True
    Left = 264
    Top = 328
    ParamData = <
      item
        DataType = ftString
        Name = 'NUMPROCINSS'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptInput
        Value = ''
      end
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptInput
      end>
  end
  object dsRubParticipanteAcertadas: TwwDataSource
    DataSet = qryRubParticipanteAcertadas
    Left = 264
    Top = 312
  end
  object qryDeleteDetConc: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'DELETE FROM DETCONCINSS'
      'WHERE'
