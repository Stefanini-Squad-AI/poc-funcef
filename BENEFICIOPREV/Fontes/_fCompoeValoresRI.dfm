  object updRubParticipante: TUpdateSQL
    ModifySQL.Strings = (
      'update DETCONCINSS'
      'set'
      '  IDRUBRICA = :IDRUBRICA,'
      '  MESREFERENCIA = :MESREFERENCIA,'
      '  NUMPROCINSS = :NUMPROCINSS,'
      '  IDPESSOA = :IDPESSOA,'
      '  SEQUENCIAL = :SEQUENCIAL,'
      '  IDBENEFICIO = :IDBENEFICIO,'
      '  NOME = :NOME,'
      '  MESCOBRANCA = :MESCOBRANCA,'
      '  SINONIMO = :SINONIMO,'
      '  IDPLANOPREV = :IDPLANOPREV,'
      '  VALORINSS = :VALORINSS,'
      '  VALORMANT = :VALORMANT,'
      '  TRGDTINCLUSAO = :TRGDTINCLUSAO,'
      '  TRGUSERINCLUSAO = :TRGUSERINCLUSAO,'
      '  CODCONCESSORINSS = :CODCONCESSORINSS,'
      '  CODMANTENEDORINSS = :CODMANTENEDORINSS,'
      '  FLGATIVO = :FLGATIVO,'
      '  FLGGLOSA = :FLGGLOSA,'
      '  FLGTRATADO = :FLGTRATADO'
      'where'
      '  IDRUBRICA = :OLD_IDRUBRICA and'
      '  MESREFERENCIA = :OLD_MESREFERENCIA and'
      '  NUMPROCINSS = :OLD_NUMPROCINSS and'
      '  IDPESSOA = :OLD_IDPESSOA and'
      '  SEQUENCIAL = :OLD_SEQUENCIAL and'
      '  IDBENEFICIO = :OLD_IDBENEFICIO'
      ' ')
    InsertSQL.Strings = (
      'insert into DETCONCINSS'
      '  (IDRUBRICA, MESREFERENCIA, NUMPROCINSS, IDPESSOA, SEQUENCIAL, '
      'IDBENEFICIO, '
      '   NOME, MESCOBRANCA, SINONIMO, IDPLANOPREV, VALORINSS, '
      'VALORMANT, TRGDTINCLUSAO, '
      '   TRGUSERINCLUSAO, CODCONCESSORINSS, CODMANTENEDORINSS, '
      'FLGATIVO, FLGGLOSA, '
      '   FLGTRATADO)'
      'values'
      
        '  (:IDRUBRICA, :MESREFERENCIA, :NUMPROCINSS, :IDPESSOA, :SEQUENC' +
        'IAL, '
      ':IDBENEFICIO, '
      '   :NOME, :MESCOBRANCA, :SINONIMO, :IDPLANOPREV, :VALORINSS, '
      ':VALORMANT, '
      '   :TRGDTINCLUSAO, :TRGUSERINCLUSAO, :CODCONCESSORINSS, '
      ':CODMANTENEDORINSS, '
      '   :FLGATIVO, :FLGGLOSA, :FLGTRATADO)')
    DeleteSQL.Strings = (
      'delete from DETCONCINSS'
      'where'
      '  IDRUBRICA = :OLD_IDRUBRICA and'
      '  MESREFERENCIA = :OLD_MESREFERENCIA and'
      '  NUMPROCINSS = :OLD_NUMPROCINSS and'
      '  IDPESSOA = :OLD_IDPESSOA and'
      '  SEQUENCIAL = :OLD_SEQUENCIAL and'
      '  IDBENEFICIO = :OLD_IDBENEFICIO')
    Left = 72
    Top = 280
  end
