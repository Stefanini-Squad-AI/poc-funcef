  object qryValor: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '     PLANO,'
      '     SUM(CREDITO) CREDITO,'
      '     SUM(DESCONTO) DESCONTO,'
      '     (SUM(CREDITO) - SUM(DESCONTO)) LIQUIDO,'
      '     SUM(GLOSA) GLOSA'
      'FROM ('
      '--CREDITO BRUTO'
      'SELECT '#39'NÃO IDENTIFICADOS'#39' PLANO,'
      '     SUM(VLRRUBRICA1) CREDITO,'
      '      0 DESCONTO,'
      '     0 GLOSA,'
      '     COUNT(*)'
      'FROM TEMPCONCINSS'
      'WHERE MESPROCESSAMENTO =  :MESCOBRANCA'
      '  AND ((SUBSTR(CODRUBRICA1,1,2) = '#39'21'#39')'
      '    OR (SUBSTR(CODRUBRICA1,1,2) = '#39'11'#39')'
      '    OR (SUBSTR(CODRUBRICA1,1,2) = '#39'41'#39'))'
      '  AND (SUBSTR(CODRUBRICA1,2,1) <> '#39'9'#39')'
      '--'#9'OR (SUBSTR(CODRUBRICA1,1,2) = '#39'92'#39'))'
      'GROUP BY '#39'NÃO IDENTIFICADOS'#39
      'UNION'
      '-- DESCONTO BRUTO'
      'SELECT'#9' '#39'NÃO IDENTIFICADOS'#39' PLANO,'
      '      0 CREDITO,'
      '      SUM(VLRRUBRICA1) DESCONTO,'
      '     0 GLOSA,'
      '     COUNT(*)'
      'FROM TEMPCONCINSS'
      'WHERE MESPROCESSAMENTO =  :MESCOBRANCA'
      '  AND ((SUBSTR(CODRUBRICA1,1,2) = '#39'22'#39')'
      '    OR (SUBSTR(CODRUBRICA1,1,2) = '#39'12'#39')'
      '    OR (SUBSTR(CODRUBRICA1,1,2) = '#39'42'#39'))'
      '  AND (SUBSTR(CODRUBRICA1,2,1) <> '#39'9'#39')'
      '--'#9'OR (SUBSTR(CODRUBRICA1,1,2) = '#39'91'#39'))'
      'GROUP BY '#39'NÃO IDENTIFICADOS'#39
      'UNION'
      '-- GLOSA'
      'SELECT '#39'NÃO IDENTIFICADOS'#39' PLANO,'
      '      0 CREDITO,'
      '      0 DESCONTO,'
      
        '      SUM(DECODE(SUBSTR(CODRUBRICA1,2,1),'#39'1'#39',VLRRUBRICA1,'#39'2'#39',-VL' +
        'RRUBRICA1)) GLOSA,'
      '     COUNT(*)'
      'FROM TEMPCONCINSS'
      'WHERE MESPROCESSAMENTO =  :MESCOBRANCA'
      '  AND (SUBSTR(CODRUBRICA1,1,1) = '#39'9'#39')'
      'GROUP BY '#39'NÃO IDENTIFICADOS'#39
      'UNION'
      '/* VALOR POR MANT. MONTANDO'
      '   PATROCINADORA I'
      '*/'
      '-- CRÉDITO BRUTO'
      'SELECT M.NOME PLANO,'
      '     SUM(D.VALORINSS) CREDITO,'
      '     0 DESCONTO,'
      '     0 GLOSA,'
      '     COUNT(*)'
      'FROM DETCONCINSS D,'
      '   MANTENEDORA M'
      'WHERE 1 = 1'
      '  AND D.MESCOBRANCA =  :MESCOBRANCA'
      '  AND D.CODMANTENEDORA IS NOT NULL'
      '  AND M.CODMANTENEDORA = D.CODMANTENEDORA'
      '  AND SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),1,1) <> '#39'9'#39
      '  AND (SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),2,1) = '#39'1'#39' OR'
      '       SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),1,2) = '#39'10'#39')'
      'GROUP BY M.NOME'
      'UNION'
      '-- GLOSA'
      'SELECT M.NOME PLANO,'
      '     0 CREDITO,'
      '     0 DESCONTO,'
      
        '     SUM(DECODE(SUBSTR(D.RUBRICAINSS,2,1), '#39'1'#39',D.VALORINSS,'#39'2'#39',-' +
        'D.VALORINSS)) GLOSA,'
      '     COUNT(*)'
      'FROM DETCONCINSS D,'
      '   MANTENEDORA M'
      'WHERE 1 = 1'
      '  AND D.MESCOBRANCA =  :MESCOBRANCA'
      '  AND D.CODMANTENEDORA IS NOT NULL'
      '  AND M.CODMANTENEDORA = D.CODMANTENEDORA'
      '  AND SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),1,1) =  '#39'9'#39
      '  AND SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),2,1) <> '#39'9'#39
      'GROUP BY M.NOME'
      'UNION'
      '-- DESCONTO BRUTO'
      'SELECT M.NOME PLANO,'
      '     0 CREDITO,'
      '     SUM(D.VALORINSS) DESCONTO,'
      '     0 GLOSA,'
      '     COUNT(*)'
      'FROM DETCONCINSS D,'
      '   MANTENEDORA M'
      'WHERE 1 = 1'
      '  AND D.MESCOBRANCA =  :MESCOBRANCA'
      '  AND D.CODMANTENEDORA IS NOT NULL'
      '  AND M.CODMANTENEDORA = D.CODMANTENEDORA'
      '  AND SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),1,1) <> '#39'9'#39
      '  AND (SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),2,1) = '#39'2'#39' OR'
      '       SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),1,2) = '#39'30'#39')'
      'GROUP BY M.NOME'
      'UNION'
      '/* VALOR POR MANT. MONTANDO'
      '   PATROCINADORA II'
      '*/'
      '-- CRÉDITO BRUTO'
      'SELECT PL.NOME,'
      '     SUM(D.VALORINSS) CREDITO,'
      '     0 DESCONTO,'
      '     0 GLOSA,'
      '     COUNT(*)'
      'FROM DETCONCINSS D,'
      '   PLANPREVCONTABIL PL'
      'WHERE 1 = 1'
      '  AND D.MESCOBRANCA =  :MESCOBRANCA'
      '  AND D.CODMANTENEDORA IS NULL'
      '  AND PL.IDPLANOPREV(+) = D.IDPLANOPREV'
      '  AND SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),1,1) <> '#39'9'#39
      '  AND (SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),2,1) = '#39'1'#39' OR'
      '       SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),1,2) = '#39'10'#39')'
      'GROUP BY PL.NOME'
      'UNION'
      '-- GLOSA'
      'SELECT PL.NOME,'
      '     0 CREDITO,'
      '     0 DESCONTO,'
      
        '     SUM(DECODE(SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),2,1), '#39'1'#39',D.' +
        'VALORINSS,'#39'2'#39',-VALORINSS)) GLOSA,'
      '     COUNT(*)'
      'FROM DETCONCINSS D,'
      '   PLANPREVCONTABIL PL'
      'WHERE 1 = 1'
      '  AND D.MESCOBRANCA =  :MESCOBRANCA'
      '  AND D.CODMANTENEDORA IS NULL'
      '  AND PL.IDPLANOPREV(+) = D.IDPLANOPREV'
      '  AND SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),1,1) = '#39'9'#39
      '  AND SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),2,1) <> '#39'9'#39
      'GROUP BY PL.NOME'
      'UNION'
      '-- DESCONTO BRUTO'
      'SELECT PL.NOME,'
      '     0 CREDITO,'
      '     SUM(D.VALORINSS) DESCONTO,'
      '     0 GLOSA,'
      '     COUNT(*)'
      'FROM DETCONCINSS D,'
      '   PLANPREVCONTABIL PL'
      'WHERE 1 = 1'
      '  AND D.MESCOBRANCA =  :MESCOBRANCA'
      '  AND D.CODMANTENEDORA IS NULL'
      '  AND PL.IDPLANOPREV(+) = D.IDPLANOPREV'
      '  AND SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),1,1) <> '#39'9'#39
      '  AND (SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),2,1) = '#39'2'#39' OR'
      '       SUBSTR(TRIM(TO_CHAR(D.RUBRICAINSS)),1,2) = '#39'30'#39')'
      'GROUP BY PL.NOME'
      ')'
      'GROUP BY PLANO'
      'ORDER BY PLANO DESC'
      '')
    ValidateWithMask = True
    Left = 256
    Top = 160
    ParamData = <
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
        Value = '2003/08'
      end
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
      end
