  object qryRubParticipante: TwwQuery
    CachedUpdates = True
    BeforeScroll = qryRubParticipanteBeforeScroll
    AfterScroll = qryRubParticipanteAfterScroll
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   SUBSTR(DESCRICAO, 1, 30) RUBRICA,'
      
        #9'DECODE(PD.FLGDESCONTO, 0, VALORPROVENTO, VALORPROVENTO * (-1)) ' +
        'VALOR,'
      ''
      '   PPC.NOME AS PLANOCONTABIL,'
      ''
      #9'RXI.RUBRICAINSS,'
      '   D.*,'
      '   0 AS FLGPROCESSA'
      ''
      'FROM'
      '   HISTRUBSAL       D,'
      '   PROVDESC         PD,'
      '   RUBRICAXINSS     RXI,'
      '   PLANPREVCONTABIL PPC'
      ''
      'WHERE'
      '       D.IDPESSOA        =:IDPESSOA'
      '   AND PD.IDPROVENTO     = D.IDRUBRICA'
      '   AND RXI.IDRUBRICA     = D.IDRUBRICA'
      '   AND RXI.FLGRUBCENTRAL = 1'
      '   AND D.IDPLANOCONTABIL = PPC.IDPLANOPREV(+)'
      ''
      'ORDER BY'
      '   D.MES DESC,'
      '   PD.FLGDESCONTO ASC,'
      '   VALORPROVENTO DESC'
      ' ')
    UpdateObject = updRubParticipante
    ControlType.Strings = (
      'FLGPROCESSA;CheckBox;1;0')
    ValidateWithMask = True
    Left = 72
    Top = 264
    ParamData = <
      item
        DataType = ftString
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
  end
  object qryRubricaAcerto: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT P.IDPROVENTO, R.RUBRICAINSS, P.DESCRICAO'
      'FROM PROVDESC P, rubricaxinss R'
      'WHERE P.IDGRUPORUBRICA = :IDGRUPORUBRICA'
      'and   P.IDPROVENTO = R.IDRUBRICA'
      'ORDER BY 3')
    ValidateWithMask = True
    Left = 232
    Top = 88
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDGRUPORUBRICA'
        ParamType = ptUnknown
      end>
