  object qryHeader: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  BF.*,'
      '  B.NOME NOME_BENEF,'
      '  P.NOME PARTICIPANTE,'
      '  B.CODBENEFICIO,'
      
        '  PP.IDPLANOPREV AS IDPLANOPREVORIGEM, PP.NOME AS PLANOPREVORIGE' +
        'M,'
      '  PPC.IDPLANOPREV AS IDPLANPREVCONTABORIGEM, PPC.NOME PLANO,'
      
        '  DECODE(EL.MATRICULA,NULL, BPP.MATRICULA,EL.MATRICULA) MATRICUL' +
        'A'
      ''
      'FROM'
      '  BENEFBFCIARIO BF,'
      '  PESSOA P,'
      '  BENEFICIO B,'
      '  PLANPREVCONTABIL PPC,'
      '  ELEGPATRO EL,'
      '  BENEFICIARIOPP BPP,'
      '  PLANPREV PP'
      ''
      'WHERE BF.IDBENEFICIO = :IDBENEFICIO'
      '  AND BF.IDPESSOA    = :IDPESSOA'
      '  AND BF.IDBENEFICIO = B.IDBENEFICIO'
      '  AND BF.IDPESSOA    = P.IDPESSOA'
      '  AND BF.IDPESSOA    = BPP.IDBENEFICIARIOPP(+)'
      '  AND BF.IDPESSOA    = EL.IDPESSOA(+)'
      '  AND BF.IDPLANOPREV = PP.IDPLANOPREV'
      '  AND BF.IDPLANPREVCONTAB = PPC.IDPLANOPREV(+)'
      ''
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 296
    Top = 16
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDBENEFICIO'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
