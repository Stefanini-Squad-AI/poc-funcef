  object qryDadosRegra: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT H.*, E.IDSITFUNC, PP.IDSITPART, PP.IDSITPLANOPREV'
      '  FROM HSTBENEFBFCIARIO H'
      '       JOIN ELEGPATRO E ON E.IDPESSOA  = H.IDTITULAR'
      '                       AND E.IDPESSJUR = H.IDPESSJUR'
      '       JOIN PARTPREVPLAN PP ON PP.IDPESSOA    = H.IDTITULAR'
      '                           AND PP.IDPESSJUR   = H.IDPESSJUR  '
      '                           AND PP.IDPLANOPREV = H.IDPLANOPREV'
      '                           AND PP.SEQPROPOSTA = H.SEQPROPOSTA'
      ' WHERE H.IDPESSOA    = :IDPESSOA'
      '   AND H.IDTITULAR   = :IDTITULAR'
      '   AND H.IDBENEFICIO = :IDBENEFICIO'
      '   AND H.SEQPROPOSTA = :SEQPROPOSTA '
      '   AND H.IDPLANOPREV = :IDPLANOPREV'
      '   AND H.IDPESSJUR   = :IDPESSJUR'
      '   AND H.NUMEROPROCESSO = :NUMEROPROCESSO'
      '   AND H.MESREFERENCIA  = :MESREFERENCIA'
      ' ORDER BY H.MES DESC')
    ValidateWithMask = True
    Left = 489
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDTITULAR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDBENEFICIO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SEQPROPOSTA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NUMEROPROCESSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MESREFERENCIA'
        ParamType = ptUnknown
      end>
  end
