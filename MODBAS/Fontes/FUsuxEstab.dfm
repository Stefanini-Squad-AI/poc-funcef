  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT'
      '  UC.IDFILIALPESSOA, P.NOME, UC.IDUSUARIO'
      'FROM'
      '  PESSOA P, USUARIOXFILIAL UC'
      'WHERE'
      '  (UC.IDUSUARIO      = :IDUSUARIO) AND'
      '  (UC.IDFILIALPESSOA = P.IDPESSOA)'
      'ORDER BY'
      '  UPPER(P.NOME)')
    Left = 295
    Top = 2
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDUSUARIO'
        ParamType = ptUnknown
      end>
  end
