  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update USUARIOXFILIAL'
      'set'
      '  IDUSUARIO = :IDUSUARIO,'
      '  IDFILIALPESSOA = :IDFILIALPESSOA'
      'where'
      '  IDUSUARIO = :OLD_IDUSUARIO and'
      '  IDFILIALPESSOA = :OLD_IDFILIALPESSOA')
    InsertSQL.Strings = (
      'insert into USUARIOXFILIAL'
      '  (IDUSUARIO, IDFILIALPESSOA)'
      'values'
      '  (:IDUSUARIO, :IDFILIALPESSOA)')
    DeleteSQL.Strings = (
      'delete from USUARIOXFILIAL'
      'where'
      '  IDUSUARIO = :OLD_IDUSUARIO and'
      '  IDFILIALPESSOA = :OLD_IDFILIALPESSOA')
    Left = 265
    Top = 2
  end
