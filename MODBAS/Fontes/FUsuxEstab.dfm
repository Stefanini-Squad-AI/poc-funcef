  object qryEstab: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  F.IDFILIALPESSOA, P.NOME'
      'FROM'
      '  PESSOA P, FILIALPESSOA F'
      'WHERE'
      '  (P.IDPESSOA = F.IDFILIALPESSOA) AND'
      '  (IDFILIALPESSOA NOT IN (SELECT IDFILIALPESSOA'
      '                          FROM   USUARIOXFILIAL'
      '                          WHERE  (IDUSUARIO = :IDUSUARIO))'
      '  ) AND'
      '  ((P.IDGRUPO = :IDEMPRESA) OR'
      '   (P.IDGRUPO IN (SELECT IDPESSOA FROM PESSOA'
      '                  WHERE  IDGRUPO = :IDEMPRESA)'
      '   ) OR'
      '   (P.IDGRUPO IN (SELECT IDPESSOA FROM PESSOA'
      '                  WHERE  IDGRUPO IN (SELECT IDPESSOA FROM PESSOA'
      
        '                                     WHERE  IDGRUPO = :IDEMPRESA' +
        ')'
      '                  )'
      '   ) OR'
      '   (P.IDGRUPO IN (SELECT IDPESSOA FROM PESSOA'
      '                  WHERE  IDGRUPO IN (SELECT IDPESSOA FROM PESSOA'
      
        '                                     WHERE IDGRUPO IN (SELECT ID' +
        'PESSOA FROM PESSOA'
      
        '                                                       WHERE  ID' +
        'GRUPO = :IDEMPRESA)'
      '                                     )'
      '                  )'
      '   )'
      '  )'
      'ORDER BY'
      '  UPPER(P.NOME)')
    UpdateObject = updEstab
    ValidateWithMask = True
    Left = 504
    Top = 3
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDUSUARIO'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'IDEMPRESA'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'IDEMPRESA'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'IDEMPRESA'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'IDEMPRESA'
        ParamType = ptUnknown
      end>
