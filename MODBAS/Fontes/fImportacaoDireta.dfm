  object qryColunas: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  COLUMN_NAME, DATA_TYPE ,NULLABLE'
      'FROM'
      '  ALL_TAB_COLUMNS'
      'WHERE'
      '  (TABLE_NAME = :ENTIDADE) AND'
      '  (OWNER      = '#39'CM'#39')'
      'ORDER BY'
      '  COLUMN_NAME')
    ValidateWithMask = True
    Left = 388
    Top = 103
    ParamData = <
      item
        DataType = ftString
        Name = 'ENTIDADE'
        ParamType = ptUnknown
      end>
  end
