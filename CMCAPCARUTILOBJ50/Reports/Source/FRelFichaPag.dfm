  object SqlDocs: TCMSqlParams
    SQL.Strings = (
      
        'SELECT D.dataprogramada,   L.DATALANCTO, P.RAZAOSOCIAL, P.IDPESS' +
        'OA, D.CODDOCUMENTO,'
      
        '  D.NODOCUMENTO, D.COMPLDOCUMENTO,  L.VALOR, D.STATUS, LX.NUMLOT' +
        'E, D.NUMSLIP'
      'FROM'
      
        '  DOCUMENTO D, LANCTODOCUM L, PESSOA P, LOTEXDOCUM LX, LOTEPAGTO' +
        ' LP'
      'WHERE'
      '  1=2')
    ClientDataSet = CdsDocs
    Left = 112
    Top = 296
