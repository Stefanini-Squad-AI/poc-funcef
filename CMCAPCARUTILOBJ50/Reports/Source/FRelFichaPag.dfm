  object SqlAp: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      ' D.CODDOCUMENTO, D.NUMSLIP,'
      ' D.NODOCUMENTO, D.COMPLDOCUMENTO,'
      ' d.NODOCUMENTO  || '#39' '#39' || d.COMPLDOCUMENTO as DOCCOMPL,'
      
        ' decode(rtrim(l.operacao),'#39'1'#39','#39'Lançamento Efetivo'#39','#39'2'#39','#39'Lançamen' +
        'to Efetivo'#39','#39'3'#39','#39'Lançamento Efetivo'#39','#39'10'#39','#39'Lançamento Efetivo'#39','
      
        '                          '#39'11'#39','#39'Lançamento de Previsão'#39','#39'12'#39','#39'La' +
        'nçamento de Previsão'#39','#39'13'#39','#39'Lançamento de Previsão'#39','
      
        '                          '#39'14'#39','#39'Lançamento de Adiantamento'#39','#39'15'#39 +
        ','#39'Lançamento de Adiantamento'#39','#39'16'#39','#39'Lançamento de Adiantamento'#39',' +
        #39'17'#39','#39'Lançamento de Adiantamento'#39') as DESCOPERACAO,'
      ''
      ' D.DATAEMISSAO, D.DATAVENCTO, D.DATAPROGRAMADA, L.PLNCODIGO,'
      ' DECODE(D.STATUS,'#39'2'#39','#39'DOCUMENTO BAIXADO'#39','#39#39') AS STATUSDOC,'
      
        ' DECODE(L.PLNCODIGO,NULL,'#39'NÃO INTEGRADO COM A CONTABILIDADE'#39','#39'IN' +
        'TEGRADO COM A CONTABILIDADE'#39') AS STATUSCONTAB,'
      ' L.DATALANCTO,'
      '  P.RAZAOSOCIAL,'
      
        'decode(P.tipo,'#39'F'#39',substr(P.numdocumento,1,3)||'#39'.'#39'||substr(P.numd' +
        'ocumento,4,3)||'#39'.'#39'||substr(P.numdocumento,7,3)||'#39'-'#39'||substr(P.nu' +
        'mdocumento,10,2),'
      
        '    substr(P.numdocumento,1,2)||'#39'.'#39'||substr(P.numdocumento,3,3)|' +
        '|'#39'.'#39'||substr(P.numdocumento,6,3)||'#39'/'#39'||substr(P.numdocumento,9,4' +
        ')||'#39'-'#39'||substr(P.numdocumento,13,2) ) as cpfcnpj  ,'
      ''
      ''
      ' L.VALOR,'
      ' L.VALOROUTRAMOEDA,'
      ' L.HISTORICOCOMPL,'
      ' TD.DESCRICAO AS DESCTIPODOC,'
      ' F.DESCRICAO,'
      ' PF.DESCRICAO AS DESCPORTFORMA,'
      ' DECODE(D.NUMLEITCODBARRAS,NULL,DECODE(D.NUMDIGCODBARRAS,NULL,'
      
        ' CONTA.DESCCONTA,D.NUMDIGCODBARRAS),D.NUMLEITCODBARRAS) AS TIPOD' +
        'OCBAIXA,'
      ' D.OPERACAO,'
      ' D.PLACONTA,'
      ' SALDO.SALDOANTERIOR'
      'FROM'
      ' DOCUMENTO D, LANCTODOCUM L, FORMARECPAG F,'
      ' PESSOA P, TIPODOCRECPAG TD, PORTADORFORMA PF,'
      '  (SELECT'
      '     DOC.CODDOCUMENTO,'
      
        '     SUM(DECODE(DOC.RECPAG,'#39'R'#39',DECODE(LAN.DEBCRE,'#39'D'#39',LAN.VALOR, ' +
        'LAN.VALOR*-1),DECODE(LAN.DEBCRE,'#39'C'#39',LAN.VALOR, LAN.VALOR*-1))) A' +
        'S SALDOANTERIOR'
      '   FROM'
      '     LANCTODOCUM LAN, DOCUMENTO DOC'
      '   WHERE'
      '     (DOC.CODDOCUMENTO = LAN.CODDOCUMENTO) AND'
      '     (DOC.CODDOCUMENTO =  15497)'
      '   GROUP BY'
      '     DOC.CODDOCUMENTO) SALDO,'
      ''
      ' (SELECT DISTINCT'
      '   C.IDPESSOA,'
      
        '   '#39' Banco '#39' || RTRIM(B.NUMBANCO) || '#39' Agência '#39'  || RTRIM(A.NUM' +
        'AGENCIA) || '#39' Conta: '#39' || RTRIM(C.CONTACORRENTE) AS DESCCONTA'
      '  FROM'
      '   CONTABANCARIA C, AGENCIABANCARIA A, BANCO B'
      '  WHERE'
      '   (C.FLGCONTAPREF = 1)                    AND'
      '   (C.IDAGENCIA(+) = A.IDPESSOA)           AND'
      '   (A.IDBANCO(+)   = B.IDPESSOA)) CONTA'
      'WHERE'
      ' (D.CODDOCUMENTO        = 15497)                  AND'
      ' (CONTA.IDPESSOA(+)     = D.IDFORCLI)             AND'
      ' (D.CODPORTFORMA        = PF.CODPORTFORMA(+))     AND'
      ' (D.CODDOCUMENTO        = L.CODDOCUMENTO)         AND'
      ' (D.OPERACAO            = L.OPERACAO)             AND'
      ' (P.IDPESSOA            = D.IDFORCLI)             AND'
      ' (D.CODFORMA            = F.CODFORMA(+))          AND'
      ' (TD.CODTIPDOC          = D.CODTIPDOC)            AND'
      ' (SALDO.CODDOCUMENTO    = D.CODDOCUMENTO)'
      'ORDER BY'
      '  D.CODDOCUMENTO'
      ' '
      ' '
      ' '
      '')
    ClientDataSet = CdsAp
    Left = 528
    Top = 296
  end
  object CdsAp: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 528
    Top = 248
  end
