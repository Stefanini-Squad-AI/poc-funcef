  object sqlTipoRecDes: TCMSqlParams
    SQL.Strings = (
      'SELECT CODTIPRECDES,   DESCRICAO        '
      'FROM TIPORECEBDESEMB  '
      'WHERE ANASINT  = '#39'A'#39
      '      AND RECPAG   = '#39'P'#39
      '      AND IDPESSOA = :idempresa')
    ClientDataSet = cdsTipoRecDes
    Left = 480
    Top = 320
  end
  object sqlPlancentResp: TCMSqlParams
    SQL.Strings = (
      
        'SELECT IDPLANCRESPON, DESCPLANCRESPON FROM PLANCENTRESPON ORDER ' +
        'BY DESCPLANCRESPON')
    ClientDataSet = cdsPlancentResp
    Left = 480
    Top = 8
  end
  object sqlCentResp: TCMSqlParams
    SQL.Strings = (
      'SELECT   '
      '   CENTRESPON.CODEXTERNO,  '
      '   CENTRESPON.NOME,             '
      '   CENTRESPON.ANALITICOSINTET,'
      '   CENTRESPON.IDPLANCRESPON   '
      'FROM CENTRESPON           '
      ' WHERE ( CENTRESPON.IDPESSOA = :idempresa )'
      ' ORDER BY CENTRESPON.NOME')
    ClientDataSet = cdsCentResp
    Left = 488
    Top = 48
  end
