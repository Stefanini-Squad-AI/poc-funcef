  object QryRateioParc: TwwQuery
    DatabaseName = 'BaseDados'
    DataSource = DsAp
    SQL.Strings = (
      'SELECT'
      
        '  U.DESCTDR, U.NOMEAP, U.NOMECR, U.VALOR, U.CENTROCUSTO, U.DESCP' +
        'ROGRAMA, U.PLANOPREV, U.PATROCINADORA'
      'FROM'
      ' (SELECT'
      
        '     TD.DESCRICAO AS DESCTDR, UN.NOME AS NOMEAP, CR.NOME AS NOME' +
        'CR, R.VALOR,'
      
        '     CC.NOME AS CENTROCUSTO, PRG.DESCPROGRAMA, PPC.NOME AS PLANO' +
        'PREV,'
      '     PJ.NOME AS PATROCINADORA'
      '  FROM'
      '     RATEIODOCUM R,'
      '     TIPORECEBDESEMB TD,'
      '     UNIDNEGOCIO UN,'
      '     CENTRESPON CR,'
      '     CENTCUST CC,'
      '     PROGRAMA PRG,'
      '     PLANPREVCONTABIL PPC,'
      '     PESSOA PJ,'
      '     PATRO PT'
      '  WHERE (R.CODDOCUMENTO = :CODDOCUMENTO)'
      '    AND (R.CODCENTRORESPON = CR.CODCENTRORESPON(+))'
      '    AND (R.IDPESSOA = CR.IDPESSOA(+))'
      '    AND (R.UNIDNEGOC = UN.UNIDNEGOC(+))'
      '    AND (R.IDPESSOA = UN.IDPESSOA(+))'
      '    AND (R.CODTIPRECDES = TD.CODTIPRECDES(+))'
      '    AND (R.IDPESSOA = TD.IDPESSOA(+))'
      '    AND (R.RECPAG = TD.RECPAG(+))'
      '    AND (R.CODCENTROCUSTO = CC.CODCENTROCUSTO(+))'
      '    AND (R.IDPROGRAMA = PRG.IDPROGRAMA(+))'
      '    AND (R.IDPLANOPREV = PPC.IDPLANOPREV(+))'
      '    AND (R.IDPATRO = PT.IDPESSOA(+))'
      '    AND (PT.IDPESSOA = PJ.IDPESSOA(+))'
      'UNION ALL'
      'SELECT'
      
        '  Q2.DESCTDR, Q2.NOMEAP, Q2.NOMECR, SUM(((Q1.VALOR * Q2.VALOR)/ ' +
        'Q3.VALOR)) AS VALOR,'
      
        '  Q2.CENTROCUSTO, Q2.DESCPROGRAMA, Q2.PLANOPREV, Q2.PATROCINADOR' +
        'A'
      'FROM'
      '  (SELECT'
      '     DOC.NUMFATURA,'
      '     LAN.VALOR'
      '  FROM'
      '     DOCUMENTO DOC,'
      '     LANCTODOCUM LAN'
      '  WHERE'
      '    (DOC.CODDOCUMENTO = :CODDOCUMENTO) AND'
      '    ((LAN.OPERACAO = '#39'3 '#39') OR (LAN.OPERACAO = '#39'13'#39')) AND'
      '    (LAN.CODDOCUMENTO = DOC.CODDOCUMENTO)) Q1,'
      ' (SELECT'
      '   D.NUMFATURA,'
      '   RD.VALOR,'
      '   TDR.DESCRICAO AS DESCTDR,'
      '   AP.NOME AS NOMEAP,'
      '   CR.NOME AS NOMECR,'
      '   CT.NOME AS CENTROCUSTO,'
      '   PG.DESCPROGRAMA,'
      '   PLC.NOME AS PLANOPREV,'
      '   PJ.NOME AS PATROCINADORA'
      '  FROM'
      '   RATEIODOCUM RD,'
      
        '   UNIDNEGOCIO AP, CENTRESPON CR, TIPORECEBDESEMB TDR, DOCUMENTO' +
        ' D,'
      '   CENTCUST CT, PROGRAMA PG, PLANPREVCONTABIL PLC,'
      '   PESSOA PJ,'
      '   PATRO PT'
      '  WHERE'
      '   (D.NUMFATURA IS NOT NULL)                    AND'
      '   (D.NUMFATURA = :NUMFATURA)                   AND'
      '   (D.CODDOCUMENTO        = RD.CODDOCUMENTO)    AND'
      '   (TDR.CODTIPRECDES(+)   = RD.CODTIPRECDES)    AND'
      '   (TDR.RECPAG(+)         = RD.RECPAG)          AND'
      '   (TDR.IDPESSOA(+)       = RD.IDPESSOA)        AND'
      '   (AP.UNIDNEGOC(+)       = RD.UNIDNEGOC)       AND'
      '   (AP.IDPESSOA(+)        = RD.IDPESSOA)        AND'
      '   (CR.CODCENTRORESPON(+) = RD.CODCENTRORESPON) AND'
      '   (CT.CODCENTROCUSTO(+)  = RD.CODCENTROCUSTO)  AND'
      '   (PG.IDPROGRAMA(+)      = RD.IDPROGRAMA)      AND'
      '   (PLC.IDPLANOPREV(+)    = RD.IDPLANOPREV)     AND'
      '   (CR.IDPESSOA(+)        = RD.IDPESSOA)        AND'
      '   (RD.IDPATRO            = PT.IDPESSOA(+))     AND'
      '   (PT.IDPESSOA           = PJ.IDPESSOA(+))'
      ''
      ') Q2,'
      '  (SELECT'
      '    D.NUMFATURA, SUM(L.VALOR) AS VALOR'
      '   FROM'
      '    LANCTODOCUM L, DOCUMENTO D'
      '   WHERE'
      '    ((L.OPERACAO = '#39'1 '#39') OR  (L.OPERACAO = '#39'11'#39')) AND'
      '    (D.CODDOCUMENTO = L.CODDOCUMENTO) AND'
      '    (D.OPERACAO = L.OPERACAO) AND'
      '    (D.NUMFATURA = :NUMFATURA) AND'
      '    (D.NUMFATURA IS NOT NULL)'
      '   GROUP BY D.NUMFATURA) Q3'
      
        'WHERE (Q1.NUMFATURA = Q2.NUMFATURA) AND (Q3.NUMFATURA = Q2.NUMFA' +
        'TURA)'
      'GROUP BY'
      
        '   Q2.DESCTDR, Q2.NOMEAP, Q2.NOMECR, Q2.CENTROCUSTO, Q2.DESCPROG' +
        'RAMA, Q2.PLANOPREV, Q2.PATROCINADORA) U'
      'ORDER BY'
      '   U.NOMEAP, U.NOMECR, U.PATROCINADORA')
    ValidateWithMask = True
    Left = 176
    Top = 376
    ParamData = <
      item
        DataType = ftFloat
        Name = 'CODDOCUMENTO'
        ParamType = ptInput
      end
      item
        DataType = ftFloat
        Name = 'CODDOCUMENTO'
        ParamType = ptInput
      end
      item
        DataType = ftFloat
        Name = 'NUMFATURA'
        ParamType = ptInput
      end
      item
        DataType = ftFloat
        Name = 'NUMFATURA'
        ParamType = ptInput
      end>
  end
  object QryContabBaixa: TwwQuery
    AfterOpen = QryContabBaixaAfterOpen
    DatabaseName = 'BaseDados'
    DataSource = DsAp
    SQL.Strings = (
      'SELECT'
      '    CONTACONTABIL,'
      '    NOMECC,'
      '    NOMESUBCONTA,'
      '    NOMEAP,'
      '    HISTORICO,'
      '    DEBCRE,'
      '    VALOR,'
      '    PLNPLANIL,'
      '    PLANOME,'
      '    PLAREDUZ,'
      '    PLACONTACCX,'
      '    UNIDCCX,'
      '    PLANOPREVCCX,'
      '    VALORCCX,'
      '    PATROCCX'
      'FROM'
      '   (SELECT'
      '       '#39#39' AS CONTACONTABIL,'
      '       '#39#39' AS NOMECC,'
      '       '#39#39' AS NOMESUBCONTA,'
      '       '#39#39' AS NOMEAP,'
      
        '       ('#39'BAIXA DOC Nº '#39' || D.NODOCUMENTO || '#39' '#39' || D.COMPLDOCUME' +
        'NTO) AS HISTORICO,'
      '       DECODE(L.DEBCRE,'#39'D'#39','#39'C'#39','#39'D'#39') AS DEBCRE,'
      '       L.VALOR,'
      '       PL.PLNPLANIL,'
      '       PCONTA.PLANOME, PCONTA.PLAREDUZ,'
      '       PC.PLACONTA  AS PLACONTACCX,'
      '       '#39#39' AS UNIDCCX,'
      '       '#39#39' AS PLANOPREVCCX,'
      '       0  AS VALORCCX,'
      '       '#39#39' AS PATROCCX'
      '    FROM'
      '       PESSOA PD,'
      '       PESSOA PB,'
      '       DOCUMENTO D,'
      '       LANCTODOCUM L,'
      '       EMPRESAFORN E,'
      '       RECBTOPAGTO R,'
      '       PORTADORFORMA P,'
      '       PORTADORCONTA PC,'
      '       PLANILHA PL,'
      '       AGENCIABANCARIA AG,'
      '       BANCO B,'
      '       TIPODOCRECPAG TD,'
      '       CENTCUST CC,'
      '       PLANOCONTA  PCONTA,'
      '      (SELECT'
      '           VALOR,CODDOCUMENTO, DATALANCTO'
      '       FROM'
      '           LANCTODOCUM'
      '       WHERE (CODDOCUMENTO = :CODDOCUMENTO) AND'
      '             (OPERACAO IN ('#39'1 '#39','#39'2 '#39','#39'3 '#39','#39'15'#39'))) LANC'
      '    WHERE'
      
        '       ((D.OPERACAO = '#39'15'#39') OR (D.STATUS = '#39'2'#39') OR ((D.STATUS = ' +
        '0) AND (L.ESTORNO > 0))) AND'
      '       (PCONTA.PLANO(+) = PC.PLANO)               AND'
      '       (PCONTA.PLACONTA(+) = PC.PLACONTA)         AND'
      '       (D.CODDOCUMENTO = :CODDOCUMENTO)           AND'
      '       (D.CODDOCUMENTO = LANC.CODDOCUMENTO)       AND'
      '       (D.IDFORCLI = PD.IDPESSOA)                 AND'
      '       (D.CODDOCUMENTO = L.CODDOCUMENTO)          AND'
      '       (R.NUMLANCTO = L.NUMLANCTO)                AND'
      '       (R.CODDOCUMENTO = L.CODDOCUMENTO)          AND'
      '       (R.CODPORTFORMA = P.CODPORTFORMA)          AND'
      '       (PC.IDBANCO = B.IDPESSOA)'#9'          AND'
      '       (B.IDPESSOA = PB.IDPESSOA)                 AND'
      '       (D.IDFORCLI = E.IDFORCLI)                  AND'
      '       (D.IDPESSOA = E.IDPESSOA)                  AND'
      '       (P.CODPORTADOR = PC.CODPORTADOR)           AND'
      '       (PL.PLNCODIGO = L.PLNCODIGO)               AND'
      '       (AG.IDPESSOA = PC.IDAGENCIA)               AND'
      '       (CC.CODCENTROCUSTO(+) = PC.CODCENTROCUSTO) AND'
      '       (CC.IDEMPRESA(+) = PC.IDEMPRESA)           AND'
      '       (TD.CODTIPDOC = D.CODTIPDOC)'
      'UNION'
      '    SELECT'
      
        '       DECODE(D.PLACONTA,NULL,E.CONTACFORN,D.PLACONTA) AS CONTAC' +
        'ONTABIL,'
      '       CC.NOME AS NOMECC,'
      '       SC.NOMESUBCONTA,'
      '       '#39#39' AS NOMEAP,'
      
        '       ('#39'BAIXA DOC Nº '#39' || D.NODOCUMENTO || '#39' '#39' || D.COMPLDOCUME' +
        'NTO) AS HISTORICO,'
      '       L.DEBCRE,'
      '       0 AS VALOR,'
      '       PL.PLNPLANIL,'
      '       PCONTA.PLANOME, PCONTA.PLAREDUZ,'
      '       CCB.PLACONTA   AS PLACONTACCX,'
      '       U.NOME AS UNIDCCX,'
      '       PCB.NOME AS PLANOPREVCCX,'
      '       CCB.VALOR AS VALORCCX,'
      '       PTX.NOME AS PATROCCX'
      '    FROM'
      '       PESSOA PD,'
      '       PESSOA PB,'
      '       DOCUMENTO D,'
      '       LANCTODOCUM L,'
      '       EMPRESAFORN E,'
      '       RECBTOPAGTO R,'
      '       PORTADORFORMA P,'
      '       PORTADORCONTA PC,'
      '       PLANILHA PL,'
      '       AGENCIABANCARIA AG,'
      '       BANCO B,'
      '       TIPODOCRECPAG TD,'
      '       SUBCONTA SC,'
      '       CENTCUST CC,'
      '       PLANOCONTA  PCONTA,'
      '       CCBAIXASXDOCUM CCB,'
      '       PLANPREVCONTABIL PCB,'
      '       UNIDNEGOCIO U,'
      '       PESSOA PTX,'
      '       (SELECT'
      '           VALOR,CODDOCUMENTO, DATALANCTO'
      '        FROM'
      '           LANCTODOCUM'
      '        WHERE (CODDOCUMENTO = :CODDOCUMENTO) AND'
      '              (OPERACAO IN ('#39'1 '#39','#39'2 '#39','#39'3 '#39','#39'15'#39'))) LANC'
      '    WHERE'
      
        '       ((D.OPERACAO = '#39'15'#39') OR (D.STATUS = '#39'2'#39') OR ((D.STATUS = ' +
        '0) AND (L.ESTORNO > 0))) AND'
      '       (D.CODDOCUMENTO = :CODDOCUMENTO )     AND'
      '       (D.CODDOCUMENTO = LANC.CODDOCUMENTO) AND'
      '       (D.IDFORCLI = PD.IDPESSOA)           AND'
      '       (PCONTA.PLANO(+) = D.PLANO)          AND'
      '       (PCONTA.PLACONTA(+) = D.PLACONTA)    AND'
      '       (D.CODDOCUMENTO = L.CODDOCUMENTO)    AND'
      '       (R.NUMLANCTO = L.NUMLANCTO)          AND'
      '       (R.CODDOCUMENTO = L.CODDOCUMENTO)    AND'
      '       (R.CODPORTFORMA = P.CODPORTFORMA)    AND'
      '       (PC.IDBANCO = B.IDPESSOA)'#9'    AND'
      '       (B.IDPESSOA = PB.IDPESSOA)           AND'
      '       (D.IDFORCLI = E.IDFORCLI)            AND'
      '       (D.IDPESSOA = E.IDPESSOA)            AND'
      '       (P.CODPORTADOR = PC.CODPORTADOR)     AND'
      '       (PL.PLNCODIGO = L.PLNCODIGO)         AND'
      '       (AG.IDPESSOA = PC.IDAGENCIA)         AND'
      '       (SC.CODSUBCONTA(+) = D.CODSUBCONTA)       AND'
      '       (SC.IDPESSOA(+) = D.IDPESSOA)             AND'
      '       (CC.CODCENTROCUSTO(+) = D.CODCENTROCUSTO) AND'
      '       (CC.IDEMPRESA(+) = D.IDEMPRESA)           AND'
      '       (TD.CODTIPDOC = D.CODTIPDOC)         AND'
      '       (D.CODDOCUMENTO  = CCB.CODDOCUMENTO(+)) AND'
      '       (CCB.IDPLANOPREV = PCB.IDPLANOPREV(+)) AND'
      '       (CCB.UNIDNEGOC   = U.UNIDNEGOC(+)) AND'
      '       (CCB.IDPATRO = PTX.IDPESSOA(+))'
      '           )'
      ''
      'ORDER BY'
      '  DEBCRE DESC'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 176
    Top = 264
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CODDOCUMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODDOCUMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODDOCUMENTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODDOCUMENTO'
        ParamType = ptUnknown
      end>
  end
  object QryLancAlt: TwwQuery
    DatabaseName = 'BaseDados'
    DataSource = DsAp
    SQL.Strings = (
      'SELECT'
      '  TA.DESCRICAO, TA.ACRESDECRES, L.HISTORICOCOMPL, L.VALOR'
