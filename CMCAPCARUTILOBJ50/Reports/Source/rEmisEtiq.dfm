  object SqlReports: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   REPORTS.TEMPLATE'
      'FROM'
      '   REPORTS'
      'WHERE'
      '   (REPORTS.IDREPORTS = :PIDREPORTS) AND'
      '   (REPORTS.ORIGEMCM  = :PORIGEMCM)')
    ClientDataSet = CdsReports
    Left = 72
    Top = 168
  end
  object CdsModelos: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 167
    Top = 163
  end
  object SqlModelos: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      'IDETIQUETA, MODELOETIQ, IDREPORTS, ORIGEMCM    '
      'FROM ETIQUETA'
      'WHERE  IDETIQUETA = :IDETIQUETA'
      'ORDER BY MODELOETIQ')
    ClientDataSet = CdsModelos
    Left = 231
    Top = 163
  end
