  object SqlTipoEncargo: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '    TIPOAGRE.DESCCUSTAGREG,'
      '    TIPOAGRE.CODTIPOCUSTAGREG'
      'FROM'
      '    TIPOAGRE,'
      '    TIPOALTERADOR'
      'WHERE'
      '    ( TIPOAGRE.CODALTERADOR = TIPOALTERADOR.CODALTERADOR(+) )'
      'AND ( TIPOAGRE.CODTRATFISCD IN ('#39'8'#39','#39'9'#39','#39'A'#39') )'
      'ORDER BY DESCCUSTAGREG'#39)
    ClientDataSet = CdsTipoEncargo
    Left = 229
    Top = 218
  end
  object CdsTipoEncargo: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 237
    Top = 186
  end
