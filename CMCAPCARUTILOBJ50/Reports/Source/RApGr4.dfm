  object SqlRateio: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   ATV.NOME AS ATIVPROJ,'
      
        '   DECODE(TRIM(CC.CODEXTERNO),'#39#39','#39#39',TRIM(CC.CODEXTERNO) || '#39' - '#39 +
        ' || CC.NOME) AS CENTCUSTO,'
      
        '   DECODE(TRIM(CR.CODEXTERNO),'#39#39','#39#39',TRIM(CR.CODEXTERNO) || '#39' - '#39 +
        ' || CR.NOME) AS CENTRESP,'
      
        '   DECODE(TRIM(TRD.CODTIPRECDES),'#39#39','#39#39',TRIM(TRD.CODTIPRECDES) ||' +
        ' '#39' - '#39' || TRD.DESCRICAO) AS TIPORECDES,'
      '   PRG.DESCPROGRAMA,'
      '   PL.NOME AS PLANO,'
      '   PT.NOME AS PATRO,'
      '   R.VALOR'
      ''
      'FROM'
      '   RATEIODOCUM R,'
      '   UNIDNEGOCIO ATV,'
      '   CENTRESPON CR,'
      '   CENTCUST CC,'
      '   TIPORECEBDESEMB TRD,'
      '   PROGRAMA PRG,'
      '   PLANPREVCONTABIL PL,'
      '   PESSOA PT'
      'WHERE'
      '   (R.UNIDNEGOC       = ATV.UNIDNEGOC(+)) AND'
      '   (R.CODCENTROCUSTO  = CC.CODCENTROCUSTO(+)) AND'
      '   (R.CODCENTRORESPON = CR.CODCENTRORESPON(+)) AND'
      '   (R.CODTIPRECDES    = TRD.CODTIPRECDES(+)) AND'
      '   (TRD.RECPAG        = '#39'P'#39') AND'
      '   (R.IDPROGRAMA      = PRG.IDPROGRAMA(+)) AND'
      '   (R.IDPLANOPREV     = PL.IDPLANOPREV(+)) AND'
      '   (R.IDPATRO         = PT.IDPESSOA(+)) AND'
      '   (R.CODDOCUMENTO    = :CODDOCUMENTO)'
      ' ')
    ClientDataSet = CdsRateio
    Left = 152
    Top = 176
  end
