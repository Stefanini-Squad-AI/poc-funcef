  object sqlCabecario: TCMSqlParams
    SQL.Strings = (
      'select '
      '  i.imagem, p.numdocumento '
      'from '
      '  pessoa p, imagens i'
      'where '
      '  ( p.idimagem = i.idimagem ) and '
      '  (p.idpessoa = :idpessoa)')
    ClientDataSet = cdsCabecario
    Left = 80
    Top = 176
  end
