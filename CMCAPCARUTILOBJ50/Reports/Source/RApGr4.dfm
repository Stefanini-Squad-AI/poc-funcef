  object SqlAlterador: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   A.DESCRICAO,'
      '   LC.VALOR,'
      '   LC.HISTORICOCOMPL,'
      '   LC.DEBCRE,'
      '   LC.VLRLIQUIDO,'
      '   A.CODALTERADOR,'
      '   A.FLGINCIDEIRRF'
      '   '
      'FROM'
      '   DOCUMENTO D,'
      '   LANCTODOCUM LC,'
      '   TIPOALTERADOR A'
      '   '
      'WHERE'
      '  (D.CODDOCUMENTO  = LC.CODDOCUMENTO) AND'
      '  (LC.OPERACAO     = 4) AND'
      '  (LC.CODALTERADOR = A.CODALTERADOR)'
      ' '
      ' '
      ' ')
    ClientDataSet = CdsAlterador
    Left = 288
    Top = 176
  end
