  object sqlAP: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   LT.TIPO, '
      
        '   LT.NUMLOTE,                                                  ' +
        '                 '
      
        '   RAD.DATAFIMPROCESSO,                                         ' +
        '                 '
      
        '   DECODE(RAD.FLGOK,'#39'S'#39','#39'Aprovado'#39','#39'N'#39','#39'Pendente'#39','#39'R'#39','#39'Recusado'#39 +
        ') AS STATUSRAD,  '
      
        '   LT.OPERACAO, LT.NUMFATURA, LT.CODDOCUMENTO, LT.NUMAPGR,      ' +
        '                 '
      
        '   LT.REFERENCIA, LT.NODOCUMENTO, LT.COMPLDOCUMENTO, LT.DATAVENC' +
        'TO,              '
      
        '   LT.DATAEMISSAO, LT.DATAPROGRAMADA, LT.NUMDOCUMENTO, LT.VALOR,' +
        '                 '
      
        '   LT.VALOROUTRAMOEDA, LT.RAZAOSOCIAL, LT.DESCRICAO,            ' +
        '                 '
      
        '   LT.HISTORICOCOMPL AS HISTORICO, LT.OBS,                      ' +
        '                 '
      
        '   LT.IDPROCESSO,                                               ' +
        '                 '
      
        '   LT.FLGDOCBANCARIO, LT.VLACRE, LT.VLDEC, LT.VLIMP, LT.VLLIQ,  ' +
        '                 '
      
        '   LT.TRGUSERINCLUSAO, LT.TRGDTINCLUSAO, LT.IDFORCLI, LT.TIPODOC' +
        ',                '
      
        '   USU.IDUSUARIO, USU.NOMEUSUARIO,                              ' +
        '                 '
      
        '   '#39#39' AS DESCESTORNO,                                           ' +
        '               '
      '   LT.IDPROCESSO,'
      
        '   CBA.CONTACORRENTE, CBA.NUMAGENCIA, CBA.NUMBANCO,             ' +
        '                 '
      
        '   SALDO.VALSALDO                                               ' +
        '                '
      
        ' FROM                                                           ' +
        '      '
      
        '   USUARIOSISTEMA USU,                                          ' +
        '      '
      
        '  (SELECT                                                       ' +
        '      '
      
        '      CBA.IDPESSOA, CBA.IDCBANCARIA,CBA.CONTACORRENTE,          ' +
        '      '
      
        '      CBA.IDAGENCIA, AGE.IDBANCO, AGE.NUMAGENCIA, BAN.NUMBANCO  ' +
        '      '
      
        '   FROM                                                         ' +
        '      '
      
        '      CONTABANCARIA CBA, AGENCIABANCARIA AGE, BANCO BAN         ' +
        '      '
      
        '   WHERE                                                        ' +
        '      '
      
        '        CBA.IDAGENCIA    = AGE.IDPESSOA                         ' +
        '    '
      
        '    AND AGE.IDBANCO      = BAN.IDPESSOA) CBA,                   ' +
        '    '
      
        '  (SELECT                                                       ' +
        '     '
      
        '      SUM(DECODE(DEBCRE,'#39'C'#39',VALOR,VALOR * -1)) AS VALSALDO,     ' +
        '    '
      
        '      CODDOCUMENTO                                              ' +
        '      '
      
        '   FROM                                                         ' +
        '     '
      
        '      LANCTODOCUM                                               ' +
        '      '
      
        '   WHERE NOT OPERACAO IN (5,10)                                 ' +
        '     '
      
        '   GROUP BY                                                     ' +
        '     '
      
        '      CODDOCUMENTO) SALDO,                                      ' +
        '      '
      '   (SELECT FLGOK,IDPROCESSO,'
      
        '       DECODE(DATAFIMPREV,NULL,SYSDATE,DATAFIMPREV) AS DATAFIMPR' +
        'EV,'
      
        '       DECODE(DATAFIMPROCESSO,NULL,SYSDATE,DATAFIMPROCESSO) AS D' +
        'ATAFIMPROCESSO '
      '    FROM RADINSTPROCESSO'
      '    ) RAD,'
      
        '   (SELECT  P.TIPO, L.OPERACAO, D.NUMFATURA, D.CODDOCUMENTO,    ' +
        '       '
      
        '       D.NUMAPGR, D.REFERENCIA, D.NODOCUMENTO,                  ' +
        '       '
      
        '       D.COMPLDOCUMENTO, D.DATAVENCTO, D.DATAEMISSAO,           ' +
        '       '
      
        '       D.DATAPROGRAMADA, P.NUMDOCUMENTO, L.VALOR,  L.VALOROUTRAM' +
        'OEDA,  '
      
        '       P.RAZAOSOCIAL, F.DESCRICAO, L.HISTORICOCOMPL, D.OBS,     ' +
        '       '
      '       D.IDPROCESSO,'
      
        '       F.FLGDADOSBANCARIOS  AS FLGDOCBANCARIO,                  ' +
        '       '
      
        '       (0) AS VLACRE, (0) AS VLDEC, (0) AS VLIMP, (0) AS VLLIQ, ' +
        'D.TRGUSERINCLUSAO,   '
      
        '       D.TRGDTINCLUSAO,  D.IDFORCLI, TD.DESCRICAO AS TIPODOC,   ' +
        '        '
      
        '       LXDOC.NUMLOTE, D.IDUSUARIOINCLUSAO, D.IDCBANCARIA        ' +
        '        '
      
        '    FROM                                                        ' +
        '        '
      
        '       PESSOA P, DOCUMENTO D, LANCTODOCUM L,                    ' +
        '        '
      
        '       FORMARECPAG F, TIPODOCRECPAG TD,                         ' +
        '        '
      '       LOTEXDOCUM LXDOC                               '
      
        '    WHERE                                                       ' +
        '       '
      '   (D.CODDOCUMENTO = 264994 ) AND '
      
        '      (D.CODDOCUMENTO = LXDOC.CODDOCUMENTO(+)) AND              ' +
        '        '
      '      (L.OPERACAO IN ('#39'1'#39','#39'2'#39','#39'3'#39','#39'11'#39','#39'14'#39')) AND             '
      
        '      (L.ESTORNO IS NULL) AND                                   ' +
        '        '
      '      (D.RECPAG           = '#39'P'#39') AND '
      '      (D.IDPESSOA         = 1)  AND    '
      
        '      (D.CODDOCUMENTO     = L.CODDOCUMENTO) AND                 ' +
        '        '
      
        '      (P.IDPESSOA         = D.IDFORCLI) AND                     ' +
        '        '
      
        '      (D.CODFORMA         = F.CODFORMA(+)) AND                  ' +
        '        '
      
        '      (TD.CODTIPDOC       = D.CODTIPDOC)         AND            ' +
        '        '
      
        '      (NVL(TD.FLGIMPRIMEAP, '#39'S'#39') = '#39'S'#39')                         ' +
        '    '
      
        '      ) LT                                                      ' +
        '        '
      
        '   WHERE                                                        ' +
        '        '
      
        '         (lt.IDCBANCARIA  = CBA.IDCBANCARIA(+))                 ' +
        '        '
      
        '     AND (lt.IDUSUARIOINCLUSAO = USU.IDUSUARIO)                 ' +
        '        '
      
        '     AND (LT.CODDOCUMENTO  = SALDO.CODDOCUMENTO)                ' +
        '        '
      
        '     AND (LT.IDPROCESSO    = RAD.IDPROCESSO(+))                 ' +
        '        '
      
        '  AND (LT.IDPROCESSO    = RAD.IDPROCESSO(+))                    ' +
        '  ')
    ClientDataSet = cdsPrincipal
    Left = 24
    Top = 176
  end
