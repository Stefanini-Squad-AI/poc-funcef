  object SqlContab: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   LC.PLACONTA,LC.CODSUBCONTA,'
      '   PC.PLANOME,'
      '   LC.LACDEBCRE,LC.LACVALOR,'
      '   LC.LACVALHIST,'
      
        '   LC.LACHIST1 || LC.LACHIST2 || LC.LACHIST3 || LC.LACHIST4 || L' +
        'C.LACHIST5 AS HISTORICO,'
      '   LC.PLNCODIGO,'
      '   LC.PLANO,LC.LACTIPO,LC.LACNUMDOC,'
      '   P.PLNDATDIA'
      '  '
      'FROM'
      '   LANCTODOCUM L,'
      '   DOCUMENTO D,'
      '   PLANILHA P,'
      '   LANCAMENTO LC,'
      '   PLANOCONTA PC'
      '   '
      'WHERE'
      '   (PC.PLACONTA    = LC.PLACONTA) AND'
      
        '   ((LC.PLNCODIGO  = L.PLNCODIGO) OR (LC.PLNCODIGO = L.PLNANTECI' +
        'PA) )AND'
      '   (P.PLNCODIGO    = LC.PLNCODIGO) AND'
      '   (D.CODDOCUMENTO = L.CODDOCUMENTO) AND'
      '   (L.CODDOCUMENTO = 12241)'
      '')
    ClientDataSet = CdsContab
    Left = 224
    Top = 176
  end
