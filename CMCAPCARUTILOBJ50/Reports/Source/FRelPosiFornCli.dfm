  object SqlUsuarios: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '  U.IDUSUARIO,'
      '  U.NOMEUSUARIO,'
      '  P.NOME'
      'FROM USUARIOSISTEMA U, PESSOA P'
      'WHERE U.IDUSUARIO = P.IDPESSOA'
      'ORDER BY P.NOME')
    ClientDataSet = CdsUsuarios
