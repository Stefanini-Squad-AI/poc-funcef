  object dsDocumentos: TDataSource
    DataSet = cdsDocumentos
    Left = 56
    Top = 80
  end
  object sqlDocumentos: TCMSqlParams
    SQL.Strings = (
      'SELECT (0) AS SELECIONADO,'
      '       D.DATAPROGRAMADA,'
      '       D.DATAEMISSAO,'
      
        '       (RTRIM(D.NODOCUMENTO) || '#39' '#39' || RTRIM(D.COMPLDOCUMENTO)) ' +
        'As Documento,'
      '       D.CODDOCUMENTO,'
      
        '       DECODE(D.IDENVIODOCUMENTO, NULL, '#39'Não Encaminhado'#39', '#39'Enca' +
        'minhado'#39') As Status,'
      '       P.RAZAOSOCIAL,'
      '       D.NODOCUMENTO,'
      '       D.NUMAPGR,'
      '       D.DATAVENCTO,'
      '       PP.PLNPLANIL,'
      '       D.IDENVIODOCUMENTO,'
      '       L.VALOR AS VALORBRUTO,'
      '       VW.SALDO AS VALORLIQUIDO,'
      
        '       DECODE(E.TRGDTINCLUSAO, NULL, '#39'-----'#39', TO_CHAR(E.TRGDTINC' +
        'LUSAO, '#39'DD/MM/YYYY HH24:MI:SS'#39')) AS DATAENVIO,'
      '       NVL(U.NOMEUSUARIO, '#39'-------'#39') AS NOMEUSUARIO '
      
        '  FROM DOCUMENTO D, PESSOA P, LANCTODOCUM L, PLANILHA PP, VWSALD' +
        'ODOC VW, ENVIODOCUMENTO E, USUARIOSISTEMA U'
      ' WHERE (D.IDPESSOA = 1)'
      '   AND (D.RECPAG = '#39'R'#39')'
      '   AND (D.IDFORCLI = P.IDPESSOA)'
      '   AND (D.CODDOCUMENTO = VW.CODDOCUMENTO)'
      '   AND (D.CODDOCUMENTO = L.CODDOCUMENTO)'
      '   AND (D.OPERACAO = L.OPERACAO)'
      '   AND (L.PLNCODIGO = PP.PLNCODIGO)'
      '   AND (D.IDENVIODOCUMENTO = E.IDENVIODOCUMENTO)'
      '   AND (E.IDUSUARIO = U.IDUSUARIO(+))'
      '   AND (D.NUMSLIP IS NULL)'
      '   AND (D.STATUS <> '#39'2'#39' OR D.STATUS IS NULL)'
      '   AND (D.OPERACAO IN ('#39'2'#39', '#39'3'#39', '#39'14'#39'))'
      '   and D.CODTIPDOC in'
      '       (SELECT CODTIPDOC'
      '          FROM TIPODOCRECPAG a'
      '         WHERE a.RECPAG = '#39'R'#39
      '           and not exists (select 1'
      '                  from UsuarioxTpdocto b'
      '                 where recpag = '#39'R'#39
      '                   and b.idusuario = 1)'
      '        union'
      '        SELECT CODTIPDOC'
      '          FROM TIPODOCRECPAG a'
      '         WHERE a.RECPAG = '#39'R'#39
      '           and exists (select 1'
      '                  from UsuarioxTpdocto b'
      '                 where recpag = '#39'R'#39
      '                   and a.codtipdoc = b.codtipdoc'
      '                   and b.idusuario = 1))'
      '   and D.DATAEMISSAO >= to_date('#39'02/11/2007'#39', '#39'dd/mm/yyyy'#39')'
      '   and D.DATAEMISSAO <= to_date('#39'02/01/2008'#39', '#39'dd/mm/yyyy'#39')'
      '   --AND D.IDENVIODOCUMENTO IS NOT NULL'
      
        '   --AND E.TRGDTINCLUSAO = TO_DATE('#39'28/12/2007 16:10:26'#39', '#39'DD/MM' +
        '/YYYY HH24:MI:SS'#39')'
      ' ORDER BY P.RAZAOSOCIAL, NODOCUMENTO'
      ' '
      ' ')
    ClientDataSet = cdsDocumentos
    Left = 56
    Top = 128
  end
