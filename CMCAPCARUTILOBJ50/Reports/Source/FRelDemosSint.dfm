  object CdsCentroRespon: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 160
    Top = 16
  end
  object SqlCentroRespon: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  IDPLANCRESPON,'
      '  CODEXTERNO,'
      '  CODCENTRORESPON,'
      '  NOME,'
      '  ANALITICOSINTET,'
      '  CODCENTROCUSTO'
      'FROM'
      '  CENTRESPON'
      'WHERE'
      '  IDPESSOA = :IDPESSOA AND'
      '  IDPLANCRESPON = :IDPLANCRESPON AND'
      '  RTRIM(CODCENTRORESPON) <> '#39'9999999999'#39
      'ORDER BY'
      '  IDPLANCRESPON, CODEXTERNO, ANALITICOSINTET DESC'
      ' ')
    ClientDataSet = CdsCentroRespon
    Left = 336
    Top = 72
  end
