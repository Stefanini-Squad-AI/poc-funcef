  object SqlTipoDoc: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  CODTIPDOC,'
      '  DESCRICAO,'
      '  DEBCRE,'
      '  FLGENGLOBAPARCELA,'
      '  FLGGERANUMDOC,'
      '  FLGDOCFISCAL'
      'FROM TIPODOCRECPAG a'
      'WHERE'
      '  A.RECPAG = :pRECPAG'
      '  AND NOT EXISTS (SELECT 1 FROM UsuarioxTpdocto B'
      '                  WHERE RECPAG    = :pRECPAG'
      '                  AND B.IDUSUARIO = :pIDUSUARIO)'
      '  UNION'
      '     SELECT CODTIPDOC,DESCRICAO,DEBCRE, FLGENGLOBAPARCELA,'
      '            FLGGERANUMDOC, FLGDOCFISCAL FROM TIPODOCRECPAG A'
      '     WHERE  A.RECPAG = :pRECPAG'
      '            AND  EXISTS (SELECT 1 FROM UsuarioxTpdocto B'
      '                         WHERE RECPAG = :pRECPAG'
      '                               AND A.CODTIPDOC = B.CODTIPDOC'
      '                               AND B.IDUSUARIO = :pIDUSUARIO)'
      'ORDER BY DEBCRE DESC, DESCRICAO  '
      ' '
      '')
    ClientDataSet = CdsTipoDoc
    Left = 239
    Top = 389
  end
