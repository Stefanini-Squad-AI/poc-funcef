  object SqlModelo: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      'IDETIQUETA, MODELOETIQ, IDREPORTS, ORIGEMCM    '
      'FROM ETIQUETA'
      'ORDER BY MODELOETIQ')
