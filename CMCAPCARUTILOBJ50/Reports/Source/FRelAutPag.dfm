  object msDoc: TMontaSelect
    Template.IdConsulta = 0
    Caption = 'Seleciona'
    Colunas.Strings = (
      'DOCUMENTO .NUMAPGR'
      'DOCUMENTO.NODOCUMENTO'
      'DOCUMENTO.COMPLDOCUMENTO'
      'PESSOA .RAZAOSOCIAL'
      'DOCUMENTO.DATAEMISSAO'
      'LANCTODOCUM.DATALANCTO'
      'DOCUMENTO.DATAVENCTO'
      'DOCUMENTO.DATAPROGRAMADA'
      'LANCTODOCUM.VALOR'
      'PORTADORFORMA.DESCRICAO'
      'LANCTODOCUM.HISTORICOCOMPL'
      'MODULO.NOMEMODULO')
    TipodeDado.Strings = (
      'N'
      'N'
      'C'
      'C'
      'D'
      'D'
      'D'
      'D'
      'C'
      'C'
      'C'
      'C')
    Descricao.Strings = (
      'Nº da AP'
      'Nº Documento'
      'Complemento'
      'Razão Social'
      'Dt. Emissão'
      'Dt. Lançamento'
      'Dt. Vencimento'
      'Dt. Programada'
      'Valor'
      'Portador x Forma'
      'Histórico'
      'Módulo')
    SensivelACaixa.Strings = (
      'N'
      'N'
      'N'
      'N'
      'N'
      'N'
      'N'
      'N'
      'N'
      'N'
      'N'
      'N')
    Tabelas.Strings = (
      'PESSOA '
      'DOCUMENTO '
      'LANCTODOCUM '
      'PORTADORFORMA '
      'MODULO'
      'TIPODOCRECPAG')
    CamposChave.Strings = (
      'DOCUMENTO.CODDOCUMENTO'
      'DOCUMENTO.COMPLDOCUMENTO'
      'DOCUMENTO.DATAVENCTO'
      'DOCUMENTO.DATAPROGRAMADA'
      'DOCUMENTO.OPERACAO'
      'DOCUMENTO.DATAEMISSAO'
      'LANCTODOCUM.VALOR'
      'DOCUMENTO.NODOCUMENTO'
      'PESSOA.RAZAOSOCIAL'
      'DOCUMENTO .NUMAPGR'
      'DOCUMENTO .NODOCUMENTO'
      'MODULO.IDMODULO'
      'LANCTODOCUM.DATALANCTO')
    Filtro.Strings = (
      '    DOCUMENTO.IDFORCLI = PESSOA.IDPESSOA  '
      '    DOCUMENTO.CODDOCUMENTO = LANCTODOCUM.CODDOCUMENTO '
      '    DOCUMENTO.OPERACAO = LANCTODOCUM.OPERACAO  '
      '    DOCUMENTO.CODPORTFORMA = PORTADORFORMA.CODPORTFORMA(+)  '
      '    DOCUMENTO.OPERACAO IN (2,3,10,11,13,14,15,16,17) '
      '    LANCTODOCUM.ESTORNO IS NULL  '
      '    DOCUMENTO.IDMODULO = MODULO.IDMODULO  '
      '    DOCUMENTO.CODTIPDOC = TIPODOCRECPAG.CODTIPDOC  '
      
        '    TIPODOCRECPAG.FLGIMPRIMEAP IS NULL OR TIPODOCRECPAG.FLGIMPRI' +
        'MEAP = '#39'S'#39'  '
      '    DOCUMENTO.RECPAG = '#39'P'#39'  '
      '    DOCUMENTO.IDPESSOA = 1 '
      
        '    DOCUMENTO.CODTIPDOC IN (SELECT CODTIPDOC  FROM TIPODOCRECPAG' +
        ' a  WHERE a.RECPAG = '#39'P'#39'  AND NOT EXISTS (SELECT 1  FROM Usuario' +
        'xTpdocto b  WHERE recpag = '#39'P'#39' AND b.idusuario = 1202560) UNION ' +
        '    SELECT CODTIPDOC FROM TIPODOCRECPAG a  WHERE a.RECPAG = '#39'P'#39' ' +
        'AND EXISTS (SELECT 1 FROM UsuarioxTpdocto b  WHERE recpag = '#39'P'#39' ' +
        'AND a.codtipdoc = b.codtipdoc  AND b.idusuario = 1202560))')
    Mascaras.Strings = (
      ''
      '#0'
      ''
      ''
      'DD/MM/YYYY'
      'DD/MM/YYYY'
      'DD/MM/YYYY'
      'DD/MM/YYYY'
      '#,##0.00'
      ''
      ''
      '')
