  object SqlCentroRespon: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  IDPLANCRESPON,'
      '  CODEXTERNO,'
      '  CODCENTRORESPON,'
      '  NOME,'
      '  ANALITICOSINTET,'
      '  CODCENTROCUSTO'
      'FROM'
      '  CENTRESPON'
      'WHERE'
      '  IDPESSOA = :IDPESSOA AND'
      '  RTRIM(CODCENTRORESPON) <> '#39'9999999999'#39' AND'
