  object SqlCapContab: TCMSqlParams
    SQL.Strings = (
      'SELECT U.DATAREF,'
      '       SUM(U.TOTDEBCAP) AS TOTDEBCAP,'
      '       SUM(U.TOTCRECAP) AS TOTCRECAP,'
      '       SUM(U.TOTDEBCON) AS TOTDEBCON,'
      '       SUM(U.TOTCRECON) AS TOTCRECON,'
      '       SUM(U.TOTCRECAP) - SUM(U.TOTCRECON) AS DIFTOTCRED,'
      '       SUM(U.TOTDEBCAP) - SUM(U.TOTDEBCON) AS DIFTOTDEBT'
      'FROM'
      '(SELECT L.DATALANCTO AS DATAREF,'
      '       SUM(DECODE(L.DEBCRE,'#39'D'#39',L.VALOR,0)) AS TOTDEBCAP,'
      '       SUM(DECODE(L.DEBCRE,'#39'C'#39',L.VALOR,0)) AS TOTCRECAP,'
      '       0 AS TOTDEBCON,'
      '       0 AS TOTCRECON'
      'FROM DOCUMENTO D,'
      '     LANCTODOCUM L'
      'WHERE'
      '      (L.CODDOCUMENTO = D.CODDOCUMENTO) AND'
      '      (L.OPERACAO IN ('#39'1 '#39','#39'2 '#39','#39'4 '#39','#39'5 '#39','#39'17'#39')) AND'
      '       (L.PLNCODIGO IS NOT NULL)'
      'GROUP BY L.DATALANCTO'
      'UNION ALL'
      'SELECT P.PLNDATDIA AS DATAREF,'
      '       0 AS TOTDEBCAP,'
      '       0 AS TOTCRECAP,'
      '       SUM(DECODE(L.LACDEBCRE,'#39'D'#39',L.LACVALOR,0)) AS TOTDEBCON,'
      '       SUM(DECODE(L.LACDEBCRE,'#39'C'#39',L.LACVALOR,0)) AS TOTCRECON'
      'FROM PLANILHA P,'
      '     LANCAMENTO L'
      'WHERE  (P.PLNCODIGO = L.PLNCODIGO) and 1=2'
      'GROUP BY P.PLNDATDIA) U'
      'GROUP BY U.DATAREF'
      'HAVING'
      '    (ROUND(SUM(U.TOTDEBCAP),2) <> ROUND(SUM(U.TOTDEBCON),2)) OR'
      '    (ROUND(SUM(U.TOTCRECAP),2) <> ROUND(SUM(U.TOTCRECON),2))'
      'ORDER BY U.DATAREF'
      ''
      ''
      ' ')
    ClientDataSet = CdsCapContab
    Left = 64
    Top = 56
  end
end
