    Aggregates = <>
    Params = <>
    Left = 29
    Top = 213
  end
  object SqlCpBaixa: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT'
      '   R.NUMCHQBORDERO'
      'FROM'
      '   RECBTOPAGTO R, DOCUMENTO D'
      
        '   ,(select count(*) as totdocum , NUMCHQBORDERO from recbtopagt' +
        'o rb ,'
      '   documento d ,lanctodocum l where'
      ''
      
        '    d.CODDOCUMENTO = rb.CODDOCUMENTO  and  rb.CODDOCUMENTO = l.C' +
        'ODDOCUMENTO'
      
        '    and rb.numlancto=l.numlancto and     D.RECPAG = :PRECPAG  AN' +
        'D'
      
        '      (D.numcpbaixa IS NULL OR D.numcpbaixa = 0)  and l.estorno ' +
        'is null  group by NUMCHQBORDERO  ) totdocum'
      ''
      
        ',  (select count(*) as totdocum , NUMCHQBORDERO from recbtopagto' +
        ' rb, documento d ,'
      '   lanctodocum l where'
      ''
      
        '       d.CODDOCUMENTO = rb.CODDOCUMENTO  and  rb.CODDOCUMENTO = ' +
        'l.CODDOCUMENTO'
      '       and rb.numlancto=l.numlancto and'
      '       D.RECPAG         = :PRECPAG AND'
      '       (D.numcpbaixa IS NULL OR D.numcpbaixa = 0)'
      '       and l.estorno is null and'
      
        '       d.codtipdoc in (SELECT CODTIPDOC FROM TIPODOCRECPAG a WHE' +
        'RE a.RECPAG = :PRECPAG'
      
        '       and not exists  (select 1 from UsuarioxTpdocto b where re' +
        'cpag=:PRECPAG'
      
        '       and b.idusuario=:idusuario) union  SELECT CODTIPDOC  FROM' +
        ' TIPODOCRECPAG a'
      '       WHERE a.RECPAG =  :PRECPAG'
      
        '       and exists (select 1 from UsuarioxTpdocto b where recpag=' +
        ' :PRECPAG and'
      '       a.codtipdoc=b.codtipdoc and b.idusuario=:idusuario))'
      '       group by NUMCHQBORDERO  ) totlote'
      ''
      'WHERE'
      ''
      '   (D.CODDOCUMENTO = R.CODDOCUMENTO) AND'
      '   (D.numcpbaixa IS NULL OR D.numcpbaixa = 0) AND'
      '   (D.RECPAG = :PRECPAG) and'
      '   totlote.NUMCHQBORDERO=totdocum.NUMCHQBORDERO and'
      '   totlote.NUMCHQBORDERO=  r.NUMCHQBORDERO and'
      '   totlote.totdocum=totdocum.totdocum'
      ''
      ''
      'ORDER BY'
      '   R.NUMCHQBORDERO'
      '')
    ClientDataSet = CdsCpBaixa
    Left = 85
    Top = 213
