  object sqlDocs: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   ('#39'N'#39') AS EMITE, L.OPERACAO, '
      '   D.NODOCUMENTO, D.COMPLDOCUMENTO, '
      
        '   L.VALOR, L.DATALANCTO, L.NUMFATURA, L.FLGTIPOFATURA, L.FLGFAT' +
        'EMITIDA,'
      '   P.RAZAOSOCIAL, L.HISTORICOCOMPL,'
      
        '   E.LOGRADOURO, E.NUMERO, E.COMPLEMENTO, E.BAIRRO, E.CEP, C.NOM' +
        'E AS NOMECIDADE,'
      '   ES.NOMEESTADO, PA.NOMEPAIS, L.NUMLANCTO, D.CODDOCUMENTO'
      'FROM'
      '   DOCUMENTO D, LANCTODOCUM L, PESSOA P, CLASFISCLIFOR C,'
      
        '   FORNSERV S, ENDPESS E, CIDADES C, ESTADO ES, PAIS PA, TIPOFAT' +
        'XCLASFIS TF'
      'WHERE'
      '   1=2'
      ''
      '')
    ClientDataSet = cdsDocs
    Left = 390
    Top = 67
  end
