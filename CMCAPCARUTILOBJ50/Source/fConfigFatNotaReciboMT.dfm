  inherited SqlModelo: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      ' DESCTIPOFATURA, '
      ' CODREDUZIDO,'
      ' FLGTIPOFATURA, '
      ' IDREPORTS, '
      ' ORIGEMCM,'
      ' IDTIPOFATURA,'
      ' CODALTERADOR'
      'FROM '
      ' TIPOFATURA'
      'ORDER BY'
      ' DESCTIPOFATURA')
  end
  inherited SqlDados: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   D.NODOCUMENTO, D.COMPLDOCUMENTO,'
      
        '   L.VALOR, L.DATALANCTO, L.NUMFATURA, L.FLGTIPOFATURA, L.FLGFAT' +
        'EMITIDA,'
      '   P.RAZAOSOCIAL, L.HISTORICOCOMPL,'
      
        '   E.LOGRADOURO, E.NUMERO, E.COMPLEMENTO, E.BAIRRO, E.CEP, C.NOM' +
        'E AS NOMECIDADE,'
      '   ES.NOMEESTADO, PA.NOMEPAIS, I.VLRRETIDO, P.NUMDOCUMENTO,'
      '   ((RD.VALOR * L.VALOR)/V.VALOR) AS VALORRATEIO, TRD.DESCRICAO,'
      
        '   (((RD.VALOR * L.VALOR)/V.VALOR) + ((((RD.VALOR * L.VALOR)/V.V' +
        'ALOR) * I.VLRRETIDO)/V.VALOR)) AS VALORRATEIOIMPOSTO,'
      
        '   LTRIM((TRD.DESCRICAO || '#39' '#39' || L.HISTORICOCOMPL)) AS DESCRICA' +
        'OHISTORICO,'
      
        '   DECODE(I.VLRRETIDO,NULL,L.VALOR,(L.VALOR + I.VLRRETIDO)) AS V' +
        'LRTOTAL'
      'FROM'
      
        '   DOCUMENTO D, LANCTODOCUM L, PESSOA P, ENDPESS E, CIDADES C, E' +
        'STADO ES, PAIS PA,'
      '   RATEIODOCUM RD, TIPORECEBDESEMB TRD,'
      '   (SELECT'
      '       L.CODDOCUMENTO, L.VALOR'
      '    FROM'
      '       LANCTODOCUM L, DOCUMENTO D'
      '    WHERE'
      '       (D.CODDOCUMENTO = :CODDOCUMENTO) AND'
      '       (D.CODDOCUMENTO = L.CODDOCUMENTO) AND'
      '       (D.OPERACAO = L.OPERACAO)) V,'
      '   (SELECT'
      
        '     I.CODDOCUMENTO, I.NUMLANCTOORIGEM, SUM(I.VLRRETIDO) AS VLRR' +
        'ETIDO'
      '    FROM'
      '     IMPOSTORETIDO I, TIPOAGRE TA'
      '    WHERE'
      '     (I.CODDOCUMENTO     = :CODDOCUMENTO)        AND'
      '     (TA.CODALTERADOR    = :CODALTERADOR)        AND'
      '     (I.CODTIPOCUSTAGREG = TA.CODTIPOCUSTAGREG)'
      '    GROUP BY'
      '     I.CODDOCUMENTO, I.NUMLANCTOORIGEM) I'
      'WHERE'
      '   (D.CODDOCUMENTO     = :CODDOCUMENTO)          AND'
      '   (V.CODDOCUMENTO     = D.CODDOCUMENTO)         AND'
      '   (L.CODDOCUMENTO     = I.CODDOCUMENTO(+))      AND'
      '   (L.NUMLANCTO        = I.NUMLANCTOORIGEM(+))   AND'
      '   (RD.CODDOCUMENTO    = D.CODDOCUMENTO)         AND'
      '   (RD.CODTIPRECDES    = TRD.CODTIPRECDES)       AND'
      '   (TRD.RECPAG         = D.RECPAG)               AND'
      '   (TRD.IDPESSOA       = D.IDPESSOA)             AND'
      '   (D.CODDOCUMENTO     = L.CODDOCUMENTO)         AND'
      '   (D.OPERACAO         = L.OPERACAO)             AND'
      '   (D.IDFORCLI         = P.IDPESSOA)             AND'
      '   (P.IDENDCOMERCIAL   = E.IDENDERECO(+))        AND'
      '   (E.IDCIDADES        = C.IDCIDADES(+))         AND'
      '   (C.CODESTADO        = ES.CODESTADO(+))        AND'
      '   (ES.IDPAIS          = PA.IDPAIS(+))')
  end
