  object sqlRateioRecibo: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   TRD.DESCRICAO,'
      '   TRD.DESCRICAO AS DESCRECDES,'
      '   RD.VALOR AS VALORRATEIO'
      'FROM'
      '   DOCUMENTO D, RATEIODOCUM RD, TIPORECEBDESEMB TRD'
      'WHERE'
      '   (D.CODDOCUMENTO = :pCODDOCUMENTO)      AND'
      '   (RD.CODDOCUMENTO  = D.CODDOCUMENTO)   AND'
      '   (TRD.CODTIPRECDES  = RD.CODTIPRECDES(+))   '
      'ORDER BY TRD.DESCRICAO')
    ClientDataSet = cdsRateioRecibo
    Left = 388
    Top = 140
  end
