  inherited SqlModelo: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      
        '  IDCARTACOBRANCA, MODELOCARTA, IDREPORTS, ORIGEMCM, FLGTIPOCART' +
        'A'
      'FROM'
      '  CARTACOBRANCA'
      'WHERE'
      '  (FLGTIPOCARTA = :FLGTIPOCARTA) ')
    Left = 84
  end
  inherited SqlDados: TCMSqlParams
    SQL.Strings = (
      
        'SELECT BX.DATABAIXA, BX.DATACFLOAT, BX.FORMARECPAG, BX.PORTADORR' +
        'ECPAG,'
      '   P.RAZAOSOCIAL, P.NUMDOCUMENTO,'
      '   E.LOGRADOURO, E.NUMERO, E.COMPLEMENTO, E.BAIRRO, E.CEP,'
      '   C.NOME AS CIDADE, ES.CODESTADO, PA.NOMEPAIS,'
      '   L.OPERACAO, L.VALOR,'
      '   D.NODOCUMENTO, D.COMPLDOCUMENTO,'
      '   DECODE(L.HISTORICOCOMPL,NULL,'
      '   DECODE(L.OPERACAO,'#39'2 '#39','#39'Valor do Documento'#39','
      '   DECODE(L.OPERACAO,'#39'5 '#39','#39'Pagamento'#39','
      '   DECODE(L.OPERACAO,'#39'3 '#39','#39'Valor do Documento'#39','
      '   DECODE(L.OPERACAO,'#39'4 '#39',T.DESCRICAO,'
      '   DECODE(L.OPERACAO,'#39'14'#39','#39'Prev. Adiantamento'#39','
      '   DECODE(L.OPERACAO,'#39'15'#39','#39'Adiantamento'#39','
      '   DECODE(L.OPERACAO,'#39'16'#39','#39'Alterador de Adianto'#39','
      '   DECODE(L.OPERACAO,'#39'1 '#39','#39'Valor do Documento'#39','
      '   DECODE(L.OPERACAO,'#39'17'#39','#39'Regulariz. Adianto'#39','
      '   DECODE(L.OPERACAO,'#39'11'#39','#39'Origem de Parcelas de Previsao'#39','
      '   DECODE(L.OPERACAO,'#39'10'#39','#39'Valor do Documento'#39','
      '   DECODE(L.OPERACAO,'#39'12'#39','#39'Previsão de Documento'#39','
      
        '   DECODE(L.OPERACAO,'#39'13'#39','#39'Parcelas de Previsão'#39','#39#39')))))))))))))' +
        ',L.HISTORICOCOMPL) as HISTORICO,'
      '   L.DATALANCTO, L.NUMFATURA, L.NUMRECIBO, D.CODDOCUMENTO,'
      '   (0.00) as SALDO,'
      
        '   L.HISTORICOCOMPL || RPAD('#39' '#39',200 - LENGTH(L.HISTORICOCOMPL),'#39 +
        ' '#39' )AS EXTENSO'
      'FROM'
      '   PESSOA P, ENDPESS E, CIDADES C, ESTADO ES, PAIS PA,'
      '   DOCUMENTO D, LANCTODOCUM L, TIPOALTERADOR T,'
      
        '   ( SELECT R.CODDOCUMENTO, R.DATABAIXA, R.DATACFLOAT, F.DESCRIC' +
        'AO AS FORMARECPAG, PC.DESCRICAO AS PORTADORRECPAG'
      
        '       FROM RECBTOPAGTO R, PORTADORFORMA P, FORMARECPAG F, PORTA' +
        'DORCONTA PC,'
      '            ( SELECT CODDOCUMENTO, MAX(DATABAIXA) AS DATABAIXA'
      '                FROM RECBTOPAGTO'
      '               GROUP BY CODDOCUMENTO ) R2'
      '      WHERE R.CODDOCUMENTO = R2.CODDOCUMENTO'
      '        AND R.DATABAIXA    = R2.DATABAIXA'
      '        AND R.CODPORTFORMA = P.CODPORTFORMA'
      '        AND P.CODFORMA = F.CODFORMA'
      '        AND P.CODPORTADOR = PC.CODPORTADOR    '
      '   ) BX'
      'WHERE'
      '   (D.CODDOCUMENTO = :CODDOCUMENTO)      AND'
      '   (P.IDENDCOMERCIAL  = E.IDENDERECO(+)) AND'
      '   (E.IDCIDADES = C.IDCIDADES(+))        AND'
      '   (C.IDESTADO = ES.IDESTADO(+))         AND'
      '   (ES.IDPAIS = PA.IDPAIS(+))            AND'
      '   (D.CODDOCUMENTO = L.CODDOCUMENTO)     AND'
      '   (D.IDFORCLI = P.IDPESSOA)             AND'
      '   (L.CODALTERADOR = T.CODALTERADOR(+))  AND'
      '   (D.CODDOCUMENTO = BX.CODDOCUMENTO(+))'
      'ORDER BY'
      '   L.OPERACAO'
      ' '
      ' '
      ' '
      ' ')
  end
