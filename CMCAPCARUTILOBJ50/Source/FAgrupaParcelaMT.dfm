  object SQLSelecionados: TCMSqlParams
    SQL.Strings = (
      ' SELECT'
      '   D.NODOCUMENTO,'
      '   L.VALOR,'
      '   M.MOESIGLA,'
      '   D.CODDOCUMENTO,'
      '   D.IDMODULO,'
      '   D.IDFORCLI,'
      '   D.MOECODIGO,'
      '   D.OPERACAO,'
      '   D.IDPESSOA,'
      '   D.STATUS,'
      '   D.NUMFATURA,'
      '   D.PLACONTA,'
      '   D.CODSUBCONTA,'
      '   D.UNIDNEGOC,'
      '   D.CODTIPDOC,'
      '   NVL(TP.FLGDOCFISCAL, '#39'S'#39') AS FLGDOCFISCAL,'
      '   D.IDPROCESSO'
      'FROM'
      '  PESSOA P,'
      '  DOCUMENTO D,'
      '  LANCTODOCUM L,'
      '  MOEDA M,  TIPODOCRECPAG TP'
      'WHERE'
      '  (D.MOECODIGO = M.MOECODIGO(+)) AND'
      '  (D.CODDOCUMENTO = L.CODDOCUMENTO) AND'
      '  (D.IDFORCLI = P.IDPESSOA) AND'
      '  (D.RECPAG = :RECPAG) AND'
      '  (D.IDFORCLI = :IDFORCLI) AND'
      '  (D.IDPESSOA = :IDPESSOA) AND'
      '  (L.OPERACAO = :OPERACAO1) AND'
      '  (D.NUMFATURA = :NUMFATURA) AND'
      '  (D.STATUS = '#39'2'#39') AND'
      '  (D.CODTIPDOC = TP.CODTIPDOC)'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ' '
      ' ')
    ClientDataSet = CdsSelecionados
    Left = 115
    Top = 269
  end
