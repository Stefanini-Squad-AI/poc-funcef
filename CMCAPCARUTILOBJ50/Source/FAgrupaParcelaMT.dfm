  object SQLFatura: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT'
      ' D.NUMFATURA'
      'FROM'
      ' DOCUMENTO D, LANCTODOCUM L'
      'WHERE'
      ' (D.CODDOCUMENTO = L.CODDOCUMENTO) AND'
      ' (D.RECPAG = :RECPAG) AND'
      ' (D.IDFORCLI = :IDFORCLI) AND'
      ' (L.OPERACAO = :OPERACAO1) AND'
      ' (D.NUMFATURA IN'
      '      (SELECT DISTINCT'
      '         D.NUMFATURA'
      '       FROM'
      '         DOCUMENTO D, LANCTODOCUM L'
      '       WHERE'
      '          (D.CODDOCUMENTO = L.CODDOCUMENTO) AND'
      '          (D.RECPAG = :RECPAG) AND'
      '          (L.OPERACAO = :OPERACAO3) AND'
      
        '          ((D.STATUS = '#39'0'#39') OR (D.STATUS = '#39'1'#39') OR (D.STATUS IS ' +
        'NULL)))) AND'
      ' (D.STATUS = '#39'2'#39')'
      ' '
      ' ')
    ClientDataSet = CdsFatura
    Left = 51
    Top = 269
  end
