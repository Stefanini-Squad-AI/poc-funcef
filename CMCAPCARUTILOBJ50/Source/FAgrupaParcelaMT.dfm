  object CdsPendentes: TCMClientDataSet
    Aggregates = <>
    Params = <>
    AfterOpen = CdsPendentesAfterOpen
    Left = 83
    Top = 221
  end
  object SQLPendentes: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   D.NODOCUMENTO,'
      '   L.VALOR,'
      '   M.MOESIGLA,'
      '   D.CODDOCUMENTO,'
      '   D.IDMODULO,'
      '   D.IDFORCLI,'
      '   D.MOECODIGO,'
      '   D.OPERACAO,'
      '   D.IDPESSOA,'
      '   D.STATUS,'
      '   D.NUMFATURA,'
      '   D.PLACONTA,'
      '   D.CODSUBCONTA,'
      '   D.UNIDNEGOC,'
      '   D.CODTIPDOC,'
      '   NVL(TP.FLGDOCFISCAL, '#39'S'#39') AS FLGDOCFISCAL,'
      '   D.IDPROCESSO'
      'FROM'
      '  PESSOA P,'
      '  DOCUMENTO D,'
      '  LANCTODOCUM L,'
      '  MOEDA M, TIPODOCRECPAG TP'
      'WHERE'
      '  (D.RECPAG = :RECPAG) AND'
      '  (D.IDFORCLI = :IDFORCLI) AND'
      '  (D.OPERACAO = :OPERACAO1) AND'
      '  (D.IDPESSOA = :IDPESSOA) AND'
      '  (D.STATUS = '#39'0'#39') AND'
      '  (D.IDFORCLI = P.IDPESSOA) AND'
      '  (D.OPERACAO = L.OPERACAO) AND'
      '  (D.CODDOCUMENTO = L.CODDOCUMENTO) AND'
      '  (D.MOECODIGO = M.MOECODIGO(+)) AND'
      '  (D.CODTIPDOC = TP.CODTIPDOC)'
      ''
      ' ')
    ClientDataSet = CdsPendentes
    Left = 83
    Top = 269
  end
  object CdsSelecionados: TCMClientDataSet
