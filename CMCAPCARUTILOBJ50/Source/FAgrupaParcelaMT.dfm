  object CdsTipoDoc: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 147
    Top = 221
  end
  object SqlTipoDoc: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  RECPAG,'
      '  CODTIPDOC,'
      '  DESCRICAO,'
      '  DEBCRE,'
      '  FLGENGLOBAPARCELA,'
      '  FLGGERANUMDOC,'
      '  NVL(FLGDOCFISCAL, '#39'S'#39') AS FLGDOCFISCAL'
      'FROM'
      '  TIPODOCRECPAG A'
      'WHERE'
      '  A.RECPAG =  :RECPAG AND'
      
        '  ((FLGENGLOBAPARCELA <> '#39'S'#39') OR (FLGENGLOBAPARCELA IS NULL)) AN' +
        'D'
      '  NOT EXISTS'
      '     (SELECT'
      '         *'
      '      FROM'
      '         USUARIOXTPDOCTO B'
      '      WHERE'
      '         RECPAG = :RECPAG AND'
      '         B.IDUSUARIO = :IDUSUARIO)'
      'UNION'
      'SELECT'
      '   RECPAG,'
      '   CODTIPDOC,'
      '   DESCRICAO,'
      '   DEBCRE,'
      '   FLGENGLOBAPARCELA,'
      '   FLGGERANUMDOC,'
      '   FLGDOCFISCAL'
      'FROM'
      '   TIPODOCRECPAG A'
      'WHERE'
      '   A.RECPAG = :RECPAG AND'
      
        '   ((FLGENGLOBAPARCELA <> '#39'S'#39') OR (FLGENGLOBAPARCELA IS NULL)) A' +
        'ND'
      '   EXISTS'
      '      (SELECT'
      '          *'
      '       FROM'
      '          USUARIOXTPDOCTO B'
      '       WHERE'
      '          RECPAG = :RECPAG AND'
      '          A.CODTIPDOC = B.CODTIPDOC AND'
      '          B.IDUSUARIO = :IDUSUARIO)'
      'ORDER BY'
      '   DEBCRE DESC, DESCRICAO'
      '')
    ClientDataSet = CdsTipoDoc
    Left = 147
    Top = 269
  end
  object CdsContasCaixas: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 179
    Top = 221
  end
  object SqlCdsContasCaixas: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  CODPORTFORMA,'
      '  DESCRICAO,'
      '  IDPESSOA ,'
      '  RECPAG,'
      '  PLACONTA'
      'FROM'
      '  PORTADORFORMA'
      'WHERE'
      '  (PORTADORFORMA.IDPESSOA = :IDPESSOA) AND'
