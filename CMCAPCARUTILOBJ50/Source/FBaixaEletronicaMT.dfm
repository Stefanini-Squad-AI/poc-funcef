  object SQLModelos: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '    IDMODELOSCNAB,DESCRICAO'
      'FROM '
      '   MODELOSCNAB'
      'WHERE '
      '   RECPAG = :RECPAG'
      'ORDER '
      '   BY DESCRICAO')
    ClientDataSet = CdsModelo
    Left = 352
    Top = 168
  end
