  object SQLUmPortadorForma: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  DESCRICAO,'
      '  CODPORTFORMA,'
      '  DMAIS,'
      '  LANCAFINANC,'
      '  PLANO,'
      '  PLACONTA,'
      '  CODPORTADOR,'
      '  DESCFINAN,'
      '  FLGCHEQUEDIFERIDO,'
      '  FLGCONTROLACHEQUE,'
      '  FLGOBSERVOBRIGATORIA'
      'FROM'
      '  PORTADORFORMA'
      'WHERE'
      '  RECPAG   = :RECPAG   AND'
      '  IDPESSOA = :IDPESSOA AND'
      '  CODPORTFORMA = :CODPORTFORMA AND'
      ' NVL(FLGENCCONTAS, '#39'N'#39') = '#39'N'#39
      ''
      ''
      ' ')
    ClientDataSet = CdsUmPortadorForma
    Left = 205
    Top = 279
  end
