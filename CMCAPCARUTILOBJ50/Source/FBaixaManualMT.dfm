  object SqlPendentes: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  DECODE(NVL(D.FLGCONTAINVEST,0),0,'#39'Velho'#39','#39'Novo'#39') AS TIPO,'
      '  D.CODPORTFORMA,'
      '  D.IDFORCLI,'
      '  D.OPERACAO,'
      '  D.CODTIPDOC,'
      '  D.IDPESSOA,'
      '  D.CODDOCUMENTO,'
      '  D.NODOCUMENTO,'
      '  D.COMPLDOCUMENTO,'
      '  D.DATAPROGRAMADA,'
      '  D.DATAVENCTO,'
      '  D.IDMODULO,'
      '  D.RECPAG,'
      '  P.NOME,'
      '  D.NUMAPGR,'
      '  D.CODDOSSIE,'
      '  D.STATUS,'
      '  D.MOECODIGO,'
      '  D.PLANO,'
      '  D.PLACONTA,'
      '  D.CODSUBCONTA,'
      '  D.CODCENTROCUSTO,'
      '  D.CODGRUPOCNAB,'
      '  D.NOSSONUMERO,'
      '  L.NUMLANCTO,'
      '  L.DATALANCTO,'
      '  L.VLRLIQUIDO,'
      '  L.VALOR,'
      '  PO.DESCRICAO,'
      '  D.IDCBANCARIA,'
      '  L.VALOROUTRAMOEDA,'
      '  L.DEBCRE,'
      '  DECODE(SIGN(D.DATAVENCTO - SYSDATE), -1, 1, 0) AS SITUACAO,'
      '  2 AS STATUSVALOR,'
      
        ' '#39'                    '#39' AS IDPLANOPREV,--//MARCIO SANCHES SPINOS' +
        'A SOL 220237 KINTANA 2052443'
      
        '  '#39'                                                             ' +
        '                                                                ' +
        '                                                                ' +
        '               '#39' AS PLANOPREV,'
      '  '#39'N'#39' as FLGPPDIFERENTE,'
      '  '#39'S'#39' as FLGBAIXATOTAL   -- //Edilaine SOL 124845-14262'
      'FROM'
      '  DOCUMENTO D,'
      '  PESSOA P,'
      '  LANCTODOCUM L,'
      '  PORTADORFORMA PO'
      'WHERE'
      '  1 = 2'
      ''
      ' '
      ' '
      ' '
      ' ')
    ClientDataSet = CdsPendentes
    Left = 317
    Top = 321
  end
  object SqlSelecionados: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  DECODE(NVL(D.FLGCONTAINVEST,0),0,'#39'Velho'#39','#39'Novo'#39') AS TIPO,'
      '  D.IDFORCLI,'
      '  D.OPERACAO,'
      '  D.CODTIPDOC,'
      '  D.CODPORTFORMA,'
      '  D.IDPESSOA,'
      '  D.CODDOCUMENTO,'
      '  D.NODOCUMENTO,'
      '  D.COMPLDOCUMENTO,  '
      '  D.DATAPROGRAMADA,'
      '  D.DATAVENCTO,'
      '  D.IDMODULO,'
      '  D.RECPAG,'
      '  P.NOME,'
      '  D.NUMAPGR,'
      '  D.CODDOSSIE,'
      '  D.STATUS,'
      '  D.MOECODIGO,'
      '  D.PLANO,'
      '  D.PLACONTA,'
      '  D.CODSUBCONTA,'
      '  D.CODCENTROCUSTO,'
      '  D.CODGRUPOCNAB,'
      '  D.NOSSONUMERO,'
      '  L.NUMLANCTO,'
      '  L.VLRLIQUIDO,'
      '  L.VALOR,'
      '  PO.DESCRICAO,'
      '  D.IDCBANCARIA,'
      '  L.VALOROUTRAMOEDA,'
      '  L.DEBCRE,'
      '  DECODE(SIGN(D.DATAVENCTO - SYSDATE), -1, 1, 0) AS SITUACAO,'
      
        ' '#39'                    '#39' AS IDPLANOPREV, --//MARCIO SANCHES SPINO' +
        'SA SOL 220237 KINTANA 2052443'
      '  2 AS STATUSVALOR,'
      
        '  D.UNIDNEGOC,                                                  ' +
        '                                                                ' +
        '                                                                ' +
        '                  '#39#39' AS PLANOPREV,'
      '  '#39'N'#39' as FLGPPDIFERENTE,'
