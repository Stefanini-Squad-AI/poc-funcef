  object wwQuery1: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  DECODE(NVL(D.FLGCONTAINVEST,0),0,'#39'Velho'#39','#39'Novo'#39') AS TIPO,'
      '  D.IDFORCLI,'
      '  D.OPERACAO,'
      '  D.CODTIPDOC,'
      '  D.IDPESSOA,'
      '  D.CODDOCUMENTO,'
      '  D.NODOCUMENTO,'
      '  D.COMPLDOCUMENTO,'
      '  D.DATAPROGRAMADA,'
      '  D.DATAVENCTO,'
      '  D.RECPAG,'
      '  P.NOME,'
      '  D.STATUS,'
      '  D.MOECODIGO,'
      '  D.PLANO,'
      '  D.PLACONTA,'
      '  D.CODSUBCONTA,'
      '  D.CODCENTROCUSTO,'
      '  D.CODGRUPOCNAB,'
      '  D.NOSSONUMERO,'
      '  L.NUMLANCTO,'
      '  L.DATALANCTO,'
      '  L.VLRLIQUIDO,'
      '  L.VALOR,'
      '  L.VALOROUTRAMOEDA,'
      '  L.DEBCRE,'
      '  DECODE(SIGN(D.DATAVENCTO - SYSDATE), -1, 1, 0) AS SITUACAO,'
      '  2 AS STATUSVALOR'
      'FROM'
      '  DOCUMENTO D,'
      '  PESSOA P,'
      '  LANCTODOCUM L'
      'WHERE'
      '  1 = 2'
      ' ')
    ValidateWithMask = True
    Left = 277
    Top = 133
