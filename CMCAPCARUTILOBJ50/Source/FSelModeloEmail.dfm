  object sqlParticpEnvioEmail: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '0 AS SELECIONADO,'
      #39'           '#39' AS MATRICULA,'
      #39'                                   '#39' AS NOME,'
      #39'                                  '#39' AS EMAIL,'
      #39'                       '#39' AS NUDOCUMENTO,'
      '0.0 AS VALORTOTAL,'
      'TO_DATE('#39'01/01/2001'#39') AS DATAVENCIMENTO,'
      '0 AS IDMODELOEMAIL'
      'FROM DUAL'
      'WHERE 1 = 2')
    ClientDataSet = cdsParticpEnvioEmail
    Left = 304
    Top = 249
  end
