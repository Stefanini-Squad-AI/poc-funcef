  object CMSqlParams2: TCMSqlParams
    SQL.Strings = (
      
        'SELECT '#39'N'#39' AS FLGEXCLUI, EMB.IDEMISSBANCARIA, EMB.NUMLOTE, EMB.Q' +
        'TDDOCS, '
      '       EMB.DATAEMISSAO, EMB.NOMEARQ, EMB.VALOR, '
      '       EMB.IDIMAGEM, EMB.IDMODULO, IM.IMAGEM, MD.NOMEMODULO '
      'FROM EMISSBANCARIA EMB, IMAGENS IM, MODULO MD'
      'WHERE EMB.IDEMISSBANCARIA = 6 AND'
      '      EMB.IDIMAGEM = IM.IDIMAGEM AND'
      '      EMB.IDMODULO = MD.IDMODULO'
      'ORDER BY EMB.DATAEMISSAO')
    ClientDataSet = Cds
    Left = 96
    Top = 65535
  end
