  object cdsDoc: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 315
    Top = 170
  end
  object sqlDoc: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  CODTIPDOC,'
      '  DESCRICAO'
      'FROM'
      '  TIPODOCRECPAG TD'
      'WHERE'
      '  TD.RECPAG = :RecPag'
      '  AND NOT EXISTS'
      '  (SELECT 1 FROM USUARIOxTPDOCTO U'
      '   WHERE'
      '     U.IDUSUARIO = :IDUSUARIO AND'
      '     U.RECPAG = :RecPag)'
      '  UNION'
      '  SELECT'
      '    CODTIPDOC,'
      '    DESCRICAO'
      '  FROM TIPODOCRECPAG TP'
      '  WHERE TP.RECPAG = :RecPag AND'
      '  EXISTS'
      '  (SELECT 1 FROM USUARIOxTPDOCTO U'
      '   WHERE'
      '     U.CODTIPDOC = TP.CODTIPDOC AND'
      '     U.IDUSUARIO = :IDUSUARIO AND'
      '     U.RECPAG = :RecPag)'
      'ORDER BY DESCRICAO'
      ''
      ' ')
    ClientDataSet = cdsDoc
    Left = 315
    Top = 200
  end
  object cdsSel: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 365
    Top = 170
  end
  object sqlSel: TCMSqlParams
    SQL.Strings = (
      
        'SELECT                                                          ' +
        '   '
      
        '  D.CODDOCUMENTO,                                               ' +
        '   '
      
        '  D.NODOCUMENTO,                                                ' +
        '   '
      
        '  D.COMPLDOCUMENTO,                                             ' +
        '   '
      
        '  L.DATALANCTO,                                                 ' +
        '   '
      
        '  D.DATAEMISSAO,                                                ' +
        '   '
      
        '  D.DATAVENCTO,                                                 ' +
        '   '
      
        '  D.DATAPROGRAMADA, D.OPERACAO,                                 ' +
        '   '
      
        '  D.OPERACAO AS OPERACAOANTERIOR,                               ' +
        '   '
      
        '  L.NUMLANCTO,                                                  ' +
        '   '
      
        '  L.VALOR,                                                      ' +
        '   '
      
        '  P.RAZAOSOCIAL,                                                ' +
        '   '
      '  TD.DESCRICAO AS DESCRDOCTO'
      'FROM'
      '  DOCUMENTO D,'
      '  LANCTODOCUM L,'
      '  TIPODOCRECPAG TD,'
      '  PESSOA P'
      'WHERE'
      '  1 = 2')
    ClientDataSet = cdsSel
    Left = 365
    Top = 200
  end
end
