  object SqlNumeroFDO: TCMSqlParams
    SQL.Strings = (
      'SELECT     ID_FDO, COD_FDO, SITUACAO'#10
      'FROM       USER_INTEGRACAO_ORCAMENTARIA.FDO_DIGITAL'#13#10#10
      'WHERE    COD_FDO = :NUMFDO'
      ''
      '')
    ClientDataSet = CdsNumeroFDO
    Left = 201
    Top = 635
  end
  object SqlFDOAux: TCMSqlParams
    SQL.Strings = (
      'SELECT '#9'B.ID_FDO, B.ID_BAIXA, B.MES_ANO_SERVICO'
      'FROM '#9'USER_INTEGRACAO_ORCAMENTARIA.FDO_DIGITAL F'
      
        #9'JOIN USER_INTEGRACAO_ORCAMENTARIA.BAIXA_FDO B ON B.ID_FDO = F.I' +
        'D_FDO'
      'WHERE ID_FDO = :ID_FDO ')
    ClientDataSet = CdsFDOAux
    Left = 201
    Top = 671
  end
