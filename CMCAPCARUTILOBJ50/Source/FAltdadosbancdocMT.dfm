  object qryBuscaFDO: TQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT B.ID_BAIXA, B.MES_ANO_SERVICO, B.SITUACAO'
      
        'FROM USER_INTEGRACAO_ORCAMENTARIA.FDO_DIGITAL F, USER_INTEGRACAO' +
        '_ORCAMENTARIA.BAIXA_FDO B'
      'WHERE F.ID_FDO = B.ID_FDO'
      'AND UPPER(B.SITUACAO) = UPPER('#39'PENDENTE'#39')')
    Left = 30
    Top = 645
    object fltfldBuscaFDOID_BAIXA: TFloatField
      FieldName = 'ID_BAIXA'
    end
    object SISTEMA_AMORTIZACAOBuscaFDOMES_ANO_SERVICO: TStringField
      FieldName = 'MES_ANO_SERVICO'
    end
    object SISTEMA_AMORTIZACAOBuscaFDOSITUACAO: TStringField
      FieldName = 'SITUACAO'
    end
  end
