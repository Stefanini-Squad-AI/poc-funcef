  object sqlHistLanc: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   L.NUMLANCTO,'
      '   L.CODDOCUMENTO,'
      '   L.DATALANCTO,'
      '   L.HISTORICOCOMPL'
      'FROM'
      '   LANCTODOCUM L, DOCUMENTO D'
      'WHERE'
      '   (L.CODDOCUMENTO = D.CODDOCUMENTO) AND'
      '   (L.OPERACAO     = D.OPERACAO) AND'
      '   (L.CODDOCUMENTO = :CODDOCUMENTO)'
      ' ')
    ClientDataSet = cdsHistLanc
