  object sqlFormaPag: TCMSqlParams
    SQL.Strings = (
      'SELECT CODFORMA, RECPAG, DESCRICAO'
      'FROM FORMARECPAG '
      'WHERE (RECPAG = :PRECPAG) AND'
      '               (IDPESSOA = :PIDPESSOA)'
      ''
      '')
    ClientDataSet = cdsFormaPag
    Left = 138
