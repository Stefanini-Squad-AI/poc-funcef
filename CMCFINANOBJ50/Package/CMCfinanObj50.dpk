{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Componentes de Integração Com o Controle Financeiro'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CMContabObj50,
  CmGlobalObj50,
  CmForms50;

contains
  uCtrlFinanc in '..\CtrlObjects\uCtrlFinanc.pas',
  uGeralFinanc in '..\CtrlObjects\uGeralFinanc.pas',
  uDbFluxoPrevisto in '..\DbObjects\uDbFluxoPrevisto.pas',
