package CmRelatorioObj50;

{$R *.RES}
{$R CMRELATORIOOBJ50_RES.RES}

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FUNCEF - Objetos de Negócios do Gerador de Relatórios'}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CmCompo50,
  CmForms50;

contains
  uCtrlDdTable in '..\CtrlObjects\uCtrlDdTable.pas',
  uCtrlDdField in '..\CtrlObjects\uCtrlDdField.pas',
  uCtrlDataview in '..\CtrlObjects\uCtrlDataview.pas',
  uCtrlGrupoRelatorio in '..\CtrlObjects\uCtrlGrupoRelatorio.pas',
  uDbDdField in '..\DbObjects\uDbDdField.pas',
  uDbDataview in '..\DbObjects\uDbDataview.pas',
  uDbDdTable in '..\DbObjects\uDbDdtable.pas',
  uDbGrupoRelatorio in '..\DbObjects\uDbGrupoRelatorio.pas';

end.
