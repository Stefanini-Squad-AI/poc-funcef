package CompoRH;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'CM - Componentes RH'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  ip50word_d5,
  ip50_d5,
  ip50client_d5,
  ip50d_d5,
  ip50word2000_d5;

contains
  ColorListBox in 'ColorListBox.pas',
  ColorCheckListBox in 'ColorCheckListBox.pas',
  OrdenaGrid in 'OrdenaGrid.pas';

end.
