function TDtmRelatsAtuarial.MostraParam(Form: string): boolean;
var frm : TForm;
begin
     if (Trim(Form) = '') then
     Begin
        Result := True;
        Exit;
     End;

     if (AnsiUpperCase(Form) = 'FRMPARAMREL') then
        frm := TfrmParamRel.Create(Application)
     else
         frm := nil;

     if frm = nil then
        Result := false
     else
     begin
          with frm do
          begin
               Result := (ShowModal = mrOk);
               free;
          end;
     end;
end;

