function TDtmRelatsAtuarial.getNomePlano(iCodPlano: Integer): String;
begin
  Try
    qryPlano.Close;
    qryPlano.ParamByName('CD_PLANO').asInteger := iCodPlano;
    qryPlano.Open;
    Result := qryPlano.FieldByName('NO_PLANO').asString;
  Finally
    qryPlano.Close;
  End;
end;

function TDtmRelatsAtuarial.getNomeGrupoContabil(iCodGrupo: Integer): String;
begin
  Try
    qryGrupoContabil.Close;
    qryGrupoContabil.ParamByName('CD_GRUPO_CONTABIL').asInteger := iCodGrupo;
    qryGrupoContabil.Open;
    Result := qryGrupoContabil.FieldByName('DS_GRUPO_CONTABIL').asString;
  Finally
    qryGrupoContabil.Close;
  End;
end;

procedure TDtmRelatsAtuarial.ppDBText28GetText(Sender: TObject;
