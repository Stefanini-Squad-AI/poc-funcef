  object UpdtSQLDet: TUpdateSQL
    ModifySQL.Strings = (
      'update FI_PLANO_BENEFICIO'
      'set'
      '  VL_MINIMO_BENEFICIO = :VL_MINIMO_BENEFICIO,'
      '  VL_MAXIMO_BENEFICIO = :VL_MAXIMO_BENEFICIO,'
      '  CD_GRUPO_BENEFICIO = :CD_GRUPO_BENEFICIO'
      'where'
      '  CD_PESSOA_PATROC = :OLD_CD_PESSOA_PATROC and'
      '  CD_PESSOA_ENTID = :OLD_CD_PESSOA_ENTID and'
      '  CD_PLANO = :OLD_CD_PLANO and'
      '  CD_TIPO_BENEF = :OLD_CD_TIPO_BENEF')
    InsertSQL.Strings = (
      'insert into FI_PLANO_BENEFICIO'
      '  (CD_PESSOA_PATROC, CD_PESSOA_ENTID, CD_PLANO, CD_TIPO_BENEF,'
      '   VL_MINIMO_BENEFICIO, VL_MAXIMO_BENEFICIO, CD_GRUPO_BENEFICIO)'
      'values'
      
        '  (:CD_PESSOA_PATROC, :CD_PESSOA_ENTID, :CD_PLANO, :CD_TIPO_BENE' +
        'F, '
      
        '   :VL_MINIMO_BENEFICIO, :VL_MAXIMO_BENEFICIO, :CD_GRUPO_BENEFIC' +
        'IO)')
    DeleteSQL.Strings = (
      'delete from FI_PLANO_BENEFICIO'
      'where'
      '  CD_PESSOA_PATROC = :OLD_CD_PESSOA_PATROC and'
      '  CD_PESSOA_ENTID = :OLD_CD_PESSOA_ENTID and'
      '  CD_PLANO = :OLD_CD_PLANO and'
      '  CD_TIPO_BENEF = :OLD_CD_TIPO_BENEF')
    Left = 378
    Top = 13
  end
