  object UpdtSQLPrincipal: TUpdateSQL
    ModifySQL.Strings = (
      'update FI_PLANO_PATRONAL'
      'set'
      '  NO_PLANO = :NO_PLANO,'
      '  DT_CRIACAO_PLANO = :DT_CRIACAO_PLANO,'
      '  DT_EXTINCAO_PLANO = :DT_EXTINCAO_PLANO,'
      '  VL_MAIOR_SAL_CONTRIB = :VL_MAIOR_SAL_CONTRIB,'
      '  DS_OBSERV = :DS_OBSERV'
      'where'
      '  CD_PESSOA_PATROC = :OLD_CD_PESSOA_PATROC and'
      '  CD_PESSOA_ENTID = :OLD_CD_PESSOA_ENTID and'
      '  CD_PLANO = :OLD_CD_PLANO')
    InsertSQL.Strings = (
      'insert into FI_PLANO_PATRONAL'
      '  (CD_PESSOA_PATROC, CD_PESSOA_ENTID, CD_PLANO, NO_PLANO, '
      '   DT_CRIACAO_PLANO, DT_EXTINCAO_PLANO, VL_MAIOR_SAL_CONTRIB, '
      '   DS_OBSERV)'
      'values'
      '  (:CD_PESSOA_PATROC, :CD_PESSOA_ENTID, :CD_PLANO, :NO_PLANO, '
      
        '   :DT_CRIACAO_PLANO,  :DT_EXTINCAO_PLANO, :VL_MAIOR_SAL_CONTRIB' +
        ', '
      '   :DS_OBSERV)')
    DeleteSQL.Strings = (
      'delete from FI_PLANO_PATRONAL'
      'where'
      '  CD_PESSOA_PATROC = :OLD_CD_PESSOA_PATROC and'
      '  CD_PESSOA_ENTID = :OLD_CD_PESSOA_ENTID and'
      '  CD_PLANO = :OLD_CD_PLANO')
    Left = 290
    Top = 68
  end
  object QryDetalhe: TwwQuery
    CachedUpdates = True
    BeforePost = QryDetalheBeforePost
    DatabaseName = 'BaseDados'
    DataSource = ds
    SQL.Strings = (
      'Select p.CD_PESSOA_PATROC, p.CD_PESSOA_ENTID, p.CD_PLANO,'
      '       p.VL_MINIMO_BENEFICIO, p.VL_MAXIMO_BENEFICIO,'
      '       t.CD_TIPO_BENEF, t.DS_TIPO_BENEF,'
      '       p.CD_GRUPO_BENEFICIO, g.DS_GRUPO_BENEFICIO'
      'from FI_PLANO_BENEFICIO p,'
      '     FI_TIPO_BENEFICIO t,'
      '     FI_GRUPO_BENEFICIO g'
      'where p.CD_PESSOA_PATROC = :CD_PESSOA_PATROC'
      '  and p.CD_PESSOA_ENTID = :CD_PESSOA_ENTID'
      '  and p.CD_PLANO = :CD_PLANO'
      '  and p.CD_TIPO_BENEF = t.CD_TIPO_BENEF'
      '  AND p.CD_GRUPO_BENEFICIO = g.CD_GRUPO_BENEFICIO'
      'order by p.CD_PESSOA_PATROC, p.CD_PESSOA_ENTID, p.CD_PLANO,'
      '         p.CD_TIPO_BENEF'
      '')
    UpdateObject = UpdtSQLDet
    ValidateWithMask = True
    Left = 322
    Top = 13
