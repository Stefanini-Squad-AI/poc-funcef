  object qryMemoria: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select a.CD_PESSOA_ENTID, a.CD_PESSOA_PATROC,'
      '           a.CD_PLANO, a.DT_GERACAO, a.CD_VERSAO,'
      '           b.CD_HIPOTESE, b.DS_HIPOTESE, '
      '           DECODE(A.IR_CALCULO_EFETIVADO, '#39'S'#39', '#39'Efetivado'#39','
      #9#9#9#9'            '#39'N'#39', '#39'Não efetivado'#39') AS "IR_CALCULO_EFETIVADO"'#9
      'from  FI_REFER_CALCULO_ATUARIAL a, FI_HIPOTESE b'
      'where a.CD_HIPOTESE = b.CD_HIPOTESE '
      '  and a.CD_PESSOA_ENTID = :CD_PESSOA_ENTID'
      '  and a.CD_PESSOA_PATROC  = :CD_PESSOA_PATROC'
      '  and a.CD_PLANO  = :CD_PLANO'
      '  and a.CD_VERSAO  = :CD_VERSAO'
      'order by a.DT_GERACAO desc')
    ValidateWithMask = True
    Left = 473
    Top = 439
    ParamData = <
      item
        DataType = ftInteger
        Name = 'CD_PESSOA_ENTID'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'CD_PESSOA_PATROC'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'CD_PLANO'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'CD_VERSAO'
        ParamType = ptUnknown
      end>
  end
