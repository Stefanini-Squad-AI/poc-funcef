  object qryITM_Hipotese: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT CH.CD_HIPOTESE, '
      '               IH.CD_ITEM_HIPOTESE,'
      '               IH.DS_ITEM_HIPOTESE,'
      ''
      '               IH.NO_VARIAVEL,'
      ''
