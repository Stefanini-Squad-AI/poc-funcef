      '               CH.SQ_VERSAO_COMUTACAO_MAS,'
      '               CH.SQ_VERSAO_COMUTACAO_FEM,'
      '               CH.SQ_VERSAO_COMUTACAO_PEN,'
      '              '
      '               IH.IR_ITEM_HIPOTESE'
      ''
      'FROM FI_COMPOSICAO_HIPOTESE CH,'
      '            FI_ITEM_HIPOTESE IH'
      ''
      'WHERE CH.CD_ITEM_HIPOTESE = IH.CD_ITEM_HIPOTESE AND'
      '               CH.CD_HIPOTESE = :CD_HIPOTESE'
      ''
      'ORDER BY CH.CD_HIPOTESE, IH.CD_ITEM_HIPOTESE')
