  object qryParticipantes: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '#39'0'#39' AS "INICIAL", '
      '               /* Passa a data de referencia */'
      '               P.CD_VERSAO,                  P.CD_PARTIC, '
      ''
      '               P.CD_PESSOA_PATROC, P.CD_PESSOA_ENTID,'
      '               P.CD_PLANO,  BC.CD_TIPO_BENEF,'
      '                '
      '               P.NR_MATRICULA,           P.NO_PESSOA,'
      '               P.NR_CPF,'
      ''
      
        '               S.IR_SEXO,                      EC.DS_ESTADO_CIVI' +
        'L,'
      
        '               SP.DS_SITUACAO_PATROC,        SF.DS_SITUACAO_FUND' +
        'ACAO, '
      '               CPE.DS_TIPO_CAT_PROF_ESP,    '
      ''
      '               GP.CD_GRUPO_PARTIC, GP.NO_GRUPO_PARTIC,'
      ''
      '               BEN.SG_TIPO_BENEF,            BEN.DS_TIPO_BENEF,'
      ''
      '               PJJ.NO_PESSOA AS "NO_ENTIDADE",'
      ''
      
        '               P.CD_PLANO_ANTERIOR,         P.CD_OUTRA_FUNDACAO,' +
        '          '
      
        '               P.IR_MIGRACAO_PLANO,          P.IR_DIRETOR,      ' +
        '           '
      
        '               P.IR_CONDICAO_TRABALHO,   P.CD_GRUPO_CALCULO,    ' +
        '   '
      
        '               P.DS_REGIONAL,                       P.CD_VINCULA' +
        '_PARTIC,'
      
        '               P.IR_FUNDACAO_ORIGEM,       P.IR_PERTENCE_PATROCI' +
        'NADORA, '
      '               P.TP_PARTICIPANTE,           '
      ''
      
        '               PLA.NO_PLANO,                      PLA.DT_CRIACAO' +
        '_PLANO, '
      
        '               PLA.DT_EXTINCAO_PLANO,  PLA.VL_MAIOR_SAL_CONTRIB,' +
        ' '
      ' '
      '               PJ.NO_PESSOA AS "NO_PATROC",  '
      '               PT.DT_REAJUSTE_SALARIO,'
      '               PJ.NR_CGC AS "CGC_PATROC"    '
      ''
      'FROM FI_PARTICIPANTE P,'
      '           FI_ESTADO_CIVIL EC, FI_SEXO S, '
      '           FI_SITUACAO_FUNDACAO SF, FI_SITUACAO_PATROC SP,'
      '           FI_BENEFICIARIO BC,'
      '           FI_TIPO_BENEFICIO BEN,'
      '           FI_TIPO_CATEG_PROF_ESPECIAL CPE,'
      '           FI_PLANO_PATRONAL PLA,'
      '           FI_PATROCINADORA PT, '
      '           FI_PESSOA_JURIDICA PJ,'
      '           FI_PESSOA_JURIDICA PJJ,'
      '           FI_GRUPO_PARTICIPANTE GP,'
      '           FI_GRUPO_CALCULO GC'
      ''
      'WHERE P.CD_VERSAO =  :CD_VERSAO AND'
      '               P.CD_PLANO    =  :CD_PLANO AND'
      '               P.CD_ESTADO_CIVIL = EC.CD_ESTADO_CIVIL AND'
      '               P.IR_SEXO = S.IR_SEXO AND'
      
        '               P.CD_SITUACAO_FUNDACAO = SF.CD_SITUACAO_FUNDACAO ' +
        'AND'
      '               P.CD_SITUACAO_PATROC = SP.CD_SITUACAO_PATROC AND'#9
      '      '
      '               P.CD_PESSOA_ENTID   = PJJ.CD_PESSOA AND'
      '   '
      '               P.CD_PESSOA_PATROC  = PLA.CD_PESSOA_PATROC AND'
      '               P.CD_PESSOA_ENTID   = PLA.CD_PESSOA_ENTID AND'
      '               P.CD_PLANO          = PLA.CD_PLANO AND  '
      '        '
      
        '               P.CD_TIPO_CAT_PROF_ESP = CPE.CD_TIPO_CAT_PROF_ESP' +
        ' (+) AND'
      '               P.CD_VERSAO  = BC.CD_VERSAO (+) AND'
      '               P.CD_PARTIC  = BC.CD_PARTIC (+) AND'
      ''
      '               BC.CD_TIPO_BENEF = BEN.CD_TIPO_BENEF (+) AND'
      ''
      '               PT.CD_PESSOA_PATROC = PJ.CD_PESSOA AND'
      ''
      '               PT.CD_PESSOA_PATROC = PLA.CD_PESSOA_PATROC AND'
      ''
      '               GP.CD_GRUPO_PARTIC   = GC.CD_GRUPO_PARTIC AND'
      '               GC.CD_PESSOA_ENTID   = P.CD_PESSOA_ENTID AND'
      '               GC.CD_PESSOA_PATROC  = P.CD_PESSOA_PATROC AND'
      '               GC.CD_PLANO          = P.CD_PLANO AND'
      '               GP.CD_GRUPO_PARTIC = P.CD_GRUPO_CALCULO '
      '               '
      '               /* LINHA INCLUDA PELO SISTEMA */')
    ValidateWithMask = True
    Left = 296
    Top = 439
    ParamData = <
      item
        DataType = ftInteger
        Name = 'CD_VERSAO'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'CD_PLANO'
        ParamType = ptUnknown
      end>
  end
