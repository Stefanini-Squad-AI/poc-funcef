  object DecisionQuery1: TDecisionQuery
    DatabaseName = 'BaseDados'
    ParamCheck = False
    SQL.Strings = (
      
        'SELECT TB.SG_TIPO_BENEF, TG.NO_GRUPO_PARTIC, OC.NO_VARIAVEL, SUM' +
        '( OC.VL_CALCULO_ATUARIAL )'
      
        'FROM FI_OCOR_CALCULO_ATUARIAL OC, FI_REFER_CALCULO_ATUARIAL RC, ' +
        'FI_GRUPO_PARTICIPANTE TG, FI_TIPO_BENEFICIO TB'
      'WHERE  (OC.CD_PESSOA_ENTID = RC.CD_PESSOA_ENTID)  '
      '   AND  (OC.CD_PESSOA_PATROC = RC.CD_PESSOA_PATROC)  '
      '   AND  (OC.CD_PLANO = RC.CD_PLANO)  '
      '   AND  (OC.DT_GERACAO = RC.DT_GERACAO)  '
      '   AND  (OC.CD_GRUPO_PARTIC = TG.CD_GRUPO_PARTIC)  '
      '   AND  (OC.CD_GRUPO_PARTIC = TG.CD_GRUPO_PARTIC)  '
      '   AND  (OC.CD_TIPO_BENEF = TB.CD_TIPO_BENEF)  '
      '   AND  ( (OC.CD_PESSOA_ENTID = 1)  '
      '   AND  (OC.CD_PESSOA_PATROC = 2)  '
      '   AND  (OC.CD_PLANO = 1) ) '
      'GROUP BY TB.SG_TIPO_BENEF, TG.NO_GRUPO_PARTIC, OC.NO_VARIAVEL')
    Left = 49
    Top = 6
  end
