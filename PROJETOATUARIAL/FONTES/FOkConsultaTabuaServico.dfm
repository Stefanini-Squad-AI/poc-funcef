  object qryIdadesTabua_PENSAO: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT MIN(NR_IDADE) AS MIN_IDADE, MAX(NR_IDADE) AS MAX_IDADE,'
      
        '       MIN(NR_IDADE_PENSAO) AS MIN_IDADE_PENSAO, MAX(NR_IDADE_PE' +
        'NSAO) AS MAX_IDADE_PENSAO'
      'FROM FI_OCOR_TABUA_COMUTACAO'
      'WHERE SQ_VERSAO_COMUTACAO = :SQ_VERSAO_COMUTACAO'
      
        '/* AND NO_VARIAVEL IN (NO_VARIAVEL)  -- linha alterada dinamicam' +
        'ente [4] */'
