  object qryOcorrenciasTabua: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT NO_VARIAVEL AS VARIAVEL, NR_IDADE AS IDADE, NR_IDADE_PENS' +
