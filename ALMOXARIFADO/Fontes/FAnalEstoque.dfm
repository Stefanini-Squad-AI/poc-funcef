      Origin = '"CM.SALDO".PERIODOCOMPRA'
    end
    object qrySaldoSALDOQTDE: TFloatField
      FieldName = 'SALDOQTDE'
      Origin = 'SALDO.SALDOQTDE'
    end
    object qrySaldoDESCRICAO: TStringField
      FieldName = 'DESCRICAO'
