  object updItem: TUpdateSQL
    ModifySQL.Strings = (
      'update ITEMANALISEESTOQ'
      'set'
      '  IDANALISEESTOQUE = :IDANALISEESTOQUE,'
      '  CODARTIGO = :CODARTIGO,'
      '  FLGQTDEMINCALC = :FLGQTDEMINCALC,'
      '  TRMEDCALCULADO = :TRMEDCALCULADO,'
      '  TRMEDINFORMADO = :TRMEDINFORMADO,'
      '  CONSMEDCALCULADO = :CONSMEDCALCULADO,'
      '  FLGTEMPMEDCALC = :FLGTEMPMEDCALC,'
      '  CONSMEDINFORMADO = :CONSMEDINFORMADO,'
      '  FLGCONSMEDCALC = :FLGCONSMEDCALC,'
      '  PONTOREPCALCULADO = :PONTOREPCALCULADO,'
      '  FLGPONTOREPCALC = :FLGPONTOREPCALC,'
      '  PONTOREPINFORMADO = :PONTOREPINFORMADO,'
      '  QTDEMINCALCULADA = :QTDEMINCALCULADA,'
      '  QTDEMININFORMADA = :QTDEMININFORMADA,'
      '  QTDESUGAUTO = :QTDESUGAUTO,'
      '  QTDESUGCALCULADA = :QTDESUGCALCULADA,'
      '  QTDECOMPRAR = :QTDECOMPRAR,'
      '  SALDOESTOQUE = :SALDOESTOQUE,'
      '  PERIDOCOMPRA = :PERIDOCOMPRA'
      'where'
      '  IDANALISEESTOQUE = :OLD_IDANALISEESTOQUE and'
      '  RTRIM(CODARTIGO) = RTRIM(:OLD_CODARTIGO)')
    InsertSQL.Strings = (
      'insert into ITEMANALISEESTOQ'
      '  (IDANALISEESTOQUE, CODARTIGO, FLGQTDEMINCALC, TRMEDCALCULADO, '
      'TRMEDINFORMADO, '
      '   CONSMEDCALCULADO, FLGTEMPMEDCALC, CONSMEDINFORMADO, '
      'FLGCONSMEDCALC, '
      '   PONTOREPCALCULADO, FLGPONTOREPCALC, PONTOREPINFORMADO, '
      'QTDEMINCALCULADA, '
      '   QTDEMININFORMADA, QTDESUGAUTO, QTDESUGCALCULADA, '
      'QTDECOMPRAR, SALDOESTOQUE, '
      '   PERIDOCOMPRA)'
      'values'
      '  (:IDANALISEESTOQUE, :CODARTIGO, :FLGQTDEMINCALC, '
      ':TRMEDCALCULADO, :TRMEDINFORMADO, '
      '   :CONSMEDCALCULADO, :FLGTEMPMEDCALC, :CONSMEDINFORMADO, '
      ':FLGCONSMEDCALC, '
      '   :PONTOREPCALCULADO, :FLGPONTOREPCALC, :PONTOREPINFORMADO, '
      ':QTDEMINCALCULADA, '
      '   :QTDEMININFORMADA, :QTDESUGAUTO, :QTDESUGCALCULADA, '
      ':QTDECOMPRAR, :SALDOESTOQUE, '
      '   :PERIDOCOMPRA)')
    DeleteSQL.Strings = (
      'delete from ITEMANALISEESTOQ'
      'where'
      '  IDANALISEESTOQUE = :OLD_IDANALISEESTOQUE and'
      '  RTRIM(CODARTIGO) = RTRIM(:OLD_CODARTIGO)')
    Left = 507
    Top = 187
  end
  object qryItem: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '     I.IDANALISEESTOQUE,                 '
      '     I.CODARTIGO,                        '
      '     I.FLGQTDEMINCALC,                          '
      '     I.TRMEDCALCULADO,                          '
      '     I.TRMEDINFORMADO,                          '
      '     I.CONSMEDCALCULADO,                        '
      '     I.FLGTEMPMEDCALC,                          '
      '     I.CONSMEDINFORMADO,                        '
      '     I.FLGCONSMEDCALC,                          '
      '     I.PONTOREPCALCULADO,                       '
      '     I.FLGPONTOREPCALC,                         '
      '     I.PONTOREPINFORMADO,                       '
      '     I.QTDEMINCALCULADA,                        '
      '     I.QTDEMININFORMADA,                        '
      '     I.QTDESUGAUTO,                             '
      '     I.QTDESUGCALCULADA,                        '
      '     I.QTDECOMPRAR,                             '
      '     I.SALDOESTOQUE,                            '
      '     I.PERIDOCOMPRA,'
      
        '     ( P.DescProd || '#39' '#39' || A.CodTamanho || '#39' '#39' || A.CodCor ) as' +
        ' Descricao                          '
      'FROM'
      '         ITEMANALISEESTOQ I,'
      '         ARTIGO A,'
      '         PRODUTO P'
      'WHERE'
      '           ( IDANALISEESTOQUE  = :pIDANAL)                 '
      '  AND ( A.CODARTIGO = I.CODARTIGO)'
      '  AND ( A.CODPRODUTO = P.CODPRODUTO)'
      ''
      '')
    UpdateObject = updItem
    ControlType.Strings = (
      'FLGQTDEMINCALC;CheckBox;S;N'
      'FLGTEMPMEDCALC;CheckBox;S;N'
      'FLGCONSMEDCALC;CheckBox;S;N'
      'FLGPONTOREPCALC;CheckBox;S;N')
    ValidateWithMask = True
    Left = 507
    Top = 237
    ParamData = <
      item
        DataType = ftInteger
        Name = 'pIDANAL'
        ParamType = ptUnknown
      end>
