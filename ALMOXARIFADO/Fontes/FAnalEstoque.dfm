  object qrySaldo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select '
      '     S.CODARTIGO,'
      '     S.ESTMINUSADO,'
      '     S.PTORESUSADO,'
      '     S.TEMRESUSADO,'
      '     S.CONMEDUSADO,'
      '     S.PERIODOCOMPRA, '
      '     S.SALDOQTDE,'
      
        '     ( P.DescProd || '#39' '#39' || A.CodTamanho || '#39' '#39' || A.CodCor ) as' +
        ' Descricao'
      'From '
      '     Saldo S,'
      '     Produto P,'
      '     Artigo A'
      'Where '
      '         ( P.ITEMESTOCAVEL = '#39'S'#39')'
      '    AND (A.FLGATIVO = '#39'S'#39')'
      '  And ( A.CodProduto = P.CodProduto )'
      '  And ( A.CodArtigo = S.CodArtigo )'
      '')
    ValidateWithMask = True
    Left = 510
    Top = 101
    object qrySaldoCODARTIGO: TStringField
      FieldName = 'CODARTIGO'
      Origin = 'SALDO.CODARTIGO'
      Size = 14
    end
    object qrySaldoESTMINUSADO: TFloatField
      FieldName = 'ESTMINUSADO'
      Origin = 'SALDO.ESTMINUSADO'
    end
    object qrySaldoPTORESUSADO: TFloatField
