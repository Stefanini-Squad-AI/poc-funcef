  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update ANALISEESTOQUE'
      'set'
      '  IDANALISEESTOQUE = :IDANALISEESTOQUE,'
      '  IDPESSOA = :IDPESSOA,'
      '  NUMSOLCOMPRA = :NUMSOLCOMPRA,'
      '  CODGRUPOPROD = :CODGRUPOPROD,'
      '  CODALMOXARIFADO = :CODALMOXARIFADO,'
      '  DATAINICONSMED = :DATAINICONSMED,'
      '  DATAFIMCONSMED = :DATAFIMCONSMED,'
      '  FLGACEITA = :FLGACEITA,'
      '  PERCMINIMO = :PERCMINIMO,'
      '  DATAINITRMED = :DATAINITRMED,'
      '  DATAFIMTRMED = :DATAFIMTRMED,'
      '  DATAANALISE = :DATAANALISE'
      'where'
      '  IDANALISEESTOQUE = :OLD_IDANALISEESTOQUE')
    InsertSQL.Strings = (
      'insert into ANALISEESTOQUE'
      
        '  (IDANALISEESTOQUE, IDPESSOA, NUMSOLCOMPRA, CODGRUPOPROD, CODAL' +
        'MOXARIFADO, '
      
        '   DATAINICONSMED, DATAFIMCONSMED, FLGACEITA, PERCMINIMO, DATAIN' +
        'ITRMED, '
      '   DATAFIMTRMED, DATAANALISE)'
      'values'
      
        '  (:IDANALISEESTOQUE, :IDPESSOA, :NUMSOLCOMPRA, :CODGRUPOPROD, :' +
        'CODALMOXARIFADO, '
      
        '   :DATAINICONSMED, :DATAFIMCONSMED, :FLGACEITA, :PERCMINIMO, :D' +
        'ATAINITRMED, '
      '   :DATAFIMTRMED, :DATAANALISE)')
    DeleteSQL.Strings = (
      'delete from ANALISEESTOQUE'
      'where'
      '  IDANALISEESTOQUE = :OLD_IDANALISEESTOQUE')
  end
