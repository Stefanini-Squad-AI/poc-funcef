        '       (P.DESCPROD || '#39' '#39' || T.CODTAMANHO || '#39' '#39' || C.CODCOR) AS' +
        ' DESCRICAO,'
      '       IE.NumRequisicao,'
      '       IE.IDITEMENTREGA,'
      '       I.QTDEPENDENTE,   '
      '       IE.QTDEEntrega,'
      '       IE.VALORUN,'
      '       IE.CodMedida,'
      '       R.CODCENTROCUSTO,'
      '       R.CustoTransf,'
      '       R.CodAlmoxaDestino,'
      '       R.CodAlmoxaOrigem,'
      '       R.UNIDNEGOC'
      '  From'
      '       Artigo A,'
      '       Produto P,'
      '       Cor C,'
      '       Tamanho T,'
      '       REQMAT R,'
      '       ItemEntr IE,'
      '       ITEMPEDI I'
      '  Where'
      '           (R.CodAlmoxaDestino = 2)'
      '       and (R.idPessoa = 1)'
      '       and (IE.DataReceb is Null and IE.FLGSTATUS = '#39'F'#39')'
      '       And (A.CodProduto = p.CodProduto)'
      '       and (A.Codtamanho = T.CodTamanho(+))'
      '       and (A.CodCor     = C.CodCor(+))'
      '       and (A.CodArtigo  = IE.CODARTIGO)'
      '       and (IE.NUMREQUISICAO = R.NUMREQUISICAO)'
      '       and (A.CodArtigo  = I.CODARTIGO)'
      '       and (I.NUMREQUISICAO = R.NUMREQUISICAO)'
      '  Order By Descricao'
      ''
      ' ')
