  object qryUltComp: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '      OC.DATAOC AS DATA,'
      '      IO.CODARTIGO AS CODARTIGO,'
      '      P.RAZAOSOCIAL AS FORNECEDOR,'
      '      IO.QTDEPEDIDA AS QTDE ,'
      '      IO.CODMEDIDA AS UNID,'
      '      IO.VALORUN AS PRECO,'
      '      PG.PRAZOPGTO AS PRAZO,'
      '      PG.PERIODOPRAZO AS PERIDO'
      'FROM'
      '   OC OC,'
      '   ITEMOC IO,'
      '   PESSOA P,'
      '   PRAZOPGTOOC PG'
      'WHERE'
      '      (RTRIM(IO.CODARTIGO) = :CODARTIGO)'
      '  AND (OC.IDPESSOA = :IDPESSOA)'
      '  AND (IO.NUMOC = OC.NUMOC)'
      '  AND (IO.IDITEMOC = PG.IDITEMOC(+))'
      '  AND (OC.IDFORCLI = P.IDPESSOA)'
      'ORDER BY OC.DATAOC DESC')
    ValidateWithMask = True
    Left = 766
    Top = 74
    ParamData = <
      item
        DataType = ftString
        Name = 'CODARTIGO'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
    object qryUltCompDATA: TDateTimeField
      FieldName = 'DATA'
      DisplayFormat = 'DD/MM/YYYY'
    end
    object qryUltCompCODARTIGO: TStringField
      FieldName = 'CODARTIGO'
      Size = 14
    end
    object qryUltCompFORNECEDOR: TStringField
      FieldName = 'FORNECEDOR'
      Size = 60
    end
    object qryUltCompQTDE: TFloatField
      FieldName = 'QTDE'
      DisplayFormat = '#,####0.0000'
    end
    object qryUltCompUNID: TStringField
      FieldName = 'UNID'
      Size = 4
    end
    object qryUltCompPRECO: TFloatField
      FieldName = 'PRECO'
      DisplayFormat = '#,##0.00'
    end
    object qryUltCompPRAZO: TFloatField
      FieldName = 'PRAZO'
    end
    object qryUltCompPERIDO: TStringField
      FieldName = 'PERIDO'
      Size = 1
    end
  end
