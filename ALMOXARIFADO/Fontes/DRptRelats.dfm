  object bdeNotaDifOC: TppBDEPipeline
    DataSource = dsNotaDifOC
    UserName = 'bdeNotaDifOC'
    Left = 26
    Top = 495
  end
  object dsNotaDifOC: TwwDataSource
    DataSet = qryNotaDifOC
    Left = 28
    Top = 479
  end
  object qryNotaDifOC: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '     INF.IDITEMOC,'
      '     INF.CODARTIGO,'
      '     O.NUMOC,'
      '     IO.CODMEDIDA,'
      '     (TO_CHAR(NF.NUMNF) || '#39'/'#39' || NF.COMPLNF) AS NUMNOTA,'
      '     ROUND(IO.VALORUN,2) AS VALOROC,'
      '     ROUND((INF.VLRUNITARIO/CR.FATOR*CM.FATOR),2) AS VALORNF,'
      '     ROUND(IO.QTDEPEDIDA,2) AS QTDEOC,'
      '     ROUND((INF.QTDERECEBDEVOL*CR.FATOR/CM.FATOR),2) AS QTDENF,'
      '     P.DESCPROD,'
      '     PE.RAZAOSOCIAL,'
      '     NF.DATAENTDEVOL'
      'FROM'
      '     ITENSRECEBDEVOL INF,'
      '     PESSOA PE,'
      '     NFRECEBDEVOL NF,'
      '     ITEMOC IO,'
      '     OC O,'
      '     ARTIGO A,'
      '     PRODUTO P,'
      '     CONVER CR,'
      '     CONVER CM'
      'WHERE'
      '      (NF.FLGTIPONOTA = '#39'R'#39' ) and (1=2)'
      '  AND (NF.DATAENTDEVOL >= TO_DATE('#39'01/04/2001'#39','#39'DD/MM/YYYY'#39'))'
      '  AND (NF.DATAENTDEVOL <= TO_DATE('#39'30/04/2001'#39','#39'DD/MM/YYYY'#39'))'
      '  AND (INF.IDNFRECEBDEVOL = NF.IDNFRECEBDEVOL)'
      '  AND (INF.IDITEMOC = IO.IDITEMOC)'
      '  AND (O.NUMOC = IO.NUMOC)'
      '  AND (PE.IDPESSOA = NF.IDFORCLI)'
      '  AND (A.CODARTIGO = INF.CODARTIGO)'
      '  AND (A.CODPRODUTO = P.CODPRODUTO)'
      '  AND (CR.CODMEDIDA = INF.CODMEDIDA)'
      '  AND (CR.CODPRODUTO = P.CODPRODUTO)'
      '  AND (IO.CODMEDIDA = CM.CODMEDIDA)'
      '  AND (CM.CODPRODUTO = P.CODPRODUTO)'
      
        '  AND ((ROUND(IO.VALORUN,2) <> ROUND((INF.VLRUNITARIO/CR.FATOR*C' +
        'M.FATOR),2))'
      
        '             OR (ROUND(IO.QTDEPEDIDA,2) <> ROUND((INF.QTDERECEBD' +
        'EVOL*CR.FATOR/CM.FATOR),2)))'
      'ORDER BY O.NUMOC, P.DESCPROD')
    ValidateWithMask = True
    Left = 28
    Top = 465
  end
