  object dsReqCad: TwwDataSource
    DataSet = qryReqCad
    Left = 388
    Top = 289
  end
  object qryReqCad: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '     RQ.NUMREQUISICAO,                                          '
      '     DECODE(CUSTOTRANSF,'#39'T'#39',AD.DESCALMOX,CC.NOME) AS DESTINO,'
      '     RQ.DATAEMISSAO,'
      '     RQ.DATANECESSIDADE,'
      
        '     DECODE(RQ.REQATENDIDA,'#39'F'#39','#39'PENDENTE'#39', DECODE(RQ.REQATENDIDA' +
        ','#39'T'#39','#39'ANTED. TOTAL'#39','#39'ANTED. PARCIAL'#39') )  AS  STATUS,'
      '     AO.DESCALMOX AS ORIGEM,'
      '     SL.LOCALIZACAO,'
      '     IP.CODARTIGO,'
      
        '     (P.DESCPROD || '#39' '#39' || A.CODTAMANHO || '#39' '#39' || A.CODCOR) AS D' +
        'ESCRICAO,'
      '     IP.CODMEDIDA,'
      '     IP.QTDEPEDIDA,'
      '     IP.VALORUN,'
      '     IP.QTDEPENDENTE,'
      '    (IP.VALORUN * IP.QTDEPEDIDA) AS VALOR,'
      '     PE.RAZAOSOCIAL,'
      '     RQ.TRGDTINCLUSAO,'
      '     RQ.OBS,'
      '     IP.OBS AS OBSITEM,'
      '     U.NOME AS UNIDNEGOC '
      'FROM'
      '    PESSOA PE,'
      '    ITEMPEDI IP,'
      '    REQMAT RQ,'
      '    SALDO SL,'
      '    ALMOX AD,'
      '    ALMOX AO,'
      '    PRODUTO P,'
      '    ARTIGO A,'
      '    CENTCUST CC,'
      '    UNIDNEGOCIO U'
      'WHERE (1=2) and'
      '       (RQ.REQATENDIDA = '#39'F'#39' )'
      '   AND (RQ.CODALMOXADESTINO = AD.CODALMOXARIFADO(+))'
      '   AND (RQ.CODALMOXAORIGEM  = AO.CODALMOXARIFADO)'
      '   AND (RQ.CODCENTROCUSTO = CC.CODCENTROCUSTO)'
      '   AND (RQ.IDEMPRESA = CC.IDEMPRESA)'
      '   AND (RQ.IDUSUARIOINCLUSAO = PE.IDPESSOA)'
      '   AND (RQ.UNIDNEGOC         = U.UNIDNEGOC(+) )'
      '   AND (RQ.IDPESSOA          = U.IDPESSOA(+) )'
      '   AND (IP.NUMREQUISICAO = RQ.NUMREQUISICAO)'
      '   AND (P.CODPRODUTO = A.CODPRODUTO )'
      '   AND (A.CODARTIGO = IP.CODARTIGO )'
      '   AND (A.CODARTIGO(+)       = SL.CODARTIGO )'
      '   AND (AO.CODALMOXARIFADO(+)= SL.CODALMOXARIFADO )'
      'ORDER BY'
      '      RQ.NUMREQUISICAO'
      ''
      ''
      ''
      ' ')
    ValidateWithMask = True
    Left = 388
    Top = 275
  end
  object RptReqCad: TppReport
    AutoStop = False
    DataPipeline = bdeReqCad
    OnPrintingComplete = RptReqCadPrintingComplete
    PassSetting = psTwoPass
    PrinterSetup.BinName = 'Default'
    PrinterSetup.DocumentName = 'PpModeloReport1'
