  object dsCurvaAltCustoMed: TwwDataSource
    DataSet = qryCurvaAltCustoMed
    Left = 692
    Top = 385
  end
  object qryCurvaAltCustoMed: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '   ('#39'A'#39') AS GRUPO,'
      '    SUB.CODARTIGO,'
      '    P.DESCPROD,'
      '    P.CODMEDCUSTO,'
      '   (MIN.CUSTOMEDIOMOV) AS ULTCUSTOMED,'
      '   (MAX.CUSTOMEDIOMOV) AS NOVOCUSTOMED,'
      '   (MAX.CUSTOMEDIOMOV - MIN.CUSTOMEDIOMOV) AS DIFCUSTOMED,'
      
        '   (ABS(MAX.CUSTOMEDIOMOV - MIN.CUSTOMEDIOMOV)/DECODE(MIN.CUSTOM' +
        'EDIOMOV,0,1,MIN.CUSTOMEDIOMOV)) * 100  AS PERCCUSTOMED,'
      '   (0) AS ULTPRECO,'
      '   (0) AS NOVOPRECO,'
      '   (0) AS DIFPRECO,    '
      '   (0) AS PERCPRECO'
      'FROM'
      '   MOVIMENT MIN,'
      '   MOVIMENT MAX,'
      '  ('
      '   SELECT'
      '       UN.CODARTIGO,'
      '       MAX(UN.IDMAX) AS IDMAX,'
      '       MAX(UN.IDMIN) AS IDMIN'
      '   FROM'
      '   ('
      '     SELECT'
      '         M.CODARTIGO,'
      '         TO_DATE('#39#39') AS DATA,'
      '         (0) AS IDMIN,'
      '         MAX(IDMOV) AS IDMAX'
      '     FROM'
      '         MOVIMENT M'
      '     WHERE'
      '             (M.CODALMOXARIFADO = 1)'
      '         AND (M.DATAMOV >= TO_DATE('#39'01/01/2001'#39','#39'dd/mm/yyyy'#39'))'
      '         AND (M.DATAMOV <= TO_DATE('#39'31/10/2001'#39','#39'dd/mm/yyyy'#39'))'
      '     GROUP BY M.CODARTIGO'
      '     UNION'
      '     SELECT'
      '         M.CODARTIGO,'
      '         MIN(M.DATAMOV) AS DATA,'
      '         MIN(IDMOV) AS IDMIN,'
      '         (0) AS IDMAX'
      '     FROM'
      '         MOVIMENT M'
      '     WHERE'
      '             (M.CODALMOXARIFADO = 1)'
      '         AND (M.DATAMOV >= TO_DATE('#39'01/01/2001'#39','#39'dd/mm/yyyy'#39'))'
      '         AND (M.DATAMOV <= TO_DATE('#39'31/10/2001'#39','#39'dd/mm/yyyy'#39'))'
      '     GROUP BY M.CODARTIGO'
      '     ) UN'
      '     GROUP BY UN.CODARTIGO'
      '   ) SUB,'
      '   PRODUTO P,'
      '   ARTIGO A,'
      '   GRUPPROD G'
      'WHERE'
      '        (SUB.CODARTIGO = A.CODARTIGO) and (1=2)'
      '    AND (SUB.IDMIN = MIN.IDMOV)'
      '    AND (SUB.IDMAX = MAX.IDMOV)    '
      '    AND (A.CODPRODUTO = P.CODPRODUTO)'
      '    AND (G.CODGRUPOPROD = P.CODGRUPOPROD)'
      'ORDER BY GRUPO, PERCCUSTOMED')
    ValidateWithMask = True
    Left = 692
    Top = 371
  end
