  object qryArtxConta: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */ '
      '      G.CODGRUPOPROD,'
      '      G.STATUSGRUPO,'
      
        '      (RTRIM(G.CODGRUPOPROD) || '#39'  '#39' || G.DESCGRUPOPROD) AS DESC' +
        'GRUPO,'
      '      A.CODARTIGO,'
      
        '      (P.DESCPROD || '#39' '#39' || A.CODCOR'#9'|| '#39' '#39' || A.CODTAMANHO) AS ' +
        'DESCRICAO,'
      #9'(C.CONTAENTRADA || '#39'  '#39' || PC.PLANOME ) AS CONTAENTRADA,'
      #9'(C.CONTAENTRADA || '#39'  '#39' || PC.PLANOME ) AS CONTASAIDA,'
      '      (C.CODCENTROCUSTO ||'#39'  '#39' || CC.NOME ) AS CENTCUST'
      'FROM'
      '    ARTIGO A,'
      '    PRODUTO P,'
      '    GRUPPROD G,'
      '    ARTXCONTAXCC C,'
      '    PLANOCONTA PC,'
      '    CENTCUST CC'
      'WHERE (1=2) and'
      '     (C.IDPESSOA = 1) '
      ' AND (A.CODPRODUTO = P.CODPRODUTO)'
      ' AND (P.CODGRUPOPROD = G.CODGRUPOPROD)'
      ' AND (A.CODARTIGO = C.CODARTIGO)'
      ' AND (C.CONTAENTRADA = PC.PLACONTA)'
      ' AND (C.CONTASAIDA = PC.PLACONTA)'
      ' AND (C.CODCENTROCUSTO = CC.CODCENTROCUSTO)'
      'ORDER BY CODGRUPOPROD,CODARTIGO')
    ValidateWithMask = True
    Left = 26
    Top = 209
  end
