  object bdeGiroProd: TppBDEPipeline
    DataSource = dsGiroProd
    UserName = 'bdeGiroProd'
    Left = 106
    Top = 401
  end
  object dsGiroProd: TwwDataSource
    DataSet = qryGiroProd
    Left = 108
    Top = 385
  end
  object qryGiroProd: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  /*+ rule */              '
      '      G.CODGRUPOPROD, '
      '      G.DESCGRUPOPROD,'
      '      A.CODARTIGO,    '
      '      P.CODMEDCUSTO,  '
      
        '      (P.DESCPROD || '#39' '#39' || A.CODCOR || '#39' '#39' || A.CODTAMANHO ) AS' +
        ' DESCRICAO, '
      '      CM1.CONSMED1,  '
      '      CM2.CONSMED2,  '
      '      CM3.CONSMED3,'
      '      C.CUSTOMEDIO,  '
      '     (CM1.CONSMED1 + CM2.CONSMED2 + CM3.CONSMED3)/3 AS MEDIA'
      ' FROM                   '
      '      (SELECT           '
      '            M.CODARTIGO,'
      '            ((SUM(M.QTDEMOV)* -1)/30) AS CONSMED1,'
      '            (SUM(QTDEMOV)* -1) AS CONSTOT '
      '       FROM '
      '            MOVIMENT M '
      '       WHERE '
      '            (M.CODALMOXARIFADO =2 ) '
      '        AND (M.CODTIPOMOV <> '#39'A'#39') '
      '        AND (M.CODTIPOMOV <> '#39'K'#39') '
      '        AND (M.CODTIPOMOV <> '#39'Z'#39') '
      '        AND (M.DATAMOV >= TO_DATE('#39'01/06/2000'#39','#39'dd/mm/yyyy'#39')) '
      '        AND (M.DATAMOV <= TO_DATE('#39'30/06/2000'#39','#39'dd/mm/yyyy'#39')) '
      '       GROUP BY M.CODARTIGO ) CM1, '
      '      (SELECT           '
      '            M.CODARTIGO,'
      '            ((SUM(M.QTDEMOV)* -1)/30) AS CONSMED2, '
      '            (SUM(QTDEMOV)* -1) AS CONSTOT '
      '       FROM '
      '            MOVIMENT M '
      '       WHERE '
      '            (M.CODALMOXARIFADO =2 )'
      '        AND (M.CODTIPOMOV <> '#39'A'#39') '
      '        AND (M.CODTIPOMOV <> '#39'K'#39') '
      '        AND (M.CODTIPOMOV <> '#39'Z'#39') '
      '        AND (M.DATAMOV >= TO_DATE('#39'01/07/2000'#39','#39'dd/mm/yyyy'#39')) '
      '        AND (M.DATAMOV <= TO_DATE('#39'30/07/2000'#39','#39'dd/mm/yyyy'#39')) '
      '       GROUP BY M.CODARTIGO ) CM2, '
      '      (SELECT           '
      '            M.CODARTIGO,'
      '            ((SUM(M.QTDEMOV)* -1)/30) AS CONSMED3, '
      '            (SUM(QTDEMOV)* -1) AS CONSTOT '
      '       FROM '
      '            MOVIMENT M '
      '       WHERE '
      '            (M.CODALMOXARIFADO =2 ) '
      '        AND (M.CODTIPOMOV <> '#39'A'#39') '
      '        AND (M.CODTIPOMOV <> '#39'K'#39') '
      '        AND (M.CODTIPOMOV <> '#39'Z'#39') '
      '        AND (M.DATAMOV >= TO_DATE('#39'01/08/2000'#39','#39'dd/mm/yyyy'#39')) '
      '        AND (M.DATAMOV <= TO_DATE('#39'30/08/2000'#39','#39'dd/mm/yyyy'#39'))'
      '       GROUP BY M.CODARTIGO ) CM3, '
      '       ARTIGO A,   '
      '       PRODUTO P,  '
      '       GRUPPROD G, '
      '       SALDO S,    '
      '       CUSTOMED C  '
      ' WHERE  (1=2) and'
      '       (A.CODPRODUTO  = P.CODPRODUTO) '
      '   AND (C.CODCUSTEIO = 1)  '
      '   AND (S.CODALMOXARIFADO = 2)  '
      '   AND (P.CODGRUPOPROD = G.CODGRUPOPROD)'
      '   AND (A.CODARTIGO = CM1.CODARTIGO(+))  '
      '   AND (A.CODARTIGO = CM2.CODARTIGO(+))  '
      '   AND (A.CODARTIGO = CM3.CODARTIGO(+))  '
      '   AND (A.CODARTIGO = C.CODARTIGO)  '
      '   AND (A.CODARTIGO = S.CODARTIGO)  '
      ''
      
        'ORDER BY G.CODGRUPOPROD,(P.DESCPROD || '#39' '#39' || A.CODCOR || '#39' '#39' ||' +
        ' A.CODTAMANHO )'
      '')
    ValidateWithMask = True
    Left = 108
    Top = 371
  end
