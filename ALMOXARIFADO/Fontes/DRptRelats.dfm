  object bdeConAlmoxContab: TppBDEPipeline
    DataSource = dsConAlmoxContab
    UserName = 'bdeConAlmoxContab'
    Left = 114
    Top = 305
  end
  object dsConAlmoxContab: TwwDataSource
    DataSet = qryConAlmoxContab
    Left = 116
    Top = 289
  end
  object qryConAlmoxContab: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  /*+ rule */'
      '    UN.DATA,'
      '    UN.CONTA,'
      '    UN.ALMOXCREDITO,'
      '    UN.ALMOXDEBITO, '
      '    UN.CONTABCREDITO,'
      '    UN.CONTABDEBITO,'
      '    ABS (UN.ALMOXCREDITO - UN.CONTABCREDITO) AS DIFCREDITO,'
      '    ABS (UN.ALMOXDEBITO - UN.CONTABDEBITO) AS DIFDEBITO    '
      'FROM'
      '('
      'SELECT '
      '     M.DATAMOV AS DATA, '
      '     DECODE(ART.CONTA,NULL,GRP.CONTA,ART.CONTA) AS CONTA, '
      
        '     SUM(DECODE(SIGN(M.VALORMOV),1,M.VALORMOV,0)) AS  ALMOXCREDI' +
        'TO, '
      
        '     SUM(DECODE(SIGN(M.VALORMOV),-1,M.VALORMOV,0)) AS ALMOXDEBIT' +
        'O,'
      '     (0) AS CONTABCREDITO,'
      '     (0) AS CONTABDEBITO'
      'FROM'
      '     MOVIMENT M,'
      '     PRODUTO P,'
      '     ( SELECT '
      '            CODARTIGO,'
      '            CONTAENTRADA AS CONTA'
      '       FROM'
      '            ARTXCONTAXCC'
      '       GROUP BY CODARTIGO, CONTAENTRADA'
      '      ) ART,'
      '      ( SELECT '
      '            CODGRUPOPROD,'
      '            CONTAENTRADA AS CONTA'
      '       FROM'
      '            ARTXCONTAXCC'
      '       GROUP BY CODGRUPOPROD, CONTAENTRADA'
      ''
      '      ) GRP'
      'WHERE'
      '      (M.DATAMOV >= TO_DATE('#39'01/05/1999'#39','#39'DD/MM/YYYY'#39'))'
      '  AND (M.DATAMOV <= TO_DATE('#39'31/05/1999'#39','#39'DD/MM/YYYY'#39'))'
      '  AND (SUBSTR(M.CODARTIGO,1,6) = P.CODPRODUTO)'
      '  AND (M.CODARTIGO = ART.CODARTIGO(+))'
      '  AND (P.CODGRUPOPROD = GRP.CODGRUPOPROD)'
      'GROUP BY '
      '     M.DATAMOV,     '
      '     DECODE(ART.CONTA,NULL,GRP.CONTA,ART.CONTA), '
      '     DECODE(ART.CONTA,NULL,'#39'G'#39','#39'A'#39')'
      'UNION'
      '  SELECT '
      '       PLN.PLNDATDIA AS DATA,'
      '       LAC.PLACONTA AS CONTA,  '
      '       (0) AS ALMOXCREDITO,'
      '       (0) AS ALMOXDEBITO,'
      
        '       SUM(DECODE(LACDEBCRE,'#39'C'#39',LAC.LACVALOR,0)) AS CONTABCREDIT' +
        'O,'
      '       SUM(DECODE(LACDEBCRE,'#39'D'#39',LAC.LACVALOR,0)) AS CONTABDEBITO'
      '  FROM'
      '      LANCAMENTO LAC,'
      '      PLANILHA PLN'
      '  WHERE'
      '        (PLN.PLNDATDIA >= TO_DATE('#39'01/05/1999'#39','#39'DD/MM/YYYY'#39'))'
      '    AND (PLN.PLNDATDIA <= TO_DATE('#39'31/05/1999'#39','#39'DD/MM/YYYY'#39'))'
      '    AND (PLN.PLNCODIGO = LAC.PLNCODIGO)'
      '  GROUP BY PLN.PLNDATDIA, LAC.PLACONTA'
      '     '
      ') UN'
      'WHERE (1=2)'
      'ORDER BY UN.DATA, UN.CONTA')
    ValidateWithMask = True
    Left = 116
    Top = 275
  end
