  object qryRecMercSint: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      ' SELECT /*+ rule */ '
      '      NF.DATAENTDEVOL, '
      '      NF.DATAEMISNF,   '
      '      P.RAZAOSOCIAL,   '
      '      (TO_CHAR(NF.NUMNF) || '#39'/'#39' || NF.COMPLNF) AS NOTANUM, '
      '      NF.VLRNOTAFISCAL, '
      '      NF.FLGTIPONOTA,'
      '      TD.DESCRICAO AS TIPODOC  '
      ' FROM                   '
      '      PESSOA P,          '
      '      NFRECEBDEVOL NF,  '
      '      DOCUMENTO D,'
      '      TIPODOCRECPAG TD'
      ' WHERE     (1=2) and             '
      '      (NF.FLGTIPONOTA <> '#39'D'#39') '
      '  AND (NF.DATAENTDEVOL >= TO_DATE('#39'29/05/2000'#39','#39'dd/mm/yyyy'#39')) '
      '  AND (NF.DATAENTDEVOL <= TO_DATE('#39'29/05/2000'#39','#39'dd/mm/yyyy'#39')) '
      '  AND (NF.IDPESSOA = 1)'
      '  AND (NF.IDFORCLI = P.IDPESSOA) '
      '  AND (NF.CODDOCUMENTO = D.CODDOCUMENTO) '
      '  AND (D.CODTIPDOC    = TD.CODTIPDOC) '
      ''
      
        'ORDER BY NF.DATAENTDEVOL,P.RAZAOSOCIAL,(TO_CHAR(NF.NUMNF) || '#39'/'#39 +
        ' || NF.COMPLNF) '
      '')
    ValidateWithMask = True
    Left = 114
    Top = 117
  end
