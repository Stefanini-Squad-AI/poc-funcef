  object updResFinAnual: TUpdateSQL
    ModifySQL.Strings = (
      'update MOVIMENT'
      'set'
      '  CODCENTROCUSTO = :CODCENTROCUSTO,'
      '  NOME = :NOME,'
      '  CODGRUPOPROD = :CODGRUPOPROD,'
      '  DESCGRUPOPROD = :DESCGRUPOPROD,'
      '  CODARTIGO = :CODARTIGO,'
      '  DESCRICAO = :DESCRICAO,'
      '  JAN = :JAN,'
      '  FEV = :FEV,'
      '  MAR = :MAR,'
      '  ABR = :ABR,'
      '  MAI = :MAI,'
      '  JUN = :JUN,'
      '  JUL = :JUL,'
      '  AGO = :AGO,'
      '  SEB = :SEB,'
      '  OUT = :OUT,'
      '  NOV = :NOV,'
      '  DEZ = :DEZ,'
      '  TOT = :TOT'
      'where'
      '  CODCENTROCUSTO = :OLD_CODCENTROCUSTO and'
      '  CODGRUPOPROD = :OLD_CODGRUPOPROD and'
      '  CODARTIGO = :OLD_CODARTIGO')
    InsertSQL.Strings = (
      'insert into MOVIMENT'
      '  (CODCENTROCUSTO, NOME, CODGRUPOPROD, DESCGRUPOPROD, '
      'CODARTIGO, DESCRICAO, '
      
        '   JAN, FEV, MAR, ABR, MAI, JUN, JUL, AGO, SEB, OUT, NOV, DEZ, T' +
        'OT)'
      'values'
      '  (:CODCENTROCUSTO, :NOME, :CODGRUPOPROD, :DESCGRUPOPROD, '
      ':CODARTIGO, :DESCRICAO, '
      
        '   :JAN, :FEV, :MAR, :ABR, :MAI, :JUN, :JUL, :AGO, :SEB, :OUT, :' +
        'NOV, :DEZ, '
      '   :TOT)')
    DeleteSQL.Strings = (
      'delete from MOVIMENT'
      'where'
      '  CODCENTROCUSTO = :OLD_CODCENTROCUSTO and'
      '  CODGRUPOPROD = :OLD_CODGRUPOPROD and'
      '  CODARTIGO = :OLD_CODARTIGO')
    Left = 208
    Top = 318
  end
