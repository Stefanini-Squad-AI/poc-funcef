  object qryNFxCustAgreg: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '     NF.DATAENTDEVOL,'
      '     NF.DATAEMISNF,'
      '     P.RAZAOSOCIAL,'
      '     (TO_CHAR(NF.NUMNF) || '#39'/'#39' || COMPLNF) AS NOTANUM,'
      '     NF.VLRNOTAFISCAL,'
      '     NF.FLGTIPONOTA,'
      
        ' DECODE(NOTA.CODTIPOCUSTAGREG,NULL,ITEM.ALIQUOTA,NOTA.ALIQUOTA) ' +
        'AS ALIQUOTA,'
      
        '     DECODE(NOTA.CODTIPOCUSTAGREG,NULL,ITEM.ITBASE,NOTA.NFBASE) ' +
        'AS BASE,'
      
        '     DECODE(NOTA.CODTIPOCUSTAGREG,NULL,ITEM.ITVALOR,NOTA.NFVALOR' +
        ') AS VALOR,'
      
        '     DECODE(NOTA.CODTIPOCUSTAGREG,NULL,ITEM.ITRECUP,NOTA.NFRECUP' +
        ') AS RECUP,'
      
        '     DECODE(NOTA.CODTIPOCUSTAGREG,NULL,TI.DESCCUSTAGREG,TN.DESCC' +
        'USTAGREG) AS DESCRICAO,   '
      
        '     DECODE(NOTA.CODTIPOCUSTAGREG,NULL,DECODE(ITEM.CODTIPOCUSTAG' +
        'REG,NULL,'#39#39','#39'ITEM'#39'),'#39'NOTA'#39') AS TIPO'
      ''
      'FROM '
      '     NFRECEBDEVOL NF,'
      '     TIPOAGRE TI,'
      '     TIPOAGRE TN,'
      '       ( SELECT'
      #9'        NF.IDNFRECEBDEVOL  AS IDITEM,'
      '              AIT.CODTIPOCUSTAGREG,     '
      #9#9'  AIT.ALIQUOTA,'
      '              SUM(AIT.BASECALCULO)  AS ITBASE,'
      '              SUM(AIT.VLRAGREGADO)   AS ITVALOR,'
      '              SUM(AIT.VLRRECUPERADO)   AS ITRECUP'
      '         FROM'
      '              NFRECEBDEVOL NF,'
      '              ITENSRECEBDEVOL IT,                   '
      '              AGRITENSRECDEV  AIT'
      '         WHERE'
      '                 (NF.FLGTIPONOTA <> '#39'D'#39')           '
      
        '             AND (NF.DATAENTDEVOL >= TO_DATE('#39'01/05/1999'#39','#39'dd/mm' +
        '/yyyy'#39'))'
      
        '             AND (NF.DATAENTDEVOL <= TO_DATE('#39'31/05/1999'#39','#39'dd/mm' +
        '/yyyy'#39'))'
      '             AND (NF.IDNFRECEBDEVOL =  IT.IDNFRECEBDEVOL)'
      '             AND (IT.IDITENSRECDEV = AIT.IDITENSRECDEV)'
      '          GROUP BY NF.IDNFRECEBDEVOL,'
      '                   AIT.CODTIPOCUSTAGREG,'
      #9#9#9' AIT.ALIQUOTA'
      '         ) ITEM,'
      '       ( SELECT'
      #9'        NF.IDNFRECEBDEVOL  AS IDNOTA,                   '
      '              ANF.CODTIPOCUSTAGREG,'
      #9#9'  ANF.ALIQUOTA,'
      '              SUM(ANF.BASECALCULO)  AS NFBASE,'
      '              SUM(ANF.VLRAGREGADO)   AS NFVALOR,'
      '              SUM(ANF.VLRRECUPERADO)   AS NFRECUP'
      '         FROM'
      '              NFRECEBDEVOL NF,'
      '              AGRNFRECDEV  ANF'
      '         WHERE'
      '               (NF.FLGTIPONOTA <> '#39'D'#39')           '
      '           AND (ANF.IDNFCOMPLEMENTAR IS NULL)'
      
        '           AND (NF.DATAENTDEVOL >= TO_DATE('#39'01/05/1999'#39','#39'dd/mm/y' +
        'yyy'#39'))'
      
        '           AND (NF.DATAENTDEVOL <= TO_DATE('#39'31/05/1999'#39','#39'dd/mm/y' +
        'yyy'#39'))'
      '           AND (NF.IDNFRECEBDEVOL = ANF.IDNFRECEBDEVOL)'
      '         GROUP BY  NF.IDNFRECEBDEVOL,'
      '                   ANF.CODTIPOCUSTAGREG,'
      #9#9#9' ANF.ALIQUOTA'
      '       ) NOTA,    '
      '   PESSOA P'
      'WHERE    (1=2) and'
      '         (NF.FLGTIPONOTA <> '#39'D'#39')'
      '     AND (NF.DATAENTDEVOL >= TO_DATE('#39'01/05/1999'#39','#39'dd/mm/yyyy'#39'))'
      '     AND (NF.DATAENTDEVOL <= TO_DATE('#39'31/05/1999'#39','#39'dd/mm/yyyy'#39'))'
      '     AND (NF.IDFORCLI = P.IDPESSOA)'
      '     AND (NF.IDNFRECEBDEVOL =  ITEM.IDITEM(+))'
      '     AND (NF.IDNFRECEBDEVOL =  NOTA.IDNOTA(+))'
      '     AND (ITEM.CODTIPOCUSTAGREG = TI.CODTIPOCUSTAGREG(+) )'
      '     AND (NOTA.CODTIPOCUSTAGREG = TN.CODTIPOCUSTAGREG(+) )'
      'ORDER BY NF.DATAENTDEVOL,'
      '         P.RAZAOSOCIAL,'
      '         (TO_CHAR(NF.NUMNF) || '#39'/'#39' || COMPLNF)  '
      '    '
      ''
      ' ')
    ValidateWithMask = True
    Left = 682
    Top = 205
  end
