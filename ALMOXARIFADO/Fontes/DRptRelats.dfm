  end
  object qryUltMovArt: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT   /*+ rule */                '
      '     M.IDMOV,           '
      '     M.CODARTIGO,       '
      '     P.DESCPROD,        '
      '     M.DATAMOV,         '
      '     M.SALDOQTDEMOV,    '
      '     M.QTDEMOV,         '
      '     P.CODMEDCUSTO,     '
      '     M.CUSTOMEDIOMOV,   '
      '     T.DESCRESUMIDA     '
      ' FROM'
      '      MOVIMENT M,'
      '      ( SELECT'
      '              M.CODARTIGO,'
      '              MAX(M.IDMOV) AS IDMOV'
      '         FROM'
      '              MOVIMENT M,'
      '             (SELECT'
      '                   CODARTIGO,'
      '                   MAX(DATAMOV) AS MAXDATAMOV'
      '              FROM MOVIMENT'
      
        '              WHERE  ( DATAMOV <= TO_DATE('#39'11/10/2001'#39','#39'DD/MM/YY' +
        'YY'#39') )'
      '                 AND (CODALMOXARIFADO  = 1)'
      '              GROUP BY CODARTIGO'
      '             ) SUB'
      '        WHERE (M.CODARTIGO = SUB.CODARTIGO)'
      '          AND (M.DATAMOV =SUB.MAXDATAMOV)'
      '          AND (M.CODALMOXARIFADO = 1)'
      '        GROUP BY M.CODARTIGO ) AUX,'
      '      PRODUTO P,'
      '      ARTIGO A,'
      '      TIPOMOV T'
      'WHERE'
      '     (M.CODALMOXARIFADO = 1 )'
      ' AND (M.CODARTIGO = AUX.CODARTIGO)'
      ' AND (M.IDMOV = AUX.IDMOV)'
      ' AND (M.CODARTIGO = A.CODARTIGO)'
      ' AND (A.CODPRODUTO = P.CODPRODUTO)'
      ' AND (A.CODPRODUTO = P.CODPRODUTO)'
      ' AND (M.CODTIPOMOV = T.CODTIPOMOV)')
    ValidateWithMask = True
    Left = 500
    Top = 371
  end
