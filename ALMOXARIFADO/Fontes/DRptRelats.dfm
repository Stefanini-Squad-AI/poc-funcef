  object qryAjustFinanc: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      ' SELECT  /*+ rule */'
      
        '     A.CODALMOXARIFADO,                                         ' +
        '                   '
      
        '     A.DESCALMOX,                                               ' +
        '                   '
      '     AR.CODARTIGO,'
      '     P.DESCPROD,'
      '     SUM(NVL(U.VALANT,0)) AS VALANT,'
      '     SUM(NVL(U.VALCOMPRA,0)) AS VALCOMPRA,          '
      '     SUM(NVL(U.VALREQ,0)) AS VALREQ,          '
      '     SUM(NVL(U.VALATUAL,0)) AS VALATUAL,          '
      '     (SUM(NVL(U.VALANT,0))+SUM(NVL(U.VALCOMPRA,0))-'
      
        '     SUM(NVL(U.VALREQ,0))-SUM(NVL(U.VALATUAL,0))) AS AJUSTE     ' +
        '     '
      
        ' FROM                                                           ' +
        '                   '
      
        '     ALMOX A, ARTIGO AR, PRODUTO P,                             ' +
        '                                         '
      
        '     ((SELECT                                                   ' +
        '                    '
      
        '          VA.CODALMOXARIFADO, VA.CODARTIGO,                     ' +
        '                                '
      '          SUM(VA.VALOR) AS VALANT,'
      '          0 AS VALATUAL,'
      '          0 AS VALREQ,'
      
        '          0 AS VALCOMPRA                                        ' +
        '            '
      
        '     FROM                                                       ' +
        '                   '
      
        '     (                                                          ' +
        '                   '
      
        '     SELECT                                                     ' +
        '                   '
      
        '           M.CODALMOXARIFADO,                                   ' +
        '                   '
      
        '           M.CODARTIGO,                                         ' +
        '                   '
      
        '          (M.SALDOQTDEMOV * M.CUSTOMEDIOMOV) AS VALOR           ' +
        '                   '
      
        '      FROM                                                      ' +
        '                   '
      
        '          MOVIMENT M,                                           ' +
        '                   '
      
        '          ( SELECT                                              ' +
        '                   '
      
        '      '#9'    M.CODALMOXARIFADO,                                   ' +
        '            '
      
        '                  M.CODARTIGO,                                  ' +
        '                   '
      
        '                  MAX(M.IDMOV) AS IDMOV                         ' +
        '                   '
      
        '            FROM                                                ' +
        '                   '
      
        '               MOVIMENT M,                                      ' +
        '                   '
      
        '               (                                                ' +
        '                   '
      
        '                SELECT                                          ' +
        '                   '
      
        '                     CODALMOXARIFADO,                           ' +
        '                   '
      
        '                     CODARTIGO,                                 ' +
        '                   '
      
        '                     MAX(DATAMOV) AS DATAMOV                    ' +
        '                   '
      
        '                FROM MOVIMENT                                   ' +
        '                   '
      
        '                WHERE                                           ' +
        '                   '
      
        '                    (DATAMOV < TO_DATE('#39'01/05/2001'#39','#39'DD/MM/YYYY'#39 +
        ')) '
      
        '                GROUP BY CODALMOXARIFADO, CODARTIGO             ' +
        '                   '
      
        '                ) SUB1                                          ' +
        '                   '
      
        '            WHERE                                               ' +
        '                   '
      
        '                 (M.CODARTIGO       = SUB1.CODARTIGO)           ' +
        '                   '
      
        '             AND (M.CODALMOXARIFADO = SUB1.CODALMOXARIFADO)     ' +
        '                   '
      
        '             AND (M.DATAMOV         = SUB1.DATAMOV)             ' +
        '                   '
      
        '             GROUP BY M.CODALMOXARIFADO, M.CODARTIGO            ' +
        '                   '
      
        '            ) AUX                                               ' +
        '                   '
      
        '      WHERE                                                     ' +
        '                   '
      
        '           (M.CODARTIGO       = AUX.CODARTIGO)                  ' +
        '                   '
      
        '       AND (M.CODALMOXARIFADO = AUX.CODALMOXARIFADO)            ' +
        '                   '
      
        '       AND (M.IDMOV           = AUX.IDMOV)                      ' +
        '                   '
      
        '     ) VA                                                       ' +
        '                   '
      '     GROUP BY VA.CODALMOXARIFADO, VA.CODARTIGO ) '
      '     UNION ALL'
      
        '     (SELECT                                                    ' +
        '                   '
      
        '          VA.CODALMOXARIFADO, VA.CODARTIGO,                     ' +
        '                                '
      '          0 AS VALANT,'
      
        '          SUM(VA.VALOR) AS VALATUAL,                            ' +
        '                      '
      '          0 AS VALREQ,'
      
        '          0 AS VALCOMPRA                                        ' +
        '            '
      
        '     FROM                                                       ' +
        '                   '
      
        '     (                                                          ' +
        '                   '
      
        '     SELECT                                                     ' +
        '                   '
      
        '           M.CODALMOXARIFADO,                                   ' +
        '                   '
      
        '           M.CODARTIGO,                                         ' +
        '                   '
      
        '          (M.SALDOQTDEMOV * M.CUSTOMEDIOMOV) AS VALOR           ' +
        '                   '
      
        '      FROM                                                      ' +
        '                   '
      
        '          MOVIMENT M,                                           ' +
        '                   '
      
        '          ( SELECT                                              ' +
        '                   '
      
        '      '#9'    M.CODALMOXARIFADO,                                   ' +
        '            '
      
        '                  M.CODARTIGO,                                  ' +
        '                   '
      
        '                  MAX(M.IDMOV) AS IDMOV                         ' +
        '                   '
      
        '            FROM                                                ' +
        '                   '
      
        '               MOVIMENT M,                                      ' +
        '                   '
      
        '               (                                                ' +
        '                   '
      
        '                SELECT                                          ' +
        '                   '
      
        '                     CODALMOXARIFADO,                           ' +
        '                   '
      
        '                     CODARTIGO,                                 ' +
        '                   '
      
        '                     MAX(DATAMOV) AS DATAMOV                    ' +
        '                   '
      
        '                FROM MOVIMENT                                   ' +
        '                   '
      
        '                WHERE                                           ' +
        '                   '
      
        '                    (DATAMOV <= TO_DATE('#39'31/05/2001'#39','#39'DD/MM/YYYY' +
        #39')) '
      
        '                GROUP BY CODALMOXARIFADO, CODARTIGO             ' +
        '                   '
      
        '                ) SUB1                                          ' +
        '                   '
      
        '            WHERE                                               ' +
        '                   '
      
        '                 (M.CODARTIGO       = SUB1.CODARTIGO)           ' +
        '                   '
      
        '             AND (M.CODALMOXARIFADO = SUB1.CODALMOXARIFADO)     ' +
        '                   '
      
        '             AND (M.DATAMOV         = SUB1.DATAMOV)             ' +
        '                   '
      
        '             GROUP BY M.CODALMOXARIFADO, M.CODARTIGO            ' +
        '                   '
      
        '            ) AUX                                               ' +
        '                   '
      
        '      WHERE                                                     ' +
        '                   '
      
        '           (M.CODARTIGO       = AUX.CODARTIGO)                  ' +
        '                   '
      
        '       AND (M.CODALMOXARIFADO = AUX.CODALMOXARIFADO)            ' +
        '                   '
      
        '       AND (M.IDMOV           = AUX.IDMOV)                      ' +
        '                   '
      
        '     ) VA                                                       ' +
        '                   '
      '     GROUP BY VA.CODALMOXARIFADO, VA.CODARTIGO )'
      '     UNION ALL                                         '
      
        '     (SELECT                                                    ' +
        '                   '
      
        '           CODALMOXARIFADO, CODARTIGO,                          ' +
        '                             '
      '           0 AS VALANT,'
      
        '           0 AS VALATUAL,                                       ' +
        '           '
      '           0 AS VALREQ,'
      
        '           SUM(VALORMOV) AS VALCOMPRA                           ' +
        '                   '
      
        '      FROM                                                      ' +
        '                   '
      
        '          MOVIMENT                                              ' +
        '                   '
      
        '      WHERE                                                     ' +
        '                   '
      '            (DATAMOV >= TO_DATE('#39'01/05/2001'#39','#39'DD/MM/YYYY'#39'))   '
      '        AND (DATAMOV <= TO_DATE('#39'31/05/2001'#39','#39'DD/MM/YYYY'#39'))   '
      
        '        AND ((CODTIPOMOV = '#39'K'#39') OR (CODTIPOMOV = '#39'A'#39') OR (CODTIP' +
        'OMOV = '#39'B'#39') OR (CODTIPOMOV = '#39'Z'#39')) '
      
        '      GROUP BY CODALMOXARIFADO, CODARTIGO                       ' +
        '                              '
      '     ) UNION ALL                                          '
      
        '     (SELECT                                                    ' +
        '                   '
      
        '           CODALMOXARIFADO, CODARTIGO,                          ' +
        '                             '
      '           0 AS VALANT,'
      
        '           0 AS VALATUAL,                                       ' +
        '           '
      
        '           SUM(VALORMOV)*-1 AS VALREQ,                          ' +
        '                    '
      
        '           0 AS VALCOMPRA                                       ' +
        '             '
      
        '      FROM                                                      ' +
        '                   '
      
        '          MOVIMENT                                              ' +
        '                   '
      
        '      WHERE                                                     ' +
        '                   '
      '            (DATAMOV >= TO_DATE('#39'01/05/2001'#39','#39'DD/MM/YYYY'#39'))   '
      '        AND (DATAMOV <= TO_DATE('#39'31/05/2001'#39','#39'DD/MM/YYYY'#39'))   '
      
        '        AND ((CODTIPOMOV <> '#39'K'#39') AND (CODTIPOMOV <> '#39'A'#39') AND (CO' +
        'DTIPOMOV <> '#39'Z'#39') AND (CODTIPOMOV <> '#39'B'#39')) '
      
        '      GROUP BY CODALMOXARIFADO, CODARTIGO                       ' +
        '                              '
      
        '     ) ) U                                                      ' +
        '                '
      
        ' WHERE                                                          ' +
        '                   '
      '       (A.CODCUSTEIO =  2 )'
      '   AND (A.CODALMOXARIFADO = U.CODALMOXARIFADO)       '
      '   AND (AR.CODARTIGO = U.CODARTIGO)       '
      '   AND (AR.CODPRODUTO = P.CODPRODUTO)'
      
        'GROUP BY      A.CODALMOXARIFADO,                                ' +
        '                            '
      
        '     A.DESCALMOX,                                               ' +
        '                   '
      '     AR.CODARTIGO,'
      '     P.DESCPROD'
      'HAVING     '
      '     ((SUM(NVL(U.VALANT,0))+SUM(NVL(U.VALCOMPRA,0))-'
      '     SUM(NVL(U.VALREQ,0))-SUM(NVL(U.VALATUAL,0))) > 1) OR'
      '     ((SUM(NVL(U.VALANT,0))+SUM(NVL(U.VALCOMPRA,0))-'
      '     SUM(NVL(U.VALREQ,0))-SUM(NVL(U.VALATUAL,0))) < -1)'
      ''
      ' ORDER BY A.DESCALMOX                                     '
      ''
      ''
      ''
      ' ')
    ValidateWithMask = True
    Left = 596
    Top = 371
  end
