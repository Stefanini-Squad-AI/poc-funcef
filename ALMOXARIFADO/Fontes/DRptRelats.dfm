  object qryArtSemMov: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */ '
      '     P.CODGRUPOPROD,'
      '     G.DESCGRUPOPROD,'
      '     A.CODARTIGO,'
      
        '     (P.DESCPROD || '#39' '#39' || A.CODCOR || '#39' '#39' || A.CODTAMANHO) AS D' +
        'ESCRICAO,'
      '     S.SALDOQTDE,'
      '     C.CUSTOMEDIO,'
      '     P.CODMEDCUSTO,'
      '     (S.SALDOQTDE * C.CUSTOMEDIO ) VALOR,'
      '     ULT.ULTDATA'
      'FROM'
      '     ARTIGO A,'
      '     PRODUTO P,'
      '     CUSTOMED C,'
      '     SALDO S,'
      '     GRUPPROD G,'
      '     (SELECT CODARTIGO,MAX(DATAMOV) AS ULTDATA'
      '      FROM MOVIMENT'
      '      WHERE (CODTIPOMOV <> '#39'Z'#39')'
      '      GROUP BY CODARTIGO) ULT'
      'WHERE (1=2) and'
      '      (S.CODALMOXARIFADO = 2 )'
      '  AND (C.CODCUSTEIO = 1)'
      '  AND (A.CODARTIGO  NOT IN (SELECT CODARTIGO'
      '                            FROM MOVIMENT'
      #9#9#9'          WHERE (CODTIPOMOV <> '#39'Z'#39')'
      #9#9#9#9#9'AND (CODALMOXARIFADO = 2) ) )'
      '  AND (A.CODPRODUTO = P.CODPRODUTO)'
      '  AND (A.CODARTIGO  = S.CODARTIGO(+))'
      '  AND (A.CODARTIGO  = C.CODARTIGO(+))'
      '  AND (A.CODARTIGO  = ULT.CODARTIGO(+))  '
      '  AND (G.CODGRUPOPROD = P.CODGRUPOPROD)'
      '')
    ValidateWithMask = True
    Left = 27
    Top = 117
  end
  object dsArtSemMov: TwwDataSource
    DataSet = qryArtSemMov
    Left = 28
    Top = 103
  end
