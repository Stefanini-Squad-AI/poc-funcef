  object qryPlanProd: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '        G.CODGRUPOPROD,'
      '        G.DESCGRUPOPROD,'
      '        A.CODARTIGO,'
      '        P.CODMEDCUSTO,'
      
        '        (P.DESCPROD || '#39' '#39' || A.CODCOR || '#39' '#39' || A.CODTAMANHO ) ' +
        'AS DESCRICAO,'
      '        S.LOCALIZACAO'
      'FROM'
      '       ARTIGO A,'
      '       PRODUTO P,'
      '       GRUPPROD G,'
      '       SALDO S'
      'WHERE (1=2) and'
      '             ( A.CODPRODUTO  = P.CODPRODUTO)'
      '    AND (P.CODGRUPOPROD = G.CODGRUPOPROD)'
      '    AND ( A.CODARTIGO = S.CODARTIGO(+))'
      '    AND ( S.CODALMOXARIFADO = 2 )   '
      '')
    ValidateWithMask = True
    Left = 385
    Top = 207
  end
  object sdPlanProd: TwwDataSource
    DataSet = qryPlanProd
    Left = 386
    Top = 194
  end
  object dbePlanProd: TppBDEPipeline
    DataSource = sdPlanProd
    UserName = 'dbePlanProd'
    Left = 387
    Top = 180
  end
