  object qryCustContab: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '     ID,'
      '     CONTA,'
      '     DATA,'
      '     CODCENTROCUSTO,'
      '     CODARTIGO,'
      '     NUMDOCUMENTO,'
      '     CODMOV,'
      '     DESCMOV,'
      '     ALMOXORIGEM,'
      '     ALMOXDESINO,'
      '     VALOR,'
      '     DESCARTIGO,'
      '     CONTANOME,'
      '     NOMECC'
      'FROM'
      '    ALMOX'
      'WHERE (1=2) '
      'ORDER BY CONTA,DATA '
      '')
    ValidateWithMask = True
    Left = 115
    Top = 206
  end
