  object dsInventFF: TwwDataSource
    DataSet = qryInventFF
    Left = 182
    Top = 12
  end
  object qryInventFF: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '       CAT.CodGrupoProd, '
      '       CAT.StatusGrupo,'
      '       CAT.CODARTIGO, '
      '       CAT.SALDOQTDE, '
      '       CAT.DESCPROD,  '
      '       CAT.CodMedCusto,  '
      '       CAT.SaldoQtde,    '
      '       CAT.CustoMedio,   '
      '       CAT.DescGrupoProd,'
      '       CAT.Valor,'
      '       CAT.TOTAL'
      ' FROM'
      '(SELECT '
      '       S.CODARTIGO, '
      '       S.SALDOQTDE, '
      '       P.DESCPROD,  '
      '       P.CodGrupoProd, '
      '       P.CodMedCusto,  '
      '       S.SaldoQtde,    '
      '       C.CustoMedio,   '
      '       G.DescGrupoProd,'
      '       G.StatusGrupo,'
      '       (S.SaldoQtde * C.CustoMedio ) As Valor,'
      '       (0) AS TOTAL'
      'From  '
      '       Saldo S,      '
      '       CustoMed C,   '
      '       Produto P,    '
      '       GrupProd G    '
      'Where                '
      '     (S.CodAlmoxarifado = 2)'
      ' And (C.CodCusteio = 1)'
      ' And (S.idPessoa = 1 ) '
      ' And (RTRIM(Substr(S.CodArtigo,1,6)) = RTRIM(P.CodProduto))'
      ' And (C.CodArtigo = S.CodArtigo)      '
      ' And (G.CodGrupoProd(+) = P.CodGrupoProd)'
      ''
      'UNION'
      ''
      'SELECT '
      '   ('#39#39') AS CODARTIGO, '
      '   (0)  AS SALDOQTDE, '
      '   ('#39#39') AS DESCPROD,  '
      '        G.CodGrupoProd, '
      '   ('#39#39') AS CodMedCusto,  '
      '   (0)  AS SaldoQtde,    '
      '   (0)  AS CustoMedio,   '
      '        G.DescGrupoProd,'
      '        G.StatusGrupo,'
      '   (0)  AS Valor,'
      '    SUM(AUX.TOTAL)'
      'FROM '
      '    GRUPPROD G,'
      '    (SELECT'
      '          P.CODGRUPOPROD, '
      '          SUM(S.SaldoQtde * C.CustoMedio ) As TOTAL'
      '     FROM'
      '          SALDO S,'
      '          PRODUTO P,'
      '          CUSTOMED C'
      '     WHERE '
      '          (S.CodAlmoxarifado = 2)'
      '      And (C.CodCusteio = 1)'
      #9'And (S.idPessoa = 1 ) '
      #9'And (RTRIM(Substr(S.CodArtigo,1,6)) = RTRIM(P.CodProduto))'
      #9'And (C.CodArtigo = S.CodArtigo)  '
      '     GROUP BY P.CODGRUPOPROD ) AUX       '
      'WHERE'
      '      (G.STATUSGRUPO = '#39'S'#39')'
      
        '  AND (G.CODGRUPOPROD LIKE SUBSTR(RTRIM(AUX.CODGRUPOPROD),1,2) |' +
        '| '#39'%'#39')'
      '  AND (LENGTH(RTRIM(G.CODGRUPOPROD)) <= 2)'
      'GROUP BY G.CODGRUPOPROD,G.DescGrupoProd,G.StatusGrupo'
      ') CAT'
      'where (1=2)  '
      'ORDER  BY CodGrupoProd')
    ValidateWithMask = True
    Left = 182
    Top = 65534
  end
