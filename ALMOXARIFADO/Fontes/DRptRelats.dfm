  object dsReqLancSint: TwwDataSource
    DataSet = qryReqLancSint
    Left = 308
    Top = 385
  end
  object qryReqLancSint: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  /*+ rule */                                        '
      '  M.CODCENTROCUSTO,'
      '  MIN(C.NOME) AS DESCC,'
      '  G.STATUSGRUPO,                               '
      '  P.CODGRUPOPROD AS GRUPO,                     '
      '  MAX(SUBSTR(P.CODGRUPOPROD,1,4)) AS QUEBRA, '
      '  G.DESCGRUPOPROD,                             '
      '  SUM((M.VALORMOV*(-1))) AS VALORMOV,          '
      '  (0) AS TOTAL                                 '
      'FROM                                           '
      '   MOVIMENT M,                                 '
      '   PRODUTO P,                                  '
      '   ARTIGO A,                                   '
      '   GRUPPROD G,'
      '   CENTCUST C                                  '
      'WHERE  (1=1)                                   '
      
        '   AND (M.CODTIPOMOV <> '#39'Z'#39') AND (M.CODTIPOMOV <> '#39'A'#39') AND (M.CO' +
        'DTIPOMOV <> '#39'K'#39') AND (M.CODTIPOMOV <> '#39'B'#39') '
      '   AND (M.DATAMOV >= TO_DATE('#39'31/01/2001'#39','#39'DD/MM/YYYY'#39')) '
      '   AND (M.DATAMOV <= TO_DATE('#39'31/05/2001'#39','#39'DD/MM/YYYY'#39'))   '
      '   AND (M.CODALMOXARIFADO = 1)'
      '   AND (M.IDPESSOA = 1) '
      '   AND (M.IDPESSOA = C.IDEMPRESA)'
      '   AND (M.CODCENTROCUSTO = C.CODCENTROCUSTO)'
      '   AND (A.CODARTIGO = M.CODARTIGO)       '
      '   AND (A.CODPRODUTO   = P.CODPRODUTO)   '
      '   AND (P.CODGRUPOPROD = G.CODGRUPOPROD) '
      'GROUP BY                     '
      '        M.CODCENTROCUSTO,            '
      '        G.STATUSGRUPO,                   '
      '        P.CODGRUPOPROD,                  '
      '        G.DESCGRUPOPROD                  '
      'UNION ALL                                '
      'SELECT                                   '
      '  M.CODCENTROCUSTO,'
      '  MIN(C.NOME) AS DESCC,'
      '  G.STATUSGRUPO,                         '
      '  G.CODGRUPOPROD AS GRUPO,               '
      '  MAX(SUBSTR(P.CODGRUPOPROD,1,4)) AS QUEBRA, '
      '  G.DESCGRUPOPROD,                       '
      '  (0) AS VALORMOV,                       '
      '  SUM((M.VALORMOV*(-1))) AS TOTAL        '
      'FROM                                     '
      '   MOVIMENT M,                           '
      '   PRODUTO P,                            '
      '   ARTIGO A,                             '
      '   GRUPPROD G,'
      '   CENTCUST C                            '
      'WHERE  (1=2)                             '
      
        ' AND (M.CODTIPOMOV <> '#39'Z'#39') AND (M.CODTIPOMOV <> '#39'A'#39') AND (M.CODT' +
        'IPOMOV <> '#39'K'#39') AND (M.CODTIPOMOV <> '#39'B'#39') '
      '   AND (M.DATAMOV >= TO_DATE('#39'31/01/2001'#39','#39'DD/MM/YYYY'#39')) '
      '   AND (M.DATAMOV <= TO_DATE('#39'31/05/2001'#39','#39'DD/MM/YYYY'#39'))   '
      '   AND (M.IDPESSOA = 1) '
      '   AND (M.CODALMOXARIFADO = 1)'
      '   AND (M.IDPESSOA = 1) '
      '   AND (M.IDPESSOA = C.IDEMPRESA)'
      '   AND (M.CODCENTROCUSTO = C.CODCENTROCUSTO)'
      '   AND (G.STATUSGRUPO = '#39'S'#39') '
      
        '   AND (G.CODGRUPOPROD LIKE SUBSTR(RTRIM(P.CODGRUPOPROD),1,4) ||' +
        ' '#39'%'#39') '
      '   AND (A.CODARTIGO = M.CODARTIGO)    '
      '   AND (A.CODPRODUTO   = P.CODPRODUTO)'
      'GROUP BY                     '
      '        M.CODCENTROCUSTO,         '
      '        G.STATUSGRUPO,                '
      '        G.CODGRUPOPROD,               '
      '        G.DESCGRUPOPROD               '
      'ORDER BY  CODCENTROCUSTO, GRUPO                       '
      ''
      ''
      ''
      '')
    ValidateWithMask = True
    Left = 308
    Top = 371
  end
