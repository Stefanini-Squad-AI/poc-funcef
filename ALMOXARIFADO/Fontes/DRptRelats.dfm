  object dsSolPrePronta: TwwDataSource
    DataSet = qrySolPrePronta
    Left = 388
    Top = 102
  end
  object qrySolPrePronta: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */ '
      '   I.NUMSOLCOMPRA,'
      '   G.CODGRUPOPROD,'
      '   G.DESCGRUPOPROD,'#9
      '   I.CODARTIGO,'
      '   NF.VLRUNITARIO,'
      '   NF.DATAENTDEVOL AS DATAULT,'
      '   SA.SALDOQTDE,'
      
        '   (P.DESCPROD || '#39' '#39' || A.CODCOR || '#39' '#39' || A.CODTAMANHO)  AS DE' +
        'SCRICAO,'
      '   I.QTDEPEDIDA,'
      '   I.CODMEDIDA,'
      '   P.CODMEDCUSTO AS UNIDSALDO,'
      '   NF.NOME'#9
      'FROM'
      '   SOLICOMP S,'
      '   ITEMSOLI I, '
      '   ARTIGO A,'
      '   PRODUTO P,'
      '   GRUPPROD G,'
      '   SALDO SA,'
      '   ( SELECT  '
      '          I.CODARTIGO,'
      '          I.VLRUNITARIO,'
      '          P.NOME,'
      '          N.DATAENTDEVOL'
      '     FROM'
      '          PESSOA P,'
      '          NFRECEBDEVOL N,'
      '          ITENSRECEBDEVOL I, '
      '          ( SELECT '
      '               MAX(IDITENSRECDEV),'
      '               CODARTIGO'
      #9#9'FROM '
      '               ITENSRECEBDEVOL  '
      '            GROUP BY CODARTIGO ) AUX'
      '     WHERE'
      '          (I.CODARTIGO = AUX.CODARTIGO)'
      '      AND (N.IDNFRECEBDEVOL = I.IDNFRECEBDEVOL) '
      '      AND (P.IDPESSOA = N.IDFORCLI) '
      '     ) NF'
      'WHERE (1=2) and'
      '      (S.IMPRESSO = '#39'N'#39')'
      '  AND (S.FLGPREPRONTA = '#39'S'#39')    '
      '  AND (P.CODGRUPOPROD = G.CODGRUPOPROD)'
      '  AND (A.CODPRODUTO = P.CODPRODUTO)'
      '  AND (S.NUMSOLCOMPRA = I.NUMSOLCOMPRA)'
      '  AND (I.CODARTIGO = A.CODARTIGO)'
      '  AND (I.CODARTIGO = SA.CODARTIGO)'
      '  AND (S.CODALMOXARIFADO = SA.CODALMOXARIFADO)'
      '  AND (I.CODARTIGO = NF.CODARTIGO(+))'
      'ORDER BY'
      '   G.CODGRUPOPROD, DESCRICAO')
    ValidateWithMask = True
    Left = 388
    Top = 88
  end
