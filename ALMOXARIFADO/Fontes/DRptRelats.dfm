  object qryLivroInvent: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '      AL.CODALMOXARIFADO,'
      '      AL.DESCALMOX,'
      '      AR.CODARTIGO,'
      '      PR.CODGRUPOPROD,'
      '      PR.DESCPROD,'
      '      PR.CODMEDCUSTO,'
      '      PR.CODFISCALPADRAO,'
      '      GP.DESCGRUPOPROD,'
      '      SA.SALDOQTDE,'
      '      CM.CUSTOMEDIO,'
      '      (SA.SALDOQTDE * CM.CUSTOMEDIO) AS VALTOTAL'
      'FROM'
      '     SALDO SA,'
      '     CUSTOMED CM,'
      '     ARTIGO AR,'
      '     PRODUTO PR,'
      '     GRUPPROD GP,'
      '     ALMOX AL'
      'WHERE (1=2) and'
      '      (SA.IDPESSOA = 1 )'
      '  AND (AR.CODPRODUTO = PR.CODPRODUTO)'
      '  AND (AR.CODARTIGO  = SA.CODARTIGO)'
      '  AND (AR.CODARTIGO  = CM.CODARTIGO)'
      '  AND (GP.CODGRUPOPROD= PR.CODGRUPOPROD)'
      '  AND (AL.CODALMOXARIFADO = SA.CODALMOXARIFADO)'
      '  AND (AL.CODCUSTEIO '#9'  = CM.CODCUSTEIO )'
      'ORDER BY'
      '       AL.DESCALMOX, PR.CODGRUPOPROD, PR.DESCPROD'
      ''
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 28
    Top = 371
  end
