    Top = 25
  end
  object dsPlanInventGrp: TwwDataSource
    DataSet = qryPlanInventGrp
    Left = 675
    Top = 12
  end
  object qryPlanInventGrp: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select /*+ rule */'
      '   I.IdInventario,'
      '   I.DataInventario, '
      '   D.CodArtigo,'
      '   S.Localizacao,'
      '   P.CodGrupoProd,'
      '   P.CODMEDCUSTO, '
      '   G.DescGrupoProd,'
      
        '   (P.DescProd || '#39' '#39' || A.CodTamanho || '#39' '#39' || A.CodCor) as Des' +
        'cricao '
      'From'
      '   Inventar I,'
      '   QtdeCont D,'
      '   Produto P,'
      '   GrupProd G,'
      '   Artigo A,'
      '   Saldo S'#9' '
      'Where (1=2) and'
      '   I.AbertoFechado <> '#39'F'#39
      '   And I.idInventario = D.idInventario'
      '   And A.CodArtigo = D.CodArtigo '
      '   And A.CodArtigo = S.CodArtigo(+) '
      '   And P.CodGrupoProd =  G.CodGrupoProd   '
      '   And P.CodProduto =  A.CodProduto'
      '')
    ValidateWithMask = True
    Left = 674
    Top = 65535
  end
