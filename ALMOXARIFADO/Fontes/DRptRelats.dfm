  object qryInventFFHoje: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '     UN.CodGrupoProd,'
      '     UN.DescGrupoProd,'
      '     UN.StatusGrupo,'
      '     UN.CODARTIGO, '
      '     UN.DESCPROD,  '
      '     UN.CodMedCusto,  '
      '     UN.QTDE,    '
      '     UN.TOTAL'
      'FROM'
      '('
      'SELECT'
      '     P.CodGrupoProd,'
      '     G.DescGrupoProd,'
      '     G.StatusGrupo,'
      '     S.CODARTIGO,'
      '     P.DESCPROD,'
      '     P.CodMedCusto,'
      
        '     DECODE(MOV.SALDOQTDEMOV,NULL,S.SALDOQTDE, MOV.SALDOQTDEMOV)' +
        ' AS QTDE,'
      '     (0) AS TOTAL'#9
      'FROM'
      '    Saldo S,'
      '    CustoMed C,'
      '    Produto P,'
      '    GrupProd G,'
      '   ( Select'
      '          M.idMov,'
      '          M.CodArtigo,    '
      '          M.SALDOQTDEMOV  '
      '      From'
      '         Moviment M,'
      '         ( Select CodArtigo, Max(idMov) as idMov'
      '           From Moviment'
      '           Where (DataMov <= To_Date('#39'20/04/1999'#39','#39'dd/mm/yyyy'#39'))'
      '             And ( CodAlmoxarifado =2)'
      '           Group By CodArtigo ) Aux'
      '    Where'
      '          (M.CodArtigo = Aux.CodArtigo)'
      '      And (M.IdMov = Aux.IdMov) ) Mov  '
      'WHERE'
      '     (S.CodAlmoxarifado = 2)'
      ' And (C.CodCusteio = 1)   '
      ' And (S.idPessoa = 1) '
      ' And ((S.SaldoQtde <> 0 ) Or (Mov.SALDOQTDEMOV <> 0)) '
      ' And (RTRIM(Substr(S.CodArtigo,1,6)) = RTRIM(P.CodProduto))'
      ' And (C.CodArtigo = S.CodArtigo)'
      ' And (S.CodArtigo = Mov.CodArtigo(+))'
      ' And (G.CodGrupoProd = P.CodGrupoProd) '
      'UNION'
      'SELECT '
      '     G.CodGrupoProd,'
      '     G.DescGrupoProd,'
      '     G.StatusGrupo,'
      '   ('#39#39') AS CODARTIGO, '
      '   ('#39#39') AS DESCPROD,  '
      '   ('#39#39') AS CodMedCusto,  '
      '   (0)  AS QTDE,    '
      '   SUM(QTDE) AS TOTAL '
      'FROM '
      '    GRUPPROD G,'
      '    ( SELECT'
      '           P.CodGrupoProd,'
      '           MOV.SALDOQTDEMOV As QTDE   '
      '      FROM'
      #9'      Saldo S,'
      '            CustoMed C,'
      '            Produto P,'
      '     ( Select'
      '            P.CodGrupoProd,'
      '            M.CodArtigo,    '
      '            M.SALDOQTDEMOV'
      '        From'
      '            Moviment M,'
      '            Produto P, '
      '           ( Select CodArtigo, Max(idMov) as idMov'
      '             From Moviment'
      
        '             Where (DataMov <= To_Date('#39'20/04/1999'#39','#39'dd/mm/yyyy'#39 +
        '))'
      '               And ( CodAlmoxarifado =2)'
      '            Group By CodArtigo ) Aux'
      '        Where'
      '             (M.CodArtigo = Aux.CodArtigo)'
      '         and (SUBSTR(M.CodArtigo,1,6) = P.CODPRODUTO ) '
      '         And (M.IdMov = Aux.IdMov) ) Mov  '
      '    WHERE'
      '         (S.CodAlmoxarifado = 2)'
      '     And (C.CodCusteio = 1)   '
      '     And (S.idPessoa = 1) '
      '     And ((S.SaldoQtde <> 0 ) Or (Mov.SALDOQTDEMOV <> 0)) '
      '     And (RTRIM(Substr(S.CodArtigo,1,6)) = RTRIM(P.CodProduto))'
      '     And (C.CodArtigo = S.CodArtigo)'
      '     And (S.CodArtigo = Mov.CodArtigo(+)) ) TOT '
      'WHERE'
      '      (G.STATUSGRUPO = '#39'S'#39')'
      
        '  AND (G.CODGRUPOPROD LIKE SUBSTR(RTRIM(TOT.CODGRUPOPROD),1,2) |' +
        '| '#39'%'#39')'
      '  AND (LENGTH(RTRIM(G.CODGRUPOPROD)) <= 2)'
      'GROUP BY G.CODGRUPOPROD,G.DescGrupoProd,G.StatusGrupo'
      ') UN'
      'WHERE (1=2) '
      'Order By UN.CodGrupoProd, UN.DescProd  '
      ''
      '')
    ValidateWithMask = True
    Left = 586
    Top = 202
  end
