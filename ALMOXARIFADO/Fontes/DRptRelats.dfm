  object qryConsMed: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '        G.CODGRUPOPROD,'
      '        G.DESCGRUPOPROD,'
      '        A.CODARTIGO,'
      '        P.CODMEDCUSTO,'
      
        '        (P.DESCPROD || '#39' '#39' || A.CODCOR || '#39' '#39' || A.CODTAMANHO ) ' +
        'AS DESCRICAO,'
      '        CM.CONSMED,'
      '        CM.CONSTOT,'
      '        SAT.SALDOATU,'
      '        SAN.SALDOANT,'
      
        '        DECODE(CM.CONSMED,0,0,(SAT.SALDOATU/CM.CONSMED)) AS COBE' +
        'RTURA,'
      
        '        DECODE(CM.CONSTOT,0,0,(62*(((SAT.SALDOATU+SAN.SALDOANT)/' +
        '2)/CM.CONSTOT))) AS GIRO'
      'FROM'
      '       ARTIGO A,'
      '       PRODUTO P,'
      '       GRUPPROD G,'
      '       (SELECT'
      '                M.CODARTIGO,'
      '            (SUM(QTDEMOV)* -1)/(62) AS CONSMED,'
      '            (SUM(QTDEMOV)* -1) AS CONSTOT'
      '        FROM'
      '            MOVIMENT M'
      '        WHERE'
      '                  (M.CODALMOXARIFADO = 2)'
      '         AND (M.CODTIPOMOV <> '#39'A'#39')'
      '         AND (M.CODTIPOMOV <> '#39'K'#39')'
      '         AND (M.DATAMOV >= TO_DATE('#39'01/04/1999'#39','#39'dd/mm/yyyy'#39'))'
      '         AND (M.DATAMOV <= TO_DATE('#39'01/06/1999'#39','#39'dd/mm/yyyy'#39'))'
      '       GROUP BY M.CODARTIGO ) CM,'
      '       (SELECT'
      '                M.CODARTIGO,'
      '                M.SALDOQTDEMOV AS SALDOATU '
      '        FROM'
      '            MOVIMENT M, '
      '            (SELECT M.CODARTIGO,MAX(M.IDMOV) AS IDMOV FROM '
      
        '                            MOVIMENT M, (SELECT CODARTIGO, MAX(D' +
        'ATAMOV) AS DATAMOV '
      
        '                                                       FROM MOVI' +
        'MENT WHERE (DATAMOV <= TO_DATE('#39'01/06/1999'#39','#39'DD/MM/YYYY'#39') ) AND '
      
        '                                                                ' +
        '                                       (CODALMOXARIFADO = 2)'
      
        '                                                       GROUP BY ' +
        'CODARTIGO) AUX '
      '              WHERE (M.CODARTIGO = AUX.CODARTIGO) AND '
      '                             (M.DATAMOV = AUX.DATAMOV) AND '
      
        '                             (M.CODALMOXARIFADO = 2) GROUP BY M.' +
        'CODARTIGO ) AUX1'
      '        WHERE'
      '                  (M.CODALMOXARIFADO = 2)'
      '         AND (M.IDMOV = AUX1.IDMOV) '
      '         AND (M.CODARTIGO = AUX1.CODARTIGO) ) SAT,'
      '       (SELECT '
      '                M.CODARTIGO,'
      '                M.SALDOQTDEMOV AS SALDOANT '
      '        FROM'
      '            MOVIMENT M,'
      '            (SELECT M.CODARTIGO,MAX(M.IDMOV) AS IDMOV FROM '
      
        '                            MOVIMENT M, (SELECT CODARTIGO, MAX(D' +
        'ATAMOV) AS DATAMOV '
      
        '                                                       FROM MOVI' +
        'MENT WHERE (DATAMOV < TO_DATE('#39'01/04/1999'#39','#39'DD/MM/YYYY'#39') ) AND '
      
        '                                                                ' +
        '                                       (CODALMOXARIFADO = 2)'
      
        '                                                       GROUP BY ' +
        'CODARTIGO) AUX '
      '              WHERE (M.CODARTIGO = AUX.CODARTIGO  ) AND '
      '                             (M.DATAMOV = AUX.DATAMOV) AND '
      
        '                             (M.CODALMOXARIFADO = 2)  GROUP BY M' +
        '.CODARTIGO ) AUX1'
      '        WHERE'
      '                  (M.CODALMOXARIFADO = 2)'
      '         AND (M.IDMOV = AUX1.IDMOV) '
      '         AND (M.CODARTIGO = AUX1.CODARTIGO) ) SAN'
      'WHERE (1=2) and'
      '             (A.CODPRODUTO  = P.CODPRODUTO)'
      '    AND (P.CODGRUPOPROD = G.CODGRUPOPROD)'
      '    AND (A.CODARTIGO = CM.CODARTIGO)  '
      '    AND (A.CODARTIGO = SAN.CODARTIGO)  '
      '    AND (A.CODARTIGO = SAT.CODARTIGO)  '
      'ORDER BY G.CODGRUPOPROD, A.CODARTIGO'
      '')
    ValidateWithMask = True
    Left = 196
    Top = 116
  end
