  object dsContInvent: TwwDataSource
    DataSet = qryContInvent
    Left = 509
    Top = 10
  end
  object qryContInvent: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      ' SELECT /*+ rule */ '
      '      I.IdInventario,   '
      '      I.DataInventario, '
      '      G.CODGRUPOPROD,'
      '      G.DESCGRUPOPROD,'
      '      D.CodArtigo,      '
      '      D.QtdeContada,    '
      '      D.DiferencaAtual, '
      '      D.SaldoInicial,   '
      
        '      Decode(D.IdMov,NULL,(D.SaldoInicial * C.CustoMedio),(D.Sal' +
        'doInicial * M.CustoMedioMov)) as ValInicial, '
      
        '      Decode(D.IdMov,NULL,(D.QtdeContada * C.CustoMedio),(D.Qtde' +
        'Contada * M.CustoMedioMov)) as ValContada,   '
      
        '      Decode(D.IdMov,NULL,(D.DiferencaAtual * C.CustoMedio),(D.D' +
        'iferencaAtual * M.CustoMedioMov)) as ValDiferenca, '
      '      S.Localizacao,    '
      
        '      (P.DescProd || '#39' '#39' || A.CodTamanho || '#39' '#39' || A.CodCor) as ' +
        'Descricao '
      ' FROM              '
      '      Inventar I,  '
      '      ResCont D,   '
      '      Produto P,   '
      '      Artigo A,    '
      '      Saldo S,     '
      '      CustoMed C,  '
      '      GrupProd G, '
      '      Moviment M   '
      ' WHERE  (1=2) and           '
      '          (I.ContagemEncerrada = '#39'F'#39')       '
      '      And (D.DiferencaAtual <>  0)        '
      '      And (D.DiferencaAtual is Not Null)  '
      '      And (S.CodAlmoxarifado = 2)'
      '      And (I.CodAlmoxarifado = 2)'
      '      And (I.IdPessoa = 1)'
      '      And (S.IdPessoa = 1)'
      '      And (C.CODCUSTEIO = 1)'
      '      And (I.idInventario = 63)'
      '      And (I.idInventario = D.idInventario) '
      '      And (A.CodArtigo = D.CodArtigo)       '
      '      And (A.CodArtigo = C.CodArtigo)       '
      '      And (A.CodArtigo = S.CodArtigo(+))    '
      '      And (P.CodProduto =  A.CodProduto)    '
      '      And (G.CODGRUPOPROD = P.CODGRUPOPROD) '
      '      And (M.IdMov(+) =  D.IdMov)           '
      ' Order By I.IdInventario, D.CodArtigo '
      '')
    ValidateWithMask = True
    Left = 508
    Top = 65534
  end
