  object qryCustAnali: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */ '
      '     G.CODGRUPOPROD, '
      '     G.DESCGRUPOPROD,'
      '     M.CODCENTROCUSTO, '
      '     M.CODARTIGO,'
      
        '     (P.DESCPROD || '#39' '#39' || AR.CODCOR || '#39' '#39' || AR.CODTAMANHO ) A' +
        'S DESCRICAO,'
      '     C.NOME,'
      '     SUM(M.VALORMOV)*-1 AS VALORMOV,'
      '     SUM(QTDEMOV)*-1 AS QTDEMOV,'
      '     P.CODMEDCUSTO,'
      '     ( (SUM(M.VALORMOV)*-1)/TOTGRP.TOTCC * 100 ) AS PERCGRP,'
      '     ( TOTGRP.TOTCC/TOT.TOTAL * 100 ) AS PERCCC,'
      '     TOTGRP.TOTCC,'
      '     TOT.TOTAL '
      'FROM '
      '     MOVIMENT M, '
      '     ALMOX A,  '
      '     PRODUTO P,  '
      '     ALMOX T, '
      '     GRUPPROD G,'
      '     CENTCUST C,'
      '     ARTIGO AR,'
      '     ('
      '       SELECT '
      '           M.CODCENTROCUSTO, '
      '           SUM(M.VALORMOV)*-1 AS TOTCC '
      #9'FROM '
      #9'     MOVIMENT M, '
      #9'     ALMOX A,  '
      #9'     PRODUTO P,  '
      #9'     ALMOX T '
      #9'WHERE'
      #9'     (M.CODTIPOMOV <> '#39'A'#39') '
      #9' AND (M.CODTIPOMOV <> '#39'K'#39')'
      #9' AND (M.CODTIPOMOV <> '#39'Z'#39')'
      
        #9' AND (M.DATAMOV BETWEEN TO_DATE('#39'14/07/1999'#39','#39'DD/MM/YYYY'#39') AND ' +
        'TO_DATE('#39'14/07/1999'#39','#39'DD/MM/YYYY'#39')) '
      #9' AND (M.IDPESSOA = 1)'
      #9' AND (A.CONTABIL = '#39'T'#39') '
      #9' AND (M.CODALMOXARIFADO = A.CODALMOXARIFADO) '
      #9' AND (M.CODALMOXTRANSF = T.CODALMOXARIFADO(+)) '
      
        '       AND ( (M.CODALMOXTRANSF IS NULL) OR                      ' +
        '                  '
      
        '           ((M.CODALMOXTRANSF IS NOT NULL) AND ( A.CODCUSTEIO <>' +
        ' T.CODCUSTEIO)    '
      '       AND ((T.CONTABIL <> '#39'T'#39') OR (T.CONTABIL IS NULL))))'
      #9' AND (SUBSTR(M.CODARTIGO,1,6) = P.CODPRODUTO) '
      #9'GROUP BY M.CODCENTROCUSTO'
      '     ) TOTGRP,'
      '     ('
      '      SELECT '
      '           SUM(M.VALORMOV)*-1 AS TOTAL'
      #9'FROM '
      #9'     MOVIMENT M, '
      #9'     ALMOX A,  '
      #9'     PRODUTO P,  '
      #9'     ALMOX T '
      #9'WHERE '
      #9'     (M.CODTIPOMOV <> '#39'A'#39') '
      #9' AND (M.CODTIPOMOV <> '#39'K'#39')'
      #9' AND (M.CODTIPOMOV <> '#39'Z'#39')'
      
        #9' AND (M.DATAMOV BETWEEN TO_DATE('#39'14/07/1999'#39','#39'DD/MM/YYYY'#39') AND ' +
        'TO_DATE('#39'14/07/1999'#39','#39'DD/MM/YYYY'#39')) '
      #9' AND (M.IDPESSOA = 1)'
      #9' AND (A.CONTABIL = '#39'T'#39') '
      #9' AND (M.CODALMOXARIFADO = A.CODALMOXARIFADO) '
      #9' AND (M.CODALMOXTRANSF = T.CODALMOXARIFADO(+)) '
      
        '       AND ( (M.CODALMOXTRANSF IS NULL) OR                      ' +
        '                  '
      
        '           ((M.CODALMOXTRANSF IS NOT NULL) AND ( A.CODCUSTEIO <>' +
        ' T.CODCUSTEIO)    '
      '       AND ((T.CONTABIL <> '#39'T'#39') OR (T.CONTABIL IS NULL))))'
      #9' AND (SUBSTR(M.CODARTIGO,1,6) = P.CODPRODUTO) '
      '     ) TOT'
      'WHERE (1=2) and'
      '     (M.CODTIPOMOV <> '#39'A'#39') '
      ' AND (M.CODTIPOMOV <> '#39'K'#39')'
      ' AND (M.CODTIPOMOV <> '#39'Z'#39')'
      
        ' AND (M.DATAMOV BETWEEN TO_DATE('#39'14/07/1999'#39','#39'DD/MM/YYYY'#39') AND T' +
        'O_DATE('#39'14/07/1999'#39','#39'DD/MM/YYYY'#39')) '
      ' AND (M.IDPESSOA = 1)'
      ' AND (A.CONTABIL = '#39'T'#39') '
      ' AND (M.CODALMOXARIFADO = A.CODALMOXARIFADO) '
      ' AND (M.CODALMOXTRANSF = T.CODALMOXARIFADO(+)) '
      
        ' AND ( (M.CODALMOXTRANSF IS NULL) OR                            ' +
        '            '
      
        '     ((M.CODALMOXTRANSF IS NOT NULL) AND ( A.CODCUSTEIO <> T.COD' +
        'CUSTEIO)    '
      ' AND ((T.CONTABIL <> '#39'T'#39') OR (T.CONTABIL IS NULL))))'
      ' AND (M.CODARTIGO = AR.CODARTIGO) '
      ' AND (AR.CODPRODUTO = P.CODPRODUTO)'
      ' AND (P.CODGRUPOPROD = G.CODGRUPOPROD)'
      ' AND (M.CODCENTROCUSTO = C.CODCENTROCUSTO)'
      ' AND (M.IDEMPRESA = C.IDEMPRESA)'
      ' AND (M.CODCENTROCUSTO = TOTGRP.CODCENTROCUSTO)'
      'GROUP BY '
      '     G.CODGRUPOPROD, '
      '     G.DESCGRUPOPROD,'
      '     M.CODCENTROCUSTO,'
      '     C.NOME,'
      '     M.CODARTIGO,'
      '     P.CODMEDCUSTO,'
      '     (P.DESCPROD || '#39' '#39' || AR.CODCOR || '#39' '#39' || AR.CODTAMANHO ),'
      '     TOTGRP.TOTCC,'
      '     TOT.TOTAL '
      'ORDER BY M.CODCENTROCUSTO,'
      '         G.CODGRUPOPROD,'
      '         DESCRICAO'
      ''
      ' ')
    ValidateWithMask = True
    Left = 592
  end
