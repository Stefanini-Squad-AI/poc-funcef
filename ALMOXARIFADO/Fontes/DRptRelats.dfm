  object qryExtMovSint: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '      G.CODGRUPOPROD,'
      '      G.DESCGRUPOPROD,'
      '      M.CODARTIGO,'
      '      P.DESCPROD,'
      '      P.CODMEDCUSTO, '
      
        '      (Decode (Sign(M.ValorMov), 1,SUM(M.ValorMov) ) )   as ValE' +
        'ntrada,'
      
        '      (Decode (Sign(M.ValorMov), -1,SUM(M.ValorMov)*(-1) ) ) as ' +
        'ValSaida,'
      
        '      (Decode (Sign(M.QTDEMOV), 1,SUM(M.QTDEMOV) ) )   as QTDEnt' +
        'rada,'
      
        '      (Decode (Sign(M.QTDEMOV), -1,SUM(M.QTDEMOV)*(-1) ) ) as QT' +
        'DSaida,'
      '      S.SALDOQTDE,'
      '      (0) as SALDOVALORANT,'
      '      (0) as SALDOQTDEANT'
      'FROM'
      '    MOVIMENT M,'
      '    SALDO S, '
      '    PRODUTO P,'
      '    GRUPPROD G'
      'WHERE (1=2) and'
      '       (M.CODALMOXARIFADO = 2)'#9' '
      '   AND (S.CODALMOXARIFADO = 2)'#9' '
      '   AND (SUBSTR(M.CODARTIGO,1,6) = P.CODPRODUTO) '
      '   AND (P.CODGRUPOPROD = G.CODGRUPOPROD)'
      '   AND (M.CODARTIGO = S.CODARTIGO)'
      'GROUP BY'
      '      G.CODGRUPOPROD,'
      '      G.DESCGRUPOPROD,'
      #9'M.CODARTIGO,'
      '      P.DESCPROD,'
      '      M.VALORMOV,'
      '      M.QTDEMOV,'
      '      P.CODMEDCUSTO,'
      '      S.SALDOQTDE'
      ''
      ' '
      '       '
      '          ')
    ValidateWithMask = True
    Left = 294
    Top = 207
  end
  object dsExtMovSint: TwwDataSource
    DataSet = qryExtMovSint
    Left = 294
    Top = 194
  end
