  object bdeSugestComp: TppBDEPipeline
    DataSource = dsSugestComp
    UserName = 'bdeSugestComp'
    Left = 284
    Top = 113
  end
  object dsSugestComp: TwwDataSource
    DataSet = qrySugestComp
    Left = 284
    Top = 101
  end
  object qrySugestComp: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */ '
      '     I.IDANALISEESTOQUE,'
      '     A.CODARTIGO,'
      
        '     P.DESCPROD || '#39#39' || RTRIM(A.CODCOR, '#39' '#39' ) ||'#39' '#39'|| RTRIM(A.C' +
        'ODTAMANHO,'#39' '#39') AS PRODUTO,'
      
        '     DECODE(FLGTEMPMEDCALC,'#39'S'#39',TRMEDCALCULADO,TRMEDINFORMADO) AS' +
        ' TEMPOMED,'
      
        '     DECODE(FLGCONSMEDCALC,'#39'S'#39',CONSMEDCALCULADO,CONSMEDINFORMADO' +
        ') AS CONSMED,'
      
        '     DECODE(FLGPONTOREPCALC,'#39'S'#39',PONTOREPCALCULADO,PONTOREPINFORM' +
        'ADO) AS PONTOREP,'
      
        '     DECODE(FLGQTDEMINCALC,'#39'S'#39',QTDEMINCALCULADA,QTDEMININFORMADA' +
        ') AS QTDEMIN,'
      '     I.QTDESUGAUTO,'
      '     I.QTDESUGCALCULADA,'
      '     I.QTDECOMPRAR,'
      '     I.SALDOESTOQUE,'
      '     P.CODMEDCUSTO'
      'FROM '
      '    ITEMANALISEESTOQ I,'
      '    ARTIGO A,'
      '    PRODUTO P'
      'WHERE'
      '      (I.IDANALISEESTOQUE = :pIdAnalise)'
      '--  AND ( ( I.QTDESUGCALCULADA <> 0 ) OR (I.QTDECOMPRAR <> 0) ) '
      '  AND (I.CODARTIGO = A.CODARTIGO)'
      '  AND (A.CODPRODUTO = P.CODPRODUTO)'
      'ORDER BY PRODUTO')
    ValidateWithMask = True
    Left = 283
    Top = 88
    ParamData = <
      item
        DataType = ftInteger
        Name = 'pIdAnalise'
        ParamType = ptUnknown
      end>
  end
