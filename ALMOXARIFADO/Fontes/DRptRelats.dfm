  object updABCComp: TUpdateSQL
    ModifySQL.Strings = (
      'update MOVIMENT'
      'set'
      '  GRUPO = :GRUPO,'
      '  PERCACU = :PERCACU,'
      '  CODARTIGO = :CODARTIGO,'
      '  DESCICAO = :DESCICAO,'
      '  CODMEDCUSTO = :CODMEDCUSTO,'
      '  SALDO = :SALDO,'
      '  VALOR = :VALOR,'
      '  PERC = :PERC,'
      '  VALORTOT = :VALORTOT'
      'where'
      '  GRUPO = :OLD_GRUPO and'
      '  CODARTIGO = :OLD_CODARTIGO')
    InsertSQL.Strings = (
      'insert into MOVIMENT'
      '  (GRUPO, PERCACU, CODARTIGO, DESCICAO, CODMEDCUSTO, SALDO, '
      'VALOR, PERC, '
      '   VALORTOT)'
      'values'
      
        '  (:GRUPO, :PERCACU, :CODARTIGO, :DESCICAO, :CODMEDCUSTO, :SALDO' +
        ', '
      ':VALOR, '
      '   :PERC, :VALORTOT)')
    DeleteSQL.Strings = (
      'delete from MOVIMENT'
      'where'
      '  GRUPO = :OLD_GRUPO and'
      '  CODARTIGO = :OLD_CODARTIGO')
    Left = 681
    Top = 286
  end
