  object qrySalEstMin: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  /*+ rule */'
      '     S.CODARTIGO,'
      
        '     (P.DESCPROD || '#39' '#39' || A.CODCOR || '#39' '#39' ||  A.CODTAMANHO) AS ' +
        'DESCRICAO,'
      '     S.SALDOQTDE,'
      '     P.CODMEDCUSTO,'
      '     S.ESTMAXIMO AS ESTMAXIMO'
      'FROM'
      '    SALDO S,'
      '    PRODUTO P,'
      '    ARTIGO A'
      'WHERE (1=2) and'
      '           (S.CODALMOXARIFADO = 2 )'
      '  AND (S.SALDOQTDE > S.ESTMAXIMO) '
      '  AND (S.CODARTIGO = A.CODARTIGO )'
      '  AND (A.CODPRODUTO = P.CODPRODUTO)')
    ValidateWithMask = True
    Left = 300
    Top = 275
  end
