      object ppDBCalc36: TppDBCalc
        UserName = 'DBCalc36'
        DataField = 'VALANT'
        DataPipeline = bdeAjustFinanc
        DisplayFormat = '#,0.00;-#,0.00'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clBlack
        Font.Name = 'Arial'
        Font.Size = 8
        Font.Style = [fsBold]
        TextAlignment = taRightJustified
        Transparent = True
        DataPipelineName = 'bdeAjustFinanc'
