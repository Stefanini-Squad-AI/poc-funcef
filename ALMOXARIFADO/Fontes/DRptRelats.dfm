  object dsSoliComp: TwwDataSource
    DataSet = qrySoliComp
    Left = 683
    Top = 104
  end
  object qrySoliComp: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '      SO.NUMSOLCOMPRA,'
      '      SO.CODCENTROCUSTO,'
      '      SO.DATAENTREGA AS DATA,'
      '      SO.IMPRESSO,'
      '      SO.IDPESSOA,'
      '      IT.CODARTIGO,'
      
        '      SUBSTR(DECODE(IT.IDPRODVARI,NULL,PR.DESCPROD,PV.DESCPRODVA' +
        'RI),1,60) AS PRODUTO,'
      '      IT.QTDEPEDIDA,'
      '      IT.CODMEDIDA,'
      '      IT.OBSITEMSOLIC,'
      '      SA.SALDOQTDE,'
      '      SA.ESTMAXIMO,'
      '      IT.SALDOACOMPRAR AS SALDO,'
      '      PR.CODMEDCUSTO,'
      '      PR.CODPRODUTO,'
      '      U.DATAU,'
      '      U.FORNECEDOR,'
      '      U.QTDE ,'
      '      U.UNID,'
      '      U.PRECO,'
      '      U.PRAZO,'
      '      U.PERIDO,'
      '      CC.NOME AS CENTROCUSTO,'
      
        '      DECODE(U.PRECO,NULL,0,((((C.CUSTOMEDIO*CF.FATOR/CO.FATOR)/' +
        'U.PRECO)-1)*100)) AS PERCVAR,'
      
        '      DECODE (PR.ITEMESTOCAVEL,'#39'S'#39','#39'SIM'#39','#39'NÃO'#39') AS ITEMESTOCAVEL' +
        ','
      '      (C.CUSTOMEDIO*CF.FATOR/CO.FATOR) AS VALORUN,'
      
        '      (C.CUSTOMEDIO*CF.FATOR/CO.FATOR) * IT.QTDEPEDIDA AS VALORT' +
        'OTAL,'
      '      CM.CONSUMO'
      'FROM'
      '     SOLICOMP SO,'
      '     ITEMSOLI IT,'
      '     ARTIGO AR,'
      '     PRODUTO PR,'
      '     CUSTOMED C,'
      '     CONVER  CO,'
      '     CONVER  CF,'
      '     SALDO SA,'
      '     PRODVARI PV,'
      '     VWCONSUMO90 CM,'
      '     (SELECT'
      '           OC.DATAOC AS DATAU,'
      '           IO.CODARTIGO AS CODARTIGO,'
      '           P.RAZAOSOCIAL AS FORNECEDOR,'
      '           IO.QTDEPEDIDA AS QTDE ,'
      '           IO.CODMEDIDA AS UNID,'
      '           IO.VALORUN AS PRECO,'
      '           PG.PRAZOPGTO AS PRAZO,'
      '           PG.PERIODOPRAZO AS PERIDO'
      '      FROM'
      '         OC OC,'
      '         ITEMOC IO,'
      '         PESSOA P,'
      '         PRAZOPGTOOC PG,'
      '         (SELECT I.CODARTIGO, MAX(I.IDITEMOC) AS IDITEMOC'
      '          FROM ITEMOC I,'
      '               OC O,'
      '               (SELECT I.CODARTIGO, MAX(O.DATAOC) AS DATAOC'
      '                FROM OC O, ITEMOC I'
      '                WHERE (O.NUMOC = I.NUMOC)'
      '                GROUP BY I.CODARTIGO) D'
      '          WHERE (I.NUMOC = O.NUMOC)'
      '            AND (I.CODARTIGO = D.CODARTIGO)'
      '            AND (O.DATAOC = D.DATAOC) GROUP BY I.CODARTIGO) MA'
      '      WHERE'
      '           (OC.IDPESSOA = 1)'
      '       AND (IO.NUMOC = OC.NUMOC)'
      '       AND (IO.IDITEMOC = MA.IDITEMOC)'
      '       AND (IO.IDITEMOC = PG.IDITEMOC(+))'
      '       AND (OC.IDFORCLI = P.IDPESSOA) ) U,'
      '       CENTCUST CC'
      'WHERE (1=2) and'
      '       (SO.IDPESSOA = 1)'
      '   AND (SO.NUMSOLCOMPRA = 0)'
      '   AND (SO.IMPRESSO = '#39'F'#39')'
      '   AND (SA.CODALMOXARIFADO(+) = 1)'
      '   AND (C.CODCUSTEIO(+) = 1)'
      '   AND (CC.CODCENTROCUSTO = SO.CODCENTROCUSTO)'
      '   AND (CC.IDEMPRESA = SO.IDPESSOA)'
      '   AND (IT.NUMSOLCOMPRA = SO.NUMSOLCOMPRA)'
      '   AND (IT.CODARTIGO   = AR.CODARTIGO)'
      '   AND (AR.CODPRODUTO  = PR.CODPRODUTO)'
      '   AND (AR.CODARTIGO   = C.CODARTIGO(+))'
      '   AND (PR.CODPRODUTO  = CO.CODPRODUTO)'
      '   AND (CO.CODMEDIDA   = PR.CODMEDCUSTO)'
      '   AND (PR.CODPRODUTO  = CF.CODPRODUTO)'
      '   AND (CF.CODMEDIDA   = IT.CODMEDIDA)'
      '   AND (IT.IDPRODVARI  = PV.IDPRODVARI(+))'
      '   AND (IT.CODARTIGO   = SA.CODARTIGO(+))'
      '   AND (IT.CODARTIGO   = U.CODARTIGO(+))'
      '   AND (IT.CODARTIGO   = CM.CODARTIGO(+))'
      'ORDER BY SO.NUMSOLCOMPRA, PRODUTO'
      ''
      ' '
      ' ')
    ValidateWithMask = True
    Left = 682
    Top = 91
