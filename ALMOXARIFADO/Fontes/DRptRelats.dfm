  object qryResFinAnual: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '        ('#39'          '#39') AS CODCENTROCUSTO,'
      '        ('#39'                               '#39') AS NOME,'
      '        ('#39'          '#39') AS CODGRUPOPROD,'
      '        ('#39'                               '#39') AS DESCGRUPOPROD,'
      '        ('#39'              '#39') AS CODARTIGO,'
      
        '        ('#39'                                                  '#39')  ' +
        'AS DESCRICAO,'
      '        ('#39'     '#39') AS UNID,'
      '        (0) AS VALJAN,'
      '        (0) AS VALFEV,'
      '        (0) AS VALMAR,'
      '        (0) AS VALABR,'
      '        (0) AS VALMAI,'
      '        (0) AS VALJUN,'
      '        (0) AS VALJUL,'
      '        (0) AS VALAGO,'
      '        (0) AS VALSEB,'
      '        (0) AS VALOUT,'
      '        (0) AS VALNOV,'
      '        (0) AS VALDEZ,'
      '        (0) AS VALTOT,'
      '        (0) AS QTDEJAN,'
      '        (0) AS QTDEFEV,'
      '        (0) AS QTDEMAR,'
      '        (0) AS QTDEABR,'
      '        (0) AS QTDEMAI,'
      '        (0) AS QTDEJUN,'
      '        (0) AS QTDEJUL,'
      '        (0) AS QTDEAGO,'
      '        (0) AS QTDESEB,'
      '        (0) AS QTDEOUT,'
      '        (0) AS QTDENOV,'
      '        (0) AS QTDEDEZ,'
      '        (0) AS QTDETOT'
      'FROM'
      '        MOVIMENT'
      'WHERE'
      '       (1=2)')
    UpdateObject = updResFinAnual
    ValidateWithMask = True
    Left = 212
    Top = 275
