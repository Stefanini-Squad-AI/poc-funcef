  object qryTermoInvent: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '     A.CODARTIGO,'
      '     P.CODMEDCUSTO,'
      
        '     (P.DESCPROD || '#39' '#39' || A.CODTAMANHO || '#39' '#39' || A.CODCOR) AS D' +
        'ESCRICAO,'
      '     DECODE(CM.SALDO,NULL,0,CM.SALDO) AS SALDO,'
      '     DECODE(CM.VALOR,NULL,0,CM.VALOR) AS VALOR'
      'FROM'
      '    ARTIGO A,'
      '    PRODUTO P,'
      '    ( SELECT  '
      '         CODARTIGO,'
      '         SUM(SALDOQTDEUC) AS SALDO,'
      '         SUM(CUSTOMEDIO) * SUM(SALDOQTDEUC) AS VALOR'
      '      FROM'
      '        CUSTOMED '
      '      GROUP BY CODARTIGO'
      '     ) CM'
      'WHERE  (1=2) and   '
      '     (A.CODPRODUTO = P.CODPRODUTO)'
      ' AND (A.CODARTIGO   = CM.CODARTIGO(+))'
      'ORDER BY '
      '     (P.DESCPROD || '#39' '#39' || A.CODTAMANHO || '#39' '#39' || A.CODCOR)'
      '')
    ValidateWithMask = True
    Left = 556
    Top = 275
  end
