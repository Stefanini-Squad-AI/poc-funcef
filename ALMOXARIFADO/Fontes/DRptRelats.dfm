  object dsEtqProduto: TwwDataSource
    DataSet = qryEtqProduto
    Left = 404
    Top = 385
  end
  object qryEtqProduto: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  /*+ rule */'
      '   A.CODARTIGO,'
      '   P.CODGRUPOPROD,'
      '   P.CODMEDCUSTO,'
      '   G.DESCGRUPOPROD,'
      '   S.ESTMINUSADO,'
      '   S.ESTMAXIMO,'
      
        '   (P.DESCPROD || '#39' '#39' || A.CODTAMANHO || '#39' '#39' || A.CODCOR) AS DES' +
        'CRICAO'
      'FROM'
      '   SALDO S,'
      '   PRODUTO P,'
      '   ARTIGO A,'
      '   GRUPPROD G'
      'WHERE'
      '       (S.CODALMOXARIFADO = 2)'
      '   AND (A.CODARTIGO =  S.CODARTIGO)'
      '   AND (P.CODGRUPOPROD =  G.CODGRUPOPROD)'
      '   AND (P.CODPRODUTO =  A.CODPRODUTO)'
      'ORDER BY DESCRICAO'
      ' '
      ' ')
    ValidateWithMask = True
    Left = 404
    Top = 370
  end
