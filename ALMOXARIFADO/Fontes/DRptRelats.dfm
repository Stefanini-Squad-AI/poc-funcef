    DataSet = qryRecMercDesemb
    Left = 196
    Top = 385
  end
  object qryRecMercDesemb: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  /*+RULE*/'
      '    IT.CODTIPRECDES,'
      '    TD.DESCRICAO,'
      '    SUM(NF.VLRNOTAFISCAL)'
      'FROM'
      '    ITENSRECEBDEVOL IT,'
      '    NFRECEBDEVOL NF,'
      '    TIPORECEBDESEMB TD'
      'WHERE (1=2) and'
      '      (IT.RECPAG = '#39'P'#39')'
      '  AND (IT.IDPESSOA = 1)'
      '  AND (IT.CODTIPRECDES = TD.CODTIPRECDES)'
      '  AND (IT.IDPESSOA = TD.IDPESSOA)'
      '  AND (IT.IDNFRECEBDEVOL = NF.IDNFRECEBDEVOL)'
      '  AND (TD.ATIVO = '#39'S'#39')'
      'GROUP BY'
      '    IT.CODTIPRECDES,'
      '    TD.DESCRICAO'
      'ORDER BY TD.DESCRICAO'
      ' ')
    ValidateWithMask = True
    Left = 196
    Top = 371
  end
