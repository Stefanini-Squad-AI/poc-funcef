  object qryUltForn: TwwQuery
    DatabaseName = 'BaseDados'
    DataSource = dsSoliComp
    SQL.Strings = (
      'SELECT'
      '      P.RAZAOSOCIAL AS FORNECEDOR,'
      '      MAX(OC.DATAOC) AS DATAOC,'
      
        '      MAX('#39'Tel. ('#39' ||RTRIM(T.DDD) ||'#39')  '#39'|| RTRIM(T.NUMERO) ) AS' +
        ' TELEFONE'
      'FROM'
      '   OC OC,'
      '   ITEMOC IO,'
      '   PESSOA P,'
      '   TELENDPESS T,'
      '  ( SELECT CODARTIGO'
      '    FROM ITEMSOLI'
      '    WHERE(NUMSOLCOMPRA = :NUMSOLCOMPRA) ) AR'
      'WHERE'
      '      (IO.CODARTIGO = AR.CODARTIGO)'
      '  AND (OC.IDPESSOA = :IDPESSOA)'
      '  AND (IO.NUMOC = OC.NUMOC)'
      '  AND (OC.IDFORCLI = P.IDPESSOA)'
      '  AND (T.TIPO LIKE '#39'%C%'#39')'
      '  AND (P.IDENDCOMERCIAL = T.IDENDERECO(+))'
      'GROUP BY P.RAZAOSOCIAL'
      'ORDER BY DATAOC DESC'
      '')
    ValidateWithMask = True
    Left = 832
    Top = 128
    ParamData = <
      item
        DataType = ftFloat
        Name = 'NUMSOLCOMPRA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
    object qryUltFornFORNECEDOR: TStringField
      FieldName = 'FORNECEDOR'
      Size = 60
    end
    object qryUltFornTELEFONE: TStringField
      FieldName = 'TELEFONE'
      Size = 34
    end
    object qryUltFornDATAOC: TDateTimeField
      FieldName = 'DATAOC'
    end
  end
