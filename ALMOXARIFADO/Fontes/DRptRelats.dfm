  object dsTotFinanc: TwwDataSource
    DataSet = qryTotFinanc
    Left = 476
    Top = 289
  end
  object qryTotFinanc: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      ' SELECT  /*+ rule */'
      
        '     A.CODALMOXARIFADO,                                         ' +
        '                   '
      '     A.DESCALMOX,'
      '     DECODE(VALANT.VALANT,NULL,0,VALANT.VALANT) AS VALANT,'
      
        '     DECODE(VALCOMPRA.VALCOMPRA,NULL,0,VALCOMPRA.VALCOMPRA) AS V' +
        'ALCOMPRA,'
      '     DECODE(VALREQ.VALREQ,NULL,0,VALREQ.VALREQ) AS VALREQ,'
      '     (DECODE(VALANT.VALANT,NULL,0,VALANT.VALANT)+'
      '     DECODE(VALCOMPRA.VALCOMPRA,NULL,0,VALCOMPRA.VALCOMPRA) -'
      '     DECODE(VALREQ.VALREQ,NULL,0,VALREQ.VALREQ) -'
      '     DECODE(VALATU.VALATUAL,NULL,0,VALATU.VALATUAL) ) AS AJUSTE,'
      '     DECODE(VALATU.VALATUAL,NULL,0,VALATU.VALATUAL) AS VALATUAL'
      ' FROM'
      '     ALMOX A,'
      '     (SELECT'
      '          VA.CODALMOXARIFADO,'
      '          SUM(VA.VALOR) AS VALANT'
      '     FROM'
      '     ('
      '     SELECT'
      '           M.CODALMOXARIFADO,'
      '           M.CODARTIGO,'
      '          (M.SALDOQTDEMOV * M.CUSTOMEDIOMOV) AS VALOR'
      '      FROM'
      '          MOVIMENT M,'
      '          ( SELECT'
      '      '#9'    M.CODALMOXARIFADO,'
      '                  M.CODARTIGO,'
      '                  MAX(M.IDMOV) AS IDMOV'
      '            FROM'
      '               MOVIMENT M,'
      '               ('
      '                SELECT'
      '                     CODALMOXARIFADO,'
      '                     CODARTIGO,'
      '                     MAX(DATAMOV) AS DATAMOV'
      '                FROM MOVIMENT'
      '                WHERE  (1=2) And'
      
        '                    (DATAMOV < TO_DATE('#39'01/01/2000'#39','#39'DD/MM/YYYY'#39 +
        '))'
      '                GROUP BY CODALMOXARIFADO, CODARTIGO'
      '                ) SUB1'
      '            WHERE (1=2) And'
      '                 (M.CODARTIGO       = SUB1.CODARTIGO)'
      '             AND (M.CODALMOXARIFADO = SUB1.CODALMOXARIFADO)'
      '             AND (M.DATAMOV         = SUB1.DATAMOV)'
      '             GROUP BY M.CODALMOXARIFADO, M.CODARTIGO'
      '            ) AUX'
      '      WHERE (1=2) And'
      '           (M.CODARTIGO       = AUX.CODARTIGO)'
      '       AND (M.CODALMOXARIFADO = AUX.CODALMOXARIFADO)'
      '       AND (M.IDMOV           = AUX.IDMOV)'
      '     ) VA'
      '     GROUP BY VA.CODALMOXARIFADO ) VALANT,'
      '     (SELECT'
      '          VA.CODALMOXARIFADO,'
      '          SUM(VA.VALOR) AS VALATUAL'
      '     FROM'
      '     ('
      '     SELECT'
      '           M.CODALMOXARIFADO,'
      '           M.CODARTIGO,'
      '          (M.SALDOQTDEMOV * M.CUSTOMEDIOMOV) AS VALOR'
      '      FROM'
      '          MOVIMENT M,'
      '          ( SELECT'
      '      '#9'    M.CODALMOXARIFADO,'
      '                  M.CODARTIGO,'
      '                  MAX(M.IDMOV) AS IDMOV'
      '            FROM'
      '               MOVIMENT M,'
      '               ('
      '                SELECT'
      '                     CODALMOXARIFADO,'
      '                     CODARTIGO,'
      '                     MAX(DATAMOV) AS DATAMOV'
      '                FROM MOVIMENT'
      '                WHERE (1=2) And'
      
        '                    (DATAMOV <= TO_DATE('#39'31/01/2000'#39','#39'DD/MM/YYYY' +
        #39'))'
      '                GROUP BY CODALMOXARIFADO, CODARTIGO'
      '                ) SUB1'
      '            WHERE (1=2) And'
      '                 (M.CODARTIGO       = SUB1.CODARTIGO)'
      '             AND (M.CODALMOXARIFADO = SUB1.CODALMOXARIFADO)'
      '             AND (M.DATAMOV         = SUB1.DATAMOV)'
      '             GROUP BY M.CODALMOXARIFADO, M.CODARTIGO'
      '            ) AUX'
      '      WHERE (1=2) And'
      '           (M.CODARTIGO       = AUX.CODARTIGO)'
      '       AND (M.CODALMOXARIFADO = AUX.CODALMOXARIFADO)'
      '       AND (M.IDMOV           = AUX.IDMOV)'
      '     ) VA'
      '     GROUP BY VA.CODALMOXARIFADO ) VALATU,'
      '     (SELECT'
      '           CODALMOXARIFADO,'
      '           SUM(VALORMOV) AS VALCOMPRA'
      '      FROM'
      '          MOVIMENT'
      '      WHERE  (1=2) And'
      '            (DATAMOV >= TO_DATE('#39'01/01/2000'#39','#39'DD/MM/YYYY'#39'))'
      '        AND (DATAMOV <= TO_DATE('#39'31/01/2000'#39','#39'DD/MM/YYYY'#39'))'
      
        '        AND ((CODTIPOMOV = '#39'K'#39') OR (CODTIPOMOV = '#39'A'#39') OR (CODTIP' +
        'OMOV = '#39'B'#39') OR (CODTIPOMOV = '#39'Z'#39'))'
      '      GROUP BY CODALMOXARIFADO'
      '     ) VALCOMPRA,'
      '     (SELECT'
      '           CODALMOXARIFADO,'
      '           SUM(VALORMOV)*-1 AS VALREQ'
      '      FROM'
      '          MOVIMENT'
      '      WHERE  (1=2) And'
      '            (DATAMOV >= TO_DATE('#39'01/01/2000'#39','#39'DD/MM/YYYY'#39'))'
      '        AND (DATAMOV <= TO_DATE('#39'31/01/2000'#39','#39'DD/MM/YYYY'#39'))'
      
        '        AND ((CODTIPOMOV <> '#39'K'#39') AND (CODTIPOMOV <> '#39'A'#39') AND (CO' +
        'DTIPOMOV <> '#39'Z'#39') AND (CODTIPOMOV <> '#39'B'#39'))'
      '      GROUP BY CODALMOXARIFADO'
      '     ) VALREQ'
      ' WHERE (1=2) and'
      '       (A.CODCUSTEIO = 1)'
      '   AND (A.CODALMOXARIFADO = VALANT.CODALMOXARIFADO)'
      '   AND (A.CODALMOXARIFADO = VALATU.CODALMOXARIFADO)'
      '   AND (A.CODALMOXARIFADO = VALCOMPRA.CODALMOXARIFADO(+))'
      '   AND (A.CODALMOXARIFADO = VALREQ.CODALMOXARIFADO(+))'
      ' ORDER BY A.DESCALMOX'
      '')
    ValidateWithMask = True
    Left = 476
    Top = 275
  end
