  object qryABCComp: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT /*+ rule */'
      '     '#39'A'#39' as GRUPO,'
      '     (0) AS PERCACU,'
      '      M.CODARTIGO,'
      
        '      (P.DESCPROD || '#39' '#39' || A.CODCOR || '#39' '#39' || A.CODTAMANHO) AS ' +
        'DESCICAO,'
      '      P.CODMEDCUSTO,'
      '      SUM(M.QTDEMOV) AS SALDO,'
      '      SUM(M.VALORMOV) AS VALOR,'
      '      ((SUM(M.VALORMOV)/SUB.VALORTOT)*100) AS PERC,'
      '      SUB.VALORTOT'
      'FROM'
      '     MOVIMENT M,'
      '     ARTIGO A,'
      '     PRODUTO P,'
      '     ( SELECT SUM(VALORMOV) AS VALORTOT'
      '       FROM MOVIMENT'
      '       WHERE'
      '              (CODTIPOMOV = '#39'A'#39')'
      '          AND (DATAMOV >= TO_DATE('#39'01/01/1999'#39','#39'DD/MM/YYYY'#39'))'
      '          AND (DATAMOV <= TO_DATE('#39'30/12/1999'#39','#39'DD/MM/YYYY'#39'))'
      '     ) SUB'
      'WHERE (1=2) and'
      '       (M.CODTIPOMOV = '#39'A'#39')'
      '   AND (M.DATAMOV >= TO_DATE('#39'01/01/1999'#39','#39'DD/MM/YYYY'#39'))'
      '   AND (M.DATAMOV <= TO_DATE('#39'30/12/1999'#39','#39'DD/MM/YYYY'#39'))'
      '   AND (M.CODARTIGO = A.CODARTIGO)'
      '   AND (A.CODPRODUTO = P.CODPRODUTO)'
      'GROUP BY'
      '      M.CODARTIGO,'
      #9'(P.DESCPROD || '#39' '#39' || A.CODCOR || '#39' '#39' || A.CODTAMANHO),'
      '      P.CODMEDCUSTO,'
      '     SUB.VALORTOT'
      'ORDER BY VALOR DESC')
    UpdateObject = updABCComp
    ValidateWithMask = True
    Left = 639
    Top = 299
    object qryABCCompGRUPO: TStringField
      FieldName = 'GRUPO'
      Size = 1
    end
    object qryABCCompPERCACU: TFloatField
      FieldName = 'PERCACU'
    end
    object qryABCCompCODARTIGO: TStringField
      FieldName = 'CODARTIGO'
      Size = 14
    end
    object qryABCCompDESCICAO: TStringField
      FieldName = 'DESCICAO'
      Size = 50
    end
    object qryABCCompCODMEDCUSTO: TStringField
      FieldName = 'CODMEDCUSTO'
      Size = 4
    end
    object qryABCCompSALDO: TFloatField
      FieldName = 'SALDO'
    end
    object qryABCCompVALOR: TFloatField
      FieldName = 'VALOR'
    end
    object qryABCCompPERC: TFloatField
      FieldName = 'PERC'
    end
    object qryABCCompVALORTOT: TFloatField
      FieldName = 'VALORTOT'
    end
  end
