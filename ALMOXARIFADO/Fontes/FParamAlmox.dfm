  object UpdParamRel: TUpdateSQL
    ModifySQL.Strings = (
      'update PARAMRELATS'
      'set'
      '  IDPARAMRELATS = :IDPARAMRELATS,'
      '  IDMODULO = :IDMODULO,'
      '  IDPESSOA = :IDPESSOA,'
      '  NOMECOMPO = :NOMECOMPO,'
      '  DESCRICAO = :DESCRICAO,'
      '  VALOR = :VALOR,'
      '  NOMERELATORIO = :NOMERELATORIO'
      'where'
      '  IDPARAMRELATS = :OLD_IDPARAMRELATS')
    InsertSQL.Strings = (
      'insert into PARAMRELATS'
      '  (IDPARAMRELATS, IDMODULO, IDPESSOA, NOMECOMPO, DESCRICAO, '
      'VALOR, NOMERELATORIO)'
      'values'
      
        '  (:IDPARAMRELATS, :IDMODULO, :IDPESSOA, :NOMECOMPO, :DESCRICAO,' +
        ' '
      ':VALOR, '
      '   :NOMERELATORIO)')
    DeleteSQL.Strings = (
      'delete from PARAMRELATS'
      'where'
      '  IDPARAMRELATS = :OLD_IDPARAMRELATS')
    Left = 219
    Top = 257
  end
