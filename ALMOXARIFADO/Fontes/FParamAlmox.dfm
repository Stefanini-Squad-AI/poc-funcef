  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT'
      '     IDPESSOA,'
      '     CODALTDEVOLUCAO,'
      '     CODTIPDOC,'
      '     MASCGRUPOPROD,'
      '     EXISTEDV,'
      '     EXISTECOMPRA,'
      '     RECEBAUTOMATICO,'
      '     CODTABPRODUTIL,'
      '     EXISTECONTASPAGAR,'
      '     EXISTECONTABIL,'
      '     FLGINFOVALORUN,'
      '     DATAIMPLANTA,'
      '     FLGCONTABGRUPO,'
      '     FLGCONTABTRANSF,'
      '     PERCREQMAT,'
      '     FLGINTEGRALIVRO,'
      '     PERCRECEBCOMOC,'
      '     IDPATRO,'
      '     IDPLANOPREV,'
      '     FLGUSAGRUPOREQ,'
      '     FLGREQSEMSALDO,'
      '     IDPROGRAMA    '
      'FROM'
      '     PARALMOX'
      'WHERE'
      '         (IDPESSOA = :pIDPESS)'
      ' ')
    Top = 2
    ParamData = <
      item
        DataType = ftInteger
        Name = 'pIDPESS'
        ParamType = ptUnknown
      end>
