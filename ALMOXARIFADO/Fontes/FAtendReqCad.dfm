  object qrySubGrid: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'Select '
      '       IP.CodArtigo, '
      '       IP.QTDEPEDIDA,'
      '       IP.NUMREQUISICAO,'
      '       IP.CODMEDIDA,'
      '       IP.QTDEPENDENTE '
      'From   ITEMPEDI IP,'
      '          REQMAT R'
      'Where  IP.CodArtigo  = :pArt'
      '          and  R.CODALMOXAORIGEM = :pNumAlmox'
      '          and  IP.NumRequisicao <> :pNumReq'
      '          and  IP.QtdePendente <> 0  '
      '          and  IP.NUMREQUISICAO = R.NUMREQUISICAO '
      '')
    ValidateWithMask = True
    Left = 188
    Top = 324
    ParamData = <
      item
        DataType = ftString
        Name = 'pArt'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'pNumAlmox'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'pNumReq'
        ParamType = ptUnknown
      end>
  end
