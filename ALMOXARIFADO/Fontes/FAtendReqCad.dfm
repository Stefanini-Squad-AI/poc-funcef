  object qryGrid: TwwQuery
    DatabaseName = 'BaseDados'
    Constrained = True
    SQL.Strings = (
      'Select A.CodArtigo, '
      '       P.CodMedCusto,'
      '       IP.CodMedida,'
      
        '       (P.DESCPROD || '#39' '#39' || A.CODTAMANHO || '#39' '#39' || A.CODCOR) AS' +
        ' DESCRICAO,'
      '       IP.NumRequisicao,'
      '       IP.QTDEPEDIDA,'
      '       IP.QTDEPENDENTE, '
      '       IP.VALORUN,'
      '       R.IDUSUARIOINCLUSAO, '
      '       R.CODCENTROCUSTO,         '
      '       R.CustoTransf,'
      '       R.CODALMOXADESTINO,'
      '       R.UNIDNEGOC,  '
      '       CC.NOME'
      'From   Artigo A,'
      '       Produto P,'
      '       ITEMPEDI IP,'
      '       REQMAT R,'
      '       CENTCUST CC'
      'Where  A.CodProduto     = p.CodProduto And'
      '       A.CodArtigo      = IP.CODARTIGO AND'
      '       IP.NUMREQUISICAO = R.NUMREQUISICAO AND'
      '       R.CODCENTROCUSTO = CC.CODCENTROCUSTO AND'
      '       R.IDEMPRESA = CC.IDEMPRESA '
      'Order By Descricao')
    PictureMasks.Strings = (
      
        'QTDEPEDIDA'#9'{{{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]#' +
        '[#][#]]],({{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]#[#' +
        '][#]]]),[-]{{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]#[' +
        '#][#]]]}'#9'T'#9'T'
      
        'QTDEPENDENTE'#9'{{{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-' +
        ']#[#][#]]],({{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]#' +
        '[#][#]]]),[-]{{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]' +
        '#[#][#]]]}'#9'T'#9'T'
      
        'VALORUN'#9'{{{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]#[#]' +
        '[#]]],({{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]#[#][#' +
        ']]]),[-]{{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]#[#][' +
        '#]]]}'#9'T'#9'T'
      
        'SALDOQTDE'#9'{{{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]#[' +
        '#][#]]],({{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]#[#]' +
        '[#]]]),[-]{{#[#][#]{{;.###*[;.###]},*#}[;,*#]},;,#*#}[E[[+,-]#[#' +
        '][#]]]}'#9'T'#9'T')
    ValidateWithMask = True
    Left = 98
    Top = 324
