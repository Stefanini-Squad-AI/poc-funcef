  object qryArtEleb: TwwQuery
    Tag = 5
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      ' SELECT'
      
        '       A.CODARTIGO,                                             ' +
        '          '
      
        '       P.CODMEDCUSTO,                                           ' +
        '          '
      
        '      (P.DESCPROD || '#39' '#39' || A.CODTAMANHO || '#39' '#39' || A.CODCOR) AS ' +
        'DESCRICAO '
      
        ' FROM                                                           ' +
        '          '
      
        '      ARTIGO A,                                                 ' +
        '          '
      
        '      PRODUTO P                                                 ' +
        '          '
      ' WHERE'
      
        '     (((A.FLGBLOQUEADO <> '#39'R'#39') AND (A.FLGBLOQUEADO <> '#39'A'#39')) OR (' +
        'A.FLGBLOQUEADO IS NULL))'
      ' AND (A.FLGATIVO = '#39'S'#39')'
      ' AND (A.CODPRODUTO = P.CODPRODUTO)'
      ' ORDER BY DESCRICAO'
      ' ')
    ValidateWithMask = True
    Left = 427
    Top = 316
    object StringField1: TStringField
      FieldName = 'CODARTIGO'
      Origin = 'ARTIGO.CODARTIGO'
      Size = 14
    end
    object StringField2: TStringField
      FieldName = 'CODMEDCUSTO'
      Origin = '"CM.PRODUTO".CODMEDCUSTO'
      Size = 4
    end
    object StringField3: TStringField
      FieldName = 'DESCRICAO'
      Origin = '"CM.PRODUTO".DESCPROD'
      Size = 50
    end
  end
