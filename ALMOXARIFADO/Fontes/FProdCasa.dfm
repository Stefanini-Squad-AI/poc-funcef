  object qryArtigo: TwwQuery
    Tag = 5
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '       A.CODARTIGO,'
      '       P.CODMEDCUSTO,'
      
        '      (P.DESCPROD || '#39' '#39' || A.CODTAMANHO || '#39' '#39' || A.CODCOR) AS ' +
        'DESCRICAO,'
      '       C.CUSTOMEDIO'
      ''
      'FROM'
      '       ARTIGO A,'
      '       PRODUTO P,'
      '       CUSTOMED C'
      'WHERE'
      
        '        (((A.FLGBLOQUEADO <> '#39'R'#39') AND (A.FLGBLOQUEADO <> '#39'A'#39')) O' +
        'R (A.FLGBLOQUEADO IS NULL))'
      '    AND (C.CODCUSTEIO = 1)'
      '    AND (A.CODPRODUTO = P.CODPRODUTO)'
      '    AND (A.CODARTIGO = C.CODARTIGO)'
      'ORDER BY DESCRICAO'
      '')
    ValidateWithMask = True
    Left = 491
    Top = 188
    object qryArtigoCODARTIGO: TStringField
      FieldName = 'CODARTIGO'
      Origin = 'ARTIGO.CODARTIGO'
      Size = 14
    end
