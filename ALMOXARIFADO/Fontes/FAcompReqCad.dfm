  object qryAtend: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '     IE.QTDEENTREGA,'
      '     IE.CODMEDIDA,'
      '     IE.DATARECEB,'
      '     IE.VALORUN,'
      '     IE.DATAENTREGA,'
      '     PA.NOME AS ATENDENTE,'
      '     PC.NOME AS CONFDEV,'
      
        '     DECODE(IE.FLGSTATUS,'#39'F'#39','#39'NÃO CONFIRMADO'#39',DECODE(IE.FLGSTATU' +
        'S,'#39'T'#39','#39'CONFIRMADO'#39','#39'DEVOLVIDO'#39' )) AS STATUS'
      'FROM'
      '     ITEMENTR IE,'
      '     PESSOA PA,'
      '     PESSOA PC'
      'WHERE'
      '         (NUMREQUISICAO  = :pNUMREQ)'
      '     AND (RTRIM(CODARTIGO) = :pCODARTIGO)'
      '     AND (IE.IDATENDENTE = PA.IDPESSOA)'
      '     AND (IE.IDUSUARIOCONFDEV = PC.IDPESSOA(+))'
      'ORDER BY'
      '          IE.DATAENTREGA')
    ValidateWithMask = True
    Left = 304
    Top = 310
    ParamData = <
      item
        DataType = ftInteger
        Name = 'pNUMREQ'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'pCODARTIGO'
        ParamType = ptUnknown
      end>
