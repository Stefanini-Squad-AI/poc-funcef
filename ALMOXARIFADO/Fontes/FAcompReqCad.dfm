  object qryCCust: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '
      '           CODCENTROCUSTO,'
      '           NOME'
      'FROM '
      '           CENTCUST'
      'WHERE '
      '( IDEMPRESA = :IDPESS)'
      'ORDER BY 2')
    ValidateWithMask = True
    Left = 435
    Top = 369
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESS'
        ParamType = ptUnknown
      end>
  end
  object qryAlmox: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '
      '           CodAlmoxarifado,'
      '           DescAlmox '
      'FROM '
      '          ALMOX '
      'WHERE '
      '         (IDPESSOA = :pIDPESS)'
      'ORDER BY 2')
    ValidateWithMask = True
    Left = 385
    Top = 366
    ParamData = <
      item
        DataType = ftInteger
        Name = 'pIDPESS'
        ParamType = ptUnknown
      end>
  end
  object qryGrpProd: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DESCGRUPOPROD, CODGRUPOPROD'
      'FROM GRUPPROD'
      'WHERE STATUSGRUPO = '#39'A'#39
      'ORDER BY DESCGRUPOPROD')
    ValidateWithMask = True
    Left = 321
    Top = 366
  end
  object qryArtigo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '
      '       A.CODARTIGO,'
      
        '      (P.DESCPROD || '#39' '#39' || A.CODCOR || '#39' '#39' || A.CODTAMANHO) AS ' +
        'DESCRICAO'
      'FROM   '
      '       ARTIGO A,'
      '       PRODUTO P'
      'Where  '
      '          ( A.FLGATIVO = '#39'S'#39' )'
      ' AND ( A.CODPRODUTO = P.CODPRODUTO)'
      ''
      'ORDER BY DESCRICAO'
      '')
    ValidateWithMask = True
    Left = 262
    Top = 369
  end
  object qryReq: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '    RQ.NUMREQUISICAO,'
      '    AO.DESCALMOX AS ORIGEM,'
      '    DECODE(CUSTOTRANSF,'#39'T'#39',AD.DESCALMOX,CC.NOME) AS DESTINO,'
      '    DATAEMISSAO,'
      '    DATANECESSIDADE,'
      
        '    DECODE(RQ.REQATENDIDA,'#39'F'#39','#39'PENDENTE'#39', DECODE(RQ.REQATENDIDA,' +
        #39'T'#39','#39'ATEND. TOTAL'#39','#39'ATEND. PARCIAL'#39') )  AS  STATUS,'
      '    U.NOMEUSUARIO'
      ''
      'FROM'
      '   REQMAT RQ,'
      '   ALMOX AO,'
      '   ALMOX AD,'
      '   CENTCUST CC,'
      '   USUARIOSISTEMA U'
      'WHERE'
      '       (RQ.CODALMOXAORIGEM = AO.CODALMOXARIFADO)'
      '   AND (RQ.CODALMOXADESTINO = AD.CODALMOXARIFADO(+))'
      '   AND (RQ.CODCENTROCUSTO = CC.CODCENTROCUSTO)'
      '   AND (RQ.IDEMPRESA = CC.IDEMPRESA)'
      
        '   AND (TO_NUMBER(RTRIM(SUBSTR(RQ.TRGUSERINCLUSAO,3,30))) = U.ID' +
        'USUARIO )'
      'ORDER BY'
      '     NUMREQUISICAO'
      ' ')
    ValidateWithMask = True
    Left = 208
    Top = 366
    object qryReqNUMREQUISICAO: TFloatField
      DisplayLabel = 'Nº Requisição'
      DisplayWidth = 10
      FieldName = 'NUMREQUISICAO'
    end
    object qryReqORIGEM: TStringField
      DisplayLabel = 'Origem'
      DisplayWidth = 30
      FieldName = 'ORIGEM'
      Size = 40
    end
    object qryReqDESTINO: TStringField
      DisplayLabel = 'Destino'
      DisplayWidth = 30
      FieldName = 'DESTINO'
      Size = 40
    end
    object qryReqDATAEMISSAO: TDateTimeField
      DisplayLabel = 'Data~Emissão'
      DisplayWidth = 10
      FieldName = 'DATAEMISSAO'
      DisplayFormat = 'dd/mm/yyyy'
    end
    object qryReqDATANECESSIDADE: TDateTimeField
      DisplayLabel = 'Data~Necessidade'
      DisplayWidth = 10
      FieldName = 'DATANECESSIDADE'
      DisplayFormat = 'dd/mm/yyyy'
    end
    object qryReqSTATUS: TStringField
      DisplayLabel = 'Status'
      DisplayWidth = 14
      FieldName = 'STATUS'
      Size = 14
    end
    object qryReqNOMEUSUARIO: TStringField
      DisplayLabel = 'Usuário'
      DisplayWidth = 20
      FieldName = 'NOMEUSUARIO'
      FixedChar = True
    end
  end
