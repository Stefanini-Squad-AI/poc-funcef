  object qryItens: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '    IP.NUMREQUISICAO,'
      '    IP.CODARTIGO,'
      
        '    (P.DESCPROD || '#39' '#39' || A.CODTAMANHO || '#39' '#39' || A.CODCOR) AS DE' +
        'SCRICAO,'
      '    IP.CODMEDIDA,'
      '    IP.QTDEPEDIDA,'
      '    IP.QTDEPENDENTE,'
      '    IP.VALORUN,'
      
        '    DECODE(IP.QTDEPEDIDA, IP.QTDEPENDENTE,'#39'NÃO ATENDIDA'#39',DECODE(' +
        'SUB.CODARTIGO,NULL,'#39'ESTORNADO'#39',DECODE(IP.QTDEPENDENTE, 0, '#39'ATEND' +
        '. TOTAL'#39','#39' ATEND. PARCIAL'#39'))) AS STATUS'
      'FROM'
      '    ITEMPEDI IP,'
      '    PRODUTO P,'
      '    ARTIGO A,'
      '    (SELECT CODARTIGO  FROM ITEMENTR'
      '     WHERE (NUMREQUISICAO = :pNUMREQ)'
      '    )SUB'
      'WHERE'
      '         (IP.NUMREQUISICAO  = :pNUMREQ)'
      '     AND (IP.CODARTIGO      = A.CODARTIGO)'
      '     AND (A.CODPRODUTO      = P.CODPRODUTO)'
      '     AND (A.CODARTIGO       = SUB.CODARTIGO(+))'
      'ORDER BY'
      '    (P.DESCPROD || '#39' '#39' || A.CODTAMANHO || '#39' '#39' || A.CODCOR)'
      ' ')
    ValidateWithMask = True
    Left = 80
    Top = 366
    ParamData = <
      item
        DataType = ftInteger
        Name = 'pNUMREQ'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'pNUMREQ'
        ParamType = ptUnknown
      end>
