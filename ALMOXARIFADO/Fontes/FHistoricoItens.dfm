  object TwwQuery
    Tag = 5
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDTIPOOPERACAO, DESCTIPOOPERACAO'
      'FROM TIPOOPERACAO'
      'WHERE'
      '    IDTIPOINVEST = 2'
      'AND IDTIPOOPERACAO IN (-52,-53,-54,-10052,-10053)'
      'ORDER BY DESCTIPOOPERACAO')
    ValidateWithMask = True
    Left = 510
    Top = 253
  end
  object QryHistrorico: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT DATANECESSIDADE, ROUND(QTDFINAL, 2) AS QTDFINAL , CODMEDI' +
        'DA FROM ( '
      ' '
      'SELECT RM.DATANECESSIDADE, '
      '       CASE '
      '         WHEN CO.CODMEDIDA = CF.CODMEDIDA THEN '
      '           IP.QTDEPEDIDA '
      '         ELSE '
      '          (IP.QTDEPEDIDA * CO.FATOR / CF.FATOR)'
      '       END AS QTDFINAL, '
      '       CF.CODMEDIDA '
      
        '  FROM REQMAT RM, ITEMPEDI IP, CONVER CO, CONVER CF, ARTIGO AR, ' +
        'PRODUTO PD  '
      '   WHERE RM.CODCENTROCUSTO = 71134'
      '   AND IP.CODARTIGO = 102'
      '   AND CO.CODMEDIDA = IP.CODMEDIDA '
      '   AND CF.CODMEDIDA = '#39'CX'#39
      '   AND RM.NUMREQUISICAO = IP.NUMREQUISICAO '
      '   AND IP.CODARTIGO = AR.CODARTIGO '
      '   AND AR.CODPRODUTO = PD.CODPRODUTO '
      '   AND PD.CODPRODUTO = CO.CODPRODUTO '
      '   AND PD.CODPRODUTO = CF.CODPRODUTO '
      'ORDER BY DATANECESSIDADE DESC '
      ' '
      ')'
      'WHERE ROWNUM <= 3')
    ValidateWithMask = True
    Left = 232
    Top = 128
    object QryHistroricoDATANECESSIDADE: TDateTimeField
      DisplayLabel = 'Data da Compra'
      DisplayWidth = 21
      FieldName = 'DATANECESSIDADE'
      Origin = 'BASEDADOS.REQMAT.DATANECESSIDADE'
    end
