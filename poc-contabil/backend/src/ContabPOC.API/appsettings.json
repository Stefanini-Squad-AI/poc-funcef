{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OracleConnection": ""
  },
  "KeyVault": {
    "Url": "https://kv-contab-poc-dev-001.vault.azure.net/"
  },
  "FuncefORM": {
    "Connection": {
      "Provider": "Oracle",
      "ConnectionStringFromKeyVault": {
        "Enabled": true,
        "SecretName": "api-oracle-conn"
      },
      "TimeoutInSeconds": 30,
      "MaxPoolSize": 100
    },
    "Audit": {
      "Enabled": true,
      "ConnectionStringFromKeyVault": {
        "Enabled": true,
        "SecretName": "api-oracle-audit"
      }
    }
  },
  "Auth": {
    "EntraId": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantIdFromKeyVault": {
        "Enabled": true,
        "SecretName": "glb-entraid-tenantid"
      },
      "ClientIdFromKeyVault": {
        "Enabled": true,
        "SecretName": "glb-entraid-clientid"
      },
      "AudienceFromKeyVault": {
        "Enabled": true,
        "SecretName": "glb-entraid-audience"
      },
      "CredentialType": "ManagedIdentity"
    }
  }
}
