SELECT
  DPT.IDTITULAR,        DPT.IDPESSOA,         DPT.IDDEPENDENCIA, DPT.NUMSEQUENCIA, 
  DPT.FLGCONTAIMPOSTOR, DPT.FLGCONTASALARIOF, DPT.FLGDESIGNADO,  DPT.FLGDEPLEGAL, 
  DPT.MATRICULA,        DPT.INICIOIMPOSTOR,   DPT.FIMIMPOSTOR,   DPT.INICIOSALARIOF,
  DPT.FIMSALARIOF,

  DPD.IDSITDEPENDENTE,

  P.NOME, P.NUMDOCUMENTO, P.FLGINVALIDO,

  PF.DATANASC, PF.SEXO, PF.INICIOINVALIDEZ , PF.FIMINVALIDEZ
FROM
  PESSOA P, PESSOAFISICA PF, DEPENTIT DPT,
  DEPENDENTE DPD, SITDEPENDENTE SIT 
WHERE 
  (P.IDPESSOA    = PF.IDPESSOA)  AND
  (PF.IDPESSOA   = DPT.IDPESSOA) AND
  (PF.IDPESSOA   = DPD.IDPESSOA) AND
  (DPD.IDSITDEPENDENTE = SIT.IDSITDEPENDENTE(+)) AND
  (DPT.IDDEPENDENCIA <> 'PRP')

