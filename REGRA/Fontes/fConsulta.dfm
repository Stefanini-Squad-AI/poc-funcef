  object QryRegraAux: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '      R.IDREGRA, R.NOMEREGRA, R.IDTIPOREGRA, T.DESCREGRA'
      'FROM'
      '    TIPOREGRA T, REGRA R'
      'WHERE'
      '     (T.IDTIPOREGRA = R.IDTIPOREGRA)'
      'ORDER BY'
      '      T.DESCREGRA, R.IDTIPOREGRA, R.NOMEREGRA')
    ValidateWithMask = True
    Left = 310
    Top = 93
  end
