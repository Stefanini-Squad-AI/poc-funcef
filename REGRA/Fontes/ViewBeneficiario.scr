SELECT 
  BF.IDPESSJUR, BF.IDPLANOPREV, BF.IDTITULAR, BF.SEQPROPOSTA, BF.IDBENEFICIO,

  P.IDPESSOA, P.NOME, P.NUMDOCUMENTO,

  PF.DATANASC, PF.SEXO, PF.INICIOINVALIDEZ , PF.FIMINVALIDEZ,

  DPT.IDDEPENDENCIA,
  
  DPD.IDSITDEPENDENTE
FROM 
  PESSOA P, PESSOAFISICA PF, DEPENTIT DPT,
  DEPENDENTE DPD, BFCIARIOTITPLAN BF, SITDEPENDENTE SIT
WHERE  
  BF.IDPESSOA = P.IDPESSOA    AND
  P.IDPESSOA  = PF.IDPESSOA   AND
  PF.IDPESSOA = DPT.IDPESSOA  AND
  PF.IDPESSOA = DPD.IDPESSOA  AND
  DPD.IDSITDEPENDENTE = SIT.IDSITDEPENDENTE(+) AND
  BF.IDTITULAR = DPT.IDTITULAR

