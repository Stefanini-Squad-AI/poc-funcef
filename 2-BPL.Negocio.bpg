#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = CmGlobalObj50.bpl CmBack50.bpl CMContabObj50.bpl CMRegra50MT.bpl CMRegra50.bpl CMCfinanObj50.bpl CMPlaneOrcObj50.bpl \
  CMCapCarObj50.bpl CMIntBancoMT50.bpl CmCapCarUtilObj50.bpl CMCAFObj50.bpl CMFBCOMUM50.bpl CMTotalPrev50.bpl CMPrevMT50.bpl \
  CMWebComum50.bpl CMIntegraEP50.bpl CMObjetosEP50.bpl CMExecEP50.bpl CMAdmPrev.bpl CmAgendamentoObj50.bpl CMIRRFobj50.bpl \
  CMAlmoxCompraObj50.bpl cmLivroObj50.bpl CMImobiliarioObj50.bpl CMIndicadoresObj50.bpl CmRelatorioObj50.bpl CMCompoRH.bpl \
  CmRHObj50.bpl CMFBOBJ50.bpl CMFolhaObjMT.bpl CMAutoAtendimentoObj50.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------


CmGlobalObj50.bpl: CMGLOBALOBJ50\Package\CmGlobalObj50.dpk
  $(DCC)

