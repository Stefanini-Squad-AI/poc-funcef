    sFlgisentoirrf, sFlgmolestiagrave, // SOL 207789 KINTANA 2029238
    sDatainiciomolestia, sDatafimmolestia, // SOL 207789 KINTANA 2029238
    sFlgsomairsupinss, sNumdepirrf, // SOL 207789 KINTANA 2029238
    sDatanasc, sNumDocumento, sMatriculaDep : String; // SOL 207789 KINTANA 2029238
begin
     sMatriculaDep := '';

     lstPessoaBaseDePag.add(inttostr(iIdPessoa)+';'+inttostr(icodportforma)+';'+inttostr(iIdRecebePgto)); //SOL 207789 KINTANA 2029238

     { sSQL:= ' DELETE FROM CM.BASEDEPAGAMENTOAPOIO BA' +#13+
        ' WHERE EXISTS (SELECT 1' +#13+
        '          FROM BASEDEPAGAMENTO B' +#13+
