                      '   AND IDTITULAR = ' + IntToStr(iIDTITULAR)+ #13#10 +
                      '   AND IDPLANOPREV = '+ IntToStr(iIDPLANOPREV)  + #13#10 +
                      '   AND FLGTIPODESC = ''B'''  + #13#10 +
                      '   AND FONTEPAGADORA = ' + IntToStr(ifontepagadora) ;

              qryperfil.close;
              qryperfil.SQL.Clear;
              qryperfil.SQL.Text := sSQL;
              qryperfil.Open;

              if (qryperfil.RecordCount = 1) and not(qryperfil.FieldByName('IDPERFIL').AsInteger = 0) then
              begin
                fct_idperfil := qryperfil.FieldByName('IDPERFIL').AsInteger;
                dtmFolhaPrevia.ExibeMensagem('Menor Perfil de investimento localizado: Mês Ref. = '+smes+' | Pessoa: '+IntToStr(iIDPESSOA)+'  Titular: '+IntToStr(iIDTITULAR)+'  Plano: '+IntToStr(iIDPLANOPREV) + ' Fonte Pagadora: '+IntToStr(ifontepagadora))
              end
