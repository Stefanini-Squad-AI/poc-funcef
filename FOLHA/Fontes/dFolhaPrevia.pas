        '           AND B.IDTITULAR = ' +IntToStr(iIdTitular)+' '+#13+
        '           AND B.IDLOTE = ' + IntToStr(iidlote) +#13+
        '           AND B.MESCOBRANCA = '+ QuotedStr(sMesCobranca)+')';

        dtmFolhaPrevia.qryAux.close;
        dtmFolhaPrevia.qryAux.sql.Clear;
        dtmFolhaPrevia.qryAux.sql.Add(ssql);
        dtmFolhaPrevia.qryAux.execSql;   }

     //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
     //sSQL := ' DELETE FROM BASEDEPAGAMENTOPREVIA '+#13+ // SOL 207789 KINTANA 2029238
    { sSQL := ' DELETE FROM BASEDEPAGAMENTO '+#13+ // SOL 207789 KINTANA 2029238
             ' WHERE IDTITULAR = ' + IntToStr(iIdTitular) +#13+
             ' AND IDPESSOA = ' + IntToStr(iIdPessoa) +#13+
             ' AND IDLOTE = ' + IntToStr(iidlote) +#13+
             ' AND MESCOBRANCA = ' + QuotedStr(sMesCobranca) +#13+
             ' AND FLGEFETIVADO = 0 ' +#13+
             ' AND IDHSTFOLHABENEF IS NULL ';

     dtmFolhaPrevia.qryAux.close;
     dtmFolhaPrevia.qryAux.sql.Clear;
     dtmFolhaPrevia.qryAux.sql.Add(ssql);
     dtmFolhaPrevia.qryAux.execSql;  }
     //FIM Helio - SOL Nº 151061-10442 KINTANA Nº 1720319

      // SOL 207789 KINTANA 2029238
      sSQL := ' Select' + #13#10 +
              'PF.FLGISENTOIRRF,' + #13#10 +
              'PF.FLGMOLESTIAGRAVE,' + #13#10 +
              'TRUNC(PF.DATAMOLESTIAGRAVE) AS DATAMOLESTIAGRAVE,' + #13#10 +
              'TRUNC(PF.DATAFIMMOLESTIA) AS DATAFIMMOLESTIA,' + #13#10 +
              'PF.FLGSOMAIRSUPINSS,' + #13#10 +
              'PF.NUMDEPIRRF,' + #13#10 +
              'TRUNC(PF.DATANASC) AS DATANASC' + #13#10 +
              'from PESSOAFISICA PF' + #13#10 +
              'where idpessoa = ' + IntToStr(iIdPessoa);
      dtmFolhaPrevia.qryAux.close;
      dtmFolhaPrevia.qryAux.sql.Clear;
      dtmFolhaPrevia.qryAux.sql.Add(sSQL);
      dtmFolhaPrevia.qryAux.Open;

      sFlgisentoirrf      := dtmFolhaPrevia.qryAux.FieldByName('FLGISENTOIRRF').AsString;
      sFlgmolestiagrave   := dtmFolhaPrevia.qryAux.FieldByName('FLGMOLESTIAGRAVE').AsString;
