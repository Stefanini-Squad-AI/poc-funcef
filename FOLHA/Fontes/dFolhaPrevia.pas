procedure TobjRecebedor.AcrescentaPessoa(aiidpessoa : longint);
begin
  if lstPessoas.indexof(inttostr(aiidpessoa)) < 0 then
    lstPessoas.add(inttostr(aiidpessoa));
end;

procedure TobjRecebedor.ObtemContabilDoPlano(
  aiidplanoprev: integer;
  var aiplanocontabil: integer;
  var ascontaliquido: string);
var objPlano: tobjPlano;
    lii: integer;
begin
  lii:=lstPlanos.indexof(inttostr(aiidplanoprev));
  if lii >= 0 then
  begin
    objplano:=(lstPlanos.objects[lii] as tobjplano);
    aiplanocontabil:=objplano.PlanoContabil;
    ascontaliquido:=objplano.PlaContaLiquido;
  end
  else
  begin
    aiplanocontabil:=self.iidplanocontabilglobal;
    ascontaliquido:=splacontaliqglobal;
  end;
end;

function TobjRecebedor.AcrescentaPlano(aiidplano, aiidplanocontab: longint;
  asplacontaliq: string;
  arvalor: real; aitipo: integer {0-normal, 1-abono} 
  ; arvalorrateio: Real // Andre Imakawa - SIG 99651
  ): tobjplano;
var objPlano: tobjPlano;
    lii: integer;
begin
  lii:=lstPlanos.indexof(inttostr(aiidplano));
  if lii < 0 then
  begin
    objplano:=tobjplano.create(aiidplanocontab, asplacontaliq, aiidplano);   //Ewerton Beltramini SIG92809
    lstPlanos.AddObject(inttostr(aiidplano), objplano);
    if (SistemaFolha.RateioPlanoRubrica > 0) then
    begin
      if aitipo = 0 then
        objPlano.ValorPlano:=arvalor
      else
        objPlano.Valor13Plano:=arvalor;

      if aitipo = 0 then
        objPlano.ValorRateio:=arvalorrateio
      else
        objPlano.ValorRateio13:=arvalorrateio;
    end;
  end
  else
  begin
    objplano:=(lstPlanos.objects[lii] as tobjplano);
    if aiidplanocontab <> 0 then 
      objplano.PlanoContabil:=aiidplanocontab;
    if asplacontaliq <> '' then 
      objplano.PlaContaLiquido:=asplacontaliq;
    if (SistemaFolha.RateioPlanoRubrica > 0) then
    begin
      if aitipo = 0 then
        objPlano.ValorPlano:=objPlano.ValorPlano+arvalor
      else
        objPlano.Valor13Plano:=objPlano.Valor13Plano+arvalor;

      if aitipo = 0 then
        objPlano.ValorRateio:= objPlano.ValorRateio + arvalorrateio
      else
        objPlano.ValorRateio13:= objPlano.ValorRateio13 + arvalorrateio;

    end;
  end;
  if (SistemaFolha.RateioPlanoRubrica > 0) then
  begin
    if aitipo = 0 then
      ValorPlanoTotal:=ValorPlanoTotal+arvalor
    else
      Valor13PlanoTotal:=Valor13PlanoTotal+arvalor;
  end;
end;

