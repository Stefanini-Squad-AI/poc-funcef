      sFlgsomairsupinss   := dtmFolhaPrevia.qryAux.FieldByName('FLGSOMAIRSUPINSS').AsString;
      sNumdepirrf         := dtmFolhaPrevia.qryAux.FieldByName('NUMDEPIRRF').AsString;
      sDatanasc           := dtmFolhaPrevia.qryAux.FieldByName('DATANASC').AsString;


      sSQL := ' SELECT NUMDOCUMENTO FROM PESSOA WHERE IDPESSOA = ' + IntToStr(iIdPessoa);
      dtmFolhaPrevia.qryAux.close;
      dtmFolhaPrevia.qryAux.sql.Clear;
      dtmFolhaPrevia.qryAux.sql.Add(sSQL);
      dtmFolhaPrevia.qryAux.Open;

      sNumDocumento      := dtmFolhaPrevia.qryAux.FieldByName('NUMDOCUMENTO').AsString;



