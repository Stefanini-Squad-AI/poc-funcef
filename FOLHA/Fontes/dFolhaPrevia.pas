procedure TobjRecebedor.CalculaValorCMPFSobreINSS(abbeneficiario: boolean);
var rValbaseinss: real;
    rValbaseinssbruto: real;
    lrcpmfinss: real;
    lstipodesc: string;
    smesref: string;
begin
  //verifica Cpmf do Beneficio do Inss
  if abbeneficiario then
    if (prmIdRubricaCPMF <> 0) then
    begin
      //alteração no controle do valor do inss quando
      //     se tem opção de somar bases de Supl e INSS
      //IRRF INSS NÃO DEDUZ PARA BASE DE CPMF
      rValbaseinssbruto:=rINSSMes;  
      rValbaseinss:=ValorBasePorFontePagadora(true,false,2)+
                    ValorBasePorFontePagadora(true,false,4); 
      bcalculacpmf:=false;
      if rValbaseinssbruto <= SistemaFolha.LimiteBrutoINSSxCPMF then
      begin
        lrcpmfinss:=CalculaCPMF(rValbaseinss);
        if lrcpmfinss > 0 then
        begin
          bcalculacpmf:=true;
          if prmFlgCalculoValores = 0 then
            lrcpmfinss:=TruncaMoeda(lrcpmfinss)
          else
            lrcpmfinss:=ArredondaMoeda(lrcpmfinss);
          lstipodesc:=dtmFolhaPrevia.BuscaDadosRubrica(self, prmIdRubricaCPMF, 'T');
          if lstipodesc <> '' then
          begin
            If iFlgtipofolha in [3, 4] Then
              smesref:=dtmFolhaPrevia.MesAbono
            else
              smesref:=dtmFolhaPrevia.MesCobranca;
            try
              if not InsereRubrica(iidresponsavel,                                      //beneficiario
                                   0,                                                   //favorecido da rubrica
                                   0,                                                   //beneficio associado : pega beneficio base
                                   prmIdRubricaCPMF,                                    //codigo do provento
