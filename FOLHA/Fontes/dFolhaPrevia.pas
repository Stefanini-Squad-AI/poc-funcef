    if abMoraBrasil then // SOL 225050 Kintana 2058832
       dbaseIRRF:=arproventoirrf-ardescontoirrf+arBaseIRMes // SOL 225050 Kintana 2058832
    else  // SOL 225050 Kintana 2058832
       dbaseIRRF:=arproventoirrf+arBaseIRMes; // SOL 225050 Kintana 2058832

    lsdataref:=FormatDateTime('dd/mm/yyyy', dtmFolhaPrevia.DataPagamento);
    if aiTipoBase = 1 then {IR ABONO}
    begin
      DecodeDate(dtmFolhaPrevia.DataPagamento, iAno, iMes, iDia);
      lsdataref:=FormatDateTime('dd/mm/yyyy', diasuteis.UltDiaMes(iAno, iMes));
    end;

    if (aiTipoBase = 7) and (ascodirrfdarf = '3223') and (abMoraBrasil) then  // Andre Imakawa - SIG 48178
    begin
      rValorIRRF := arproventoirrf * 0.15
    end
    //edilaine WO32047 : inicio
    else if (not abMoraBrasil) and (SistemaFolha.FlgNovoIrExterior = 1) then
    begin
      rValorIRRF := SistemaFolha.objIrrf.CalculaIRRF_Ext(dbaseirrf,
                                                         FormatDateTime('dd/mm/yyyy', dtmFolhaPrevia.UltDiaMesPag),
                                                         0, dPercentual, rValorReducaoIR);

      if rValorIRRF-arValorIRMes > 0 then
         rValorIRRF:=rValorIRRF-arValorIRMes;
    end
    //edilaine WO32047 : fim
    else
      if (abMoraBrasil) then
      begin
        rValorIRRF:=SistemaFolha.objIrrf.CalculaIRRF(
          inumdepirrf, dtdatanasc, dbaseirrf, dPercentual,
          rValorReducaoIR,       //edilaine WO29025
          FormatDateTime('dd/mm/yyyy', dtmFolhaPrevia.UltDiaMesPag), 0,
          0, true, arproventoirrf       //edilaine WO29025
          );

        if rValorIRRF-arValorIRMes > 0 then
          rValorIRRF:=rValorIRRF-arValorIRMes;
      end
      else
      begin
        rValorIRRF:=SistemaFolha.objIrrf.CalculaIRRF_Ext(dbaseirrf,
          FormatDateTime('dd/mm/yyyy', dtmFolhaPrevia.UltDiaMesPag));

        if rValorIRRF-arValorIRMes > 0 then
          rValorIRRF:=rValorIRRF-arValorIRMes;
      end;

    if ((aiTipoBase = 0) or
        ((aiTipoBase = 1) and (prmFLGVLIRVLMINABONO = 1))) and
       (rValorIRRF <= prmVlMinIRFF) and
       (rValorIRRF > 0) then
    begin
      rValorIRRF := 0;
    end;
    if RoundCM(rValorIRRF,2) < 0 then
      Result := 0
    else
      Result := RoundCM(rValorIRRF,2);
  end;
var
  lrBaseIRMes, lrValorIRMes: real;
  lrSaldoComp: real;
  lrproventoir: real;
  lrdescontoir: real;
  lscoddarf: string;
  liidrubir: integer;
  lsnomebase: string;
  lifontepagadora: integer;
  liidplanoprevbase, liidplanocontabilbase, liidplanoorigembase: integer;
  bNaoEstaIsento:Boolean;
  iTpIR: Integer; // 0 - FUND, 1 - INSS, 2 - FUND13, 3 - INSS13

begin

  bNaoEstaIsento := NaoEstaIsento(lscoddarf);
  //TRATA IR NORMAL
  lrproventoir:=0;
  lrdescontoir:=0;
  lscoddarf:='';
  liidrubir:=0;
  lifontepagadora:=0;
  iTpIR :=0;
  if assigned(BaseFUND) then
  begin
    lrproventoir:=lrproventoir+BaseFUND.rproventoirrf;
    lrdescontoir:=lrdescontoir+BaseFUND.rdescontoirrf;
    lscoddarf:=BaseFUND.scodirrfdarf;
    liidrubir:=BaseFUND.iidrubirrf;
    lsnomebase:='FUND';
    lifontepagadora:=1;
    if BaseFUND.MultiPlano then
    begin
      liidplanoprevbase:=0;
      liidplanocontabilbase:=0;
      liidplanoorigembase:=0; // Andre Imakawa - SIG 66634
    end
    else
    begin
      liidplanoprevbase:=BaseFUND.PlanoPrev;
      liidplanocontabilbase:=BaseFUND.PlanoContabil;
      liidplanoorigembase:=BaseFUND.PlanoOrigem; // Andre Imakawa - SIG 66634
    end;
    BuscaOutros_IRMensal(0, lscoddarf, liidrubir, lrBaseIRMes, lrValorIRMes);
    If bNaoEstaIsento Then  //CPrev - 26854 // SOL 253413 PPM 777588
      if lrproventoir > 0 then
      begin
        aValorIR[iTpIR] := ApenasCalculaIRNormal(0,
                              lscoddarf,
                              lrproventoir, lrdescontoir, lrBaseIRMes, lrValorIRMes,
                              MoranoBrasil);
      end;
  end;
  Inc(iTpIR);
  lrproventoir:=0;
  lrdescontoir:=0;
  lscoddarf:='';
  liidrubir:=0;
  lifontepagadora:=0;
  if assigned(BaseINSS) then
  begin
    lrproventoir:=lrproventoir+BaseINSS.rproventoirrf;
    lrdescontoir:=lrdescontoir+BaseINSS.rdescontoirrf;
    lscoddarf:=BaseINSS.scodirrfdarf;
    liidrubir:=BaseINSS.iidrubirrf;
    lifontepagadora:=2;
    if BaseINSS.MultiPlano then
    begin
      liidplanoprevbase:=0;
      liidplanocontabilbase:=0;
      liidplanoorigembase:=0; // Andre Imakawa - SIG 66634
    end
    else
    begin
      liidplanoprevbase:=BaseINSS.PlanoPrev;
      liidplanocontabilbase:=BaseINSS.PlanoContabil;
      liidplanoorigembase:=BaseINSS.PlanoOrigem; // Andre Imakawa - SIG 66634
    end;
    lrBaseIRMes:=0; lrValorIRMes:=0;
    If bNaoEstaIsento Then  //CPrev - 26854 // SOL 253413 PPM 777588
      if lrproventoir > 0 then
      begin
        aValorIR[iTpIR] := ApenasCalculaIRNormal(0,
                              lscoddarf,
                              lrproventoir, lrdescontoir, lrBaseIRMes, lrValorIRMes,
                              MoranoBrasil);
      end;
  end;

  //TRATA IR ABONO
  Inc(iTpIR);
  lrproventoir:=0;
  lrdescontoir:=0;
  lscoddarf:='';
  liidrubir:=0;
  lifontepagadora:=0;
  if assigned(BaseFUND13) then
  begin
    lrproventoir:=lrproventoir+BaseFUND13.rproventoirrf;
    lrdescontoir:=lrdescontoir+BaseFUND13.rdescontoirrf;
    lscoddarf:=BaseFUND13.scodirrfdarf;
    liidrubir:=BaseFUND13.iidrubirrf;
    lsnomebase:='FUND13';
    lifontepagadora:=1;
    if BaseFUND13.MultiPlano then
    begin
      liidplanoprevbase:=0;
      liidplanocontabilbase:=0;
      liidplanoorigembase:=0; // Andre Imakawa - SIG 66634
    end
    else
    begin
      liidplanoprevbase:=BaseFUND13.PlanoPrev;
      liidplanocontabilbase:=BaseFUND13.PlanoContabil;
      liidplanoorigembase:=BaseFUND13.PlanoOrigem; // Andre Imakawa - SIG 66634
    end;
    BuscaOutros_IRMensal(1, lscoddarf, liidrubir, lrBaseIRMes, lrValorIRMes);
    If bNaoEstaIsento Then  //CPrev - 26854 // SOL 253413 PPM 777588
      if lrproventoir > 0 then
      begin
        aValorIR[iTpIR] := ApenasCalculaIRNormal(1,
                              lscoddarf,
                              lrproventoir, lrdescontoir, lrBaseIRMes, lrValorIRMes,
                              MoranoBrasil);
      end;
  end;
  Inc(iTpIR);
  lrproventoir:=0;
  lrdescontoir:=0;
  lscoddarf:='';
  liidrubir:=0;
  lifontepagadora:=0;
  if assigned(BaseINSS13) then
  begin
    lrproventoir:=lrproventoir+BaseINSS13.rproventoirrf;
    lrdescontoir:=lrdescontoir+BaseINSS13.rdescontoirrf;
    lscoddarf:=BaseINSS13.scodirrfdarf;
    liidrubir:=BaseINSS13.iidrubirrf;
    lifontepagadora:=2;
    if BaseINSS13.MultiPlano then
    begin
      liidplanoprevbase:=0;
      liidplanocontabilbase:=0;
      liidplanoorigembase:=0; // Andre Imakawa - SIG 66634
    end
    else
    begin
      liidplanoprevbase:=BaseINSS13.PlanoPrev;
      liidplanocontabilbase:=BaseINSS13.PlanoContabil;
      liidplanoorigembase:=BaseINSS13.PlanoOrigem; // Andre Imakawa - SIG 66634
    end;
    lrBaseIRMes:=0; lrValorIRMes:=0;
    If bNaoEstaIsento Then  //CPrev - 26854 // SOL 253413 PPM 777588
      if lrproventoir > 0 then
      begin
        aValorIR[iTpIR] := ApenasCalculaIRNormal(1,
                              lscoddarf,
                              lrproventoir, lrdescontoir, lrBaseIRMes, lrValorIRMes,
                              MoranoBrasil);
      end;
  end;
end;
