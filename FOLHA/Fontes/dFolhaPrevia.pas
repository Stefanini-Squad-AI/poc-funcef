procedure TobjRecebedor.EfetivaRubricas(var bErroInserePrevia: boolean);    // Andre Imakawa - SIG 80669
var lik, lii : integer;
    objrub : tobjrubrica;
    lsplacontaliquido: string;
    liplanocontabil, iFlgRisco, iFlgResgate: integer;
    lbtemresiduo: boolean;
    iIdFavorecidoRecebedor : integer;
    bInseriuPrevia: boolean;    // Andre Imakawa - SIG 80669
    iFlgResgateParc: Integer; // Andre Imakawa - SIG 26149
begin
  lik:=0;
  //Showmessage('Total de rubrica:'+inttostr(lstRubricas.count));
  lbtemresiduo:=false;

  for lii:=0 to lstRubricas.count-1 do
  begin
    objrub:=(lstRubricas.objects[lii] as tobjrubrica);

    if ((objrub.iflgdesconto = 0) and ((objrub.rvalorrecebido > 0) or objrub.bpermitezero)) or
        (objrub.bpossuimargem and ((objrub.rvalorrecebido > 0) or objrub.bpermitezero)) then
    begin
      if not lbtemresiduo then
        if not (abs(objrub.rvalorprovento-objrub.rvalorrecebido) < 0.01) then
          lbtemresiduo:=true;

      //dtmFolhaPrevia.CorrigeBitributacaoExcessoDebito(objrub, iidtitular); // Andre Imakawa - SIG 97490

      inc(lik);

      //if (objrub.sflgtipodesc <> 'P') then // Felipe A. Santos - SIG23021 // Andre Imakawa - SIG 24398
      ObtemContabilDoPlano(objrub.iidplanoprev,liplanocontabil,lsplacontaliquido);
      //else  // Andre Imakawa - SIG 24398
      //   ObtemContabilDoPlano(0,liplanocontabil,lsplacontaliquido); // Felipe A. Santos - SIG23021  // Andre Imakawa - SIG 24398

      // Andre Imakawa - SIG 83292 - Inicio
      if (objrub.sflgtipodesc = 'Q') and (liplanocontabil = 0) and (lsplacontaliquido = '') then
      begin
        ObtemContabilDoPlano(0,liplanocontabil,lsplacontaliquido);
      end;
      // Andre Imakawa - SIG 83292 - Fim

      // Andre Imakawa - SIG 80669 - Inicio
      bInseriuPrevia := objrub.IncluiPrevia(iidpessjur, iidpatro, iidplanoprevglobal,
                          iidplanoorigemglobal,
                          liplanocontabil,
                          iidtitular, iidresponsavel,
                          iIdRecebePgto,
                          iidlote, iseqproposta, icodmoedabase, lik,
                          icodportforma, idfloatpagto,
                          iflgtipofolha,
                          NumBanco, NumAgencia, ContaCorrente,
                          bconsignatario, lsplacontaliquido, iacaojudganha, iflgfitespecial,
                          ifavdoc,
                          iseqdocumento,
                          iPrimeiroPagamento,
                          TemParamIndividual,
                          self,Sidhstbitributacao, //SOL205224 douglas.siqueira
                          TpConta      // Andre Imakawa - SIG 60540
                          );

      if not(bInseriuPrevia) then
      begin
        bErroInserePrevia := True;
      end
      else
      begin
        objrub.iFlgGravou := 1; //Andre Imakawa - SIG 99651
      end;

      // Andre Imakawa - SIG 80669 - Fim

      if splacontaliqglobal = '' then
        splacontaliqglobal:=lsplacontaliquido;


