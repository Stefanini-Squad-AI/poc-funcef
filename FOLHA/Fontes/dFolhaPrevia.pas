Procedure TobjRecebedor.VerificaLimiteEquacionamento;
  Function PossuiLimiteEquacionamento : real;
  var  query:TwwQuery;
       sSql: string;
  begin
    Try
      Try
        query := TwwQuery.Create(nil);       //edilaine WO19556
        query.DataBaseName := 'BaseDados';
        query.close;
        query.SQL.clear;

        sSql := 'SELECT IDMOTIVOACJUDDEFICIT, PORCENTAGEM                                                        ' + #13#10 +
                '  FROM (SELECT CP.IDMOTIVOACJUDDEFICIT,                                                         ' + #13#10 +
                '               ROUND(SUM(CP.PERCACJUDDEFICIT), 2) AS PORCENTAGEM                                ' + #13#10 +
                '          FROM CM.CONTRIBPARTPACJUDDEFICIT CP                                                   ' + #13#10 +
                '         WHERE CP.IDMOTIVOACJUDDEFICIT = ANY(3112, 3113)                                        ' + #13#10 +
                '           AND CP.IDPESSOA = '+ IntToStr(iidresponsavel)                                          + #13#10 +
                '           AND CP.ANOMESINIACJUDDEFICIT <= '+ QuotedStr(dtmFolhaPrevia.MesCobranca)               + #13#10 +
                '           AND ((CP.ANOMESFIMACJUDDEFICIT >= '+ QuotedStr(dtmFolhaPrevia.MesCobranca) + ') OR   ' + #13#10 +
                '               (CP.ANOMESFIMACJUDDEFICIT IS NULL))                                              ' + #13#10 +
                '         GROUP BY CP.IDMOTIVOACJUDDEFICIT                                                       ' + #13#10 +
                '        UNION ALL                                                                               ' + #13#10 +
                '        SELECT CN.IDMOTIVOACJUDDEFICIT,                                                         ' + #13#10 +
                '               ROUND(SUM(CN.PERCACJUDDEFICIT), 2) AS PORCENTAGEM                                ' + #13#10 +
                '          FROM CM.CONTRIBNUCLEOACJUDDEFICIT CN                                                  ' + #13#10 +
                '         INNER JOIN CM.NUCLEOFAMILIAR NF                                                        ' + #13#10 +
                '            ON CN.IDNUCLEOFAMILIAR = NF.IDNUCLEOFAMILIAR                                        ' + #13#10 +
                '         WHERE CN.IDMOTIVOACJUDDEFICIT = ANY(3112, 3113)                                        ' + #13#10 +
                '           AND CN.ANOMESINIACJUDDEFICIT <= '+ QuotedStr(dtmFolhaPrevia.MesCobranca)               + #13#10 +
                '           AND ((CN.ANOMESFIMACJUDDEFICIT >= '+ QuotedStr(dtmFolhaPrevia.MesCobranca) + ') OR   ' + #13#10 +
                '               (CN.ANOMESFIMACJUDDEFICIT IS NULL))                                              ' + #13#10 +
                '           AND NF.IDRESPNUCLEO = '+ IntToStr(iidresponsavel)                                      + #13#10 +
                '         GROUP BY CN.IDMOTIVOACJUDDEFICIT)                                                      ' + #13#10 +
                ' WHERE ROWNUM = 1';

        query.SQL.Add(sSql);
        query.Open;
        if query.IsEmpty then
           Result := 0
        else
           result:=query.FieldByName('PORCENTAGEM').AsFloat;
        query.Close ;
      except

      end;
    Finally
       FreeAndNil(query);
    end;

  end;

  Function RetornaValorLiquido(var aIRTOTAL: Real): real;
  var  query:TwwQuery;
       sSql: string;
       rtotprov,rtotdesc : Real;
  begin
    try
      dtmFolhaPrevia.qryRubricasDetalhe.Close;
      dtmFolhaPrevia.qryRubricasDetalhe.Sql.clear;
      dtmFolhaPrevia.qryRubricasDetalhe.Sql.add(RetornaConsultaPreviaDetalhe);
      dtmFolhaPrevia.qryRubricasDetalhe.prepare;
      dtmFolhaPrevia.qryRubricasDetalhe.ParamByName('IDTITULAR').AsString:=IntToStr(iidtitular);
      dtmFolhaPrevia.qryRubricasDetalhe.ParamByName('IDLOTE').AsInteger:=iidlote;
      dtmFolhaPrevia.qryRubricasDetalhe.ParamByName('IDPESSOA').AsInteger:=iidresponsavel;
      dtmFolhaPrevia.qryRubricasDetalhe.Open;

      While Not dtmFolhaPrevia.qryRubricasDetalhe.Eof Do
      Begin
        if (dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('FONTEPAGADORA_COD').AsInteger = 1) and
           (((Copy(dtmFolhaPrevia.MesCobranca,6,2) <> prmMesAbonoFund) and
           (Copy(dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('MES').asString,6,2) <> '13'))
            or
           (Copy(dtmFolhaPrevia.MesCobranca,6,2) = prmMesAbonoFund))and
           ((dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('FLGTIPODESC').AsString = 'B')or
           (dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('FLGTIPODESC').AsString = 'P')or
           ((dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('FLGTIPODESC').AsString = 'Y') and
           (dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('FLGPENSAOALIM').AsInteger = 1))or
           ((dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('FLGTIPODESC').AsString = 'I')
            and (iisomairrfinss = 0))) then
        begin
          rtotprov := rtotprov + dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('VLRPROVENTO').AsFloat;
          rtotdesc := rtotdesc + dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('VALORDESCONTO').AsFloat;
        end;
        
        if (dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('FONTEPAGADORA_COD').AsInteger = 1) and
           (dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('FLGTIPODESC').AsString = 'I') and
           (dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('IDPROCJUD').AsInteger = 0) and
           (iisomairrfinss = 1) then
        begin
          aIRTOTAL := aIRTOTAL + dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('VALORDESCONTO').AsFloat;
        end;
        dtmFolhaPrevia.qryRubricasDetalhe.Next;
      End;

      Result := (rTotProv-rTotDesc);
    Except

    end;

  end;

var
  rPorcentagem, rValorRubricaEqua, rValorLiquido, rValorMaximo, rValorDiferenca, rFator, rValorCorrigido: Real;
  rValorIRCalculo, rValorIRFUND, rValorIRINSS, rValorIRTOTAL: Real;
  lii, iTotRubricaEqua:Integer;
  lstPrevia: tstringlist;
  queryupd:TwwQuery;
  sSql: string;
  ValorIR: array of Real;

begin
  if lstRubricas.count > 0 then
  begin
    iTotRubricaEqua := 0;
    rPorcentagem := PossuiLimiteEquacionamento;
    if rPorcentagem > 0 then
    begin

      rValorLiquido := RetornaValorLiquido(rValorIRTOTAL);


      dtmFolhaPrevia.qryRubricasDetalhe.first;
      if Not dtmFolhaPrevia.qryRubricasDetalhe.IsEmpty then
      begin
        try
          dtmFolhaPrevia.qryRubricasContribEqua.Close;
          dtmFolhaPrevia.qryRubricasContribEqua.Open;
          lstPrevia    := TStringList.Create;

          While Not dtmFolhaPrevia.qryRubricasDetalhe.Eof Do
          Begin
            if (dtmFolhaPrevia.qryRubricasContribEqua.locate('IDRUBRICA', dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('IDRUBRICA').AsInteger, [])) and
               (dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('VALORDESCONTO').AsFloat > 0) and
               (((Copy(dtmFolhaPrevia.MesCobranca,6,2) <> prmMesAbonoFund) and
               (Copy(dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('MES').asString,6,2) <> '13'))
                or
               (Copy(dtmFolhaPrevia.MesCobranca,6,2) = prmMesAbonoFund))
                then
            begin
              Inc(iTotRubricaEqua);

              lstPrevia.Add(FloatToStr(dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('VALORDESCONTO').AsFloat) + ';' + dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('ROWID').AsString);

              rValorRubricaEqua := rValorRubricaEqua + dtmFolhaPrevia.qryRubricasDetalhe.FieldByName('VALORDESCONTO').AsFloat;
            end;

            dtmFolhaPrevia.qryRubricasDetalhe.Next;
          End;

          if iisomairrfinss = 1 then
          begin
            SetLength(ValorIR,4);
            RetornaValoresIR(ValorIR);
            // Tratamento para verificar se é MES de Abono FUNCEF
            if (Copy(dtmFolhaPrevia.MesCobranca,6,2) <> prmMesAbonoFund) then
            begin
              rValorIRFUND := ValorIR[0]; // 0 - FUND, 1 - INSS, 2 - FUND13, 3 - INSS13
              rValorIRINSS := ValorIR[1]; // 0 - FUND, 1 - INSS, 2 - FUND13, 3 - INSS13
            end
            else
            begin
              rValorIRFUND := ValorIR[0] + ValorIR[2]; // 0 - FUND, 1 - INSS, 2 - FUND13, 3 - INSS13
              rValorIRINSS := ValorIR[1] + ValorIR[3]; // 0 - FUND, 1 - INSS, 2 - FUND13, 3 - INSS13
            end;

            SetLength(ValorIR,0);
          end;

          if (iisomairrfinss = 1) then
          begin
            //rValorIRCalculo :=   rValorIRTOTAL - (rValorIRFUND + rValorIRINSS) + rValorIRFUND;
            rValorIRCalculo :=  rValorIRFUND;
          end;

          rValorMaximo := roundCM(((rValorLiquido + rValorRubricaEqua - rValorIRCalculo)/rPorcentagem),2) ;

          if rValorMaximo < rValorRubricaEqua then
          Begin
            rValorDiferenca := rValorRubricaEqua - rValorMaximo;
            rFator := rValorDiferenca / rValorRubricaEqua;

            try
              queryupd := TwwQuery.Create(nil);     //edilaine WO19556
              queryupd.DataBaseName := 'BaseDados';
              rValorDiferenca := 0;
              for lii:=0 to lstPrevia.count-1 do
              begin

                try
                  rValorCorrigido := roundCM(StrToFloat(Piece(lstPrevia[lii],';',1)) - (StrToFloat(Piece(lstPrevia[lii],';',1)) * rFator),2);
                  rValorDiferenca := rValorDiferenca +  roundCM((StrToFloat(Piece(lstPrevia[lii],';',1)) * rFator),2);
                  queryupd.Close;
                  queryupd.sql.Clear;

                  sSql := ' UPDATE CM.PREVIA P' + #13#10 +
                          ' SET P.VALORPROVENTO = ' + StringReplace((FloatToStr(rValorCorrigido)), ',', '.', []) + #13#10 +
                          ' WHERE P.ROWID = ' + QuotedStr(Piece(lstPrevia[lii],';',2));

                  queryupd.sql.Add(sSql);
                  queryupd.ExecSQL;

                except

                end;

              end;
            finally
                  FreeAndNil(queryupd);
            end;

            try
              try
                queryupd := TwwQuery.Create(nil);      //edilaine WO19556
                queryupd.DataBaseName := 'BaseDados';
                queryupd.Close;
                queryupd.sql.Clear;

                sSql := ' UPDATE CM.BASEDEPAGAMENTO                                     '  + #13#10 +
                        ' SET VLRDESCONTO = VLRDESCONTO - ' + StringReplace((FloatToStr(rValorDiferenca)), ',', '.', [])  + #13#10 +
                        '    ,VLRLIQUIDO = VLRLIQUIDO + '  + StringReplace((FloatToStr(rValorDiferenca)), ',', '.', [])  + #13#10 +
                        ' WHERE 	IDLOTE = ' + IntToStr(iidlote)                                 + #13#10 +
                        ' AND IDTITULAR = ' + IntToStr(iidtitular)                              + #13#10 +
                        ' AND IDPESSOA ='   + IntToStr(iidresponsavel);

                queryupd.sql.Add(sSql);
                queryupd.ExecSQL;

              except

              end;
            finally
              FreeAndNil(queryupd);
            end;

          end;
        finally
          FreeAndNil(lstPrevia);

        end;

      end;


    end;
  end;

end;
