          dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('IDBENEFICIO').asinteger:=
            objrub.iidbeneficio;
          if objrub.iflgdesconto = 0 then
          begin
            dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('PFLGATRASO').asinteger:=1;
            dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('PFLGDEVOL').asinteger:=0;
          end
          else
          begin
            dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('PFLGATRASO').asinteger:=0;
            dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('PFLGDEVOL').asinteger:=1;
          end;
          dtmFolhaPrevia.qryCorrecaoBeneficio.Open;
          while not dtmFolhaPrevia.qryCorrecaoBeneficio.eof do
          begin
            licodalterador:=dtmFolhaPrevia.qryCorrecaoBeneficio.FieldByName('codalterador').asinteger;
            liidregra:=dtmFolhaPrevia.qryCorrecaoBeneficio.FieldByName('IdRegraCALCULO').asinteger;
            if (liidregra <> 0) and (licodalterador <> 0) then
            begin
              if CalculaAlterador(asDataPagamento, objrub, licodalterador,
                   liidregra,
                   dtmFolhaPrevia.qryPrevia.fieldbyname('TIPOBENEFICIO').asinteger,
                   dtmFolhaPrevia.qryPrevia.fieldbyname('FLGFREQUENCIA').asstring,
                   lrvalorregra) then
                InsereRubricaAlterador(objrub, objrub.rvalorrecebido,
                  lrvalorregra,
                  DeterminaRubricaCorrecao(lrvalorregra,
                    dtmFolhaPrevia.qryCorrecaoBeneficio.fieldbyname('idrubnormal').asinteger,
                    dtmFolhaPrevia.qryCorrecaoBeneficio.fieldbyname('idrubdevolucao').asinteger));
            end;
            dtmFolhaPrevia.qryCorrecaoBeneficio.next;
          end;
        finally
          dtmFolhaPrevia.qryCorrecaoBeneficio.Close;
        end;
      end;
    end;
  finally
     qryAux.close;              //edilaine WO19556
     FreeAndNil(qryAux);        //edilaine WO19556
  end;
end;

function TObjRecebedor.CalculaAlterador(asDataPagamento : string; aobjrubrica : TObjRubrica;
  aicodalterador, aiidregracalculo : integer;
  aitipobeneficio: integer;
  asflgfrequencia: string;
  var advalorcorrecao : Double) : boolean;
 var lsdataref, lsDataDevido, lssql, lsvalorcorrecao, lsValor : string;
     liidcalculo : integer;
     lbErro : boolean;
begin
  Result:=False;
  adValorCorrecao:=0;

  lsvalor:=oranumero(formatfloat('#0.00', aobjrubrica.rvalorrecebido));

  if trim(asDataPagamento) = '' then
    lsDataDevido:=AtualizaDataFolha(copy(aobjrubrica.smes,6,2),copy(aobjrubrica.smes,1,4))
  else
    lsDataDevido:=asDataPagamento;

  if now > dtmFolhaPrevia.DataPagamento then
    lsdataref:=copy(formatdatetime('dd/mm/yyyy',dtmFolhaPrevia.DataPagamento),7,4)+'/'+
               copy(formatdatetime('dd/mm/yyyy',dtmFolhaPrevia.DataPagamento),4,2)
  else
    lsdataref:=copy(FormatDateTime('dd/mm/yyyy', NOW),7,4)+'/'+
               copy(FormatDateTime('dd/mm/yyyy', NOW),4,2);

  lssql:='SELECT '+
           '18 AS IDMODULO, '+  //IDENTIFICA O MÓDULO QUE EXECUTA A REGRA DE ALTERADOR
           inttostr(aicodalterador)+' CODALTERADORCORR,' +
           lsValor+' VALORPREV,' +
           QuotedStr(lsdataref)+' DATAREF, '+
           QuotedStr(aobjrubrica.smes)+' MESREFERENCIA,'+
           QuotedStr(lsDataDevido)+' DATAPREVISAORECE,'+
           inttostr(aobjrubrica.iidplanoprev)+' AS IDPLANOPREV, '+ 
           inttostr(iidpatro)+' AS IDPESSJUR, '+
           inttostr(iidtitular)+' AS IDTITULAR, '+
           inttostr(aobjrubrica.iidpessoa)+' AS IDPESSOA, ';

  if aitipobeneficio >= 0 then
  begin
    lssql:=lssql+
      inttostr(aitipobeneficio)+' AS TIPOBENEFICIO, '+
      quotedstr(asflgfrequencia)+' AS FLGFREQUENCIA, ';
  end;

  lssql:=lssql+
    QuotedStr(formatdatetime('dd/mm/yyyy',
              dtdatarequerimento))+' DATAREQUERIMENTO, '+
    QuotedStr(formatdatetime('dd/mm/yyyy',
              dtmFolhaPrevia.DataPagamento))+' DATARECEBIMENTO '+
    'FROM DUAL ';
  try
    {if bsimularegra then
    begin
      if (aobjrubrica.iflgdesconto = 0) then
        lsvalorcorrecao:=RegraNumericaSimula(2)
      else
        lsvalorcorrecao:=RegraNumericaSimula(3);
    end
    else}
    lsvalorcorrecao:=RegraNumerica(inttostr(aiidregracalculo), lssql, lbErro,
      liidcalculo);
    if not lbErro then
    begin
      lsvalorcorrecao:=clientenumero(trim(lsvalorcorrecao));
      try
        advalorcorrecao:=strtofloat(lsvalorcorrecao);
      except
        lberro:=true;
      end;
    end;
  except
    lberro:=true;
  end;

  if lberro then
  begin
    if (aobjrubrica.iflgdesconto = 0) then
      dtmFolhaPrevia.ExibeMensagem('Erro[REGRA DE CORREÇÃO DE BENEFÍCIO] '+
        lsvalorcorrecao+' Rubrica: '+inttostr(aobjrubrica.iidrubrica),
        self) 
    else
      if (aobjrubrica.iflgdesconto = 1) then
        dtmFolhaPrevia.ExibeMensagem('Erro[REGRA DE CORREÇÃO DE CONTRIBUIÇÃO] '+
          lsvalorcorrecao+' Rubrica: '+inttostr(aobjrubrica.iidrubrica),
          self); 

    dtmFolhaPrevia.ExibeMensagemSemRecebedor('SQL para Regra: '+lsSQL);
  end;
  result:=(not lberro) and (advalorcorrecao<>0);
end;

//DETERMINA RUBRICA PARA CORRECAO
function TObjRecebedor.DeterminaRubricaCorrecao(arvalor: double;
  airubnorm, airubdevol: integer): integer;
begin
  if (arvalor > 0) then
    result:=airubnorm
  else
    result:=airubdevol;
end;

procedure TObjRecebedor.InsereRubricaAlterador(aobjrub: tobjrubrica;
  alrvalorbase, alrvalorcorr: double; alidrubrica: integer);
 var lstipodesc: string;
     lrvalorcotas: double;
begin
  if alrvalorcorr = 0 then
    exit;
  alrvalorcorr:=abs(alrvalorcorr);
  lstipodesc:=dtmFolhaPrevia.BuscaDadosRubrica(self, alidrubrica, 'R');
  if lstipodesc <> '' then
  begin
    lrValorCotas:=TransformaCotas(alrvalorcorr, aobjrub.smes);
    try
      if not InsereRubrica(iidresponsavel,                                      //beneficiario
                           0,                                                   //favorecido da rubrica
                           0,                                                   //beneficio associado : pega beneficio base
                           alidrubrica,                                         //codigo do provento
                           dtmFolhaPrevia.qryProvento.FieldByName('flgdesconto').asinteger, //flag de desconto
                           dtmFolhaPrevia.qryProvento.FieldByName('flgespecial').asinteger, //flag especial
                           aobjrub.iidmotivo,                                   //motivo do desconto
                           1,                                                   //seqrubrica = 1
                           icodmoedabase,                                       //codigo da moeda
                           0,                                                   //regra de calculo
                           dtmFolhaPrevia.qryProvento.FieldByName('CODFONTEPAGADORA').asinteger, //fonte pagadora
                           dtmFolhaPrevia.qryProvento.FieldByName('flgirrf').asinteger, //indica se rubrica entra na base de IR
                           dtmFolhaPrevia.qryProvento.FieldByName('FLGSALFAMILIA').asinteger, //indica se rubrica entra na composição do calculo do salario familia
                           0,                                                   // Indica se o beneficio é provisorio
                           Sistema.Idmodulo,                                    //sistema de origem da rubrica
                           0,                                                   //flgSRB
                           1,                                                   //flgOK
                           0,                                                   //flgPA
                           dtmFolhaPrevia.qryProvento.FieldByName('flgdescpensao').asinteger, //flgBasePA
                           0,                                                   //flgconcessao
                           0,                                                   //flgindividual
                           dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalpart').asinteger,//compõe sal. participacao
                           dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalbenef').asinteger,//compõe sal. benefício
                           dtmFolhaPrevia.qryProvento.FieldByName('numprioridade').asinteger, //prioridade de desconto
                           iidpessjur,                                           //id empresa p/ contabilização
                           dtmFolhaPrevia.qryProvento.FieldByName('tipobasedesconto').asinteger, //tipo de base de desconto {abono,supl,inss,resgate}
                           0,                                                   //código do alterador
                           0,                                                   //id do plano de contas
                           inumeroprocesso,
                           snumprocinss,
                           'R',  //flg do tipo de desconto 'C', 'P', 'B', 'Y'
                           alrvalorbase,                                        //valor informativo associado a rubrica (base de calculo do IR)
                           alrvalorcorr,                                        //valor da rubrica
                           0,                                                   //valor base de calculo para a regra
                           '***',                                               //referencia
                           aobjrub.smes,                                        //mês de referência
                           aobjrub.scodirrfdarf,                                //código IRRF na SRF para o DARF
                           '',                                                  //indice recebimento 'R'ou pagamento 'P'
                           '',                                                  //código do tipo de recebimento ou desembolso
                           '',                                                  //código do centro de custo
                           '',                                                  //código do centro de responsabilidade
                           '',                                                  //código da unidade de negócio
                           '',                                                  //conta contábil associada
                           '',                                                  //data inicio da rubrica
                           '',                                                  //data final da rubrica
                           dtmFolhaPrevia.qryProvento.FieldByName('descparcial').asinteger,    //indica se permite desconto parcial
                           0,                                                   //usa no abono anual
                           3,                                                   //origem da rubrica
                           0,                                                  //lote original do desconto
                           0,  // RUBRICA CONSIGNATARIO
                           false, // ACEITA ZERO
                           '',    // DATA PREVISTA DE PAGAMENTO - PEND 10826
                           dtmFolhaPrevia.qryProvento.FieldByName('CODPROVDESC').asstring, //PARA GRAVAR CODPROVDESC NA PREVIA E EM SQL PARA REGRAS
                           aobjrub.iidplanoprev,
                           aobjrub.iidplanoorigem,
                           aobjrub.iidplanocontabil,
                           0, //RUBRICA CUJO SEQUENCIAL INTERNO É IRRELEVANTE PARA RETORNO
                           dtmFolhaPrevia.qryProvento.FieldByName('FLGRUBLEGAL').asinteger,  //
                           dtmFolhaPrevia.qryprevia.fieldbyname('MESCOMPREEM').asstring,     // SOL 140042 Kintana 900220
                           0, //modo cópia
                           aobjrub.scodirrfdarfori //código DARF da rubrica original de correção do benefício
                           ,dtmFolhaPrevia.qryProvento.FieldByName('FLGMARGEM').asinteger         //Renato Visoni SOL 131523 KINTANA 750021
                           ,0
                           ,dtmFolhaPrevia.qryProvento.FieldByName('FLGREPROGRAMAR').asInteger    //Marcio Denilson - SOL 136569 - KINTANA 820997
                           ,false, 0,dtmFolhaPrevia.qryProvento.FieldByName('FLGEXCLUICONTRIBPA').asInteger    //Osni Cavalcante - SIG 58950.59454
                           ) then
        dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de Correção '+
          dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring,
          self)
    else
       if objrubinserida <> nil then // FEFX - SIG43291
         VerificaIrrfDarfRegimeRegressivo(objRubInserida); // FEFX - SIG43291
    except
      on e:exception do
      begin
        dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de Correção '+
          dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring+'-'+e.message,
          self); 
      end;
    end;
  end
  else
    dtmFolhaPrevia.ExibeMensagem('Rubrica não encontrada (Correção Contribuição): '+inttostr(alidrubrica),
      self); 
end;

//ALTERADO PARA PROCESSAR TODOS OS ALTERADORES
procedure TObjRecebedor.CalculaCorrecaoTmpDesc;
 var alidrubrica, lii, licodalterador, liidregra : integer;
     lrvalorregra: double;
     objrub: tobjrubrica;
     lstipodesc, lssql: string;
     sCampos : String; // Renato Visoni SOL 123100 Kintana 616262
     qryAux : TwwQuery;    //edilaine WO19556
     iQtdRubrica : integer;      //edilaine WO38027
begin

  try
    qryAux := TwwQuery.Create(nil);        //edilaine WO19556
    qryAux.DataBaseName := 'BaseDados';    //edilaine WO19556

    lstRubricas.Sorted := false;             //edilaine WO38027

    if prmFlgCorrigeBenef = 1 then
    begin
      iQtdRubrica := lstRubricas.count;        //edilaine WO38027

      //CONTROLE DAS RUBRICAS PARA AS QUAIS SERÃO EXECUTADAS
      //  AS REGRAS DE ALTERADOR ATRAVÉS DE UMA LISTA TEMPORÁRIA DE RUBRICAS
      //for lii:=0 to lstRubricas.count-1 do             //edilaine WO38027
      for lii:=0 to iQtdRubrica-1 do                     //edilaine WO38027
      begin
        if (TobjRubrica(lstRubricas.objects[lii]).sflgtipodesc = 'P') and
           (TobjRubrica(lstRubricas.objects[lii]).smes < dtmFolhaPrevia.MesCobranca) then
        begin
          //edilaine WO32327 - inicio
          //lstRubTemp.AddObject(inttostr(lii),TobjRubrica(lstRubricas.objects[lii]));

          //for lii:=0 to lstRubTemp.count-1 do
          begin
            //objrub:=TobjRubrica(lstRubTemp.objects[lii]);
            objrub := TobjRubrica(lstRubricas.objects[lii]);

            //verifica se é contribuicao
            if objrub.iidcontribuicao > 0 then
            begin
              try
                if (objRub.sreferencia = 'CONTRIB') and
                   (objrub.iidmotivo <> prmidmotivofolhaben) and
                   (objrub.iidmotivo <> prmidmotivoabono) then
                begin
                  lssql:=
                    'SELECT H.VALOR, H.FLGTIPO, A.IDRUBDEVOLUCAO, A.IDRUBNORMAL '+_clinefeed+
                    'FROM HSTATRASOCONTRIB H, ALTERADORXCONTRIB A, HSTCONTRIBPREV HC '+_clinefeed+
                    'WHERE H.NUMRECEBIMENTO = '+inttostr(objrub.inumrecebimento)+' '+_clinefeed+
                    'AND H.MESCOBRANCA = '+quotedstr(dtmfolhaprevia.MesCobranca)+' '+_clinefeed+
                    'AND H.MESREFERENCIA = '+quotedstr(objrub.smes)+' '+_clinefeed+
                    'AND H.IDMOTIVO = '+inttostr(objrub.iidmotivo)+' '+_clinefeed+
                    'AND H.DATARECEBIMENTO IS NULL '+_clinefeed+
                    'AND H.VALORRECEBIDO IS NULL '+_clinefeed+
                    'AND HC.NUMRECEBIMENTO = H.NUMRECEBIMENTO '+_clinefeed+
                    'AND HC.MESCOBRANCA = H.MESCOBRANCA '+_clinefeed+
                    'AND HC.MESREFERENCIA = H.MESREFERENCIA '+_clinefeed+
                    'AND A.IDPLANOPREV = HC.IDPLANOPREV '+_clinefeed+
                    'AND A.IDCONTRIBUICAO = HC.IDCONTRIBUICAO '+_clinefeed+
                    'AND A.CODALTERADOR = H.CODALTERADOR '+_clinefeed+
                    'AND HC.IDPESSJUR = '+inttostr(self.iidpatro)+' '+_clinefeed+
                    //'AND HC.IDPESSOA = '+inttostr(self.iidresponsavel)+' '+_clinefeed+       // Andre Imakawa - SIG 86059
                    'AND HC.IDPESSOA = '+inttostr(objrub.iidpessoa)+' '+_clinefeed+            // Andre Imakawa - SIG 86059
                    'AND HC.IDPLANOPREV = '+inttostr(objrub.iidplanoprev)+' '+_clinefeed+
                    'AND HC.IDCONTRIBUICAO = '+inttostr(objrub.iidcontribuicao)+' '+_clinefeed;

                  if FazQuery({dtmFolhaPrevia.}qryAux, lssql) then
                  begin
                    while not {dtmFolhaPrevia.}qryAux.eof do
                    begin
                      if {dtmFolhaPrevia.}qryAux.fieldbyname('valor').asfloat <> 0 then
                      begin
                        if objrub.iflgdesconto = 1 then
                        begin
                          if {dtmFolhaPrevia.}qryAux.fieldbyname('valor').asfloat > 0 then
                          begin
                            if ({dtmFolhaPrevia.}qryAux.fieldbyname('FLGTIPO').asstring = 'A') then
                              alidrubrica:={dtmFolhaPrevia.}qryAux.fieldbyname('IDRUBNORMAL').asinteger;
                            if ({dtmFolhaPrevia.}qryAux.fieldbyname('FLGTIPO').asstring = 'D') then
                              alidrubrica:={dtmFolhaPrevia.}qryAux.fieldbyname('IDRUBDEVOLUCAO').asinteger;
                          end
                          else
                          begin
                            if ({dtmFolhaPrevia.}qryAux.fieldbyname('FLGTIPO').asstring = 'A') then
                              alidrubrica:={dtmFolhaPrevia.}qryAux.fieldbyname('IDRUBDEVOLUCAO').asinteger;
                            if ({dtmFolhaPrevia.}qryAux.fieldbyname('FLGTIPO').asstring = 'D') then
                              alidrubrica:={dtmFolhaPrevia.}qryAux.fieldbyname('IDRUBNORMAL').asinteger;
                          end;
                        end
                        else
                        begin
                          if {dtmFolhaPrevia.}qryAux.fieldbyname('valor').asfloat > 0 then
                          begin
                            if ({dtmFolhaPrevia.}qryAux.fieldbyname('FLGTIPO').asstring = 'D') then
                              alidrubrica:={dtmFolhaPrevia.}qryAux.fieldbyname('IDRUBNORMAL').asinteger;
                            if ({dtmFolhaPrevia.}qryAux.fieldbyname('FLGTIPO').asstring = 'A') then
                              alidrubrica:={dtmFolhaPrevia.}qryAux.fieldbyname('IDRUBDEVOLUCAO').asinteger;
                          end
                          else
                          begin
                            if ({dtmFolhaPrevia.}qryAux.fieldbyname('FLGTIPO').asstring = 'D') then
                              alidrubrica:={dtmFolhaPrevia.}qryAux.fieldbyname('IDRUBDEVOLUCAO').asinteger;
                            if ({dtmFolhaPrevia.}qryAux.fieldbyname('FLGTIPO').asstring = 'A') then
                              alidrubrica:={dtmFolhaPrevia.}qryAux.fieldbyname('IDRUBNORMAL').asinteger;
                          end;
                        end;
                        if (alidrubrica > 0) then
                        begin
                          lstipodesc:=dtmFolhaPrevia.BuscaDadosRubrica(self, alidrubrica, 'T');
                          if lstipodesc <> '' then
                          begin
                            try

                              //Renato Visoni SOL 123100 Kintana 616262
                              sCampos := inttostr(objrub.inumrecebimento)+dtmfolhaprevia.MesCobranca+objrub.smes+inttostr(objrub.iidmotivo)+
                                         inttostr(self.iidpatro)+inttostr(self.iidresponsavel)+inttostr(objrub.iidplanoprev)+
                                         inttostr(objrub.iidcontribuicao)+intTostr(alidrubrica);

                              if ListaProcessados.IndexOf(sCampos) <> -1 then begin
                                {dtmFolhaPrevia.}qryAux.Next;
                                continue;
                              end;

                              ListaProcessados.Add(sCampos);
                              //Renato Visoni SOL 123100 Kintana 616262

                              if not InsereRubrica(
                                  iidresponsavel,                                      //beneficiario
                                  0,                                                   //favorecido da rubrica
                                  0,                                                   //beneficio associado : pega beneficio base
                                  alidrubrica,                                         //codigo do provento
                                  dtmFolhaPrevia.qryProvento.FieldByName('flgdesconto').asinteger,    //flag de desconto
                                  dtmFolhaPrevia.qryProvento.FieldByName('flgespecial').asinteger,    //flag especial
                                  objrub.iidmotivo,         //motivo do desconto
                                  objrub.eseqrubrica,       //seqrubrica = 1
                                  icodmoedabase,                                       //codigo da moeda
                                  0,                                                   //regra de calculo
                                  dtmFolhaPrevia.qryProvento.FieldByName('CODFONTEPAGADORA').asinteger, //fonte pagadora
                                  dtmFolhaPrevia.qryProvento.FieldByName('flgirrf').asinteger, //indica se rubrica entra na base de IR
                                  dtmFolhaPrevia.qryProvento.FieldByName('FLGSALFAMILIA').asinteger, //indica se rubrica entra na composição do calculo do salario familia
                                  0,                                                   // Indica se o beneficio é provisorio
                                  Sistema.Idmodulo,                                    //sistema de origem da rubrica
                                  0,                                                   //flgSRB
                                  1,                                                   //flgOK
                                  0,                                                   //flgPA
                                  dtmFolhaPrevia.qryProvento.FieldByName('flgdescpensao').asinteger, //flgBasePA
                                  0,                                                   //flgconcessao
                                  0,                                                   //flgindividual
                                  dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalpart').asinteger,//compõe sal. participacao
                                  dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalbenef').asinteger,//compõe sal. benefício
                                  dtmFolhaPrevia.qryProvento.FieldByName('numprioridade').asinteger, //prioridade de desconto
                                  iidpessjur,                                           //id empresa p/ contabilização
                                  dtmFolhaPrevia.qryProvento.FieldByName('tipobasedesconto').asinteger, //tipo de base de desconto {abono,supl,inss,resgate}
                                  0,                                                   //código do alterador
                                  0,                                                   //id do plano de contas
                                  objrub.inumeroprocesso,
                                  objrub.snumprocinss,//'', //SOL 226688 KTN 2060535
                                  'T',                                                 //flg do tipo de desconto 'C', 'P', 'B', 'Y'
                                  0,                                                   //valor informativo associado a rubrica (base de calculo do IR)
                                  abs({dtmFolhaPrevia.}qryAux.fieldbyname('valor').asfloat),                 //valor da rubrica
                                  0,                                                   //valor base de calculo para a regra
                                  '***',                                               //referencia
                                  objrub.smes,        //mês de referência
                                  dtmFolhaPrevia.qryProvento.FieldByName('codirrfdarf').asstring, //código IRRF na SRF para o DARF
                                  '',                                                  //indice recebimento 'R'ou pagamento 'P'
                                  '',                                                  //código do tipo de recebimento ou desembolso
                                  '',                                                  //código do centro de custo
                                  '',                                                  //código do centro de responsabilidade
                                  '',                                                  //código da unidade de negócio
                                  '',                                                  //conta contábil associada
                                  '',                                                  //data inicio da rubrica
                                  '',                                                  //data final da rubrica
                                  dtmFolhaPrevia.qryProvento.FieldByName('descparcial').asinteger,    //indica se permite desconto parcial
                                  0,                                                   //usa no abono anual
                                  3,                                                   //origem da rubrica
                                  0,                                                  //lote original do desconto
                                  0,  // RUBRICA CONSIGNATARIO
                                  false, // ACEITA ZERO
                                  '',    // DATA PREVISTA DE PAGAMENTO - PEND 10826
                                  dtmFolhaPrevia.qryProvento.FieldByName('CODPROVDESC').asstring, //PARA GRAVAR CODPROVDESC NA PREVIA E EM SQL PARA REGRAS
                                  //0, //ATRIBUI ZERO PARA OBTER O IDPLANOPREV GLOBAL     // Andre Imakawa - SIG 102098
                                  objrub.iidplanoprev,                                    // Andre Imakawa - SIG 102098
                                  //0, //ATRIBUI ZERO PARA OBTER O IDPLANOORIGEM GLOBAL   // Andre Imakawa - SIG 102098
                                  objrub.iidplanoorigem,                                  // Andre Imakawa - SIG 102098
                                  //0, //ATRIBUI ZERO PARA OBTER O PLANO CONTABIL GLOBAL  // Andre Imakawa - SIG 102098
                                  objrub.iidplanocontabil,                                // Andre Imakawa - SIG 102098
                                  0, //RUBRICA CUJO SEQUENCIAL INTERNO É IRRELEVANTE PARA RETORNO
                                  dtmFolhaPrevia.qryProvento.FieldByName('FLGRUBLEGAL').asinteger,  //
                                  dtmFolhaPrevia.qryprevia.fieldbyname('MESCOMPREEM').asstring      // SOL 140042 Kintana 900220
                                  ,0
                                  ,''
                                  ,dtmFolhaPrevia.qryProvento.FieldByName('FLGMARGEM').asinteger         //Renato Visoni SOL 131523 KINTANA 750021
                                  ,0
                                  ,dtmFolhaPrevia.qryProvento.FieldByName('FLGREPROGRAMAR').asInteger    //Marcio Denilson - SOL 136569 - KINTANA 820997
                                  ,false, 0,dtmFolhaPrevia.qryProvento.FieldByName('FLGEXCLUICONTRIBPA').asInteger    //Osni Cavalcante - SIG 58950.59454
                                  ) then
                                dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de Correção da HstAtrasoContrib '+
                                  dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring,
                                  self)
                            else
                               if objrubinserida <> nil then // FEFX - SIG43291
                                 VerificaIrrfDarfRegimeRegressivo(objRubInserida); // FEFX - SIG43291
                            except
                              on e:exception do
                              begin
                                dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de Correção da HstAtrasoContrib '+
                                  dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring+'-'+e.message,
                                  self);
                              end;
                            end;
                          end
                          else
                            dtmFolhaPrevia.ExibeMensagem('Rubrica não encontrada (Correção Benefício da HstAtrasoContrib): '+inttostr(alidrubrica),
                              self);
                        end
                        else
                          dtmFolhaPrevia.ExibeMensagem('Rubrica de correção não parametrizada (da HstAtrasoContrib)',
                            self);
                      end
                      else
                        dtmFolhaPrevia.ExibeMensagem('Valor da HstAtrasoContrib lançado zero',
                          self);
                      {dtmFolhaPrevia.}qryAux.next;
                    end;
                    continue; //para não executar o calculo de alteradores
                  end;
                end;
              except
                on e:exception do
                begin
                  dtmFolhaPrevia.ExibeMensagem('Erro na busca de alteradores de contribuição lançados.'+
                    '-'+e.message,
                    self);
                end;
              end;

              //Verifica se rubrica é uma contribuição
              dtmFolhaPrevia.qryCorrecaoContrib.Close;
              dtmFolhaPrevia.qryCorrecaoContrib.ParamByName('IDPLANOPREV').asinteger:=
                objrub.iidplanoprev;
              dtmFolhaPrevia.qryCorrecaoContrib.ParamByName('IDRUBRICA').asinteger:=objrub.iidrubrica;
              dtmFolhaPrevia.qryCorrecaoContrib.ParamByName('IDCONTRIBUICAO').asinteger:=
                objrub.iidcontribuicao;
              if objrub.iflgdesconto = 1 then
              begin
                dtmFolhaPrevia.qryCorrecaoContrib.ParamByName('PFLGATRASO').asinteger:=1;
                dtmFolhaPrevia.qryCorrecaoContrib.ParamByName('PFLGDEVOL').asinteger:=0;
              end
              else
              begin
                dtmFolhaPrevia.qryCorrecaoContrib.ParamByName('PFLGATRASO').asinteger:=0;
                dtmFolhaPrevia.qryCorrecaoContrib.ParamByName('PFLGDEVOL').asinteger:=1;
              end;
              try
                dtmFolhaPrevia.qryCorrecaoContrib.Open;
                if not dtmFolhaPrevia.qryCorrecaoContrib.isempty then
                begin
                  while not dtmFolhaPrevia.qryCorrecaoContrib.eof do
                  begin
                    licodalterador:=dtmFolhaPrevia.qryCorrecaoContrib.FieldByName('codalterador').asinteger;
                    liidregra:=dtmFolhaPrevia.qryCorrecaoContrib.FieldByName('IdRegraCALCULO').asinteger;
                    if (liidregra <> 0) and (licodalterador <> 0) then
                    begin
                      if CalculaAlterador(objrub.sdtpagtoprev, objrub, licodalterador,
                           liidregra,
                           -1, ' ',
                           lrvalorregra) then
                        InsereRubricaAlterador(objrub, objrub.rvalorrecebido, lrvalorregra,
                          DeterminaRubricaCorrecao(lrvalorregra,
                            dtmFolhaPrevia.qryCorrecaoContrib.fieldbyname('idrubnormal').asinteger,
                            dtmFolhaPrevia.qryCorrecaoContrib.fieldbyname('idrubdevolucao').asinteger));
                    end;
                    dtmFolhaPrevia.qryCorrecaoContrib.next;
                  end;
                end;
              finally
                dtmFolhaPrevia.qryCorrecaoContrib.Close;
              end;
            end
            else
            begin
              //FAZER CORRECAO DE BENEFICIO QUE VEM DA TMPDESC
              dtmFolhaPrevia.qryCorrecaoBeneficio.Close;
              dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('IDPLANOPREV').asinteger:=
                objrub.iidplanoprev;
              dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('IDBENEFICIO').asinteger:=objrub.iidbeneficio;
              if objrub.iflgdesconto = 0 then
              begin
                dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('PFLGATRASO').asinteger:=1;
                dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('PFLGDEVOL').asinteger:=0;
              end
              else
              begin
                dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('PFLGATRASO').asinteger:=0;
                dtmFolhaPrevia.qryCorrecaoBeneficio.ParamByName('PFLGDEVOL').asinteger:=1;
              end;
              try
                dtmFolhaPrevia.qryCorrecaoBeneficio.Open;
                while not dtmFolhaPrevia.qryCorrecaoBeneficio.eof do
                begin
                  licodalterador:=dtmFolhaPrevia.qryCorrecaoBeneficio.FieldByName('codalterador').asinteger;
                  liidregra:=dtmFolhaPrevia.qryCorrecaoBeneficio.FieldByName('IdRegraCALCULO').asinteger;
                  if (liidregra <> 0) and (licodalterador <> 0) then
                  begin
                    if CalculaAlterador('', objrub, licodalterador, liidregra,
                         -1, ' ',
                         lrvalorregra) then
                      InsereRubricaAlterador(objrub, objrub.rvalorrecebido, lrvalorregra,
                        DeterminaRubricaCorrecao(lrvalorregra,
                          dtmFolhaPrevia.qryCorrecaoBeneficio.fieldbyname('idrubnormal').asinteger,
                          dtmFolhaPrevia.qryCorrecaoBeneficio.fieldbyname('idrubdevolucao').asinteger));
                  end;
                  dtmFolhaPrevia.qryCorrecaoBeneficio.next;
                end;
              finally
                dtmFolhaPrevia.qryCorrecaoBeneficio.Close;
              end;
            end;
          end;
          //edilaine WO32327 - fim
        end;
      end;
    end;
  finally
    lstRubricas.Sorted := true;     //edilaine WO38027

    qryAux.close;           //edilaine WO19556
    FreeAndNil(qryAux);     //edilaine WO19556
  end;
end;

