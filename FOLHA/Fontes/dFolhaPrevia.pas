    procedure verificaFlagsContabeis();
    var
       sSql : string;
       iflgcontabbenef, iflgcontababono, iflgcorrecaomonetaria, liindex : Integer ; // Andre Imakawa - SIG 20182
       sPlacontacorrecao, splacontaabono, smsgs :string ;
