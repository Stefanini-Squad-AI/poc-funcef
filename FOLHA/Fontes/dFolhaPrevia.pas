   QryProvdesc.close;
   QryProvdesc.SQL.clear;
   QryProvdesc.SQL.Add(auxSql);
   QryProvdesc.Open;

   if (QryProvdesc.FieldByName('flgbitributacao').AsInteger = 1) then
   begin

      auxSql := ' update hstbitributacao h ' + #13#10 +
                '   set h.valor = 0 ' + #13#10 +
                '  where h.idpessoa  = ' +Inttostr(aobjrub.iidpessoa) +#13#10 +
                '  and   h.idtitular = ' +Inttostr(pidtitular) +#13#10 +
