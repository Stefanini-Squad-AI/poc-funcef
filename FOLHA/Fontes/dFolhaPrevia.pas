          + '   AND NVL(FLGPROCESSADO,1) IN (1,2)    ';

  end;

        // SOL 248691 PPM 671922 retirar a data final
   if pflgdestbenef <> 'E' then //Andre Imakawa - SIG25700
   begin
     try
       with TwwQuery.Create(nil) do      //edilaine WO19556
