function TdtmFolhaPrevia.PegaDadosRecebedor(
  aobjrecmsg: TobjRecebedor): string; 
var Recebedor: TobjRecebedor;
begin

  if aobjrecmsg = nil then
    Recebedor:=objRecebedor
  else
    Recebedor:=aobjrecmsg;

  with Recebedor do
  begin
    if (smatricula = '') or (sinscricao = '') or (snome = '') then
    begin
      qryDadoTitular.close;
      qryDadoTitular.parambyname('pidtitular').asinteger:=iidtitular;
      qryDadoTitular.parambyname('pidpessjur').asinteger:=iidpatro;
      qryDadoTitular.parambyname('pidplanoprev').asinteger:=iidplanoorigemglobal;
      qryDadoTitular.open;
      if not qryDadoTitular.isempty then
      begin
        smatricula:=qryDadoTitular.fieldbyname('matricula').asstring;
        sinscricao:=qryDadoTitular.fieldbyname('inscricaonumero').asstring;
      end;
      dtmFolhaPrevia.qryDadoTitular.close; 
      qryDadoRecebedor.close;
      qryDadoRecebedor.parambyname('pidpessoa').asinteger:=iidresponsavel;
      qryDadoRecebedor.open;
      if not qryDadoRecebedor.isempty then
        snome:=qryDadoRecebedor.fieldbyname('nome').asstring;
      dtmFolhaPrevia.qryDadoRecebedor.close; 
    end;
    result:='Matricula : '+smatricula+ ' Inscrição : '+sinscricao+
            ' Nome : '+snome;
  end;
  qryDadoRecebedor.Close;// SOL 242740 PPM 575822
end;

