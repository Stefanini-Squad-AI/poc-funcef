         dtmFolhaPrevia.qryAux.Open;
         idPlanoPrev := dtmFolhaPrevia.qryAux.FieldByName('IDPLANOPREVPREV').AsInteger;
         dtmFolhaPrevia.qryAux.Close;
       except

       end;
   end
   else
   begin

      aobjrecebedor.ObtemContabilDoPlano(pidplanoprev,piIDPlanoPrevContabil,lsplacontaliquidoAux);

      SQL := 'SELECT IDPLANOPREVPREV' + #13 +
              ' FROM PLANPREVCONTABIL' + #13 +
              ' WHERE IDPLANOPREV = ' + IntToStr(piIDPlanoPrevContabil) + #13;
      try
         dtmFolhaPrevia.qryAux.Close;
         dtmFolhaPrevia.qryAux.SQL.Clear;
         dtmFolhaPrevia.qryAux.SQL.Add(SQL);
         dtmFolhaPrevia.qryAux.Open;
         idPlanoPrev := dtmFolhaPrevia.qryAux.FieldByName('IDPLANOPREVPREV').AsInteger;
         dtmFolhaPrevia.qryAux.Close;
      except

      end;

   end;

   if idPlanoPrev = 0 then
      idPlanoPrev := aobjrecebedor.iidplanoorigemglobal;

   Result :=  idPlanoPrev;
end;
