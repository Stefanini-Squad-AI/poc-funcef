//procedure TobjRecebedor.VerificaIrrfDarfRegimeRegressivo(aobjrub : TobjRubrica);      //edilaine WO32047
procedure TobjRecebedor.VerificaIrrfDarfRegimeRegressivo(var aobjrub : TobjRubrica);    //edilaine WO32047
var
   auxSql : String;
   participanteOptaIRREgressivo : Boolean;
   //lidPlanoprev: Integer; // Andre Imakawa - SIG 24174  //Andre Imakawa - SIG 27217
   lidPlanoprevfiltro: Integer; // Andre Imakawa - SIG 50589
   QryDarf : TwwQuery;          //edilaine WO32047
begin

  if aobjrub.ifontepagadora = 2 then Exit; // Andre Imakawa - SIG25949

  participanteOptaIRREgressivo := False;

  // Andre Imakawa - SIG 50589 - Inicio
  {
  // Andre Imakawa - SIG 48125 - Inicio
  if (aobjrub.iidplanoprev = 0) then
    aobjrub.iidplanoprev := dtmFolhaPrevia.RetornaIdPlanoPrevRubrica(aobjrub);
  // Andre Imakawa - SIG 48125 - Fim
  }
  lidPlanoprevfiltro :=  aobjrub.iidplanoprev;
  if (aobjrub.sflgtipodesc = 'Y' ) and (aobjrub.iflgPA = 1) and (aobjrub.iidplanoprev = 0) then
    lidPlanoprevfiltro :=  iidplanoprevglobal
  else
    lidPlanoprevfiltro := aobjrub.iidplanoprev;

  // Andre Imakawa - SIG 50589 - Fim

  //Andre Imakawa - SIG 27217 - Inicio
  {
  // Andre Imakawa - SIG 24174 - Inicio
  if aobjrub.sflgtipodesc = 'Y' then
     lidPlanoprev := self.RetornaIdPlanoPrev(aobjrub.iidplanocontabil,aobjrub.iidplanoprev,Self)
  else
     lidPlanoprev := aobjrub.iidplanoprev;
  // Andre Imakawa - SIG 24174 - Fim
  }
  //Andre Imakawa - SIG 27217 - Fim

  //auxSql := ' SELECT * ' +#13+
  //wo20725 - leandro - inicio
  if Self.iidtitular = aobjrub.iidpessoa then
  begin
    auxSql := ' SELECT 1 ' +#13+
                  ' FROM PARTPREVPLAN PART ' +#13+
                  ' WHERE PART.IDPESSOA = ' + IntToStr(Self.iidtitular) +#13+//IntToStr(Self.iidresponsavel) +#13+
                  ' AND PART.IDPESSJUR = ' + IntToStr(Self.iidpatro) +#13+
                  ' AND PART.IDPLANOPREV = ' + IntToStr(lidPlanoprevfiltro) +#13+ // Andre Imakawa - SIG 50589
                  //' AND PART.IDPLANOPREV = ' + IntToStr(aobjrub.iidplanoprev) +#13+  // Andre Imakawa - SIG 24174 //Andre Imakawa - SIG 27217 // Andre Imakawa - SIG 50589
                  //' AND PART.IDPLANOPREV = ' + IntToStr(lidPlanoprev) +#13+  // Andre Imakawa - SIG 24174 //Andre Imakawa - SIG 27217
                  ' AND PART.TIPOOPCAOIR = 2 ';// +#13+
                 // ' AND PART.FLGDESATIVADO <> 1';   // SOL 246290 PPM 642043

    //edilaine - SIG71773 - inicio
    {verifica também casos em que o beneficio tem opcao de IR diferente do plano}
    if aobjrub.sflgtipodesc = 'B' then
    begin
       auxSql := StringReplace(auxSql, 'AND PART.TIPOOPCAOIR = 2', 'AND ((PART.TIPOOPCAOIR = 2', [rfIgnoreCase]);
       auxSql := auxSql +
                  ' AND NOT EXISTS (SELECT 1  ' +#13+
                  '                   FROM BENEFBFCIARIO BF ' +#13+
                  '                   JOIN BENEFICIO B ON B.IDBENEFICIO = BF.IDBENEFICIO ' +#13+
                  '                  WHERE BF.IDPESSJUR   = PART.IDPESSJUR   ' +#13+
                  '                    and BF.IDPLANOPREV = PART.IDPLANOPREV ' +#13+
                  '                    and BF.IDPESSOA    = PART.IDPESSOA    ' +#13+
                  '                    and BF.NUMEROPROCESSO = '+IntToStr(Self.inumeroprocesso) +#13+
                  '                    and B.FLGPORTADO = 1       ' +#13+
                  '                    and B.FLGIRREGRESSIVO = 0))' +#13+

                  ' OR EXISTS (SELECT 1  ' +#13+
                  '               FROM BENEFBFCIARIO BF ' +#13+
                  '               JOIN BENEFICIO B ON B.IDBENEFICIO = BF.IDBENEFICIO ' +#13+
                  '              WHERE BF.IDPESSJUR   = PART.IDPESSJUR   ' +#13+
                  '                and BF.IDPLANOPREV = PART.IDPLANOPREV ' +#13+
                  '                and BF.IDPESSOA    = PART.IDPESSOA    ' +#13+
                  '                and BF.NUMEROPROCESSO = '+IntToStr(Self.inumeroprocesso) +#13+
                  '                and B.FLGPORTADO = 1       ' +#13+
                  '                and B.FLGIRREGRESSIVO = 1))';
    end;
    //edilaine - SIG71773 - fim
  end
  else
  begin
    auxSql := ' SELECT max(BTT.TIPOOPCAOIR) AS TIPOOPCAOIR ,BTT.IDPESSJUR, BTT.IDTITULAR, BTT.IDPESSOA, BTT.SEQPROPOSTA, BTT.IDPLANOPREV, BTT.IDPLANOORIGEM   ' +#13+
              ' FROM bfciariotitplan BTT ' +#13+
              //' WHERE BTT.IDPESSOA = ' + IntToStr(Self.iidtitular) +#13+     //WO25758 - Leandro
              ' WHERE BTT.IDPESSOA = ' + IntToStr(aobjrub.iidpessoa) +#13+     //WO25758 - Leandro
              ' AND BTT.IDTITULAR  = ' + IntToStr(Self.iidtitular) +#13+       //edilaine WO32047
              ' AND BTT.IDPESSJUR = ' + IntToStr(Self.iidpatro) +#13+
              ' AND BTT.IDPLANOPREV = ' + IntToStr(lidPlanoprevfiltro) +#13+
              ' AND BTT.TIPOOPCAOIR = 2 ' +#13+
              ' GROUP BY BTT.IDPESSJUR, BTT.IDTITULAR, BTT.IDPESSOA, BTT.SEQPROPOSTA, BTT.IDPLANOPREV, BTT.IDPLANOORIGEM ';

  end;
  //WO20725 - LEANDREO - FIM

  //with TwwQuery.Create(nil) do             //edilaine WO19556
   QryDarf := TwwQuery.create(nil);          //edilaine WO32047
   try
      with QryDarf do
      begin
        DataBaseName := dtmBaseDados.dbBaseDados.DataBaseName;

        SQL.Add(auxSql);
        Open;

        if Not IsEmpty then
        // Andre Imakawa - SIG 23057 - Inicio
        begin
           participanteOptaIRREgressivo := True;
           aobjrub.iOptaIRREgressivo := 1;
        end;
        // Andre Imakawa - SIG 23057 - Fim


        //se o participante opta pelo ir regressivo
        //carrega irrfdarfreg ao inves de irrfdarf
        //if participanteOptaIRREgressivo then
        //begin
        auxSql := ' SELECT CODIRRFDARFREG, CODIRRFDARF FROM PROVDESC WHERE IDPROVENTO = ' + IntToStr(aobjrub.iidrubrica);

         //with TwwQuery.Create(nil) do        //edilaine WO19556              //edilaine WO32047
         //begin                                                               //edilaine WO32047
         //       DataBaseName := dtmBaseDados.dbBaseDados.DataBaseName;       //edilaine WO32047

        Close;
        SQL.Clear;
        SQL.Add(auxSql);
        Open;
        // Andre Imakawa - SIG 33052 - Inicio
        if (frmFolhaNormalPrevia.chkResgate.Checked) and (aobjrub.sflgtipodesc = 'B') then
          begin
            if participanteOptaIRREgressivo then
              // Andre Imakawa - SIG 40670 - Inicio
              if not(FieldByName('CODIRRFDARFREG').Isnull) then
               aobjrub.scodirrfdarf := FieldByName('CODIRRFDARFREG').AsString
             else
                aobjrub.scodirrfdarf := FieldByName('CODIRRFDARF').AsString
              // Andre Imakawa - SIG 40670 - Fim
            else
            begin
              aobjrub.scodirrfdarf := FieldByName('CODIRRFDARF').AsString;
              if (sTpModalidade = 'BD') then
                aobjrub.scodirrfdarf := '3556';
            end;
          end
        else
          begin
            if participanteOptaIRREgressivo then
              // Andre Imakawa - SIG 40670 - Inicio
              if not(FieldByName('CODIRRFDARFREG').Isnull) then
               aobjrub.scodirrfdarf := FieldByName('CODIRRFDARFREG').AsString
            else
                aobjrub.scodirrfdarf := FieldByName('CODIRRFDARF').AsString
              // Andre Imakawa - SIG 40670 - Fim
            else
               aobjrub.scodirrfdarf := FieldByName('CODIRRFDARF').AsString;
          end;
        // Andre Imakawa - SIG 33052 - Fim

        //Close;
        //Free;
      end;//with

   finally
     QryDarf.Close;
     FreeAndNil(QryDarf);
   end;
   //end;//if
end;


