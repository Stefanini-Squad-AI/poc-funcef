    //USAR FLGCONCESSAO DA HSTBENEFBFCIARIO
    if dtmFolhaPrevia.qryPrevia.FieldByName('flgconcessaohst').asinteger = 0 then
    begin
      bExecuta:=false;
      if not dtmFolhaPrevia.qryPrevia.fieldbyname('DATAFINAL').isnull then
      begin
        bExecuta:=EstaNoMes(dtmFolhaPrevia.qryPrevia.fieldbyname('DATAFINAL').asdatetime,
                            dtmFolhaPrevia.qryPrevia.fieldbyname('MESREFERENCIA').asstring);
        lsdatafinal:=formatdatetime('dd/mm/yyyy',
          dtmFolhaPrevia.qryPrevia.fieldbyname('DATAFINAL').asdatetime);
      end
      else
        if not dtmFolhaPrevia.qryPrevia.fieldbyname('DATAFINALPREVISTA').isnull then
        begin
          bExecuta:=EstaNoMes(dtmFolhaPrevia.qryPrevia.fieldbyname('DATAFINALPREVISTA').asdatetime,
                              dtmFolhaPrevia.qryPrevia.fieldbyname('MESREFERENCIA').asstring);
          lsdatafinal:=formatdatetime('dd/mm/yyyy',
            dtmFolhaPrevia.qryPrevia.fieldbyname('DATAFINALPREVISTA').asdatetime);
        end;

      if bExecuta then
      begin
        sSQL:= 'SELECT '+OraNumero(dtmFolhaPrevia.qryPrevia.fieldbyname('VALORTOTAL').asstring)+ ' VALORTOTAL,' +
                OraNumero(lsvalor)+ ' VALORATUAL,' +
                OraNumero(lsvalor)+ ' VLBENEFPGTO,'+
                OraNumero(lsvalor)+ ' VALORREFERENCIA,'+
                QuotedStr('01/'+copy(lsDataFinal,4,10))+' DATAINICIO,' +
                QuotedStr(lsDataFinal) +' DATAFINAL, ' +
                QuotedStr('01/'+copy(lsDataFinal,4,10))+' DATAREF, ' +
                inttostr(linumBenef)+' NUMBENEF, '+
                OraNumero(dtmFolhaPrevia.qryPrevia.fieldbyname('VLRINFINSS').asstring) + ' VLRINFINSS, '+
                '''AS'' FLGINTERNOANT, '+
                Inttostr(Sistema.IdModulo)+ ' AS IDMODULO, 2 AS TIPOPROCESSO, '+
                dtmFolhaPrevia.qryPrevia.fieldbyname('FLGBENEFMIN').asstring + ' FLGBENEFMIN, '+
                dtmFolhaPrevia.qryPrevia.fieldbyname('IDSITPART').asstring + ' IDSITPARTNOVO, '+
                dtmFolhaPrevia.qryPrevia.fieldbyname('IDSITPART').asstring + ' IDSITPARTATUAL, '+
                dtmFolhaPrevia.qryPrevia.fieldbyname('IDSITPLANOPREV').asstring + ' IDSITPLANONOVO, '+
                dtmFolhaPrevia.qryPrevia.fieldbyname('IDSITPLANOPREV').asstring + ' IDSITPLANOATUAL, '+
                dtmFolhaPrevia.qryPrevia.fieldbyname('IDSITFUNC').asstring + ' IDSITFUNCNOVO, '+
                dtmFolhaPrevia.qryPrevia.fieldbyname('IDSITFUNC').asstring + ' IDSITFUNCATUAL, '+
                dtmFolhaPrevia.qryPrevia.fieldbyname('IDPLANOPREV').asstring + ' IDPLANOPREV, '+
                //USAR FLGCONCESSAO DA HSTBENEFBFCIARIO
                dtmFolhaPrevia.qryPrevia.FieldByName('FLGCONCESSAOHST').asstring + ' FLGCONCESSAO, '+
                dtmFolhaPrevia.qryPrevia.FieldByName('IDBENEFICIO').asstring + ' IDBENEFICIO, '+
                dtmFolhaPrevia.qryPrevia.fieldbyname('TEMPOSERVTOTAL').asstring + ' TEMPOSERVTOTAL FROM DUAL';
        try
          lss:=RegraNumerica(Inttostr(dtmFolhaPrevia.qryPrevia.fieldbyname('IDREGRAULTPAGTO').asinteger),
                             sSQL, bErro, iIdCalculoGeral);
          try
            lrvalorbenefmin:=strtofloat(ClienteNumero(lss));
          except
            on e:exception do
            begin
              dtmFolhaPrevia.ExibeMensagem('Erro[EXECUÇÃO DA REGRA] - Número : '+
                inttostr(dtmFolhaPrevia.qryPrevia.fieldbyname('IDREGRAULTPAGTO').asinteger)+'-'+e.message,
                self); 
              //MOSTRA SQL DA REGRA NO MEMO - PEND. 14949
              dtmFolhaPrevia.ExibeMensagemSemRecebedor('SQL para Regra: '+sSQL);
            end;
          end;
        except
          on e:exception do
          begin
            dtmFolhaPrevia.ExibeMensagem('Erro[EXECUÇÃO DA REGRA] - Número : '+
              inttostr(dtmFolhaPrevia.qryPrevia.fieldbyname('IDREGRAULTPAGTO').asinteger)+'-'+e.message,
              self); 
          end;
        end;
