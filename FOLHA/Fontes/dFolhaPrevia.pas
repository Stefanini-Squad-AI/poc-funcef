                  except
                    on e:exception do
                    begin
                      dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de Correção da HstAtrasoBenef '+
                        dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring+'-'+e.message,
                        self); 
                    end;
                  end;
                end
                else
                  dtmFolhaPrevia.ExibeMensagem('Rubrica não encontrada (Correção Benefício da HstAtrasoBenef): '+inttostr(alidrubrica),
                    self);
              end
              else
                dtmFolhaPrevia.ExibeMensagem('Rubrica de correção não parametrizada (da HstAtrasoBenef)',
