// Andre Imakawa - SIG 99651 - Inicio
function TobjRecebedor.VerificaProporcaoPlanos(var aProgressivo: boolean; var aRegressivo: boolean; piIDPessoa, piIDPlanoPrev: Integer): Boolean; // wo20725 leandro
var
  liContador, lii: integer;
  liTotProgressivo, liTotRegressivo: integer;
  objPlano: tobjPlano;
  rValorProgressivo, rValorRegressivo, rValorProgressivo13, rValorRegressivo13: Real;
  Query: TwwQuery;
begin
  try

    result := false;

    Query := TwwQuery.Create(nil);        //edilaine WO19556
    Query.DataBaseName := 'BaseDados';

    Query.close;
    Query.sql.Clear;



    //WO20725 - Leandro - inicio
    if iidTitular = piIDPessoa then
    begin
      Query.SQL.Clear;
      Query.SQL.Add('  SELECT PP.IDPLANOPREV, DECODE(PP.TIPOOPCAOIR,2,2,1) OPCAO_IR ');
      Query.SQL.Add('    FROM PARTPREVPLAN PP  ');
      Query.SQL.Add('  WHERE PP.IDPESSOA = ' + intTostr(iIDTITULAR));
    end
    else
    begin
      Query.SQL.Clear;
      Query.SQL.Add(' SELECT max(DECODE(bt.TIPOOPCAOIR,2,2,1)) AS OPCAO_IR ,bt.IDPESSJUR, bt.IDTITULAR, bt.IDPESSOA, bt.SEQPROPOSTA, bt.IDPLANOPREV, bt.IDPLANOORIGEM' );
      Query.SQL.Add(' FROM bfciariotitplan bt');
      //Query.SQL.Add(' WHERE IDPESSOA =  ' + intTostr(iIDTITULAR)); //WO25758 - Leandro
      Query.SQL.Add(' WHERE IDPESSOA  = ' + intTostr(piIDPessoa));   //WO25758 - Leandro
      Query.SQL.Add('   AND IDTITULAR = ' + intTostr(iIDTITULAR));   //edilaine WO36319
      //Query.SQL.Add(' AND   IDPLANOPREV  = ' + intTostr(piIDPlanoPrev));
      Query.SQL.Add(' GROUP BY bt.IDPESSJUR, bt.IDTITULAR, bt.IDPESSOA, bt.SEQPROPOSTA, bt.IDPLANOPREV, bt.IDPLANOORIGEM');
    end;
    //WO20725 - Leandro - fim

    Query.Open;

    liTotProgressivo := 0;
    liTotRegressivo := 0;
    rValorProgressivo := 0;
    rValorProgressivo13 := 0;
    rValorRegressivo := 0;
    rValorRegressivo13 := 0;

    for lii := 0 to lstPlanos.count - 1 do
    begin
      objPlano := (lstPlanos.objects[lii] as tobjplano);

      Query.First;
      while not Query.eof do
      begin
        if (objPlano.FPlanoPrev = Query.fieldbyname('IDPLANOPREV').asInteger) then
          objPlano.OpcaoIR := Query.fieldbyname('OPCAO_IR').asInteger;
        Query.Next;
      end;
    end;

    if (lstPlanos.count > 1) then
    begin
      for lii := 0 to lstPlanos.count - 1 do
      begin
        objPlano := (lstPlanos.objects[lii] as tobjplano);

        Query.First;
        while not Query.eof do
        begin
          if (objPlano.FPlanoPrev = Query.fieldbyname('IDPLANOPREV').asInteger) then
            objPlano.OpcaoIR := Query.fieldbyname('OPCAO_IR').asInteger;
          Query.Next;
        end;

        if objPlano.OpcaoIR <> 2 then // Andre Imakawa - WO4625
        begin
          inc(liTotProgressivo);
          rValorProgressivo := rValorProgressivo + objPlano.ValorRateio;
          rValorProgressivo13 := rValorProgressivo13 + objPlano.ValorRateio13;
        end
        else if objPlano.OpcaoIR = 2 then
        begin
          inc(liTotRegressivo);
          rValorRegressivo := rValorRegressivo + objPlano.ValorRateio;
          rValorRegressivo13 := rValorRegressivo13 + objPlano.ValorRateio13;
        end;

      end;

      for lii := 0 to lstPlanos.count - 1 do
      begin
        objPlano := (lstPlanos.objects[lii] as tobjplano);

        if objPlano.OpcaoIR <> 2 then // Andre Imakawa - WO4625
        begin
          if (rValorProgressivo > 0) and (objPlano.ValorRateio > 0) then
            objPlano.PorcentoRateio := RoundCM(((objPlano.ValorRateio * 100) / rValorProgressivo), 4);
          if (rValorProgressivo13 > 0) and (objPlano.ValorRateio13 > 0) then
            objPlano.PorcentoRateio13 := RoundCM(((objPlano.ValorRateio13 * 100) / rValorProgressivo13), 4);
        end
        else if objPlano.OpcaoIR = 2 then
        begin
          if (rValorRegressivo > 0) and (objPlano.ValorRateio > 0) then
            objPlano.PorcentoRateio := RoundCM(((objPlano.ValorRateio * 100) / rValorRegressivo), 4);
          if (rValorRegressivo13 > 0) and (objPlano.ValorRateio13 > 0) then
            objPlano.PorcentoRateio13 := RoundCM(((objPlano.ValorRateio13 * 100) / rValorRegressivo13), 4);
        end;
      end;

      aProgressivo := (liTotProgressivo > 1);
      aRegressivo := (liTotRegressivo > 1);

      if (liTotRegressivo > 1) or (liTotProgressivo > 1) then
        result := true;
    end;
  finally
    Query.close;
    FreeAndNil(Query);
  end;

end;

