//Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
procedure TObjRecebedor.CorrigeValorDescontoBaseDePagamentoPrevia;
var
  sSQL : String;
  Query, QueryOpIR :TwwQuery;  //SOL 207789/16579 PPM 543916
  rValorDesconto, rValorProvento : Real;
  lii, iidPessoa, iidplanoprev, iidBeneficio, iIdTipoOpIR, iIdBasePagamento : Integer;//SOL 207789/16579 PPM 543916
  objrub : tobjrubrica; //SOL 207789/16579 PPM 543916
  rIrCompensado13, rIrCompensado, rInformativo, rInformativo13: Real; // SOL 207789/16579 PPM 543916
  sNumProcINSS, sNumBanco, sNumAgencia, sContaCorrente : String; // SOL 207789/16579 PPM 543916
  iIdFavorecidoRecebedor  : Integer;//SOL 207789/16579 PPM 543916
begin
  try
    
    rValorDesconto   := 0;
    rValorProvento   := 0;
    rInformativo13   := 0;
    rInformativo     := 0;
    rIrCompensado13  := 0;
    rIrCompensado    := 0;
    iIdBasePagamento := 0; // SOL 207789/16579 PPM 543916 inicio
    rValorDesconto   := 0;
    rValorProvento   := 0;

    Query := TwwQuery.Create(nil);         //edilaine WO19556
    Query.DataBaseName := 'BaseDados';
    // SOL 207789/16579 PPM 543916 inicio
    QueryOpIR := TwwQuery.Create(nil); //SOL 207789/16579 PPM 543916          //edilaine WO19556
    QueryOpIR.DataBaseName := 'BaseDados'; //SOL 207789/16579 PPM 543916

    //calcula o valor de desconto
    sNumProcINSS := '';
    for lii := 0 to lstRubricas.Count -1 do
    begin
      objrub := (lstRubricas.objects[lii] as tobjrubrica);

      iidPessoa := objrub.iidpessoa;

      if (ListaBeneficiosPessoa.IndexOf(IntToStr(objrub.iidbeneficio)) < 0) then  //SOL 258019 PPM 977651
      begin
         if objrub.iidplanoprev <> 0 then
            iidplanoprev := objrub.iidplanoprev
         else
            iidplanoprev := iidplanoprevglobal;

         //WO20725 - Leandro - inicio
         if iidPessoa = iidTitular then
         begin
           sSQL := ' SELECT NVL(TIPOOPCAOIR,1) AS TIPOOPCAOIR FROM PARTPREVPLAN  '+#13+
                   ' WHERE IDPESSOA =  '+IntToStr(iidtitular)+#13+
                   ' AND   IDPLANOPREV  = '+IntToStr(iidplanoprev);
         end
         else
         begin
           //sSQL := ' SELECT NVL(TIPOOPCAOIR,1) AS TIPOOPCAOIR  '+#13+               //edilaine WO36319
           sSQL := ' SELECT max(DECODE(TIPOOPCAOIR,2,2,1)) AS TIPOOPCAOIR  '+#13+     //edilaine WO36319
                   ' FROM bfciariotitplan  '+#13+
                   ' WHERE IDPESSOA =  '+IntToStr(iidPessoa)+#13+
                   ' AND   IDPLANOPREV  = '+IntToStr(iidplanoprev)+#13+
                   ' AND   IDTITULAR    = '+IntToStr(iidtitular);                     //edilaine WO36319
                   //' AND   IDBENEFICIO = '+IntToStr(objrub.iidbeneficio);           //edilaine WO36319
         end;
         //WO20725 - Leandro - fim

         Query.Close;
         Query.SQL.clear;
         Query.SQL.Add(sSQL);
         Query.open;


         if QuotedStr(Query.FieldByName('TIPOOPCAOIR').AsString) =  '2' then
            iIdTipoOpIR := 2
         else
            iIdTipoOpIR := 1;


         if objrub.iidbeneficio > 0 then
         begin
            sSQL := 'INSERT INTO BASEDEPAGAMENTOAPOIO' + #13#10 +
                    '    (  IDBASEPGTOAPOIO' + #13#10 +
                    '     , IDBASEPGTO' + #13#10 +
                    '      , TIPOOPCAOIR' + #13#10 +
                    '      , IDBENEFICIO' + #13#10 +
                    '      , IDPLANOPREV' + #13#10 +
                    '     )' + #13#10 +
                    '   VALUES' + #13#10 +
                    '     ( CM.SEQBASEPAGAMENTOAPOIO.NEXTVAL' + #13#10 +
                    //'     , '+IntToStr(iIdBasePgto)+' '+ #13#10 +                                   //edilaine SIG90547
                    '     , '+IntToStr(self.iIdBasePagamento)+' '+ #13#10 +    //edilaine SIG90547
                    '     , '+IntToStr(iIdTipoOpIR)+' '+ #13#10 +
                    '     , '+IntToStr(objrub.iidbeneficio)+' '+ #13#10 +
                    '     , '+IntToStr(iidplanoprev)+ ' )';



            Query.Close;
            Query.SQL.clear;
            Query.SQL.Add(sSQL);
            Query.ExecSQL;

         end;
         iidplanoprev := objrub.iidplanoprev;
         iidBeneficio := objrub.iidbeneficio;

         ListaBeneficiosPessoa.Add(IntToStr(objrub.iidbeneficio));



      end;


      //SOL 207789/16579 PPM 543916
      // IRRF Compensado: É a rubrica IRCOMPENSADO da tabela PREVIA (CODPROVDESC = 36952).
      if objrub.scodprovdesc = '36952' then
         rIrCompensado := rIrCompensado + objrub.rvalorrecebido;

      // IRRF Compensado Décimo Terceiro: É a rubrica IRCOMPENSADO13 da tabela PREVIA (CODPROVDESC = 38894).

      if objrub.scodprovdesc = '38894' then
         rIrCompensado13 := rIrCompensado13 + objrub.rvalorrecebido;

      // IRRF Informativo (IRINFORMATIVO): É a rubrica IRINFORMATIVO da tabela PREVIA (CODPROVDESC = 435304 , 38390). O sistema deverá realizar o somatório das duas rubricas, caso o participante tenha os dois regristros na tabela PREVIA para os parâmetros informados.
      if (objrub.scodprovdesc = '435304') or (objrub.scodprovdesc =  '38390') then
         rInformativo := rInformativo + objrub.rvalorinfo;

      // IRRF Informativo Décimo Terceiro (IRINFORMATIVO13): É a rubrica IRINFORMATIVO13 da tabela PREVIA (CODPROVDESC = 435404 , 38912). O sistema deverá realizar o somatório das duas rubricas, caso o participante tenha os dois regristros na tabela PREVIA para os parâmetros informados.
      if (objrub.scodprovdesc = '435404') or (objrub.scodprovdesc =  '38912') then
         rInformativo13 := rInformativo13 + objrub.rvalorinfo;

      if trim(sNumProcINSS) = '' then
         sNumProcINSS     := objrub.snumprocinss;

      sNumBanco      := NumBanco;
      sNumAgencia    := NumAgencia;
      sContaCorrente := ContaCorrente;

      // SOL 207789/16579 PPM 543916 final

      if objrub.sflgtipodesc <> 'K' then
      begin
         if objrub.iflgdesconto = 1 then   //SOL 207789/16579 PPM 543916
         begin
            rValorDesconto := rValorDesconto + roundCM(objrub.rvalorprovento,2);
         end
         else
         begin
            rValorProvento := rValorProvento + roundCM(objrub.rvalorprovento,2);
         end;
      end;

    end;
    if trim(sNumBanco) <> '' then
       sNumBanco      := NumBanco
    else
       sNumBanco   := '';

    if trim(sNumAgencia) <> '' then
       sNumAgencia      := sNumAgencia
    else
       sNumAgencia   := '';

    if trim(sContaCorrente) <> '' then
       sContaCorrente      := sContaCorrente
    else
       sContaCorrente   := '';



    //atualiza o valor em basedepagamentoprevia
    //sSQL := ' UPDATE BASEDEPAGAMENTOPREVIA ' +#13+ // SOL 207789/16579 PPM 543916
    sSQL := ' UPDATE BASEDEPAGAMENTO ' +#13+ // SOL 207789/16579 PPM 543916
            ' SET VLRDESCONTO = ' + OraNumero(FloatToStr(rValorDesconto)) +#13+ //SIG51216

            ' ,IRCOMPENSADO    = ' + OraNumero(FloatToStr(rIrCompensado)) +#13+ //SIG51216
            ' ,IRCOMPENSADO13  = ' + OraNumero(FloatToStr(rIrCompensado13)) +#13+ //SIG51216
            ' ,IRINFORMATIVO   = ' + OraNumero(FloatToStr(rInformativo)) +#13+ //SIG51216
            ' ,IRINFORMATIVO13 = ' + OraNumero(FloatToStr(rInformativo13)) +#13+ //SIG51216
            ' ,NUMPROCINSS     = ' + QuotedStr(sNumProcINSS);

            if trim(sNumBanco) <> '' then
            begin
               sSQL :=  sSQL + ' ,NUMBANCO          = ' + QuotedStr(sNumBanco) +#13+
                               ' ,NUMAGENCIA        = ' + QuotedStr(sNumAgencia) +#13+
                               ' ,CONTACORRENTE     = ' + QuotedStr(sContaCorrente);
            end;
    sSQL :=  sSQL + ' ,VLRBRUTO = ' + OraNumero(FloatToStr(rValorProvento)) +#13+
                    //' ,VLRLIQUIDO = (' + Float2String(rValorProvento) +  //SIG51216
                    //' - '+ Float2String(rValorDesconto) + ')' +#13+    //SIG51216
                    ' ,VLRLIQUIDO = (' + OraNumero(FloatToStrf((rValorProvento-rValorDesconto),ffnumber,15,2)) + ')' +#13+   //SIG51216

                    // Andre Imakawa - SIG 62918 - Incio
                    {
                    ' WHERE IDTITULAR = ' + IntToStr(iidtitular) +#13+
                    //' AND IDPESSOA    = ' + IntToStr(iidPessoa) +#13+           // Andre Imakawa - SIG 51216
                    ' AND IDPESSOA    = ' + IntToStr(iidresponsavel) +#13+        // Andre Imakawa - SIG 51216
                    ' AND IDLOTE      = ' + IntToStr(iidlote) +#13+
                    ' AND MESCOBRANCA = ' + QuotedStr(dtmFolhaPrevia.MesCobranca);
                    }
                    ' WHERE IDBASEPGTO = '+IntToStr(self.iIdBasePagamento);    //edilaine SIG90547
                    //' WHERE IDBASEPGTO = '+IntToStr(iIdBasePgto);                                    //edilaine SIG90547
                    // Andre Imakawa - SIG 62918 - Fim


    Query.Close;
    Query.SQL.clear;
    Query.SQL.Add(sSQL);
    //CMDebugToFile(#13#10 + sSQL + #13#10);

    Query.ExecSQL;
  finally
    Query.close;
    FreeAndNil(Query);      //Query.free; //edilaine WO19556

    QueryOpIR.close;
    FreeAndNil(QueryOpIR);  //QueryOpIR.free;   //edilaine WO19556
    
  end;




end;


procedure TObjRecebedor.CalculoIRRF;
var lstipodesc: string;
    lrBaseIRMes, lrValorIRMes: real;
    lrSaldoComp: real; 
    lrproventoir: real;
    lrdescontoir: real;
    lscoddarf: string;
    liidrubir: integer;
    lsnomebase: string;
    lifontepagadora: integer;
    liidplanoprevbase, liidplanocontabilbase, liidplanoorigembase: integer;  // Andre Imakawa - SIG 66634

    //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
    bOpcaoIRRegressivo, bNaoEstaIsento:Boolean; // SOL 253413 PPM 777588
    rPrazoMP: real;
    rPercentualIRRF, rPercentualIRRFResgateReg: real;
    rTotalProvIRRF: real;
    rTotalDescIRRF: real;
    rValorBase: Real;
    rVAlorIRRF: Real;
    iFlgRisco: Integer;
    iFlgResgate: Integer;
    sMatriculaIRRF: String;
    iRubIRRF: Integer;
    sCodIrrfDarf: String;
    iPlanoPrevIRFF: Integer;
    iPlanoContabilIRFF: Integer;
    //FIM Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
    lrdescontoirTotal : real; //SOL 270391 PPM 1335136
    lii : Integer;            //SOL 270391 PPM 1335136
    objrubIR: tobjrubrica;    //SOL 270391 PPM 1335136
    sSQL : string;  // SOL 207789 KINTANA 2029238
    iFlgResgateParc, iQtdParcelas: Integer; // Andre Imakawa - SIG 26149
    rValorIRJudicialAux, rValorIRJudicialINSS, rValorIRJudicialFund, rValorIRJudicialINSS13, rValorIRJudicialFund13: Real; // Andre Imakawa - SIG 71773
    bAcaoGanhaEmDeposito : boolean;      //edilaine SIG92016
    rValorIRRFBase: Real; // Andre Imakawa - SIG 99651
    ldPercentual: Double; // Andre Imakawa - SIG 99651
    rIRRFDevido, rIRRFPago: real;       //edilaine - SIG70584/125782
    bPossuiAcaoLiminar : boolean;     //edilaine WO6905-6885
begin

  bNaoEstaIsento := NaoEstaIsento(lscoddarf);

  if ExisteBaseNormal(false) then
    LancaRubricaDEP_IDADE_IR(0);
//SOL205224 douglas.siqueira
   if TemBitr then
   begin
   if ExisteBaseNormal(false)= false then
      LancaRubricaDEP_IDADE_IR(0);
   end;
//SOL205224 douglas.siqueira
  if ExisteBase13(false) then
    LancaRubricaDEP_IDADE_IR(1);
  if ExisteBaseReserva(false) then
    LancaRubricaDEP_IDADE_IR(2);

  //BRUNO AZEVEDO SOL 253022 KINTANA 770426
  if (ExisteBaseRegressiva(false) and Not(ExisteBaseNormal(false)))
     and not(TemBitr) then     // edilaine - SIG 20032
    LancaRubricaDEP_IDADE_IR(0);
  //BRUNO AZEVEDO SOL 253022 KINTANA 770426

  //VERIFICA SALDO A COMPENSAR PARA QUALQUER PESSOA MESMO QUE COM ACAO JUDICIAL EM LIMINAR
  lrSaldoComp:=SaldoCompensaIR;

  lrBaseIRMes:=0; lrValorIRMes:=0;


  //MARCIO DENILSON SOL 151061 KINTANA 1105188
  bOpcaoIRRegressivo := False;

  //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
  //tenta encontrar opcao de irr regressivo para o titular atual
  //utiliza iiditular e iidresponsavel
  //pq qryprevia já está no proximo registro
