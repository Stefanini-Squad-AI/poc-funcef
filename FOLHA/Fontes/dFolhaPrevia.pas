      //BRUNO AZEVEDO SOL 132938/9942 KINTANA 1682446
      //if (dtmFolhaPrevia.qryPrevia.fieldbyname('idmotivo').asinteger <> prmidmotivofolhaben) and
      //   (dtmFolhaPrevia.qryPrevia.fieldbyname('idmotivo').asinteger <> prmidmotivoabono) then
      //begin
