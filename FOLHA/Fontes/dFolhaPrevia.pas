            if liiPlano >=0 then
            begin

              objplano:=(lstPlanos.objects[liiPlano] as tobjplano);

              if objrub.rvalorprovento = 0 then
                rValorRubrica := objrub.rvalorinfo
              else
                rValorRubrica := objrub.rvalorprovento;

              dtmFolhaPrevia.qryReinf.first;        //edilaine - SIG136670 

              if (objrub.iCodNaturezaReinf = pCodNaturezaReinf) and
