procedure TobjBuscaIR.FazBuscaIR;
Var sSQL : String;
begin
  sSQL    := ' SELECT H.IDRESPONSAVEL, H.IDTITULAR, H.CODIRRFDARF, '                                                     + #13 +
             '        SUM(CASE WHEN ( (SUBSTR(H.MES,6,2) <> ''13'') AND (H.FLGIRRF = 1) AND (H.FLGTIPODESC <> ''I'') ) ' + #13 +
             '              THEN DECODE(V.FLGDESCONTO,0,H.VALORPROVENTO,1,-1*H.VALORPROVENTO,0) '                        + #13 +
             '               ELSE 0 '                                                                                    + #13 +
             '            END) BASEIR, '                                                                                 + #13 +
             '        SUM( CASE WHEN ( (SUBSTR(H.MES,6,2) = ''13'') AND (H.FLGIRRF = 1) AND (H.FLGTIPODESC <> ''I'') ) ' + #13 +
             '              THEN DECODE(V.FLGDESCONTO,0,H.VALORPROVENTO,1,-1*H.VALORPROVENTO,0) '                        + #13 +
             '              ELSE 0 '                                                                                     + #13 +
             '            END) BASEIR13, '                                                                               + #13 +
             '        SUM( CASE WHEN ( (SUBSTR(H.MES,6,2) <> ''13'') AND (H.FLGTIPODESC = ''I'') ) '                     + #13 +
             '              THEN H.VALORPROVENTO '                                                                       + #13 +
             '              ELSE 0 '                                                                                     + #13 +
             '            END) VALORIR, '                                                                                + #13 +
             '        SUM( CASE WHEN ( (SUBSTR(H.MES,6,2) = ''13'') AND (H.FLGTIPODESC = ''I'') ) '                      + #13 +
             '              THEN H.VALORPROVENTO '                                                                       + #13 +
             '              ELSE 0 '                                                                                     + #13 +
             '            END) VALORIR13 '                                                                               + #13 +
             ' FROM HISTRUBSAL H, PROVDESC V '                                                                           + #13 +
             ' WHERE H.IDMODULO                          = 18 '                                                          + #13 +
             '   AND TO_CHAR(H.DATAPAGAMENTO, ''YYYY/MM'') = ' + QuotedStr(FAnoMes) + ' '                                + #13 +
             '   AND H.IDRUBRICA                         = V.IDPROVENTO '                                                + #13 +
             '   AND H.FLGESTORNO                        = 0 '                                                           + #13 +
             '   AND H.IDHSTFOLHABENEF IS NOT NULL '                                                                     + #13 +
             '   AND H.CODIRRFDARF IS NOT NULL '                                                                         + #13 +

             //edilaine - SIG71773 - inicio
             {excluir os lançamentos de benefícios portados cuja opção de IR seja Regressivo}
             '   AND NOT EXISTS (SELECT 1  '                                                                             + #13 +
             '                     FROM BFCIARIOTITPLAN BTP   '                                                          + #13 +
             '                     JOIN BENEFPLANPREV BPP ON BPP.IDBENEFICIO = BTP.IDBENEFICIO  '                        + #13 +
             '                                           AND BPP.IDPLANOPREV = BTP.IDPLANOPREV  '                        + #13 +
             '                     JOIN BENEFICIO B ON B.IDBENEFICIO = BTP.IDBENEDICIO          '                        + #13 +
{             '                     JOIN PARTPREVPLAN PP ON PP.IDPESSOA = BTP.IDPESSOA           '                        + #13 +
             '                                         AND PP.IDPESSJUR = BTP.IDPESSJUR         '                        + #13 +
             '                                         AND PP.IDPLANOPREV = BTP.IDPLANOPREV     '                        + #13 +
}             '                     WHERE BTP.IDRUBRICA = H.IDRUBRICA                            '                        + #13 +
             '                       AND BTP.IDPESSOA  = H.IDPESSOA                             '                        + #13 +
             '                       AND B.FLGPORTADO  = 1 AND B.FLGIRREGRESSIVO = 1            '                        + #13;
             //edilaine - SIG71773 - fim
             
  If FIndividual Then
    sSQL := sSQL + '   AND EXISTS (SELECT 1 '                                                                         + #13 +
                   '               FROM LISTAFOLHABENEFDET LD '                                                       + #13 +
                   '               WHERE (H.IDTITULAR = LD.IDTITULAR) '                                               + #13 +
                   '                 AND (LD.IDLISTA  = ' + IntToStr( VerificaListaUsuario(FIdUsuario )) + ')) '                         + #13;

  sSQL := sSQL + ' GROUP BY H.IDRESPONSAVEL, H.IDTITULAR, H.CODIRRFDARF ';

  Try
     FazQuery(dtmFolhaPrevia.qryIRGeral, sSQL);
  Except End;

end;

function TobjBuscaIR.LocalizaIRPessoa(piIdResponsavel, piIdTitular:Integer; psCodIRRFDARF:String): Boolean;
begin
  FBaseIR    := 0;
  FBaseIR13  := 0;
  FValorIR   := 0;
  FValorIR13 := 0;

  Result := dtmFolhaPrevia.qryIRGeral.Locate('IdResponsavel; IdTitular; CodIRRFDARF',
                                             VarArrayOf([piIdResponsavel, piIdTitular, psCodIRRFDARF]),
                                             []);

  If Result Then
  Begin
    FBaseIR    := dtmFolhaPrevia.qryIRGeral.FieldByName('BaseIR').AsFloat;
    FBaseIR13  := dtmFolhaPrevia.qryIRGeral.FieldByName('BaseIR13').AsFloat;
    FValorIR   := dtmFolhaPrevia.qryIRGeral.FieldByName('ValorIR').AsFloat;
    FValorIR13 := dtmFolhaPrevia.qryIRGeral.FieldByName('ValorIR13').AsFloat;
  End;
end;

function TobjBuscaIR.VerificaListaUsuario(piIdUsuario:Integer): Integer;
Var sSQL : String;
begin
  sSql := ' SELECT IDLISTA '                                     + #13 +
          ' FROM LISTAFOLHABENEF '                               + #13 +
          ' WHERE (IDUSUARIO =  ' + IntToStr(piIdUsuario) + ') ' + #13;

  dtmFolhaPrevia.qryAux4.Close;
  dtmFolhaPrevia.qryAux4.Sql.Clear;
  dtmFolhaPrevia.qryAux4.Sql.Add(sSql);
  dtmFolhaPrevia.qryAux4.Open;

  If Not dtmFolhaPrevia.qryAux4.IsEmpty Then
    Result := dtmFolhaPrevia.qryAux4.FieldByName('IDLISTA').AsInteger
  Else
    Result := -1;

  dtmFolhaPrevia.qryAux4.close; // SOL 242740 PPM 575822
end;                 

procedure TobjRecebedor.ApuraIRRF;
Var N : Integer;

    Procedure FazApuracao(aobjBase : TObjBase);
    Var fPorcentagem  : Real;
        fValor_Limite : Real;
    Begin
      If aobjBase.rproventoirrf > 0 Then
      Begin
        Try
          fPorcentagem := 12;

          fValor_Limite := (aobjBase.rproventoirrf * (fPorcentagem / 100));

          If aobjBase.rdescontoContrib >= fValor_Limite Then
            //aobjBase.rdescontoContrib := fValor_Limite;  // Renato Visoni - SOL 103723 / Kintana 463361
        Except
          aobjBase.rdescontoContrib := 0;
        End;
      End;

      aobjBase.rdescontoirrf := aobjBase.rdescontoContrib + aobjBase.rdescontoirrf;
    End;

Begin
  If BaseFUND        <> Nil Then FazApuracao(BaseFUND       );
  If BaseINSS        <> Nil Then FazApuracao(BaseINSS       );
  If BaseReserva     <> Nil Then FazApuracao(BaseReserva    );
  If BaseReservaCD   <> Nil Then FazApuracao(BaseReservaCD  );

  If BaseFUND13      <> Nil Then FazApuracao(BaseFUND13     );
  If BaseINSS13      <> Nil Then FazApuracao(BaseINSS13     );

  If BaseFUNDREGR    <> Nil Then FazApuracao(BaseFUNDREGR   );
  If BaseFUND13REGR  <> Nil Then FazApuracao(BaseFUND13REGR );
  If BaseReservaREGR <> Nil Then FazApuracao(BaseReservaREGR);
end;


