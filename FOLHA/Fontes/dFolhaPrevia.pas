// Felipe A. Santos SOL 197564/13523 Kintana 1905644
function TdtmFolhaPrevia.RetornaString(Lista: TStringList; PosIni, QtdStr: integer;
                                       Separador : string; QuebraStr : boolean;
                                       SeqDeQuebra : integer = 0;NomeDaLista : string = '') : string;
var i, iQuebra: integer;
    strAux : string;

begin
     // Se a quantidade de strings na lista for menor que a quantidade passada
     // então atribui a quantidade da lista para quantidade passada

    if Lista.Count < QtdStr then
       QtdStr := Lista.Count;

    // retorna a quantidade de strings escolhidas dentro da lista
    iQuebra := 0;
    for i := PosIni to QtdStr - 1 do
    begin
         if (NomeDaLista = 'Rubricas') and (i = (QtdStr - 1)) and (Lista.Count = QtdStr) then
            strAux := strAux + Lista[i]
         else
            strAux := strAux + Lista[i] + Separador;

         iQuebra := iQuebra + 1;

         if QuebraStr then
         begin
           if iQuebra = SeqDeQuebra then
           begin
             strAux := strAux + #13#10;
             iQuebra := 0;
           end;
         end;
    end;

    Result := strAux;

end;
