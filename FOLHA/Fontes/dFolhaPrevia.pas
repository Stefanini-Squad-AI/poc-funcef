procedure TobjRecebedor.BuscaOutros_IRMensal(aitipobase: integer;
  ascodirrfdarf: string; aiidrubrica: integer; var arBase, arValorIR: real);
begin
  arBase:=0;
  arValorIR:=0;

  if not SistemaFolha.FlgUsaBaseMensalIRRF then exit;

  If dtmFolhaPrevia.objBuscaIR.LocalizaIRPessoa(iidresponsavel, iidtitular, ascodirrfdarf) Then
  Begin
    If aitipobase = 0 Then
    Begin
      arBase := dtmFolhaPrevia.objBuscaIR.BaseIR;
      arValorIR := dtmFolhaPrevia.objBuscaIR.ValorIR;
    End
    Else
    Begin
      arBase := dtmFolhaPrevia.objBuscaIR.BaseIR13;
      arValorIR := dtmFolhaPrevia.objBuscaIR.ValorIR13;
    End;  
  End;
end;

procedure TobjRecebedor.LancaIRCompensado(var arSaldoComp, arValorIRRF: real;
  arbaseirrf: real; ascodirrfdarf: string; aiidmotivo, aiFontePagadora,  aidplanoprev, aidplanoorigem, aidplanocontabil: integer);
 var lrIRRFCompensado: real;
     lstipodesc: string;
begin
  //CALCULA VALOR A COMPENSAR PELO SALDO
  lrIRRFCompensado:=0;
  if arSaldoComp > 0 then
  begin
    if arSaldoComp > arValorIRRF then
    begin
      lrIRRFCompensado:=arValorIRRF;
      arValorIRRF:=0;
      arSaldoComp:=arSaldoComp-lrIRRFCompensado;
    end
    else
    begin
      lrIRRFCompensado:=arSaldoComp;
      arValorIRRF:=arValorIRRF-lrIRRFCompensado;
      arSaldoComp:=0;
    end;
  end;

  if (lrIRRFCompensado > 0) then
  begin
    lstipodesc:=dtmFolhaPrevia.BuscaDadosRubrica(self, prmIDRUBIRRFCOMPIR, 'K');
    if lstipodesc <> '' then
    begin
      try
        if not InsereRubrica(
          iidresponsavel,                                      //beneficiario
          0,                                                   //favorecido da rubrica
          0,                                                   //beneficio associado : pega beneficio base
          prmIDRUBIRRFCOMPIR,                                  //codigo do provento
          dtmFolhaPrevia.qryProvento.FieldByName('flgdesconto').asinteger,    //flag de desconto
          dtmFolhaPrevia.qryProvento.FieldByName('flgespecial').asinteger,    //flag especial
          aiidmotivo,                                          //motivo do desconto
          1,                                                   //seqrubrica = 1
          icodmoedabase,                                       //codigo da moeda
          0,                                                   //regra de calculo
          aiFontePagadora,                                     //fonte pagadora : pega fonte pagadora base
          dtmFolhaPrevia.qryProvento.FieldByName('flgirrf').asinteger, //indica se rubrica entra na base de IR
          dtmFolhaPrevia.qryProvento.FieldByName('FLGSALFAMILIA').asinteger, //indica se rubrica entra na composição do calculo do salario familia
          0,                                                   // Indica se o beneficio é provisorio
          Sistema.Idmodulo,                                    //sistema de origem da rubrica
          0,                                                   //flgSRB
          1,                                                   //flgOK
          0,                                                   //flgPA
          dtmFolhaPrevia.qryProvento.FieldByName('flgdescpensao').asinteger, //flgBasePA
          0,                                                   //flgconcessao
          0,                                                   //flgindividual
          dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalpart').asinteger,//compõe sal. participacao
          dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalbenef').asinteger,//compõe sal. benefício
          dtmFolhaPrevia.qryProvento.FieldByName('numprioridade').asinteger, //prioridade de desconto
          iidpessjur,                                           //id empresa p/ contabilização
          dtmFolhaPrevia.qryProvento.FieldByName('tipobasedesconto').asinteger, //tipo de base de desconto {abono,supl,inss,resgate}
          0,                                                   //código do alterador
          0,                                                   //id do plano de contas
          inumeroprocesso,
          snumprocinss,
          'K',                                                 //flg do tipo de desconto 'C', 'P', 'B', 'Y'
          arbaseirrf,                                          //valor informativo associado a rubrica (base de calculo do IR)
          lrIRRFCompensado,                                    //valor do IRRF calculado compensado
          0,                                                   //base de calculo
          '***',                                               //referencia
        {  dtmFolhaPrevia.MesCobranca,                         //mês de referência  }
          dtmFolhaPrevia.MesReferencia,                        //mês de referência       //William Santana SOL 197565 KTN 1905420
          ascodirrfdarf,                                       //código IRRF na SRF para o DARF igual ao provento base
          '',                                                  //indice recebimento 'R'ou pagamento 'P'
          '',                                                  //código do tipo de recebimento ou desembolso
          '',                                                  //código do centro de custo
          '',                                                  //código do centro de responsabilidade
          '',                                                  //código da unidade de negócio
          '',                                                  //conta contábil associada
          '',                                                  //data inicio da rubrica
          '',                                                  //data final da rubrica
          dtmFolhaPrevia.qryProvento.FieldByName('descparcial').asinteger,    //indica se permite desconto parcial
          0,                                                   //usa no abono anual
          3,                                                   //origem da rubrica
          0,                                                   //lote original do desconto
          0,  // RUBRICA CONSIGNATARIO
          false, // ACEITA ZERO
          '',    // DATA PREVISTA DE PAGAMENTO - PEND 10826
          dtmFolhaPrevia.qryProvento.FieldByName('CODPROVDESC').asstring, //PARA GRAVAR CODPROVDESC NA PREVIA E EM SQL PARA REGRAS
          //0, //ATRIBUI ZERO PARA OBTER O IDPLANOPREV GLOBAL     // Andre Imakawa - SIG 66634
          aidplanoprev,                                           // Andre Imakawa - SIG 66634
          //0, //ATRIBUI ZERO PARA OBTER O IDPLANOORIGEM GLOBAL   // Andre Imakawa - SIG 66634
          aidplanoorigem,                                         // Andre Imakawa - SIG 66634
          //0, //ATRIBUI ZERO PARA OBTER O PLANO CONTABIL GLOBAL  // Andre Imakawa - SIG 66634
          aidplanocontabil,                                       // Andre Imakawa - SIG 66634
          0, //RUBRICA CUJO SEQUENCIAL INTERNO É IRRELEVANTE PARA RETORNO
          dtmFolhaPrevia.qryProvento.FieldByName('FLGRUBLEGAL').asinteger,  //
          dtmFolhaPrevia.qryprevia.fieldbyname('MESCOMPREEM').asstring      // SOL 140042 Kintana 900220
          ,0
          ,''
          ,dtmFolhaPrevia.qryProvento.FieldByName('FLGMARGEM').asinteger         //Renato Visoni SOL 131523 KINTANA 750021
          ,0
          ,dtmFolhaPrevia.qryProvento.FieldByName('FLGREPROGRAMAR').asInteger    //Marcio Denilson - SOL 136569 - KINTANA 820997
          ,false, 0,dtmFolhaPrevia.qryProvento.FieldByName('FLGEXCLUICONTRIBPA').asInteger    //Osni Cavalcante - SIG 58950.59454
          ) then
          dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de Compensação de IRRF '+
            dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring,
            self)
      else
         if objrubinserida <> nil then // FEFX - SIG43291
            VerificaIrrfDarfRegimeRegressivo(objrubinserida); // FEFX - SIG43291
      except
        dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de Compensação de IRRF'+
          dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring,
          self); 
      end;
    end
    else
      dtmFolhaPrevia.ExibeMensagem('Rubrica não encontrada (Compensação de IRRF): '+inttostr(prmIDRUBIRRFCOMPIR),
        self); 
  end;
end;

procedure TobjRecebedor.CalculaLancaIRRegressivo(aiTipoBase, {0-vitalicio,1-abono,7-reserva}
  aiRubrica: integer; ascodirrfdarf: string;
  aiidmotivo: integer; arproventoirrf: real; asNomeBase: string;
  aiidplanoprev, //PLANO PREVIDENCIARIO PARA BUSCA DAS RESERVA
  //PLANOS PARA CARIMBAR A RUBRICA DE IR
  aiidplanoprev_RubIR,
  aiidplanocontabil_RubIR: integer
  );
var dbaseIRRF, dpercentual: double;
    rValorIRRF: real;
    rIRRFCompensado: real;
    lstipodesc: string;
    lsmesref: string;
    lsdataref: string;
begin
  dbaseIRRF:=arproventoirrf;
  lsdataref:=FormatDateTime('dd/mm/yyyy', dtmFolhaPrevia.DataPagamento);

  if aiTipoBase in [0, 1] then // 0: vitalicio, 1: abono, 7: reserva
  begin
    rValorIRRF := SistemaFolha.objIrrf.CalculaIRRFRegressivoContinuado(iidtitular,
      aiidplanoprev, dbaseirrf, dtmFolhaPrevia.UltDiaMesPag);
  end
  else
  begin
    rValorIRRF := SistemaFolha.objIrrf.CalculaIRRFRegressivoResgate(iidtitular,
      aiidplanoprev, dbaseirrf, dtmFolhaPrevia.UltDiaMesPag);
  end;

  // Andre Imakawa - SIG 94114 - Inicio
  //lsMesRef:=dtmfolhaprevia.MesCobranca;
  if aiTipoBase = 1 then {IR ABONO}
  begin
    lsMesRef:=dtmfolhaprevia.MesAbono;
  end
  else {IR NORMAL}
  begin
    lsMesRef:=dtmfolhaprevia.MesCobranca;
  end;
  // Andre Imakawa - SIG 94114 - Fim

  if (rValorIRRF > 0) then
  begin
    lstipodesc:=dtmFolhaPrevia.BuscaDadosRubrica(self, aiRubrica, 'I');
    if lstipodesc <> '' then
    begin
      if not InsereRubrica(
        iidresponsavel,                                       //beneficiario
        0,                                                    //favorecido da rubrica
        0,                                                    //beneficio associado : pega beneficio base
        aiRubrica,                                            //codigo do provento
        dtmFolhaPrevia.qryProvento.FieldByName('flgdesconto').asinteger,    //flag de desconto
        dtmFolhaPrevia.qryProvento.FieldByName('flgespecial').asinteger,    //flag especial
        aiidmotivo,                                           //motivo do desconto
        1,                                                    //seqrubrica = 1
        icodmoedabase,                                        //codigo da moeda
        0,                                                    //regra de calculo
        dtmFolhaPrevia.qryProvento.FieldByName('codfontepagadora').asinteger, //fonte pagadora : pega fonte pagadora base
        dtmFolhaPrevia.qryProvento.FieldByName('flgirrf').asinteger, //indica se rubrica entra na base de IR
        dtmFolhaPrevia.qryProvento.FieldByName('FLGSALFAMILIA').asinteger, //indica se rubrica entra na composição do calculo do salario familia
        0,                                                   // Indica se o beneficio é provisorio
        Sistema.Idmodulo,                                    //sistema de origem da rubrica
        0,                                                   //flgSRB
        1,                                                   //flgOK
        0,                                                   //flgPA
        dtmFolhaPrevia.qryProvento.FieldByName('flgdescpensao').asinteger, //flgBasePA
        0,                                                   //flgconcessao
        0,                                                   //flgindividual
        dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalpart').asinteger,//compõe sal. participacao
        dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalbenef').asinteger,//compõe sal. benefício
        dtmFolhaPrevia.qryProvento.FieldByName('numprioridade').asinteger, //prioridade de desconto
