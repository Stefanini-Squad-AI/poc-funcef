function TobjRecebedor.CalculaArredondamento(arvalor : real; aibase : integer) : real;
 var rv1, rv2 : real;
begin
  rv1 := (arvalor / prmPercCPMF);
  rv2 := (( trunc(rv1*100) div (aibase*100) ) * (aibase*100)) / 100;
  if round(abs(rv1-rv2)*100) < 1 then
    result:=0
  else
    result:=(rv2+aibase-rv1)*prmPercCPMF;
end;

