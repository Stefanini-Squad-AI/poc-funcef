            lobjrubTemp := TObjRubrica.Create(lobjrub.iidpessoa, lobjrub.iidfavorecido, lobjrub.iidbeneficio, lobjrub.iidrubrica, lobjrub.iflgdesconto, lobjrub.iflgespecial, lobjrub.iidmotivo, lobjrub.eseqrubrica, lobjrub.iidregracalculo, lobjrub.ifontepagadora, lobjrub.iflgirrf, lobjrub.iflgsalfam, lobjrub.iflgprovisorio, lobjrub.iidmodulo, lobjrub.iflgsrb, lobjrub.iflgok, lobjrub.iflgPA, lobjrub.iformabasePA, lobjrub.iflgconcessao, lobjrub.iflgindividual, lobjrub.iflgcompoesalpar, lobjrub.iflgcompoesalben,
