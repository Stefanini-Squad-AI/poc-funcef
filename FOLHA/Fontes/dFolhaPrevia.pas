                                         dtmFolhaPrevia.qryPrevia.FieldByName('IDPLANOPREV').asinteger,      //CPrev - 27906 - ATRIBUI ZERO PARA OBTER O IDPLANOPREV GLOBAL
                                         dtmFolhaPrevia.qryPrevia.FieldByName('IDPLANOORIGEM').asinteger,    //CPrev - 27906 - ATRIBUI ZERO PARA OBTER O IDPLANOORIGEM GLOBAL
                                         dtmFolhaPrevia.qryPrevia.FieldByName('IDPLANOCONTABIL').asinteger,  //CPrev - 27906 - ATRIBUI ZERO PARA OBTER O PLANO CONTABIL GLOBAL
