     lberro : boolean;

  function EstaNoMes(adt : tdatetime; ames : string) : boolean;
  begin
    result:=formatdatetime('yyyy/mm', adt) = ames;
  end;

  procedure TrataUltimoPagamento;
   var ssql : string;
       lss, lsdatafinal : string;
       bErro, bExecuta : boolean;
       iIdCalculoGeral : integer;
