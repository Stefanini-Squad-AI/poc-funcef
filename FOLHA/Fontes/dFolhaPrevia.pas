    dtmFolhaPrevia.qryUpdDescFolha.sql.clear;
    dtmFolhaPrevia.qryUpdDescFolha.sql.add(
      'UPDATE TMPDESC '+
      'SET LOTEPREVIA = '+inttostr(aiidlote)+', '+
      '    DATARECEBIMENTO = TO_DATE('+
        quotedstr(formatdatetime('dd/mm/yyyy', dtmFolhaPrevia.DataPagamento))+',''DD/MM/YYYY'') '+
      'WHERE IDSEQINTERNOFB = '+inttostr(iseqinternofb));

    try
      dtmFolhaPrevia.qryUpdDescFolha.ExecSQL;
    except
      on E:EDBEngineError do
      begin
        dtmFolhaPrevia.ExibeMensagem('Erro na atualização da rubrica : '+inttostr(iidrubrica));
        dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
        dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
      end;
    end;
  end;

  procedure AtribuiCF;
  begin
    if iflgdesconto = 0 then
    begin
      regCF.PlaContaC:='';
      regCF.CentroCustoC:='';
      regCF.PlaContaD:=trim(splaconta);
      regCF.CentroCustoD:=trim(scodcentrocusto);
    end
    else
      if iflgdesconto = 1 then
      begin
        regCF.PlaContaC:=trim(splaconta);
        regCF.CentroCustoC:=trim(scodcentrocusto);
        regCF.PlaContaD:='';
        regCF.CentroCustoD:='';
      end;

    regCF.SubConta:=0;

    if sunidnegoc = '' then
      regCF.UnidNegoc:=0
    else
      regCF.UnidNegoc:=strtoint(sunidnegoc);

    regCF.CentroRespon:=trim(scodcentrorespon);
    regCF.CodTipRecDes:=trim(scodtiprecdes);
    regCF.Plano:=0;
    regCF.RecPag:='P';
    regCF.Mensagem:='';
    regCF.PlaContaCProvisAbono:='';
    regCF.CentroCustoCProvisAbono:='';
    regCF.PlaContaDProvisAbono:='';
    regCF.CentroCustoDProvisAbono:='';
    regCF.bValidada:=false;
  end;

