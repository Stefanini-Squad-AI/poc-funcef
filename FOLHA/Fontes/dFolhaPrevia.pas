    // Andre Imakawa - SIG 20182 - Inicio
    Function AlocaCF: PRegContFinan;
    Var pCF: pRegContFinan;
    Begin
       Try
          new(pCF);
          result := pCF;
       Except
          result := Nil;
       End;
    End;

    Procedure TransfereCF(Var CFOrigem, CFDestino: TRegContFinan);
    Begin
       CFDestino.PlaContaC := CFOrigem.PlaContaC;
       CFDestino.CentroCustoC := CFOrigem.CentroCustoC;
       CFDestino.PlaContaD := CFOrigem.PlaContaD;
       CFDestino.CentroCustoD := CFOrigem.CentroCustoD;
       CFDestino.PlaContaCProvisAbono := CFOrigem.PlaContaCProvisAbono;
       CFDestino.CentroCustoCProvisAbono := CFOrigem.CentroCustoCProvisAbono;
       CFDestino.PlaContaDProvisAbono := CFOrigem.PlaContaDProvisAbono;
       CFDestino.CentroCustoDProvisAbono := CFOrigem.CentroCustoDProvisAbono;
       CFDestino.SubConta := CFOrigem.SubConta;
       CFDestino.UnidNegoc := CFOrigem.UnidNegoc;
       CFDestino.CentroRespon := CFOrigem.CentroRespon;
       CFDestino.CodTipRecDes := CFOrigem.CodTipRecDes;
       CFDestino.Plano := CFOrigem.Plano;
       CFDestino.RecPag := CFOrigem.RecPag;
       CFDestino.Mensagem := CFOrigem.Mensagem;
       CFDestino.bValidada := CFOrigem.bValidada;
    End;
    // Andre Imakawa - SIG 20182 - Fim

    begin
      sSql := '';
      query.close;
      query.SQL.Clear;
      query.SQL.Add(' SELECT P.FLGCONTBENEFICIO, P.FLGCONTABONO, P.FLGCORRECAOMONETARIA, ');
      query.SQL.Add(' (select PLACONTACORRECAO from paramaprev) AS PLACONTACORRECAO,     ');
      query.SQL.Add(' (select PLACONTAABONO from paramaprev)    AS PLACONTAABONO         ');
      query.SQL.Add(' FROM PROVDESC P WHERE P.idprovento = '+ inttostr(iidrubrica) );
      query.Open;

      iflgcontabbenef       := query.Fieldbyname('FLGCONTBENEFICIO'    ).AsInteger;
      iflgcontababono       := query.Fieldbyname('FLGCONTABONO'        ).AsInteger;
      iflgcorrecaomonetaria := query.Fieldbyname('FLGCORRECAOMONETARIA').AsInteger;
      sPlacontacorrecao     := query.Fieldbyname('PLACONTACORRECAO'    ).AsString;
      splacontaabono        := query.Fieldbyname('PLACONTAABONO'       ).AsString;


      if  (iflgcorrecaomonetaria = 1) and (sPlacontacorrecao <> EmptyStr) then
       begin
         if iflgdesconto = 0 then
          regCF.PlaContaD:=trim(sPlacontacorrecao)
         else
          if iflgdesconto = 1 then
           regCF.PlaContaC:=trim(sPlacontacorrecao);
       end
      else
      if  (iflgcontababono = 1) and (splacontaabono <> EmptyStr) and (copy(smes,5,3) = '/13') then
       begin
         if iflgdesconto = 0 then
          regCF.PlaContaD:=trim(splacontaabono)
         else
          if iflgdesconto = 1 then
           regCF.PlaContaC:=trim(splacontaabono);
       end
      else
      if  ((iflgcontabbenef = 1) and (sflgtipodesc = 'Y')) then
      begin

         //FERNANDO XAVIER - SOL 247786 PPM 660182
         //MELHORIA DE PERFORMANCE E CORREÇÃO NO PROBLEMA DO SOL
         //Roberta/Hebio incluido o IdBeneficio e IdTitular nos filtros.
         sSql := '   SELECT BP.PLACONTAD AS conta '
                +'   FROM BENEFBFCIARIO BF '
                +'   JOIN HSTBENEFBFCIARIO HST ON HST.IDPLANOPREV = BF.IDPLANOPREV AND    '
                +'                      HST.IDBENEFICIO = BF.IDBENEFICIO AND    '
                +'                      HST.NUMEROPROCESSO = BF.NUMEROPROCESSO AND  '
                +'                      HST.IDPESSJUR = BF.IDPESSJUR AND   '
                +'                      HST.IDTITULAR = BF.IDTITULAR AND   '
                +'                      HST.IDPLANOORIGEM = BF.IDPLANOORIGEM AND  '
                +'                      HST.IDPESSOA = BF.IDPESSOA AND     '
                +'                      HST.SEQPROPOSTA = BF.SEQPROPOSTA   '
                +'   JOIN BENEFPLANPATRO BP ON BP.IDPLANOPREV = BF.IDPLANOPREV AND    '
                +'                  BP.IDPESSJUR = BF.IDPESSJUR AND        '
                +'                  BP.IDBENEFICIO = BF.IDBENEFICIO        '
                +'   WHERE  BF.FONTEPAGADORA = 1        '
                //+'   AND    BF.IDTPPAGTOBENEFIC = 1     ' // Andre Imakawa - 20182
                +' 	 AND    BF.IDPESSOA    = ('+inttostr(iidpessoa)+')	   '
                +' 	 AND    BF.IDBENEFICIO = ('+inttostr(iidbeneficio)+')	 '
                +' 	 AND    BF.IDTITULAR   = ('+inttostr(aiidtitular)+')	 '
                +' 	 AND    HST.IDLOTE     = ('+inttostr(aiidlote)+')      ';
         //FERNANDO XAVIER - SOL 247786 PPM 660182
         query.close;
         query.SQL.Clear;
         query.SQL.Add(sSql);
         query.Open;

         if  (trim(query.FieldByName('conta').AsString) = '') then
         begin
            if FazQuery(query2, 'SELECT '
                           +' (SELECT P.NOME FROM PESSOA P WHERE P.IDPESSOA = '+ inttostr(iidpessoa) +') AS PESSOA,            '
                           +' (SELECT MATRICULA FROM ELEGPATRO E WHERE E.IDPESSOA = '+ inttostr(iidpessoa) +') AS MATRICULA,            '//SOL 257727 PPM 964888
                           +' (SELECT B.NOME FROM BENEFICIO B WHERE B.IDBENEFICIO = '+ inttostr(iidbeneficio)+') AS BENEFICIO,  '
                           +' (SELECT PP.NOME FROM PLANPREV PP WHERE PP.IDPLANOPREV = '+inttostr(iidplanoprev)+') AS PLANO,    '
                           +' (SELECT PC.NOME FROM PLANPREVCONTABIL PC WHERE PC.IDPLANOPREV = '+inttostr(iidplanocontabil)+') AS PCONTABIL '
                           +' FROM DUAL ') then

            begin

              smsgs := '------- Parametrização de conta contábil não encontrada ----------' + _clinefeed
                    + 'Matrícula beneficiário: '+ query2.fieldbyname('MATRICULA').AsString + _clinefeed
                    + 'Nome beneficiário: '+query2.fieldbyname('PESSOA').AsString + _clinefeed
                    + 'Benefício: '+query2.fieldbyname('BENEFICIO').AsString + _clinefeed
                    + 'Plano Previdenciário: '+query2.fieldbyname('PLANO').AsString + _clinefeed
                    + 'Plano Contábil: '+query2.fieldbyname('PCONTABIL').AsString + _clinefeed
                    + 'Rubrica: ' + inttostr(iidrubrica) + _clinefeed
            end;


           dtmFolhaPrevia.ExibeMensagemSemRecebedor(smsgs);

           if iflgdesconto = 0 then
            regCF.PlaContaD:=''
           else
            if iflgdesconto = 1 then
             regCF.PlaContaC:='';
         end
         else
         begin
           if iflgdesconto = 0 then
            regCF.PlaContaD:=trim(query.FieldByName('conta').AsString)
           else
            if iflgdesconto = 1 then
             regCF.PlaContaC:=trim(query.FieldByName('conta').AsString);

           // Andre Imakawa - SIG 20182 - Inicio
           result := dtmContabil.ValidaCF(liidplanocontabilgravar, liprovisaoabono=1,regCF, smsgs);
           regCF.bValidada := result;

           if dtmContabil.IsRubricaBeneficio(liidplanoprevgravar, iidrubrica) then
           begin
             If dtmContabil.HabilitaControleListas Then
                Begin
                liindex := dtmContabil.ListaCFBenef.indexof(
                     inttostr(aiidpatro) + ';' + inttostr(liidplanoprevgravar) + ';' +
                     inttostr(dtmContabil.liidbeneficio) + ';' + inttostr(iflgdesconto) + ';' +
                     dtmContabil.AjustaMascaraMes(smes) + ';' + inttostr(iflgprovisorio) + ';' +
                     inttostr(aiacaojudganha) + ';' + 'B');

               If liindex >= 0 Then
               Begin
                 dtmContabil.ListaCFBenef.Delete(liindex);

                 CFInterno := AlocaCF;
                 regCF.Mensagem := smsgs;
                 TransfereCF(regCF, CFInterno^);
                 dtmContabil.IncluiLista(dtmContabil.ListaCFBenef,
                     inttostr(aiidpatro) + ';' + inttostr(liidplanoprevgravar) + ';' +
                     inttostr(dtmContabil.liidbeneficio) + ';' + inttostr(iflgdesconto) + ';' +
                     dtmContabil.AjustaMascaraMes(smes) + ';' + inttostr(iflgprovisorio) + ';' +
                     inttostr(aiacaojudganha) + ';' + 'B',
                     CFInterno);
               end;

             End;

           end
           Else
           Begin
             If Not dtmContabil.IsRubricaContribuicao(liidplanoprevgravar, iidrubrica) Then
             begin
               If dtmContabil.HabilitaControleListas Then
               Begin
                  liindex := dtmContabil.ListaCFRub.indexof(
                     inttostr(aiidpatro) + ';' + inttostr(liidplanoprevgravar) + ';' +
                     inttostr(iidrubrica)+ ';' + inttostr(iflgdesconto) + ';' +
                     sflgtipodesc);

                 If liindex >= 0 Then
                 Begin
                   dtmContabil.ListaCFRub.Delete(liindex);

                   CFInterno := AlocaCF;
                   regCF.Mensagem := smsgs;
                   TransfereCF(regCF, CFInterno^);
                   dtmContabil.IncluiLista(dtmContabil.ListaCFRub,
                       inttostr(aiidpatro) + ';' + inttostr(liidplanoprevgravar) + ';' +
                       inttostr(iidrubrica)+ ';' + inttostr(iflgdesconto) + ';' +
                       sflgtipodesc,
                       CFInterno);
                 end;
               End;
             end
             else
             begin
               If dtmContabil.HabilitaControleListas Then
               Begin
                  liindex := dtmContabil.ListaCFContr.indexof(
                     inttostr(aiidpatro) + ';' + inttostr(liidplanoprevgravar) + ';' +
                     inttostr(dtmContabil.liidcontribuicao) + ';' + inttostr(iflgdesconto) + ';' +
                     dtmContabil.AjustaMascaraMes(smes) + ';' + inttostr(iflgprovisorio) + ';' +
                     inttostr(aiacaojudganha) + ';' + sflgtipodesc);

                  If liindex >= 0 Then
                  Begin
                    dtmContabil.ListaCFContr.Delete(liindex);

                    CFInterno := AlocaCF;
                    regCF.Mensagem := smsgs;
                    TransfereCF(regCF, CFInterno^);
                    dtmContabil.IncluiLista(dtmContabil.ListaCFContr,
                       inttostr(aiidpatro) + ';' + inttostr(liidplanoprevgravar) + ';' +
                       inttostr(dtmContabil.liidcontribuicao) + ';' + inttostr(iflgdesconto) + ';' +
                       dtmContabil.AjustaMascaraMes(smes) + ';' + inttostr(iflgprovisorio) + ';' +
                       inttostr(aiacaojudganha) + ';' + sflgtipodesc,
                       CFInterno);
                  end;
               End;
             end;
           end;
           // Andre Imakawa - SIG 20182 - Fim
         end;
      end;
      query2.close; // SOL 242740 PPM 575822
      query.close; // SOL 242740 PPM 575822
    end;
