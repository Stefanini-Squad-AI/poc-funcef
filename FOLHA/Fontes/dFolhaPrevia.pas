                          lrvalor, 1, lrvalorRateio)    // Andre Imakawa - SIG 99651
        else
          AcrescentaPlano(lobjrub.iidplanoprev,
                          lobjrub.iidplanocontabil,
                          lsplacontaliq,
                          lrvalor, 0, lrvalorRateio);   // Andre Imakawa - SIG 99651

      end;

      // Andre Imakawa - SIG 99651 - Inicio
      if bconsignatario then
      begin
        if (copy(lobjrub.smes,6,2) = '13') then
          AcrescentaPlano(strtoint(iff(lobjrub.iidplanoprev=0,inttostr(iidplanoprevglobal),inttostr(lobjrub.iidplanoprev))),
                          strtoint(iff(lobjrub.iidplanocontabil=0,inttostr(iidplanocontabilglobal),inttostr(lobjrub.iidplanocontabil))),
                          lsplacontaliq,
                          lrvalor, 1, 0)    // Andre Imakawa - SIG 99651
        else
          AcrescentaPlano(strtoint(iff(lobjrub.iidplanoprev=0,inttostr(iidplanoprevglobal),inttostr(lobjrub.iidplanoprev))),
                          strtoint(iff(lobjrub.iidplanocontabil=0,inttostr(iidplanocontabilglobal),inttostr(lobjrub.iidplanocontabil))),
                          lsplacontaliq,
                          lrvalor, 0, 0);   // Andre Imakawa - SIG 99651

      end;
      // Andre Imakawa - SIG 99651 - Fim
    end;

    objrubinserida := lobjrub;
    result         := true;

 finally
    //dtmFolhaPrevia.qryAux.close; // SOL 242740 PPM 575822
    query.close; // SOL 242740 PPM 575822
    FreeAndNil(query);   //query.Destroy; //SOL205224 douglas.siqueira                       //edilaine WO19556
    querySaldoIdoso.close; // SOL 253375 PPM 777307
    FreeAndNil(querySaldoIdoso);   //querySaldoIdoso.Destroy; // SOL 253375 PPM 777307       //edilaine WO19556
    queryIdade.close; // SOL 253375 PPM 777307
    FreeAndNil(queryIdade);   //queryIdade.Destroy; // SOL 253375 PPM 777307                 //edilaine WO19556

    _qryAux.close;         //edilaine WO19556
    FreeAndNil(_qryAux);   //edilaine WO19556
 end;
end;

function TobjRecebedor.CalculaCPMF(arvalor : real) : real;
begin
  result:=arvalor*(prmPercCPMF-1);
end;

procedure TobjRecebedor.ProcessaFavorecidos(var bErroInserePrevia: Boolean);   // Andre Imakawa - SIG 80669
 var lii, linumdepirrf, liNumDepsalf,liflgisentoirrf : integer;
     ldtdatanasc : tdatetime;
     lrValorCotas, lrtotalcredito,lrValorCPMFPA : real;
     liidpessoa, licodportforma : integer;
     lsmesref, lstipodesc : string;
     liidrubrica : integer;
     dtDataLibera : tdatetime;
     sDatalibera : String;
begin
  try
    //USADA PARA LANÇAR CPMF TOTAL SOBRE AS PAS INSS
    for lii:=0 to lstFavorecidos.count-1 do
    begin
      try
        liidpessoa:=strtoint(Piece(lstFavorecidos[lii],';',1));
        licodportforma:=strtoint(Piece(lstFavorecidos[lii],';',2));
        dtmFolhaPrevia.qryDadosPF.Close;
        dtmFolhaPrevia.qryDadosPF.parambyname('pIDPESSOA').asinteger:=liidpessoa;
        dtmFolhaPrevia.qryDadosPF.open;
        linumdepirrf:=dtmFolhaPrevia.qryDadosPF.fieldbyname('numdepirrf').asinteger;
        linumdepSalf:=dtmFolhaPrevia.qryDadosPF.fieldbyname('numdepsalf').asinteger;
        liflgisentoirrf:=dtmFolhaPrevia.qryDadosPF.fieldbyname('flgisentoirrf').asinteger;
        ldtdatanasc:=dtmFolhaPrevia.qryDadosPF.fieldbyname('datanasc').asdatetime;
        dtmFolhaPrevia.qryDadosPF.Close;
      except
        if SistemaFolha.FlgEfetuaPagtoFavOutros = 0 then
          dtmFolhaPrevia.ExibeMensagem('Erro na leitura dos dados do recebedor de Consignação Judicial',
            self)
        else
          dtmFolhaPrevia.ExibeMensagem('Erro na leitura dos dados do Favorecido.',
            self);
        linumdepirrf:=0;
        liflgisentoirrf:=0;
        ldtdatanasc:=0;
      end;
      lsmesref:='';

      if not dtmFolhaPrevia.CriaRecebedor(inumeroprocesso,
                                          iidfundacao,
                                          iidpatro,
                                          iidplanoprevglobal,
                                          iidplanoorigemglobal,
                                          iidplanocontabilglobal,
                                          iidtitular,
                                          liidpessoa,
                                          liidpessoa,
                                          iidlote,
                                          linumdepirrf,
                                          liNumDepSalf,
                                          liflgisentoirrf,
                                          iseqproposta,
                                          iflgconcessaolote,
                                          iiDESCIRMES,
                                          iiMolestiaGrave,
                                          iisomairrfinss,
                                          licodportforma,
                                          idfloatpagto,
                                          ldtdatanasc,
                                          dtdatarequerimento,
                                          snumprocinss,
                                          0,
                                          dtDatalibera,
                                          sdatalibera,
                                          dtdataLibera,
                                          dtdatafimmolestia,
                                          dtdatamolestia, //SOL 214520 KTN 2042434
                                          true,
                                          0,0,0,0,0,0,0,
                                          dtmFolhaPrevia.qryprevia.fieldbyname('MESCOMPREEM').asstring,   // SOL 140042 Kintana 900220
                                          dtmFolhaPrevia.qryprevia.fieldbyname('TPMODALIDADE').asstring,  // SOL 257943 PPM 970494
                                          dtmFolhaPrevia.objRecebedorFav
                                          ) then
      begin
        dtmFolhaPrevia.ExibeMensagem('Erro ao criar Recebedor de Consignação Judicial',
          self);
        break;
      end;

      dtmfolhaprevia.AvaliaDadoBancario(dtmFolhaPrevia.objRecebedorFav);
      dtmFolhaPrevia.objRecebedorFav.iidbeneficiobase:=self.iidbeneficiobase;
      dtmFolhaPrevia.objRecebedorFav.AcrescentaPessoa(liidpessoa);
      dtmFolhaPrevia.objRecebedorFav.splacontaliqglobal:=splacontaliqglobal;
      dtmFolhaPrevia.objRecebedorFav.iidplanoprevglobalinss := iidplanoprevglobalinss; //CPREV-26654-26/10/2007
      dtmFolhaPrevia.objRecebedorFav.iidplanoorigemglobalinss := iidplanoorigemglobalinss; //CPREV-26654-26/10/2007
      dtmFolhaPrevia.objRecebedorFav.iidplanocontabilglobalinss := iidplanocontabilglobalinss; //CPREV-26654-26/10/2007
      ProcessaRubricasConsignatario(liidpessoa,dtmFolhaPrevia.objRecebedorFav);
      dtmFolhaPrevia.ProcessaFechamentoRecebedor(dtmFolhaPrevia.objRecebedorFav, true, bErroInserePrevia);  // Andre Imakawa - SIG 80669

      dtmFolhaPrevia.objRecebedorFav.LimpaDados;

    end;
  finally
  end;
end;

procedure TobjRecebedor.ExecutaRegraRubrica(aflgPA : boolean);
 var lii: integer;
     objrubTemp, objrub: TObjRubrica;
     rValorMax, rValorMin: real;
     iTipoAcaoJud, istatusAcaoJud, iFazDeposito: Integer;
     rPercAcao: real;
     iNumBenefTot, iNumBenefGrupo: Integer;
     rpercgrupo: real;
     lrvalorbaseirrfsempa, lrperctotal, lrvalorexcecao,
     lrvalorliqtotal, lrvalorbenef, lrvalorbasepa, lvalorbaseirrf, rValbaseinss: real;

//*COLOCAR ESTA ROTINA FORA DA ROTINA DE EXECUÇÃO DA REGRA
//*VISTO QUE ESTE DADOS SÃO OS MESMOS PARA AS REGRAS DE PA OU REGRAS OUTRAS
  procedure ObtemDadosPessoa;
   var ssql: string;
  begin
    if not bconsignatario then
    begin
      dtmfolhaprevia.qryDetProcJudicial.first;
      If dtmFolhaPrevia.qryDetprocjudicial.eof then
      begin
        iTipoAcaoJud    := -1;
        iStatusAcaoJud  := -1;
        rPercAcao       := 0;
        iFazDeposito    := -1;
      end
      else
      begin
        iTipoAcaoJud   := dtmFolhaPrevia.qrydetprocjudicial.fieldbyname('TIPOACAO').asinteger;
        iStatusAcaoJud := dtmFolhaPrevia.qrydetprocjudicial.fieldbyname('SITPROCESSO').asinteger;
        rPercAcao      := dtmFolhaPrevia.qryDetProcJudicial.fieldbyname('PERCACAO').asFloat;
        iFazDeposito   := dtmFolhaPrevia.qrydetprocjudicial.fieldbyname('FLGFAZDEPOSITO').asinteger;
      end;
    end
    else
    begin
      iTipoAcaoJud    := -1;
      iStatusAcaoJud  := -1;
      rPercAcao       := 0;
      iFazDeposito    := -1;
    end;

    // Pega o Nº total de beneficiarios do titular
    if iidtitular <> iidresponsavel then
    begin
      //OTIMIZAÇÃO NA OBTENÇÃO DAS QUANTIDADES DE BENEFICIARIO
      ssql:='SELECT BF.IDPESSOA, BF.IDRESPONSAVEL, BF.PERCENTUAL '+_clinefeed+
            'FROM BFCIARIOTITPLAN BF, BENEFBFCIARIO BO '+_clinefeed+
            'WHERE BF.IDTITULAR = '+Inttostr(iidTitular)+' '+_clinefeed+
            'AND BF.IDPLANOPREV = '+Inttostr(iidplanoprevglobal)+' '+_clinefeed+
            'AND BF.IDPLANOPREV = BO.IDPLANOPREV '+_clinefeed+
            'AND BF.IDBENEFICIO = BO.IDBENEFICIO '+_clinefeed+
            'AND BF.IDTITULAR = BO.IDTITULAR '+_clinefeed+
            'AND BF.IDPESSOA = BO.IDPESSOA '+_clinefeed+
            'AND BF.IDPLANOORIGEM = BO.IDPLANOORIGEM '+_clinefeed+
            'AND BF.IDPESSJUR = BO.IDPESSJUR '+_clinefeed+
            'AND BO.IDSITBENEFICIO = 1 '+_clinefeed+
            'ORDER BY BF.IDRESPONSAVEL '+_clinefeed;
      dtmfolhaprevia.qryAux.close;
      dtmFolhaprevia.qryAux.sql.clear;
      dtmFolhaprevia.qryAux.sql.add(ssql);
      dtmFolhaprevia.qryAux.open;
      If dtmFolhaprevia.qryAux.isempty then
      begin
        iNumBenefTot:=1;
        iNumBenefGrupo:=1;
        rpercgrupo:=100;
      end
      else
      begin
        iNumBenefTot:=0;
        iNumBenefGrupo:=0;
        rpercgrupo:=0;
        while not dtmFolhaprevia.qryAux.eof do
        begin
          inc(iNumBenefTot);
          if dtmFolhaprevia.qryAux.fieldbyname('IDRESPONSAVEL').asinteger = iidresponsavel then
          begin
            inc(iNumBenefGrupo);
            rpercgrupo:=rpercgrupo+dtmFolhaprevia.qryAux.fieldbyname('PERCENTUAL').asfloat;
          end;
          dtmFolhaprevia.qryAux.next;
        end;
        if iNumBenefTot=0 then
          iNumBenefTot:=1;
        if iNumBenefGrupo=0 then
          iNumBenefGrupo:=1;
        if rpercgrupo=0 then
          rpercgrupo:=100;
      end;
    end;
     //dtmFolhaprevia.qryAux.Close;  // SOL 242740 PPM 575822
  end;

  procedure ObtemDadosParaRegra;
  begin
    //PROCURA NA QUERY COMPLETA DE LIMITES
    if dtmfolhaprevia.qryLimiteRubrica.locate('idpessoa;idrubrica',
         vararrayof([objrub.iidfavorecido, objrub.iidrubrica]), []) then
    begin
      rValorMin:=dtmfolhaprevia.qryLimiteRubrica.fieldbyname('LIMITEMINIMO').asFloat;
      rValorMax:=dtmfolhaprevia.qryLimiteRubrica.fieldbyname('LIMITEMAXIMO').asFloat;
    end
    else
    begin
      rValorMin:=0;
      rValorMax:=0;
    end;
    //SE LIMITE SUPERIOR É ZERO SIGNIFICA QUE NÃO TEM TETO
    if rValorMax = 0 then
      rValorMax:=9999999999;

    lrvalorbenef:=ValorBase(0, objrub.smes, false, (objrub.iflgPA = 0),
      objrub.iidregracalculo, nil, 0);

    lrvalorliqtotal:=ValorBase(1, objrub.smes, true, (objrub.iflgPA = 0),
      objrub.iidregracalculo, nil, 0);

    lrvalorbasepa:=ValorBase(1, objrub.smes, false, (objrub.iflgPA = 0),
      objrub.iidregracalculo, nil, 0);

    lvalorbaseirrf:=ValorBase(2, objrub.smes, false, (objrub.iflgPA = 0),
      objrub.iidregracalculo, nil, 0);

    lrvalorbaseirrfsempa:=ValorBase(3, objrub.smes, false, (objrub.iflgPA = 0),
      objrub.iidregracalculo, nil, 0);

    lrperctotal:=ValorBase(4, objrub.smes, false, (objrub.iflgPA = 0),
      objrub.iidregracalculo, nil, 0);

    if aflgPA then
    begin
      dtmFolhaPrevia.qryRubXPA.close;
      dtmFolhaPrevia.qryRubXPA.parambyname('PIDEMPRESA').asinteger:=iidpessjur;
      dtmFolhaPrevia.qryRubXPA.parambyname('PIDTITULAR').asinteger:=iidtitular;
      dtmFolhaPrevia.qryRubXPA.parambyname('PIDPESSOA').asinteger:=iidresponsavel;
      dtmFolhaPrevia.qryRubXPA.parambyname('PIDFAVORECIDO').asinteger:=objrub.iidfavorecido;
      dtmFolhaPrevia.qryRubXPA.parambyname('PSEQRUBRICAINDIV').asfloat:=objrub.eseqrubrica;
      dtmFolhaPrevia.qryRubXPA.open;
      lrvalorexcecao:=ValorBase(5, objrub.smes, true, (objrub.iflgPA = 0),
         objrub.iidregracalculo, dtmFolhaPrevia.qryRubXPA, 0);
      dtmFolhaPrevia.qryRubXPA.close;
    end
    else
      lrvalorexcecao:=0;

    dtmFolhaPrevia.qryRubXPA.Close; // SOL 242740 PPM 575822
  end;

//OBTER VALOR DE PA PROCESSADO NO ANO
  function ObtemValorPA: real;
  var lssql: string;
  begin
    lssql:='SELECT SUM(VALORPROVENTO) '+_clinefeed+
           'FROM HISTRUBSAL '+_clinefeed+
           'WHERE IDTITULAR = '+inttostr(iidtitular)+' '+_clinefeed+
           'AND IDPESSOA = '+inttostr(objrub.iidpessoa)+' '+_clinefeed+
           'AND IDFAVORECIDO = '+inttostr(objrub.iidfavorecido)+' '+_clinefeed+
           'AND IDRUBRICA = '+inttostr(objrub.iidrubrica)+' '+_clinefeed+
           'AND IDMODULO = 18 '+_clinefeed+
           'AND IDHSTFOLHABENEF IS NOT NULL '+_clinefeed+
           'AND FLGPENSAOALIM = 1 '+_clinefeed+
           'AND FLGTIPODESC = ''Y'' '+_clinefeed+
           'AND MES = '+quotedstr(copy(dtmFolhaPrevia.MesCobranca,1,4)+'/13')+' '+_clinefeed+
           'AND MESCOBRANCA < '+quotedstr(dtmFolhaPrevia.MesCobranca)+' '+_clinefeed+
           'AND SUBSTR(MESCOBRANCA,1,4) = '+quotedstr(copy(dtmFolhaPrevia.MesCobranca,1,4))+_clinefeed;

    if FazQuery(dtmFolhaPrevia.qryAux, lssql) then
       result:=dtmFolhaPrevia.qryAux.fields[0].asfloat
    else
      result:=0;

    dtmFolhaPrevia.qryAux.close; // SOL 242740 PPM 575822
  end;

  procedure ExecutaRegra(aitipobase: integer);
   var ssql, svalorregra: string;
       lBaseFUND, lBaseINSS: tObjBase;
       lberro: boolean;
       rValbaseSupl : real;
       lrvalorpasuple, lrvalorpainss: real;
       lrInssMes: real;
       lrSuplMes: real;
       lrContMes: real;
       lrContMesExcluido : real;  //Osni Cavalcante - SIG 58950.59454
       lrPASuplMes: real;
       lrPAINSSMes: real;
       lrvalorproc: real;
       lrauxpa: real;
       lrvalorregra: real;
       sdibs: string;
       lsopcaoir: string;
       lrSuplAtr: real;
       lrSuplAbn: real;
       lrINSSAtr: real;
       lrINSSAbn: real;
       lrSuplAbnAtr: real;
       lrINSSAbnAtr: real;
       lrContAtr: real;
       lrContAbn: real;
       lrContAbnExcluido: real;   //Osni Cavalcante - SIG 58950.59454
       lrINSSInfo: real; // Andre Imakawa - SIG 104022
  begin
    //TRATA REGRESSIVA TIPO = 2
    //if (objrub.scodirrfdarf = '5565') and (objrub.iflgPA = 1) then // Andre Imakawa - SIG 48125
    if (objrub.iOptaIRREgressivo = 1 ) and (objrub.iflgPA = 1) then // Andre Imakawa - SIG 48125
    begin
      lsopcaoir:='2';
      rValbaseSupl:=0;
      if Assigned(BaseFUNDREGR) then
        rValbaseSupl:=BaseFUNDREGR.rproventoirrf;
      //if Assigned(BaseFUND13REGR) then                            // Andre Imakawa - SIG 59550
      //  rValbaseSupl:=rValbaseSupl+BaseFUND13REGR.rproventoirrf;  // Andre Imakawa - SIG 59550
      if Assigned(BaseReservaREGR) then
        rValbaseSupl:=rValbaseSupl+BaseReservaREGR.rproventoirrf;
      rValbaseINSS:=0;
      lrvalorpasuple:=0;
      lrvalorpainss :=0;
      lrSuplMes:=rValbaseSupl;
      lrInssMes:=0;
      lrContMes:=0;
      lrContMesExcluido :=0;  //Osni Cavalcante - SIG 58950.59454
      lrPASuplMes:=0;
      lrPAINSSMes:=0;

      //VALORES DO ABONO DEVEM IR P/ RUBRICA NORMAL
      if aitipobase = 0 then
      begin
        if Assigned(BaseFUND) or (objrub.iflgPA = 0) then
          lrSuplMes:=rSuplMes;
        if (objrub.iflgPA = 1) then
          lrInssMes:=rINSSMesBasePA
        else
          lrInssMes:=rINSSMes;
        lrContMes:=rContMes;
        lrContMesExcluido := rContMesExcluido; //Osni Cavalcante - SIG 58950.59454     
        lrPASuplMes:=rPASuplMes;
        lrPAINSSMes:=rPAINSSMes;
      end
      else
      begin
        lrSuplMes:=rSuplAbn;
        if (objrub.iflgPA = 1) then
          lrInssMes:=rINSSAbnBasePA
        else
          lrInssMes:=rINSSAbn;
        lrContMes:=rContAbn;
        lrContMesExcluido := rContAbnExcluido;  //Osni Cavalcante - SIG 58950.59454
        lrPASuplMes:=rPASuplAbn;
        lrPAINSSMes:=rPAINSSAbn;
      end;
    end
    else
    begin
      lsopcaoir:='1';
      if aitipobase = 0 then
      begin
        lBaseFUND:=BaseFUND;
        lBaseINSS:=BaseINSS;
      end
      else
      begin
        lBaseFUND:=BaseFUND13;
        lBaseINSS:=BaseINSS13;
      end;

      rValbaseSupl:=0;
      if Assigned(lBaseFUND) then
        //AJUSTA BASESUPL PELO TOTAL BRUTO PARA IR
        rValbaseSupl:=lBaseFUND.rproventoirrf;

      rValbaseINSS:=0;
      if Assigned(lBaseINSS) then
        //AJUSTA BASESUPL PELO TOTAL BRUTO PARA IR
        rValbaseINSS:=lBaseINSS.rproventoirrf;

      //APURA TOTAIS DE PA JÁ CALCULADAS POR FONTEPAGADORA
      lrvalorpasuple:=ValorBase(6, objrub.smes, false, (objrub.iflgPA = 0),
        objrub.iidregracalculo, nil, 1);
      lrvalorpainss:= ValorBase(6, objrub.smes, false, (objrub.iflgPA = 0),
        objrub.iidregracalculo, nil, 2);

      //VALORES DO ABONO DEVEM IR P/ RUBRICA NORMAL
      if aitipobase = 0 then
      begin
        lrSuplMes:=0;
        if Assigned(BaseFUND) or (objrub.iflgPA = 0) then
          lrSuplMes:=rSuplMes;
        if (objrub.iflgPA = 1) then
          lrInssMes:=rINSSMesBasePA
        else
          lrInssMes:=rINSSMes;
        lrContMes:=rContMes;
        lrContMesExcluido := rContMesExcluido; //Osni Cavalcante - SIG 58950.59454
        lrPASuplMes:=rPASuplMes;
        lrPAINSSMes:=rPAINSSMes;
      end
      else
      begin
        lrSuplMes:=rSuplAbn;
        if (objrub.iflgPA = 1) then
          lrInssMes:=rINSSAbnBasePA
        else
          lrInssMes:=rINSSAbn;
        lrContMes:=rContAbn;
        lrContMesExcluido := rContAbnExcluido; //Osni Cavalcante - SIG 58950.59454
        lrPASuplMes:=rPASuplAbn;
        lrPAINSSMes:=rPAINSSAbn;
      end;
    end;

    try
      sdibs:='';
      if DIBFund > 0 then
        sdibs:=QuotedStr(formatdatetime('DD/MM/YYYY',DIBFund))+' AS DIBFUND, '+_clinefeed
      else
        sdibs:=Quotedstr('')+' AS DIBFUND, '+_clinefeed;

      if DIBINSS > 0 then
        sdibs:=sdibs+QuotedStr(formatdatetime('DD/MM/YYYY',DIBINSS))+' AS DIBINSS, '+_clinefeed
      else
        sdibs:=sdibs+Quotedstr('')+' AS DIBINSS, '+_clinefeed;
    except
       sdibs:='';
    end;

    if (objrub.bretraocaorindiv) or (objrub.iflgPA = 0) then
    begin
      lrSuplAtr:=rSuplAtr;
      lrSuplAbn:=rSuplAbn;
      lrINSSAtr:=rINSSAtr;
      lrINSSAbn:=rINSSAbn;
      lrSuplAbnAtr:=rSuplAbnAtr;
      lrINSSAbnAtr:=rINSSAbnAtr;
      lrContAtr:=rContAtr;
      lrContAbn:=rContAbn;
    end
    else //APENAS PARA PA
    begin
      AtribuiValoresPA(
        lrSuplAtr, lrSuplAbn,
        lrINSSAtr, lrINSSAbn,
        lrSuplAbnAtr, lrINSSAbnAtr,
        lrContAtr, lrContAbn,
        objrub.sdatainicio);
    end;

    // Andre Imakawa - SIG 104022 - Inicio
    lrINSSInfo := rINSSMes;
    // Andre Imakawa - SIG 104022 - Fim

    try
      sSQL:=
        'SELECT '+
          sdibs+
          QuotedStr(CodigoPais)+' AS CODPAIS, '+_clinefeed+ //USAR PROPRIEDADE CODIGOPAIS DO OBJETO
          inttostr(iflgtipofolha)+' AS FLGTIPOFOLHA, '+_clinefeed+
          inttostr(iflgconcessaolote)+' AS FLGCONCESSAO, '+_clinefeed+
          inttostr(iTemRubAtrasoIR)+' AS FLGRUBATRASOIR, '+_clinefeed+
          oranumero(formatfloat('#0.00',lrvalorbenef))+' AS VLRBRUTO,  '+_clinefeed+
          inttoStr(iNumBenefTot)+' AS NUMBENTOT, '+_clinefeed+
          inttoStr(iNumBenefGrupo)+' AS NUMBENGR, '+_clinefeed+
          oranumero(formatfloat('#0.000000',rpercgrupo))+' AS PERCENTUAL, '+_clinefeed+
          inttostr(iTipoAcaoJud)+' AS TIPOACAO, '+_clinefeed+
          inttostr(iStatusAcaoJud)+' AS STATUSACAO, '+_clinefeed+
