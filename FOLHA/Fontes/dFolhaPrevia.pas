    //edilaine WO32316 : inicio
    //sSQL := 'INSERT INTO CM.REGRA_IRRF_REDUCAO(SEQ, VALOR_FUNCEF, VALOR_INSS, SOMA_FONTES, DEDUCOES, DEDUCOES_EQUA, ' + #13#10 +
    //        '                                  PERCACAO, BASEIRRF ) '   + #13#10 +       //edilaine WO31036
    sSQL := 'INSERT INTO CM.REGRA_IRRF_REDUCAO(SEQ, PARAMETROS_IN) '+ #13#10 +
