  var
    lii, liiPlano, liContadorPlano: Integer;
    objrub: tobjrubrica;
    lrsinal: Real;
    lbErro, lbAchouProgressivo: boolean;
    sAuxTipoREINF: string;
    objPlano: tobjPlano;
    sSQL: string;
    queryGrupoRubrica: TwwQuery; // Andre Imakawa - WO 5170
  begin
    lbErro := False;
    try
      queryGrupoRubrica := TwwQuery.Create(nil); // Andre Imakawa - WO 5170
      try

        for liContadorPlano := 0 to lstPlanos.count - 1 do
        begin
          objPlano := (lstPlanos.objects[liContadorPlano] as tobjplano);
          if (objPlano.OpcaoIR <> 2) then // Andre Imakawa - WO3011
          begin
            lbAchouProgressivo := True;
            Break;
          end;
        end;

        if not(lbAchouProgressivo) then
        begin
          for lii := 0 to lstRubricas.count - 1 do
          begin
            objrub := (lstRubricas.objects[lii] as tobjrubrica);
            if (objrub.sflgtipodesc = 'I') and (objrub.ifontepagadora = 2) then
            begin
              lbAchouProgressivo := True;
              Break;
            end;
          end;
        end;

        if lbAchouProgressivo then
        begin

          // Andre Imakawa - WO 5170 - Inicio
          queryGrupoRubrica.DataBaseName := 'BaseDados';
          queryGrupoRubrica.close;

          sSQL := ' SELECT C.IDRUBRICA' + ' FROM CONJUNTORUBXRUB C' + ' INNER JOIN CM.CONJUNTORUBRICA CR ON C.IDCONJUNTORUBRICA = CR.IDCONJUNTORUBRICA' + ' WHERE CR.CODIGO = ''IR''';

          queryGrupoRubrica.SQL.Add(sSQL);
          queryGrupoRubrica.open;
          // Andre Imakawa - WO 5170 - Fim

          CarregaCdsReinf('''REINFIRINF'',''REINFIRJUD'',''REINFIRCOM''',1);

          for lii := 0 to lstRubricas.count - 1 do
          begin
            objrub := (lstRubricas.objects[lii] as tobjrubrica);
