  scodirrfdarf:=ascodirrfdarf;
  if ascodirrfdarfori <> '' then
    scodirrfdarfori:=ascodirrfdarfori
  else
    scodirrfdarfori:=ascodirrfdarf;

  icodalterador    :=aicodalterador;
  ifontepagadora   :=aifontepagadora;
