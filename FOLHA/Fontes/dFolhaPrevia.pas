  if ((aobjrub.sflgtipodesc <> 'Y') {and (aobjrub.iflgirrf <> 0)}) then    // SOL SOL 226005 Kintana 2059695 comentado o {and (aobjrub.iflgirrf <> 0)}
  begin
    lbBenefIsento := ObtemBeneficioIsento(aobjrub.iidbeneficio);   //edilaine SIG92016

    aobjbase.rvalorbruto:=aobjbase.rvalorbruto+arvalorrubrica;
    if ((aobjrub.iflgirrf = 1) and (iiDescIRMes = 0) and (not(flgbitrib))) then // SOL 218360 - KTN 2049283
    begin
      // Andre Imakawa - SIG 49800-60759 - Inicio
      //lbBenefIsento := ObtemBeneficioIsento(aobjrub.iidbeneficio);             //edilaine SIG92016
      if not(lbBenefIsento) then
        aobjbase.rproventoirrf:=aobjbase.rproventoirrf+arvalorrubrica;
      // Andre Imakawa - SIG 49800-60759 - Fim
    end;

    //edilaine SIG92016 : inicio
    if (aobjrub.iFlgIsentoAcaoGanha = 1) and (not lbBenefIsento) and 
       (aobjrub.iflgirrf = 0) and (iiDescIRMes = 0) and (not flgbitrib) then
       aobjbase.rProvIsentoIrAcaoJud := aobjbase.rProvIsentoIrAcaoJud + arvalorrubrica;
    //edilaine SIG92016 : fim

    aobjbase.rvalorliquido:=aobjbase.rvalorbruto;
  end;

  lstMesRefProv.add(aobjrub.smes);
  if aobjrub.smes > sUltMesRefReal then
    sUltMesRefReal:=aobjrub.smes;
  smesrefprov:=aobjrub.smes;
  iidrubrefprov:=aobjrub.iidrubrica;
end;

procedure TobjRecebedor.ClassificaRubricaBase(
  aobjrub : TobjRubrica;
  arvalororiginalrubrica: real;
  flgbitrib: boolean = false); // SOL 218360 - KTN 2049283
var litipomargem, lproximo, lindice : integer;
    lsbase, lsordem : string;
    lobjbase : tobjbase;
begin
  VerificaIrrfDarfRegimeRegressivo(aobjrub);   //edilaine WO32047

  if (aobjrub.sflgtipodesc='B') or (aobjrub.sflgtipodesc='R') then
    litipomargem:=dtmFolhaPrevia.DeterminaTipoMargem(aobjrub)
  else
  begin
    If copy(aobjrub.smes,6,2) = '13' then
    begin
      if (aobjrub.ifontepagadora = 2) then
        litipomargem:=4
      else
        litipomargem:=3;
    end
    else
    begin
      if (aobjrub.ifontepagadora = 2) then
        litipomargem:=2
      else
        litipomargem:=0;
    end;
  end;
  aobjrub.itipomargem:=litipomargem;

  //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
  //deve seguir a parametrizaco do cadastro de rubricas
  {if (litipomargem in [5, 6, 7]) then
    aobjrub.scodirrfdarf:='5565';}
  //VerificaIrrfDarfRegimeRegressivo(aobjrub);                   //edilaine WO32047
  //FIM Helio - SOL Nº 151061-10442 KINTANA Nº 1720319

  if (litipomargem = 9)  then
  begin
    aobjrub.iflgok:=0;
    aobjrub.sflgtipodesc:='K';
  end
  else
    if (aobjrub.iflgdesconto = 0) then
    begin
      if (aobjrub.sflgtipodesc <> 'Q') and
         (aobjrub.iflgirrf = 1) and (trim(aobjrub.scodirrfdarf) = '') then
        dtmFolhaPrevia.ExibeMensagemSemRecebedor('Rubrica:'+
          inttostr(aobjrub.iidrubrica)+' sem a Natureza de Rendimento '+
          'parametrizada, mas compõe IR. '+
          'Fazer a parametrização no cadastro de rubricas.');
      //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
      //somente avisa, nao impede que a base seja alocada
      //comenta
      {else
      begin}
      //FIM Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
        if not(flgbitrib) then
        begin
            case litipomargem of
              0 : AlocaBase('FUND',   0, BaseFUND,    aobjrub,
                    arvalororiginalrubrica
                    );
              1 : AlocaBase('RESE',   4, BaseReserva, aobjrub,
                    arvalororiginalrubrica
                    );
              2 : AlocaBase('INSS',   1, BaseINSS,    aobjrub,
                    arvalororiginalrubrica
                    );
              3 : AlocaBase('FUND13', 2, BaseFUND13,  aobjrub,
                    arvalororiginalrubrica
                    );
              4 : AlocaBase('INSS13', 3, BaseINSS13,  aobjrub,
                    arvalororiginalrubrica
                    );
              5 : AlocaBase('FUNDREGR', 5, BaseFUNDREGR, aobjrub,
                    arvalororiginalrubrica
                    );
              6 : AlocaBase('FUND13REGR', 6, BaseFUND13REGR, aobjrub,
                    arvalororiginalrubrica
                    );
              7 : AlocaBase('RESEREGR', 7, BaseReservaREGR, aobjrub,
                    arvalororiginalrubrica
                    );
              8 : AlocaBase('RESECD', 8, BaseReservaCD, aobjrub,
                    arvalororiginalrubrica
                    );
            end;
        end
        else
        begin   // SOL 218360 - KTN 2049283
            case litipomargem of
              0 : AlocaBase('FUND',   0, BaseFUND,    aobjrub,
                    arvalororiginalrubrica, flgbitrib
                    );
              3 : AlocaBase('FUND13', 2, BaseFUND13,  aobjrub, // SOL 241799 PPM 557943
                    arvalororiginalrubrica, flgbitrib // SOL 242967 PPM 579335
                    );
            end;
        end;
      end;
    //end; //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
end;



