          'WHERE H.IDPLANOPREV = A.IDPLANOPREV '+_clinefeed+
          'AND H.IDBENEFICIO = A.IDBENEFICIO '+_clinefeed+
          'AND H.IDBENEFICIO = B.IDBENEFICIO(+) '+_clinefeed+  // Felipe A. Santos - SOL 258357/17801 PPM 1083052
