              end
              else
              begin
                // Falta Parametrização REINF04 // sAuxTipoREINF
              end;

            end;
          end;
        end
        else
        begin
          // Falta Parametrização REINF04
        end;

      except
        lbErro := True;
      end;
    finally
      Result := lbErro;
    end
  end;

  function ProcessaRubricasREINFIRPRO(qryTipoREINF: twwquery;
