    sDataCalculo := '01/'+Copy(MesCobranca,6,2)+'/'+Copy(MesCobranca,1,4);                                  //edilaine WO19556

    qryAux2.Close;
    qryAux2.Sql.Clear;
    qryAux2.Sql.Add('SELECT H.IDPESSOA, H.IDBENEFICIO, NVL(PPAR.VALOR,''N'') MORAFORA'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - Adicionado o IDBENEFICIO //Taffarel - SIG49027
    qryAux2.Sql.Add('  FROM HSTBENEFBFCIARIO H, BENEFPLANPREV B, LOTESPREVIABENEF LP, PARTPREVPLAN PP, PESSOAPARAM PPAR '); //SOL 261281 PPM 1065000 //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587 //Taffarel - SIG49027
    qryAux2.Sql.Add('       , BENEFICIO BN ');    //edilaine - SIG71773

    //leandro - WO20725 - inicio
    qryAux2.Sql.Add('        , (SELECT max(bt.TIPOOPCAOIR) AS TIPOOPCAOIR ');
    qryAux2.Sql.Add('                  ,bt.IDPESSJUR, bt.IDTITULAR, bt.IDPESSOA, bt.SEQPROPOSTA, bt.IDPLANOPREV, bt.IDPLANOORIGEM');
    qryAux2.Sql.Add('             FROM bfciariotitplan bt ');
    qryAux2.Sql.Add('             WHERE bt.idtitular <> bt.idpessoa ');
    qryAux2.Sql.Add('            GROUP BY bt.IDPESSJUR, bt.IDTITULAR, bt.IDPESSOA, bt.SEQPROPOSTA, bt.IDPLANOPREV, bt.IDPLANOORIGEM ');
    qryAux2.Sql.Add('        ) btt  ');
    //leandro - WO20725 - fim

    qryAux2.Sql.Add(' WHERE H.IDPESSJUR IN (91008,1)');   //ALINHADO COM O JOÃO, PODEMOS FIXAR OS IDPESSJUR, PERFORMANCE
    qryAux2.Sql.Add('   AND H.FONTEPAGADORA IN (1, 2)'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - adicionado o fonte pagadora = 1
    //qryAux2.Sql.Add('   AND H.IDLOTE IN (' + frmFolhaNormalPrevia.sLotesSelecionados + ')'); //SOL 261281 PPM 1065000
    qryAux2.Sql.Add('   AND H.IDLOTE = LP.IDLOTE '); //SOL 261281 PPM 1065000
    qryAux2.Sql.Add('   AND LP.IDPREVIABENEF = ' + FloatToStr(frmFolhaNormalPrevia.iIdPreviaBenef) ); //SOL 261281 PPM 1065000
    qryAux2.Sql.Add('   AND H.MESREFERENCIA <= TO_CHAR(ADD_MONTHS(TO_DATE('+QuotedStr(sDataCalculo)+'), -12), ''YYYY'')||''/13''');
    qryAux2.Sql.Add('   AND B.IDPLANOPREV = H.IDPLANOPREV');
    qryAux2.Sql.Add('   AND B.IDBENEFICIO = H.IDBENEFICIO');

    qryAux2.Sql.Add('   AND BN.IDBENEFICIO = H.IDBENEFICIO');    //edilaine - SIG71773

    //wo20725 leandro - inicio
    qryAux2.Sql.Add('    AND BTT.IDPESSJUR(+)     = H.IDPESSJUR ');
    qryAux2.Sql.Add('    AND BTT.IDTITULAR(+)     = H.IDTITULAR ');
    qryAux2.Sql.Add('    AND BTT.IDPESSOA(+)      = H.IDPESSOA  ');
    qryAux2.Sql.Add('    AND BTT.SEQPROPOSTA(+)   = H.SEQPROPOSTA  ');
    qryAux2.Sql.Add('    AND BTT.IDPLANOPREV(+)   = H.IDPLANOPREV  ');
    //leandro wo20725 - fim

    //qryAux2.Sql.Add('   AND B.IDRUBRICANORMALRRA IS NOT NULL');  // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - Comentado
    qryAux2.Sql.Add('   AND B.IDRUBRICAATRASORRA IS NOT NULL'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
    qryAux2.Sql.Add(' AND (PPAR.IDPESSOA(+) = H.IDPESSOA)'); //Taffarel - SIG49027
    qryAux2.Sql.Add(' AND (PPAR.IDPARAM(+) = 210 )'); //Taffarel - SIG49027
    //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
    qryAux2.Sql.Add('   AND PP.IDPESSOA = H.IDTITULAR');
    qryAux2.Sql.Add('   AND PP.IDPESSJUR = H.IDPESSJUR');
    qryAux2.Sql.Add('   AND ((H.IDPLANOPREV = PP.IDPLANOPREV AND H.IDPESSOA = H.IDTITULAR) OR');
    qryAux2.Sql.Add('        (H.IDPLANOORIGEM = PP.IDPLANOPREV AND H.IDPESSOA <> H.IDTITULAR))');
    //edilaine - SIG71773 - inicio
    //qryAux2.Sql.Add('   AND ((H.FONTEPAGADORA = 1 AND NVL(PP.TIPOOPCAOIR,1) <> 2) OR');
    //qryAux2.Sql.Add('        (H.FONTEPAGADORA = 2))');
    // qryAux2.Sql.Add('   AND ((H.FONTEPAGADORA = 1 AND (NVL(PP.TIPOOPCAOIR,1) <> 2 OR'); //wo20725 leandro
    qryAux2.Sql.Add('  AND ((H.FONTEPAGADORA = 1 AND (NVL(DECODE(H.IDTITULAR, H.IDPESSOA, PP.TIPOOPCAOIR, BTT.TIPOOPCAOIR),1) <> 2 OR'); //wo20725 leandro

    qryAux2.Sql.Add('        (BN.FLGPORTADO = 1 AND BN.FLGIRREGRESSIVO=0))) OR');
    qryAux2.Sql.Add('        (H.FONTEPAGADORA = 2))');
    //edilaine - SIG71773 - fim
    //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
    qryAux2.Sql.Add('   AND EXISTS (SELECT P.VALORPARAM VALOR');
