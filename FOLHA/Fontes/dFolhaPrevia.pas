procedure TdtmFolhaPrevia.GeraListaPartIRRegressivo(var lista : TStringList);     //edilaine WO19556
var
    //lista : TStringList;        //edilaine WO19556
    linhaParticipante : String;

    function LinhaAtualOptIRRegressivo:String;
    var
       sSql : String;
    begin
       Result := '';

       //edilaine - SIG71773 - inicio
       if ((qryPrevia.FieldByName('TIPOOPCAOIR').AsInteger = 2) and not
           ((qryPrevia.FieldByName('FLGPORTADO').AsInteger = 1) and (qryPrevia.FieldByName('FLGIRREGRESSIVO').AsInteger = 0))) or
          ((qryPrevia.FieldByName('FLGPORTADO').AsInteger = 1) and
           (qryPrevia.FieldByName('FLGIRREGRESSIVO').AsInteger = 1)) then    //edilaine - SIG71773 - fim
       begin
          {sSql := ' SELECT ' +#13+
                  ' (SELECT MATRICULA FROM DEPENTIT WHERE IDTITULAR = B.IDTITULAR AND IDPESSOA = B.IDPESSOA) AS MATRICULA, ' +#13+
                  ' (SELECT NOME FROM PESSOA WHERE IDPESSOA = B.IDPESSOA) AS NOME, ' +#13+
                  ' B.* FROM BASEDEPAGAMENTOPREVIA B ' +#13+   }
          //sSql := ' SELECT  d.matricula, p.nome FROM BASEDEPAGAMENTOPREVIA B   ' +#13+ //SOL 207789 KINTANA 2029238
          sSql := ' SELECT  d.matricula, p.nome FROM BASEDEPAGAMENTO B   ' +#13+ //SOL 207789 KINTANA 2029238
                  ' inner join DEPENTIT d on (d.idpessoa = b.idpessoa)  ' +#13+
                  ' inner join PESSOA p on (p.idpessoa = d.idpessoa)' +#13+
                  ' WHERE B.IDTITULAR = ' + qryPrevia.FieldByName('IDTITULAR').AsString +#13+
                  ' AND B.IDPESSOA =  ' + qryPrevia.FieldByName('IDPESSOA').AsString +#13+
                  ' AND B.MES = ' + QuotedStr(qryPrevia.FieldByName('MES').AsString) +#13+
                  ' AND B.MESCOBRANCA = ' + QuotedStr(dtmFolhaPrevia.MesCobranca) +#13+
                  ' AND (B.VLRIRREGRESSIVO IS NULL OR B.VLRIRREGRESSIVO <= 0) ';


          with TwwQuery.Create(nil) do    //edilaine WO19556
          begin
            DataBaseName := dtmBaseDados.dbBaseDados.DataBaseName;

            SQL.Clear;

            SQL.Text := sSql;

            Open;

            if Not IsEmpty then
              Result := FieldByName('MATRICULA').AsString + ' - ' + FieldByName('NOME').AsString;

            Close;
            Free;
          end; //with TwwQuery.Create(dtmBaseDados) do


       end;//if qryPrevia.FieldByName('TIPOOPCAOIR').AsInteger = 2 then

    end; //fim function LinhaAtualOptIRRegressivo

begin //GeraListaPartIRRegressivo

   //lista := TStringList.Create;

   qryPrevia.First;
   while not qryPrevia.Eof do
   begin

       linhaParticipante := LinhaAtualOptIRRegressivo;

       if linhaParticipante <> '' then
       begin
           if lista.IndexOf( linhaParticipante ) = -1 then
                lista.Add( linhaParticipante);
       end;

       qryPrevia.Next;
   end;

   //Result := lista;   //edilaine WO19556

end; //fim GeraListaPartIRRegressivo

function TdtmFolhaPrevia.VerificaParametrizacaoRRA: Boolean;
begin
  // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - início
  try
    qryAuxRRA.Close;
    qryAuxRRA.SQL.Clear;
    qryAuxRRA.SQL.Add('SELECT BPP.IDRUBRICAATRASORRA, ');
    qryAuxRRA.SQL.Add('       BPP.IDRUBRICADEVOLUCAORRA, ');
    qryAuxRRA.SQL.Add('       BPP.IDRUBRICAREVATRASORRA, ');
    qryAuxRRA.SQL.Add('       BPP.IDRUBRICAREVDEVOLUCAORRA, ');
    qryAuxRRA.SQL.Add('       BPP.IDRUBRICACORATRASORRA, ');
    qryAuxRRA.SQL.Add('       BPP.IDRUBRICACORDEVOLUCAORRA, ');
    qryAuxRRA.SQL.Add('       P.NOME AS NOMEPLANO, ');
    qryAuxRRA.SQL.Add('       B.NOME AS NOMEBENEF ');
    qryAuxRRA.SQL.Add('  FROM BENEFPLANPREV BPP, PLANPREV P, BENEFICIO B ');
    qryAuxRRA.SQL.Add(' WHERE BPP.IDBENEFICIO = B.IDBENEFICIO ');
    qryAuxRRA.SQL.Add('   AND BPP.IDPLANOPREV = P.IDPLANOPREV ');
    qryAuxRRA.SQL.Add('   AND BPP.IDBENEFICIO = :IDBENEFICIO ');
    qryAuxRRA.SQL.Add('   AND BPP.IDPLANOPREV = :IDPLANOPREV ');
    qryAuxRRA.ParamByName('IDBENEFICIO').AsInteger := qryPrevia.FieldByName('IDBENEFICIO').AsInteger;
    qryAuxRRA.ParamByName('IDPLANOPREV').AsInteger := qryPrevia.FieldByName('IDPLANOPREV').AsInteger;
    qryAuxRRA.Open;

    sBenefRRA := qryAuxRRA.FieldByName('NOMEBENEF').AsString;
    sPlanoRRA := qryAuxRRA.FieldByName('NOMEPLANO').AsString;

    if (Trim(qryAuxRRA.FieldByName('IDRUBRICAATRASORRA').AsString) = '') or
       (Trim(qryAuxRRA.FieldByName('IDRUBRICADEVOLUCAORRA').AsString) = '') or
       (Trim(qryAuxRRA.FieldByName('IDRUBRICAREVATRASORRA').AsString) = '') or
       (Trim(qryAuxRRA.FieldByName('IDRUBRICAREVDEVOLUCAORRA').AsString) = '') or
       (Trim(qryAuxRRA.FieldByName('IDRUBRICACORATRASORRA').AsString) = '') or
       (Trim(qryAuxRRA.FieldByName('IDRUBRICACORDEVOLUCAORRA').AsString) = '')
    then
    begin
      Result := False;
    end
    else
      Result := True;

  finally
    qryAuxRRA.Close;
    qryMat.Close;
  end;
  // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim
end;

