//FAZ O RATEIO DAS RUBRICAS POR PLANO
procedure TobjRecebedor.ProcessaRateioRubricas;
var litotalrub, licontador, icount, liplano, //SIG21573
    RetEnc, liRateio: integer;  // SOL 223400 Kintana 2057026
    lobjrubTemp, lobjrub, lobjrubAux: tobjrubrica; //SIG21573
    lobjplano: tobjplano;
    lrvalorrub, lrvalorusado, lrvalorparcial,
    rValorTotalPlano, rValorProvento, rValorTotalPlanoGeral, rValorTotalPlanoSaldado : real; // SOL 223400 Kintana 2057026
    lsordem, lsprioridade, lstipodescordenado: string;
    liplano_aux, lContProgressivo, lContRegressivo: integer; // Andre Imakawa - SIG 60585
    lobjplano_aux: tobjplano;  // Andre Imakawa - SIG 60585
    lbpassou: boolean; // Andre Imakawa - SIG 68508
    iidplanocontabilAux: integer; // Andre Imakawa - SIG 69744
    rValorTotalPlano13, rValorTotalPlanoGeral13, rValorTotalPlanoSaldado13 : real; // Andre Imakawa - SIG 94056
    bFezRateio : boolean;          //edilaine WO24367
begin


  //Renato Visoni SOL 114192 KINTANA 532893
  for liContador:=0 to lstRubricas.count -1 do begin
    lObjRub := (lstRubricas.objects[liContador] as tObjRubrica);

    if lObjRub.iflgirrf = 1 then begin
      if iIdPlanos = 0  then begin
        iIdPlanos := lObjRub.iidplanocontabil;
        inc(iPlanosComIrrf);
      end else if iIdPlanos <> lObjRub.iidplanocontabil then begin
        inc(iPlanosComIrrf);
      end;
    end;
  end;
  //Renato Visoni SOL 114192 KINTANA 532893

  lstRubricas.Sorted:=false;
  litotalrub:=lstRubricas.count;

  for licontador:=0 to litotalrub-1 do
  begin
    lobjrub:=(lstRubricas.objects[licontador] as tobjrubrica);
    // SOL 223400 Kintana 2057026 inicio
    if (lobjrub.iflgirrf = 1) and (lobjrub.iflgdesconto = 0) then
    begin
       if (lobjrub.ipossuiabono = 1) and (copy(lobjrub.smes,6,2) = '13') then
       begin
          if ((lobjrub.iidplanocontabil  = iidplanocontabilglobal )) then
          begin
             rValorTotalPlano := rValorTotalPlano + lobjrub.rvalorprovento;
             rValorTotalPlanoGeral := rValorTotalPlanoGeral + lobjrub.rvalorprovento;
          end
          else
          begin
             rValorTotalPlanoSaldado := rValorTotalPlanoSaldado + lobjrub.rvalorprovento;
             rValorTotalPlanoGeral := rValorTotalPlanoGeral + lobjrub.rvalorprovento;
          end;
       end;
    end;
    // SOL 223400 Kintana 2057026 final
    if ((lobjRub.bRateioPlano) and (iPlanosComIrrf > 1) and         //Renato Visoni SOL 114192 KINTANA 532893  and (iPlanosComIrrf > 1)
        (Self.VerificaTipoOpcaoIRRateiro(lObjRub.iidpessoa)) and    // SOL:121791 - Daniel Begnami
        (Self.VerificaFontePagadora(lObjRub.iidrubrica))            //BRUNO AZEVEDO SOL 133804 KINTANA 782606
         and (lobjrub.iFontePagadora <> 2)                          // Aline Freire SOL 161349 KINTANA 1359475
        ) then
    begin
      lrvalorrub:=lobjrub.rvalorprovento;
      lrvalorusado:=0;

