    function CalcIdade(dDataNasc: TDateTime): integer;
      begin
        if Trim(FormatDateTime('dd/mm/yyyy', dDataNasc)) = ''
        then Result := 0
        else Result := Trunc((date - dDataNasc) / 365.25);
      end;


