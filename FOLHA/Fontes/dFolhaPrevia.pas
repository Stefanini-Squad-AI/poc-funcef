//PARA APURAR VALOR AGREGADO SEM ZERAR E COM PARCIAL
function TObjRecebedor.ApuraValor(iparcial: integer; rvalor, rvalparc: real): real;
begin
  if rvalor + rvalparc < 0 then
  begin
    if iparcial = 1 then
      result:=0
    else
      result:=rvalor;
  end
  else
    result:=rvalor+rvalparc;
end;

//NOVA ROTINA PARA CALCULA A PARTIR DA DATA INICIO DA PA
procedure TobjRecebedor.AtribuiValoresPA(var prSuplAtr, prSuplAbn, prINSSAtr,
  prINSSAbn, prSuplAbnAtr, prINSSAbnAtr, prContAtr, prContAbn: real;
  psdatainicio: string);
var lii: integer;
    lrbase: real;
    lrsinal: real;
    lsmesbase: string;
    lobjrub: TobjRubrica;
begin
  lrbase:=0;

  if length(psdatainicio) <> 10 then
    lsmesbase:='0000/00'
  else
    lsmesbase:=copy(psdatainicio,7,4)+'/'+copy(psdatainicio,4,2);

  prSuplAtr:=0;
  prSuplAbn:=0;
  prINSSAtr:=0;
  prINSSAbn:=0;
  prSuplAbnAtr:=0;
  prINSSAbnAtr:=0;
  prContAtr:=0;
  prContAbn:=0;

  for lii:=0 to lstRubricas.count-1 do
  begin
    lobjrub:=TobjRubrica(lstRubricas.objects[lii]);

    if lobjrub.smes < lsmesbase then
      continue;

    if lobjrub.iflgdesconto = 0 then
      lrsinal:=1
    else
      lrsinal:=-1;

    if (lobjrub.smes <> dtmfolhaprevia.Mescobranca) and
       (copy(lobjrub.smes,6,2) <> '13') and
       (lobjrub.sflgtipodesc = 'B') and
       (lobjrub.ifontepagadora = 1) then
    begin
      prSuplAtr:=prSuplAtr+lrsinal*lobjRub.rvalorrecebido;
      continue;
    end;

    if (lobjrub.smes = dtmfolhaprevia.MesAbono) and
       (lobjrub.sflgtipodesc = 'B') and
       (lobjrub.ifontepagadora = 1) then
    begin
      if lrsinal > 0 then
        prSuplAbn:=prSuplAbn+lrsinal*lobjRub.rvalorrecebido;
      continue;
    end;

    if (lobjrub.smes <> dtmfolhaprevia.Mescobranca) and
       (copy(lobjrub.smes,6,2) <> '13') and
       (lobjrub.sflgtipodesc = 'B') and
       (lobjrub.ifontepagadora = 2) then
    begin
      prINSSAtr:=prINSSAtr+lrsinal*lobjRub.rvalorrecebido;
      continue;
    end;

    if (copy(lobjrub.smes,6,2) = '13') and
       (lobjrub.sflgtipodesc = 'B') and
       (lobjrub.ifontepagadora = 2) then
    begin
      if lrsinal > 0 then
        prINSSAbn:=prINSSAbn+lrsinal*lobjRub.rvalorrecebido;
      continue;
    end;

    if (lobjrub.smes <> dtmfolhaprevia.MesAbono) and
       (copy(lobjrub.smes,6,2) = '13') and
       (lobjrub.sflgtipodesc = 'B') and
       (lobjrub.ifontepagadora = 1) then
    begin
      prSuplAbnAtr:=prSuplAbnAtr+lrsinal*lobjRub.rvalorrecebido;
      continue;
    end;

    if (lobjrub.smes <> dtmfolhaprevia.MesAbono) and
       (copy(lobjrub.smes,6,2) = '13') and
       (lobjrub.sflgtipodesc = 'B') and
       (lobjrub.ifontepagadora = 2) then
    begin
      prINSSAbnAtr:=prINSSAbnAtr+lrsinal*lobjRub.rvalorrecebido;
      continue;
    end;

    if (lobjrub.smes <> dtmfolhaprevia.Mescobranca) and
       (copy(lobjrub.smes,6,2) <> '13') and
       (lobjrub.sflgtipodesc = 'P') then
    begin
      prContAtr:=prContAtr+lrsinal*lobjRub.rvalorrecebido;
      continue;
    end;

    if (copy(lobjrub.smes,6,2) = '13') and
       (lobjrub.sflgtipodesc = 'P') then
    begin
      if lrsinal < 0 then
        prContAbn:=prContAbn+lrsinal*lobjRub.rvalorrecebido;
      continue;
    end;
  end;
end;

function TObjRecebedor.ValorBase(aitipobase : integer; asmesref : string;
  abforca, abforcames : boolean; aiidregra : integer; qryRub : twwquery;
  aifontepagadora: integer //PARA OBTER TOTAL DE PA's CALCULADAS
  ) : real;
//
// ABFORCA - FORCA BASE DE DESCONTO TOTAL NA BASE DE PA
//  valido apenas para aitipobase = 1
// inclusao dos tipos 3 e 4
{- Parâmetro aitipobase :
  0 - base bruto;
  1 - base PA;
  2 - base IRRF;
  3 - base para IRRF sem considerar outras PA;
  4 - valor percentual para mesma regra;
  5 - valor das rubricas de excecao para PA;
  6 - valor das PAs calculadas por fonte pagadora;
  7 - valor do IR por fonte pagadora}

// inclusao do tipo 5 que avalia as rubricas que pertencem a query qryRub de exceções para PA
 var lii : integer;
     lrbase : real;
begin
  lrbase:=0;
  for lii:=0 to lstRubricas.count-1 do
  begin
    with TobjRubrica(lstRubricas.objects[lii]) do
    begin
      //DESPREZAR NO CALCULO DE QUALQUER BASE A RUBRICA DE ARREDONDAMENTO DO MES ANTERIOR
      if (prmIDRUBARREDMESANT > 0) and (prmIDRUBARREDMESANT = iidrubrica) then
        continue;
      case aitipobase of
        0 : {NAO UTILIZAR NESTES CALCULOS AS RUBRICAS DE EMPRESTIMO}
            {NAO UTILIZAR NESTES CALCULOS AS RUBRICAS INFORMATIVAS}
            if (sflgtipodesc <> 'K') and (sflgtipodesc <> 'W') and
               (sflgtipodesc <> 'E') and (iflgdesconto < 2) then
            begin
              if (((copy(smes,6,2) = '13') and (copy(asmesref,6,2) = '13')) or
                  ((copy(smes,6,2) <> '13') and (copy(asmesref,6,2) <> '13'))) then
              begin
                if (iformabasePA = 1) and
                {PARA CBS DEVE-SE CONSIDERAR PARAMETRO SE
                 RUBRICA FORMA BASE DA PA NO CALCULO DO VALOR BRUTO}
                   (iflgdesconto = 0) and ((not abforcames) or (smes = asmesref)) then
                    lrbase:=lrbase+rValorprovento;
              end;
            end;
        1 : {NAO UTILIZAR NESTES CALCULOS AS RUBRICAS DE EMPRESTIMO}
            {NAO UTILIZAR NESTES CALCULOS AS RUBRICAS INFORMATIVAS}
            if (sflgtipodesc <> 'K') and (sflgtipodesc <> 'W') and
               (sflgtipodesc <> 'E') and (iflgdesconto < 2) then
            begin
              if (((copy(smes,6,2) = '13') and (copy(asmesref,6,2) = '13')) or
                  ((copy(smes,6,2) <> '13') and (copy(asmesref,6,2) <> '13'))) then
              begin
                if iflgdesconto = 0 then
                begin
                  if (iformabasePA = 1) and ((not abforcames) or (smes = asmesref)) then
                    lrbase:=lrbase+(1-2*iflgdesconto)*rvalorrecebido;
                end
                else
                  if iflgdesconto = 1 then
                  begin
                    if not abforca then //Liquido Normal
                    begin
                      if (iformabasePA = 1) and (iflgPA = 0) and
                         ((not abforcames) or (smes = asmesref)) then
                      begin
                        //PARAMETRO PARA CONTROLAR SE BASE DE CALCULO PODE FICAR NEGATIVA
                        if SistemaFolha.FlgZeraBaseNegativaPrevia=1 then
                          //PARA APURAR VALOR AGREGADO SEM ZERAR E COM PARCIAL
                          lrbase:=ApuraValor(idescontaparcial, lrbase, (1-2*iflgdesconto)*rvalorrecebido)
                        else
                          lrbase:=lrbase+(1-2*iflgdesconto)*rvalorrecebido;
                      end;
                    end
                    else //Liquido Total
                    begin
                      if (((iformabasePA = 1) and (iflgPA = 1)) or (iflgPA = 0)) and
                         ((not abforcames) or (smes = asmesref)) then
                        //PARAMETRO PARA CONTROLAR SE BASE DE CALCULO PODE FICAR NEGATIVA
                        if SistemaFolha.FlgZeraBaseNegativaPrevia=1 then
                          //PARA APURAR VALOR AGREGADO SEM ZERAR E COM PARCIAL
                          lrbase:=ApuraValor(idescontaparcial, lrbase, (1-2*iflgdesconto)*rvalorrecebido)
                        else
                          lrbase:=lrbase+(1-2*iflgdesconto)*rvalorrecebido;
                    end;
                  end;
              end;
            end;
        2 : {NAO UTILIZAR NESTES CALCULOS AS RUBRICAS DE EMPRESTIMO}
            if  (iflgdesconto < 2) and (iflgirrf = 1) then
            begin
              if (((copy(smes,6,2) = '13') and (copy(asmesref,6,2) = '13')) or
                  ((copy(smes,6,2) <> '13') and (copy(asmesref,6,2) <> '13'))) then
              begin
                if (sflgtipodesc = 'W') then
                begin
                  //PARA APURAR VALOR AGREGADO SEM ZERAR E COM PARCIAL
                  if SistemaFolha.FlgZeraBaseNegativaPrevia=1 then
                    lrbase:=ApuraValor(idescontaparcial, lrbase, (1-2*iflgdesconto)*rvalorinfo)
                  else
                    lrbase:=lrbase+(1-2*iflgdesconto)*rvalorinfo
                end
                else
                  if (sflgtipodesc <> 'E') and (sflgtipodesc <> 'K') and
                     ((not abforcames) or (smes = asmesref)) then
                  begin
                    //PARA APURAR VALOR AGREGADO SEM ZERAR E COM PARCIAL
                    if SistemaFolha.FlgZeraBaseNegativaPrevia=1 then
                      lrbase:=ApuraValor(idescontaparcial, lrbase, (1-2*iflgdesconto)*rvalorrecebido)
                    else
                      lrbase:=lrbase+(1-2*iflgdesconto)*rvalorrecebido;
                  end;
              end;
            end;
        3 : {NAO UTILIZAR NESTES CALCULOS AS RUBRICAS DE EMPRESTIMO}
            {NAO UTILIZAR NESTES CALCULOS AS RUBRICAS INFORMATIVAS}
            if (sflgtipodesc <> 'K') and (sflgtipodesc <> 'W') and
               (sflgtipodesc <> 'E') and (iflgdesconto < 2) then
            begin
              if (((copy(smes,6,2) = '13') and (copy(asmesref,6,2) = '13')) or
                  ((copy(smes,6,2) <> '13') and (copy(asmesref,6,2) <> '13'))) then
              begin
                if iflgpa = 0 then
                begin
                  if (iflgirrf = 1) and ((not abforcames) or (smes = asmesref)) then
                  begin
                    //PARA APURAR VALOR AGREGADO SEM ZERAR E COM PARCIAL
                    if SistemaFolha.FlgZeraBaseNegativaPrevia=1 then
                      lrbase:=ApuraValor(idescontaparcial, lrbase, (1-2*iflgdesconto)*rvalorrecebido)
                    else
                      lrbase:=lrbase+(1-2*iflgdesconto)*rvalorrecebido;
                  end;
                end;
              end;
            end;
        4 : {NAO UTILIZAR NESTES CALCULOS AS RUBRICAS DE EMPRESTIMO}
            {NAO UTILIZAR NESTES CALCULOS AS RUBRICAS INFORMATIVAS}
            if (sflgtipodesc <> 'K') and (sflgtipodesc <> 'W') and
               (sflgtipodesc <> 'E') and (iflgdesconto < 2) then
            begin
              if (iidregracalculo = aiidregra) and (iorigem = 2) then
                lrbase:=lrbase+rvalorcalculo;
            end;
        5 : {NAO UTILIZAR NESTES CALCULOS AS RUBRICAS INFORMATIVAS}
            if (sflgtipodesc <> 'K') and (sflgtipodesc <> 'W') and (iflgdesconto < 2) then
              if (((copy(smes,6,2) = '13') and (copy(asmesref,6,2) = '13')) or
                  ((copy(smes,6,2) <> '13') and (copy(asmesref,6,2) <> '13'))) then
              begin
                if qryRub.locate('IDRUBRICA', iidrubrica, []) then
                  lrbase:=lrbase+(1-2*iflgdesconto)*rvalorrecebido;
              end;
        //PARA TOTAIS DE PA JÁ CALCULADAS POR FONTEPAGADORA
        6: begin
            if (sflgtipodesc = 'Y') and (iflgpa = 1) and
               (iflgdesconto = 1) and (aifontepagadora = ifontepagadora) then
              if (((copy(smes,6,2) = '13') and (copy(asmesref,6,2) = '13')) or
                  ((copy(smes,6,2) <> '13') and (copy(asmesref,6,2) <> '13'))) then
              begin
                lrbase:=lrbase+rvalorrecebido;
              end;
           end;
        7: begin
            if (sflgtipodesc = 'I') and
               (iflgdesconto = 1) and (aifontepagadora = ifontepagadora) then
              if (((copy(smes,6,2) = '13') and (copy(asmesref,6,2) = '13')) or
                  ((copy(smes,6,2) <> '13') and (copy(asmesref,6,2) <> '13'))) then
              begin
                lrbase:=lrbase+rvalorrecebido;
              end;
           end;
      end;
    end;
  end;
  result:=lrbase;
end;

function TObjRecebedor.CalculaBeneficioMinimo : real;
