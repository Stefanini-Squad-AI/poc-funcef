// Andre Imakawa - SIG 48125 - Inicio
function TdtmFolhaPrevia.RetornaIdPlanoPrevRubrica(aobjrub: tobjrubrica): Integer;
var
   auxSql : String;
   query  : TwwQuery;
begin

   if aobjrub.sflgtipodesc = 'Y' then
   begin

      auxSql :=  'SELECT IDPLANOPREV' + #13#10 +
                 '  FROM PARTPREVPLAN PPP' + #13#10 +
                 ' WHERE PPP.IDPESSOA = '+ inttostr(aobjrub.iidpessoa) + #13#10 +
                 '   AND PPP.IDSITPLANOPREV <> 3' + #13#10 +
                 ' ORDER BY NVL(PPP.TIPOOPCAOIR, 1) ASC';

   end
   else
   begin

     auxSql := ' select b.idplanoprev' + #13#10 +
               ' from benefbfciario b inner join benefxtaxa bt on (bt.idbeneficio = b.idbeneficio)' + #13#10 +
               ' where b.idpessoa = ' + IntToStr(aobjrub.iidpessoa) ;

     if aobjrub.iidcontribuicao > 0 then
        auxSql := auxSql + #13#10 +' and bt.idcontribuicao = '+ IntToStr(aobjrub.iidcontribuicao)
     else
        auxSql := auxSql + #13#10 +' and b.idbeneficio = '+ IntToStr(aobjrub.iidbeneficio);
   end;

   query := TwwQuery.Create(nil);                   //edilaine WO19556
   query.DataBaseName := 'BaseDados';

   query.close;
   query.SQL.clear;
   query.SQL.Add(auxSql);
   query.Open;

   if Not(query.IsEmpty) then
     Result :=  query.FieldByName('IDPLANOPREV').AsInteger
   else
     Result := 0;

   query.Close;

   FreeAndNil(query);

end;
