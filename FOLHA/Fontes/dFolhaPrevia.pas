            end
            else
              dtmFolhaPrevia.ExibeMensagem('Valor da HstAtrasoBenef lançado zero',
                self); 
            {dtmFolhaPrevia.}qryAux.next;      //edilaine WO19556
          end;
          {dtmFolhaPrevia.}qryAux.close; // SOL 242740 PPM 575822    //edilaine WO19556
          exit; //para não executar o calculo de alteradores
        end;
      //end;
      //BRUNO AZEVEDO SOL 132938/9942 KINTANA 1682446
    except
      on e:exception do
      begin
        {dtmFolhaPrevia.}qryAux.close; // SOL 242740 PPM 575822       //edilaine WO19556
        dtmFolhaPrevia.ExibeMensagem('Erro na busca de alteradores de benefício lançados.'+
          '-'+e.message,
          self);
      end;
    end;
    if prmFlgCorrigeBenef = 1 then
    begin
      if (objrubinserida.smes < dtmFolhaPrevia.MesCobranca) or
         //CASO SEJA FOLHA DE RESERVA E ESTEJA PARAMETRIZADO PARA CORRIGIR NO MÊS DE PAGAMENTO
         (dtmFolhaPrevia.FolhaReserva and (SistemaFolha.FlgCorrigeReservaMes = 1)) then
      begin
        try
          VerificaIrrfDarfRegimeRegressivo(objRubInserida); //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319

          objrub:=objrubinserida;
