Function TobjRecebedor.verificaFlgisentoirrfPessoa : Boolean;
     var  query:TwwQuery;

begin
  try
    query := TwwQuery.Create(nil);       //edilaine WO19556
    query.DataBaseName := 'BaseDados';
    query.close;
    query.SQL.clear;
    query.SQL.Add(' SELECT COUNT(1) AS QTDE  FROM PESSOAFISICA ' );
    query.SQL.Add(' WHERE TO_DATE('+QuotedStr(DateToStr(dtmFolhaPrevia.DataPagamento))+',''DD/MM/YYYY'') >= DATAMOLESTIAGRAVE AND ');  //  SOL 218619 KTN 2050326
    query.SQL.Add(' DATAFIMMOLESTIA  <= TO_DATE('+QuotedStr(DateToStr(dtmFolhaPrevia.DataPagamento))+',''DD/MM/YYYY'') ');       //  SOL 218619 KTN 2050326
    query.SQL.Add(' AND   DATAMORTE IS NULL  AND NVL(FLGISENTOIRRF,0) = 1 AND  IDPESSOA = '+IntToStr(iidResponsavel));
    query.Open;

    if query.fieldbyname('QTDE').AsInteger = 0 then
       result:=False
    else
       result:=True;

  finally
    query.Close;
    FreeAndNil(query);     //query.Destroy;   //edilaine WO19556
  end;

end;
