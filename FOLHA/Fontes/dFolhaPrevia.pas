      // SOL 207789 KINTANA 2029238

     //sSQL := 'INSERT INTO CM.BASEDEPAGAMENTOPREVIA     '  // SOL 207789 KINTANA 2029238
     sSQL := 'INSERT INTO CM.BASEDEPAGAMENTO     '  // SOL 207789 KINTANA 2029238
           + '(      idbasepgto                        '
           + '      ,IDTITULAR                         '
           + '      ,IDPESSOA                          '
           + '      ,IDRESPONSAVEL                     ' // Andre Imakawa - SIG 51216
           + '      ,MATRICULA                         '
           + '      ,DATAPAGAMENTO                     '
           + '      ,MES                               '
           + '      ,MESCOBRANCA                       '
           + '      ,PRAZOMEDIOPONDERADO               '
           + '      ,PERCENTUALIRREGRESSIVO            '
           + '      ,BASECALCIRREGRESSIVO              '
           + '      ,VLRIRREGRESSIVO                   '
           + '      ,VLRBRUTO                          '
           + '      ,VLRDESCONTO                       '
           + '      ,VLRLIQUIDO                        '
           + '      ,TIPOFOLHA                         '
           + '      ,FLGRISCO                          '
           + '      ,FLGEFETIVADO                      '
           + '      ,IDHSTFOLHABENEF                   '
           // // SOL 207789 KINTANA 2029238
           + '      ,FLGISENTOIRRF                     '
           + '      ,FLGMOLESTIAGRAVE                  '
           + '      ,DATAINICIOMOLESTIA                '
           + '      ,DATAFIMMOLESTIA                   '
           + '      ,FLGSOMAIRSUPINSS                  '
           + '      ,NUMDEPIRRF                        '
           + '      ,DATANASC                          '
           + '      ,NUMDOCUMENTO                      '
           + '      ,IDLOTE                            '
           + '      ,CODPORTFORMA                      '
           + '      ,IDRECEBEPGTO                      '   //Rafael SIG - 92255
           //  // SOL 207789 KINTANA 2029238
           + '      ,VLRREDUCAOIRRF                    '   //edilaine WO29025
           + '      ,VLRTRIBUTAVELIRRF                 '   //edilaine WO29025
           + '      ,VLRREDUCAOIRRF13                  '   //leandro  WO29025
           + '      ,VLRTRIBUTAVELIRRF13               '   //leandro  WO29025
           + '      ,VLRREDUCAOINSSIRRF                '   //leandro  WO29025
           + '      ,VLRTRIBUTAVELINSSIRRF             '   //leandro  WO29025
           + '      ,VLRREDUCAOINSSIRRF13              '   //leandro  WO29025
           + '      ,VLRTRIBUTAVELINSSIRRF13           '   //leandro  WO29025
           + ')                                        '
           + 'VALUES                                   '
           + '(      :idbasepgto                       '
           + '      ,:IDTITULAR                        '
           + '      ,:IDPESSOA                         '
           + '      ,:IDRESPONSAVEL                    '  // Andre Imakawa - SIG 51216
           + '      ,:MATRICULA                        '
           + '      ,:DATAPAGAMENTO                    '
           + '      ,:MES                              '
           + '      ,:MESCOBRANCA                      '
           + '      ,:PRAZOMEDIOPONDERADO              '
           + '      ,:PERCENTUALIRREGRESSIVO           '
           + '      ,:BASECALCIRREGRESSIVO             '
           + '      ,:VLRIRREGRESSIVO                  '
           + '      ,:VLRBRUTO                         '
           + '      ,:VLRDESCONTO                      '
           + '      ,:VLRLIQUIDO                       '
           + '      ,:TIPOFOLHA                        '
           + '      ,:FLGRISCO                         '
           + '      ,0                                 '
           + '      ,null                              '
           //  // SOL 207789 KINTANA 2029238
           + '      ,:FLGISENTOIRRF                     '
           + '      ,:FLGMOLESTIAGRAVE                  '
           + '      ,:DATAINICIOMOLESTIA                '
           + '      ,:DATAFIMMOLESTIA                   '
           + '      ,:FLGSOMAIRSUPINSS                  '
           + '      ,:NUMDEPIRRF                        '
           + '      ,:DATANASC                          '
           + '      ,:NUMDOCUMENTO                      '
           + '      ,:IDLOTE                            '
           + '      ,:CODPORTFORMA                      '
           + '      ,:IDRECEBEPGTO                      '    //Rafael SIG - 92255
           //  // SOL 207789 KINTANA 2029238
           + '      ,:VLRREDUCAOIRRF                    '   //edilaine WO29025
           + '      ,:VLRTRIBUTAVELIRRF                 '   //edilaine WO29025
           + '      ,:VLRREDUCAOIRRF13                  '   //leandro  WO29025
           + '      ,:VLRTRIBUTAVELIRRF13               '   //leandro  WO29025
           + '      ,:VLRREDUCAOINSSIRRF                '   //leandro  WO29025
           + '      ,:VLRTRIBUTAVELINSSIRRF             '   //leandro  WO29025
           + '      ,:VLRREDUCAOINSSIRRF13              '   //leandro  WO29025
           + '      ,:VLRTRIBUTAVELINSSIRRF13           '   //leandro  WO29025
           + ')                                        ';

      With TwwQuery.Create(nil) do     //edilaine WO19556
      begin
        DataBaseName := dtmBaseDados.dbBaseDados.DataBaseName;
        Close;
        SQL.Add(sSQL);
        ParamByName('idbasepgto').AsInteger           := iIdBasePgto;
        ParamByName('IDTITULAR').AsInteger            := iIdTitular;
        ParamByName('IDPESSOA').AsInteger             := iIdPessoa; //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
        ParamByName('IDRESPONSAVEL').AsInteger        := iIdPessoa; // Andre Imakawa - SIG 51216
        //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
        ParamByName('MATRICULA').AsString             := sMatricula;
        ParamByName('IDPESSOA').AsInteger             := iIdPessoa; //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
        ParamByName('DATAPAGAMENTO').AsDateTime       := dtDataPag;
        ParamByName('MES').AsString                   := sMes;
        ParamByName('MESCOBRANCA').AsString           := sMesCobranca;
        ParamByName('PRAZOMEDIOPONDERADO').AsFloat    := rPrazoMP;
        ParamByName('PERCENTUALIRREGRESSIVO').AsFloat := rPercentualIRR;
        ParamByName('BASECALCIRREGRESSIVO').AsFloat   := rBaseCalc;
        ParamByName('VLRIRREGRESSIVO').AsFloat        := rVlrIRR;
        ParamByName('VLRBRUTO').AsFloat               := rVlrBruto;
        ParamByName('VLRDESCONTO').AsFloat            := rVlrDesconto;
        ParamByName('VLRLIQUIDO').AsFloat             := vVlrRLiquido;
        ParamByName('TIPOFOLHA').AsInteger            := iTipoFolha;
        ParamByName('FLGRISCO').AsInteger             := iFlgRisco;

        // SOL 207789 KINTANA 2029238
        ParamByName('FLGISENTOIRRF').AsString         := sFlgisentoirrf;
        ParamByName('FLGMOLESTIAGRAVE').AsString      := sFlgmolestiagrave;
        ParamByName('DATAINICIOMOLESTIA').AsString    := sDatainiciomolestia;
        ParamByName('DATAFIMMOLESTIA').AsString       := sDatafimmolestia;
        ParamByName('FLGSOMAIRSUPINSS').AsString      := sFlgsomairsupinss;
        ParamByName('NUMDEPIRRF').AsString            := sNumdepirrf;
        ParamByName('DATANASC').AsString              := sDatanasc;
        ParamByName('NUMDOCUMENTO').AsString          := sNumDocumento;
        ParamByName('IDLOTE').AsInteger               := iidlote;
        if icodportforma > 0 then
           ParamByName('CODPORTFORMA').AsInteger      := icodportforma
        else
           ParamByName('CODPORTFORMA').AsString       := '';
        ParamByName('IDRECEBEPGTO').AsInteger         := iIdRecebePgto;  //Rafael SIG - 92255
        // SOL 207789 KINTANA 2029238

        ParamByName('VLRREDUCAOIRRF').AsFloat          := TruncaMoeda(rValorReducaoIR);       //edilaine WO29025
        ParamByName('VLRTRIBUTAVELIRRF').AsFloat       := TruncaMoeda(rValorTributavel);      //edilaine WO29025

        ParamByName('VLRREDUCAOIRRF13').AsFloat        := TruncaMoeda(rValorReducaoIR13);         //leandro WO29025
        ParamByName('VLRTRIBUTAVELIRRF13').AsFloat     := TruncaMoeda(rValorTributavel13);        //leandro WO29025
        ParamByName('VLRREDUCAOINSSIRRF').AsFloat      := TruncaMoeda(rValorReducaoINSSIR);       //leandro WO29025
        ParamByName('VLRTRIBUTAVELINSSIRRF').AsFloat   := TruncaMoeda(rValorTributavelINSS);      //leandro WO29025
        ParamByName('VLRREDUCAOINSSIRRF13').AsFloat    := TruncaMoeda(rValorReducaoINSSIR13);     //leandro WO29025
        ParamByName('VLRTRIBUTAVELINSSIRRF13').AsFloat := TruncaMoeda(rValorTributavelINSS13);    //leandro WO29025

        //CMDebugToFile(#13#10 + sSQL + #13#10);
        ExecSQL;

        Close;
        Free;
      end;
  { except
   on E:Exception do
      begin
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('ATUALIZAÇÃO DA BASE DE PAGAMENTO');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('Não foi possível inserir a Base de Pagamento para a Matrícula: '+sMatricula);
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('                            ');
      end;
   end; }
end;

//MARCIO DENILSON SOL 151061 KINTANA 1105188
procedure TobjRecebedor.AtualizarFLGProcessadoHstPrazoAcum(piIDPessoa,piIdTitular, piIDPlanoPrev, piIDBeneficio , iFlgProcessado: Integer);
var
  sSQL : String;
begin
  sSQL := ' UPDATE HSTPRAZOACUMULACAOFOLHA      '
        + ' SET FLGPROCESSADO = :FLGPROCESSADO  '
        + '    ,TRGUSERALTERACAO = USER         '
        + '    ,TRGDTALTERACAO = SYSDATE        '
        + ' WHERE IDTITULAR = :IDTITULAR        '
        + ' AND IDPESSOA = :IDPESSOA            '
        + ' AND IDPLANOPREV = :IDPLANOPREV      '
        + ' AND IDBENEFICIO = :IDBENEFICIO      ' //wo32215 LEANDRO
        + ' AND DATAFIM IS NULL                 '  // Andre Imakawa - SIG 123483
        + ' AND idhstfolhabenef IS NULL         ';  // SOL 247169 PPM 646651

   with TwwQuery.Create(nil) do     //edilaine WO19556
   begin
     DataBaseName := dtmBaseDados.dbBaseDados.DataBaseName;
     SQL.Add(sSQL);
     ParamByName('FLGPROCESSADO').AsInteger := iFlgProcessado;
     ParamByName('IDPESSOA').AsInteger      := piIDPessoa;
     ParamByName('IDTITULAR').AsInteger     := piIdTitular;
     ParamByName('IDPLANOPREV').AsInteger   := piIDPlanoPrev;
     ParamByName('IDBENEFICIO').AsInteger   := piIDBeneficio;
     ExecSQL;

     Close;
     Free;
   end;

end;

