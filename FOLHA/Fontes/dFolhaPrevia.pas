  objPlano: tobjPlano;
  lrvalorrub, lrvalorinfo, lrvalorparcial, lrvalorparcialinfo: Real;
  lstipodescordenado, lsprioridade, lsordem: string;
begin
  try
    lstRubricas.Sorted := false;
    litotalrub := lstRubricas.count;
    for liContador := 0 to litotalrub - 1 do
    begin
      lobjrub := (lstRubricas.objects[liContador] as tObjRubrica);
      liContadorPlano := 0;
      if (lobjrub.bRateioPlanoReinf) then
      begin
        lobjrub.bRateioPlanoReinf := false;
        for liContadorPlano := 0 to lstPlanos.count - 1 do
        begin
          objPlano := (lstPlanos.objects[liContadorPlano] as tobjplano);

          if ((objPlano.OpcaoIR <> 2) and (aProgressivo) and (objPlano.PlanoPrev <> lobjrub.iidplanoprev)) or // Andre Imakawa - WO4625
             ((objPlano.OpcaoIR = 2) and (aRegressivo) and (objPlano.PlanoPrev <> lobjrub.iidplanoprev)) then
          begin
            lrvalorrub := lobjrub.rvalorprovento;
            lrvalorinfo := lobjrub.rvalorinfo;

            if (copy(lobjrub.smes, 6, 2) <> '13') then
              if lobjrub.iflgdesconto = 2 then
              begin
                lrvalorparcialinfo := RoundCM(lrvalorinfo * (objPlano.PorcentoRateio / 100), 2);
                lrvalorparcial := lrvalorrub;
              end
              else
              begin
                lrvalorparcial := RoundCM(lrvalorrub * (objPlano.PorcentoRateio / 100), 2);
                lrvalorparcialinfo := lrvalorinfo;
              end
            else if lobjrub.iflgdesconto = 2 then
            begin
              lrvalorparcialinfo := RoundCM(lrvalorinfo * (objPlano.PorcentoRateio13 / 100), 2);
              lrvalorparcial := lrvalorrub;
            end
            else
            begin
              lrvalorparcial := RoundCM(lrvalorrub * (objPlano.PorcentoRateio13 / 100), 2);
