                                   ,dtmFolhaPrevia.qryProvento.FieldByName('FLGMARGEM').asinteger         //Renato Visoni SOL 131523 KINTANA 750021
                                   ,dtmFolhaPrevia.qryProvento.FieldByName('FLGREPROGRAMAR').asInteger    //Marcio Denilson - SOL 136569 -
                                   ,0, false, 0   //Andre Imakawa - SIG 67673
                                   ,dtmFolhaPrevia.qryProvento.FieldByName('FLGEXCLUICONTRIBPA').asInteger    //Osni Cavalcante - SIG 58950.59454

                                   ) then
                dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de CPMF do INSS '+
                                             dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring,
                                             self) 
              else
                if BaseINSS <> nil then
                begin // FEFX - SIG43291
                  BaseINSS.rvalorbruto:=BaseINSS.rvalorbruto+lrcpmfinss;
                    if objrubinserida <> nil then // FEFX - SIG43291
                       VerificaIrrfDarfRegimeRegressivo(objRubInserida); // FEFX - SIG43291
                end; // FEFX - SIG43291
            except
              on e:exception do
              begin
                dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de CPMF do INSS '+
                  dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring+'-'+
                  e.message,
