              lobjrub.iusaabono, lobjrub.iorigem, lobjrub.iidloteorigem, lobjrub.iidrubricaconsig, lobjrub.bpermitezero, lobjrub.sdtpagtoprev, lobjrub.scodprovdesc, objPlano.PlanoPrev, lobjrub.iidplanoorigem, objPlano.PlanoContabil, lobjrub.iseqinternofb, lobjrub.iFlgRubLegal, lobjrub.smescompreem, lobjrub.iFlgMargem, lobjrub.iFlgReprogramar, lobjrub.bValidouBit, lobjrub.iOptaIRREgressivo, lobjrub.iFlgExcluiContribPA, lobjrub.sRelacaoDepen, lobjrub.iFlgDeficit);
            lobjrubTemp.rvalorprovento := lrvalorparcial;
            lobjrubTemp.rvalorcotas := TransformaCotas(lrvalorparcial, lobjrubTemp.smes);
            lobjrubTemp.bpossuimargem := lobjrub.bpossuimargem;
            lobjrubTemp.itipobase := lobjrub.itipobase;
            lobjrubTemp.snumprocinssconsig := lobjrub.snumprocinssconsig;
            lobjrubTemp.itipomargem := lobjrub.itipomargem;
            lobjrubTemp.bflgcpmf := lobjrub.bflgcpmf;
            lobjrubTemp.bpermanente := lobjrub.bpermanente;
            lobjrubTemp.iprazo := lobjrub.iprazo;
            lobjrubTemp.iidcontribuicao := lobjrub.iidcontribuicao;
            lobjrubTemp.rsaldopermitido := lobjrub.rsaldopermitido;
            lobjrubTemp.iIdProcJud := lobjrub.iIdProcJud;
            lobjrubTemp.sCodDarfJudicial := lobjrub.sCodDarfJudicial; // Andre Imakawa - SIG 101620
            lobjrubTemp.iFlgFazDeposito := lobjrub.iFlgFazDeposito;  // Andre Imakawa - SIG 99651
            lobjrubTemp.iTipoAcao := lobjrub.iTipoAcao;       // Andre Imakawa - SIG 99651
            lobjrubTemp.inumrecebimento := lobjrub.inumrecebimento;
            lobjrubTemp.ipossuiabono := lobjrub.ipossuiabono;
            lobjrubTemp.bRateioPlano := false;
            lobjrubTemp.bRateioPlanoReinf := false; // Andre Imakawa - SIG 99651
            lobjrubtemp.iIdGrupoRubrica := lobjrub.iIdGrupoRubrica;  // Andre Imakawa - SIG 99651
            lobjrubtemp.iFlgRRA := lobjrub.iFlgRRA;                  // Andre Imakawa - SIG 99651


            if lobjrub.iflgdesconto = 0 then
            begin
              if (lobjrub.sflgtipodesc = 'Q') then
                lstipodescordenado := '0'
              else
                lstipodescordenado := '1';
              lsprioridade := '0';
            end
            else
            begin
              lstipodescordenado := '1';
              lsprioridade := inttostr(999999 - lobjrub.iprioridade);
            end;

            lsordem := inttostr(lobjrub.iflgdesconto) + #255 + lstipodescordenado + #255 + dtmFolhaPrevia.LeftPadCh(lsprioridade, '0', 6) + #255 + lobjrub.smes + #255 + dtmFolhaPrevia.LeftPadCh(formatfloat('#0', lobjrub.eseqrubrica), '0', 18) + #255 + dtmFolhaPrevia.LeftPadCh(inttostr(lobjrub.iidpessoa), '0', 10) + #255 + dtmFolhaPrevia.LeftPadCh(inttostr(lobjrub.iidrubrica), '0', 6) + #255 + dtmFolhaPrevia.LeftPadCh(inttostr(lobjrub.iidplanoprev), '0', 6) + #255 + dtmFolhaPrevia.LeftPadCh(inttostr(objPlano.PlanoContabil), '0', 6) + #255 + dtmFolhaPrevia.LeftPadCh(inttostr(lobjrub.iidmotivo), '0', 6) + #255 + dtmFolhaPrevia.LeftPadCh(lobjrub.scodirrfdarf, '0', 20);

            lobjrub.slsOrdem := lsordem; // Andre Imakawa - SIG 99651

            lstRubricas.AddObject(lsordem, lobjrubTemp);
            litotalrub := litotalrub + 1;

            if lobjrub.iflgdesconto = 2 then
