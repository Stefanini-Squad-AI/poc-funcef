    lrsinal: Real;
    lbErro: boolean;
    sSQL, sAuxTipoREINF: string;
    lVlGravar, lVlBruto, lVlLiquido, lVlSusp, lVlIdade, lVlIdadeAux: Real;
    arVlINSS, arVlRePlanNaoSald, arVlRePlanSald, arVlReb, arVlNP: array of Real;
    queryGrupoRubrica: TwwQuery;
  begin
    try
      lbErro := False;

      SetLength(arVlRePlanNaoSald,4);
      SetLength(arVlRePlanSald,4);
      SetLength(arVlReb,4);
      SetLength(arVlINSS,4);
      SetLength(arVlNP,4);

      queryGrupoRubrica := TwwQuery.Create(nil);            //edilaine WO19556
      queryGrupoRubrica.DataBaseName := 'BaseDados';
      queryGrupoRubrica.close;

      try
        //carrega rubricas de adiantamento de abono  //edilaine WO14701
        CarregaCdsReinf('REINFABADT');               //edilaine WO14701

        // sSQL := ' SELECT TRG.IDGRUPORUBRICA '                                                + #13#10 + //Leandro WO6603 / 9172 / 9174
        sSQL := ' SELECT TRG.IDGRUPORUBRICA, TRG.IDREFREINF '                                + #13#10 +    //Leandro WO6603 / 9172 / 9174
                ' FROM CM.TIPOREINF_GRUPORUBRICA TRG '                                       + #13#10 +
                ' WHERE TRG.FLGATIVO = 1 '                                                   + #13#10 +
                //'  AND TRG.IDREFREINF = ANY (''REINFRENDTRIB'', ''REINFRENDTRIB13'')  '      + #13#10 +
                '  AND TRG.IDREFREINF = ANY (''REINFRENDBRUTO'', ''REINFRENDBRUTO13'')  '      + #13#10 +
                '   AND TRG.ROTINA_PREVIA IS NULL '                                          + #13#10 +
                '  GROUP BY TRG.IDGRUPORUBRICA, TRG.IDREFREINF '; //Leandro WO6603 / 9172 / 9174


        queryGrupoRubrica.SQL.Add(sSQL);
        queryGrupoRubrica.open;


        for lii := 0 to lstRubricas.count - 1 do
        begin
          objrub := (lstRubricas.objects[lii] as tobjrubrica);

          //edilaine WO14701 : inicio
          if (copy(objrub.smes, 6, 2) = '13') and (dtmFolhaPrevia.qryReinf.locate('IDRUBRICA', objrub.iidrubrica, [])) then
             continue;
          //edilaine WO14701 : fim

          if (objrub.iFlgGravou = 1) and
             (objrub.iFlgRRA <> 1) and //Andre Imakawa - WO2546-2645-2706
             //Leandro WO6603 / 9172 / 9174 - inicio
             //(queryGrupoRubrica.locate('IDGRUPORUBRICA', objrub.iIdGrupoRubrica, [])) and

             (((queryGrupoRubrica.locate('IDGRUPORUBRICA;IDREFREINF', varArrayOf([objrub.iIdGrupoRubrica, 'REINFRENDBRUTO']), [])) and (copy(objrub.smes, 6, 2) <> '13')) or
             ((queryGrupoRubrica.locate('IDGRUPORUBRICA;IDREFREINF', varArrayOf([objrub.iIdGrupoRubrica, 'REINFRENDBRUTO13']), [])) and (copy(objrub.smes, 6, 2) = '13'))) and
             //Leandro WO6603 / 9172 / 9174 - fim

             (objrub.iCodNaturezaReinf = pCodNaturezaReinf) and
             ((pGrupoREINF = 'REINFRENDBRUTO') and
             (objrub.iflgdesconto <> 2)  // Andre Imakawa - WO2546-2645-2706
             )
             then
          begin
            if (copy(objrub.smes, 6, 2) <> '13') then
            begin
              if objrub.iflgdesconto = 0 then
              begin
                lrsinal := 1;
                liTpRub := 0;
              end
              else
              begin
                lrsinal := -1;
                liTpRub := 1;
              end;
            end
            else
            begin
              if objrub.iflgdesconto = 0 then
              begin
                lrsinal := 1;
                liTpRub := 2;
              end
              else
              begin
                lrsinal := -1;
                liTpRub := 3;
              end;
            end;


            if objrub.ifontepagadora = 2 then
            begin
              arVlINSS[liTpRub] := arVlINSS[liTpRub] + (lrsinal * objrub.rvalorprovento);
            end
            else
            begin
              case objrub.iidplanocontabil of
                2:  begin
                      arVlRePlanNaoSald[liTpRub] := arVlRePlanNaoSald[liTpRub] + (lrsinal * objrub.rvalorprovento)
                    end;
                28: begin
                      arVlRePlanSald[liTpRub] := arVlRePlanSald[liTpRub] + (lrsinal * objrub.rvalorprovento);
                    end;
                66: begin
                      arVlReb[liTpRub] := arVlReb[liTpRub] + (lrsinal * objrub.rvalorprovento);
                    end;
                74: begin
                      arVlNP[liTpRub] := arVlNP[liTpRub] + (lrsinal * objrub.rvalorprovento);
                    end;
              end;
            end;

          end;

        end;

        // 0 - Normal | 1 - Abono
        for liiTipo := 0 to 1 do
        begin

          if liiTipo = 0 then
          begin
            sAuxTipoREINF := pGrupoREINF;
            lTpProv := 0;
            lTPDesc := 1;
            //lVlIdade := rVlrIsentoIdade;
          end
          else
          begin
            sAuxTipoREINF := pGrupoREINF + '13';
            lTpProv := 2;
            lTPDesc := 3;
            //lVlIdade := rVlrIsentoIdade13;
          end;

          for liiPlano := 0 to 4 do
          begin
            case liiPlano of
              // FUNCEF - REPLAN NAO SALDADO
              0 : begin
                    //lVlLiquido :=  arVlRePlanNaoSald[lTpProv] + arVlRePlanNaoSald[lTPDesc];
                    //lVlBruto   :=  arVlRePlanNaoSald[lTpProv];
                    lVlBruto :=  arVlRePlanNaoSald[lTpProv] + arVlRePlanNaoSald[lTPDesc];
                    iFontePagadora := 1;
                    iPlanoPrev := 2;
                    iPlanoPrevContab := iPlanoPrev;
                  end;
              // FUNCEF - REPLAN SALDADO
              1 : begin
                    //lVlLiquido :=  arVlRePlanSald[lTpProv] + arVlRePlanSald[lTPDesc];
                    //lVlBruto   :=  arVlRePlanSald[lTpProv];
                    lVlBruto :=  arVlRePlanSald[lTpProv] + arVlRePlanSald[lTPDesc];
                    iFontePagadora := 1;
                    iPlanoPrev := 2;
                    iPlanoPrevContab := 28;
                  end;
              // FUNCEF - REB
              2 : begin
                    //lVlLiquido :=  arVlReb[lTpProv] + arVlReb[lTPDesc];
                    //lVlBruto   :=  arVlReb[lTpProv];
                    lVlBruto :=  arVlReb[lTpProv] + arVlReb[lTPDesc];
                    iFontePagadora := 1;
                    iPlanoPrev := 66;
                    iPlanoPrevContab := iPlanoPrev;
                  end;
              // FUNCEF - NOVO PLANO
              3 : begin
                    //lVlLiquido :=  arVlNP[lTpProv] + arVlNP[lTPDesc];
                    //lVlBruto   :=  arVlNP[lTpProv];
                    lVlBruto :=  arVlNP[lTpProv] + arVlNP[lTPDesc];
                    iFontePagadora := 1;
                    iPlanoPrev := 74;
                    iPlanoPrevContab := iPlanoPrev;
                  end;
              // INSS
              4 : begin
                    //lVlLiquido :=  arVlINSS[lTpProv] + arVlINSS[lTPDesc];
                    //lVlBruto   :=  arVlINSS[lTpProv];
                    lVlBruto :=  arVlINSS[lTpProv] + arVlINSS[lTPDesc];
                    iFontePagadora := 2;
                  end;

            end;


            // Tratamento para Rendimento Bruto
            if pGrupoREINF = 'REINFRENDBRUTO' then
            begin
              if lVlBruto <= 0 then Continue;

              lVlGravar := lVlBruto;

              if ProcessaRubricasREINF(qryTipoREINF, sAuxTipoREINF, iFontePagadora, iPlanoPrevContab, lVlGravar, 1, pCodNaturezaReinf) then
              begin
                lbErro := True;
              end;

            end;

          end;

          {
          if (arVlIdadeFUNCEF[liiTipo] > 0) or (arVlIdadeINSS[liiTipo] > 0) then
          begin
            if liiTipo = 0 then
              sAuxTipoREINF := 'REINFIDADE'
            else
              sAuxTipoREINF := 'REINFIDADE13';

            if arVlIdadeFUNCEF[liiTipo] > 0 then
            begin
              if ProcessaRubricasREINF(qryTipoREINF, sAuxTipoREINF, 1, 0, arVlIdadeFUNCEF[liiTipo], 1, pCodNaturezaReinf) then
              begin
                lbErro := True;
              end;
            end;

            if arVlIdadeINSS[liiTipo] > 0 then
            begin
              if ProcessaRubricasREINF(qryTipoREINF, sAuxTipoREINF, 2, 0, arVlIdadeINSS[liiTipo], 1, pCodNaturezaReinf) then
              begin
                lbErro := True;
              end;
            end;
          end;
          }

        end;
      except

      end;

    finally
      SetLength(arVlRePlanNaoSald,0);
      SetLength(arVlRePlanSald,0);
      SetLength(arVlReb,0);
      SetLength(arVlINSS,0);
      SetLength(arVlNP,0);
      FreeAndNil(arVlRePlanNaoSald);
      FreeAndNil(arVlRePlanSald);
      FreeAndNil(arVlReb);
      FreeAndNil(arVlNP);
      FreeAndNil(arVlINSS);
      FreeAndNil(queryGrupoRubrica); // Andre Imakawa - SIG 135627
      //FreeAndNil(arVlIdadeINSS);
      //FreeAndNil(arVlIdadeFUNCEF);
    end;
  end;

  //Andre Imakawa - WO2546-2645-2706 - Inicio
  function ProcessaRubricasREINFRENDIMENTOSRRA(qryTipoREINF: twwquery; pCodNaturezaReinf:Integer): Boolean;
  var
    lii, liiTipo, liTpRub,  liiPlano: Integer;
    lTpProv, lTPDesc: Integer;
    objrub: tobjrubrica;
    iPlanoPrev, iPlanoPrevContab, iFontePagadora: integer;
    lrsinal: Real;
    lbErro: boolean;
    sSQL, sAuxTipoREINF: string;
    lVlGravar, lVlBruto, lVlLiquido, lVlSusp, lVlIdade, lVlIdadeAux: Real;
    arVlINSS, arVlRePlanNaoSald, arVlRePlanSald, arVlReb, arVlNP: array of Real;

  begin
    try
      lbErro := False;

      try
        SetLength(arVlRePlanNaoSald,4);
        SetLength(arVlRePlanSald,4);
        SetLength(arVlReb,4);
        SetLength(arVlINSS,4);
        SetLength(arVlNP,4);
        
        for lii := 0 to lstRubricas.count - 1 do
        begin
          objrub := (lstRubricas.objects[lii] as tobjrubrica);
          if (objrub.iFlgGravou = 1) and
             (objrub.iFlgRRA = 1) and
             (objrub.sflgtipodesc <> 'I') and  // WO23009 - Leandro
             (objrub.iCodNaturezaReinf = pCodNaturezaReinf) then
          begin

            if objrub.iflgdesconto = 0 then
            begin
              lrsinal := 1;
              liTpRub := 0;
            end
            else
            begin
              lrsinal := -1;
              liTpRub := 1;
            end;

            if objrub.ifontepagadora = 2 then
            begin
              arVlINSS[liTpRub] := arVlINSS[liTpRub] + (lrsinal * objrub.rvalorprovento);
            end
            else
            begin
              case objrub.iidplanocontabil of
                2:  begin
                      arVlRePlanNaoSald[liTpRub] := arVlRePlanNaoSald[liTpRub] + (lrsinal * objrub.rvalorprovento)
                    end;
                28: begin
                      arVlRePlanSald[liTpRub] := arVlRePlanSald[liTpRub] + (lrsinal * objrub.rvalorprovento);
                    end;
                66: begin
                      arVlReb[liTpRub] := arVlReb[liTpRub] + (lrsinal * objrub.rvalorprovento);
                    end;
                74: begin
                      arVlNP[liTpRub] := arVlNP[liTpRub] + (lrsinal * objrub.rvalorprovento);
                    end;
              end;
            end;

          end;

        end;

        lTpProv := 0;
        lTPDesc := 1;

        for liiPlano := 0 to 4 do
        begin
          case liiPlano of
            // FUNCEF - REPLAN NAO SALDADO
            0 : begin
                  lVlLiquido :=  arVlRePlanNaoSald[lTpProv] + arVlRePlanNaoSald[lTPDesc];
                  lVlBruto   :=  arVlRePlanNaoSald[lTpProv];
                  iFontePagadora := 1;
                  iPlanoPrev := 2;
                  iPlanoPrevContab := iPlanoPrev;
                end;
            // FUNCEF - REPLAN SALDADO
            1 : begin
                  lVlLiquido :=  arVlRePlanSald[lTpProv] + arVlRePlanSald[lTPDesc];
                  lVlBruto   :=  arVlRePlanSald[lTpProv];
                  iFontePagadora := 1;
                  iPlanoPrev := 2;
                  iPlanoPrevContab := 28;
                end;
            // FUNCEF - REB
            2 : begin
                  lVlLiquido :=  arVlReb[lTpProv] + arVlReb[lTPDesc];
                  lVlBruto   :=  arVlReb[lTpProv];
                  iFontePagadora := 1;
                  iPlanoPrev := 66;
                  iPlanoPrevContab := iPlanoPrev;
                end;
            // FUNCEF - NOVO PLANO
            3 : begin
                  lVlLiquido :=  arVlNP[lTpProv] + arVlNP[lTPDesc];
                  lVlBruto   :=  arVlNP[lTpProv];
                  iFontePagadora := 1;
                  iPlanoPrev := 74;
                  iPlanoPrevContab := iPlanoPrev;
                end;
            // INSS
            4 : begin
                  lVlLiquido :=  arVlINSS[lTpProv] + arVlINSS[lTPDesc];
                  lVlBruto   :=  arVlINSS[lTpProv];
                  iFontePagadora := 2;
                end;

          end;

          //If lVlBruto > 0 then   //edilaine WO23099
          If lVlLiquido > 0 then   //edilaine WO23099
          begin
            qryTipoREINF.Filtered := False;
            if iFontePagadora = 2 then
               qryTipoREINF.Filter := 'IDREFREINF = ''REINFRENDBRUTORRA''' + ' AND CODFONTEPAGADORA = ' + IntToStr(iFontePagadora)
            else
               qryTipoREINF.Filter := 'IDREFREINF = ''REINFRENDBRUTORRA''' + ' AND CODFONTEPAGADORA = ' + IntToStr(iFontePagadora) + ' AND IDPLANOPREVCONTABIL = ' + IntToStr(iPlanoPrevContab);
            qryTipoREINF.Filtered := True;

            if not (qryTipoREINF.IsEmpty) then
            begin
              //if InsereBasePagamentoReinf(qryTipoREINF.FieldByName('IDTIPOREINF').AsInteger, lVlBruto, 1, pCodNaturezaReinf) then  //edilaine WO23099
              if InsereBasePagamentoReinf(qryTipoREINF.FieldByName('IDTIPOREINF').AsInteger, lVlLiquido, 1, pCodNaturezaReinf) then  //edilaine WO23099
              begin
                lbErro := True;
              end;
            end
            else
            begin
              // Falta Parametrização REINFRENDBRUTORRA // sAuxTipoREINF
            end;

            qryTipoREINF.Filtered := False;
            //edilaine WO32130 : inicio
            if bMolestiaGrave then
            begin
              if iFontePagadora = 2 then
                qryTipoREINF.Filter := 'IDREFREINF = ''REINFRRAMOLESTIA''' + ' AND CODFONTEPAGADORA = ' + IntToStr(iFontePagadora)
              else
                qryTipoREINF.Filter := 'IDREFREINF = ''REINFRRAMOLESTIA''' + ' AND CODFONTEPAGADORA = ' + IntToStr(iFontePagadora) + ' AND IDPLANOPREVCONTABIL = ' + IntToStr(iPlanoPrevContab);
            end
            else
            begin
              if iFontePagadora = 2 then
                qryTipoREINF.Filter := 'IDREFREINF = ''REINFRENDTRIBRRA''' + ' AND CODFONTEPAGADORA = ' + IntToStr(iFontePagadora)
              else
                qryTipoREINF.Filter := 'IDREFREINF = ''REINFRENDTRIBRRA''' + ' AND CODFONTEPAGADORA = ' + IntToStr(iFontePagadora) + ' AND IDPLANOPREVCONTABIL = ' + IntToStr(iPlanoPrevContab);
            end;
            //edilaine WO32130 : fim
            qryTipoREINF.Filtered := True;

            if not (qryTipoREINF.IsEmpty) then
            begin
              //if InsereBasePagamentoReinf(qryTipoREINF.FieldByName('IDTIPOREINF').AsInteger, lVlBruto, 1, pCodNaturezaReinf) then  //edilaine WO23099
              if InsereBasePagamentoReinf(qryTipoREINF.FieldByName('IDTIPOREINF').AsInteger, lVlLiquido, 1, pCodNaturezaReinf) then  //edilaine WO23099
              begin
                lbErro := True;
              end;
            end
            else
            begin
              // Falta Parametrização REINFRENDTRIBRRA // sAuxTipoREINF
            end;
          end;

        end;
      except

      end;
    finally
      SetLength(arVlRePlanNaoSald,0);
      SetLength(arVlRePlanSald,0);
      SetLength(arVlReb,0);
      SetLength(arVlINSS,0);
      SetLength(arVlNP,0);
      FreeAndNil(arVlRePlanNaoSald);
      FreeAndNil(arVlRePlanSald);
      FreeAndNil(arVlReb);
      FreeAndNil(arVlNP);
      FreeAndNil(arVlINSS);

    end;
  end;

   function ProcessaRubricasREINFIRRRA(qryTipoREINF: twwquery;
                                      pCodNaturezaReinf:Integer): Boolean;
  var
    lii, liiPlano, liContadorPlano: Integer;
    objrub: tobjrubrica;
    lrsinal: Real;
    lbErro, lbAchouProgressivo: boolean;
    sAuxTipoREINF: string;
    objPlano: tobjPlano;
  begin
    lbErro := False;
    try
      try

        for liContadorPlano := 0 to lstPlanos.count - 1 do
        begin
          objPlano := (lstPlanos.objects[liContadorPlano] as tobjplano);
          if (objPlano.OpcaoIR <> 2) then // Andre Imakawa - WO4625
          begin
            lbAchouProgressivo := True;
            Break;
          end;

        end;

        if not(lbAchouProgressivo) then
        begin
          for lii := 0 to lstRubricas.count - 1 do
          begin
            objrub := (lstRubricas.objects[lii] as tobjrubrica);
            if (objrub.sflgtipodesc = 'I') and (objrub.ifontepagadora = 2) then
            begin
              lbAchouProgressivo := True;
              Break;
            end;
          end;
        end;

        if lbAchouProgressivo then
        begin

          CarregaCdsReinf('''REINFIRINF'',''REINFIRJUD'',''REINFIRCOM''',1);

          for lii := 0 to lstRubricas.count - 1 do
          begin
            objrub := (lstRubricas.objects[lii] as tobjrubrica);
            liiPlano := lstPlanos.indexof(inttostr(objrub.iidplanoprev));

            if liiPlano >=0 then
            begin
              objplano:=(lstPlanos.objects[liiPlano] as tobjplano);
              if (objrub.iFlgGravou = 1) and
                 (objrub.iCodNaturezaReinf = pCodNaturezaReinf) and
                 (objrub.sflgtipodesc = 'I') and
                 {(((objPlano.OpcaoIR = 1) and (objrub.ifontepagadora = 1)) or
                 (objrub.ifontepagadora = 2)) and}
                 (objrub.iFlgRRA = 1) and  //Andre Imakawa - WO2546-2645-2706
                 not(dtmFolhaPrevia.qryReinf.locate('IDRUBRICA', objrub.iidrubrica, []))and
                 (objrub.iflgdesconto in [0, 1]) then
              begin

                sAuxTipoREINF := 'REINFIRRRA';

                if objrub.iflgdesconto = 1 then
                  lrsinal := 1
                else
                  lrsinal := -1;

                qryTipoREINF.Filtered := False;
                if objrub.ifontepagadora = 2 then
                  qryTipoREINF.Filter := 'IDREFREINF = ' + QuotedStr(sAuxTipoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(objrub.ifontepagadora)
                else
                  qryTipoREINF.Filter := 'IDREFREINF = ' + QuotedStr(sAuxTipoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(objrub.ifontepagadora) + ' AND IDPLANOPREVCONTABIL = ' + IntToStr(objrub.iidplanocontabil);
                qryTipoREINF.Filtered := True;

                if not (qryTipoREINF.IsEmpty) then
                begin
                  if InsereBasePagamentoReinf(qryTipoREINF.FieldByName('IDTIPOREINF').AsInteger, (lrsinal * objrub.rvalorprovento), 1, pCodNaturezaReinf) then
                  begin
                    lbErro := True;
                  end;
                end
                else
                begin
                  // Falta Parametrização REINFIRRRA // sAuxTipoREINF
                end;

              end;
            end;
          end;

        end;

      except
        lbErro := True;
      end;
    finally
      Result := lbErro;
    end
  end;

  //Andre Imakawa - WO2546-2645-2706 - Fim

  function ProcessaRubricasREINFIREGRESSIVO(qryTipoREINF: twwquery;
                                            pCodNaturezaReinf: integer): Boolean;
  var
    lii, liiPlano, liContadorPlano: Integer;
    objrub: tobjrubrica;
    lrsinal, lralorIR, lralorIR13: Real;
    lbErro, lbAchouRegressivo: boolean;
    sAuxTipoREINF: string;
    objPlano: tobjPlano;
    queryGrupoRubrica: TwwQuery; // Andre Imakawa - WO 5170

  begin
    lbErro := False;

    try
      // WO12007 - Folha de Benefícios - Consulta prévia da Folha de Benefícios
      // Alterado por Arnaldo Vicnete Scarin em 02/07/2024
      queryGrupoRubrica := TwwQuery.Create(nil);
      // WO12007 - Fim

      try

        // WO12007 - Folha de Benefícios - Consulta prévia da Folha de Benefícios
        // Alterado por Arnaldo Vicnete Scarin em 02/07/2024
        with queryGrupoRubrica do
        begin
          DataBaseName := 'BaseDados';
          Close;
          Sql.Text := ' SELECT C.IDRUBRICA' +#13+
                      ' FROM CONJUNTORUBXRUB C' +#13+
                      ' INNER JOIN CM.CONJUNTORUBRICA CR ON C.IDCONJUNTORUBRICA = CR.IDCONJUNTORUBRICA' +#13+
                      ' WHERE CR.CODIGO = ''IR''';
          Open;
        end;
        // WO12007 - Fim

        // WO12007 - Folha de Benefícios - Consulta prévia da Folha de Benefícios
        // Alterado por Arnaldo Vicnete Scarin em 02/07/2024
        CarregaCdsReinf('''REINFIRINF'',''REINFIRJUD'',''REINFIRCOM''',1);
        // WO12007 - Fim


        lralorIR := 0;
        lralorIR13 := 0;
        for liContadorPlano := 0 to lstPlanos.count - 1 do
        begin
          objPlano := (lstPlanos.objects[liContadorPlano] as tobjplano);
          if (objPlano.OpcaoIR = 2) then
          begin
            for lii := 0 to lstRubricas.count - 1 do
            begin
              objrub := (lstRubricas.objects[lii] as tobjrubrica);
              if (objPlano.FPlanoPrev = objrub.iidplanoprev) and(objrub.sflgtipodesc = 'I') and
                 (objrub.iCodNaturezaReinf = pCodNaturezaReinf) and (objrub.ifontepagadora <> 2) then
              begin
                if (copy(objrub.smes, 6, 2) <> '13') then
                  lralorIR := lralorIR + objrub.rvalorprovento
                else
                  lralorIR13 := lralorIR13 + objrub.rvalorprovento;
              end
              // WO12007 - Folha de Benefícios - Consulta prévia da Folha de Benefícios
              // Alterado por Arnaldo Vicnete Scarin em 02/07/2024
              // Foi incluida a verificaçao das Rubricas Individuais que não estavam sendo
              // consideradas no processo da REINF
              else if (objPlano.FPlanoPrev = objrub.iidplanoprev) and
                      (objrub.sflgtipodesc = 'Y') and
                      (queryGrupoRubrica.locate('IDRUBRICA', objrub.iidrubrica, [])) and
                      (objrub.iCodNaturezaReinf = pCodNaturezaReinf) and
                      // Incluido ajuste para resolução do problema 
                      not (dtmFolhaPrevia.qryReinf.locate('IDRUBRICA', objrub.iidrubrica, [])) and
                      (objrub.ifontepagadora <> 2) then
              begin
                if (copy(objrub.smes, 6, 2) <> '13') then
                  lralorIR := lralorIR + objrub.rvalorprovento
                else
                  lralorIR13 := lralorIR13 + objrub.rvalorprovento;
              end;
              // WO12007 - Fim
            end;

            if lralorIR > 0 then
            begin
              if ProcessaRubricasREINF(qryTipoREINF, 'REINFIRREG', 1, objPlano.PlanoContabil, RoundCM(lralorIR,2), 1, pCodNaturezaReinf) then
              begin
                lbErro := True;
              end;
            end;

            if lralorIR13 > 0 then
            begin
              if ProcessaRubricasREINF(qryTipoREINF, 'REINFIRREG13', 1, objPlano.PlanoContabil, RoundCM(lralorIR13,2), 1, pCodNaturezaReinf) then
              begin
                lbErro := True;
              end;
            end;

          end;

        end;

      except
        lbErro := True;
      end;
    finally
      queryGrupoRubrica.Close;
      freeAndNil(queryGrupoRubrica);
      Result := lbErro;
    end
  end;

