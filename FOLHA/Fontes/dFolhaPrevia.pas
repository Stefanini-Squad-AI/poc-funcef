//
//Valores fixos foram desabilitados e criada parametrização de regra para
//  possibilitar o cálculo do salário família por faixa
procedure TObjRecebedor.CalculoSalarioFamilia;
var rValorSalFam: real;
    lstipodesc: String;
    ssql: string;
    svalorregra: string;
    iIdCalculoGeral: integer;
    lbErro: boolean;
begin
  rvalorSalfam:=0;
  If (SistemaFolha.RegraSalFam > 0) and
     (iNumDepSalf > 0) and
     (dtmFolhaPrevia.rBaseSalFam > 0) then
  begin
    ssql:=
      'SELECT '+inttostr(iNumDepSalf)+' AS NUMDEPSALF, '+#13#10+
                formatfloat('#0.00',dtmFolhaPrevia.rBaseSalFam)+
                  ' AS VLRBASESALF, '+#13#10+
                inttostr(iidresponsavel)+ ' AS IDPESSOA '+#13#10+
      'FROM DUAL ';

    try
      iIdCalculoGeral:=0;
      sValorRegra:=RegraNumerica(inttostr(SistemaFolha.RegraSalFam),
        ssql, lbErro, iIdCalculoGeral);
    except
      lberro:=true;
      sValorRegra:='0';
    end;

    try
      rvalorSalfam:=strtofloat(sValorRegra);
    except
      rvalorsalfam:=0;
    end;

    If rValorSalfam > 0 then
    begin
      lstipodesc:=dtmFolhaPrevia.BuscaDadosRubrica(self,
        SistemaFolha.IdRubCredSalfam, 'B');

      if (lstipodesc <> '') then
      begin
        try
          if not InsereRubrica(
            iidresponsavel,                                      //beneficiario
            0,                                                   //favorecido da rubrica
            0,                                                   //beneficio associado : pega beneficio base
            SistemaFolha.IdRubCredSalfam,                           //codigo do provento
            dtmFolhaPrevia.qryProvento.FieldByName('flgdesconto').asinteger,    //flag de desconto
            dtmFolhaPrevia.qryProvento.FieldByName('flgespecial').asinteger,    //flag especial
            prmidmotivofolhaben,                                 //motivo do desconto
            1,                                                   //seqrubrica = 1
            icodmoedabase,                                       //codigo da moeda
            0,                                                   //regra de calculo
            dtmFolhaPrevia.qryProvento.FieldByName('CODFONTEPAGADORA').asinteger, //fonte pagadora
            dtmFolhaPrevia.qryProvento.FieldByName('flgirrf').asinteger, //indica se rubrica entra na base de IR
            dtmFolhaPrevia.qryProvento.FieldByName('FLGSALFAMILIA').asinteger, //indica se rubrica entra na composição do calculo do salario familia
            0,                                                   // Indica se o beneficio é provisorio
            Sistema.Idmodulo,                                    //sistema de origem da rubrica
            0,                                                   //flgSRB
            1,                                                   //flgOK
            0,                                                   //flgPA
            dtmFolhaPrevia.qryProvento.FieldByName('flgdescpensao').asinteger, //flgBasePA
            0,                                                   //flgconcessao
            0,                                                   //flgindividual
            dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalpart').asinteger,//compõe sal. participacao
            dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalbenef').asinteger,//compõe sal. benefício
            dtmFolhaPrevia.qryProvento.FieldByName('numprioridade').asinteger, //prioridade de desconto
            iidpessjur,                                           //id empresa p/ contabilização
            dtmFolhaPrevia.qryProvento.FieldByName('tipobasedesconto').asinteger, //tipo de base de desconto {abono,supl,inss,resgate}
            0,                                                   //código do alterador
            0,                                                   //id do plano de contas
            inumeroprocesso,
            snumprocinss,
            'B',                                                 //flg do tipo de desconto 'C', 'P', 'B', 'Y', 'K'
            iNumDepSalf,                                           //valor informativo associado a rubrica (NÚMERO DE DEPENDENTES)
            rValorSalfam,                                                   //valor da rubrica
            0,                                                   //valor base de calculo para a regra
            '***',                                               //referencia
            dtmFolhaPrevia.MesCobranca,                          //mês de referência
            dtmFolhaPrevia.qryProvento.FieldByName('CODIRRFDARF').asstring,  //código IRRF na SRF para o DARF igual ao provento base
            '',                                                 //indice recebimento 'R'ou pagamento 'P'
            '',                                                 //código do tipo de recebimento ou desembolso
            '',                                                 //código do centro de custo
            '',                                                 //código do centro de responsabilidade
            '',                                                 //código da unidade de negócio
            '',                                                 //conta contábil associada
            '',                                                 //data inicio da rubrica
            '',                                                 //data final da rubrica
            dtmFolhaPrevia.qryProvento.FieldByName('descparcial').asinteger,    //indica se permite desconto parcial
            0,                                                  //usa no abono anual
            3,                                                  //origem da rubrica
            0,                                                  //lote original do desconto
            0,                                                  // RUBRICA CONSIGNATARIO
            false, // ACEITA ZERO
            '',    // DATA PREVISTA DE PAGAMENTO - PEND 10826
            dtmFolhaPrevia.qryProvento.FieldByName('CODPROVDESC').asstring, //PARA GRAVAR CODPROVDESC NA PREVIA E EM SQL PARA REGRAS
            0, //ATRIBUI ZERO PARA OBTER O IDPLANOPREV GLOBAL
            0, //ATRIBUI ZERO PARA OBTER O IDPLANOORIGEM GLOBAL
            0, //ATRIBUI ZERO PARA OBTER O PLANO CONTABIL GLOBAL
            0, //RUBRICA CUJO SEQUENCIAL INTERNO É IRRELEVANTE PARA RETORNO
            dtmFolhaPrevia.qryProvento.FieldByName('FLGRUBLEGAL').asinteger,  //
            dtmFolhaPrevia.qryprevia.fieldbyname('MESCOMPREEM').asstring      // SOL 140042 Kintana 900220
            ,0
            ,''
            ,dtmFolhaPrevia.qryProvento.FieldByName('FLGMARGEM').asinteger         //Renato Visoni SOL 131523 KINTANA 750021
            ,0
            ,dtmFolhaPrevia.qryProvento.FieldByName('FLGREPROGRAMAR').asInteger    //Marcio Denilson - SOL 136569 - KINTANA 820997
            ,false, 0,dtmFolhaPrevia.qryProvento.FieldByName('FLGEXCLUICONTRIBPA').asInteger    //Osni Cavalcante - SIG 58950.59454
            ) then
            dtmFolhaPrevia.ExibeMensagem(
              'Erro ao gravar rubrica de Crédito de Salário Família '+
              dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring,
              self)
        else
           if objrubinserida <> nil then // FEFX - SIG43291
              VerificaIrrfDarfRegimeRegressivo(objrubinserida); // FEFX - SIG43291
        except
          on e:exception do
          begin
            dtmFolhaPrevia.ExibeMensagem(
              'Erro ao gravar rubrica de Crédito de Salário Família '+
              dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring+'-'+e.message,
              self); 
          end;
        end;
      end
      else
        dtmFolhaPrevia.ExibeMensagem('Rubrica não encontrada (Crédito de Salário Família): '+inttostr(SistemaFolha.IdRubCredSalfam),
          self); 
    end;
  end;
end;

procedure TObjRecebedor.CalculaEstruturasCalculo;
var
   iIdCalculoGeral : integer;
   objrub : tobjrubrica;
   lstGrupos: tstringlist;
   lbErro : Boolean;

  //EXECUTA UMA ESTRUTURA DE CÁLCULO EM ROTINA ÚNICA
  procedure ExecutaEstruturaCalculo(aiEstrutura: integer);
   var rValorRegra, 
       rBase, rBaseIr,rBASEbIT: real;//SOL205224 douglas.siqueira
       sGrupo, sValorRegra, ssql, lstipodesc: string;
       lii: integer;
       iFLGCONCESSAO : Integer; // Renato Visoni SOL 126744 - KINTANA 666874
       sMesCompreemb: String;
       query:TwwQuery;//SOL205224 douglas.siqueira
  begin

   try
    query := TwwQuery.Create(nil);//SOL205224 douglas.siqueira         //edilaine WO19556
    query.DataBaseName := 'BaseDados';//SOL205224 douglas.siqueira

    dtmfolhaprevia.cdsEstrutura.filter:='IDESTRUTURA = '+inttostr(aiEstrutura);
    dtmfolhaprevia.cdsEstrutura.filtered:=true;
    dtmfolhaprevia.cdsEstrutura.first;
    sgrupo:='';
    rBASEbIT:=0;//SOL205224 douglas.siqueira
    while not dtmfolhaprevia.cdsEstrutura.eof do
    begin

      if (sgrupo <> dtmfolhaprevia.cdsEstruturaGRUPOCALCULO.asstring) then
      begin
        if sgrupo <> '' then
        begin
          lstGrupos.add(Oranumero(formatfloat('#0.00',rBase))+' AS GRUPO'+sGrupo+', '+
                        //ALTERADO NOME VARIAVEL IR
                        Oranumero(formatfloat('#0.00',rBaseIr))+' AS GRUPOIR'+sGrupo);
        end;
        sgrupo:=dtmfolhaprevia.cdsEstruturaGRUPOCALCULO.asstring;
        rBase:=0;
        rBaseIr:=0;
      end;
      if (sgrupo = dtmfolhaprevia.cdsEstruturaGRUPOCALCULO.asstring) then
      begin
        sgrupo:=dtmfolhaprevia.cdsEstruturaGRUPOCALCULO.asstring;
        rBase:=rBase+dtmfolhaprevia.cdsEstruturaV1.asfloat;
//SOL205224 douglas.siqueira
        if sgrupo = '1' then
           begin
            query.Close;
            query.sql.Clear;
            //query.sql.Add('SELECT NVL(FLGBITRIBUTACAO, 0)FLGBITRIBUTACAO FROM PROVDESC WHERE IDPROVENTO = '+dtmfolhaprevia.cdsEstruturaIDRUBRICA.AsString); // SOL SOL 242740 PPM 575822 PPM 575822
            query.sql.Add('SELECT FLGBITRIBUTACAO FROM PROVDESC WHERE IDPROVENTO = '+dtmfolhaprevia.cdsEstruturaIDRUBRICA.AsString); // SOL SOL 242740 PPM 575822 PPM 575822
            query.Open;
            IF query.FieldByName('FLGBITRIBUTACAO').Text='1' then
               rBASEbIT:=rBASEbIT+dtmfolhaprevia.cdsEstruturaV1.asfloat;
           end;
//SOL205224 douglas.siqueira
        rBaseIr:=rBaseIr+dtmfolhaprevia.cdsEstruturaV2.asfloat;
      end;
      dtmfolhaprevia.cdsEstrutura.next;
    end;

    lstGrupos.add(Oranumero(formatfloat('#0.00',rBase))+' AS GRUPO'+sGrupo+', '+
                  //ALTERADO NOME VARIAVEL IR
                  Oranumero(formatfloat('#0.00',rBaseIr))+' AS GRUPOIR'+sGrupo);

    //Renato Visoni SOL 126744 - KINTANA 666874
    dtmFolhaPrevia.qryAux4.Close;
    dtmFolhaPrevia.qryAux4.SQL.Clear;

    dtmFolhaPrevia.qryAux4.SQL.Add('  select flgconcessao from hstbenefbfciario ');
    dtmFolhaPrevia.qryAux4.SQL.Add('  where idpessoa = '+ intTostr(iidresponsavel));
    dtmFolhaPrevia.qryAux4.SQL.Add('  and mes='+ QuotedStr(dtmFolhaPrevia.MesCobranca));
    dtmFolhaPrevia.qryAux4.SQL.Add('  group by flgconcessao                     ');

    dtmFolhaPrevia.qryAux4.open;
    if dtmFolhaPrevia.qryAux4.RecordCount > 1 then begin
      iFLGCONCESSAO := 1;
    end else begin
      iFLGCONCESSAO := iflgconcessaolote;
    end;
    // Renato Visoni SOL 126744 - KINTANA 666874


    ssql := 'SELECT '+
               QuotedStr(CodigoPais)+' AS CODPAIS, '+ //USAR PROPRIEDADE CODIGOPAIS DO OBJETO
               oranumero(formatfloat('#0.00000000', prmPercCPMF))+' AS PERCCPMF, '+
               //inttostr(iflgconcessaolote)+' AS FLGCONCESSAO, '+ // Renato Visoni SOL 126744 - KINTANA 666874
               inttostr(iFLGCONCESSAO)+' AS FLGCONCESSAO, '+ // Renato Visoni SOL 126744 - KINTANA 666874
               inttostr(iTemRubAtrasoIR)+' AS FLGRUBATRASOIR, '+
               inttostr(inumdepirrf)+' AS NUMDEPIRRF, '+
               inttostr(iflgisentoirrf)+' AS ISENTOIRRF, '+
               QuotedStr(formatdatetime('dd/mm/yyyy',dtdatanasc))+' AS DATANASC, '+
               QuotedStr(formatdatetime('dd/mm/yyyy',dtmFolhaPrevia.DataPagamento))+' AS DATAREF, '+
               inttostr(iiMolestiagrave)+' AS FLGMOLESTIAGRAVE, '+
               inttostr(iiSomairrfinss)+' AS FLGSOMAIRSUPINSS, '+
               Floattostr(prmVLMINIRFF)+' AS VLMINIR, '+
               Floattostr(SistemaFolha.DeducaoBaseIR0561)+' AS DEDUCAOBASEIR0561, '+
               InttoStr(iidtitular)+' AS IDTITULAR, '+
               IntToStr({iidpessjur}iidpatro)+' AS IDPESSJUR, '+
               inttostr(iidplanoprevglobal)+' AS IDPLANOPREV, '+
               inttostr(iidbeneficiobase)+' AS IDBENEFICIO, '+
               inttostr(iidresponsavel)+ ' AS IDPESSOA, '+
               QuotedStr(dtmFolhaPrevia.qryEstruturas.fieldbyname('CODPROVDESC').AsString)+ 'AS CODPROVDESC, ';  // SOL123555 - Daniel Begnami

    query.Close;//SOL205224 douglas.siqueira
    query.Destroy; //SOL205224 douglas.siqueira
    if sSQLMargem <> '' then sSQL :=   ssql +' '+ sSQLMargem; // Renato Visoni SOL 126744 - KINTANA 666874

    for lii:=0 to lstGrupos.count-1 do
    begin
      ssql := ssql + lstGrupos[lii];
      If ((lii+1) < lstGrupos.count) then
        ssql := ssql + ' , ';
    end;
    ssql := ssql + '  ,'+Oranumero(formatfloat('#0.00',(rBASEbIT)))+'  AS GRUPOBITRIB ';//SOL205224 douglas.siqueira
    ssql := ssql + ' FROM DUAL ';

    try
      iIdCalculoGeral:=0;
      sValorRegra:=RegraNumerica(
        inttostr(dtmFolhaPrevia.qryEstruturas.fieldbyname('IDREGRA').asinteger),
        sSQL, lbErro,iIdCalculoGeral);
    except
      lberro:=true;
      sValorRegra:='0';
    end;
    if lberro then
    begin
      dtmFolhaPrevia.ExibeMensagem('Erro na Regra '+
        inttostr(dtmFolhaPrevia.qryEstruturas.fieldbyname('IDREGRA').asinteger)+
        ' - Estrutura de Cálculo:'+
        dtmFolhaPrevia.qryEstruturas.fieldbyname('DESCRICAO').asstring,
        self);

      dtmFolhaPrevia.ExibeMensagemSemRecebedor('SQL para Regra: '+sSQL);
    end
    else
    begin
      try
        //SOL 123847 - Ádler Souza
        rvalorRegra:=strtofloat(ClienteNumero(sValorRegra));
        //rvalorRegra:=abs(strtofloat(ClienteNumero(sValorRegra)));
        //Fim - SOL 123847 - Ádler Souza
      except
        rvalorRegra:=0;
      end;

      if (dtmFolhaPrevia.qryEstruturas.fieldbyname('FLGVALIDO').asinteger = 0) or
         (rvalorRegra > 0) then
      begin
        lstipodesc:=dtmFolhaPrevia.BuscaDadosRubrica(self,
          dtmFolhaPrevia.qryEstruturas.fieldbyname('IDRUBRICAEXIBICAO').asinteger, 'K');
        if lstipodesc <> '' then
        begin
          try

            //BRUNO AZEVEDO SOL 140042/6601
            {sMesCompreemb := '';
            if (dtmFolhaPrevia.qryProvento.FieldByName('CODFONTEPAGADORA').asinteger = 2) then begin
              sMesCompreemb := dtmFolhaPrevia.qryprevia.fieldbyname('MESCOMPREEM').asstring;
              if (Trim(sMesCompreemb) = '') then begin
                sMesCompreemb := dtmFolhaPrevia.MesCobranca;
              end;
            end; }
            //BRUNO AZEVEDO SOL 140042/6601

            if not InsereRubrica(
                     iidresponsavel,                                      //beneficiario
                     0,                                                   //favorecido da rubrica
                     0,                                                   //beneficio associado : pega beneficio base
                     dtmFolhaPrevia.qryEstruturas.fieldbyname('IDRUBRICAEXIBICAO').asinteger, //codigo do provento
                     dtmFolhaPrevia.qryProvento.FieldByName('flgdesconto').asinteger,    //flag de desconto
                     dtmFolhaPrevia.qryProvento.FieldByName('flgespecial').asinteger,    //flag especial
                     prmidmotivofolhaben,                                 //motivo do desconto
                     1,                                                   //seqrubrica = 1
                     icodmoedabase,                                       //codigo da moeda
                     0,                                                   //regra de calculo
                     dtmFolhaPrevia.qryProvento.FieldByName('CODFONTEPAGADORA').asinteger, //fonte pagadora
                     dtmFolhaPrevia.qryProvento.FieldByName('flgirrf').asinteger, //indica se rubrica entra na base de IR
                     dtmFolhaPrevia.qryProvento.FieldByName('FLGSALFAMILIA').asinteger, //indica se rubrica entra na composição do calculo do salario familia
                     0,                                                   // Indica se o beneficio é provisorio
                     Sistema.Idmodulo,                                    //sistema de origem da rubrica
                     0,                                                   //flgSRB
                     0,                                                   //flgOK
                     0,                                                   //flgPA
                     dtmFolhaPrevia.qryProvento.FieldByName('flgdescpensao').asinteger, //flgBasePA
                     0,                                                   //flgconcessao
                     0,                                                   //flgindividual
                     dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalpart').asinteger,//compõe sal. participacao
