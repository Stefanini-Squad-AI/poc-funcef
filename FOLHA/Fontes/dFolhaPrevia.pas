   auxSql := 'select nvl(pd.flgbitributacao,0) flgbitributacao from provdesc pd where pd.idprovento = '+inttostr(aobjrub.iidrubrica);
   QryProvdesc := TwwQuery.Create(nil);              //edilaine WO19556
