//SIG49055 Inicio
function TdtmFolhaPrevia.fn_RetornaDarfInforme(pidplanoprev, pidpessoa,
  pidtitular, pidrubrica, pidbeneficio, pfontepagadora, presgate: integer; pDatapagamento: tdatetime): boolean;
  var sp_darfInforme : TwwStoredProc;
begin

  Result := false;
  sp_darfInforme := TwwStoredProc.Create( dtmFolhaPrevia );
  try
   sp_darfInforme.DatabaseName   := dtmBaseDados.dbBaseDados.DataBaseName;
   sp_darfInforme.StoredProcName := 'SP_FB_RETORNA_DARF_INFORME';
   sp_darfInforme.Params.CreateParam( ftInteger, 'PIDPLANOPREV'   , ptInput).AsInteger;
   sp_darfInforme.Params.CreateParam( ftInteger, 'PIDPESSOA'      , ptInput).AsInteger;
   sp_darfInforme.Params.CreateParam( ftInteger, 'PIDTITULAR'     , ptInput).AsInteger;
   sp_darfInforme.Params.CreateParam( ftInteger, 'PIDRUBRICA'     , ptInput).AsInteger;
   sp_darfInforme.Params.CreateParam( ftInteger, 'PIDBENEFICIO'   , ptInput).AsInteger;
   sp_darfInforme.Params.CreateParam( ftInteger, 'PFONTEPAGADORA' , ptInput).AsInteger;
   sp_darfInforme.Params.CreateParam( ftInteger, 'PIDLOTE'        , ptInput).AsInteger;
   sp_darfInforme.Params.CreateParam( ftdatetime,'PDATAPAGAMENTO' , ptInput).AsDateTime;

   sp_darfInforme.Params.CreateParam(  ftInteger,  'SIDINFORME'   , ptOutput).AsInteger;
   sp_darfInforme.Params.CreateParam(  ftString,  'SCODIRRFDARF'  , ptOutput).AsString;


   sp_darfInforme.parambyName('PIDPLANOPREV').Asinteger      := pidplanoprev;
   sp_darfInforme.parambyName('PIDPESSOA').Asinteger         := pidpessoa;
   sp_darfInforme.parambyName('PIDTITULAR').Asinteger        := pidtitular;
   sp_darfInforme.parambyName('PIDRUBRICA').Asinteger        := pidrubrica;
   sp_darfInforme.parambyName('PFONTEPAGADORA').Asinteger    := pfontepagadora;
   sp_darfInforme.parambyName('PIDLOTE').Asinteger           := presgate;
   sp_darfInforme.parambyName('PDATAPAGAMENTO').AsDatetime   := pDatapagamento;
   if pidbeneficio > 0 then
      sp_darfInforme.parambyName('PIDBENEFICIO').Asinteger      := pidbeneficio
   else
      sp_darfInforme.parambyName('PIDBENEFICIO').clear;

   sp_darfInforme.Prepare;
   sp_darfInforme.ExecProc;

   dtmFolhaPrevia.sidinformeProc   := sp_darfInforme.parambyName('SIDINFORME').Asstring;
   dtmFolhaPrevia.scodirrfdarfProc := sp_darfInforme.parambyName('SCODIRRFDARF').AsString;

   dtmFolhaPrevia.scodirrfdarfProc := LeftPadCh(trim(dtmFolhaPrevia.scodirrfdarfProc),'0',4); // Andre Imakawa - SIG 52312

   Result := true;

  finally
    FreeAndNil(sp_darfInforme);    //sp_darfInforme.Free;       //edilaine WO19556
  end;

end;
