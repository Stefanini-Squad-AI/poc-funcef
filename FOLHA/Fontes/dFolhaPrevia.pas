//MARCIO DENILSON SOL 151061 KINTANA 1105188
function TobjRecebedor.retornaPercentualIRRF(prazoMP: real; iFlgRisco: Integer): real;
var
  sSQL : String;
  percentual: real;
begin
  percentual := 0;

  sSQL := ' SELECT PRAZOACUM                    '
        + '       ,ALIQUOTA                     '
        + ' FROM IRRFREGRESSIVA                 '
    //    + ' WHERE PRAZOACUM > :PRAZOACUM        '
   ///alteraçao Douglas
        +' WHERE PRAZOACUM = (case'
        +'          when :PRAZOACUM <= 2 then'
        +'           2'
        +'          when (:PRAZOACUM > 2) and ( :PRAZOACUM  <= 4) then'
        +'           4'
        +'          when (:PRAZOACUM > 4) and ( :PRAZOACUM  <= 6) then'
        +'           6'
        +'          when (:PRAZOACUM > 6) and ( :PRAZOACUM  <= 8) then'
        +'           8'
        +'          when (:PRAZOACUM > 8) and ( :PRAZOACUM  <= 10) then'
        +'           10'
        +'          when (:PRAZOACUM > 10) then'
        +'           999'
        +'        end)'
   ///alteraçao Douglas
        //+ '   AND NVL(FLGRISCO,0) = '+inttostr(iFlgRisco) comentado por //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
        + ' ORDER BY PRAZOACUM                  ';

   //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
   if iFlgRisco = 1 then
   begin
	  sSQL := ' SELECT PRAZOACUM                    '
			+#13+ '       ,ALIQUOTA                     '
			+#13+ ' FROM IRRFREGRESSIVA                 '
			+#13+' WHERE PRAZOACUM = (case'
			+#13+'          when :PRAZOACUM <= 6 then'
			+#13+'           6'
			+#13+'          when (:PRAZOACUM > 6) and ( :PRAZOACUM  <= 8) then'
			+#13+'           8'
			+#13+'          when (:PRAZOACUM > 8) and ( :PRAZOACUM  <= 10) then'
			+#13+'           10'
			+#13+'          when (:PRAZOACUM > 10) then'
			+#13+'           999'
			+#13+'        end)'
			+#13+ '   AND NVL(FLGRISCO,0) = '+inttostr(iFlgRisco)
			+#13+ ' ORDER BY PRAZOACUM                  ';
   end;
   //FIM Helio - SOL Nº 151061-10442 KINTANA Nº 1720319

   try
     with TwwQuery.Create(nil) do    //edilaine WO19556
     begin
       DataBaseName := dtmBaseDados.dbBaseDados.DataBaseName;
       SQL.Add(sSQL);
       ParamByName('PRAZOACUM').AsFloat  := prazoMP;
//       ParamByName('FLGRISCO').AsInteger := iFlgRisco;
//       ParamByName('FLGRISCO').AsInteger := iFlgRisco;
       Open;
       if not IsEmpty then
        percentual := FieldByName('ALIQUOTA').AsFloat;
       Close;
       Free;
     end;
   finally
     result := percentual;
   end;


end;

