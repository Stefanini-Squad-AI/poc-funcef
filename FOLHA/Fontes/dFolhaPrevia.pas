  function ProcessaREINFRRA(qryTipoREINF: twwquery; pCodNaturezaReinf: integer): Boolean;
  var
    liFontePagadora, lii, liQtdPeriodo: Integer;
    objrub: tobjrubrica;
    lstPeriodoREINFRRA: TStringList;
    dblTotalRRA: Double;
    lbErro: boolean;
  begin
    Result := False;
    lbErro := False;
    try

      try
        for liFontePagadora := 1 to 2 do
        begin
          lstPeriodoREINFRRA :=tstringlist.create;
          dblTotalRRA := 0;
          liQtdPeriodo := 0;
          if lstRubricas.count > 0 then
          begin

            dblTotalRRA := 0;
            for lii := 0 to lstRubricas.count - 1 do
            begin
              objrub := (lstRubricas.objects[lii] as tobjrubrica);
              if (objrub.iFlgGravou = 1) and (objrub.iCodNaturezaReinf = pCodNaturezaReinf) and
                 (objrub.iFlgRRA = 1) and (liFontePagadora = objrub.ifontepagadora) then
              begin
                //Andre Imakawa - WO2546-2645-2706 - Inicio
                if objrub.sflgtipodesc = 'I' then
                  Continue;
                //Andre Imakawa - WO2546-2645-2706 - Fim

                if lstPeriodoREINFRRA.IndexOf(objrub.smes) = -1 then
                  lstPeriodoREINFRRA.Add(objrub.smes);

                if objrub.iflgdesconto = 0 then
                begin
                  dblTotalRRA:= dblTotalRRA + objrub.rvalorprovento;
                end
                else
                begin
                  dblTotalRRA:= dblTotalRRA - objrub.rvalorrecebido;
                end;
              end;

            end;

            liQtdPeriodo := lstPeriodoREINFRRA.count;

            if liQtdPeriodo > 0 then
              if ProcessaRubricasREINF(qryTipoREINF, 'REINFRRAQT', liFontePagadora, 0, liQtdPeriodo,2, pCodNaturezaReinf) then
              begin
                lbErro := True;
              end;

            //Andre Imakawa - WO2546-2645-2706 - Inicio
            {
            if dblTotalRRA > 0 then
              if ProcessaRubricasREINF(qryTipoREINF, 'REINFRRAVL', liFontePagadora, 0, dblTotalRRA,1, pCodNaturezaReinf) then
              begin
                lbErro := True;
              end;
            }
            //Andre Imakawa - WO2546-2645-2706 - Fim
          end;
          FreeAndNil(lstPeriodoREINFRRA);
        end;
        Result := lbErro;
      except
        Result := True;
      end;
    finally
      if assigned(lstPeriodoREINFRRA) then   //edilaine WO19556
         FreeAndNil(lstPeriodoREINFRRA);
    end;
  end;

