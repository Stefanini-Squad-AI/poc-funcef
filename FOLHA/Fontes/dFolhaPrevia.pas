procedure TobjRecebedor.DeterminabaseSalariofamilia;
var
   lii : Integer;
begin
     dtmFolhaPrevia.rBaseSalFam := 0 ;
     for lii:=0 to lstRubricas.count-1 do
     begin
          with TobjRubrica(lstRubricas.objects[lii]) do
          begin
               if iflgSalFam = 1 then
               begin
                    If iFlgDesconto = 0 then
                       dtmFolhaPrevia.rBaseSalFam := (dtmFolhaPrevia.rbaseSalfam + rValorRecebido)
                    else
                       dtmFolhaPrevia.rBaseSalFam := (dtmFolhaPrevia.rbaseSalfam - rValorRecebido);
               end;
          end;
     end;
end;

procedure TobjRecebedor.DeterminaBasesIRRF;
var lii: integer;
    oBaseFUND, oBaseINSS: TObjBase;
    oRub: TObjRubrica;

  function VerificaBase(aobjBase, aobjINSS,
    aobjRegr: TObjBase;
    aobjrub : TObjRubrica) : boolean;
  var lrvalordesc: real;
      lrvalorliquido: real;
      lbBenefIsento: Boolean; // Andre Imakawa - SIG 49800-60759
  begin
    result:=false;

    If aobjBase = nil Then
      exit;

    If (aobjrub.iflgdesconto = 0)        And
       (aobjrub.sflgtipodesc <> 'Y')     And
       (aobjrub.sflgtipodesc <> 'Q')     And
       (aobjrub.iflgirrf = 1)            And
       (trim(aobjrub.scodirrfdarf) = '') Then
      dtmFolhaPrevia.ExibeMensagemSemRecebedor('Rubrica:'+
                                                IntToStr(aobjrub.iidrubrica)     +
                                                ' sem a Natureza de Rendimento ' +
                                                'parametrizada, mas compõe IR. '+
                                                'Fazer a parametrização no cadastro de rubricas.');

    If (aobjrub.iflgirrf      = 1)   And
       (aobjrub.iflgdesconto  < 2)   And
       (aobjrub.sflgtipodesc <> 'K') Then
    Begin

      lbBenefIsento := ObtemBeneficioIsento(aobjrub.iidbeneficio); // Andre Imakawa - SIG 49800-60759

      If aobjrub.iflgdesconto = 0 Then
      Begin
        //ESTES LANÇAMENTOS SÃO INCORPORADOS
        //  AO PROVENTO QUANDO É REALIZADA A EXECUÇÃO DA REGRA DE RUBRICA INDIVIDUAL
        aobjBase.rvalorliquido:=aobjBase.rvalorliquido+aobjrub.rvalorrecebido;

        // Andre Imakawa - SIG 49800-60759 - Inicio
        If aobjrub.sflgtipodesc = 'W' then
        begin
          if not(lbBenefIsento) then
            aobjBase.rproventoirrf:=aobjBase.rproventoirrf+aobjrub.rvalorinfo;
          //if lbBenefIsento then aobjBase.rproventoisentobenef := aobjBase.rproventoisentobenef+aobjrub.rvalorinfo;
        end
        else
        begin
          if not(lbBenefIsento) then
            aobjBase.rproventoirrf:=aobjBase.rproventoirrf+aobjrub.rvalorrecebido;
          //if lbBenefIsento then aobjBase.rproventoisentobenef := aobjBase.rproventoisentobenef+aobjrub.rvalorrecebido;
        end;
        // Andre Imakawa - SIG 49800-60759 - Fim

        aobjBase.rvalorbruto:=aobjBase.rvalorbruto+aobjrub.rvalorrecebido;
      End
      Else
      Begin
        //CASO A BASE FIQUE NEGATIVA PASSAR PARA A PRÓXIMA BASE
//PASSOU A USAR VARIÁVEL AUXILIAR ANTES DOS PASSOS
//  DE VERIFICAÇÃO DOS VALORES NA BASE
// QUANDO A BASE NÃO COMPORTAVA O VALOR COMPLETO DA RUBRICA DE DESCONTO SAIA DA ROTINA
// PARA VERIFICAR EM OUTRA BASE. O PROBLEMA É QUE A VARIÁVEL RDESCONTOIRRF NÃO ERA ABATIDA
// DO VALOR PARCIAL, E PORTANTO EM ALGUMAS SITUAÇÕES O IR ERA CALCULADO INDEVIDAMENTE.
        If aobjrub.sflgtipodesc = 'W' Then
          lrvalordesc:=aobjrub.rvalorinfo
        else if (aobjrub.iflgirrf = 1) and (aobjrub.iOptaIRREgressivo = 1) and (aobjrub.sflgtipodesc = 'D') then     //edilaine - SIG92807 // Andre Imakawa - SIG94059
          lrvalordesc := 0                                                        //edilaine - SIG92807
        //edilaine WO33925 : inicio
        else if (aobjrub.iflgirrf = 1) and (aobjrub.iOptaIRREgressivo = 0) and (aobjrub.sflgtipodesc = 'D') then
        begin
          if not(lbBenefIsento) then
            aobjBase.rproventoirrf:=aobjBase.rproventoirrf-aobjrub.rvalorrecebido;
           lrvalordesc := 0;
        end
        //edilaine WO33925 : fim
        Else
          lrvalordesc:=aobjrub.rvalorrecebido;


        If assigned(aobjRegr) then
          lrvalorliquido := aobjBase.rvalorliquido +
                            aobjRegr.rvalorliquido
        Else
          lrvalorliquido:=aobjBase.rvalorliquido;

        If Not((aobjrub.iflgPA = 1) And (aobjrub.sflgtipodesc = 'Y')) Then
          If lrvalorliquido-lrvalordesc < 0 then
          Begin
            If aobjINSS <> nil then
            Begin
              if not(lbBenefIsento) then
                aobjBase.rdescontoirrf:=aobjBase.rdescontoirrf+aobjBase.rvalorliquido;
              //if lbBenefIsento then aobjBase.rdescontoisentobenef:=aobjBase.rdescontoisentobenef+aobjBase.rvalorliquido; // Andre Imakawa - SIG 49800-60759
              aobjBase.rvalorliquido:=0;
            End;

            //exit; // SOL 218271 - KTN 2049249
          End;

        aobjBase.rvalorliquido:=aobjBase.rvalorliquido-lrvalordesc;

        // Andre Imakawa - SIG 49800-60759 - Inicio
        If (aobjrub.sflgtipodesc = 'P') Then
        begin
          if not(lbBenefIsento) then
            aobjBase.rdescontoContrib := aobjBase.rdescontoContrib + lrvalordesc;
        end
        Else
        begin
          if not(lbBenefIsento) then
            aobjBase.rdescontoirrf:=aobjBase.rdescontoirrf+lrvalordesc;
        end;
        // Andre Imakawa - SIG 49800-60759 - Fim

        //atribui o coddarf apenas nos descontos
        aobjrub.itipobase:=aobjBase.itipobase;
		//aobjrub.scodirrfdarf:=aobjBase.scodirrfdarf; //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
        //BRUNO AZEVEDO 03/04/2013 - 155182 - QUANDO FOR RUBRICA INDIVIDUAL NÃO ATUALIZAR O CODDARF
        //if aobjrub.sflgtipodesc <> 'Y' then begin
        //  aobjrub.scodirrfdarf:=aobjBase.scodirrfdarf;
        //end;
      End;

      result:=true;
    End;

    //edilaine SIG92016 : inicio
    If (aobjrub.iFlgIsentoAcaoGanha = 1) And
       (aobjrub.iflgirrf      = 0)   And
       (aobjrub.iflgdesconto  < 2)   And
       (aobjrub.sflgtipodesc <> 'K') Then
    Begin
      lbBenefIsento := ObtemBeneficioIsento(aobjrub.iidbeneficio); // Andre Imakawa - SIG 49800-60759

      if (aobjrub.iflgdesconto = 0) and (not lbBenefIsento) then
      begin
        If aobjrub.sflgtipodesc = 'W' Then
           aobjBase.rProvIsentoIrAcaoJud := aobjBase.rProvIsentoIrAcaoJud + aobjrub.rvalorinfo
        else
           aobjBase.rProvIsentoIrAcaoJud := aobjBase.rProvIsentoIrAcaoJud + aobjrub.rvalorrecebido;
      end
      else
      begin
        lrvalordesc := 0;
        If aobjrub.sflgtipodesc = 'W' Then
          lrvalordesc:=aobjrub.rvalorinfo
        Else
          lrvalordesc:=aobjrub.rvalorrecebido;


        if (aobjrub.sflgtipodesc = 'P') and (not lbBenefIsento) and (aobjrub.iFlgExcluiContribPA = 0) Then
           aobjBase.rDescIsentoIrAcaoJud := aobjBase.rDescIsentoIrAcaoJud + lrvalordesc;

        if (aobjrub.sflgtipodesc <> 'P') and (not lbBenefIsento) then
           aobjBase.rDescIsentoIrAcaoJud := aobjBase.rDescIsentoIrAcaoJud + lrvalordesc;
      end;
    end;
    //edilaine SIG92016 : fim

  End;

begin
  For lii:=0 to lstRubricas.count-1 do
  Begin
    oRub:=TobjRubrica(lstRubricas.objects[lii]);

    If (oRub.iflgdesconto in [1,2]) Or
       ((oRub.iflgdesconto  = 0)  And
        (oRub.sflgtipodesc <> 'B')  And
        (oRub.sflgtipodesc <> 'R')) Then
    Begin
      If (oRub.iflgdesconto in [1,2]) then
        oRub.rValorprovento:=0;

      if copy(oRub.smes,6,2) = '13' then
      begin
        oBaseFUND:=BaseFUND13;
        oBaseINSS:=BaseINSS13;
      end
      else
      begin
        oBaseFUND:=BaseFUND;
        oBaseINSS:=BaseINSS;
      end;

      {pode descontar sobre suplementação, ou suplementação+resgate
       ou suplementação+resgate+inss}
      If (oRub.itipobasedesconto in [1,4,5]) then
      Begin
        //If (iisomairrfinss = 1) or (oRub.ifontepagadora = 1) then // Andre Imakawa - SIG 123480
        If (oRub.ifontepagadora = 1) then                           // Andre Imakawa - SIG 123480
        Begin
//        if oBaseFUND.FPlanoPrev <> oRub.iidPlanoPrev then continue; //Renato Visoni SOL 123018 Kintana 610105  //SOL124143 - Daniel Begnami
          If VerificaBase(oBaseFUND, BaseFUND13, BaseFUNDREGR, oRub) then //ACRESCENTA BASE REGRESSIVA
            continue;
        End;

        //If (iisomairrfinss = 1)      Or (oRub.ifontepagadora = 2) Then // Andre Imakawa - SIG 123480
        If (oRub.ifontepagadora = 2) Then                                // Andre Imakawa - SIG 123480
        begin
          if VerificaBase(oBaseINSS, BaseINSS13, nil, oRub) then //ACRESCENTA BASE REGRESSIVA
            continue;
        End;
      End;

      {pode descontar sobre resgate, ou suplementação+resgate
       ou suplementação+resgate+inss ==> testar sobre resgate}
      if (oRub.itipobasedesconto in [2,4,5]) then
      begin
        if VerificaBase(BaseReserva, nil, BaseReservaREGR, oRub) then //ACRESCENTA BASE REGRESSIVA
          continue;

        if VerificaBase(BaseReservaCD, nil, BaseReservaREGR, oRub) then //ACRESCENTA BASE REGRESSIVA
          continue;
      end;

      //QUANDO IR É TOTAL A BASE É SUPL
      if iisomairrfinss = 1 then
      begin
        if (oRub.itipobasedesconto in [3,5]) then
        begin
          // Andre Imakawa - SIG 123480 - Inicio
          If (oRub.ifontepagadora = 1) then
            if VerificaBase(oBaseFUND, BaseFUND13, BaseFUNDREGR, oRub) then //ACRESCENTA BASE REGRESSIVA
              continue;

          If (oRub.ifontepagadora = 2) then
            if VerificaBase(oBaseINSS, BaseINSS13, nil, oRub) then  //ACRESCENTA BASE REGRESSIVA
              continue;
          // Andre Imakawa - SIG 123480 - Fim              
        end;

      end
      else
      begin
        {pode descontar sobre inss, ou suplementação+inss
         ou suplementação+resgate+inss ==> testar sobre inss}
        if (oRub.itipobasedesconto in [3,5]) and
           (oRub.sflgtipodesc <> 'B') and
           (oRub.sflgtipodesc <> 'R') then
        begin
          if (oRub.ifontepagadora = 1) then
            if VerificaBase(oBaseFUND, oBaseINSS, BaseFUNDREGR, oRub) then //ACRESCENTA BASE REGRESSIVA
              continue;

          if (oRub.ifontepagadora = 2) then
            if VerificaBase(oBaseINSS, BaseINSS13, nil, oRub) then //ACRESCENTA BASE REGRESSIVA
              continue;

        end;
      end;
    end;
  end;
end;

//VERIFICA MARGEM DA RUBRICA
//   SEPAREI ROTINA PARA PODER EXECUTAR PARA UMA RUBRICA APENAS
procedure TobjRecebedor.VerificaMargemDescontoRubrica(
  aobjrub: tobjrubrica;
  abEstrutura: boolean); 
var rdesc: real;
begin
  if (SistemaFolha.TipoMargemDesconto <> 2) or
                                                                             //BRUNO AZEVEDO SOL 132237 KINTANA 760615
     ((SistemaFolha.TipoMargemDesconto = 2) and (aobjrub.iFlgRubLegal = 0) and (aobjrub.iFlgMargem = 1)) then
    aobjrub.bpossuimargem:=false;

  if aobjrub.iflgdesconto = 1 then
  begin
    if (SistemaFolha.TipoMargemDesconto <> 2) or
       ((SistemaFolha.TipoMargemDesconto = 2) and (aobjrub.iFlgRubLegal = 0)) then
    begin
      if prmFlgCalculoValores = 0 then
        rdesc:=TruncaMoeda(aobjrub.rvalorrecebido)
      else
        rdesc:=ArredondaMoeda(aobjrub.rvalorrecebido);

        if ((rMargemDesconto > 0) and (aobjrub.iFlgMargem = 1) and (aobjrub.iFlgRubLegal = 0))
           //BRUNO AZEVEDO SOL 132237 KINTANA 760615
           //BRUNO AZEVEDO SOL 132119 KINTANA 758870
           //or
           //((rMargemDesconto 15
        then
      begin
        if (rMargemDesconto - rdesc >= -0.009) then
        begin
          rMargemDesconto:=rMargemDesconto-rdesc;
          rliquidototal:=rliquidototal-rdesc;
          aobjrub.rValorprovento:=rdesc;
          aobjrub.bpossuimargem:=true;
        end
        else
          if (aobjrub.idescontaparcial=1) then
          begin
            aobjrub.rValorprovento:=rMargemDesconto;
            rMargemDesconto:=0;
            rliquidototal:=rliquidototal-aobjrub.rValorprovento;
            if (rliquidototal <= 0.009) then
              rliquidototal:=0;
            aobjrub.bpossuimargem:=true;
          end;
      end;
    end;
  end;

  if abEstrutura then
    if (aobjrub.iflgdesconto = 0) or
       ((aobjrub.iflgdesconto = 1) and (aobjrub.iFlgMargem = 1)) or
       //BRUNO AZEVEDO SOL 132406 KINTANA 762728
       ((aobjrub.iflgdesconto = 2) and (aobjrub.iFlgMargem = 1)) then  // SOL124161 - Daniel Begnami
      dtmfolhaprevia.AtualizaValorEstrutura(aobjrub);
end;

procedure TobjRecebedor.VerificaMargemDesconto(
  aiPasso: integer
  );
var lii : integer;
    objrub : TobjRubrica;
    rdesc: real;
    //BRUNO AZEVEDO SOL 132237 KINTANA 760615
    bEncRet: Boolean;
    //BRUNO AZEVEDO SOL 132237 KINTANA 760615

    //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE
    iIdPessoa : integer;
    //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE
begin
  //ACERTO LIQUIDO 0.01 PARA FICAR EM 0.00

  rliquidototal:=0;
  rMargemDesconto:=0;
  rLimiteVlrBase  :=0;//Renato Visoni SOL 131523 KINTANA 750021
  rVlrBase        :=0;//Renato Visoni SOL 131523 KINTANA 750021
  
  //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE
  iIdPessoa := 0;
  //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE
  for lii:=0 to lstRubricas.count-1 do
  begin
    objrub:=(lstRubricas.objects[lii] as TobjRubrica);
    if objrub.iflgdesconto = 0 then
    begin
      if prmFlgCalculoValores = 0 then
        rliquidototal:=rliquidototal+TruncaMoeda(objrub.rValorprovento)
      else
        rliquidototal:=rliquidototal+ArredondaMoeda(objrub.rValorprovento);

      //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE
      if (iIdPessoa <>  objrub.iIdpessoa) then begin
        FazQuery(dtmFolhaPrevia.qryAux, 'SELECT COUNT(1) AS QTD_ATIVO ' +
                                        '  FROM BENEFBFCIARIO         ' +
                                        ' WHERE IDPESSOA = '+ intTostr(objrub.iIdpessoa) +
                                        '   AND IDSITBENEFICIO NOT IN (2, 3) ');

        bEncRet := (dtmFolhaPrevia.qryAux.FieldByName('QTD_ATIVO').AsInteger = 0);
      end;
      //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE

      if (SistemaFolha.TipoMargemDesconto <> 2) or
         ((SistemaFolha.TipoMargemDesconto = 2) and (objrub.iFlgRubLegal = 1)) or
         (bEncRet) then
         //if (SistemaFolha.TipoMargemDesconto <> 2) or (SistemaFolha.TipoMargemDesconto = 2) then
         //and (objrub.iFlgRubLegal = 1)) then // Bruno Azevedo SOL 132119 KINTANA 758870
      //BRUNO AZEVEDO SOL 187313 KINTANA 1763785
      begin
        if prmFlgCalculoValores = 0 then
          rMargemDesconto:=rMargemDesconto+TruncaMoeda(objrub.rValorprovento)
        else
          rMargemDesconto:=rMargemDesconto+ArredondaMoeda(objrub.rValorprovento);
      end;
      //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE
      iIdPessoa := objrub.iIdpessoa;
      //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE
    end
    else
    begin
      //EFETUA O ABATIMENTO DAS RUBRICAS DE DESCONTO LEGAL ANTES DA APLICAÇÃO DO PERCENTUAL DE MARGEM

     //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE
      if (iIdPessoa <>  objrub.iIdpessoa) then begin
        FazQuery(dtmFolhaPrevia.qryAux, 'SELECT COUNT(1) AS QTD_ATIVO ' +
                                        '  FROM BENEFBFCIARIO         ' +
                                        ' WHERE IDPESSOA = '+ intTostr(objrub.iIdpessoa) +
                                        '   AND IDSITBENEFICIO NOT IN (2, 3) ');

        bEncRet := (dtmFolhaPrevia.qryAux.FieldByName('QTD_ATIVO').AsInteger = 0);
      end;
      //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE

      if objrub.iflgdesconto = 1 then
      begin
        if (SistemaFolha.TipoMargemDesconto = 2) and
            //BRUNO AZEVEDO SOL 132237 KINTANA 760615
           ((objrub.iFlgRubLegal = 1) or (bEncRet)) then
        begin
          if prmFlgCalculoValores = 0 then
            rDesc:=TruncaMoeda(objrub.rvalorrecebido)
          else
            rDesc:=ArredondaMoeda(objrub.rvalorrecebido);
          if rMargemDesconto > 0 then
          begin
            if roundCM(rMargemDesconto,2) >= RoundCM(rDesc,2) then
            begin
              rMargemDesconto:=RoundCM(rMargemDesconto,2)-RoundCM(rDesc,2);
              objrub.rValorprovento:=RoundCM(rdesc,2);
              rliquidototal:=rliquidototal-RoundCM(rdesc,2);
              objrub.bpossuimargem:=true;
            end
            else
            begin
              if (objrub.idescontaparcial=1) then
              begin
                objrub.rValorprovento:=RoundCM(rMargemDesconto,2);
                rMargemDesconto:=0;
                rliquidototal:=rliquidototal-objrub.rValorprovento;
                if (rliquidototal <= 0.009) then
                  rliquidototal:=0;
                objrub.bpossuimargem:=true;
              end;
            end;
          end;
        end;
      end;
      //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE
      iIdPessoa := objrub.iIdpessoa;
      //BRUNO AZEVEDO SOL 251666 KINTANA 746448 - PROJETO DE MELHORIA DE PERFORMANCE
    end;
  end;

  //BRUNO AZEVEDO SOL 132237 KINTANA 760615
  if not(bEncRet) then begin
    if SistemaFolha.VlrMargemDesconto > 0 then
    begin
      //BRUNO AZEVEDO SOL 132368 KINTANA 762229
      CalculaMargemDesconto(rMargemDesconto);
      //BRUNO AZEVEDO SOL 132368 KINTANA 762229

      //EFETUAR ARREDONDAMENTO OU TRUNCAMENTO DO VALOR LIQUIDO PARA MARGEM DE DESCONTO
      //SEMPRE TRUNCA POIS TENHO NESTE MOMENTO O VALOR TOTAL DE PROVENTOS
      //  E INDIVIDUALMENTE AS RUBRICA PODEM NÃO TER +0.01 E NO TOTAL PODE TER O QUE VAI GERAR UM LIQDUIDO FINAL DE -0.01
      if prmFlgCalculoValores = 0 then
        rliquidototal:=TruncaMoeda(rliquidototal)
      else
        rliquidototal:=ArredondaMoeda(rliquidototal);
    end;

    rLimiteVlrBase := rliquidototal-rMargemDesconto;//Renato Visoni SOL 131523 KINTANA 750021


    //Renato Visoni SOL 131523 KINTANA 750021
    iIdPessoa := 0; // SOL 254972 PPM 811047
    for lii:=0 to lstRubricas.count-1 do
    begin
      objrub:=(lstRubricas.objects[lii] as TobjRubrica);
      if (iIdPessoa <>  objrub.iIdpessoa) then begin // SOL 254972 PPM 811047 inicio
         FazQuery(dtmFolhaPrevia.qryAux, 'SELECT COUNT(1) AS QTD_ATIVO ' +
                                  '  FROM BENEFBFCIARIO         ' +
                                  ' WHERE IDPESSOA = '+ intTostr(objrub.iIdpessoa) +
                                  '   AND IDSITBENEFICIO NOT IN (2, 3) ');

         bEncRet := (dtmFolhaPrevia.qryAux.FieldByName('QTD_ATIVO').AsInteger = 0);
      end; // SOL 254972 PPM 811047 fim
      iIdPessoa := objrub.iIdpessoa; // SOL 254972 PPM 811047
      VerificaMargemDescontoRubricaVoluntaria(objrub, aiPasso=1, bEncRet);
      if rLimiteVlrBase <= 0.009 then
        break;
    end;
    //Renato Visoni SOL 131523 KINTANA 750021

    for lii:=0 to lstRubricas.count-1 do
    begin
      objrub:=(lstRubricas.objects[lii] as TobjRubrica);
      //INCLUI CONTROLE PARA VALORAR ESTRUTURA DE CALCULO
      VerificaMargemDescontoRubrica(objrub, aiPasso=1);
      if rMargemDesconto <= 0.009 then
        break;
    end;
  end else begin
    for lii:=0 to lstRubricas.count-1 do
    begin
      objrub:=(lstRubricas.objects[lii] as TobjRubrica);

      if aiPasso=1 then
        if (objrub.iflgdesconto = 0) or
           (objrub.iflgdesconto = 1) or
           (objrub.iflgdesconto = 2) then  // SOL124161 - Daniel Begnami
          dtmfolhaprevia.AtualizaValorEstrutura(objrub);
    end;
  end; //-> //BRUNO AZEVEDO SOL 132237 KINTANA 760615
  dtmFolhaPrevia.qryAux.close; // SOL 242740 PPM 575822
end;

//BRUNO AZEVEDO SOL 132368 KINTANA 762229
procedure TobjRecebedor.CalculaMargemDesconto(var pMargem: Real);
begin
  pMargem:=pMargem*(1-SistemaFolha.VlrMargemDesconto/100);
  if prmFlgCalculoValores = 0 then
    pMargem:=TruncaMoeda(pMargem)
  else
    pMargem:=ArredondaMoeda(pMargem);
end;
//BRUNO AZEVEDO SOL 132368 KINTANA 762229

function TobjRecebedor.TransformaCotas(arvalorreal : real; asmesref : string) : real;
 var dIndice : double;
begin
  result:=arvalorreal;
  if (dtmFolhaPrevia.qryPrevia.fieldbyname('FLGCALCTODOMES').asinteger = 1) then
  begin
    if smesmoedabase = asmesref then
      dindice := rindicebase
    else
    begin
      if not PegaIndiceMes(icodmoedabase, asmesref, dIndice) then
        dIndice:=0;
      smesmoedabase:=asmesref;
      rindicebase:=dIndice;
    end;
    if dIndice > 0.0000001 then
      result:=result*dIndice
    else
      result:=0;
  end;
end;

procedure TObjRecebedor.ProcessaRubricasConsignatario(aiidfavorecido : integer;
  objRecConsig : tobjrecebedor);
 var lii: integer;
     lsmesant, lstipodesc : string;
     objRub: tobjrubrica;
     lrvalorinssconsig, lrValorCPMFPA: double;
     smesref: string; 
begin
  lsmesant:='';
  //alteração no controle do valor do inss quando
  //     se tem opção de somar bases de Supl e INSS
  //------ VERIFICA O CPMF SOBRE A PENSAO (INSS) ----------------------------------//
  lrValorCPMFPA:=0;
  if bcalculacpmf then
  begin
    //TRATA RUBRICA NÃO PARAMETRIZADA
    if SistemaFolha.IDRUBCPMFPAINSS > 0 then
    begin
      lrvalorinssconsig:=0;
      //ACHA VALORES DE PA INSS PRESUMIDOS EM FUNCAO DO IR TOTAL
      for lii:=0 to lstRubPAINSSIntermed.count-1 do
      begin
        objrub:=TobjRubrica(lstRubPAINSSIntermed.objects[lii]);
        if (aiidfavorecido = objrub.iidfavorecido) and
           (objrub.rValorRecebido > 0) and
           (objrub.iidrubricaconsig > 0) and
           (objrub.ifontepagadora = 2) then
          lrvalorinssconsig:=lrvalorinssconsig+objrub.rValorRecebido;
      end;

      for lii:=0 to lstRubricas.count-1 do
      begin
        objrub:=TobjRubrica(lstRubricas.objects[lii]);
        if (aiidfavorecido = objrub.iidfavorecido) and
           (objrub.rValorprovento > 0) and
           (objrub.iidrubricaconsig > 0) and
           (objrub.ifontepagadora = 2) then
          lrvalorinssconsig:=lrvalorinssconsig+objrub.rValorprovento;
      end;
      if lrvalorinssconsig > 0 then
      begin
        lrValorCPMFPA:=CalculaCPMF(lrvalorinssconsig);
        if lrValorCPMFPA > 0 then
        begin
          if prmFlgCalculoValores = 0 then
            lrValorCPMFPA:=TruncaMoeda(lrValorCPMFPA)
          else
            lrValorCPMFPA:=ArredondaMoeda(lrValorCPMFPA);
          dtmfolhaprevia.objrecebedor.CalculaCPMFSobrePensao(lrvalorcpmfpa);
        end;
      end;
    end
    else
    begin
      dtmFolhaPrevia.ExibeMensagem('Rubrica de Credito de CPMF de '+
        'Consignação Judicial sobre o INSS não parametrizada.',
        self); 
    end;
  end;

//ACRESCENTA NUMPROCINSS DO CONSIGNATARIO
  for lii:=0 to lstRubricas.count-1 do
  begin
    objrub:=TobjRubrica(lstRubricas.objects[lii]);
    if (aiidfavorecido = objrub.iidfavorecido) and
       (objrub.rValorprovento > 0) and
       (objrub.iidrubricaconsig > 0) and
       (objrub.sflgtipodesc = 'Y') then
    begin
      if objrub.snumprocinssconsig <> ''  then
      begin
        objRecConsig.snumprocinss:=objrub.snumprocinssconsig;
        break;
      end;
    end;
  end;

  for lii:=0 to lstRubricas.count-1 do
  begin
    objrub:=TobjRubrica(lstRubricas.objects[lii]);
    if (aiidfavorecido = objrub.iidfavorecido) and
