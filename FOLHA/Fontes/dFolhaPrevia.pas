                if iCiclo > 2 then   //Darivaldo Alencar - SIG65454
                begin
                  iCiclo := -1;
                  fn_perfilinvest(iIDPESSOA, iIDTITULAR, iIDPLANOPREV, ifontepagadora);
                end;
                // Andre Imakawa - SIG 66337 - Fim
              end;
            end;
          until (iCiclo = -1);
          //edilaine - SIG56702 fim
        end;

        queryperfil.SQL.Clear;
        queryperfil.Close;

      finally
        FreeAndNil(queryperfil);
      end;
    end;
