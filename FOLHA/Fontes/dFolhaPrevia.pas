//MARCIO DENILSON SOL 151061 KINTANA 1105188
procedure TobjRecebedor.consultaValoresRubCorrecaoMonetaria(pMes: String; piIDPessoa, piIdTitular, piIDPlanoPrev: Integer; var rValorProvento,rValorDesconto: Real);
var
  sSQL : String;
  Query:TwwQuery;   //edilaine SOL 151061 KINTANA 1105188
  lii : Integer; //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
  objrub : tobjrubrica; //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
begin

  //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
  try
    rValorProvento := 0;
    rValorDesconto := 0;

    Query := TwwQuery.Create(nil);           //edilaine WO19556
    Query.DataBaseName := 'BaseDados';

    for lii := 0 to lstRubricas.Count -1 do
    begin
      objrub := (lstRubricas.objects[lii] as tobjrubrica);

      //sSQL  := ' SELECT * FROM PROVDESC ' +#13+
      sSQL  := ' SELECT FLGDESCONTO FROM PROVDESC ' +#13+
               ' WHERE IDPROVENTO = ' + IntToStr(objrub.iidrubrica) +#13+
               ' AND FLGIRRF = 1 ' +#13+
               ' AND CODFONTEPAGADORA = 1 ' +#13+
               ' AND FLGCORRECAOMONETARIA = 1';
      Query.Close;
      Query.SQL.clear;
      Query.SQL.Add(sSQL);
      Query.Open;

      if not Query.IsEmpty then
      begin
           if Query.FieldByName('FLGDESCONTO').AsInteger = 1 then
           begin
                rValorDesconto := rValorDesconto + objrub.rvalorprovento;
           end
           else
           begin
                rValorProvento := rValorProvento + objrub.rvalorprovento;
           end;
      end;

    end;


  finally
    Query.close;
    FreeAndNil(Query);  //Query.free; //edilaine WO19556
  end;
  //FIM Helio - SOL Nº 151061-10442 KINTANA Nº 1720319

  //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
  //INICIO COMENTARIO HELIO
  //edilaine SOL 151061 KINTANA 1105188 - inicio
  {try
    rValorProvento := 0;
    rValorDesconto := 0;


    sSQL  := dtmFolhaPrevia.qryPrevia.sql.GetText;
    Query := TwwQuery.Create(dtmBaseDados);
    Query.DataBaseName := 'BaseDados';
    Query.SQL.clear;
    Query.SQL.Add(sSQL);
    Query.Open;

    Query.Filtered := False;
    Query.Filter   := 'FLGCORRECAOMONETARIA = 1 and IDPESSOA = '+#39+inttostr(piIDPessoa)+#39+ ' and IDTITULAR='+#39+inttostr(piIdTitular)+#39+' and IDPLANOPREV='+#39+inttostr(piIDPlanoPrev)+#39+' and MES='+#39+pMes+#39;
    Query.Filtered := True;

    Query.First;
    while not Query.Eof do
    begin
      if Query.fieldbyname('FLGDESCONTO').asfloat = 1 then
          rValorDesconto := rValorDesconto + Query.FieldByName('VALORPREV').AsFloat
       else
          rValorProvento := rValorProvento + Query.FieldByName('VALORPREV').AsFloat;

      Query.Next;
    end;

  finally
    Query.close;
    Query.free;
  end;}
  //edilaine SOL 151061 KINTANA 1105188 - fim
  //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
  //FIM COMENTARIO HELIO

  {//edilaine SOL 151061 KINTANA 1105188 - comentado
  sSQL := ' SELECT SUM(DECODE(PD.FLGDESCONTO,0,PR.VALORPROVENTO,0)) AS PROVENTO  '
        + '       ,SUM(DECODE(PD.FLGDESCONTO,1,PR.VALORPROVENTO,0)) AS DESCONTO  '
        + ' FROM PREVIA PR                                                       '
        + '     ,PROVDESC PD                                                     '
        + ' WHERE PR.IDRUBRICA = PD.IDPROVENTO                                   '
        + '  AND PD.FLGCORRECAOMONETARIA = 1                                                  '
        + '  AND PR.IDPESSOA = :IDPESSOA                                         '
        + '  AND PR.IDTITULAR = :IDTITULAR                                       '
        + '  AND PR.IDPLANOPREV = :IDPLANOPREV                                   '
        + '  AND MES = :MES                                                      ';

  With TwwQuery.Create(dtmBaseDados) do
   begin
     DataBaseName := dtmBaseDados.dbBaseDados.DataBaseName;
     SQL.Add(sSQL);
     ParamByName('IDPESSOA').AsInteger    := piIDPessoa;
     ParamByName('IDTITULAR').AsInteger   := piIdTitular;
     ParamByName('IDPLANOPREV').AsInteger := piIDPlanoPrev;
     ParamByName('MES').AsString := pMes;
     Open;
     if not IsEmpty then
      begin
        rValorProvento := FieldByName('PROVENTO').AsFloat;
        rValorDesconto := FieldByName('DESCONTO').AsFloat;
      end;
     Close;
     Free;
   end;
  }//edilaine SOL 151061 KINTANA 1105188 - fim
end;


