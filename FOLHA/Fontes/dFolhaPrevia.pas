//separação das rotinas de arredondamento e cpmf, pois precisam ser chamadas em momentos distintos
procedure TobjRecebedor.CalculaArredondamentoLiquido(
  abbeneficiario: boolean);
var lrarredonda: real;
    lsmesarred: string;
    lstipodesc: string;
begin
  if lbpagtoelet and (prmIDRUBARRED > 0) and (prmIDRUBARREDMESANT > 0) then
  begin
    dtmfolhaprevia.qryBanco.close;
    dtmfolhaprevia.qryBanco.parambyname('IDPESSOA').asinteger:=iidresponsavel;
    dtmfolhaprevia.qryBanco.open;

    if dtmfolhaprevia.qryBanco.recordcount = 1 then
    begin
      if (dtmfolhaprevia.qryBanco.fieldbyname('TIPOCONTA').AsString = '2') then
      begin
        lrarredonda:=CalculaArredondamento(rliquidototal, 5);

        //GRAVAR RUBRICA DE ARREDONDAMENTO COM MES DE ABONO NA FOLHA DE ABONO
        if dtmfolhaprevia.qryPrevia.fieldbyname('FLGTIPOFOLHA').asinteger in [3,4] then
          lsmesarred:=dtmFolhaPrevia.MesAbono
        else
          lsmesarred:=dtmFolhaPrevia.MesCobranca;

        lstipodesc:=dtmFolhaPrevia.BuscaDadosRubrica(self, prmIDRUBARRED, 'T');

        if lstipodesc <> '' then
        begin
          try

            if not InsereRubrica(iidresponsavel,                                                        //beneficiario
                                 0,                                                                     //favorecido da rubrica
                                 0,                                                                     //beneficio associado : pega beneficio base
                                 prmIDRUBARRED,                                                         //codigo do provento
                                 dtmFolhaPrevia.qryProvento.FieldByName('flgdesconto').asinteger,       //flag de desconto
                                 dtmFolhaPrevia.qryProvento.FieldByName('flgespecial').asinteger,       //flag especial
                                 prmidmotivofolhaben,                                                   //motivo do desconto
                                 1,                                                                     //seqrubrica = 1
                                 icodmoedabase,                                                         //codigo da moeda
