//VALORES INTERMEDIARIOS PARA REGRAS - serão atribuidas
//    no método de escrita do ValorProvento da Rubrica
procedure TobjRecebedor.AtribuiValores(arvalor: real; aobjrub: tobjrubrica);
var rsinal: real;
begin
  if aobjrub.iflgdesconto = 0 then
    rsinal:=1
  else
    rsinal:=-1;

  // Andre Imakawa - SIG 101940 - Inicio
  if (copy(aobjrub.smes,1,4) <> copy(dtmFolhaPrevia.MesCobranca,1,4)) and
     (aobjrub.sflgtipodesc = 'B') then
  begin
    dtmFolhaPrevia.qryAux4.Close;
    dtmFolhaPrevia.qryAux4.SQL.Clear;
    dtmFolhaPrevia.qryAux4.SQL.Add(' select 1 from provdesc');
    dtmFolhaPrevia.qryAux4.SQL.Add(' WHERE IDPROVENTO ='+ IntToStr(aobjrub.iidrubrica));
    dtmFolhaPrevia.qryAux4.SQL.Add('   AND FLGRRA = 1');
    dtmFolhaPrevia.qryAux4.open;

    if (dtmFolhaPrevia.qryAux4.RecordCount > 0) then
    begin
      if aobjrub.ifontepagadora = 1 then
      begin
        if (copy(aobjrub.smes,6,2) <> '13') then
          dtmfolhaprevia.objrecebedor.rSuplRRA := dtmfolhaprevia.objrecebedor.rSuplRRA +rsinal*arvalor
        else
          dtmfolhaprevia.objrecebedor.rSuplAbnRRA := dtmfolhaprevia.objrecebedor.rSuplAbnRRA +rsinal*arvalor;
      end
      else
      begin
        if (copy(aobjrub.smes,6,2) <> '13') then
          dtmfolhaprevia.objrecebedor.rINSSRRA := dtmfolhaprevia.objrecebedor.rINSSRRA +rsinal*arvalor
        else
          dtmfolhaprevia.objrecebedor.rINSSAbnRRA := dtmfolhaprevia.objrecebedor.rINSSAbnRRA +rsinal*arvalor;
      end;
    end;

  end;
  // Andre Imakawa - SIG 101940 - Fim

  if (aobjrub.smes = dtmfolhaprevia.Mescobranca) and
     (aobjrub.sflgtipodesc = 'B') and
     (aobjrub.ifontepagadora = 1) then
  begin
    dtmfolhaprevia.objrecebedor.rSuplMes:=dtmfolhaprevia.objrecebedor.rSuplMes+rsinal*arvalor;
    exit;
  end;

//USAR APENAS O ABONO DO ANO-
//  POSTERIORMENTE OS VALORES DE ANOS ANTERIORES SERÃO ABERTOS EM UMA VARIÁVEL
//  SEPARADA QUE SERÁ PASSADA PARA AS REGRAS DE CÁLCULO
  if (aobjrub.smes = dtmfolhaprevia.MesAbono) and
     (aobjrub.sflgtipodesc = 'B') and
     (aobjrub.ifontepagadora = 1) then
  begin
    if rsinal > 0 then
      dtmfolhaprevia.objrecebedor.rSuplAbn:=dtmfolhaprevia.objrecebedor.rSuplAbn+rsinal*arvalor;
    exit;
  end;

  if (aobjrub.smes <> dtmfolhaprevia.Mescobranca) and
     (copy(aobjrub.smes,6,2) <> '13') and
     (aobjrub.sflgtipodesc = 'B') and
     (aobjrub.ifontepagadora = 1) then
  begin
    dtmfolhaprevia.objrecebedor.rSuplAtr:=dtmfolhaprevia.objrecebedor.rSuplAtr+rsinal*arvalor;
    exit;
  end;

  if (aobjrub.smes = dtmfolhaprevia.Mescobranca) and
     (aobjrub.sflgtipodesc = 'B') and
     (aobjrub.ifontepagadora = 2) then
  begin
    dtmfolhaprevia.objrecebedor.rINSSMes:=dtmfolhaprevia.objrecebedor.rINSSMes+rsinal*arvalor;
    //BASE PARA PA
    if (aobjrub.iformabasePA = 1) then
      dtmfolhaprevia.objrecebedor.rINSSMesBasePA:=dtmfolhaprevia.objrecebedor.rINSSMesBasePA+rsinal*arvalor;
    exit;
  end;

  if (copy(aobjrub.smes,6,2) = '13') and
     (aobjrub.sflgtipodesc = 'B') and
     (aobjrub.ifontepagadora = 2) then
  begin
    if rsinal > 0 then
    begin
      dtmfolhaprevia.objrecebedor.rINSSAbn:=dtmfolhaprevia.objrecebedor.rINSSAbn+rsinal*arvalor;
      if (aobjrub.iformabasePA = 1) then
        dtmfolhaprevia.objrecebedor.rINSSAbnBasePA:=dtmfolhaprevia.objrecebedor.rINSSAbnBasePA+rsinal*arvalor;
    end;
    exit;
  end;

  if (aobjrub.smes <> dtmfolhaprevia.Mescobranca) and
     (copy(aobjrub.smes,6,2) <> '13') and
     (aobjrub.sflgtipodesc = 'B') and
     (aobjrub.ifontepagadora = 2) then
  begin
    //VERIFICAR SE É RRA 155182 - BRUNO AZEVEDO
    dtmFolhaPrevia.qryAux4.Close;
    dtmFolhaPrevia.qryAux4.SQL.Clear;
    //dtmFolhaPrevia.qryAux4.SQL.Add(' select NVL(FLGRRA,0) from provdesc');   // SOL 242740 PPM 575822
    dtmFolhaPrevia.qryAux4.SQL.Add(' select 1 from provdesc');   // SOL 242740 PPM 575822
    dtmFolhaPrevia.qryAux4.SQL.Add(' WHERE IDPROVENTO ='+ IntToStr(aobjrub.iidrubrica));
    //dtmFolhaPrevia.qryAux4.SQL.Add('   AND NVL(FLGRRA,0) = 1'); // SOL 242740 PPM 575822
    dtmFolhaPrevia.qryAux4.SQL.Add('   AND FLGRRA = 1');     // SOL 242740 PPM 575822
    dtmFolhaPrevia.qryAux4.open;

    if (dtmFolhaPrevia.qryAux4.RecordCount = 0) then begin
       dtmfolhaprevia.objrecebedor.rINSSAtr:=dtmfolhaprevia.objrecebedor.rINSSAtr+rsinal*arvalor;
    end;
    //VERIFICAR SE É RRA 155182 - BRUNO AZEVEDO
    exit;
  end;

  if (aobjrub.smes <> dtmfolhaprevia.MesAbono) and
     (copy(aobjrub.smes,6,2) = '13') and
     (aobjrub.sflgtipodesc = 'B') and
     (aobjrub.ifontepagadora = 1) then
  begin
    dtmfolhaprevia.objrecebedor.rSuplAbnAtr:=dtmfolhaprevia.objrecebedor.rSuplAbnAtr+rsinal*arvalor;
    exit;
  end;

  if (aobjrub.smes <> dtmfolhaprevia.MesAbono) and
     (copy(aobjrub.smes,6,2) = '13') and
     (aobjrub.sflgtipodesc = 'B') and
     (aobjrub.ifontepagadora = 2) then
  begin
    dtmfolhaprevia.objrecebedor.rINSSAbnAtr:=dtmfolhaprevia.objrecebedor.rINSSAbnAtr+rsinal*arvalor;
    exit;
  end;

  //Osni Cavalcante SIG 58950.59454 - Início do trecho de alteração
  if (aobjrub.smes = dtmfolhaprevia.Mescobranca) and (aobjrub.sflgtipodesc = 'P') then
  begin
    if aobjrub.iFlgExcluiContribPA = 0 then
      dtmfolhaprevia.objrecebedor.rContMes := dtmfolhaprevia.objrecebedor.rContMes + rsinal * arvalor
    else
      dtmfolhaprevia.objrecebedor.rContMesExcluido := dtmfolhaprevia.objrecebedor.rContMesExcluido + rsinal * arvalor;

    exit;
  end;

  if (copy(aobjrub.smes,6,2) = '13') and (aobjrub.sflgtipodesc = 'P') then
  begin
    if rsinal < 0 then
      if aobjrub.iFlgExcluiContribPA = 0 then
        dtmfolhaprevia.objrecebedor.rContAbn := dtmfolhaprevia.objrecebedor.rContAbn + rsinal * arvalor
      else
        dtmfolhaprevia.objrecebedor.rContAbnExcluido := dtmfolhaprevia.objrecebedor.rContAbnExcluido + rsinal * arvalor;

    exit;
  end;
  //Osni Cavalcante SIG 58950.59454 - Final do trecho de alteração

  // Andre Imakawa - SIG 67673 - Inicio
  if (aobjrub.smes <> dtmfolhaprevia.Mescobranca) and (aobjrub.sflgtipodesc = 'P') and (aobjrub.iFlgDeficit > 0) then
  begin
    if (copy(aobjrub.smes,6,2) <> '13') then
    begin
      dtmfolhaprevia.objrecebedor.rContAnterior := dtmfolhaprevia.objrecebedor.rContAnterior + rsinal * arvalor
    end
    else
    begin
      if copy(aobjrub.smes,1,4) <> copy(dtmfolhaprevia.Mescobranca,1,4) then
        dtmfolhaprevia.objrecebedor.rContAbonoAnterior := dtmfolhaprevia.objrecebedor.rContAbonoAnterior + rsinal * arvalor;
    end;
  end;

  // Andre Imakawa - SIG 67673 - Fim


  if (aobjrub.smes <> dtmfolhaprevia.Mescobranca) and
     (copy(aobjrub.smes,6,2) <> '13') and
     (aobjrub.sflgtipodesc = 'P') then
  begin
    dtmfolhaprevia.objrecebedor.rContAtr:=dtmfolhaprevia.objrecebedor.rContAtr+rsinal*arvalor;
    exit;
  end;

  if (aobjrub.smes = dtmfolhaprevia.Mescobranca) and
     (aobjrub.sflgtipodesc = 'Y') and
     (aobjrub.iflgpa = 1) and
     (aobjrub.ifontepagadora = 1) and
     (aobjrub.iflgirrf = 1) then
  begin
    dtmfolhaprevia.objrecebedor.rPASuplMes:=dtmfolhaprevia.objrecebedor.rPASuplMes+rsinal*arvalor;
    exit;
  end;

  if (copy(aobjrub.smes,6,2) = '13') and
     (aobjrub.sflgtipodesc = 'Y') and
     (aobjrub.iflgpa = 1) and
     (aobjrub.ifontepagadora = 1) then
  begin
    if rsinal < 0 then
      dtmfolhaprevia.objrecebedor.rPASuplAbn:=dtmfolhaprevia.objrecebedor.rPASuplAbn+rsinal*arvalor;
    exit;
  end;

  if (aobjrub.smes <> dtmfolhaprevia.Mescobranca) and
     (copy(aobjrub.smes,6,2) <> '13') and
     (aobjrub.sflgtipodesc = 'Y') and
     (aobjrub.iflgpa = 1) and
     (aobjrub.ifontepagadora = 1) then
  begin
    dtmfolhaprevia.objrecebedor.rPASuplAtr:=dtmfolhaprevia.objrecebedor.rPASuplAtr+rsinal*arvalor;
    exit;
  end;

  if (aobjrub.smes = dtmfolhaprevia.Mescobranca) and
     (aobjrub.sflgtipodesc = 'Y') and
     (aobjrub.iflgpa = 1) and
     (aobjrub.ifontepagadora = 2) then
  begin
    dtmfolhaprevia.objrecebedor.rPAINSSMes:=dtmfolhaprevia.objrecebedor.rPAINSSMes+rsinal*arvalor;
    exit;
  end;

  if (copy(aobjrub.smes,6,2) = '13') and
     (aobjrub.sflgtipodesc = 'Y') and
     (aobjrub.iflgpa = 1) and
     (aobjrub.ifontepagadora = 2) then
  begin
    if rsinal < 0 then
      dtmfolhaprevia.objrecebedor.rPAINSSAbn:=dtmfolhaprevia.objrecebedor.rPAINSSAbn+rsinal*arvalor;
    exit;
  end;

  if (aobjrub.smes <> dtmfolhaprevia.Mescobranca) and
     (copy(aobjrub.smes,6,2) <> '13') and
     (aobjrub.sflgtipodesc = 'Y') and
     (aobjrub.iflgpa = 1) and
     (aobjrub.ifontepagadora = 2) then
  begin

     dtmfolhaprevia.objrecebedor.rPAINSSAtr:=dtmfolhaprevia.objrecebedor.rPAINSSAtr+rsinal*arvalor;
     exit;

  end;

end;

function TobjRecebedor.ValorBasePorFontePagadora(abapenasbruto: boolean;
                                                 apensaoalim: boolean;
                                                 aifontepagadora: integer): real;
 var lii : integer;
     lrbase : real;
begin
  lrbase:=0;
  for lii:=0 to lstRubricas.count-1 do
  begin
    with TobjRubrica(lstRubricas.objects[lii]) do
      if (apensaoalim and (iflgPA = 1)) or
         (iflgPA = 0) then
      begin
        if ((aifontepagadora = 2) and
            (ifontepagadora = aifontepagadora)) or
           ((aifontepagadora = 4) and
            (ifontepagadora = 2) and
            (copy(smes,5,2)='13')) then
        begin
          if (iflgdesconto = 0) then
          begin
            //CONSIDERAR APENAS RUBRICAS DE BENEFÍCIO
            if (sflgtipodesc = 'B') or
               ((sflgtipodesc <> 'B') and
                dtmContabil.IsRubricaBeneficio(iidplanoprev, iidrubrica)) then        
              lrbase:=lrbase+rValorprovento;
          end
          else
          begin
            if not abapenasbruto then
              if (iflgdesconto = 1) then
                lrbase:=lrbase-rValorprovento;
          end;
        end;
      end;
  end;
  result:=lrbase;
end;

function TobjRecebedor.VerificaCompensacaoIRRF: real;
begin
  If dtmfolhaprevia.qryPrevia.fieldbyname('IDCOMPIRRF').isnull then
    result:=0
  else
  begin
    If ((dtmfolhaprevia.qryPrevia.fieldbyname('ANOMESINICIO').asstring >
         formatdatetime('yyyy/mm',dtmFolhaPrevia.DataPagamento)) or
        (dtmfolhaprevia.qryPrevia.fieldbyname('ANOMESINICIO').isnull)) then
      result:=0
    else
      If (trim(dtmfolhaprevia.qryPrevia.fieldbyname('ANOMESFIM').asstring) <> '') and
         (dtmfolhaprevia.qryPrevia.fieldbyname('ANOMESFIM').asstring <
           formatdatetime('yyyy/mm',dtmFolhaPrevia.DataPagamento)) then
        result:=0
      else
        result:=dtmfolhaprevia.qryPrevia.fieldbyname('SALDOACOMP').asfloat;
  end;
end;
