procedure TobjRecebedor.LancaRubricaDEP_IDADE_IR(aiTipoBase: integer
  {0 - normal, 1 - abono, 2 - reserva}); //TRATA IR RESERVA
var iIdRubDedDepIR: Integer;
    iIdRubDedIdadeIR: Integer;
    idifmes, iResult: integer;
    sMesRef, lstipodesc: string;
    lsCodirrfdarf, sSql: string;
    sMesCompreemb: String;
//Bruno Bastos - 11/12/2010 - sIdPessoa, sIdTitular, sIdBeneficio, sValorPrev: String; //BRUNO AZEVEDO SOL 148662 KINTANA 1048463
begin
// SOL 148043 KINTANA 1033485
//Bruno Bastos - 11/12/2010 - iResult := 0;

  {Bruno Bastos - 11/12/2010
  //BRUNO AZEVEDO SOL 148662 KINTANA 1048463
  sIdPessoa    := dtmFolhaPrevia.qryPrevia.FieldByName('IDPESSOA').AsString;
  sIdTitular   := dtmFolhaPrevia.qryPrevia.FieldByName('IDTITULAR').AsString;
  sIdBeneficio := dtmFolhaPrevia.qryPrevia.FieldByName('IDBENEFICIO').AsString;
  sValorPrev   := dtmFolhaPrevia.qryPrevia.FieldByName('VALORPREV').AsString;
  }
  //BRUNO AZEVEDO SOL 148662 KINTANA 1048463

  {Bruno Bastos - 11/12/2010
  dtmFolhaPrevia.qryPrevia.first;
  while not(dtmFolhaPrevia.qryPrevia.eof) do
  begin
     sSql := '';
     if dtmFolhaPrevia.qryPrevia.FieldByName('FLGRESGATE').asstring  =  '1'  then
     begin
        sSql := sSql + 'SELECT 1 '+
                       'FROM PROVDESC '+
                       'WHERE (codprovdesc = ''' + dtmFolhaPrevia.qryPrevia.FieldByName('IDRUBRICA').asstring +''')' +
                       'and   (flgirrf     = ''1'')';

        if FazQuery(dtmFolhaPrevia.qryAux, sSql) then
        begin
               if dtmFolhaPrevia.qryAux.fields[0].asinteger > 0 then
           begin
              iResult := dtmFolhaPrevia.qryAux.fields[0].asinteger;
              exit;
           end;
        end
        else
           iResult := 0;
     end;
    dtmFolhaPrevia.qryPrevia.next;
  end;
   }  //Bruno Bastos - 11/12/2010 - Fim comentário

  //BRUNO AZEVEDO SOL 148662 KINTANA 1048463
  {Bruno Bastos - 11/12/2010
  dtmFolhaPrevia.qryPrevia.first;
