    function DeducaoIdade(_idpessoa,_mesreferencia,_idlote: string): Double;
      var
        query,query2,query3:TwwQuery;
      begin
        try
          query := TwwQuery.Create(nil);       //edilaine WO19556
          query.DataBaseName := 'BaseDados';

          query2 := TwwQuery.Create(nil);      //edilaine WO19556
          query2.DataBaseName := 'BaseDados';


          query3 := TwwQuery.Create(nil);      //edilaine WO19556
          query3.DataBaseName := 'BaseDados';


          query.Close;
          query.SQL.Clear;
          query.SQL.Add('SELECT DATANASC FROM PESSOAFISICA');
          query.SQL.Add('WHERE IDPESSOA = '+_idpessoa);
          query.Open;
          if CalcIdade(query.fieldbyname('DATANASC').Value)>=65 then
             begin
             //////205224/15237
             if Copy(_mesreferencia,6,2)='13'then
                begin

                  query3.Close;
                  query3.SQL.Clear;

                  query3.SQL.Add('SELECT DECODE(SUM(VLRIDADE),NULL,-1,SUM(VLRIDADE))VLRIDADE FROM HSTDEDIDADEBITRIB ');
                  query3.SQL.Add('WHERE IDPESSOA = '+_idpessoa);
               //   query3.SQL.Add('AND IDLOTE = '+_idlote);
               //   query3.SQL.Add('AND SUBSTR(MESREFERENCIA,1,4) = '+copy(_mesreferencia,1,4));           // Andre Imakawa - SIG 80672
                  query3.SQL.Add('AND SUBSTR(MESCOBRANCA,1,4) = '+copy(dtmFolhaPrevia.MesCobranca,1,4));   // Andre Imakawa - SIG 80672

                  query3.Open;
                  if query3.fieldbyname('VLRIDADE').Value = -1 then
                    begin
                      query2.Close;
                      query2.SQL.Clear;
                      query2.SQL.Add('SELECT VLRIDOSO FROM HSTPARAMIRRF');
                      query2.SQL.Add('WHERE DATAINIVIGENCIA = (SELECT MAX(DATAINIVIGENCIA) FROM HSTPARAMIRRF)');
                      query2.Open;

                      result:=query2.fieldbyname('VLRIDOSO').Value;
                    end
                  else
                    begin
                      query2.Close;
                      query2.SQL.Clear;
                      query2.SQL.Add('SELECT VLRIDOSO FROM HSTPARAMIRRF');
                      query2.SQL.Add('WHERE DATAINIVIGENCIA = (SELECT MAX(DATAINIVIGENCIA) FROM HSTPARAMIRRF)');
                      query2.Open;

                      if (query2.fieldbyname('VLRIDOSO').Value-query3.fieldbyname('VLRIDADE').Value)>0 then
                        result:=query2.fieldbyname('VLRIDOSO').Value-query3.fieldbyname('VLRIDADE').Value
                      else
                        result:=0;
                    end;

                end
             else
                begin

                 qryIdoso.Filtered:=False;
                 qryIdoso.Filter:='';
                 qryIdoso.Filter:='idpessoa='+_idpessoa;
                 qryIdoso.Filtered:=True;
                 qryIdoso.Open;

                 if qryIdoso.IsEmpty then
                    begin
                     query2.Close;
                     query2.SQL.Clear;
                     query2.SQL.Add('SELECT VLRIDOSO FROM HSTPARAMIRRF');
                     query2.SQL.Add('WHERE DATAINIVIGENCIA = (SELECT MAX(DATAINIVIGENCIA) FROM HSTPARAMIRRF)');
                     query2.Open;

                     result:=query2.fieldbyname('VLRIDOSO').Value;
                    end
                 else
                    result:=qryIdoso.fieldbyname('SaldoIdoso').Value;
                end;

             end
          else
             result:=0;

          ////////////////////205224/15237
        finally
          query.Close;
          FreeAndNil(query);    //query.Destroy;  //edilaine WO19556

          query2.Close;
          FreeAndNil(query2);  //query2.Destroy;  //edilaine WO19556

          query3.Close;
          FreeAndNil(query3);  //query3.Destroy;  //edilaine WO19556
        end;
      end;

    procedure AtualizaSaldoIdade(_idpessoa,_mesreferencia,_idlote: string; _valor: Double);
      var
        valorIdoso:Double;
      begin
         valorIdoso:=0;
         qryIdoso.Filtered:=False;
         qryIdoso.Filter:='';
         qryIdoso.Filter:='idpessoa='+_idpessoa;
         qryIdoso.Filtered:=True;
         qryIdoso.Open;

         if qryIdoso.IsEmpty  then
         begin
            valorIdoso:=DeducaoIdade(_idpessoa,_mesreferencia,_idlote);
            qryIdoso.Open;
            qryIdoso.Insert;
            qryIdoso.fieldbyname('idpessoa').text:=_idpessoa;
            if _valor-valorIdoso<0 then
            begin
               if valorIdoso-_valor< 0 then
                  qryIdoso.fieldbyname('SaldoIdoso').Value:=0
               else
                  qryIdoso.fieldbyname('SaldoIdoso').Value:=valorIdoso-_valor
            end
            else
               qryIdoso.fieldbyname('SaldoIdoso').Value:=0;
            qryIdoso.Post;
         end
         else
         begin
            qryIdoso.Edit;
            if ((_valor-qryIdoso.fieldbyname('SaldoIdoso').AsFloat)<0) then
            begin
               if qryIdoso.fieldbyname('SaldoIdoso').AsFloat-_valor<0  then
                  qryIdoso.fieldbyname('SaldoIdoso').Value:=0
               else
                  qryIdoso.fieldbyname('SaldoIdoso').Value:=qryIdoso.fieldbyname('SaldoIdoso').AsFloat-_valor
            end
            else
               qryIdoso.fieldbyname('SaldoIdoso').Value:=0;
            qryIdoso.Post;
         end;
      end;

