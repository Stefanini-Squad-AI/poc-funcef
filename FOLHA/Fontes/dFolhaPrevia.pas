//MARCIO DENILSON SOL 151061 KINTANA 1105188
procedure TobjRecebedor.consultaValoresRubIRRF(pidLote, piIDPessoa,piIdTitular,piIDPlanoPrev, pIdResponsavel: Integer; var rValorProvento, rValorDesconto: Real);// SOL 250373 PPM 710990
var
  sSQL : String;
  Query: TwwQuery;
  i : Integer; //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
  objrub : tobjrubrica; //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
  sRubricas: string; //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
  sRubIN1343, sValorIN1343, sIdPlanoPrevIN1343, sIdBeneficioIN1343: String; //Bruno azevedo comentar
  lii : integer;  // Andre Imakawa - SIG 22994
begin
  try
    sSQL:= dtmFolhaPrevia.qryPrevia.sql.GetText;
    Query:= TwwQuery.Create(nil);          //edilaine WO19556
    Query.DataBaseName := 'BaseDados';

    Query.SQL.clear;
    rValorProvento:=0;
    rValorDesconto:=0;

    //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
    // SOL 250373 PPM 710990 reformulada a consulta
    //wo20725 leandro inicio
    if Self.iidtitular = objrub.iidpessoa then
    begin
      Query.SQL.Text := 'SELECT HST.FLGDEVOLUCAO, '+#13+
                      '       HST.IDPESSOA, '+#13+      //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
                      '       HST.IDPLANOPREV, '+#13+   //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
                      '       HST.IDBENEFICIO, '+#13+   //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
                      '       PD.IDPROVENTO, '+#13+     //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
                      '       HST.VALORPREV,    '+#13+
                      '       NVL(BTP.IDRESPONSAVEL,HST.IDPESSOA) RESPONSAVEL,   '+#13+
                      '       HST.FONTEPAGADORA '+#13+
                      '  FROM HSTBENEFBFCIARIO HST  '+#13+
                      ' INNER JOIN BENEFPLANPREV BPP  '+#13+
                      '    on (BPP.IDPLANOPREV = HST.IDPLANOPREV AND   '+#13+
                      '       BPP.IDBENEFICIO = HST.IDBENEFICIO)       '+#13+
                      ' INNER JOIN BENEFICIO B ON B.IDBENEFICIO = BPP.IDBENEFICIO '+#13+      //edilaine - SIG71773
                      ' INNER JOIN BFCIARIOTITPLAN BTP                 '+#13+
                      '    ON (BTP.IDPESSJUR = HST.IDPESSJUR AND BTP.IDPLANOPREV = HST.IDPLANOPREV AND   '+#13+
                      '       BTP.IDPLANOORIGEM = HST.IDPLANOORIGEM AND                                  '+#13+
                      '       BTP.IDPESSOA = HST.IDPESSOA AND BTP.SEQPROPOSTA = HST.SEQPROPOSTA AND      '+#13+
                      '       BTP.IDTITULAR = HST.IDTITULAR AND BTP.IDBENEFICIO = HST.IDBENEFICIO)       '+#13+
                      ' INNER JOIN PARTPREVPLAN PP ON  (PP.IDPESSOA = HST.IDTITULAR AND PP.IDPESSJUR = HST.IDPESSJUR)   '+#13+
                      ' INNER JOIN PROVDESC PD ON (PD.IDPROVENTO = BPP.IDRUBRICA)  '+#13+
                      // SOL 264879 PPM 1158258 //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
                    //  '  INNER JOIN PREVIA P             '+#13+
                    //  '    ON (HST.IDTITULAR = P.IDTITULAR AND HST.IDPESSOA = P.IDPESSOA AND   '+#13+
                    // '        HST.MES = P.MESCOBRANCA AND HST.MESREFERENCIA = P.MES AND       '+#13+
                    //  '        BPP.IDRUBRICA = P.IDRUBRICA)     '+#13+
                      // SOL 264879 PPM 1158258 //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587

                      ' WHERE (HST.DTEFETPGTO IS NULL)                             '+#13+
                      '   AND (HST.VLBENEFPGTO IS NULL)                            '+#13+
                      '   AND (HST.VALORPREV >= 0 OR NVL(BPP.FLGACEITAZERO, 0) = 1)   '+#13+
                      '   AND ((NVL(BPP.FLGREFERENCIA, 0) = 0) OR                     '+#13+
                      '       ((BPP.FLGREFERENCIA = 1) AND (BPP.FLGPAGAINSS = 1)))    '+#13+
                      '   AND ((HST.IDPLANOPREV = PP.IDPLANOPREV AND HST.IDPESSOA = HST.IDTITULAR) OR   '+#13+
                      '       (HST.IDPLANOORIGEM = PP.IDPLANOPREV AND      '+#13+
                      '       HST.IDPESSOA <> HST.IDTITULAR))              '+#13+
                      '   AND (PD.FLGIRRF = 1)                             '+#13+
                      '   AND (HST.FLGENVIADO = 0)                         '+#13+
                      //edilaine - SIG71773 - inicio
                      {incluir os lançamentos de benefícios portados cuja opção de IR seja Regressivo}
  //                    '   AND (FLGTIPOREGISTRO = 0 OR FLGTIPOREGISTRO = 3) AND TIPOOPCAOIR = 2       '+#13+       //Everson TIBERO
  //                    '   AND (HST.FLGTIPOREGISTRO = 0 OR HST.FLGTIPOREGISTRO = 3) AND TIPOOPCAOIR = 2       '+#13+ //Everson TIBERO
                      '   AND (HST.FLGTIPOREGISTRO = 0 OR HST.FLGTIPOREGISTRO = 3) '+#13+

