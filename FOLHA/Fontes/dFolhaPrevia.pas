                  else
                    sSQL := 'IDREFREINF = '+ QuotedStr(sAuxTipoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(objrub.ifontepagadora);


                qryTipoREINF.Filtered := False;
                qryTipoREINF.Filter := sSQL;
                qryTipoREINF.Filtered := True;

                {qryTipoREINF.Filtered := False;
                qryTipoREINF.Filter := 'IDREFREINF = ' + QuotedStr(sAuxTipoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(objrub.ifontepagadora) + ' AND IDPLANOPREVCONTABIL = ' + IntToStr(objrub.iidplanocontabil);
                qryTipoREINF.Filtered := True;
                }//edilaine - WO4657 : fim

                if not (qryTipoREINF.IsEmpty) then
                begin
                  if InsereBasePagamentoReinf(qryTipoREINF.FieldByName('IDTIPOREINF').AsInteger, (lrsinal * rValorRubrica), 1, pCodNaturezaReinf, objrub.iIdProcJud) then
                  begin
                    lbErro := True;
                  end;
                end
                else
                begin
                  // Falta Parametrização REINF // sAuxTipoREINF
                end;

              end;
            end;

          end;
        end
        else
        begin
          // Falta Parametrização REINF // pGrupoREINF
        end;

      except
        lbErro := True;
      end;
    finally
      Result := lbErro;
    end
  end;

  function ProcessaRubricasREINFGrupoRubrica(qryTipoREINF: twwquery; pCodNaturezaReinf: integer): Boolean;
  var
    lii, lii_Tipo, liiPlano: Integer;
    objrub: tobjrubrica;
    lrsinal: Real;
    lbErro: boolean;
    sAuxTipoREINF: string;
    iTipoRegistro, iFontePagadora, iPlanoPrev, iPlanoPrevContab: integer;
    lVlGravar: real;
    queryReinfGrupo, queryGrupoRubrica: TwwQuery;
    arVlINSS, arVlRePlanNaoSald, arVlRePlanSald, arVlReb, arVlNP: array of Real;
  begin
    lbErro := False;
    try
      queryReinfGrupo := TwwQuery.Create(nil);                  //edilaine WO19556
      queryGrupoRubrica   := TwwQuery.Create(nil);              //edilaine WO19556
      queryReinfGrupo.DataBaseName := 'BaseDados';
      queryGrupoRubrica.DataBaseName := 'BaseDados';

      try
        queryReinfGrupo.close;
        queryReinfGrupo.sql.Clear;

        sSQL := ' SELECT TR.IDREFREINF, TR.TIPOREGISTRO FROM CM.TIPOREINF TR '        + #13#10 +
                ' WHERE TR.FLGATIVO = 1 '                                             + #13#10 +
                ' AND EXISTS(SELECT 1 FROM CM.TIPOREINF_GRUPORUBRICA TRG '            + #13#10 +
                ' WHERE TR.IDREFREINF = TRG.IDREFREINF AND TRG.FLGATIVO = 1  '        + #13#10 +
                '   AND TRG.ROTINA_PREVIA =  ''ProcessaRubricasREINFGrupoRubrica'' )' + #13#10 +
                ' GROUP BY TR.IDREFREINF, TR.TIPOREGISTRO '                           + #13#10 +
                ' ORDER BY TR.IDREFREINF ';


        queryReinfGrupo.SQL.Add(sSQL);
        queryReinfGrupo.open;

        queryGrupoRubrica.close;
        queryGrupoRubrica.sql.Clear;

        sSQL := ' SELECT TRG.IDREFREINF, TRG.IDGRUPORUBRICA FROM CM.TIPOREINF_GRUPORUBRICA TRG WHERE TRG.FLGATIVO = 1';

        queryGrupoRubrica.SQL.Add(sSQL);
        queryGrupoRubrica.open;

        if (not (queryReinfGrupo.IsEmpty)) and (not(queryGrupoRubrica.IsEmpty)) then
        begin

          for lii_Tipo := 0 to queryReinfGrupo.RecordCount - 1 do
          begin
            SetLength(arVlRePlanNaoSald,4);
            SetLength(arVlRePlanSald,4);
            SetLength(arVlReb,4);
            SetLength(arVlINSS,4);
            SetLength(arVlNP,4);


            sAuxTipoREINF := queryReinfGrupo.FieldByName('IDREFREINF').AsString;
            iTipoRegistro := queryReinfGrupo.FieldByName('TIPOREGISTRO').Asinteger;


            for lii := 0 to lstRubricas.count - 1 do
            begin
              objrub := (lstRubricas.objects[lii] as tobjrubrica);

              if iTipoRegistro = 0 then
              begin
                if (copy(objrub.smes, 6, 2) = '13') then
                  continue;
              end
              else
              begin
                if (copy(objrub.smes, 6, 2) <> '13') then
                  continue;
              end;

              if (objrub.iFlgGravou = 1) and
                 (objrub.iCodNaturezaReinf = pCodNaturezaReinf) and
                 (objrub.rvalorprovento > 0) and
                 (queryGrupoRubrica.locate('IDREFREINF;IDGRUPORUBRICA', VarArrayOf([sAuxTipoREINF, objrub.iIdGrupoRubrica]), [])) then
              begin

                if (objrub.iflgdesconto = 1) or (objrub.iflgdesconto = 2) then
                  lrsinal := -1
                else
                  lrsinal := 1;

                if objrub.ifontepagadora = 2 then
                begin
                  arVlINSS[iTipoRegistro] := arVlINSS[iTipoRegistro] + (lrsinal * objrub.rvalorprovento);
                end
                else
                begin
                  case objrub.iidplanocontabil of
                    2:  begin
                          arVlRePlanNaoSald[iTipoRegistro] := arVlRePlanNaoSald[iTipoRegistro] + (lrsinal * objrub.rvalorprovento)
                        end;
                    28: begin
                          arVlRePlanSald[iTipoRegistro] := arVlRePlanSald[iTipoRegistro] + (lrsinal * objrub.rvalorprovento);
                        end;
                    66: begin
                          arVlReb[iTipoRegistro] := arVlReb[iTipoRegistro] + (lrsinal * objrub.rvalorprovento);
                        end;
                    74: begin
                          arVlNP[iTipoRegistro] := arVlNP[iTipoRegistro] + (lrsinal * objrub.rvalorprovento);
                        end;
                  end;
                end;

              end;

            end;

            for liiPlano := 0 to 4 do
            begin
              case liiPlano of
                // FUNCEF - REPLAN NAO SALDADO
                0 : begin
                      lVlGravar   :=  arVlRePlanNaoSald[iTipoRegistro];
                      iFontePagadora := 1;
                      iPlanoPrev := 2;
                      iPlanoPrevContab := iPlanoPrev;
                    end;
                // FUNCEF - REPLAN SALDADO
                1 : begin
                      lVlGravar   :=  arVlRePlanSald[iTipoRegistro];
                      iFontePagadora := 1;
                      iPlanoPrev := 2;
                      iPlanoPrevContab := 28;
                    end;
                // FUNCEF - REB
                2 : begin
                      lVlGravar   :=  arVlReb[iTipoRegistro];
                      iFontePagadora := 1;
                      iPlanoPrev := 66;
                      iPlanoPrevContab := iPlanoPrev;
                    end;
                // FUNCEF - NOVO PLANO
                3 : begin
                      lVlGravar   :=  arVlNP[iTipoRegistro];
                      iFontePagadora := 1;
                      iPlanoPrev := 74;
                      iPlanoPrevContab := iPlanoPrev;
                    end;
                // INSS
                4 : begin
                      lVlGravar   :=  arVlINSS[iTipoRegistro];
                      iFontePagadora := 2;
                    end;

              end;

              if lVlGravar <> 0 then
                if ProcessaRubricasREINF(qryTipoREINF, sAuxTipoREINF, iFontePagadora, iPlanoPrevContab, lVlGravar, 1, pCodNaturezaReinf) then
                  begin
                    lbErro := True;
                  end;

            end;


            SetLength(arVlRePlanNaoSald,0);
            SetLength(arVlRePlanSald,0);
            SetLength(arVlReb,0);
            SetLength(arVlINSS,0);
            SetLength(arVlNP,0);

            queryReinfGrupo.next;
          end;

        end;

      except
        lbErro := True;
      end;
    finally
      SetLength(arVlRePlanNaoSald,0);
      SetLength(arVlRePlanSald,0);
      SetLength(arVlReb,0);
      SetLength(arVlINSS,0);
      SetLength(arVlNP,0);
      FreeAndNil(arVlRePlanNaoSald);
      FreeAndNil(arVlRePlanSald);
      FreeAndNil(arVlReb);
      FreeAndNil(arVlNP);
      FreeAndNil(arVlINSS);
      FreeAndNil(queryReinfGrupo);// Andre Imakawa - SIG 135627
      FreeAndNil(queryGrupoRubrica);// Andre Imakawa - SIG 135627
      Result := lbErro;
    end
  end;

  function ProcessaRubricasREINFRENDIMENTOS(qryTipoREINF: twwquery; pCodNaturezaReinf: integer;
                                           var aVlIdade, aVlIdade13, aVlDepen, aVlDepen13: real): Boolean;
  var
