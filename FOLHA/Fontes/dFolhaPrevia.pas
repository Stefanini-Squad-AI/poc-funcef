       //   query.SQL.Add('WHERE IDPLANOPREV IN (74,2)');
          query.SQL.Add('WHERE IDPLANOPREV= '+_idplanoprev);
          query.SQL.Add('AND IDBENEFICIO = '+_idbeneficio);
          query.open;

          if  query.fieldbyname('IDRUBRICA').text = _idrubrica then
              result:=query.fieldbyname('IDRUBBIT').text
          else
