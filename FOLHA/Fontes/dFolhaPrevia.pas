procedure TdtmFolhaPrevia.BuscaParametroRubricaIRTotal;
var
  sSQL1, sSQL2, sSQL3, sSQL4, sSQL5: string;
  Query:TwwQuery;
begin
  // verifica se as rubricas estão parametrizada
  sSQL1  := 'SELECT NOMEPARAM, NVL(VALORPARAM,0) AS VALORPARAM '+
           '  FROM PARAMFOLHA '+
           ' WHERE NOMEPARAM IN (''RUBRICAIRTOTALCOMP'') ';

  sSQL2  := 'SELECT NOMEPARAM, NVL(VALORPARAM,0) AS VALORPARAM '+
           '  FROM PARAMFOLHA '+
           ' WHERE NOMEPARAM IN (''RUBRICAIRTOTALCOMPAB'') ';

  sSQL3  := 'SELECT NOMEPARAM, NVL(VALORPARAM,0) AS VALORPARAM '+
           '  FROM PARAMFOLHA '+
           ' WHERE NOMEPARAM IN (''RUBRICAIRINFOACAO'') ';

  sSQL4  := 'SELECT NOMEPARAM, NVL(VALORPARAM,0) AS VALORPARAM '+
           '  FROM PARAMFOLHA '+
           ' WHERE NOMEPARAM IN (''RUBRICAIRINFOACAOAB'') ';

  sSQL5  := 'SELECT NOMEPARAM, NVL(VALORPARAM,0) AS VALORPARAM '+
           '  FROM PARAMFOLHA '+
           ' WHERE NOMEPARAM IN (''REGRACAOJUDGANHA'') ';


  try
    Query := TwwQuery.Create(nil);    //edilaine WO19556
    Query.DataBaseName := 'BaseDados';

    Query.Close;
    Query.SQL.clear;
    Query.SQL.Add(sSQL1);
    Query.Open;

    if not Query.IsEmpty then
      iRubricaIRCompl := StrToInt(Query.FieldByName('VALORPARAM').AsString)
    else
      iRubricaIRCompl := -1;

    Query.Close;
    Query.SQL.clear;
    Query.SQL.Add(sSQL2);
    Query.Open;

    if not Query.IsEmpty then
      iRubricaIRCompl13 := StrToInt(Query.FieldByName('VALORPARAM').AsString)
    else
      iRubricaIRCompl13 := -1;

    Query.Close;
    Query.SQL.clear;
    Query.SQL.Add(sSQL3);
    Query.Open;

    if not Query.IsEmpty then
      iRubricaIRInfoAcaoGanha := StrToInt(Query.FieldByName('VALORPARAM').AsString)
    else
      iRubricaIRInfoAcaoGanha := -1;

    Query.Close;
    Query.SQL.clear;
    Query.SQL.Add(sSQL4);
    Query.Open;

    if not Query.IsEmpty then
      iRubricaIRInfoAcaoGanha13 := StrToInt(Query.FieldByName('VALORPARAM').AsString)
    else
      iRubricaIRInfoAcaoGanha13 := -1;

    Query.Close;
    Query.SQL.clear;
    Query.SQL.Add(sSQL5);
    Query.Open;

    if not Query.IsEmpty then
      iRegraAcaoGanhaEqua := StrToInt(Query.FieldByName('VALORPARAM').AsString)
    else
      iRegraAcaoGanhaEqua := -1;


  finally
    Query.close;
    FreeAndNil(Query);      //Query.free;   //edilaine WO19556
  end;

end;
