//procedure TobjRecebedor.CalculaLancaIRNormal(              //edilaine SIG70584/125782
function TobjRecebedor.CalculaLancaIRNormal(                 //edilaine SIG70584/125782
  aiTipoBase, aiFontePagadora, aiRubrica: integer;
  ascodirrfdarf: string; aiidmotivo: integer;
  arproventoirrf, ardescontoirrf, arBaseIrMes, arValorIRMes: real;
  var arSaldoComp: real; asNomeBase: string; abMoraBrasil: boolean;
  aiidplanoprev, aiidplanocontabil, aiidplanoorigem: integer
  ;var arVlIRRF: real // Andre Imakawa - SIG 99651
  ;var aPercentual: Double // Andre Imakawa - SIG 99651
  ;abSoCalcula : boolean = false        //edilaine SIG70584/125782
  ;abViaAcaoJudicial : boolean = false  //edilaine SIG136670
  ) : double;                           //edilaine SIG70584/125782
var dbaseIRRF, dpercentual: double;
    rValorIRRF: real;
    rIRRFCompensado: real;
    lstipodesc: string;
    lsmesref: string;
    lsdataref: string;
    iAno, iMes, iDia: word;
    participanteOptaIRREgressivo: Boolean;
    auxSql: string;
    rVlrDescSimplIrrf, rValorDescLegal : double;    //edilaine SIG136670
    aiRubricaSimplif : integer;                     //edilaine SIG136670
    bAplicaDescSimplif : boolean;                   //edilaine SIG136670
    rVlrTribut  : double;                           //edilaine WO29025
    rVlrReducao : double;                           //edilaine WO29025
begin
  //dbaseIRRF:=arproventoirrf-ardescontoirrf+arBaseIRMes;
  if abMoraBrasil then // SOL 225050 Kintana 2058832
     dbaseIRRF:=arproventoirrf-ardescontoirrf+arBaseIRMes // SOL 225050 Kintana 2058832
  else  // SOL 225050 Kintana 2058832
     dbaseIRRF:=arproventoirrf+arBaseIRMes; // SOL 225050 Kintana 2058832

  lsdataref:=FormatDateTime('dd/mm/yyyy', dtmFolhaPrevia.DataPagamento);
  if aiTipoBase = 1 then {IR ABONO}
  begin
    DecodeDate(dtmFolhaPrevia.DataPagamento, iAno, iMes, iDia);
    lsdataref:=FormatDateTime('dd/mm/yyyy', diasuteis.UltDiaMes(iAno, iMes));
  end;

  if (aiTipoBase = 7) and (ascodirrfdarf = '3223') and (abMoraBrasil) then  // Andre Imakawa - SIG 48178
  begin
    rValorIRRF := arproventoirrf * 0.15;
    aPercentual := 15; //Andre Imakawa - SIG 99651
  end
  //edilaine WO32047 : inicio
  //mora no exterior e o cálculo sera feito usando tabela progressiva
  else if (not abMoraBrasil) and (SistemaFolha.FlgNovoIrExterior = 1) then
  begin

    rValorIRRF := SistemaFolha.objIrrf.CalculaIRRF_Ext(dbaseirrf,
                                                       FormatDateTime('dd/mm/yyyy', dtmFolhaPrevia.UltDiaMesPag),
                                                       0, dPercentual, rVlrReducao);
    aPercentual := dPercentual;

    if rValorIRRF-arValorIRMes > 0 then
       rValorIRRF:=rValorIRRF-arValorIRMes;
  end
  //edilaine WO32047 : fim
  else
    if (abMoraBrasil) then
    begin

      //edilane SIG136670 : inicio
      rValorDescLegal := BuscaValorTotalRubricas(aiFontePagadora);

      bAplicaDescSimplif := (SistemaFolha.FlgDescSimplesIRRF = 1) and
                            (not abViaAcaoJudicial) and
                            (dtmFolhaPrevia.qryPrevia.FieldByName('FLGNAOAPLICADEDSIMP_IRRF').AsString <> '1');
      //edilane SIG136670 : fim


      //WO29025 leandro inicio
      rVlrTribut  := arproventoirrf;  //dbaseirrf + rValorDescLegal;
      rVlrReducao := 0;

      rValorIRRF:=SistemaFolha.objIrrf.CalculaIRRF(
          inumdepirrf, dtdatanasc, dbaseirrf, dPercentual,
          rVlrReducao,           //edilaine WO29025
          FormatDateTime('dd/mm/yyyy', dtmFolhaPrevia.UltDiaMesPag), 0,
          rValorDescLegal,       //edilane SIG136670
          bAplicaDescSimplif,    //edilane SIG136670
          rVlrTribut             //edilaine WO29025
          );

      if aiFontePagadora = 1 then
      begin
        if aiTipoBase = 1 then {IR ABONO}
        begin
          rValorReducaoIR13  := rVlrReducao;
          rValorTributavel13 := rVlrTribut;
        end
        else
        begin
          rValorReducaoIR  := rVlrReducao;
          rValorTributavel := rVlrTribut;
        end;
      end
      else
      begin
        if aiTipoBase = 1 then {IR ABONO}
        begin
           rValorReducaoINSSIR13  := rVlrReducao;
           rValorTributavelINSS13 := rVlrTribut;
        end
        else
        begin
           rValorReducaoINSSIR  := rVlrReducao;
           rValorTributavelINSS := rVlrTribut;
        end;
      end;
      //WO29025 leandro fim

      aPercentual := dPercentual; //Andre Imakawa - SIG 99651

      if rValorIRRF-arValorIRMes > 0 then
        rValorIRRF:=rValorIRRF-arValorIRMes;
    end
    else
    begin
      //mora no exterior e o cálculo deve ser feito usando % fixo
      rValorIRRF:=SistemaFolha.objIrrf.CalculaIRRF_Ext(dbaseirrf,
         FormatDateTime('dd/mm/yyyy', dtmFolhaPrevia.UltDiaMesPag));

      if (rValorIRRF > 0) and (dbaseirrf > 0) then  //Andre Imakawa - SIG 99651
        aPercentual :=  rValorIRRF / dbaseirrf;     //Andre Imakawa - SIG 99651

      if rValorIRRF-arValorIRMes > 0 then
        rValorIRRF:=rValorIRRF-arValorIRMes;
    end;


  if aiTipoBase = 1 then {IR ABONO}
  begin
    lsMesRef:=dtmfolhaprevia.MesAbono;
  end
  else {IR NORMAL}
  begin
    lsMesRef:=dtmfolhaprevia.MesCobranca;
  end;

  dtmFolhaPrevia.MesReferencia := lsMesRef;    //William Santana SOL 197565 KTN 1905420

  //Andre Imakawa - WO7973 - Inicio
  //edilaine SIG136670 : inicio
  if (SistemaFolha.objIrrf.VlrDeduzidoIRSimplif > 0) and (bAplicaDescSimplif) then
  begin
    if aiFontePagadora = 1 then  {Funcef}
    begin
      if aiTipoBase = 1 then {IR ABONO}
         aiRubricaSimplif := SistemaFolha.IDRubricaIrDescSimplesAbn
      else
         aiRubricaSimplif := SistemaFolha.IDRubricaIrDescSimples;
    end
    else  {INSS}
    begin
      if aiTipoBase = 1 then {IR ABONO}
         aiRubricaSimplif := SistemaFolha.IDRubIrDescSimplesInssAbn
      else
         aiRubricaSimplif := SistemaFolha.IDRubIrDescSimplesInss;
    end;

    lstipodesc := dtmFolhaPrevia.BuscaDadosRubrica(self, aiRubricaSimplif, 'K');

    rVlrDescSimplIrrf := SistemaFolha.objIrrf.VlrDeduzidoIRSimplif;

    if (lstipodesc <> '') and (rVlrDescSimplIrrf > 0) then
    begin
      if not InsereRubrica(
                  iidresponsavel,                                       //beneficiario
                  0,                                                    //favorecido da rubrica
                  0,                                                    //beneficio associado : pega beneficio base
                  aiRubricaSimplif,                                     //codigo do provento
                  dtmFolhaPrevia.qryProvento.FieldByName('flgdesconto').asinteger,    //flag de desconto
                  dtmFolhaPrevia.qryProvento.FieldByName('flgespecial').asinteger,    //flag especial
                  aiidmotivo,                                           //motivo do desconto
                  1,                                                    //seqrubrica = 1
                  icodmoedabase,                                        //codigo da moeda
                  0,                                                    //regra de calculo
                  aiFontePagadora,                                      //fonte pagadora : pega fonte pagadora base
                  dtmFolhaPrevia.qryProvento.FieldByName('flgirrf').asinteger, //indica se rubrica entra na base de IR
                  dtmFolhaPrevia.qryProvento.FieldByName('FLGSALFAMILIA').asinteger, //indica se rubrica entra na composição do calculo do salario familia
                  0,                                                   // Indica se o beneficio é provisorio
                  Sistema.Idmodulo,                                    //sistema de origem da rubrica
                  0,                                                   //flgSRB
                  1,                                                   //flgOK
                  0,                                                   //flgPA
                  dtmFolhaPrevia.qryProvento.FieldByName('flgdescpensao').asinteger, //flgBasePA
                  0,                                                   //flgconcessao
                  0,                                                   //flgindividual
                  dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalpart').asinteger,//compõe sal. participacao
                  dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalbenef').asinteger,//compõe sal. benefício
                  dtmFolhaPrevia.qryProvento.FieldByName('numprioridade').asinteger, //prioridade de desconto
                  iidpessjur,                                           //id empresa p/ contabilização
                  dtmFolhaPrevia.qryProvento.FieldByName('tipobasedesconto').asinteger, //tipo de base de desconto {abono,supl,inss,resgate}
                  0,                                                   //código do alterador
                  0,                                                   //id do plano de contas
                  inumeroprocesso,
                  snumprocinss,
                  lstipodesc,                                          //flg do tipo de desconto 'C', 'P', 'B', 'Y'
                  dbaseirrf,                                           //valor informativo associado a rubrica (base de calculo do IR)
                  rVlrDescSimplIrrf,                                   //valor da rubrica
                  0,                                                   //valor base de calculo para a regra
                  '***',                                               //referencia
                  lsMesRef,                                            //mês de referência
                  //BRUNO AZEVEDO SOL 155182 Kintana 1228739
                  //dtmFolhaPrevia.qryProvento.FieldByName('CODIRRFDARF').AsString, // SOL 248327 PPM 668845
                  ascodirrfdarf,                                       //código IRRF na SRF para o DARF igual ao provento base // SOL 248327 PPM 668845
                  //BRUNO AZEVEDO SOL 155182 Kintana 1228739
                  '',                                                  //indice recebimento 'R'ou pagamento 'P'
                  '',                                                  //código do tipo de recebimento ou desembolso
                  '',                                                  //código do centro de custo
                  '',                                                  //código do centro de responsabilidade
                  '',                                                  //código da unidade de negócio
                  '',                                                  //conta contábil associada
                  '',                                                  //data inicio da rubrica
                  '',                                                  //data final da rubrica
                  dtmFolhaPrevia.qryProvento.FieldByName('descparcial').asinteger,    //indica se permite desconto parcial
                  0,                                                   //usa no abono anual
                  3,                                                   //origem da rubrica
                  0,                                                   //lote original do desconto
                  0,                                                   // RUBRICA CONSIGNATARIO
                  false, // ACEITA ZERO
                  '',     // DATA PREVISTA DE PAGAMENTO - PEND 10826
                  dtmFolhaPrevia.qryProvento.FieldByName('CODPROVDESC').asstring, //PARA GRAVAR CODPROVDESC NA PREVIA E EM SQL PARA REGRAS
                  aiidplanoprev, //PLANO PREVIDENCIARIO ATRIBUIDO A BASE DE IR
                  0, //ATRIBUI ZERO PARA OBTER O IDPLANOORIGEM GLOBAL
                  aiidplanocontabil, //PLANO CONTABIL ATRIBUIDO A BASE DE IR
                  0, //RUBRICA CUJO SEQUENCIAL INTERNO É IRRELEVANTE PARA RETORNO
                  dtmFolhaPrevia.qryProvento.FieldByName('FLGRUBLEGAL').asinteger,  //
                  dtmFolhaPrevia.qryprevia.fieldbyname('MESCOMPREEM').asstring      // SOL 140042 Kintana 900220
                  ,0
                  ,''
                  ,dtmFolhaPrevia.qryProvento.FieldByName('FLGMARGEM').asinteger         //Renato Visoni SOL 131523 KINTANA 750021
                  ,0
                  ,dtmFolhaPrevia.qryProvento.FieldByName('FLGREPROGRAMAR').asInteger    //Marcio Denilson - SOL 136569 - KINTANA 820997
                  ,false, 0,dtmFolhaPrevia.qryProvento.FieldByName('FLGEXCLUICONTRIBPA').asInteger    //Osni Cavalcante - SIG 58950.59454
                  ) then
          dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de Dedução de IRRF '+
              dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring,
              self)
      else
         if objrubinserida <> nil then // FEFX - SIG43291
         begin
           VerificaIrrfDarfRegimeRegressivo(objrubinserida); // FEFX - SIG43291
         end;
    end
    else if (lstipodesc = '') then
      dtmFolhaPrevia.ExibeMensagem('Rubrica não encontrada (Dedução Simplificada de IRRF): '+
        inttostr(aiRubricaSimplif),
        self);
  end;
  //edilaine SIG136670 : fim
  //Andre Imakawa - WO7973 - Fim

  //MOSTRA VALOR DE IR ABAIXO DO LIMITE
  if ((aiTipoBase = 0) or
      ((aiTipoBase = 1) and (prmFLGVLIRVLMINABONO = 1))) and
     (rValorIRRF <= prmVlMinIRFF) and
     (rValorIRRF > 0) then
  begin
