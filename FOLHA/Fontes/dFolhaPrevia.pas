                if liFontePagadora = 2 then
                  qryTipoREINF.Filter := 'IDREFREINF = ' + QuotedStr(sAuxTipoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(liFontePagadora)
                else
                  qryTipoREINF.Filter := 'IDREFREINF = ' + QuotedStr(sAuxTipoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(liFontePagadora) + ' AND IDPLANOPREVCONTABIL = ' + IntToStr(liPlanoContabil);
