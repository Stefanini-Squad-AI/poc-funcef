                          objRubInserida.iprazo:=
                            dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('parcelas').asinteger;
                        end;
                      end;
                      if dtmFolhaPrevia.qryRubricaIndividual.FieldByName('flgpensaoalim').asinteger = 1 then
                      begin
                        objRubInserida.bflgcpmf:=
                          dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGCALCULACPMF').asinteger = 1;
                        // INCLUI processo do INSS para PA
                        objRubInserida.snumprocinssconsig:=
                          //BRUNO AZEVEDO SOL 135233 KINTANA 806340
                          sNumProcINSS;
                          //dtmFolhaPrevia.qryRubricaIndividual.FieldByName('NUMPROCINSS').asstring;
                          //BRUNO AZEVEDO SOL 135233 KINTANA 806340
                      end
                      else
                      begin
                        if dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('FLGCONTROLASALDO').asinteger = 1 then
                        begin
                          objRubInserida.rsaldopermitido:=
                            dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('VLRSALDOINICIAL').asfloat-
                            dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('VLRTOTALPROC').asfloat;
                          if objRubInserida.rsaldopermitido < 0 then
                            objRubInserida.rsaldopermitido:=0;
                        end;
                      end;
                      //ESTA BOOLEANA INDICA QUE SE DEVE CONSIDERAR OS VALORES ANTERIORES À DATA INÍCIO
                      // DA PA COMO O SISTEMA FAZ ATÉ ESTA DATA.
                      //QUANDO FALSO INDICA QUE NÃO SE COMPUTARÁ OS VALORES ANTERIORES A DATA INÍCIO DA PA.
                      objRubInserida.bretraocaorindiv:=
                        dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('FLGRETROACAO').asinteger=1;
                    end;
                  end;
                  except
                  on e:exception do
                    begin
                    dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica da RubricaIndiv '+
                      dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubrica').asstring+'-'+e.message,
                      self);
                    end;
                  end;
             end; }
        // final SOL 213511 - KTN 2040087 inserir rubrica de abono
        //**************************************************************************************
        //SOL 259058 PPM  997777

      end; //if lbinsere then
    end;
    dtmFolhaPrevia.qryNumProcINSS.close; // SOL 242740 PPM 575822
  end;

  //ABRIR RUBRICA DE CONTRIBUICAO QUANDO AC JUD GANHA NA PREVIA AO INVES DE ABRIR TMPDESC NO PREPARO
  procedure InsereTmpdesc(arvalor: real; aiFlgIsentoAcaoGanha : integer = -1);
   var lstipodesc : string;
       iIdBeneficio : Integer;
	   lNumProcINSS : String;            //edilaine SIG56256
       iIdPlanoPrevContabil  : Integer; // Andre Imakawa - SIG 24398
  begin
    lstipodesc:=dtmFolhaPrevia.BuscaDadosRubrica(self, iIdRubrica, 'P');
    if lstipodesc <> '' then
    begin
      try
        if (dtmFolhaPrevia.qryTmpDesc.FieldByName('FLGTIPODESC').AsString = 'D') Or
           (dtmFolhaPrevia.qryTmpDesc.FieldByName('FLGTIPODESC').AsString = 'J') then //Helio - SOL Nº 252332 PPM Nº 761404 //RNG95
           iIdBeneficio := dtmFolhaPrevia.qryTmpDesc.FieldByName('IDDESCONTO').asinteger
        else
           iIdBeneficio := 0;

        //edilaine SIG56256 : inicio
        if (dtmFolhaPrevia.qryTmpDesc.FieldByName('FLGTIPODESC').AsString = 'D') then
        begin
            dtmFolhaPrevia.qryAux.close;
            dtmFolhaPrevia.qryAux.SQL.Clear;
            dtmFolhaPrevia.qryAux.SQL.Add(
                'SELECT C.NUMPROCINSS        '+
                '  FROM HSTDIVIDABENEFICIO H '+
                '  JOIN CONTROLEDIVIDABENEFICIO C '+
                '    ON C.IDCONTROLEDIVIDABENEFICIO = H.IDCONTROLEDIVIDABENEFICIO '+
                ' WHERE H.IDHSTORICODIVIDABENEFICIO = '+dtmFolhaPrevia.qryTmpDesc.FieldByName('REFERENCIA').AsString);
            dtmFolhaPrevia.qryAux.open;
            if (not dtmFolhaPrevia.qryAux.eof) and (dtmFolhaPrevia.qryAux.Fields[0].AsString <> '') then
               lNumProcINSS := dtmFolhaPrevia.qryAux.Fields[0].AsString
            else
               lNumProcINSS := sNumProcINSS;
        end
        else
           lNumProcINSS := sNumProcINSS;
        //edilaine SIG56256 : fim

        // Andre Imakawa - SIG 24398 - Inicio
        iIdPlanoPrevContabil := dtmFolhaPrevia.qryTmpDesc.FieldByName('IDPLANPREVCONTAB').asinteger;
        if (dtmFolhaPrevia.qryTmpDesc.FieldByName('FLGTIPODESC').AsString = 'P') then
        begin
            dtmFolhaPrevia.qryAux.close;
            dtmFolhaPrevia.qryAux.SQL.Clear;
            dtmFolhaPrevia.qryAux.SQL.Add(

                            'SELECT B.IDPLANPREVCONTAB, B.IDBENEFICIO' + #13#10 +       //edilaine - SIG69744  // Andre Imakawa - TIBERO
                            '     FROM BENEFXTAXA BT' + #13#10 +
                            '    INNER JOIN HSTBENEFBFCIARIO H' + #13#10 +
                            '       ON (H.IDBENEFICIO = BT.IDBENEFICIO )' + #13#10 +
                            '    INNER JOIN BENEFBFCIARIO B' + #13#10 +
                            '       ON (B.IDPLANOPREV = H.IDPLANOPREV AND B.IDTITULAR = H.IDTITULAR AND' + #13#10 +
                            '          B.IDPESSOA = H.IDPESSOA AND B.IDBENEFICIO = H.IDBENEFICIO AND B.SEQPROPOSTA = H.SEQPROPOSTA AND' + #13#10 +
                            '          B.SEQPROPOSTA = H.SEQPROPOSTA AND B.IDPLANOORIGEM = H.IDPLANOORIGEM AND' + #13#10 +
                            '          B.FONTEPAGADORA = H.FONTEPAGADORA  AND   B.IDPESSJUR = H.IDPESSJUR AND  B.NUMEROPROCESSO = H.NUMEROPROCESSO' + #13#10 +
                            '          )' + #13#10 +
                            '    WHERE B.IDPLANOPREV = '+dtmFolhaPrevia.qryTmpDesc.FieldByName('IDPLANOPREV').AsString+ #13#10 +
                            '      AND H.MES = '+QuotedStr(dtmFolhaPrevia.MesCobranca)+ #13#10 +
                            '      AND H.IDTITULAR = '+dtmFolhaPrevia.qryTmpDesc.parambyname('pIdTitular').AsString + #13#10 +
                            '      AND H.IDPESSOA = '+dtmFolhaPrevia.qryTmpDesc.FieldByName('idpessoa').AsString + #13#10 +
                            '      AND BT.IDCONTRIBUICAO IN ('+dtmFolhaPrevia.qryTmpDesc.FieldByName('IDDESCONTO').AsString+')' );
            dtmFolhaPrevia.qryAux.open;
            iIdPlanoPrevContabil := dtmFolhaPrevia.qryAux.FieldByName('IDPLANPREVCONTAB').asinteger ;
            iIdBeneficio := dtmFolhaPrevia.qryAux.FieldByName('IDBENEFICIO').asinteger;    //edilaine - SIG69744
            dtmFolhaPrevia.qryAux.close;
        end;
        // Andre Imakawa - SIG 24398 - Fim

        if not InsereRubrica(
            dtmFolhaPrevia.qryTmpDesc.FieldByName('idpessoa').asinteger,        //beneficiario
            dtmFolhaPrevia.qryTmpDesc.FieldByName('idfavorecido').asinteger,    //favorecido da rubrica
            iIdBeneficio,                                                       //beneficio associado : // SOL 248566 PPM 669712 pega o idbeneficio da tmpdesc
            iIdRubrica,                                                         //codigo do provento
            dtmFolhaPrevia.qryProvento.FieldByName('flgdesconto').asinteger,     //flag de desconto
            dtmFolhaPrevia.qryProvento.FieldByName('flgespecial').asinteger,    //flag especial
            liidmotivo,        //motivo do desconto
            dtmFolhaPrevia.qryTmpDesc.FieldByName('ordem').asfloat, //
            icodmoedabase,                                       //codigo da moeda
            0,     //regra de calculo
            dtmFolhaPrevia.qryProvento.FieldByName('CODFONTEPAGADORA').asinteger, //fonte pagadora
            dtmFolhaPrevia.qryProvento.FieldByName('flgirrf').asinteger,         //indica se rubrica entra na base de IR
            dtmFolhaPrevia.qryProvento.FieldByName('FLGSALFAMILIA').asinteger,   //indica se rubrica entra no calculo do salario familia
            0,                                                   // Indica se o beneficio é provisorio
            dtmFolhaPrevia.qryTmpDesc.FieldByName('idmodulo').asinteger,        //sistema de origem da rubrica
            0,                                                   //flgSRB
            1,                                                   //flgOK
            0,                                                   //flgPA
            dtmFolhaPrevia.qryProvento.FieldByName('flgdescpensao').asinteger, //flgBasePA
            0,                                                   //flgconcessao
            0,                                                   //flgindividual
            dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalpart').asinteger, //compõe sal. participacao
            dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalbenef').asinteger, //compõe sal. benefício
            dtmFolhaPrevia.qryProvento.FieldByName('numprioridade').asinteger,  //prioridade de desconto
            dtmFolhaPrevia.qryTmpDesc.FieldByName('idempresa').asinteger,       //id empresa p/ contabilização
            dtmFolhaPrevia.qryProvento.FieldByName('tipobasedesconto').asinteger,//tipo de base de desconto {abono,supl,inss,resgate}
            0,                                                   //código do alterador
            dtmFolhaPrevia.qryTmpDesc.FieldByName('plano').asinteger,           //id do plano de contas
            inumeroprocesso,
            lNumProcINSS,  {snumprocinss,}
            dtmFolhaPrevia.qryTmpDesc.FieldByName('flgtipodesc').asstring,      //flg do tipo de desconto 'C', 'P', 'B', 'Y'
            dtmFolhaPrevia.qryTmpDesc.FieldByName('valorinfo').asfloat,         //valor informativo associado a rubrica
            arvalor,                                                            //valor da rubrica
            0,                                                                  //valor base de calculo para a regra
            dtmFolhaPrevia.qryTmpDesc.FieldByName('referencia').asstring,       //referencia
            dtmFolhaPrevia.qryTmpDesc.FieldByName('mesreferencia').asstring,    //mês de referência
            scoddarf,     //código IRRF na SRF para o DARF
            dtmFolhaPrevia.qryTmpDesc.FieldByName('recpag').asstring,           //indice recebimento 'R'ou pagamento 'P'
            dtmFolhaPrevia.qryTmpDesc.FieldByName('codtiprecdes').asstring,     //código do tipo de recebimento ou desembolso
            dtmFolhaPrevia.qryTmpDesc.FieldByName('codcentrocusto').asstring,  //código do centro de custo
            dtmFolhaPrevia.qryTmpDesc.FieldByName('codcentrorespon').asstring,  //código do centro de responsabilidade
            dtmFolhaPrevia.qryTmpDesc.FieldByName('unidnegoc').asstring,        //código da unidade de negócio
            dtmFolhaPrevia.qryTmpDesc.FieldByName('placonta').asstring,         //conta contábil associada
            '',                                                 //data inicio da rubrica
            '',                                                 //data final da rubrica
            dtmFolhaPrevia.qryTmpDesc.FieldByName('descparcial').asinteger,     //indica se permite desconto parcial
            dtmFolhaPrevia.qryTmpDesc.FieldByName('flg_AbAnual').asinteger {0}, //usa no abono anual                  //edilaine WO14701
            1,                                                  //origem da rubrica
            dtmFolhaPrevia.qryTmpDesc.FieldByName('idlote').asinteger, //idlote original
            0,  // RUBRICA CONSIGNATARIO
            false, // ACEITA ZERO
            sdttmpdesc, // DATA PREVISTA DE PAGAMENTO - PEND 10826
            dtmFolhaPrevia.qryProvento.FieldByName('CODPROVDESC').asstring, //PARA GRAVAR CODPROVDESC NA PREVIA E EM SQL PARA REGRAS
            dtmFolhaPrevia.qryTmpDesc.FieldByName('IDPLANOPREV').asinteger, //ATRIBUI ZERO PARA OBTER O IDPLANOPREV GLOBAL
            0, //ATRIBUI ZERO PARA OBTER O IDPLANOORIGEM GLOBAL
            iIdPlanoPrevContabil, //dtmFolhaPrevia.qryTmpDesc.FieldByName('IDPLANPREVCONTAB').asinteger, // PLANOCONTABIL  // Andre Imakawa - SIG 24398
            dtmFolhaPrevia.qryTmpDesc.FieldByName('IDSEQINTERNOFB').asinteger, // GRAVAR SEQINTERNO PARA RETORNO
            dtmFolhaPrevia.qryTmpDesc.FieldByName('FLGRUBLEGAL').asinteger,  //
            dtmFolhaPrevia.qryTmpDesc.FieldByName('MESCOMPREEM').asstring    // SOL 140042 Kintana 900220
            ,0,'',dtmFolhaPrevia.qryTmpDesc.FieldByName('FLGMARGEM').asinteger         //Renato Visoni SOL 131523 KINTANA 750021
            ,0
            ,dtmFolhaPrevia.qryProvento.FieldByName('FLGREPROGRAMAR').asInteger   //Marcio Denilson - SOL 136569 - KINTANA 820997
            ,false, 0,dtmFolhaPrevia.qryProvento.FieldByName('FLGEXCLUICONTRIBPA').asInteger    //Osni Cavalcante - SIG 58950.59454
            ,emptystr, dtmFolhaPrevia.qryTmpDesc.FieldByName('FLGDEFICIT').asinteger  // Andre Imakawa - SIG 67673
            , aiFlgIsentoAcaoGanha                                                      //edilaine SIG92016
            ) then
          dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica da TmpDesc '+
            dtmFolhaPrevia.qryTmpDesc.FieldByName('idprovento').asstring,
            self)
        else
        begin
          if objRubInserida <> nil then
          begin
            VerificaIrrfDarfRegimeRegressivo(objRubInserida); //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319

            if dtmFolhaPrevia.qryTmpDesc.FieldByName('flgtipodesc').asstring = 'E' then
            begin
              objRubInserida.bpermanente:=
                (dtmFolhaPrevia.qryTmpdesc.fieldbyname('PRAZO').asinteger = 0);
              if (dtmFolhaPrevia.qryTmpdesc.fieldbyname('PRAZO').asinteger = 2) then
                objRubInserida.iprazo:=1
              else
              begin
                if SistemaFolha.FormaParcelaPrevia = 0 then
                  objRubInserida.iprazo:=
                    dtmFolhaPrevia.qryTmpDesc.FieldByName('numprazo').asinteger
                else
                  objRubInserida.iprazo:=
                    dtmFolhaPrevia.qryTmpDesc.FieldByName('parcela').asinteger;
              end;
            end;
            // SOL 237951 PPM 493275 adicionado o novo flag 'D' inicio
            if dtmFolhaPrevia.qryTmpDesc.FieldByName('flgtipodesc').asstring = 'D' then
            begin
              objRubInserida.bpermanente:=
                (dtmFolhaPrevia.qryTmpdesc.fieldbyname('PRAZO').asinteger = 0);
              if (dtmFolhaPrevia.qryTmpdesc.fieldbyname('PRAZO').asinteger = 2) then
                objRubInserida.iprazo:=1
              else
              begin
                if SistemaFolha.FormaParcelaPrevia = 0 then
                  objRubInserida.iprazo:=
                    dtmFolhaPrevia.qryTmpDesc.FieldByName('NUMPRAZOD').asinteger
                else
                  objRubInserida.iprazo:=
                    dtmFolhaPrevia.qryTmpDesc.FieldByName('parcela').asinteger;
              end;
            end;
            // SOL 237951 PPM 493275 adicionado o novo flag 'D' Final

            //TRATA PRAZO DE CONVENIO AVULSO
            if dtmFolhaPrevia.qryTmpDesc.FieldByName('flgtipodesc').asstring = 'C' then
            begin
              objRubInserida.bpermanente:=
                (dtmFolhaPrevia.qryTmpdesc.fieldbyname('PRAZO').asinteger = 0);
              if (dtmFolhaPrevia.qryTmpdesc.fieldbyname('PRAZO').asinteger = 2) then
                objRubInserida.iprazo:=1
              else
                objRubInserida.iprazo:=
                  dtmFolhaPrevia.qryTmpDesc.FieldByName('numprazo').asinteger; //
            end;

            if dtmFolhaPrevia.qryTmpDesc.FieldByName('flgtipodesc').asstring = 'P' then
            begin
              if liddesconto > 0 then
              begin
                if FazQuery(dtmFolhaPrevia.qryAux3,
                    'SELECT NVL(FLGCOBRADECTERC,0) AS FLGCOBRADECTERC '+
                    'FROM CONTPREV '+
                    'WHERE IDPLANOPREV = '+
                      inttostr(dtmFolhaPrevia.qryTmpdesc.fieldbyname('IDPLANOPREV').asinteger)+' '+
                    'AND IDCONTRIBUICAO = '+inttostr(liddesconto)) then
                begin
                  if dtmFolhaPrevia.qryAux3.fieldbyname('FLGCOBRADECTERC').asinteger = 1 then
                    objrubinserida.ipossuiabono:=1;
                end;
              end;

              objRubInserida.bpermanente:=
                (dtmFolhaPrevia.qryTmpdesc.fieldbyname('PRAZO').asinteger = 0);
              if (dtmFolhaPrevia.qryTmpdesc.fieldbyname('PRAZO').asinteger = 2) then
                objRubInserida.iprazo:=1
              else
                objRubInserida.iprazo:=
                  dtmFolhaPrevia.qryTmpDesc.FieldByName('numprazo').asinteger;

	      AtribuiValores(objRubInserida.rvalorrecebido, objRubInserida);

              if liddesconto > 0 then
              begin
                if ((dtmFolhaPrevia.qryTmpdesc.fieldbyname('IDMODULO').asinteger = 16) or
                    (dtmFolhaPrevia.qryTmpdesc.fieldbyname('IDMODULO').asinteger = 454) or
                    (dtmFolhaPrevia.qryTmpdesc.fieldbyname('IDMODULO').asinteger = 456)) and
                   (pos('BENEF',
                      uppercase(dtmFolhaPrevia.qryTmpdesc.fieldbyname('DESCRICAO').asstring)) > 0) then
                begin
                  objRubInserida.iidbeneficio:=liddesconto;
                end
                else
                begin
                  objRubInserida.iidcontribuicao:=liddesconto;
                  objRubInserida.inumrecebimento:=dtmFolhaPrevia.qryTmpdesc.fieldbyname('NUMRECEBIMENTO').asinteger; //QDO ORIGEM É HSTCONTRIBPREV
                  //TRATA TAMBÉM PELA DESCRICAO VISTO QUE A CONCESSÃO NÃO ESTÁ GRAVANDO A REFERENCIA CORRETAMENTE
                  objRubInserida.sreferencia:='CONTRIB';
                end;
              end;
            end;

            // Andre Imakawa - SIG 80955
            if dtmFolhaPrevia.qryTmpDesc.FieldByName('FLGRRA').asinteger = 1 then
            begin
              if dtmFolhaPrevia.ListaPessoasComRRA.IndexOf(dtmFolhaPrevia.qryTmpDesc.FieldByName('idpessoa').AsString) = -1 then
                dtmFolhaPrevia.ListaPessoasComRRA.Add(dtmFolhaPrevia.qryTmpDesc.FieldByName('idpessoa').AsString);

              if dtmFolhaPrevia.ListaBeneficiosComRRA.IndexOf(dtmFolhaPrevia.qryTmpDesc.FieldByName('IDDESCONTO').AsString) = -1 then
                dtmFolhaPrevia.ListaBeneficiosComRRA.Add(dtmFolhaPrevia.qryTmpDesc.FieldByName('IDDESCONTO').AsString);

              if dtmFolhaPrevia.ListaPessoasComRRAxBeneficio.IndexOf(dtmFolhaPrevia.qryTmpDesc.FieldByName('idpessoa').AsString+';'+dtmFolhaPrevia.qryTmpDesc.FieldByName('IDDESCONTO').AsString) = -1 then
                dtmFolhaPrevia.ListaPessoasComRRAxBeneficio.Add(dtmFolhaPrevia.qryTmpDesc.FieldByName('idpessoa').AsString+';'+dtmFolhaPrevia.qryTmpDesc.FieldByName('IDDESCONTO').AsString);

              dtmFolhaPrevia.bLancouRRA := True;
            end;
            // Andre Imakawa - SIG 80955
          end;
        end;
      except
        on e:exception do
        begin
          dtmFolhaPrevia.qryAux3.close; // SOL 242740 PPM 575822
          dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica da TmpDesc '+
            dtmFolhaPrevia.qryTmpDesc.FieldByName('idprovento').asstring+'-'+e.message,
            self);
        end;
      end;
    end;
    dtmFolhaPrevia.qryAux3.close; // SOL 242740 PPM 575822
  end;

  // Andre Imakawa - SIG 121306 - Inicio
  procedure AjustaSaldoPermitido;
  var
    liiQtd, lii_aux1, lii_aux2, lii_aux3: integer;
    objrub_aux1, objrub_aux2, objrub_aux3 : tobjrubrica;
  begin
    try
      for lii_aux1:=0 to lstRubricas.count-1 do
      begin
        objrub_aux1:=(lstRubricas.objects[lii_aux1] as tobjrubrica);

        if (objrub_aux1.sflgtipodesc = 'Y') and (objrub_aux1.rsaldopermitido <> 9999999999) then
        begin
          liiQtd := 1;
          for lii_aux2:=0 to lstRubricas.count-1 do
          begin
            objrub_aux2:=(lstRubricas.objects[lii_aux2] as tobjrubrica);
            if (objrub_aux1.iseqinternofb = objrub_aux2.iseqinternofb) and
               (lii_aux1 <> lii_aux2) and (lii_aux1 < lii_aux2)then
               begin
                 inc(liiQtd);
               end;
          end;

          if liiQtd > 1 then
          begin
            for lii_aux3:=0 to lstRubricas.count-1 do
            begin
              objrub_aux3:=(lstRubricas.objects[lii_aux3] as tobjrubrica);
              if (objrub_aux1.iseqinternofb = objrub_aux3.iseqinternofb) then
              begin
                objrub_aux3.rsaldopermitido := roundCM((objrub_aux3.rsaldopermitido/liiQtd),2);
              end;
            end;
          end;

        end;
      end;
    except

    end;
  end;
  // Andre Imakawa - SIG 121306 - Fim

begin
  for lij:=0 to lstPessoas.count-1 do
  begin
    //LAÇO LISTA PLANOS PARA PEGAR REGISTROS DA TMPDESC
    for lik:=0 to lstPlanos.count-1 do
    begin
      try
        dtmFolhaPrevia.qryTmpDesc.Close;
        dtmFolhaPrevia.qryTmpDesc.parambyname('pIdTitular').asinteger:=iidtitular;
        dtmFolhaPrevia.qryTmpDesc.parambyname('pIdPessoa').asinteger:=strtoint(lstPessoas[lij]){iidresponsavel};
        dtmFolhaPrevia.qryTmpDesc.parambyname('pIdPessJur').asinteger:=iidpatro;
        dtmFolhaPrevia.qryTmpDesc.parambyname('pIdPlanoPrev').asinteger:=strtoint(lstPlanos[lik]);
        if iidmotivofolha = prmIdMotivoAbono then
        begin
          dtmFolhaPrevia.qryTmpDesc.parambyname('pIdMotivo').asinteger:=prmIdMotivoAbono;
          dtmFolhaPrevia.qryTmpDesc.parambyname('pMesRef').asstring:=dtmFolhaPrevia.MesAbono;
        end
        else
          dtmFolhaPrevia.qryTmpDesc.parambyname('pMesRef').asstring:=dtmFolhaPrevia.MesCobranca;
        dtmFolhaPrevia.qryTmpDesc.parambyname('pMesPagto').asstring:=dtmFolhaPrevia.MesCobranca;
        dtmFolhaPrevia.qryTmpDesc.open;
      except
        on e:exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro na leitura da TmpDesc'+'-'+e.message,
            self);
        end;
      end;
      while not dtmFolhaPrevia.qryTmpDesc.eof do
      begin
        if not (
           (dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'K') or //PERMITIR RUB INFORMATIVA
           (dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'P') or
           (dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'A') or
           (dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'E') or
           (dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'D') or // SOL 237951 PPM 493275 adicionado o novo flag 'D'
           (dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'J') or //Helio - SOL Nº 252332 PPM Nº 761404 //RNG93
           (dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'C') ) then
        begin
          dtmFolhaPrevia.qryTmpDesc.next;
          continue;
        end;

        if (SistemaFolha.FLGTRATALOTEINDEPENDENTE=1) and
           ((dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'P') or (dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'D') ) and // SOL 237951 PPM 493275 adicionado o novo flag 'D'
           (dtmFolhaPrevia.qryTmpDesc.fieldbyname('IDLOTE').asinteger <> iidlote) then
        begin
          dtmFolhaPrevia.qryTmpDesc.next;
          continue;
        end;

        //TRATA TAMBÉM PELA DESCRICAO VISTO QUE A CONCESSÃO NÃO ESTÁ GRAVANDO A REFERENCIA CORRETAMENTE
        if (dtmFolhaPrevia.qryTmpDesc.fieldbyname('REFERENCIA').asstring = 'CONTRIB') or
           (pos('CONTRIB',uppercase(dtmFolhaPrevia.qryTmpDesc.fieldbyname('DESCRICAO').asstring)) > 0) then
        begin
          try
            liddesconto:=dtmFolhaPrevia.qryTmpDesc.fieldbyname('IDCONTRIBUICAO').asinteger;
            if liddesconto < 0 then
              liddesconto:=0;
          except
            liddesconto:=0;
          end;
        end
        else
          if ((dtmFolhaPrevia.qryTmpdesc.fieldbyname('IDMODULO').asinteger = 16) or
              (dtmFolhaPrevia.qryTmpdesc.fieldbyname('IDMODULO').asinteger = 454) or
              (dtmFolhaPrevia.qryTmpdesc.fieldbyname('IDMODULO').asinteger = 456)) and
             (pos('BENEF',
                uppercase(dtmFolhaPrevia.qryTmpdesc.fieldbyname('DESCRICAO').asstring)) > 0) then
          begin
            liddesconto:=dtmFolhaPrevia.qryTmpDesc.fieldbyname('IDDESCONTO').asinteger;
          end
          else
            liddesconto:=0;

        if not dtmFolhaPrevia.qrytmpdesc.fieldbyname('DATARECEBIMENTO').isnull then
          sdttmpdesc:=formatdatetime('dd/mm/yyyy',
            dtmFolhaPrevia.qryTmpdesc.fieldbyname('DATARECEBIMENTO').asdatetime)
        else
          sdttmpdesc:='';

        try
          if (liddesconto > 0) and
             (dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'P') then
          begin
            if dtmFolhaPrevia.qryPagadorContrib.locate(
                 'idplanoprev;idcontribuicao;idrubrica',
                 vararrayof([
                   dtmFolhaPrevia.qryTmpDesc.fieldbyname('IDPLANOPREV').asinteger,
                   liddesconto,
                   dtmFolhaPrevia.qryTmpDesc.fieldbyname('IDPROVENTO').asinteger]),
                 []) then
              if dtmFolhaPrevia.qryPagadorContrib.Fieldbyname('FLGPAGADOR').asstring <> 'C' then
              begin
                dtmFolhaPrevia.qryTmpDesc.next;
                continue;
              end;
          end;
        except
          on e:exception do
          begin
            dtmFolhaPrevia.ExibeMensagem('Erro na consulta do FlgPagador.'+'-'+e.message,
              self);
            dtmFolhaPrevia.qryTmpDesc.next;
            continue;
          end;
        end;
        if dtmFolhaPrevia.qryTmpDesc.FieldByName('idmotivo').asinteger > 0 then
          liidmotivo:=dtmFolhaPrevia.qryTmpDesc.FieldByName('idmotivo').asinteger
        else
          liidmotivo:=prmIdmotivoFolhaBen;

        //LANCAMENTO ABERTO DE CONTRIBUICAO QUANDO ACAO JUDICIAL GANHA
        if (iacaojudganha = 1) and
           (dtmFolhaPrevia.qryTmpDesc.FieldByName('flgtipodesc').asstring = 'P') then
        begin
          if (copy(dtmFolhaPrevia.qryTmpDesc.FieldByName('mesreferencia').asstring,6,2) <> '13') or
             ((copy(dtmFolhaPrevia.qryTmpDesc.FieldByName('mesreferencia').asstring,6,2) = '13') and
              (dtmFolhaPrevia.qryTmpDesc.FieldByName('flgirrf').asinteger = 1) and
              not dtmFolhaPrevia.TemAntecipacaoAbono) then
          begin
            //TRATA DARF PARA PROVENTO
            //USAR NATUREZA DE RENDIMENTO PARA DESCONTO TAMBÉM
            scoddarf:=dtmFolhaPrevia.qryTmpDesc.FieldByName('codirrfdarf').asstring;

            //Andre Imakawa - SIG 92016 - Inicio
            if not(bAcaoEquacionamento) then
              rvalorjud:=TruncaMoeda(
                dtmFolhaPrevia.qryTmpDesc.FieldByName('valor').asfloat*
                rpercacjudganha);
            //Andre Imakawa - SIG 92016 - Fim

            rvalornormal:=TruncaMoeda(
              dtmFolhaPrevia.qryTmpDesc.FieldByName('valor').asfloat-
              rvalorjud);

            iIdRubrica:=dtmFolhaPrevia.qryTmpDesc.FieldByName('idprovento').asinteger;
            InsereTmpdesc(rvalornormal);

            //USAR NATUREZA DE RENDIMENTO PARA DESCONTO TAMBÉM
            scoddarf:=dtmFolhaPrevia.qryTmpDesc.FieldByName('codirrfdarf').asstring;
	    iIdRubrica:=dtmFolhaPrevia.BuscaRubricaContribuicaoAcaoGanha(
              dtmFolhaPrevia.qryTmpDesc.fieldbyname('IDPLANOPREV').asinteger,
              dtmFolhaPrevia.qryTmpDesc.FieldByName('idprovento').asinteger);
            InsereTmpdesc(rvalorjud, 1);

          end
          else
          begin
            //TRATA DARF PARA PROVENTO
            //USAR NATUREZA DE RENDIMENTO PARA DESCONTO TAMBÉM
            scoddarf:=dtmFolhaPrevia.qryTmpDesc.FieldByName('codirrfdarf').asstring;
	          iIdRubrica:=dtmFolhaPrevia.qryTmpDesc.FieldByName('idprovento').asinteger;
            InsereTmpdesc(dtmFolhaPrevia.qryTmpDesc.FieldByName('valor').asfloat);
          end;
        end
        //edilaine - SIG24483 - inicio
        else if (dtmFolhaPrevia.qryTmpDesc.fieldbyname('FLGTIPODESC').asstring = 'J') and
                (dtmFolhaPrevia.qryTmpDesc.FieldByName('FLGIRRF').asinteger = 1) and
                (dtmFolhaPrevia.qryTmpDesc.fieldbyname('ISENCAO_IR').AsInteger = 1) and (rpercacjudganha > 0) then  // Andre Imakawa - SIG 99651

        begin
          {insere parte que incide IR}
          scoddarf    := dtmFolhaPrevia.qryTmpDesc.FieldByName('codirrfdarf').asstring;
          rvalorjud   := TruncaMoeda(dtmFolhaPrevia.qryTmpDesc.FieldByName('valor').asfloat * rpercacjudganha);
          rvalornormal:= TruncaMoeda(dtmFolhaPrevia.qryTmpDesc.FieldByName('valor').asfloat - rvalorjud);

          iIdRubrica := dtmFolhaPrevia.qryTmpDesc.FieldByName('idprovento').asinteger;
          InsereTmpdesc(rvalornormal);

          {insere parte isenta IR}
          scoddarf := dtmFolhaPrevia.qryTmpDesc.FieldByName('codirrfdarf').asstring;
      	  iIdRubrica := dtmFolhaPrevia.BuscaRubricaIsentaAcaoJud(
                        dtmFolhaPrevia.qryTmpDesc.fieldbyname('IDPLANOPREV').asinteger,
                        dtmFolhaPrevia.qryTmpDesc.FieldByName('idprovento').asinteger);
          InsereTmpdesc(rvalorjud);
        end
        //edilaine - SIG24483 - fim
        else
        begin
          scoddarf:=dtmFolhaPrevia.qryTmpDesc.FieldByName('codirrfdarf').asstring;
          iIdRubrica:=dtmFolhaPrevia.qryTmpDesc.FieldByName('idprovento').asinteger;
          InsereTmpdesc(dtmFolhaPrevia.qryTmpDesc.FieldByName('valor').asfloat);
        end;

        dtmFolhaPrevia.qryTmpDesc.next;
      end;

      dtmFolhaPrevia.qryTmpDesc.Close;

    end;

    try
      if (trim(lstPessoas[lij]) <> '') and
         (lstMesRefProv.Count >= 1) then
      begin
        if strtoint(lstPessoas[lij]) <> 0 then
        begin
          dtmFolhaPrevia.ObtemQueryRubricaIndividual(
            dtmFolhaPrevia.qryRubricaIndividual,
            iidpessjur,
            iidtitular,
            strtoint(lstPessoas[lij]),
            dtmFolhaPrevia.MesCobranca,
            lstMesRefProv[0],
            lstMesRefProv[lstMesRefProv.count-1]);

          //PROCESSA SE CONSEGUIR ABRIR A CONSULTA
          while not dtmFolhaPrevia.qryRubricaIndividual.eof do
          begin

            if dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datainicio').isnull then
            begin
              lsmesini:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESINI').AsString; // SOL 254564 PPM 801622
              lsdatainicio:=' ';
            end
            else
            begin
              lsmesini:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESINI').AsString; // SOL 254564 PPM 801622
              lsdatainicio:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datainicio').asstring;
            end;
            if (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('FLGPERMANENTE').asinteger = 1) or
               dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datafinal').isnull then
            begin
              lsmesfim:='9999/99';
              lsdatafinal:=' ';
            end
            else
            begin
              // Andre Imakawa - SIG 39480 - Incio
              if ((dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('FLGPERMANENTE').asinteger = 0) and
                 not( dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datafinal').isnull)) then
                 begin
                   if (//(copy(lstMesRefProv[lii], 6, 2) = '13') and - Andre Imakawa - SIG 40646
                      ((dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 1)and (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPABONO').asInteger = 1)) or
                      ((dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 2)and (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPAABONOINSS').asInteger = 1))) then
                     begin
                       if (formatdatetime('yyyy/mm',dtmFolhaPrevia.DataPagamento) <= formatdatetime('yyyy/mm',
                          dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datafinal').asdatetime)) then
                         begin
                            lsmesfim:='9999/99';
                            lsdatafinal:=' ';
                         end
                       else
                         begin
                            lsmesfim:=formatdatetime('yyyy/mm',
                            dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datafinal').asdatetime);
                            lsdatafinal:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datafinal').asstring;
                         end;
                     end
                   else
                     begin
                       lsmesfim:=formatdatetime('yyyy/mm',
                       dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datafinal').asdatetime);
                       lsdatafinal:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datafinal').asstring;
                     end
                 end
              else
                 begin
                   lsmesfim:=formatdatetime('yyyy/mm',
                   dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datafinal').asdatetime);
                   lsdatafinal:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('datafinal').asstring;
                 end;
              // Andre Imakawa - SIG 39480 - Fim
            end;
            liocorparcial:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('NUMOCORRENCIAS').asinteger;
            for lii:=0 to lstMesRefProv.count-1 do
            begin
              if (lstMesRefProv[lii] > lsmesini) and  // SOL 254564 PPM 801622
                 ((lstMesRefProv[lii] <= lsmesfim) or
                  ((copy(lstMesRefProv[lii], 6, 2) = '13') and
                   (lsmesfim = copy(lstMesRefProv[lii], 1, 4)+'/12'))) then
              begin
                 if (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('FLGPERMANENTE').asinteger = 1) and (copy(lstMesRefProv[lii], 6, 2) <> '13') then // SOL 264016 PPM 1130964 // SOL 264776 PPM  1155520
                    if (dtmFolhaPrevia.MesCobranca <> lstMesRefProv[lii]) then // SOL 264016 PPM 1130964
                       continue;    // SOL 264016 PPM 1130964

                 // SOL 257727 PPM 964888 descomentado
                 if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPAABONOINSS').asInteger <> 1) and // SOL 241799 PPM 557943
                    (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGUSAABONO').asInteger <> 1) then // SOL 241799 PPM 557943
                    if (dtmFolhaPrevia.MesCobranca <> lstMesRefProv[lii]) and (copy(lstMesRefProv[lii], 6, 2) <> '13') then // SOL 241799 PPM 557943
                        continue;  // SOL 241799 PPM 5579431

                    if (copy(lstMesRefProv[lii], 1, 4) <> copy(dtmFolhaPrevia.MesCobranca, 1, 4)) and (copy(lstMesRefProv[lii], 6, 2) = '13')  then
                       continue;  // SOL 241799 PPM 557943

                    //if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPAABONOINSS').asInteger = 1) and (copy(lstMesRefProv[lii], 6, 2) = '02') then
                    //   continue;

                if dtmFolhaPrevia.qryRubricaIndividual.FieldByName('flgpensaoalim').asinteger = 1 then
                begin
                  if iflgtipofolha in [0, 6] then
                  begin
                    if ExisteBaseNormal(true) or
                       ExisteBaseReserva(true) then
                      if copy(lstMesRefProv[lii],6,2) <> '13' then // SOL 237013 PPM 477956 // SOL 241799 PPM 557943
                        InsereRubricaIndividual(0) {normal}
                      else
                        lbInsere:=true
                    else  // Andre Imakawa - SIG 50589
                      // Andre Imakawa - SIG 48125 - Inicio
                      if ExisteBaseRegressiva(true) then
                        if copy(lstMesRefProv[lii],6,2) <> '13' then // SOL 237013 PPM 477956 // SOL 241799 PPM 557943
                          InsereRubricaIndividual(2) {Regressiva}
                        else
                          lbInsere:=true;
                      // Andre Imakawa - SIG 48125 - Fim
                        
                  end
                  else
                    lbInsere:=true;

                  if lbInsere then
                  begin
                    if copy(lstMesRefProv[lii],6,2) = '13' then   // SOL 237013 PPM 477956 // SOL 241799 PPM 557943
                    begin   //SOL 269071 PPM 1275764
                       if ExisteBase13(true) then
                         if bTemAbonoNormal then //CONTROLA SE REGISTROS DE ABONO SÃO NORMAIS E NÃO APENAS DE REVISÃO
                            //if not ((dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPAABONOINSS').asInteger = 1) and (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = '02')) then //SOL 248206 PPM 663140
                            // Fevereiro Antec. Abono Funcef  - FLGANTECIPAABONO e MES Cobranca = 02 com Fontepagadora 1
                            if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 1) and
                               (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPABONO').asInteger = 1) and
                               (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = prmMesAdiantAbonoFund) then  //Andre Imakawa - SIG 99272
                               InsereRubricaIndividual(1); {Antecip abono Funcef}
                            // Agosto Antec. Abono Inss  - FLGANTECIPAABONOINSS e MES Cobranca = 08  com Fontepagadora 2
                            if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 2) and
                               (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPAABONOINSS').asInteger = 1) and
                               (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = prmMesAdiantAbonoINSS) then //Andre Imakawa - SIG 99272
                               InsereRubricaIndividual(1); {Antecip abono Inss}
                            // Novembro Abono Inss/Funcef - FLGABONO  e Mes Cobranca 11

                            // Andre Imakawa - SIG 99499 - Inicio
                            //if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGUSAABONO').asInteger = 1) and
                            //   (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = '11') then
                            if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 1) and
                               (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGUSAABONO').asInteger = 1) and
                               (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = prmMesAbonoFund) then
                               InsereRubricaIndividual(1);

                            if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 2) and
                               (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGUSAABONO').asInteger = 1) and
                               (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = prmMesAbonoINSS) then
                               InsereRubricaIndividual(1);
                            // Andre Imakawa - SIG 99499 - Fim

                               //InsereRubricaIndividual(1); {abono}

                              //InsereRubricaIndividual(1); {abono}
                       break;
                    end;  //SOL 269071 PPM 1275764
                  end;
                end
                else
                begin
                  if copy(lstMesRefProv[lii],6,2) = '13' then   // SOL 264016 PPM 1130964
                  begin
                    if ExisteBase13(true) OR
                       ExisteBaseRegressiva(true) then //CPrev - 26655
                      if bTemAbonoNormal then //CONTROLA SE REGISTROS DE ABONO SÃO NORMAIS E NÃO APENAS DE REVISÃO
                         //if not ((dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPAABONOINSS').asInteger = 1) and (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = '02')) then // SOL 248206 PPM 663140
                         // Fevereiro Antec. Abono Funcef  - FLGANTECIPAABONO e MES Cobranca = 02 com Fontepagadora 1
                         if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 1) and
                            (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPABONO').asInteger = 1) and
                            (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = prmMesAdiantAbonoFund) then  //Andre Imakawa - SIG 99272
                            InsereRubricaIndividual(1); {Antecip abono Funcef}
                         // Agosto Antec. Abono Inss  - FLGANTECIPAABONOINSS e MES Cobranca = 08  com Fontepagadora 2
                         if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 2) and
                            (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPAABONOINSS').asInteger = 1) and
                            (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = prmMesAdiantAbonoINSS) then  //Andre Imakawa - SIG 99272
                            InsereRubricaIndividual(1); {Antecip abono Inss}
                         // Novembro Abono Inss/Funcef - FLGABONO  e Mes Cobranca 11
                         // Andre Imakawa - SIG 99499 - Inicio
                         //if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGUSAABONO').asInteger = 1) and
                         //   (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = '11') then
                         //   InsereRubricaIndividual(1); {Antecip abono Inss}
                         if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 1) and
                            (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGUSAABONO').asInteger = 1) and
                            (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = prmMesAbonoFund) then
                            InsereRubricaIndividual(1);

                         if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 2) and
                            (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGUSAABONO').asInteger = 1) and
                            (copy(dtmFolhaPrevia.MesCobranca, 6, 2) = prmMesAbonoINSS) then
                            InsereRubricaIndividual(1);
                         // Andre Imakawa - SIG 99499 - Fim


                            //InsereRubricaIndividual(1); {abono}
                  end
                  else
                    if iflgtipofolha in [0, 6] then
                       if copy(lstMesRefProv[lii],6,2) <> '13' then // SOL 264016 PPM 1130964
                         InsereRubricaIndividual(0); {normal}
                end;
              end; //if (lstMesRefProv[lii] >= lsmesini) and
            end; //for lii:=0 to lstMesRefProv.count-1 do
            dtmFolhaPrevia.qryRubricaIndividual.next;
          end;
          dtmFolhaPrevia.qryRubricaIndividual.Close;
        end;
      end;
    except
      on e:exception do
      begin
        dtmFolhaPrevia.ExibeMensagem('Erro na leitura da rubrica individual'+'-'+e.message,
          self);
      end;
    end;
  end;
  if bControlaSaldoRI then AjustaSaldoPermitido;  // Andre Imakawa - SIG 121306
end;

procedure TdtmFolhaPrevia.AvaliaDadoBancario(aobjrec: tobjrecebedor);
var numbco, numage, nomeag, numcta, tpconta, sidcbanc: string;
    bDuplContaPref, bResgateParc: boolean;
    ifavcredito: integer;
    smsg, sSQL: string;
begin
  ifavcredito := aobjrec.iIdRecebePgto ;
  smsg:='';
  
  aobjrec.icodportforma:=ctrlBCP.DefinePortadorForma(
    aobjrec.iidtitular, ifavcredito,
    aobjrec.iidpatro, 
    0,
    aobjrec.iflgprovisorio, byte(aobjrec.bconsignatario),
    aobjrec.icodportforma,
    byte(dtmFolhaPrevia.FolhaReserva),
    numbco, numage, nomeag, numcta,
    tpconta, sidcbanc, aobjrec.lbpagtoelet, bDuplContaPref,
    aobjrec.ifavdoc ,
    aobjrec.rLiquidoTotal,
    aobjrec.iseqdocumento,
    aobjrec.objPortResp
    ,aobjRec.iidlote // Renato Visoni SOL 138251 kintana 840758
    );

  //Fernando Xavier SOL 63067 KINTANA

  //sSQL := ' SELECT * FROM CTRLINTERFACE WHERE IDLOTE = ' + intTostr(aobjRec.iidlote) +' AND NVL(FLGRESGATEPARCELADO,1)=1';
  sSQL := ' SELECT 1 FROM CTRLINTERFACE WHERE IDLOTE = ' + intTostr(aobjRec.iidlote) +' AND NVL(FLGRESGATEPARCELADO,1)=1';
  dtmFolhaPrevia.qryAux2.close;
  dtmFolhaPrevia.qryAux2.sql.clear;
  dtmFolhaPrevia.qryAux2.sql.add(ssql);
  dtmFolhaPrevia.qryAux2.open;
  bResgateParc := not (dtmFolhaPrevia.qryAux2.IsEmpty);

  if bResgateParc then
  begin
     if (trim(numbco) = '') or
        (trim(numage) = '') or
        (trim(numcta) = '') then
     begin
        dtmFolhaPrevia.ExibeMensagem('Erro, Conta Resgate não Cadastrada.'+smsg,    // SOL:111915 - Daniel Begnami
          aobjrec);
     end;
  end
  else
  if aobjrec.lbpagtoelet then
  begin
    if bDuplContaPref then
    begin
      dtmFolhaPrevia.ExibeMensagem('Erro, existe mais de uma Conta Salário Cadastrada.'+smsg,   // SOL:111915 - Daniel Begnami
        aobjrec); 
      dtmFolhaPrevia.ExibeMensagemSemRecebedor('Alterar acessando o Menu Cadastros / Contas Bancárias');
      dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
    end
    else
      if (trim(numbco) = '') or
         (trim(numage) = '') or
         //novo TIPO OP/Recibo
         ((trim(numcta) = '') and (tpconta <> '4')) then
      begin
        // Andre Imakawa - SIG 123059 - Inicio
        if (aobjrec.icodportforma < 308) or (aobjrec.icodportforma > 310) then
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro, Conta Salário não Cadastrada.'+smsg,    // SOL:111915 - Daniel Begnami
            aobjrec);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Alterar acessando o Menu Cadastros / Contas Bancárias');
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
        end;      
        // Andre Imakawa - SIG 123059 - Fim
      end;
  end;
  aobjrec.NumBanco:=numbco;
  aobjrec.NumAgencia:=numage;
  aobjrec.ContaCorrente:=numcta;
  aobjrec.TpConta:=tpconta; // Andre Imakawa - SIG 60540

  // SIG35803 Xavier - Validação das contas bancarias
  qryAux.Close;
  qryAux.SQL.Clear;
  qryAux.SQL.Add('SELECT PF.DESCRICAO' + #13#10 +
                 '      FROM PORTADORFORMA PF' + #13#10 +
                 '       INNER JOIN FORMARECPAG FP ON (FP.CODFORMA = PF.CODFORMA )' + #13#10 +
                 'WHERE FP.FLGDADOSBANCARIOS = ''S''' + #13#10 +
                 'AND  PF.CODPORTFORMA = '+IntToStr(aobjrec.icodportforma));

  qryAux.open;

  If not(qryAux.IsEmpty) then
  begin
     if (trim(numbco) = '') or (trim(numage) = '') or (trim(numcta) = '')  then
     begin
        dtmFolhaPrevia.ExibeMensagemSemRecebedor('Convênio : '+qryAux.FieldByName('DESCRICAO').AsString);
        dtmFolhaPrevia.ExibeMensagem('Erro, Dados bancários inexistentes '+smsg, aobjrec);
        dtmFolhaPrevia.ExibeMensagemSemRecebedor('');
     end;
  end;
  // SIG35803 Xavier - Validação das contas bancarias


  dtmFolhaPrevia.qryAux2.Close;   // SOL 242740 PPM 575822
end;

procedure TobjRecebedor.BuscaBeneficiariosResponsavel;
var lssql: string;
begin
  if not bconsignatario then
    if length(sListaBeneficios) > 1 then
    begin
      dtmFolhaPrevia.qryBFCiarioTitPlan.close;
      lssql:=
        'SELECT DISTINCT IDPESSOA '+_clinefeed+
        'FROM BFCIARIOTITPLAN '+_clinefeed+
        'WHERE IDRESPONSAVEL = '+inttostr(iidresponsavel)+' '+_clinefeed+
        'AND IDPLANOPREV = '+inttostr(iidplanoprevglobal)+' '+_clinefeed+
        'AND IDPESSJUR = '+inttostr(iidpessjur)+' '+_clinefeed+
        'AND IDBENEFICIO IN ('+sListaBeneficios+') '+_clinefeed;
      dtmFolhaPrevia.qryBFCiarioTitPlan.open;
      while not dtmFolhaPrevia.qryBFCiarioTitPlan.eof do
      begin
        AcrescentaPessoa(
          dtmFolhaPrevia.qryBFCiarioTitPlan.FieldByName('idpessoa').asinteger);
        dtmFolhaPrevia.qryBFCiarioTitPlan.next;
      end;
      dtmFolhaPrevia.qryBFCiarioTitPlan.close;
    end;
end;

function TdtmFolhaPrevia.CriaRecebedor(ainumeroprocesso, aiidpessjur,
                                       aiidpatro, aiidplanoprev,
                                       aiidplanoorigem,
                                       aiidplanocontabilglobal,
                                       aiidtitular, aiidresponsavel,
                                       aiIdRecebePgto,
                                       aiidlote,
                                       ainumdepirrf, aiNumDepSalf, aiflgisentoirrf, aiseqproposta, aiflgconcessao,
                                       aiiDESCIRMES    : integer;
                                       aiiMolestiaGrave : Integer;
                                       aiisomairrfinss : integer;
                                       aicodportforma, aidfloatpagto : integer;
                                       adtdatanasc, adtdatarequerimento : tdatetime;
                                       asnumprocinss: string;
                                       aiflgprovisorio : integer;
                                       adtdataliberacao : tdatetime;
                                       asmespagliberacao : string;
                                       adtdataconcessao : tdatetime;
                                       adtDataFimMolestia, adtDataMolestia {SOL 214520 KTN 2042434}: tdatetime;
                                       abconsignatario: boolean;
                                       arValorBase1: real;
                                       arValorBase2: real;
                                       arValorBase3: real;
                                       arValorBase4: real;
                                       arValorBase5: real;
                                       arValorBase6: real;
                                       adtDIB: tdatetime;
                                       aanomescompreem: string;  // SOL 140042 Kintana 900220
                                       asTpModalidade: string; //SOL 257943 PPM 970494
                                       var aobjRec : TObjRecebedor) : boolean;
var
  lsplacontaliq: string;
begin
  try
    aobjRec.AtribuiDados(ainumeroprocesso, aiidpessjur,
                         aiidpatro, aiidplanoprev,
                         aiidplanoorigem,
                         aiidplanocontabilglobal,
                         aiidtitular, aiidresponsavel,
                         aiIdRecebePgto,
                         aiidlote,
                         ainumdepirrf, aiNumDepSalf, aiflgisentoirrf, aiseqproposta, aiflgconcessao,
                         aiiDESCIRMES,aiiMolestiaGrave, aiisomairrfinss, aicodportforma, aidfloatpagto,
                         adtdatanasc, adtdatarequerimento, asnumprocinss, aiflgprovisorio,
                         adtdataliberacao, asmespagliberacao,adtdataconcessao,
                         adtdatafimmolestia, adtdatamolestia {SOL 214520 KTN 2042434}, abconsignatario,
                         arValorBase1,arValorBase2,arValorBase3,
                         arValorBase4,arValorBase5,arValorBase6,adtDIB, aanomescompreem, // SOL 140042 Kintana 900220
                         asTpModalidade //SOL 257943 PPM 970494
                         );

    aobjrec.ibloqueiaprevia    := 0;

    aobjrec.bMolestiaGrave     := False; // Andre Imakawa - SIG 99651

    aobjrec.bTemCPMFPA         := false;  //CONTROLA REPROCESSAMENTO DAS MARGENS PELA ENTRADA DA CPMF DE PA

    aobjrec.iidmotivofolha     := dtmFolhaPrevia.iidmotivolote;

    aobjrec.rSuplMes           := 0;
    aobjrec.rSuplAtr           := 0;
    aobjrec.rSuplAbn           := 0;
    aobjrec.rINSSMes           := 0;
    aobjrec.rINSSMesBasePA     := 0;
    aobjrec.rINSSAtr           := 0;
    aobjrec.rINSSAbn           := 0;
    aobjrec.rContMes           := 0;
    aobjrec.rContMesExcluido   := 0; //Osni Cavalcante - SIG 58950.59454
    aobjrec.rContAtr           := 0;
    aobjrec.rContAbn           := 0;
    aobjrec.rContAbnExcluido   := 0; //Osni Cavalcante - SIG 58950.59454
    aobjrec.rPASuplMes         := 0;
    aobjrec.rPASuplAtr         := 0;
    aobjrec.rPASuplAbn         := 0;
    aobjrec.rPAINSSMes         := 0;
    aobjrec.rPAINSSAtr         := 0;
    aobjrec.rPAINSSAbn         := 0;

    aobjrec.rValorBaseBen1     := -1;
    aobjrec.rValorBaseBen2     := -1;
    aobjrec.rValorBaseBen3     := -1;

    aobjRec.rVlrDeducaoDep := 0;  // Andre Imakawa - SIG 99651
    aobjRec.rVlrDeducaoDep13 := 0;  // Andre Imakawa - SIG 99651
    aobjRec.rVlrIsentoIdade := 0;  // Andre Imakawa - SIG 99651
    aobjRec.rVlrIsentoIdade13 := 0;  // Andre Imakawa - SIG 99651
    aobjRec.rVlrPAFUNDRecebedor := 0;  // Andre Imakawa - SIG 99651
    aobjRec.rVlrPAINSSRecebedor := 0;  // Andre Imakawa - SIG 99651
    aobjRec.rVlrPAFUNDRecebedor13 := 0;  // Andre Imakawa - SIG 99651
    aobjRec.rVlrPAINSSRecebedor13 := 0;  // Andre Imakawa - SIG 99651
    aobjRec.iNaturezaPaRecebedor  := 0;  // Andre Imakawa - SIG 99651
    aobjRec.iNaturezaPaPagador  := 0;  // Andre Imakawa - SIG 99651
    aobjRec.bPossuiAcaoBitrib   := False; // Andre Imakawa - SIG 99651
    aobjRec.rPercAcaoBitrib     := 0;

    aobjrec.splacontaliqglobal := '';

    aobjrec.iIdBasePagamento   := -1;       //edilaine SIG90547

    aobjrec.BuscaAcaoGanha;

    aobjrec.iflgfitespecial    := qryPrevia.FieldByName('FLGFITESPECIAL').asinteger;

    aobjrec.SaldoCompensaIR    := aobjrec.VerificaCompensacaoIRRF;
    //Início - William Santana - SOL 251048.17830 - PPM 1115143
    // aobjrec.MoraNoBrasil       := dtmfolhaprevia.qryPrevia.fieldbyname('CODPAIS').asstring = 'BRA';
        //aobjrec.MoraNoBrasil       := not( dtmfolhaprevia.qryPrevia.fieldbyname('NaoMoraNoBrasil').asstring = 'S' );//SOL 270391 PPM 1335136
    aobjrec.MoraNoBrasil       := ( dtmfolhaprevia.qryPrevia.fieldbyname('NaoMoraNoBrasil').asstring <> 'S' ); //SOL 270391 PPM 1335136
    //Término William Santana - SOL 251048.17830 - PPM 1115143

    if aobjrec.MoraNoBrasil then
      aobjrec.CodigoPais:='BRA'
    else
      aobjrec.CodigoPais:='EXT';

    result:=true;

    // Andre Imakawa - WO1234 - Inicio
    if abconsignatario then
    begin
      if Assigned(self.objrecebedor) then
        lsplacontaliq := self.objrecebedor.splacontaliqglobal;
    end
    else
      lsplacontaliq := '';
    // Andre Imakawa - WO1234 - Fim

    aobjrec.AcrescentaPlano(aiidplanoprev, 0, lsplacontaliq, 0, 0, 0);  // Andre Imaakawa - SIG 99651

    if not abconsignatario then
    begin
      inc(dtmFolhaPrevia.lRecebedor);
      dtmfolhaprevia.lblmsg.caption := 'Total  de  rubricas  processadas: '+
                                       inttostr(dtmFolhaPrevia.lContador)+#13+
                                       'Total de recebedores processados: '+
                                       inttostr(dtmFolhaPrevia.lRecebedor);
      dtmfolhaprevia.lblmsg.update;

      LimpaEstrutura;
      dtmFolhaPrevia.qryDetProcJudicial.Close;
      dtmFolhaPrevia.qryDetProcJudicial.Parambyname('IDPESSOA').asinteger := aiidresponsavel;
      //Leandro WO13356 - dtmFolhaPrevia.qryDetProcJudicial.Parambyname('DTPGTO').asdate      := dtmFolhaPrevia.DataPagamento; //Leandro WO4555
      dtmFolhaPrevia.qryDetProcJudicial.Open;

      aobjrec.sListaBeneficios      := '';
    end;
  except
    on e:exception do
    begin
      result:=false;
      dtmFolhaPrevia.ExibeMensagem('Erro criação objeto recebedor.',
        aobjRec);
      dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
      dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
    end;
  end;
end;

