procedure TobjRecebedor.VerificaMargemDescontoRubricaVoluntaria(
  aobjrub: tobjrubrica; abEstrutura, bEncRet: boolean);
var rdesc: real;
    //BRUNO AZEVEDO SOL 179961 KINTANA 1687754
    //bEncRet: Boolean;
    //BRUNO AZEVEDO SOL 179961 KINTANA 1687754
begin

  //BRUNO AZEVEDO SOL 187436 KINTANA 1765685
  //bEncRet := FazQuery(dtmFolhaPrevia.qryAux,' SELECT IDSITBENEFICIO FROM BENEFBFCIARIO '+
  //                                   ' WHERE IDPESSOA = '+ intTostr(aobjrub.iIdpessoa) +
  //                                   ' AND IDBENEFICIO = '+ intTostr(aobjrub.iIdbeneficio) +
  //                                   ' AND IDSITBENEFICIO IN (3,2) ');
   // SOL 254972 PPM 811047 inicio
  {FazQuery(dtmFolhaPrevia.qryAux, 'SELECT COUNT(1) AS QTD_ATIVO ' +
                                  '  FROM BENEFBFCIARIO         ' +
                                  ' WHERE IDPESSOA = '+ intTostr(aobjrub.iIdpessoa) +
                                  '   AND IDSITBENEFICIO NOT IN (2, 3) ');

  bEncRet := (dtmFolhaPrevia.qryAux.FieldByName('QTD_ATIVO').AsInteger = 0); }
  // SOL 254972 PPM 811047 Final
  //BRUNO AZEVEDO SOL 187436 KINTANA 1765685

  //Renato Visoni SOL 131523 KINTANA 750021
  if (SistemaFolha.TipoMargemDesconto <> 2) or
                                                                               //BRUNO AZEVEDO SOL 132237 KINTANA 760615
     ((SistemaFolha.TipoMargemDesconto = 2) and (aobjrub.iFlgRubLegal = 0) and (aobjrub.iFlgMargem = 0)) then
    aobjrub.bpossuimargem:=false;

  if (aobjrub.iflgdesconto = 1) then
  begin
    if (SistemaFolha.TipoMargemDesconto <> 2) or
       ((SistemaFolha.TipoMargemDesconto = 2) and (aobjrub.iFlgRubLegal = 0)) then
    begin
      if prmFlgCalculoValores = 0 then
        rdesc:=TruncaMoeda(aobjrub.rvalorrecebido)
      else
        rdesc:=ArredondaMoeda(aobjrub.rvalorrecebido);

      //if ((dtmFolhaPrevia.qryPrevia.FieldByName('IDSITBENEFICIO').AsInteger in [2,3]) and (aobjrub.iFlgRubLegal = 0)) then // SOL 170006 KINTANA 1510657 //SOL 258021 PPM 972817 comentado
      if ((bEncRet) and (aobjrub.iFlgRubLegal = 0)) then // SOL 170006 KINTANA 1510657 // SOL 258021 PPM 972817 trocado o dtmFolhaPrevia.qryPrevia.FieldByName('IDSITBENEFICIO').AsInteger in [2,3] por (bEncRet)
      begin
         aobjrub.iFlgMargem := 0;
      end
      else if frmFolhaNormalPrevia.chkResgate.Checked then   // SOL 261857 PPM  1092246
      begin
          aobjrub.iFlgMargem := 0;
      end;
      // SOL 261857 PPM  1092246
      // SOL 170006 KINTANA 1510657

      // SOL 170006 KINTANA 1510657 // SOL 170006 KINTANA 1510657

      if ((aobjrub.iFlgMargem = 0) and (aobjrub.iFlgRubLegal = 0))
         //BRUNO AZEVEDO SOL 132237 KINTANA 760615
          //or
         //BRUNO AZEVEDO SOL 132119 KINTANA 758870
         //((dtmFolhaPrevia.qryPrevia.FieldByName('IDSITBENEFICIO').AsInteger in [2,3]) and (aobjrub.iFlgRubLegal = 0))
         //BRUNO AZEVEDO SOL 132237 KINTANA 760615
      then begin
        if rLimiteVlrBase > 0 then begin
          if (rLimiteVlrBase - rdesc >= -0.009)  then begin
            rLimiteVlrBase := rLimiteVlrBase - rdesc;
            rliquidototal  := rliquidototal-rdesc;
            aobjrub.rValorprovento :=rdesc;
            aobjrub.bpossuimargem  :=true;
          end else
          //BRUNO AZEVEDO SOL 179961 KINTANA 1687754
          //if ((dtmFolhaPrevia.qryPrevia.FieldByName('IDSITBENEFICIO').AsInteger in [2,3]) and (aobjrub.iFlgRubLegal = 0)) then // SOL 170006 KINTANA 1510657
          if ((bEncRet) and (aobjrub.iFlgRubLegal = 0)) then // SOL 170006 KINTANA 1510657
          //BRUNO AZEVEDO SOL 179961 KINTANA 1687754
          begin
            rLimiteVlrBase := rLimiteVlrBase - rdesc;
            rliquidototal  := rliquidototal-rdesc;
            aobjrub.rValorprovento :=rdesc;
            aobjrub.bpossuimargem  :=true;
          end // SOL 170006 KINTANA 1510657
          else begin
            if ((rLimiteVlrBase + rMargemDesconto) - rdesc >= -0.009)  then begin
              rMargemDesconto :=(rLimiteVlrBase + rMargemDesconto)-rdesc;
              //BRUNO AZEVEDO SOL 132368 KINTANA 762229
              CalculaMargemDesconto(rMargemDesconto);
              rliquidototal   := rliquidototal - rdesc;
              rLimiteVlrBase  := rliquidototal - rMargemDesconto;
              aobjrub.rValorprovento := rDesc;
              //BRUNO AZEVEDO SOL 132368 KINTANA 762229
              aobjrub.bpossuimargem  := true;

            end else
            if (aobjrub.idescontaparcial=1)  then begin
              aobjrub.rValorprovento:=rLimiteVlrBase + rMargemDesconto;
              rMargemDesconto:=0;
              rLimiteVlrBase:=0;
              rliquidototal:=rliquidototal-aobjrub.rValorprovento;
              if (rliquidototal <= 0.009) then
                rliquidototal:=0;
              aobjrub.bpossuimargem:=true;
            end;
          end;
        end else begin
          if rMargemDesconto > 0 then
          begin
            if (rMargemDesconto - rdesc >= -0.009)  then
            begin
              rMargemDesconto:=rMargemDesconto-rdesc;
              rliquidototal:=rliquidototal-rdesc;
              aobjrub.rValorprovento:=rdesc;
              aobjrub.bpossuimargem:=true;
            end
            else
              if (aobjrub.idescontaparcial=1)  then
              begin
                aobjrub.rValorprovento:=rMargemDesconto;
                rMargemDesconto:=0;
                rliquidototal:=rliquidototal-aobjrub.rValorprovento;
                if (rliquidototal <= 0.009) then
                  rliquidototal:=0;
                aobjrub.bpossuimargem:=true;
              end;
          end;
        end;
      end;
    end;
  end;

  if abEstrutura then
    if ((aobjrub.iflgdesconto = 1) and (aobjrub.iFlgMargem = 0)) or
       //BRUNO AZEVEDO SOL 132406 KINTANA 762728
       ((aobjrub.iflgdesconto = 2) and (aobjrub.iFlgMargem = 0)) then  // SOL124161 - Daniel Begnami
      dtmfolhaprevia.AtualizaValorEstrutura(aobjrub);
  dtmFolhaPrevia.qryAux.close;// SOL 242740 PPM 575822
end;
//Renato Visoni SOL 131523 KINTANA 750021

{*******************************************************************************
    Aline Freire SOL 155182 Kintana 1228739
    Realiza os cálculos concernentes a IRRF RRA
    e insere Rubrica na tabela PREVIA
********************************************************************************}
procedure TobjRecebedor.CalculoIRRFRRA(pidPlanoPrev : integer);
var dblTotalRRA,dblFaixaNM,
    dblAliquota,dblParcela,
    dblValTotIRRFRRA,dblBrutoTotalRRA, dblTotalBenefRRA, dblTotalBenefRRAAux: double;
    intNM,intRubrica  : integer;
    sTipoDesc: String;
    liFontePagadora : integer; // Felipe A. Santos - SOL 258357/17801 PPM 1083052
    objrubIN1343, objrubBenefRRA : tobjrubrica; lii : integer; //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
    bRRA : boolean;
    lidPlanoPrev: integer; // Andre Imakawa - SIG 24509
begin

  liFontePagadora := 0; // Felipe A. Santos - SOL 258357/17801 PPM 1083052

  // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - criação do for da fonte pagadora
  // recupera a rubrica de IRRF RRA pela fonte pagadora para lança-la na PREVIA
  for liFontePagadora := 1 to 2 do
  begin
    // Felipe A. Santos - SOL 258357/17801 PPM 1083052  - início

    // verifica se as rubricas de IRRF RRA estão parametrizadas
    if (liFontePagadora = 1) then
    begin
      if not(dtmFolhaPrevia.RRAIRRFParametrizadoFUND) then
      begin
         dtmFolhaPrevia.ExibeMensagemCabecalhoRRA;
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('Não existe parametrização para Rubrica IRRF - RRA - Fundação,');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('assim não foram lançados os IRRF - RRA com fonte pagadora FUNCEF para');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('o beneficiário:');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor(dtmFolhaPrevia.RetornaMatriculaDepentit(iidresponsavel));
         Exit;
      end;
    end
    else if (liFontePagadora = 2) then
    begin
      if not(dtmFolhaPrevia.RRAIRRFParametrizadoINSS) then
      begin
         dtmFolhaPrevia.ExibeMensagemCabecalhoRRA;
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('Não existe parametrização para Rubrica IRRF - RRA - INSS,');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('assim não foram lançados os IRRF - RRA com fonte pagadora INSS');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('para o seguinte beneficiário:');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor(dtmFolhaPrevia.RetornaMatriculaDepentit(iidresponsavel));
         Exit;
      end;
    end;

    // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim
    dblTotalBenefRRA := 0;
    dblTotalBenefRRAAux := 0;
    dblTotalRRA := 0;
    intNM       := 0;
    dblFaixaNM  := 0;
    dblAliquota := 0;
    intRubrica  := 0;

   { Forma de Cálculo do IRRF RRA:
     Somatório do Valor Total do RRA / Quantidade meses do RRA = Valor X
     Valor X * Alíquota = Valor Y
     Valor Y - Parcela a Deduzir do Imposto = Valor Z
     Valor Z x Quantidades do meses do RRA = Valor do IRRF RRA}

    with dtmFolhaPrevia do
    begin
       // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - início
       cdsRRA.Filtered := False;
       cdsRRA.Filter := 'FONTEPAGADORA = ' + IntToStr(liFontePagadora);
       cdsRRA.Filtered := True;

       if cdsRRA.IsEmpty then
          Continue;   // se não tiver registro com essa fonte pagadora então continua o laço
       // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim

       // Somatório do Valor Total do RRA
       //dblTotalRRA:= cdsRRAAGR_TOTALRRA.Value;    //SOL 269294 PPM 1293303
       // Somatório do Valor Total do RRA rateado por plano.
       //ListaPessoasComRRAxBeneficio.Add(qryAux2.FieldByName('IDPESSOA').AsString+';'+qryAux2.FieldByName('IDBENEFICIO').AsString);

       lstPeriodoRRA :=tstringlist.create; // Andre Imakawa - SIG 64957

       if assigned(lstRubricas) then
       begin
          for lii:=0 to lstRubricas.count-1 do
          begin
             objrubBenefRRA:=(lstRubricas.objects[lii] as tobjrubrica);

             if not(ObtemBeneficioIsento(objrubBenefRRA.iidbeneficio)) then   // Andre Imakawa - SIG 49800-60759
             begin
               if (ListaPessoasComRRAxBeneficio.IndexOf(IntToStr(objrubBenefRRA.iidpessoa)+';'+IntToStr(objrubBenefRRA.iidbeneficio)) <> -1) then
               begin


                  //VERIFICAR SE É RRA  //SOL 269294 PPM 1293303
                  dtmFolhaPrevia.qryAux4.Close;
                  dtmFolhaPrevia.qryAux4.SQL.Clear;
                  dtmFolhaPrevia.qryAux4.SQL.Add(' select 1 from provdesc');
                  dtmFolhaPrevia.qryAux4.SQL.Add(' WHERE IDPROVENTO ='+ IntToStr(objrubBenefRRA.iidrubrica));
                  dtmFolhaPrevia.qryAux4.SQL.Add('   AND FLGRRA = 1');
                  dtmFolhaPrevia.qryAux4.open;

                  bRRA := (dtmFolhaPrevia.qryAux4.RecordCount > 0);  //SOL 269294 PPM 1293303


                  // acumula o vlr de beneficio para o plano e tambem para outro plano para veerificar se faz o proporcional.
                  if  (bRRA) and (liFontePagadora = objrubBenefRRA.ifontepagadora) then  //SOL 269294 PPM 1293303 // Andre Imakawa - SIG 96258
                  begin

                     objrubBenefRRA.iFlgRRA := 1; // Andre Imakawa - SIG 99651

                     // Andre Imakawa - SIG 64957 - Inicio
                     //Inc(intNM); // Andre Imakawa - SIG 61572
                     if objrubBenefRRA.sflgtipodesc <> 'I' then // Andre Imakawa - SIG 80671
                       if lstPeriodoRRA.IndexOf(objrubBenefRRA.smes) = -1 then
                         lstPeriodoRRA.Add(objrubBenefRRA.smes);
                     // Andre Imakawa - SIG 64957 - Fim

                     // Andre Imakawa - SIG 24509 - Inicio
                     if objrubBenefRRA.sflgtipodesc = 'Y' then
                        lidPlanoPrev := self.RetornaIdPlanoPrev(objrubBenefRRA.iidplanocontabil,objrubBenefRRA.iidplanoprev,Self)
                     else
                        lidPlanoPrev := objrubBenefRRA.iidplanoprev;
                     // Andre Imakawa - SIG 24509 - Fim

                     if (liFontePagadora = objrubBenefRRA.ifontepagadora) and ((pidPlanoPrev = lidPlanoPrev) and (copy(objrubBenefRRA.smes,1,4) <= IntToStr(StrToInt(formatdatetime('yyyy',dtmFolhaPrevia.DataPagamento))-1) ) )  then // Andre Imakawa - SIG 24509
                        dblTotalBenefRRA := dblTotalBenefRRA + objrubBenefRRA.rvalorprovento
                     else
                     if (liFontePagadora = objrubBenefRRA.ifontepagadora) and  ((pidPlanoPrev <> lidPlanoPrev) and (copy(objrubBenefRRA.smes,1,4) <= IntToStr(StrToInt(formatdatetime('yyyy',dtmFolhaPrevia.DataPagamento))-1) ) ) then // Andre Imakawa - SIG 24509
                        dblTotalBenefRRAAux := dblTotalBenefRRAAux + objrubBenefRRA.rvalorprovento;
                     // acumula a base dos valores que entraram na previa somando os proventos e subtraindo os descontos
                     if (copy(objrubBenefRRA.smes,1,4) <= IntToStr(StrToInt(formatdatetime('yyyy',dtmFolhaPrevia.DataPagamento))-1) )  then
                     begin
                        if liFontePagadora = objrubBenefRRA.ifontepagadora then  //SOL 269294 PPM 1293303
                        begin
                           if objrubBenefRRA.iflgdesconto = 0 then
                           begin
                              dblTotalRRA:= dblTotalRRA + objrubBenefRRA.rvalorprovento;
                           end
                           else
                           begin
                              dblTotalRRA:= dblTotalRRA - objrubBenefRRA.rvalorrecebido;  // Fernando Xavier - SIG 20679
                           end;
                        end; //SOL 269294 PPM 1293303
                     end;
                  end;
               end;
             end;
          end;
        end;


       //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
       { // Andre Imakawa - SIG 24509 - Inicio
       if assigned(lstRubricas) then
       begin
          for lii:=0 to lstRubricas.count-1 do
          begin

             objrubIN1343:=(lstRubricas.objects[lii] as tobjrubrica);

             if (objrubIN1343.bValidouBit) then
             begin
                //if  (pidPlanoPrev = objrubIN1343.iidplanoprev) then     // IN abate do total do RRA independente de plano.
                dblTotalRRA := Strtofloat(Floattostr(dblTotalRRA)) - Strtofloat(floattostr(objrubIN1343.rvalorprovento));
             end;

          end;
          if dblTotalRRA <= 0 then   //SOL 269092 PPM 1282955   Caso tenha IN1343 subtraimos do total do RRA visto que IN é isenção de IR.
          begin
             break;
          end;
       end;  //SOL 269092 PPM 1282955
       }// Andre Imakawa - SIG 24509 - Inicio
        //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587

       intNM := lstPeriodoRRA.count;     // Andre Imakawa - SIG 64957
       FreeAndNil(lstPeriodoRRA);         // Andre Imakawa - SIG 64957

       // Quantidade meses do RRA
       //intNM      := cdsRRA.RecordCount; // Andre Imakawa - SIG 61572
       if intNM = 0 then Continue;       // Andre Imakawa - SIG 61572

       // Somatório do Valor Total do RRA / Quantidade meses do RRA
       dblFaixaNM := dblTotalRRA / intNM; //SOL 269294 PPM 1293303

       // Valor cheio
       dblBrutoTotalRRA := dblTotalRRA * intNM;  //SOL 269294 PPM 1293303   //SOL 269294 PPM 1293303

       // Pega valor da Aliquota... e da parcela
       qryAux.Close;
       qryAux.sql.Clear;
       qryAux.sql.Add( 'select I.FAIXA_IRRF    FAIXA,      '+
                       '       I.ALIQUOTA_IRRF ALIQUOTA,   '+
                       '       I.PARCDEDUZIRRF PARCELA     '+
                       '  from (select *                   '+
                       '          from IRRF                '+
                       '         where faixa_irrf >='+OraNumero(floattostr(dblFaixaNM))+
                       '         order by datainivigencia desc, aliquota_irrf) I '+
                       ' where rownum = 1                              ');
       qryAux.open;
       qryAux.First;

       dblFaixaNM := dblTotalRRA / intNM;  //SOL 269294 PPM 1293303

       // Valor da Aliquota
       dblAliquota := qryAux.fieldbyname('ALIQUOTA').asfloat;

       // Parcela
       dblParcela  := qryAux.fieldbyname('PARCELA').asfloat;

       // Valor do IRRF RRA
       dblValTotIRRFRRA := RoundCM(((dblFaixaNM * dblAliquota/100) - dblParcela) * intNM,5) ;

       // Andre Imakawa - SIG 28942 - Inicio
       if dblTotalRRA <= 0 then   //SOL 269092 PPM 1282955   Caso tenha IN1343 subtraimos do total do RRA visto que IN é isenção de IR.
       begin
          //break;  // Andre Imakawa - SIG 82189
          Continue; // Andre Imakawa - SIG 82189
       end;
       // Andre Imakawa - SIG 28942 - Fim

       // Só entra para ratear o proporcional caso tenha mais de um plano e vlr de beneficio para o outro plano.
       if (lstPlanos.count > 1) then
       begin
          dblTotalBenefRRAAux := (((dblTotalBenefRRAAux * 100)/ dblTotalRRA) / 100) * dblValTotIRRFRRA;
          if (dblTotalBenefRRAAux >= prmVLMINIRFF) then  //SOL 269152 PPM 1284507   //SOL 269294 PPM 1293303
          begin
             // Calcula o proporcional de RRA do plano sobre a base total em caso de mais de um plano.
             dblValTotIRRFRRA := (((dblTotalBenefRRA * 100)/ dblTotalRRA) / 100) * dblValTotIRRFRRA;
             //dblValTotIRRFRRA := RoundCM(((dblValTotIRRFRRA * ((dblTotalBenefRRA*100)/dblFaixaNM))/100),5) ;
          end; //SOL 269152 PPM 1284507
       end;

       // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - início
       // RNG105 - se o valor cálculado do imposto for menor que o limite mínimo de IRRF então não insere rubrica de IRRF RRA
       if (dblValTotIRRFRRA < prmVLMINIRFF) then
       begin
          dtmFolhaPrevia.ExibeMensagemCabecalhoRRA;
          if (liFontePagadora = 1) then
             ExibeMensagem('Valor do IRRF RRA - Fundação abaixo do limite mínimo (' + Float2String(prmVLMINIRFF) + '): ' + Float2String(dblValTotIRRFRRA))
          else
             ExibeMensagem('Valor do IRRF RRA - INSS abaixo do limite mínimo (' + Float2String(prmVLMINIRFF) + '): ' + Float2String(dblValTotIRRFRRA));

          Continue; // pula o código abaixo, e vai para o proximo laço
       end;
       // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim


       // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - adicionado fonte pagadora 1
       // Select p/ retornar o valor do parâmetro para RRA
       if (liFontePagadora = 1) then
       begin
         qryAux2.close;
         qryAux2.sql.Clear;
         qryAux2.sql.add('select valorparam' +
                         '  from paramfolha ' +
                         ' where nomeparam  = ''RUBRICAIRRFRRAFUND''');
         qryAux2.open;
       end
       else
       begin
       // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim
         qryAux2.close;
         qryAux2.sql.Clear;
         qryAux2.sql.add('select valorparam' +
                         '  from paramfolha ' +
                         ' where nomeparam  = ''RUBRICAIRRFRRA''');
         qryAux2.open;
       end; // Felipe A. Santos - SOL 258357/17801 PPM 1083052

       if qryAux2.fieldbyname('valorparam').asinteger > 0 then
          intRubrica:= qryAux2.fieldbyname('valorparam').asinteger;

       //BRUNO AZEVEDO - estava pegando os paramentros da rubrica errada, com essa função ele localiza a rubrica certa de RRA
       sTipoDesc := dtmFolhaPrevia.BuscaDadosRubrica(self, intRubrica, 'T');
           //2
       if (dblValTotIRRFRRA > 0) and (intRubrica > 0) and NaoEstaIsento(dtmFolhaPrevia.qryProvento.FieldByName('CODIRRFDARF').AsString) Then
       begin
         try
           if not InsereRubrica(
              iidresponsavel,                                       //beneficiario
              0,                                                    //favorecido da rubrica
              0,                                                    //beneficio associado : pega beneficio base
              intRubrica,                                           //codigo do provento
              dtmFolhaPrevia.qryProvento.FieldByName('flgdesconto').asinteger,    //flag de desconto
              dtmFolhaPrevia.qryProvento.FieldByName('flgespecial').asinteger,    //flag especial
              objetoRubrica.iidmotivo,                                           //motivo do desconto
              1,                                                    //seqrubrica = 1
              icodmoedabase,                                        //codigo da moeda
              0,                                                    //regra de calculo
              dtmFolhaPrevia.qryProvento.FieldByName('codfontepagadora').asinteger, //fonte pagadora : pega fonte pagadora base
              dtmFolhaPrevia.qryProvento.FieldByName('flgirrf').asinteger,  //indica se rubrica entra na base de IR
              dtmFolhaPrevia.qryProvento.FieldByName('FLGSALFAMILIA').asinteger, //indica se rubrica entra na composição do calculo do salario familia
              0,                                                   // Indica se o beneficio é provisorio
              Sistema.Idmodulo,                                    //sistema de origem da rubrica
              0,                                                   //flgSRB
              1,                                                   //flgOK
              0,                                                   //flgPA
              dtmFolhaPrevia.qryProvento.FieldByName('flgdescpensao').asinteger, //flgBasePA
              0,                                                   //flgconcessao
              0,                                                   //flgindividual
              dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalpart').asinteger,//compõe sal. participacao
              dtmFolhaPrevia.qryProvento.FieldByName('flgcompoesalbenef').asinteger,//compõe sal. benefício
              dtmFolhaPrevia.qryProvento.FieldByName('numprioridade').asinteger, //prioridade de desconto
              iidpessjur,                                           //id empresa p/ contabilização
              dtmFolhaPrevia.qryProvento.FieldByName('tipobasedesconto').asinteger, //tipo de base de desconto {abono,supl,inss,resgate}
              0,                                                   //código do alterador
              0,                                                   //id do plano de contas
              inumeroprocesso,
              snumprocinss,
              'I',                                                 //flg do tipo de desconto 'C', 'P', 'B', 'Y'
              dblTotalRRA,                                         //valor informativo associado a rubrica (base de calculo do IR)
              dblValTotIRRFRRA,                                    //valor da rubrica
              0,                                                   //valor base de calculo para a regra
              '***',                                               //referencia
              dtmFolhaPrevia.MesCobranca,                          //mês de referência  155182
              dtmFolhaPrevia.qryProvento.FieldByName('CODIRRFDARF').AsString,  //código IRRF na SRF para o DARF igual ao provento base
              '',                                                  //indice recebimento 'R'ou pagamento 'P'
              '',                                                  //código do tipo de recebimento ou desembolso
              '',                                                  //código do centro de custo
              '',                                                  //código do centro de responsabilidade
              '',                                                  //código da unidade de negócio
              '',                                                  //conta contábil associada
              '',                                                  //data inicio da rubrica
              '',                                                  //data final da rubrica
              dtmFolhaPrevia.qryProvento.FieldByName('descparcial').asinteger,    //indica se permite desconto parcial
              0,                                                   //usa no abono anual
              3,                                                   //origem da rubrica
              0,                                                   //lote original do desconto
              0,                                                   // RUBRICA CONSIGNATARIO
              false, // ACEITA ZERO
              '',     // DATA PREVISTA DE PAGAMENTO - PEND 10826
              dtmFolhaPrevia.qryProvento.FieldByName('CODPROVDESC').asstring, //PARA GRAVAR CODPROVDESC NA PREVIA E EM SQL PARA REGRAS
              pidPlanoPrev,// Passado o plano para contemplar o rateio 0,//PLANO PREVIDENCIARIO ATRIBUIDO A BASE DE IR
              0, //ATRIBUI ZERO PARA OBTER O IDPLANOORIGEM GLOBAL
              0, //PLANO CONTABIL ATRIBUIDO A BASE DE IR
              0, //RUBRICA CUJO SEQUENCIAL INTERNO É IRRELEVANTE PARA RETORNO
              dtmFolhaPrevia.qryProvento.FieldByName('FLGRUBLEGAL').asinteger,''  //
              ,0,'',dtmFolhaPrevia.qryProvento.FieldByName('FLGMARGEM').asinteger//Renato Visoni SOL 131523 KINTANA 750021
              , 0, 0, false, 0 // Andre Imakawa - SIG 67673
              ,dtmFolhaPrevia.qryProvento.FieldByName('FLGEXCLUICONTRIBPA').asInteger    //Osni Cavalcante - SIG 58950.59454
              ) then
              dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de IRRF RRA '+
                dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring,
                self)
         else
            if objrubinserida <> nil then // FEFX - SIG43291
            begin
              objrubinserida.iFlgRRA := 1; //Andre Imakawa - WO2546-2645-2706
              VerificaIrrfDarfRegimeRegressivo(objrubinserida); // FEFX - SIG43291
            end;
         except
           on e:exception do
           begin
             qryAux2.close; // SOL 242740 PPM 575822
             dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de IRRF RRA '+
               dtmFolhaPrevia.qryProvento.FieldByName('idprovento').asstring+'-'+e.message, self);
           end;
         end;// try .. except
       end;// if .. then
       qryAux2.close; // SOL 242740 PPM 575822
       qryAux.close; // SOL 242740 PPM 575822
    end;// with .. do
  end;

  // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - início
  dtmFolhaPrevia.cdsRRA.Filtered := False;
  dtmFolhaPrevia.cdsRRA.Filter := '';
  // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim
end;
{*******************************************************************************
    Aline Freire SOL 155182 Kintana 1228739
    Verifica se para o Lote e titular informado existe as parametrizações necessárias
    para realização do cálculo de RRA
*******************************************************************************}
Procedure TobjRecebedor.VerificaIRRFRRA;
var lii: Integer;
begin
   if (dtmFolhaPrevia.ListaPessoasComRRA.IndexOf(inttostr(iidresponsavel)) <> -1) then  //SOL 258019 PPM 977651 //Taffarel - SIG49027
   begin  //SOL 258019 PPM 977651
      with dtmFolhaPrevia do
      begin
        //AQUI NÃO DEVE AGRUPAR POR RUBRICA REVISAO
        qryRRA.Close;
        qryRRA.Sql.Clear;
        qryRRA.Sql.Add('    SELECT   ');
        qryRRA.Sql.Add('           0 as IDPLANOPREV,');  //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587 - Não agrupar mais por estes campos
        qryRRA.Sql.Add('           0 as FLGDEVOLUCAO,'); //BRUNO OTACILIO SOL206962
        qryRRA.Sql.Add('           0 as IDBENEFICIO,');  //BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587 - Não agrupar mais por estes campos
        qryRRA.Sql.Add('           IDPESSOA,');
        qryRRA.Sql.Add('           IDTITULAR,');
        qryRRA.Sql.Add('           MESREFERENCIA,');
        //qryRRA.Sql.Add('           sum(QTDEMES) AS QTDEMES,');
        qryRRA.Sql.Add('count(distinct MESREFERENCIA) over() AS QTDEMES,');
        qryRRA.Sql.Add('    sum(VALORPREV) AS VALORPREV,');
        qryRRA.Sql.Add('           0 as RUBRICAREVISAO,');
        qryRRA.Sql.Add('           FONTEPAGADORA'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
        qryRRA.Sql.Add('           FROM (');
        // Recupera os benefícios de RRA
        qryRRA.Sql.Add('    select H.IDLOTE,');
        qryRRA.Sql.Add('           H.IDPLANOPREV,');
        qryRRA.Sql.Add('           H.IDBENEFICIO,');
        qryRRA.Sql.Add('           H.IDPESSOA,');
        qryRRA.Sql.Add('           H.IDTITULAR,');
        qryRRA.Sql.Add('           H.MES,');
        qryRRA.Sql.Add(' COUNT(DISTINCT H.MESREFERENCIA) OVER () AS QTDEMES, ');
        qryRRA.Sql.Add('           H.MESREFERENCIA,');
        qryRRA.Sql.Add('           C.MESREFERENCIA CTRLMESREFERENCIA,');
        qryRRA.Sql.Add('           SUM (DECODE(H.FLGDEVOLUCAO,1,-H.VALORPREV,H.VALORPREV)) AS VALORPREV,');
        qryRRA.Sql.Add('           H.DATAPAGAMENTO,');

        // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - início
        {
        qryRRA.Sql.Add('           DECODE(H.FLGDEVOLUCAO,');
        qryRRA.Sql.Add('                  0,');
        qryRRA.Sql.Add('                  B.IDRUBRICANORMALRRA,');
        qryRRA.Sql.Add('                  1,');
        qryRRA.Sql.Add('                  B.IDRUBRICADEVOLUCAORRA) as RUBRICA,');
        qryRRA.Sql.Add('           DECODE(H.FLGDEVOLUCAO,');
        qryRRA.Sql.Add('                  1,');
        qryRRA.Sql.Add('                  B.IDRUBRICAREVDEVOLUCAORRA,');
        qryRRA.Sql.Add('                  B.IDRUBRICAREVATRASORRA) as RUBRICAREVISAO');
        }
        qryRRA.Sql.Add('           0 AS IDRUBRICA,');
        qryRRA.Sql.Add('           CASE WHEN H.FLGTIPOREGISTRO IN (0, 1) THEN');
        qryRRA.Sql.Add('                     DECODE(H.FLGDEVOLUCAO, 0, B.IDRUBRICAATRASORRA,');
        qryRRA.Sql.Add('                                            1, B.IDRUBRICADEVOLUCAORRA,0)');
        qryRRA.Sql.Add('                WHEN H.FLGTIPOREGISTRO IN (3, 4) THEN');
        qryRRA.Sql.Add('                     DECODE(H.FLGDEVOLUCAO, 0, B.IDRUBRICAREVATRASORRA,');
        qryRRA.Sql.Add('                                            1, B.IDRUBRICAREVDEVOLUCAORRA,0)');
        qryRRA.Sql.Add('           END RUBRICAREVISAO,');
        qryRRA.Sql.Add('           H.FONTEPAGADORA');
        // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim

        qryRRA.Sql.Add('      FROM HSTBENEFBFCIARIO H,');
        qryRRA.Sql.Add('           CTRLINTERFACE C,');
        qryRRA.Sql.Add('           BENEFPLANPREV B');
        // Felipe A. Santos - SOL 258357/17801 PPM 1083052 -início
        {
        qryRRA.Sql.Add('           (select P.VALORPARAM VALOR');
        qryRRA.Sql.Add('              from PARAMFOLHA P');
        qryRRA.Sql.Add('             where P.NOMEPARAM = ''RUBRICAIRRFRRA'') PARAM');}
       // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim
        qryRRA.Sql.Add('    where H.MESREFERENCIA <= TO_CHAR(TO_number(substr(H.MES,1,4))-1) ||''/13''');
        qryRRA.Sql.Add('       and H.FONTEPAGADORA IN (1, 2)'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - adicionado o fonte pagadora 1
        qryRRA.Sql.Add('       and C.IDLOTE = H.IDLOTE');
        qryRRA.Sql.Add('       and B.IDBENEFICIO = H.IDBENEFICIO');
        qryRRA.Sql.Add('       and B.IDPLANOPREV = H.IDPLANOPREV');
        //qryRRA.Sql.Add('       and B.IDRUBRICANORMALRRA is not null'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
        qryRRA.Sql.Add('       and b.IDRUBRICAATRASORRA is not null'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
        //qryRRA.Sql.Add('       and PARAM.VALOR is not null'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
        qryRRA.Sql.Add('       and H.IDLOTE = :idlote');
        qryRRA.Sql.Add('       and H.IDPESSOA =:idpessoa');
        qryRRA.Sql.Add('       and H.FLGENVIADO = 0');
        qryRRA.Sql.Add('     GROUP BY H.IDLOTE,');
        qryRRA.Sql.Add('              H.IDPLANOPREV,');
        qryRRA.Sql.Add('              H.IDBENEFICIO,');
        qryRRA.Sql.Add('              H.IDPESSOA,');
        qryRRA.Sql.Add('              H.IDTITULAR,');
        qryRRA.Sql.Add('              H.MES,');
        qryRRA.Sql.Add('              H.MESREFERENCIA,');
        qryRRA.Sql.Add('              C.MESREFERENCIA ,');
        qryRRA.Sql.Add('              H.FLGDEVOLUCAO,');
        qryRRA.Sql.Add('              H.DATAPAGAMENTO,');
        //qryRRA.Sql.Add('              B.IDRUBRICANORMALRRA,');   // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - comentado
        qryRRA.Sql.Add('              B.IDRUBRICAATRASORRA,'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
        qryRRA.Sql.Add('              B.IDRUBRICADEVOLUCAORRA,');
        qryRRA.Sql.Add('              B.IDRUBRICAREVDEVOLUCAORRA,');
        qryRRA.Sql.Add('              B.IDRUBRICAREVATRASORRA,');
        qryRRA.Sql.Add('              H.FONTEPAGADORA,'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
        qryRRA.Sql.Add('              H.FLGTIPOREGISTRO '); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
        qryRRA.Sql.Add('      union all');

        // Andre Imakawa - SIG 80955 - Inicio
        qryRRA.Sql.Add('SELECT 0 AS IDLOTE,');
        qryRRA.Sql.Add('       BF.IDPLANOPREV,');
        qryRRA.Sql.Add('       BF.IDBENEFICIO,');
        qryRRA.Sql.Add('       BF.IDPESSOA,');
        qryRRA.Sql.Add('       BF.IDTITULAR,');
        qryRRA.Sql.Add('       '''' AS MES,');
        qryRRA.Sql.Add('       COUNT(DISTINCT TD.MESREFERENCIA) OVER () AS QTDEMES,');
        qryRRA.Sql.Add('       TD.MESREFERENCIA,');
        qryRRA.Sql.Add('       '''' CTRLMESREFERENCIA,');
        qryRRA.Sql.Add('       SUM (CASE');
        qryRRA.Sql.Add('                                WHEN (BPP.IDRUBRICAREVDEVOLUCAORRA = TD.IDPROVENTO)');
        qryRRA.Sql.Add('                             OR (BPP.IDRUBRICACORDEVOLUCAORRA = TD.IDPROVENTO)');
        qryRRA.Sql.Add('                             OR (BPP.IDRUBRICADEVOLUCAORRA = TD.IDPROVENTO) THEN TD.VALOR * -1');
        qryRRA.Sql.Add('                                ELSE TD.VALOR');
        qryRRA.Sql.Add('                            END) AS VALORPREV,');
        qryRRA.Sql.Add('       NULL AS DATAPAGAMENTO,');
        qryRRA.Sql.Add('       TD.IDPROVENTO,');
        qryRRA.Sql.Add('       TD.IDPROVENTO as RUBRICAREVISAO,');
        qryRRA.Sql.Add('       BF.FONTEPAGADORA');
        qryRRA.Sql.Add('  FROM BENEFBFCIARIO BF INNER JOIN BENEFPLANPREV BPP ON BPP.IDPLANOPREV = BF.IDPLANOPREV');
        qryRRA.Sql.Add('   AND BPP.IDBENEFICIO = BF.IDBENEFICIO ');
        qryRRA.Sql.Add('   INNER JOIN TMPDESC TD ON TD.IDPESSOA = BF.IDPESSOA');
        qryRRA.Sql.Add('   AND BF.IDPLANOPREV = TD.IDPLANOPREV');
        qryRRA.Sql.Add('   AND BF.IDBENEFICIO = TD.IDDESCONTO');
        qryRRA.Sql.Add('   AND BF.IDPESSJUR = TD.IDPESSJUR');
        qryRRA.Sql.Add('   AND BF.IDTITULAR = TD.IDTITULAR');
        qryRRA.Sql.Add('   INNER JOIN PROVDESC PD ON PD.IDPROVENTO = TD.IDPROVENTO ');
        qryRRA.Sql.Add(' WHERE TD.IDPESSOA = :idpessoa');
        qryRRA.Sql.Add('   AND BF.FONTEPAGADORA IN (1,2)');
        qryRRA.Sql.Add('   AND BF.IDSITBENEFICIO <> 3');
        qryRRA.Sql.Add('   AND TD.MESREFERENCIA <= TO_CHAR(TO_number(substr('+QuotedStr(dtmFolhaPrevia.MesCobranca)+', 1, 4))-1) ||''/13''');
        qryRRA.Sql.Add('   AND (TD.SITENVIO = ''0'')');
        qryRRA.Sql.Add('   AND (TD.FLGDESCFOLHA = ''B'')');
        qryRRA.Sql.Add('  AND (TD.FLGTIPODESC IN (''C'',''P'',''A'',''E'',''K'',''D'',''J'')) ');
        qryRRA.Sql.Add('   AND (PD.FLGRRA = 1)');
        qryRRA.Sql.Add(' group by IDLOTE,');
        qryRRA.Sql.Add('       BF.IDPLANOPREV,');
        qryRRA.Sql.Add('       BF.IDBENEFICIO,');
        qryRRA.Sql.Add('       BF.IDPESSOA,');
        qryRRA.Sql.Add('       BF.IDTITULAR,');
        qryRRA.Sql.Add('       TD.MESREFERENCIA,');
        qryRRA.Sql.Add('       TD.IDPROVENTO,');
        qryRRA.Sql.Add('       TD.IDPROVENTO,');
        qryRRA.Sql.Add('       BF.FONTEPAGADORA');
        qryRRA.Sql.Add('      union all');
        // Andre Imakawa - SIG 80955 - Fim

        // recupera as rubricas individuais de RRA
        qryRRA.Sql.Add('    SELECT 0 AS IDLOTE,');
        qryRRA.Sql.Add('           BF.IDPLANOPREV,');
        qryRRA.Sql.Add('           BF.IDBENEFICIO,');
        qryRRA.Sql.Add('           BF.IDPESSOA,');
        qryRRA.Sql.Add('           BF.IDTITULAR,');
        qryRRA.Sql.Add('           '''' AS MES,');
        qryRRA.Sql.Add(' COUNT(DISTINCT RI.ANOMESREF) OVER () AS QTDEMES, ');
        qryRRA.Sql.Add('           RI.ANOMESREF,');
        qryRRA.Sql.Add('           '''' CTRLMESREFERENCIA,');
        qryRRA.Sql.Add('           SUM');
        qryRRA.Sql.Add('               (CASE');
        qryRRA.Sql.Add('                 WHEN (BPP.IDRUBRICAREVDEVOLUCAORRA = RI.IDRUBRICA) OR (BPP.IDRUBRICACORDEVOLUCAORRA = RI.IDRUBRICA) OR'); // Alterado por Felipe A. Santos - SOL 258357/17801 PPM 1083052
        qryRRA.Sql.Add('                      (BPP.IDRUBRICADEVOLUCAORRA = RI.IDRUBRICA)'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
        qryRRA.Sql.Add('                   THEN RI.VALORRUBRICA * -1');
        qryRRA.Sql.Add('                 ELSE RI.VALORRUBRICA');
        qryRRA.Sql.Add('                END) AS VALORPREV,');
        qryRRA.Sql.Add('           NULL AS DATAPAGAMENTO,');
        qryRRA.Sql.Add('           RI.IDRUBRICA,');
        qryRRA.Sql.Add('           RI.IDRUBRICA as RUBRICAREVISAO,');
        qryRRA.Sql.Add('           BF.FONTEPAGADORA');// Felipe A. Santos - SOL 258357/17801 PPM 1083052
        qryRRA.Sql.Add('       FROM BENEFBFCIARIO BF');
        qryRRA.Sql.Add('       INNER JOIN BENEFPLANPREV BPP ON');
        qryRRA.Sql.Add('             BPP.IDPLANOPREV = BF.IDPLANOPREV');
        qryRRA.Sql.Add('         AND BPP.IDBENEFICIO = BF.IDBENEFICIO');
        qryRRA.Sql.Add('       INNER JOIN RUBRICAINDIV RI ON');
