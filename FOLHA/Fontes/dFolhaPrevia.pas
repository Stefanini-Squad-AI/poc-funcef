function TobjRecebedor.VerificaAcoesEmLiminar: boolean;
var
  dDataFim: Tdatetime;
  sProcessoAux: string;
  iPos : integer;
  bAcao : Boolean;
begin
  result := false;
  if Not (dtmfolhaprevia.qrydetprocjudicial.isempty) then
  begin
    dtmfolhaprevia.qrydetprocjudicial.First;

    // Arnaldo WO7681 / WO4303
    // Alterado por Arnaldo V. Scarin
    // foi retirado o comando "and (not result)" do while, pois
    // no caso de existir mais de uma ação em julgamento, o Código abaixo
    // não avaliava corretamente os dados.
    while (not dtmfolhaprevia.qrydetprocjudicial.eof) do
    begin
      iPos := Pos('.' + dtmfolhaprevia.qrydetprocjudicial.fieldbyname('IDPROCJUD').AsString + '.', sProcessoAux);
      if (iPos = 0) then
      begin
        sProcessoAux := sProcessoAux + '.' + dtmfolhaprevia.qrydetprocjudicial.fieldbyname('IDPROCJUD').AsString + '.';
        // Guarda na data Final a data de termino da Ação Judicial
        dDataFim := dtmfolhaprevia.qrydetprocjudicial.fieldbyname('DATAFINAL').asDatetime;
        // Corrige a Data Final
        if (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('DATAFINAL').isnull) or (dDataFim = 0) or (datetostr(dDataFim) = '') then
          dDataFim := (dtmFolhaPrevia.DataPagamento + 1);
        // Arnaldo WO7681 / WO4303
        // Alterado por Arnaldo V. Scarin
        // O código original apresentava diversos if´s, aos quais foram ajustados, para otimização do
        // processamento. O processamento só deverá se executado se a data Inicial for Menor ou Igual
        // a data de Pagamento e se a Ação Judicial tiver Data Final for maior que a Data de Pagamento
        // da Folha, ela poderá ser avaliada, e deverá retornar verdadeiro, se na query de ações existir
        // uma ou mais Ações que estão em Julgamento
        if (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('DATAINICIO').asDatetime <= dtmFolhaPrevia.DataPagamento) then
        begin
          if ( (    (dDataFim >= dtmFolhaPrevia.DataPagamento)
                and (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('SITPROCESSO').asinteger = 0) ) or
               (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('SITPROCESSO').asinteger = 1) ) then
          begin
            //  Se não for compensação de irrf
            if (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('TIPOACAO').asinteger < 3) then
            begin
              // Situações possívels para as Acoes Judiciais (Campo SITPROCESSO):
              // 0 - Em Liminar
              // 1 - Ação Julgada Ganha
              // 2 - Ação Julgada Perdida
              //if (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('SITPROCESSO').asinteger = 0) then    //edilaine WO14714
              if (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('SITPROCESSO').asinteger < 2) then      //edilaine WO14714
                 AcrescentaAcaoJudicial(dtmFolhaPrevia.qryDetProcJudicial.fieldbyname('IDPROCJUD').asinteger,
                                        dtmFolhaPrevia.qryDetProcJudicial.fieldbyname('TIPOACAO').asinteger,
                                        dtmFolhaPrevia.qryDetProcJudicial.fieldbyname('PERCACAO').AsFloat,
                                        dtmFolhaPrevia.qryDetProcJudicial.fieldbyname('FLGFAZDEPOSITO').asinteger,
                                        dtmFolhaPrevia.qryDetProcJudicial.fieldbyname('SITPROCESSO').asinteger,
                                        dtmFolhaPrevia.qryDetProcJudicial.fieldbyname('FLGACAOEQUA').asinteger);  //leandro wo15216
              if not Result then
                Result := (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('SITPROCESSO').asinteger = 0);
            end
          end;
        end;
      end;
      dtmfolhaprevia.qrydetprocjudicial.next;
    end;
  end;
end;
//edilaine WO6905-6885 : fim


Function TobjRecebedor.AcaoJudicialEmLiminar : Boolean;
 var ddatafim: Tdatetime;
begin
  If dtmfolhaprevia.qrydetprocjudicial.isempty then
    result := false
  else
  begin
    dDataFim:=dtmfolhaprevia.qrydetprocjudicial.fieldbyname('DATAFINAL').asDatetime;
    If (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('DATAFINAL').isnull) or
       (dDataFim = 0) or
       (datetostr(dDataFim) = '') then
      ddataFim:=(dtmFolhaPrevia.DataPagamento+1);
    If (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('DATAINICIO').asDatetime >
        dtmFolhaPrevia.DataPagamento) then
      result := false
    else
    begin
      If (ddatafim < dtmFolhaPrevia.DataPagamento) then 
        result := false
      else
      begin
        //  Se não for compensação de irrf
        //If (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('TIPOACAO').asinteger <> 2) then
        if (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('TIPOACAO').asinteger < 3) then // Andre Imakawa - SIG 99651 // Andre Imakawa - SIG 134868
        begin
          // Ação Julgada Perdida
          If (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('SITPROCESSO').asinteger = 2) then
            result := false
          else
            // Ação Julgada Ganha
            If (dtmfolhaprevia.qrydetprocjudicial.fieldbyname('SITPROCESSO').asinteger = 1) then
              result := false
            else
              result := true
        end
        else
          result := false;
      end;
    end;
  end;
end;

