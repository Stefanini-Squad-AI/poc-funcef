procedure TdtmFolhaPrevia.RetornaGrupoRubrica(pIdRubrica: Integer;var pIdGrupoRubrica: Integer);
var
   auxSql : String;
   QryProvdesc         : TwwQuery;

begin
   try
     auxSql := 'SELECT NVL(TRIM(IDGRUPORUBRICA),0) AS IDGRUPORUBRICA FROM PROVDESC PD WHERE PD.IDPROVENTO = '+inttostr(pIdRubrica);
     QryProvdesc := TwwQuery.Create(nil);           //edilaine WO19556
     QryProvdesc.DataBaseName := 'BaseDados';

     QryProvdesc.close;
     QryProvdesc.SQL.clear;
     QryProvdesc.SQL.Add(auxSql);
     QryProvdesc.Open;

     if not QryProvdesc.isempty then
       pIdGrupoRubrica := StrToInt(QryProvdesc.fieldbyname('IDGRUPORUBRICA').AsString);

   finally
     FreeAndNil(QryProvdesc);
   end;


end;


