         lobjrub.rvalorprovento:=0;
         lobjrub.rvalorrecebido:=0;
        end;
        //edilaine WO24367 : fim
      end
      else // SOL 223400 Kintana 2057026 final
      begin
         lobjrub.rvalorprovento:=ArredondaMoeda(lrvalorrub-lrvalorusado);
         lobjrub.rvalorrecebido:=ArredondaMoeda(lrvalorrub-lrvalorusado);
      end;
    end;
  end;
  lstRubricas.Sorted:=true;
  dtmFolhaPrevia.qryAux3.close; // SOL 242740 PPM 575822
  dtmFolhaPrevia.QryAux.close; // SOL 242740 PPM 575822
end;

procedure TdtmFolhaPrevia.ProcessaFechamentoRecebedor(aobjrecebedor : tobjrecebedor;
  brecebedorpa : boolean;
  var bErroInserePrevia:Boolean);          // Andre Imakawa - SIG 80669
 var lii, lik: integer;
     smsgerro: string;
     iFlgEnvia: integer;
     objplano: tobjplano;
     splaconta: string;
     iRecebePGTO : Integer;
     bRateioProgressivo, bRateioRegressivo: Boolean;
begin
  try
    //Showmessage('Fechamento recebedor');
    if aobjRecebedor.bInstanciado then
    begin
      aobjRecebedor.BuscaBeneficiariosResponsavel;

      //TRATAR QDO NÃO TEM PROVENTO TIPO 'B'
      if aobjRecebedor.sUltMesRefReal = '' then
        aobjRecebedor.sUltMesRefReal := dtmFolhaPrevia.MesCobranca;

      //PEGA CONTA LIQUIDO
      try
        if not brecebedorpa then
          aobjrecebedor.splacontaliqglobal := dtmContabil.AchaContaLiquidoBeneficio( aobjrecebedor.iidpatro,
                                                                                     aobjrecebedor.iidplanoprevglobal,
                                                                                     aobjrecebedor.iidbeneficiobase);
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT1).',
                                       aobjrecebedor);

          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      try
        //ALTERA ENVIO DE CONTRIBUIÇÃO NO ABONO
        if (((aobjrecebedor.iidmotivofolha = prmIdMotivoFolhaBen) and
              not (aobjrecebedor.iflgtipofolha in [3,4])) or
            ((aobjrecebedor.iidmotivofolha = prmIdMotivoAbono) and
              (aobjrecebedor.iflgtipofolha in [3,4]))) and not brecebedorpa then
        begin
          if (aobjrecebedor.iflgconcessaolote = 1) then
            iFlgEnvia:=SistemaFolha.FlgEnviaContribConcessao
          else
            iFlgEnvia:=SistemaFolha.FlgEnviaContribManutencao;

          //ENVIAR CONTRIBUIÇÕES DE TODAS AS PESSOAS VINCULADAS AO RESPONSAVEL
          if (not brecebedorpa) and (iFlgEnvia > 0) then
          begin
            for lii:=0 to aobjrecebedor.lstPessoas.count-1 do

              for lik:=0 to aobjrecebedor.lstPlanos.count-1 do
                EnviaContribAssistTmpDesc(
                  qryAux, qryAux2,
                  inttostr(aobjrecebedor.iidtitular),
                  aobjrecebedor.lstPessoas[lii],
                  inttostr(aobjrecebedor.iidPatro),
                  aobjrecebedor.lstPlanos[lik],
                  aobjrecebedor.iidlote,
                  1,
                  MesCobranca,
                  MesCobranca,
                  0,
                  sMsgErro,
                  0,
                  nil,
                  nil,
                  0,
                  iFlgEnvia,
                  aobjrecebedor.iflgprovisorio);
          end;
        end;
        //SE NÃO TEM OPÇÃO ATRIBUIR ZERO
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT1).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      try
        if aobjrecebedor.rValorBaseBen1 = -1 then
          aobjrecebedor.rValorBaseBen1:=0;
        if aobjrecebedor.rValorBaseBen2 = -1 then
          aobjrecebedor.rValorBaseBen2:=0;
        if aobjrecebedor.rValorBaseBen2 = -1 then
          aobjrecebedor.rValorBaseBen2:=0;

        aobjrecebedor.ProcessaRubrica; //processa rubricas externas (Tmpdesc e Rubricaindiv)
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT2).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      try
        if not brecebedorpa then
          aobjrecebedor.CalculaCorrecaoTmpDesc;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT3).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      try
        aobjrecebedor.ExecutaRegraRubrica(false);
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT4).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      try
        aobjrecebedor.ExecutaRegraRubrica(true);
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT5).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      try
        aobjrecebedor.DeterminaBasesIRRF;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT6).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      try
        aobjrecebedor.ApuraIRRF;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT6.1).', aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      // Aline Freire e Bruno Azevedo SOL 155182 Kintana 1228739
      try
        if (bLancouRRA) and  // SOL 205497 KTN 1987890 - Otacilio
           not(objrecebedor.iflgtipofolha in [3,4])  // não executar o cálculo de IRRF do RRA quando o tipo da folha for abono //  Felipe A. Santos SOL 258357/17801 PPM 1083052
        then
          aobjrecebedor.VerificaIRRFRRA;

      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;
      // Aline Freire e Bruno Azevedo SOL 155182 Kintana 1228739

      try
        aobjrecebedor.CalculoIRRF;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT7).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;


      try
        aobjrecebedor.DeterminaBaseSalarioFamilia;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT8).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      try
        aobjrecebedor.CalculoSalarioFamilia;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT9).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      try
        aobjrecebedor.CalculaValorCMPFSobreINSS(not brecebedorpa);
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT11).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      try
        aobjrecebedor.VerificaMargemDesconto(1);
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT10).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      //executar apenas arredondamento
      try
        aobjrecebedor.CalculaArredondamentoLiquido(not brecebedorpa);
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT11).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;


      //acrescenta teste para gerar consignatário apenas se previa não bloqueada
      if (aobjrecebedor.ibloqueiaprevia = 0) then
      begin
        try
          if not brecebedorpa then
            aobjrecebedor.ProcessaFavorecidos(bErroInserePrevia); // Andre Imakawa - SIG 80669
        except
          on E:Exception do
          begin
            dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT12).',
              aobjrecebedor);
            dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
            dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
            exit;
          end;
        end;
      end;

      //CONTROLA REPROCESSAMENTO DAS MARGENS PELA ENTRADA DA CPMF DE PA
      if aobjrecebedor.bTemCPMFPA then
      begin
        for lii:=0 to aobjrecebedor.lstRubricas.count-1 do
          with TobjRubrica(aobjrecebedor.lstRubricas.objects[lii]) do
            if iflgdesconto = 1 then
            begin
              rValorprovento:=0;
              bpossuimargem:=false;
            end;

        //EFETUA NOVA VERIFICAÇÃO DA MARGEM DE DESCONTO PORQUE ENTROU A RUBRICA DE CPMF SOBRE A PA
        try
          aobjrecebedor.VerificaMargemDesconto(2);
        except
          on E:Exception do
          begin
            dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT10_2).',
              aobjrecebedor);
            dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
            dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
            exit;
          end;
        end;
      end;

      try
        if ((not brecebedorpa) and (aobjrecebedor.smespagliberacao = Mescobranca)) then //Adiantamento
           PrimeiroPGTDefinitivo;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT13).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      // SOL 252343/17434 PPM 874741
      {try
        if Not brecebedorpa Then
          if SistemaFolha.flgusamargem3070 = 1 then
            if not (aobjrecebedor.iflgtipofolha in [3,4]) then
              if not dtmFolhaPrevia.FolhaReserva then //CALCULA ESTRUTURAS DE CALCULO SE NAO FOR FOLHA DE RESERVA
                aobjrecebedor.CalculaEstruturasCalculo;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT14).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end; }
      // SOL 252343/17434 PPM 874741

      If SistemaFolha.VerificaRecebedorDuplicado = 1 Then
      Begin
        If aobjrecebedor.TemRecebedorDuplicado Then
        Begin

          aobjrecebedor.ibloqueiaprevia := 3;
        End
      End;

      aobjrecebedor.iseqdocumento:=ctrlBCP.DefineSeqDocumento(
        aobjrecebedor.rliquidototal, aobjrecebedor.objPortResp);

      //acrescenta teste para gravar rubricas apenas se previa não bloqueada
      if (aobjrecebedor.ibloqueiaprevia = 0) then
      begin
        //FAZ O RATEIO DAS RUBRICAS POR PLANO
        try
          if not brecebedorpa and aobjrecebedor.TemRateioAFazer and
            (aobjrecebedor.lstPlanos.count > 1) and (SistemaFolha.RateioPlanoRubrica > 0) then
          begin
            iPlanosComIrrf := 0; //Renato Visoni SOL 114192 KINTANA 532893
            iIdPlanos      := 0; //Renato Visoni SOL 114192 KINTANA 532893

               aobjrecebedor.ProcessaRateioRubricas;
          end;
        except
          on E:Exception do
          begin
            dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT16).',
              aobjrecebedor);
            dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
            dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
            exit;
          end;
        end;

        // Andre Imakawa - SIG 99651 - Inicio
        // Rateio de Rubricas REINF

        try
          //if aobjrecebedor.VerificaProporcaoPlanos(bRateioProgressivo, bRateioRegressivo) then //wo20725 leandro
          if aobjrecebedor.VerificaProporcaoPlanos(bRateioProgressivo, bRateioRegressivo, aobjrecebedor.iidresponsavel, aobjrecebedor.iidplanoprevglobal) then   //wo20725 leandro
          begin
            if not brecebedorpa and ( SistemaFolha.RateioPlanoRubrica > 0) then
              aobjrecebedor.ProcessaRateioRubricasReinf(bRateioProgressivo, bRateioRegressivo);
          end;
        except
          on E:Exception do
          begin
            dtmFolhaPrevia.ExibeMensagem('Erro no processamento (REINF01).',
              aobjrecebedor);
            dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
            dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
            exit;
          end;
        end;

        // Andre Imakawa - SIG 99651 - Fim

        try
          aobjrecebedor.EfetivaRubricas(bErroInserePrevia);    // Andre Imakawa - SIG 80669
        except
          on E:Exception do
          begin
            dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT15).',
              aobjrecebedor);
            dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
            dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
            exit;
          end;
        end;
      end
      else
      begin
        dtmFolhaPrevia.ExibeMensagemSemRecebedor('*** ATENÇÃO ***');
        dtmFolhaPrevia.ExibeMensagemSemRecebedor('Não foi gerada Prévia para este recebedor. Motivo:');
        case aobjrecebedor.ibloqueiaprevia of
        1: begin
             dtmFolhaPrevia.ExibeMensagemSemRecebedor(' Existe mais de um contas/caixas x forma de pagamento associado a seu consignatário.');
             dtmFolhaPrevia.ExibeMensagem(' Verificar Cadastro de Rubricas Individuais.',
               aobjrecebedor);
           end;
        2: begin
             dtmFolhaPrevia.ExibeMensagemSemRecebedor(' Existem lançamentos a pagar para benefício pendente de concessão.');
             dtmFolhaPrevia.ExibeMensagem(' Verificar a concessão.',
               aobjrecebedor);
           end;
        3: begin
             dtmFolhaPrevia.ExibeMensagemSemRecebedor('Possui mais de um recebedor');
             dtmFolhaPrevia.ExibeMensagemSemRecebedor('DADOS DO RECEBEDOR: ' + PegaDadosRecebedor(aobjrecebedor));
             dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
           end;
        end;
        dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
      end;

      //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319
      //faz correcao dos valores de desconto
      //em basedepagamentoprevia
      //é feito nesse ponto pq precisa
      //que todas rubricas já tenham sido calculadas
      try
        aobjrecebedor.CorrigeValorDescontoBaseDePagamentoPrevia;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT7-C).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;
      //FIM Helio - SOL Nº 151061-10442 KINTANA Nº 1720319


      try
        aobjrecebedor.VerificaLimiteEquacionamento;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT17).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;

      // Andre Imakawa - SIG 99651 - Inicio
      // Processa REINF
      try
        aobjrecebedor.ProcessaReinf(bErroInserePrevia);
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (REINF00).',
            aobjrecebedor);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          //exit;
        end;
      end;
      // Andre Imakawa - SIG 99651 - Fim


      try
        aobjrecebedor.LimpaDados;
      except
        on E:Exception do
        begin
          dtmFolhaPrevia.ExibeMensagem('Erro no processamento (INT16).',
                                        aobjrecebedor);

          dtmFolhaPrevia.ExibeMensagemSemRecebedor('Mensagem de erro : '+E.message);
          dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
          exit;
        end;
      end;
    end;
  finally
    if not brecebedorpa then
      if not qryPrevia.eof then
      begin
        //IF qryPrevia.fieldbyname('IDRESPONNAOREC').AsInteger > 0 AND     //CPrev - 27921
        IF (qryPrevia.fieldbyname('IDRESPONNAOREC').AsInteger > 0) AND     //CPrev - 27921
           (qryPrevia.fieldbyname('FLGDESTBENEF').AsString    = 'E') Then  //CPrev - 27921
          iRecebePGTO := qryPrevia.fieldbyname('IDRESPONNAOREC').AsInteger
        Else
          iRecebePGTO := qryPrevia.fieldbyname('IDRESPONSAVEL').AsInteger;

        if not CriaRecebedor(qryPrevia.fieldbyname('numeroprocesso').asinteger,
                             qryPrevia.fieldbyname('idfundacao').asinteger,
                             qryPrevia.fieldbyname('idpessjur').asinteger,
                             qryPrevia.fieldbyname('idplanoprev').asinteger,
                             qryPrevia.fieldbyname('idplanoorigem').asinteger,
                             qryPrevia.fieldbyname('idplanocontabil').asinteger,
                             qryPrevia.fieldbyname('idtitular').asinteger,
                             qryPrevia.fieldbyname('responsavel').asinteger,
                             iRecebePGTO,
                             qryPrevia.fieldbyname('idlote').asinteger,
                             qryPrevia.fieldbyname('numdepirrf').asinteger,
                             qryPrevia.fieldbyname('NUMDEPSALF').asinteger,
                             qryPrevia.fieldbyname('flgisentoirrf').asinteger,
                             //qryPrevia.fieldbyname('FLGISENTOIRRFATUALIZADO').asinteger, // SOL 214520 - KTN 2042434
                             qryPrevia.fieldbyname('seqproposta').asinteger,
                             qryPrevia.fieldbyname('flgconcessao').asinteger,
                             qryprevia.fieldbyname('FLGDESCIRMES').asinteger,
                             qryprevia.fieldbyname('FLGMOLESTIAGRAVE').asinteger,
                             //qryprevia.fieldbyname('FLGMOLESTIAGRAVEATUALIZADO').asinteger, // SOL 214520 - KTN 2042434
                             qryprevia.fieldbyname('FLGSOMAIRSUPINSS').asinteger,
                             qryPrevia.fieldbyname('codportforma').asinteger,
                             qryPrevia.fieldbyname('dfloatpagto').asinteger,
                             qryPrevia.fieldbyname('datanasc').asdatetime,
                             qryPrevia.fieldbyname('datarequerimento').asdatetime,
                             qryPrevia.fieldbyname('numprocinss').asstring,
                             qryPrevia.fieldbyname('FLGPROVISORIO').asinteger,
                             qryPrevia.fieldbyname('DATALIBERACAO').asDatetime,
                             qryPrevia.fieldbyname('MESPAGLIBERACAO').asString,
                             qryprevia.fieldbyname('DATACONCESSAO').asDateTime,
                             qryprevia.fieldbyname('DATAFIMMOLESTIA').asDateTime,
                             qryprevia.fieldbyname('DATAMOLESTIAGRAVE').asDateTime, // SOL 214520 - KTN 2042434
                             false,
                             dtmFolhaPrevia.qryPrevia.fieldbyname('VALORBASE1').asfloat,
                             dtmFolhaPrevia.qryPrevia.fieldbyname('VALORBASE2').asfloat,
                             dtmFolhaPrevia.qryPrevia.fieldbyname('VALORBASE3').asfloat,
                             dtmFolhaPrevia.qryPrevia.fieldbyname('VALORBASE4').asfloat,
                             dtmFolhaPrevia.qryPrevia.fieldbyname('VALORBASE5').asfloat,
                             dtmFolhaPrevia.qryPrevia.fieldbyname('VALORBASE6').asfloat,
                             dtmFolhaPrevia.qryPrevia.fieldbyname('DATAINICIO').asdatetime,
                             dtmFolhaPrevia.qryPrevia.fieldbyname('MESCOMPREEM').asstring, // SOL 140042 Kintana 900220
                             dtmFolhaPrevia.qryPrevia.fieldbyname('TPMODALIDADE').asstring, //SOL 257943 PPM 970494
                             objRecebedor) then
          dtmFolhaPrevia.ExibeMensagem('Erro ao criar Recebedor', aobjrecebedor)
        else
        begin
          dtmFolhaPrevia.AvaliaDadoBancario(objRecebedor);
          //TRATAR TIPO DE FOLHA PARA DIFERENCIAR NO ABONO
          objrecebedor.iflgtipofolha:=qryPrevia.fieldbyname('FLGTIPOFOLHA').asinteger;
        if (copy(qryPrevia.fieldbyname('mes').asstring,6,2) = '12') and
           (copy(qryPrevia.fieldbyname('mesreferencia').asstring,6,2)  = '13') and
           ((Copy(qryPrevia.fieldbyname('Mes').asstring,1,4)) = (Copy(qryPrevia.fieldbyname('mesreferencia').asstring,1,4))) then //Renato Visoni  SOL 104908 Kintana 469824
          objrecebedor.iflgtipofolha:=3;
        end;
      end;
  end;
TemBitr:=false; //SOL205224 douglas.siqueira
end;

procedure TdtmFolhaPrevia.ResolveRubrica(var aiidrubrica, aiidmotivo : integer;
  var smsg: string ; iSituacao: integer; iIdTitular, iIdLote: Integer; rValor: Double);
begin
  //BRUNO AZEVEDO - SOL 252347 KINTANA 755091 - PROJETO DE MELHORIA DA FOLHA
  //VERIFICAR SE A PESSOA DA RUBRICA ATUAL TEM RRA MESMO
  //TIRAMOS TODA PARTE DE RUBRICA INDIVIDUAL DESTA QUERY, VISTO QUE A RUBRICA INDIVIDUAL JÁ É LANÇADA COMO RRA
  if  (ListaPessoasComRRA.IndexOf(dtmFolhaPrevia.qryPrevia.fieldbyname('IdPessoa').AsString) <> -1)
  and (ListaBeneficiosComRRA.IndexOf(dtmFolhaPrevia.qryPrevia.fieldbyname('IDBENEFICIO').AsString) <> -1) // Felipe Azevedo e Bruno Azevedo - SOL 267468 PPM 1232462
  ////BRUNO AZEVEDO SOL 267609, 267611 e 267612 PPM 1235585, 1235586 e 1235587
  and (ListaPessoasComRRAxBeneficio.IndexOf(dtmFolhaPrevia.qryPrevia.fieldbyname('IdPessoa').AsString+';'+dtmFolhaPrevia.qryPrevia.fieldbyname('IDBENEFICIO').AsString) <> -1)
  then begin
    // SOL 155182 Kintana 1228739 Bruno Azevedo e Aline Freire
    // VERIFICAR A RUBRICA DE RRA E JA LANÇAR CORRETAMENTE PRA NAO PRECISAR FAZER UPDATE E NAO INCINDIR IR
    //With dtmFolhaPrevia do
    begin
      qryRRA.Close;
      qryRRA.Sql.Clear;
      qryRRA.Sql.Add('    SELECT   ');
      qryRRA.Sql.Add('           IDPLANOPREV,');
      qryRRA.Sql.Add('           FLGDEVOLUCAO,');  //BRUNO OTACILIO SOL206962
      qryRRA.Sql.Add('           IDBENEFICIO,');
      qryRRA.Sql.Add('           IDPESSOA,');
      qryRRA.Sql.Add('           IDTITULAR,');
      qryRRA.Sql.Add('           MESREFERENCIA,');
      qryRRA.Sql.Add('    sum(VALORPREV) AS VALORPREV,');
      qryRRA.Sql.Add('           RUBRICAREVISAO,');
      qryRRA.Sql.Add('           FONTEPAGADORA'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
      qryRRA.Sql.Add('      FROM (');
      qryRRA.Sql.Add('    select H.IDLOTE,');
      qryRRA.Sql.Add('           H.FLGDEVOLUCAO,');  //BRUNO OTACILIO SOL206962
      qryRRA.Sql.Add('           H.IDPLANOPREV,');
      qryRRA.Sql.Add('           H.IDBENEFICIO,');
      qryRRA.Sql.Add('           H.IDPESSOA,');
      qryRRA.Sql.Add('           H.IDTITULAR,');
      qryRRA.Sql.Add('           H.MES,');
      qryRRA.Sql.Add('           H.MESREFERENCIA,');
      qryRRA.Sql.Add('           C.MESREFERENCIA CTRLMESREFERENCIA,');
      qryRRA.Sql.Add('           H.VALORPREV as VALORPREV,');
      qryRRA.Sql.Add('           H.DATAPAGAMENTO,');

      // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - início

      // RN99
      //qryRRA.Sql.Add('      CASE WHEN H.FLGTIPOREGISTRO IN (0, 1) THEN');  // tipo de registro normal ou abono  // Andre Imakawa - SIG 80669
      qryRRA.Sql.Add('      CASE WHEN H.FLGTIPOREGISTRO IN (0, 1, 2) THEN');  // tipo de registro normal ou abono // Andre Imakawa - SIG 80669
//      qryRRA.Sql.Add('                DECODE(H.FLGDEVOLUCAO, 0, IDRUBRICAATRASORRA,'); // forma igual a pagamento           //Everson TIBERO
      qryRRA.Sql.Add('                DECODE(H.FLGDEVOLUCAO, 0, B.IDRUBRICAATRASORRA,'); // forma igual a pagamento           //Everson TIBERO
//      qryRRA.Sql.Add('                                       1, IDRUBRICADEVOLUCAORRA,0)'); // forma igual a cobrança       //Everson TIBERO
      qryRRA.Sql.Add('                                       1, B.IDRUBRICADEVOLUCAORRA,0)'); // forma igual a cobrança       //Everson TIBERO
      //qryRRA.Sql.Add('           WHEN H.FLGTIPOREGISTRO IN (3, 4) THEN'); // Tipo de registro revisão normal e revisão abono      // Andre Imakawa - SIG 80669
      qryRRA.Sql.Add('           WHEN H.FLGTIPOREGISTRO IN (3, 4, 5) THEN'); // Tipo de registro revisão normal e revisão abono     // Andre Imakawa - SIG 80669
//      qryRRA.Sql.Add('                DECODE(H.FLGDEVOLUCAO, 0, IDRUBRICAREVATRASORRA,');  // forma igual a pagamento       //Everson TIBERO
      qryRRA.Sql.Add('                DECODE(H.FLGDEVOLUCAO, 0, B.IDRUBRICAREVATRASORRA,');  // forma igual a pagamento       //Everson TIBERO
//      qryRRA.Sql.Add('                                       1, IDRUBRICAREVDEVOLUCAORRA,0)'); // forma igual a cobrança    //Everson TIBERO
      qryRRA.Sql.Add('                                       1, B.IDRUBRICAREVDEVOLUCAORRA,0)'); // forma igual a cobrança    //Everson TIBERO
      qryRRA.Sql.Add('       END RUBRICAREVISAO,');

      {qryRRA.Sql.Add('           DECODE(H.FLGDEVOLUCAO,');
      qryRRA.Sql.Add('                  0,');
      qryRRA.Sql.Add('                  B.IDRUBRICANORMALRRA,');
      qryRRA.Sql.Add('                  1,');
      qryRRA.Sql.Add('                  B.IDRUBRICADEVOLUCAORRA) as RUBRICA,');
      qryRRA.Sql.Add('           DECODE(H.FLGDEVOLUCAO,');
      qryRRA.Sql.Add('                  1,');
      qryRRA.Sql.Add('                  B.IDRUBRICAREVDEVOLUCAORRA,');
      qryRRA.Sql.Add('                  B.IDRUBRICAREVATRASORRA) as RUBRICAREVISAO'); }

      qryRRA.Sql.Add('           H.FONTEPAGADORA');
      // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim
      qryRRA.Sql.Add('      FROM HSTBENEFBFCIARIO H,');
      qryRRA.Sql.Add('           CTRLINTERFACE C,');
      qryRRA.Sql.Add('           BENEFPLANPREV B,');
      qryRRA.Sql.Add('           (select P.VALORPARAM VALOR');
      qryRRA.Sql.Add('              from PARAMFOLHA P');
      qryRRA.Sql.Add('             where P.NOMEPARAM = ''RUBRICAIRRFRRA'') PARAM');
      qryRRA.Sql.Add('    where H.MESREFERENCIA <= TO_CHAR(TO_number(substr(H.MES,1,4))-1) ||''/13''');
      qryRRA.Sql.Add('       and H.FONTEPAGADORA =' + qryPrevia.FieldByName('FONTEPAGADORA').AsString); // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fonte pagadora agora é passado como parâmetro
      qryRRA.Sql.Add('       and C.IDLOTE = H.IDLOTE');
      qryRRA.Sql.Add('       and B.IDBENEFICIO = H.IDBENEFICIO');
      qryRRA.Sql.Add('       and B.IDPLANOPREV = H.IDPLANOPREV');

      // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - início
      //qryRRA.Sql.Add('       and B.IDRUBRICANORMALRRA is not null');

      // se esse campo estiver preenchido significa que é RRA, utilizei um dos seis campo de RRA da BENEFPLANPREV
      // pois na teoria se um está preenchido todos tem que estar, Validação da RNG98.
      qryRRA.Sql.Add('       and B.IDRUBRICAATRASORRA IS NOT NULL');
      // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim

      qryRRA.Sql.Add('       and PARAM.VALOR is not null');
      qryRRA.Sql.Add('       and H.IDLOTE = :idlote');
      qryRRA.Sql.Add('       and H.IDPESSOA =:idpessoa');
      qryRRA.Sql.Add('       and H.IDPESSOA =:idpessoa');
      qryRRA.Sql.Add('           )');
      qryRRA.Sql.Add('           GROUP BY');
      qryRRA.Sql.Add('           IDPLANOPREV,');
      qryRRA.Sql.Add('           FLGDEVOLUCAO,'); //BRUNO OTACILIO SOL206962
      qryRRA.Sql.Add('           IDBENEFICIO,');
      qryRRA.Sql.Add('           IDPESSOA,');
      qryRRA.Sql.Add('           IDTITULAR,');
      qryRRA.Sql.Add('           MESREFERENCIA,');
      qryRRA.Sql.Add('           RUBRICAREVISAO,');
      qryRRA.Sql.Add('           FONTEPAGADORA'); // Felipe A. Santos - SOL 258357/17801 PPM 1083052
      qryRRA.ParamByName('IDPESSOA').asinteger := dtmFolhaPrevia.qryPrevia.fieldbyname('IdPessoa').asinteger;// Felipe A. Santos - SOL 258357/17801 PPM 1083052
      qryRRA.ParamByName('IDLOTE').asinteger    := iIdLote; // Felipe A. Santos - SOL 258357/17801 PPM 1083052

      cdsRRA.close;
      //cdsRRA.Params.ParamByName('IDPESSOA').asinteger := dtmFolhaPrevia.qryPrevia.fieldbyname('IdPessoa').asinteger; // Felipe A. Santos - SOL 258357/17801 PPM 1083052
      //cdsRRA.Params.ParamByName('IDLOTE').asinteger   := iIdLote; // Felipe A. Santos - SOL 258357/17801 PPM 1083052
      cdsRRA.Open;

      // SOL 205497 KTN 1987890 - Otacilio ** Inicio **
      if iAltidPessoa <> dtmFolhaPrevia.qryPrevia.fieldbyname('IdPessoa').asinteger then
      begin
        bLancouRRA := False;
        iAltidPessoa := dtmFolhaPrevia.qryPrevia.fieldbyname('IdPessoa').asinteger;
      end;
      // SOL 205497 KTN 1987890 - Otacilio ** Fim **

      if (cdsRRA.Recordcount > 0) then begin
        while not cdsRRA.Eof do begin
          // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - adicionado o fonte pagadora igual a Fundação = 1
          {//SOMENTE INSS POIS O FUNCEF PAGA NORMAL } // Comentário ao lado excluído - Agora aceita FUNCEF e INSS
          if (((qryPrevia.FieldByName('FONTEPAGADORA').AsString = '2') or (qryPrevia.FieldByName('FONTEPAGADORA').AsString = '1')) and
              //BRUNO OTACILIO SOL206962
             (qryPrevia.FieldByName('FLGDEVOLUCAO').AsString = cdsRRA.FieldByName('FLGDEVOLUCAO').AsString) and //VERIFICAR TBM O FLGDEVOLUCAO
             (qryPrevia.FieldByName('MESREFERENCIA').AsString = cdsRRA.FieldByName('MESREFERENCIA').AsString)) then
          begin
            if (cdsRRA.FieldByName('RUBRICAREVISAO').asString <> '') then    //SOL 266389 PPM 1201608
            begin
               aiidrubrica := cdsRRA.FieldByName('RUBRICAREVISAO').asinteger;
               bLancouRRA := True; // SOL 205497 KTN 1987890 - Otacilio
               bverificaRRA := True; //SOL 266389 PPM 1201608
               Exit;
            end; //SOL 266389 PPM 1201608
          end;
          cdsRRA.Next;
        end;
      end;
    end;
  end;
  //BRUNO AZEVEDO - SOL 252347 KINTANA 755091 - PROJETO DE MELHORIA DA FOLHA

  TemAntecipacaoAbono := False; //Renato Visoni SOL 127985

  if qryPrevia.FieldByName('IDMOTIVO').isnull then
    aiidmotivo:=prmIDMOTIVOFOLHABEN
  else
    aiidmotivo:=qryPrevia.FieldByName('IDMOTIVO').asinteger;

  If (prmIdMotivoQuitacao = aiidmotivo) And
     (Not qryPrevia.FieldByName('IDRUBRICAQUITANT').IsNull) Then
  Begin
    aiidrubrica := qryPrevia.FieldByName('IDRUBRICAQUITANT').asinteger;
    Exit;
  End;

  //USAR RUBRICA NORMAL SE NÃO TIVER A DE ADIANTAMENTO
  aiidrubrica:=qryPrevia.FieldByName('IDRUBRICA').asinteger;

  //ALTERADO PARA TRATAR CASOS DE ACAO JUD NO ABONO
  if copy(qryPrevia.FieldByName('MESREFERENCIA').AsString, 6, 2) = '13' then
  begin
    //TRATA BENEFICIO DE REFERENCIA
    if (qryPrevia.FieldByName('FLGREFERENCIA').asinteger = 0) then
    begin
      //TRATAR MESMO ANO DA FOLHA E ANO ANTERIOR
      if copy(qryPrevia.FieldByName('MESREFERENCIA').AsString, 1, 4) <>
         copy(dtmFolhaPrevia.MesCobranca,1,4) then
      begin
        //TRATAR ABONO DE ANOS ANTERIORES
        //AÇÃO JUDICIAL GANHA ABERTURA DE RUBRICA
        if (SistemaFolha.FLGABRERUBACJUD = 1) and (iSituacao = 1) then
        begin
          if (not qryPrevia.FieldByName('IDRUBATR13ACJUD').isnull) Then
            aiidrubrica:=qryPrevia.FieldByName('IDRUBATR13ACJUD').asinteger
          else
            if (not qryPrevia.FieldByName('IDRUB13ACJUD').isnull) Then
              aiidrubrica:=qryPrevia.FieldByName('IDRUB13ACJUD').asinteger;
        end
        else
        begin
          //ANTECIPAÇÃO DE ABONO
          if (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 2) or
             (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 5) then
          begin

            If qryPrevia.FieldByName('FLGDEVOLUCAO').AsInteger = 0 Then //CPrev - 26824
              TemAntecipacaoAbono:=true; 

            if (not qryPrevia.FieldByName('IDRUBACERTOABONO').isnull) Then
              aiidrubrica:=qryPrevia.FieldByName('IDRUBACERTOABONO').asinteger
            else
              if (not qryPrevia.FieldByName('IDRUBANTECABONO').isnull) Then
                aiidrubrica:=qryPrevia.FieldByName('IDRUBANTECABONO').asinteger;
          end
          else
          begin
            if (not qryPrevia.FieldByName('IDRUBATRASOABONO').isnull) Then
              aiidrubrica:=qryPrevia.FieldByName('IDRUBATRASOABONO').asinteger
            else
              if (not qryPrevia.FieldByName('IDRUBABONO').isnull) Then
                aiidrubrica:=qryPrevia.FieldByName('IDRUBABONO').asinteger;
          end;
        end;
      end
      else
      begin
        if (qryPrevia.FieldByName('IDSITBENEFICIO').asinteger = 3) and
           (qryPrevia.FieldByName('FLGABONOFINALBEN').asinteger = 1) and
           (not qryPrevia.FieldByName('DATAFINAL').isnull) then
          aiidrubrica:=qryPrevia.FieldByName('IDRUBABONO').asinteger
        else
        begin
          //TRATAR FLGTIPOREGISTRO NA ATRIBUIÇÃO DA RUBRICA DE BENEFÍCIO
          if (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 2) or
             (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 5) then
          begin
            If qryPrevia.FieldByName('FLGDEVOLUCAO').AsInteger = 0 Then //CPrev - 26824
              TemAntecipacaoAbono := true; 

            if not qryPrevia.FieldByName('IDRUBANTECABONO').isnull then
              aiidrubrica:=qryPrevia.FieldByName('IDRUBANTECABONO').asinteger;
          end
          else
          begin
            //TRATAR ABONO DE ANOS ANTERIORES
            //AÇÃO JUDICIAL GANHA ABERTURA DE RUBRICA
            if (SistemaFolha.FLGABRERUBACJUD = 1) and (iSituacao = 1) then
            begin
              if (not qryPrevia.FieldByName('IDRUB13ACJUD').isnull) Then
                aiidrubrica:=qryPrevia.FieldByName('IDRUB13ACJUD').asinteger;
            end
            else
            begin
              if not qryPrevia.FieldByName('IDRUBABONO').isnull then
                aiidrubrica:=qryPrevia.FieldByName('IDRUBABONO').asinteger;
            end;
          end;
        end;
      end;
    end
    else
    begin //BENEFÍCIO DE INSS
      //TRATAR FLGTIPOREGISTRO NA ATRIBUIÇÃO DA RUBRICA DE BENEFÍCIO
      if (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 2) or
         (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 5) then
      begin
        If qryPrevia.FieldByName('FLGDEVOLUCAO').AsInteger = 0 Then //CPrev - 26824
          TemAntecipacaoAbono := true; 

        if not qryPrevia.FieldByName('IDRUBANTECABONO').isnull then
          aiidrubrica:=qryPrevia.FieldByName('IDRUBANTECABONO').asinteger;
      end
      else
      begin
        //TRATAR ABONO DE ANOS ANTERIORES
        if copy(qryPrevia.FieldByName('MESREFERENCIA').AsString, 1, 4) <>
           copy(dtmFolhaPrevia.MesCobranca,1,4) then
        begin
          if (not qryPrevia.FieldByName('IDRUBATRASOABONO').isnull) Then
            aiidrubrica:=qryPrevia.FieldByName('IDRUBATRASOABONO').asinteger
          else
            if not qryPrevia.FieldByName('IDRUBABONO').isnull then
              aiidrubrica:=qryPrevia.FieldByName('IDRUBABONO').asinteger;
        end
        else
        begin
          if not qryPrevia.FieldByName('IDRUBABONO').isnull then
            aiidrubrica:=qryPrevia.FieldByName('IDRUBABONO').asinteger;
        end;
      end;
    end;
  end;

  //ACAO JUDICIAL
  If SistemaFolha.FLGABRERUBACJUD = 1 then
  begin
    If (iSituacao = 1) and
       (qryPrevia.FieldByName('FLGREFERENCIA').asinteger = 0) then
    begin
      if copy(qryPrevia.FieldByName('MESREFERENCIA').AsString, 6, 2) <> '13' then
      //VERIFICAR REVISÃO NORMAL
      begin
        if (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 3) then
        begin
          if not qryPrevia.FieldByName('IDRUBREVACJUD').isnull then
            aiidrubrica:=qryPrevia.FieldByName('IDRUBREVACJUD').asinteger;
        end
        else
          if not qryPrevia.FieldByName('IDRUBACJUD').isnull then
            aiidrubrica:=qryPrevia.FieldByName('IDRUBACJUD').asinteger;
      end;
    end;
  end;

  smsg:='';
  if qryPrevia.FieldByName('FLGPROVISORIO').asinteger = 1 then
    if not qryPrevia.FieldByName('IDRUBADIANT').isnull then
      aiidrubrica:=qryPrevia.FieldByName('IDRUBADIANT').asinteger;

  if qryPrevia.FieldByName('FLGDEVOLUCAO').asinteger = 1 then
  begin
    //PEGAR NOVA RUBRICA IDRUBDEVOLABONO NO ABONO ANUAL
    if copy(qryPrevia.FieldByName('MESREFERENCIA').AsString, 6, 2) = '13' then
    begin
      if (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 2) or
         (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 5) then
      begin
        if not qryPrevia.FieldByName('IDRUBDEVANTABONO').isnull then
          aiidrubrica:=qryPrevia.FieldByName('IDRUBDEVANTABONO').asinteger;
      end
      else
      begin
        //TRATAR ABONO DE ANOS ANTERIORES
        //AÇÃO JUDICIAL GANHA ABERTURA DE RUBRICA
        if (qryPrevia.FieldByName('FLGREFERENCIA').asinteger = 0) and
           (SistemaFolha.FLGABRERUBACJUD = 1) and (iSituacao = 1) then
        begin
          if not qryPrevia.FieldByName('IDRUBDEV13ACJUD').isnull then
            aiidrubrica:=qryPrevia.FieldByName('IDRUBDEV13ACJUD').asinteger;
        end
        else
        begin
          if not qryPrevia.FieldByName('IDRUBDEVOLABONO').isnull then
            aiidrubrica:=qryPrevia.FieldByName('IDRUBDEVOLABONO').asinteger;
        end;
      end;

      //ADIANTAMENTO
      if qryPrevia.FieldByName('FLGPROVISORIO').asinteger = 1 then
        if not qryPrevia.FieldByName('IDRUBDEVADIANT13').isnull then
          aiidrubrica:=qryPrevia.FieldByName('IDRUBDEVADIANT13').asinteger
        else
        begin
          aiidrubrica:=0;
          smsg:='Devolução de Adiantamento de Abono';
        end;
    end
    else
    begin
      //TRATAR ABONO DE ANOS ANTERIORES
      //AÇÃO JUDICIAL GANHA ABERTURA DE RUBRICA
      if (qryPrevia.FieldByName('FLGREFERENCIA').asinteger = 0) and
         (SistemaFolha.FLGABRERUBACJUD = 1) and (iSituacao = 1) then
      begin
        if not qryPrevia.FieldByName('IDRUBDEVACJUD').isnull then
          aiidrubrica:=qryPrevia.FieldByName('IDRUBDEVACJUD').asinteger
      end
      else
      begin
        if not qryPrevia.FieldByName('IDRUBDEVOLUCAO').isnull then
          aiidrubrica:=qryPrevia.FieldByName('IDRUBDEVOLUCAO').asinteger
        else
        begin
          aiidrubrica:=0;
          smsg:='Devolução de Benefício';
        end;
      end;
      
      //VERIFICAR REVISÃO NORMAL
      if (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 2) or
         (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 5) then
      begin
        if (SistemaFolha.FLGABRERUBACJUD = 1) and (iSituacao = 1) then
        begin
          if not qryPrevia.FieldByName('IDRUBDEVREVACJUD').isnull then
            aiidrubrica:=qryPrevia.FieldByName('IDRUBDEVREVACJUD').asinteger;
        end
        else
        begin
          if not qryPrevia.FieldByName('IDRUBDEVREVISAO').isnull then
            aiidrubrica:=qryPrevia.FieldByName('IDRUBDEVREVISAO').asinteger;
        end;
      end;

      //ADIANTAMENTO
      if qryPrevia.FieldByName('FLGPROVISORIO').asinteger = 1 then
        if not qryPrevia.FieldByName('IDRUBDEVOLADIANT').isnull then
          aiidrubrica:=qryPrevia.FieldByName('IDRUBDEVOLADIANT').asinteger
        else
        begin
          aiidrubrica:=0;
          smsg:='Devolução de Adiantamento de Benefício';
        end;

    end;
  end
  else
  begin
    if copy(qryPrevia.FieldByName('MESREFERENCIA').AsString, 6, 2) = '13' then
    begin
      if qryPrevia.FieldByName('FLGPROVISORIO').asinteger = 1 then
        if not qryPrevia.FieldByName('IDRUBADIANT13').isnull then
          aiidrubrica:=qryPrevia.FieldByName('IDRUBADIANT13').asinteger;
    end
    else
    begin
      //USAR RUBRICA DE ATRASO PARA BENEFICIO PERMANENTE
      if qryPrevia.FieldByName('FLGPROVISORIO').asinteger = 0 then
      begin
        //NÃO COLOCAR RUBRICA DE ATRASO PARA BENEFICIO DE PAGAMENTO ÚNICO
        if (qryPrevia.FieldByName('FLGFREQUENCIA').asstring <> 'U') then
        begin
          //TRATAR ABERTURA DA RUBRICA DE ATRASO POR AÇÃO JUDICIAL GANHA
          If SistemaFolha.FLGABRERUBACJUD = 1 then
          begin
            If (iSituacao = 1) and
               (qryPrevia.FieldByName('FLGREFERENCIA').asinteger = 0) then
            begin
              //VERIFICAR REVISÃO NORMAL
              if (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 3) then
              begin
                if (not qryPrevia.FieldByName('IDRUBATRREVACJUD').isnull) and
                   (qryPrevia.FieldByName('MESREFERENCIA').AsString < MesCobranca) then
                  aiidrubrica:=qryPrevia.FieldByName('IDRUBATRREVACJUD').asinteger;
              end
              else
              begin
                if (not qryPrevia.FieldByName('IDRUBATRACJUD').isnull) and
                   (qryPrevia.FieldByName('MESREFERENCIA').AsString < MesCobranca) then
                  aiidrubrica:=qryPrevia.FieldByName('IDRUBATRACJUD').asinteger;
              end;
            end
            else
            begin
              //UTILIZAR IDRUBRICAATRASO E NÃO IDRUBRICADIF
              if (not qryPrevia.FieldByName('IDRUBRICAATRASO').isnull) and
                 (qryPrevia.FieldByName('MESREFERENCIA').AsString < MesCobranca) then
              //VERIFICAR REVISÃO NORMAL
              if (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger = 3) then
              begin
                if (not qryPrevia.FieldByName('IDRUBATRREVISAO').isnull) and
                   (qryPrevia.FieldByName('MESREFERENCIA').AsString < MesCobranca) then
                  aiidrubrica:=qryPrevia.FieldByName('IDRUBATRREVISAO').asinteger;
              end
              else
              begin
                if not qryPrevia.FieldByName('IDRUBRICAATRASO').isnull then
                  aiidrubrica:=qryPrevia.FieldByName('IDRUBRICAATRASO').asinteger;
              end;
            end;
          end
          else
          begin
            //UTILIZAR IDRUBRICAATRASO E NÃO IDRUBRICADIF
            if (not qryPrevia.FieldByName('IDRUBRICAATRASO').isnull) and
               (qryPrevia.FieldByName('MESREFERENCIA').AsString < MesCobranca) then
              aiidrubrica:=qryPrevia.FieldByName('IDRUBRICAATRASO').asinteger;
          end;
        end;
      end;
    end;
  end;
end;

procedure TobjRecebedor.BuscaAcaoGanha;
begin
  // Verifica se existe ação Judicial (Deposito e Bi-tributação) ganha e ativa para a pessoa em questão.
  iacaojudganha:=0;
  rpercacjudganha:=0;
  if FazQuery(dtmFolhaPrevia.qryAux3,
        'SELECT NVL(PRJ.PERCACAO,0) AS PERCACAO, SITPROCESSO '+
        ',CASE' +
        '      WHEN' +
        '       (SELECT COUNT(*)' +
        '          FROM DETPROCJUD, REGRA' +
        '        WHERE REGRA.IDREGRA = DETPROCJUD.IDREGRA' +
        '          AND DETPROCJUD.IDPROCJUD = PRJ.IDPROCJUD' +
        '          AND INSTR(REGRA.NOMEREGRA, ''EQUA'') <> 0' +
        '       ) > 0' +
        '      THEN  1' +
        '      ELSE 0' +
        '   END FLGACAOEQUA ' +
        'FROM PROCJUD PRJ ' +
        'WHERE PRJ.IDPESSOA = '+inttostr(iidresponsavel)+' '+
        //'AND TIPOACAO < 2 AND SITPROCESSO = 1') then // Andre Imakawa - SIG 99651
        'AND TIPOACAO < 3 AND SITPROCESSO = 1 ' + // Andre Imakawa - SIG 134868
        'ORDER BY DECODE(PRJ.SITPROCESSO,1,0,1) ASC') then // Andre Imakawa - SIG 99651
  begin
    rpercacjudganha:=dtmFolhaPrevia.qryAux3.fieldbyname('PERCACAO').asFloat/100;
    bAcaoEquacionamento := dtmFolhaPrevia.qryAux3.fieldbyname('FLGACAOEQUA').AsInteger = 1;
    if (rpercacjudganha > 0) and (dtmFolhaPrevia.qryAux3.fieldbyname('SITPROCESSO').AsInteger = 1) then
      iacaojudganha:=1;
  end;
  dtmFolhaPrevia.qryAux3.close;
end;

procedure TdtmFolhaPrevia.ProcessaRubricaProvento;
 var liidrubrica, liidmotivo : integer;
     lrvalorbenef : real;
     smsg, lstipodesc: string;
     rvalorjud, rvalornormal: real;
     lssql: string;
     orubBenef: TObjRubrica; 
     lsplacontaliq: string;

  procedure InsereRubricaBeneficio(arvalorrub: real; aiFlgIsentaAcJudGanha : integer = -1);
  var liflgsrb: integer;
      lbaceitazero: boolean; //CONTROLA ACEITA ZERO SE REGRA DE BEN MINIMO PARAMETRIZADA
      lsdata: string;
  begin

    // Felipe A. Santos SOL258357/17801 PPM 1083052 - Início
    // verifica no benefício (BENEFPLANPREV) se todas as rubricas de RRA então parametrizadas.
    //if (bLancouRRA) then //SOL 266389 PPM 1201608
    if (bverificaRRA) then //SOL 266389 PPM 1201608
    begin
      if not(bRRAParametrizado) then
      begin
        ExibeMensagemRRA;
        //bLancouRRA := False; //SOL 266389 PPM 1201608
        bverificaRRA := False; //SOL 266389 PPM 1201608
        Exit;
      end;
    end;
    // Felipe A. Santos SOL258357/17801 PPM 1083052 - fim

    lstipodesc:=BuscaDadosRubrica(objrecebedor, liidrubrica, 'B');
    if lstipodesc <> '' then
    begin
      //TRATAR QUANDO A RUBRICA É ESPECIAL
      if (lstipodesc <> 'K') then
      begin
        if objRecebedor.smesrefprov = '' then
          objRecebedor.smesrefprov:=qryPrevia.FieldByName('mesreferencia').asstring;
        try
          If qryPrevia.fieldbyname('FLGREFERENCIA').asinteger = 0 then
            liflgsrb:=2
          else
            If qryPrevia.fieldbyname('FLGREFERENCIA').asinteger = 1 then
              liflgsrb:=3
            else
              liflgsrb:=0;

          //CPREV-26654-26/10/2007-INICIO
          if (qryProvento.fieldbyname('CODFONTEPAGADORA').asinteger = 2) then
          begin
            objRecebedor.iidplanoprevglobalinss     := qryPrevia.FieldByName('IDPLANOPREV').asinteger;
            objRecebedor.iidplanoorigemglobalinss   := qryPrevia.FieldByName('IDPLANOORIGEM').asinteger;
            objRecebedor.iidplanocontabilglobalinss := qryPrevia.FieldByName('IDPLANOCONTABIL').asinteger;
          end;
          //CPREV-26654-26/10/2007-FIM

	  lbaceitazero:=(qryPrevia.fieldbyname('FLGACEITAZERO').asinteger = 1) and
            (prmVlrBenefMin > 0);

          if not objRecebedor.InsereRubrica(
              qryPrevia.FieldByName('idpessoa').asinteger,     //beneficiario
              0, //favorecido da rubrica
              qryPrevia.FieldByName('idbeneficio').asinteger,  //beneficio associado : pega beneficio base
              liidrubrica,   //codigo do provento
              qryProvento.FieldByName('flgdesconto').asinteger,  //flag de desconto
              qryProvento.FieldByName('flgespecial').asinteger,    //flag especial
              liidmotivo,                                        //motivo do desconto
              qryPrevia.FieldByName('seqbeneficio').asinteger,//1, //seqrubrica = 1
              objrecebedor.icodmoedabase,                        //codigo da moeda
              0,                                                 //regra de calculo
              qryProvento.fieldbyname('CODFONTEPAGADORA').asinteger, //fonte pagadora da provdesc
              qryProvento.FieldByName('flgirrf').asinteger,      //indica se rubrica entra na base de IR
              qryProvento.FieldByName('FLGSALFAMILIA').asinteger,      //indica se rubrica entra no calculo do salario familia
              qryPrevia.FieldByName('FLGPROVISORIO').asinteger,     //indica se o beneficio é provisorio
              Sistema.IdModulo,                                         //sistema de origem da rubrica
              liflgsrb,
              1,  //flgOK
              0,  //flgPA
              qryProvento.FieldByName('flgdescpensao').asinteger, //flgBasePA
              qryPrevia.FieldByName('flgconcessaohst').asinteger,  //flgconcessao
              0,  //flgindividual
              qryProvento.FieldByName('flgcompoesalpart').asinteger, //compõe sal. participacao
              qryProvento.FieldByName('flgcompoesalbenef').asinteger, //compõe sal. benefício
              qryProvento.FieldByName('numprioridade').asinteger,  //prioridade de desconto
              qryPrevia.FieldByName('idfundacao').asinteger,       //id empresa p/ contabilização
              qryProvento.FieldByName('tipobasedesconto').asinteger, //tipo de base de desconto {abono,supl,inss,resgate}
              0,  //código do alterador
              0,  //id do plano de contas
              qryPrevia.FieldByName('numeroprocesso').asinteger,
              qryPrevia.FieldByName('numprocinss').AsString,
              'B', //flg do tipo de desconto 'C', 'P', 'B', 'Y'
              0, //valor informativo associado a rubrica
              arvalorrub, //valor da rubrica
              0, //valor base de cálculo para a regra
              '***',  //referencia
              qryPrevia.FieldByName('mesreferencia').asstring, //mês de referência
              qryProvento.FieldByName('codirrfdarf').asstring, //código IRRF na SRF para o DARF
              '',  //indice recebimento 'R'ou pagamento 'P'
              '',  //código do tipo de recebimento ou desembolso
              '',  //código do centro de custo
              '',  //código do centro de responsabilidade
              '',  //código da unidade de negócio
              qryPrevia.FieldByName('PLACONTAD').asstring, //conta contábil associada
              '',  //data inicio da rubrica
              '',  //data final da rubrica
              qryProvento.FieldByName('descparcial').asinteger,      //indica se permite desconto parcial
              0,                                                     //usa no abono anual
              0,                                                  //origem da rubrica
              0,                                                  //lote original do desconto
              0,  // RUBRICA CONSIGNATARIO
              lbaceitazero,
              '', // DATA PREVISTA DE PAGAMENTO
              qryProvento.FieldByName('CODPROVDESC').asstring, //PARA GRAVAR CODPROVDESC NA PREVIA E EM SQL PARA REGRAS
              qryPrevia.FieldByName('IDPLANOPREV').asinteger,
              qryPrevia.FieldByName('IDPLANOORIGEM').asinteger,
              qryPrevia.FieldByName('IDPLANOCONTABIL').asinteger, //PLANO CONTABIL DA BENEFBFCIARIO
              qryPrevia.FieldByName('IDSEQINTERNOFB').asinteger, // GRAVAR SEQINTERNO PARA RETORNO
              dtmFolhaPrevia.qryProvento.FieldByName('FLGRUBLEGAL').asinteger,  //
              dtmFolhaPrevia.qryprevia.fieldbyname('MESCOMPREEM').asstring   // SOL 140042 Kintana 900220
              ,0,'',dtmFolhaPrevia.qryProvento.FieldByName('FLGMARGEM').asinteger         //Renato Visoni SOL 131523 KINTANA 750021
              ,0
              ,dtmFolhaPrevia.qryProvento.FieldByName('FLGREPROGRAMAR').asInteger    //Marcio Denilson - SOL 136569 - KINTANA 820997
              ,false, 0,dtmFolhaPrevia.qryProvento.FieldByName('FLGEXCLUICONTRIBPA').asInteger    //Osni Cavalcante - SIG 58950.59454
              ,emptystr, -1, aiFlgIsentaAcJudGanha           //edilaine SIG92016
              ) then
            dtmFolhaPrevia.ExibeMensagem('Erro ao gravar rubrica de Provento '+
              qryProvento.FieldByName('idprovento').asstring);
        except
          on e:exception do
          begin
            dtmFolhaPrevia.ExibeMensagem('Exceção ao gravar rubrica de Provento '+
              qryProvento.FieldByName('idprovento').asstring+' - '+e.message);
          end;
        end;
        //PARA TRATAR RUBRICAS NÃO INSERIDAS
        if objrecebedor.objrubinserida <> nil then
        begin
          // Andre Imakawa - SIG 33052 - Inicio
          {
          // SOL 248327 PPM 668845  Inicio    // SOL 262549 PPM 1097892 invertido a chamada dos metodos.



          If (Trim(objrecebedor.objrubinserida.scodirrfdarf) = '3223') or (Trim(objrecebedor.objrubinserida.scodirrfdarf) = '3556') Then
          begin
             if (objrecebedor.sTpModalidade = 'CD') then //SOL 257943 PPM 970494
                objrecebedor.objrubinserida.scodirrfdarf := '3223';
          end
          else
             objrecebedor.objrubinserida.scodirrfdarf :=  qryProvento.FieldByName('CODIRRFDARF').AsString;
          // SOL 248327 PPM 668845  Final
          }
          // Andre Imakawa - SIG 33052 - Fim

          // SOL 246290 PPM 642043 // SOL 254010 PPM 788237
          objrecebedor.VerificaIrrfDarfRegimeRegressivo(objrecebedor.objrubinserida); //Helio - SOL Nº 151061-10442 KINTANA Nº 1720319 // SOL 257943 PPM 970494 invertido, deve estar antes das alterações do SOL 248327, caso contrario apresenta erro no resgate.


          orubBenef:=objrecebedor.objrubinserida;
          objrecebedor.objrubinserida.ipossuiabono:=
            qryPrevia.FieldByName('FLGPOSSUIABONO').asinteger;

          if qryPrevia.FieldByName('FLGPOSSUIABONO').asinteger = 1 then
            objrecebedor.TemAbonoBeneficio:=true;

          if (qryPrevia.FieldByName('PLACONTAD').asstring <> '') then
            objRecebedor.TemParamIndividual:=true;

          //PARA TRATAR DATA DE PAGAMENTO NULA NA HSTBENEFBFCIARIO
          if qryPrevia.FieldByName('datapagamento').isnull then
            lsdata:=''
          else
            lsdata:=formatdatetime('dd/mm/yyyy',
              qryPrevia.FieldByName('datapagamento').asdatetime);
          objrecebedor.CalculaCorrecaoBeneficio(lsdata);
        end;
      end
      else
        dtmFolhaPrevia.ExibeMensagem('Rubrica de Provento parametrizada como especial: '+inttostr(liidrubrica));
    end
    else
    begin
      if liidrubrica=0 then
        dtmFolhaPrevia.ExibeMensagem('Rubrica de '+smsg+' (cód benef:'+
          inttostr(qryPrevia.FieldByName('idbeneficio').asinteger)+
          ') não parametrizada.')
      else
        dtmFolhaPrevia.ExibeMensagem('Rubrica de '+smsg+
          ' não encontrada: '+inttostr(liidrubrica));
    end;
  end;

begin

  //bLancouRRA := False;  // SOL 266335 PPM 1200586
  bverificaRRA := false; //SOL 266389 PPM 1201608
  objRecebedor.sListaBeneficios:=
    objRecebedor.sListaBeneficios+qryPrevia.FieldByName('idbeneficio').asstring+',';

  objRecebedor.AcrescentaBeneficio(qryPrevia.FieldByName('idbeneficio').asinteger, qryPrevia.FieldByName('benef_isento').asinteger); //Andre Imakawa - SIG 49800-60759

  if (qryPrevia.fieldbyname('FLGREFERENCIA').asinteger = 0) then
    objrecebedor.DIBFund:=qryPrevia.fieldbyname('DATADIB').asdatetime
  else
    objrecebedor.DIBINSS:=qryPrevia.fieldbyname('DATADIB').asdatetime;

  if (qryPrevia.FieldByName('IDSITBENEFICIO').asinteger <> 1) and
     (qryPrevia.FieldByName('IDSITBENEFICIO').asinteger <> 2) and
     (qryPrevia.FieldByName('IDSITBENEFICIO').asinteger <> 3) then
    objRecebedor.ibloqueiaprevia:=2;

  if SistemaFolha.FlgUsaProvisaoAbono then
  begin
    //PARA CONTROLE DA PROVISÃO DO ABONO ANUAL
    if objRecebedor.iPrimeiroPagamento = -1 then
    //VERIFICA SE O PAGAMENTO EM QUESTÃO É O PRIMEIRO DESTE BENEFICIÁRIO CONSULTANDO O HISTÓRICO DE BENEFÍCIOS
    begin
      lssql:=
        'SELECT MIN(MES) AS MES '+_clinefeed+
        'FROM HSTBENEFBFCIARIO '+_clinefeed+
        'WHERE IDPESSJUR = '+inttostr(dtmFolhaPrevia.qryPrevia.fieldbyname('idpessjur').asinteger)+' '+_clinefeed+
        'AND IDTITULAR = '+inttostr(dtmFolhaPrevia.qryPrevia.fieldbyname('idtitular').asinteger)+' '+_clinefeed+
        'AND IDPESSOA = '+inttostr(dtmFolhaPrevia.qryPrevia.fieldbyname('idpessoa').asinteger)+' '+_clinefeed;

      if FazQuery(dtmFolhaPrevia.qryAux, lssql) then
      begin
        if (dtmFolhaPrevia.qryAux.fieldbyname('MES').asstring = MesCobranca) then
          objRecebedor.iPrimeiroPagamento:=1
        else
          objRecebedor.iPrimeiroPagamento:=0;
      end
      else
        objRecebedor.iPrimeiroPagamento:=0;
    end;
  end
  else
    objRecebedor.iPrimeiroPagamento:=0;

  if qryPrevia.FieldByName('IDMOTIVO').isnull then
    liidmotivo:=prmIDMOTIVOFOLHABEN
  else
    liidmotivo:=qryPrevia.FieldByName('IDMOTIVO').asinteger;

  //CONTROLA SE REGISTROS DE ABONO SÃO NORMAIS E NÃO APENAS DE REVISÃO
  if ((liidmotivo = prmidmotivofolhaben) or
      (liidmotivo = prmidmotivoabono)) and
     (copy(qryPrevia.FieldByName('mesreferencia').asstring,6,2) = '13') then
    objRecebedor.bTemAbonoNormal:=true;

  if (qryPrevia.fieldbyname('FLGDEVOLUCAO').asinteger = 1) and
      //USAR FLGCONCESSAO DA HSTBENEFBFCIARIO
     (qryPrevia.fieldbyname('FLGCONCESSAOHST').asinteger = 1) then
  begin
    if objRecebedor.iidbeneficiobase = 0 then
    begin
      objRecebedor.iidbeneficiobase:=qryPrevia.FieldByName('idbeneficio').asinteger;
      objrecebedor.icodmoedabase:=qryPrevia.fieldbyname('indicereajbenef').asinteger;
    end;
  end;

  if (qryPrevia.fieldbyname('mes').asstring = qryPrevia.fieldbyname('mesreferencia').asstring) then
  begin
    objRecebedor.inumeroprocesso:=qryPrevia.FieldByName('numeroprocesso').asinteger;
    objRecebedor.snumprocinss   :=qryPrevia.FieldByName('numprocinss').AsString;
  end
  else
  if objRecebedor.ifontepgbase = 2 then     // SOL 220245
  begin
      objRecebedor.inumeroprocesso:=qryPrevia.FieldByName('numeroprocesso').asinteger;
      objRecebedor.snumprocinss   :=qryPrevia.FieldByName('numprocinss').AsString;
  end; // SOL 220245

  objRecebedor.AcrescentaPessoa(qryPrevia.FieldByName('idresponsavel').asinteger);
  objRecebedor.AcrescentaPessoa(qryPrevia.FieldByName('idpessoa').asinteger);

  if (SistemaFolha.RateioPlanoRubrica = 0) OR
     (qryPrevia.fieldbyname('FONTEPAGADORA').Asinteger = 2) then //CPrev - 26821
  begin
    lsplacontaliq:=dtmContabil.AchaContaLiquidoBeneficio(          
      qryPrevia.fieldbyname('idpessjur').asinteger,
      qryPrevia.FieldByName('idplanoprev').asinteger,
      qryPrevia.FieldByName('idbeneficio').asinteger);
    objrecebedor.AcrescentaPlano(
      qryPrevia.FieldByName('idplanoprev').asinteger,
      qryPrevia.FieldByName('idplanocontabil').asinteger,
      lsplacontaliq, 0, 0, 0); // Andre Imaakawa - SIG 99651
  end;

  //TEM ACAO JUDICIAL
  If (not dtmfolhaprevia.qrydetprocjudicial.isempty) and
     (SistemaFolha.FLGABRERUBACJUD = 1) and
     (qryPrevia.fieldbyname('FLGREFERENCIA').asinteger = 0) and
     //SE TEM ISENÇÃO DE IR: NÃO ABRIR RUBRICAS DE AÇÃO JUDICIAL
     (objRecebedor.iiMolestiaGrave = 0) and (objRecebedor.iflgisentoirrf = 0) then
  begin
    If (objRecebedor.iacaojudganha = 1) and
//   O FLGTIPOREGISTRO INDICA AS ORIGENS DA ABERTURA. NO CASO DE ANTECIPAÇÃO DE ABONO ANUAL
//   VAI GRAVAR O VALOR APENAS NA RUBRICA DE ANTECIPAÇÃO DE ABONO
       (qryPrevia.FieldByName('FLGTIPOREGISTRO').asinteger in [0,1,3,4]) then
    begin
      //NAO EXECUTAR A REGRA DE BENEFICIO MINIMO NA FOLHA DE ABONO
      if qryPrevia.fieldbyname('FLGTIPOFOLHA').asinteger in [3,4] then
        lrvalorbenef:=dtmFolhaPrevia.qryPrevia.fieldbyname('VALORPREV').asfloat
      else
        //EXECUTAR A REGRA DE BENEFICIO MINIMO SE O REGISTRO DA HSTBENEFBFCIARIO NÃO É DE ORIGEM CONCESSAO
        //NAO EXECUTAR A REGRA DE BENEFICIO MINIMO NA FOLHA DE CONCESSAO
        if (qryPrevia.FieldByName('flgconcessaohst').asinteger = 0) and
           (copy(qryPrevia.FieldByName('mesreferencia').asstring,6,2) <> '13') and
           (qryPrevia.FieldByName('idmotivo').asinteger = prmIdMotivoFolhaBen) then
          lrvalorbenef:=objrecebedor.CalculaBeneficioMinimo
        else
          lrvalorbenef:=dtmFolhaPrevia.qryPrevia.fieldbyname('VALORPREV').asfloat;

      //Andre Imakawa - SIG 92016 - Inicio
      if not(objRecebedor.bAcaoEquacionamento) then
        rvalorjud:=TruncaMoeda(lrvalorbenef*objRecebedor.rpercacjudganha);
      //Andre Imakawa - SIG 92016 - Fim
      // Andre Imakawa - SIG 134868 - Inicio
      // Andre Imakawa - SIG 99651 - Inicio
      //if objRecebedor.iacaojudganha = 1then 
      //  rvalorjud:=TruncaMoeda(lrvalorbenef*objRecebedor.rpercacjudganha)
      //else
      //  rvalorjud := 0;
      // Andre Imakawa - SIG 99651 - Fim
      // Andre Imakawa - SIG 134868 - Fim      
      rvalornormal:=TruncaMoeda(lrvalorbenef-rvalorjud);
      //BRUNO AZEVEDO E ALINE - PASSEI IDTITULAR e o LOTE
      ResolveRubrica(liidrubrica, liidmotivo, smsg, 0, objrecebedor.iidtitular, qryPrevia.FieldByName('IDLOTE').asinteger, rvalornormal);
      InsereRubricaBeneficio(rvalornormal);
      ResolveRubrica(liidrubrica, liidmotivo, smsg, 1, objrecebedor.iidtitular, qryPrevia.FieldByName('IDLOTE').asinteger, rvalorjud);
      InsereRubricaBeneficio(rvalorjud, 1);
    end
    else // não possui ação judicial ganha e ativa (situação normal)
    begin
      //ResolveRubrica(liidrubrica, liidmotivo, smsg, 0);
      //NAO EXECUTAR A REGRA DE BENEFICIO MINIMO NA FOLHA DE ABONO
      if qryPrevia.fieldbyname('FLGTIPOFOLHA').asinteger in [3,4] then
        lrvalorbenef:=dtmFolhaPrevia.qryPrevia.fieldbyname('VALORPREV').asfloat
      else
        //EXECUTAR A REGRA DE BENEFICIO MINIMO SE O REGISTRO DA HSTBENEFBFCIARIO NÃO É DE ORIGEM CONCESSAO
        //NAO EXECUTAR A REGRA DE BENEFICIO MINIMO NA FOLHA DE CONCESSAO
        if (qryPrevia.FieldByName('flgconcessaohst').asinteger = 0) and
           (copy(qryPrevia.FieldByName('mesreferencia').asstring,6,2) <> '13') and
           (qryPrevia.FieldByName('idmotivo').asinteger = prmIdMotivoFolhaBen) then
          lrvalorbenef:=objrecebedor.CalculaBeneficioMinimo
        else
          lrvalorbenef:=dtmFolhaPrevia.qryPrevia.fieldbyname('VALORPREV').asfloat;
      ResolveRubrica(liidrubrica, liidmotivo, smsg, 0, objrecebedor.iidtitular, qryPrevia.FieldByName('IDLOTE').asinteger, lrvalorbenef);

      InsereRubricaBeneficio(lrvalorbenef);
    end;
    qryAux3.close;
  end
  else
  begin
    //ResolveRubrica(liidrubrica, liidmotivo, smsg, 0);
    //NAO EXECUTAR A REGRA DE BENEFICIO MINIMO NA FOLHA DE ABONO
    if qryPrevia.fieldbyname('FLGTIPOFOLHA').asinteger in [3,4] then
      lrvalorbenef:=dtmFolhaPrevia.qryPrevia.fieldbyname('VALORPREV').asfloat
    else
      //EXECUTAR A REGRA DE BENEFICIO MINIMO SE O REGISTRO DA HSTBENEFBFCIARIO NÃO É DE ORIGEM CONCESSAO
      //NAO EXECUTAR A REGRA DE BENEFICIO MINIMO NA FOLHA DE CONCESSAO
      if (qryPrevia.FieldByName('flgconcessaohst').asinteger = 0) and
         (copy(qryPrevia.FieldByName('mesreferencia').asstring,6,2) <> '13') and
         (qryPrevia.FieldByName('idmotivo').asinteger = prmIdMotivoFolhaBen) then
        lrvalorbenef:=objrecebedor.CalculaBeneficioMinimo
      else
        lrvalorbenef:=dtmFolhaPrevia.qryPrevia.fieldbyname('VALORPREV').asfloat;

    ResolveRubrica(liidrubrica, liidmotivo, smsg, 0, objrecebedor.iidtitular, qryPrevia.FieldByName('IDLOTE').asinteger, lrvalorbenef);
    InsereRubricaBeneficio(lrvalorbenef);
  end;

  if (lstipodesc = 'B') and (orubBenef <> nil) then
    objRecebedor.AtribuiValores(lrvalorbenef, orubBenef);

  If (qryPrevia.fieldbyname('FLGREFERENCIA').asinteger = 0) and
     (qryPrevia.FieldByName('FLGFREQUENCIA').asstring <> 'U') then
    if objRecebedor.rValorBaseBen1 = -1 then
    begin
      //SEMPRE PEGA VALORES BASE DA QRY PRINCIPAL
      objRecebedor.rValorBaseBen1:=qryPrevia.fieldbyname('VALORBASEBEN1').asfloat;
      objRecebedor.rValorBaseBen2:=qryPrevia.fieldbyname('VALORBASEBEN2').asfloat;
      objRecebedor.rValorBaseBen3:=qryPrevia.fieldbyname('VALORBASEBEN3').asfloat;
    end;

    dtmFolhaPrevia.qryAux.Close;// SOL 242740 PPM 575822
end;

function TdtmFolhaPrevia.BuscaDadosRubrica(objrec : TobjRecebedor;
  aiidrubrica : integer; astipodesc : string) : string;
begin
  if qryProvento.locate('idprovento',aiidrubrica,[]) then
  begin
    if qryProvento.fieldbyname('FLGDESCONTO').asinteger = 2 then
      result:='K'
    else
      result:=astipodesc;
  end
  else
    result:='';
end;

