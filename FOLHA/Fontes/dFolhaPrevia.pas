  sSQL : String;
begin

  //sSQL := ' SELECT IDPESSOA                                        '
  sSQL := ' SELECT 1                                        '
        + ' FROM EVENTOSPREV EP                                    '
        + ' WHERE IDPESSOA = :IDPESSOA                             '
        + ' AND IDPLANOPREV = :IDPLANOPREV                         '
        + ' AND EXISTS                                             '
        + ' (                                                      '
        + '   SELECT 1                                             '
        + '   FROM EVENTOGERADOR EG                                '
