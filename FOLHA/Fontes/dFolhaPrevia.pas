  Result := False;

  //sSQL := 'SELECT IDPESSOA, COUNT(IDRESPONSAVEL) ' + #13 +
  sSQL := 'SELECT 1 ' + #13 +
          'FROM (SELECT DISTINCT BTP.IDPESSOA, BTP.IDRESPONSAVEL ' + #13 +
          '      FROM BFCIARIOTITPLAN BTP, ' + #13 +
          '           HSTBENEFBFCIARIO HST ' + #13 +
          '      WHERE HST.IDLOTE        = ' + IntToStr(iidlote) + #13 +
          '	    AND BTP.IDTITULAR     = ' + IntToStr(iidtitular) + #13 +
          '        AND BTP.IDBENEFICIO   = HST.IDBENEFICIO ' + #13 +
          '        AND BTP.IDPLANOPREV   = HST.IDPLANOPREV ' + #13 +
          '        AND BTP.IDPLANOORIGEM = HST.IDPLANOORIGEM ' + #13 +
          '        AND BTP.SEQPROPOSTA   = HST.SEQPROPOSTA ' + #13 +
          '        AND BTP.IDTITULAR     = HST.IDTITULAR ' + #13 +
          '        AND BTP.IDPESSOA      = HST.IDPESSOA ' + #13 +
          '        AND BTP.IDPESSJUR     = HST.IDPESSJUR) ' + #13 +
          'GROUP BY IDPESSOA ' + #13 +
          'HAVING COUNT(IDRESPONSAVEL) > 1 ';

   FazQuery(dtmFolhaPrevia.qryAux, sSql);

   If Not dtmFolhaPrevia.qryAux.IsEmpty Then Result := True;
   dtmFolhaPrevia.qryAux.close; // SOL 242740 PPM 575822
end;

