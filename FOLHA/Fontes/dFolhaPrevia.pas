//MARCIO DENILSON SOL 151061 KINTANA 1105188
procedure TobjRecebedor.validaIdadeCalculaIsencao(pDataNasc: TDate; var rValorBaseIRRF: Real);
var
  sSQL : String;
begin
  sSQL := ' SELECT H.IDADEIDOSO, H.VLRIDOSO       '
        + ' FROM HSTPARAMIRRF H                   '
        + ' WHERE H.DATAINIVIGENCIA =             '
        + ' (                                     '
        + ' SELECT MAX(DATAINIVIGENCIA) AS DATA   '
        + ' FROM IRRF                             '
        + ' WHERE DATAINIVIGENCIA <= SYSDATE      '
        + ' )                                     ';

  With TwwQuery.Create(nil) do       //edilaine WO19556
   begin
     DataBaseName := dtmBaseDados.dbBaseDados.DataBaseName;
     SQL.Add(sSQL);
     Open;
     if not IsEmpty then
      begin
        if calcIdade(pDataNasc) >= FieldByName('IDADEIDOSO').asInteger then // SOL 254010 PPM 788237
          rValorBaseIRRF := rValorBaseIRRF - FieldByName('VLRIDOSO').AsFloat;
      end;
     Close;
     Free;
   end;
end;

//MARCIO DENILSON SOL 151061 KINTANA 1105188
function TobjRecebedor.VerificaBeneficioPossuiEventoGeradorRisco(piIDPessoa, piIDPlanoPrev: Integer): Integer;
