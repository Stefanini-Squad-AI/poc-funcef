                    if ({dtmFolhaPrevia.}qryAux.fieldbyname('FLGTIPO').asstring = 'D') then                 //edilaine WO19556
                      alidrubrica:={dtmFolhaPrevia.}qryAux.fieldbyname('IDRUBNORMAL').asinteger;            //edilaine WO19556
