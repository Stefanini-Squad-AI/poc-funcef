constructor TobjBase.Create(asbase : string; aiindice : integer; ascodirrfdarf : string);
begin
  inherited create;

  itipobase:=aiindice;
  scodirrfdarf:=ascodirrfdarf;
  rvalorbruto:=0;
  rvalorliquido:=0;
  rproventoirrf:=0;
  rdescontoirrf:=0;
  rdescontoContrib := 0;
  rvalorirrf:=0;
  iidrubirrf:=0;

  if asbase = 'FUND' then
    iidrubirrf:=prmIdRubricaIRRF;

  if asbase = 'RESE' then
  begin
    if prmIdRubIRRFResg > 0 then
      iidrubirrf:=prmIdRubIRRFResg
    else
      iidrubirrf:=prmIdRubricaIRRF;
  end;

  if asbase = 'INSS' then
  begin
    if prmIDRUBIRRFINSS > 0 then
      iidrubirrf:=prmIDRUBIRRFINSS
    else
      iidrubirrf:=prmIdRubricaIRRF;
  end;

  if asbase = 'FUND13' then
  begin
    if prmIDRUBIRRFABONO > 0 then
      iidrubirrf:=prmIDRUBIRRFABONO
    else
      iidrubirrf:=prmIdRubricaIRRF;
  end;

  if asbase = 'INSS13' then
  begin
    if SistemaFolha.IDRUBIRRFINSSABONO > 0 then
      iidrubirrf:=SistemaFolha.IDRUBIRRFINSSABONO
    else
      iidrubirrf:=prmIdRubricaIRRF;
  end;

  if asbase = 'FUNDREGR' then
  begin
    if SistemaFolha.IdRubIRRFVitalicioREGR > 0 then
      iidrubirrf:=SistemaFolha.IdRubIRRFVitalicioREGR
    else
      iidrubirrf:=0;
  end;

  if asbase = 'FUND13REGR' then
  begin
    if SistemaFolha.IdRubIRRFAbonoREGR > 0 then
      iidrubirrf:=SistemaFolha.IdRubIRRFAbonoREGR
    else
      iidrubirrf:=0;
  end;

  if asbase = 'RESECD' then
  begin
    if prmIdRubIRRFResg > 0 then
      iidrubirrf:=prmIdRubIRRFResg
    else
      iidrubirrf:=prmIdRubricaIRRF;
  end;

  if asbase = 'RESEREGR' then
  begin
    if SistemaFolha.IdRubIRRFReservaTribRegressiva > 0 then
      iidrubirrf:=SistemaFolha.IdRubIRRFReservaTribRegressiva
    else
      iidrubirrf:=0;
  end;

  PlanoPrev:=0;
  MultiPlano:=false;
end;

