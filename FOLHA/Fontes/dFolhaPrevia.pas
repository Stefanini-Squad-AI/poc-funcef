procedure TdtmFolhaPrevia.LimpaEstrutura;
begin
  cdsEstrutura.cancelupdates;
  cdsEstrutura.filter:='';
  cdsEstrutura.filtered:=false;
  cdsEstrutura.first;
  while not cdsEstrutura.eof do
  begin
    cdsEstrutura.edit;
    cdsEstruturaV1.asfloat:=0;
    cdsEstruturaV2.asfloat:=0;
    cdsEstruturaSTIPODESC.asstring:=' ';
    cdsEstrutura.post;
    cdsEstrutura.next;
  end;
end;

procedure TdtmFolhaPrevia.AtualizaValorEstrutura(aobjrub: tobjrubrica);
var rsinal: real;
begin
// if aobjrub.bpermanente or (aobjrub.iprazo > 1) then
//  begin
    if aobjrub.iflgdesconto = 0 then
      rsinal:=1
    else
      rsinal:=-1;
    cdsEstrutura.filter:='idrubrica = '+inttostr(aobjrub.iidrubrica);
    cdsEstrutura.filtered:=true;
    cdsEstrutura.first;
    while not cdsEstrutura.eof do
    begin
      //FALTAVA O "/" POIS PAROU DE FUNCIONAR PARA O ANO DE 2013
      //if pos('13',aobjrub.sMes) = 0 then begin // Renato Visoni SOL 126747 - KINTANA 666759
      if pos('/13',aobjrub.sMes) = 0 then begin //BRUNO AZEVEDO SOL 198448 - KINTANA 1909218
        cdsEstrutura.edit;

        cdsEstruturaV1.asfloat:=cdsEstruturaV1.asfloat+rsinal*aobjrub.rvalorrecebido;   // SOL:123797 - Daniel Begnami
        if aobjrub.iflgirrf = 1 then
          cdsEstruturaV2.asfloat:=cdsEstruturaV2.asfloat+rsinal*aobjrub.rvalorrecebido; // SOL:123797 - Daniel Begnami

        cdsEstrutura.post;
        cdsEstrutura.next;
      end else begin
        cdsEstrutura.next;// Renato Visoni SOL 126747 - KINTANA 666759
      end;

    end;
    cdsEstrutura.filtered:=false;
//  end;
end;

