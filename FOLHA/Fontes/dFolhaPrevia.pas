    lrsinal: Real;
    lbErro: boolean;
    sAuxTipoREINF: string;
    rValorRubrica: real;
    objPlano: tobjPlano;
  begin
    lbErro := False;
    try
      try
        if CarregaCdsReinf(pGrupoREINF) then
        begin
          for lii := 0 to lstRubricas.count - 1 do
          begin
            objrub := (lstRubricas.objects[lii] as tobjrubrica);
