              lobjrub.rvalorrecebido := ArredondaMoeda(lrvalorrub - lrvalorparcial);
            end;

          end;

        end;
      end;
    end;
  finally
    lstRubricas.Sorted := true;
  end
end;

function TobjRecebedor.ProcessaReinf(var bErroInserePrevia: boolean): Boolean;
var
  Query: TwwQuery;
  sSQL: string;
  lstNaturezaReinf: TStringList;
  lii: integer;
  lrValorIdade, lrValorIdade13, lrValorDepen, lrValorDepen13: Real;
  pGerouPercIRReg: boolean;

  function ListaNaturezasReinf(var pStringLista: TStringList): Boolean;
  var
    lii: Integer;
    objrub: tobjrubrica;
    lstFuncef, lstINSS: TStringList;
  begin
    Result := False;


    try
      try
        if lstRubricas.count > 0 then
        begin
          lstFuncef := TStringList.Create;
          lstINSS   := TStringList.Create;
          for lii := 0 to lstRubricas.count - 1 do
          begin
            objrub := (lstRubricas.objects[lii] as tobjrubrica);
            if (objrub.iFlgGravou = 1) then
            begin
              if (objrub.iCodNaturezaReinf <> 0) then
              begin
                if (objrub.ifontepagadora = 1) and (lstFuncef.IndexOf( IntToStr(objrub.iCodNaturezaReinf) ) = -1) then
                  lstFuncef.Add( IntToStr(objrub.iCodNaturezaReinf) )
                else
                  if (objrub.ifontepagadora = 2) and (lstINSS.IndexOf( IntToStr(objrub.iCodNaturezaReinf) ) = -1) then
                    lstINSS.Add( IntToStr(objrub.iCodNaturezaReinf) );
              end;
            end;

          end;
          if lstFuncef.Count > 0 then
          begin
            lstFuncef.Sort;
            for lii := 0 to lstFuncef.count - 1 do
            begin
              if pStringLista.IndexOf( lstFuncef[lii] ) = -1 then
                pStringLista.Add(lstFuncef[lii]);
            end;
          end;
          if lstINSS.Count > 0 then
          begin
            lstINSS.Sort;
            for lii := 0 to lstINSS.count - 1 do
            begin
              if pStringLista.IndexOf( lstINSS[lii] ) = -1 then
                pStringLista.Add(lstINSS[lii]);
            end;
          end;
          Result := True;
        end;

      except
        Result := False;
      end;
    finally
       FreeAndNil(lstFuncef);
       FreeAndNil(lstINSS);
    end;
  end;

  function InsereBasePagamentoReinf(aIdTipoReinf: Integer; aVlReinf: Real; aTipo, aNaturezaReinf: integer; aIdProcJUD: Integer = 0): Boolean;
  var
    queryInsert: TwwQuery;
  begin
    Result := True;
    try
      queryInsert := TwwQuery.Create(nil);          //edilaine WO19556
      queryInsert.DataBaseName := 'BaseDados';

      queryInsert.close;
      queryInsert.sql.Clear;
      queryInsert.SQL.Add(' INSERT INTO BASEDEPAGAMENTOREINF');
      queryInsert.SQL.Add('   (IDBASEPGTOREINF, IDBASEPGTO, CODNATUREZAREINF, ');
      if aIdProcJUD > 0 then
      begin
        queryInsert.SQL.Add('   IDPROCJUD,');
      end;
      queryInsert.SQL.Add('   IDTIPOREINF, VLREINF)');
      queryInsert.SQL.Add(' VALUES');
      queryInsert.SQL.Add('   ( SEQTIPOREINF.NEXTVAL ');
      queryInsert.SQL.Add('   ,' + IntToStr(self.iIdBasePagamento));
      queryInsert.SQL.Add('   ,' + IntToStr(aNaturezaReinf));
      if aIdProcJUD > 0 then
      begin
        queryInsert.SQL.Add('   ,' + IntToStr(aIdProcJUD));
      end;
      queryInsert.SQL.Add('   ,' + IntToStr(aIdTipoReinf));
      if aTipo = 1 then
        queryInsert.SQL.Add('   , round(' + StringReplace((FloatToStr(aVlReinf)), ',', '.', []) + ',2))  ')
      else if aTipo = 2 then
        queryInsert.SQL.Add('   , round(' + StringReplace((FloatToStr(aVlReinf)), ',', '.', []) + ',0))  ');

      try
        queryInsert.ExecSQL;
        Result := false;
      except
        on E: EDBEngineError do
        begin
          Result := True;
        end;
      end;
    finally
      queryInsert.close;
      FreeAndNil(queryInsert);
    end;
  end;

  function CarregaCdsReinf(pRefReinf: string; pTipoSQL: integer = 0): Boolean;
  var
    sSQL: string;
  begin
    try
      {
      pTipoSQL = 0 - Utiliza igualdade | 1 - Utiliza ANY
      }
      dtmFolhaPrevia.qryReinf.close;
      dtmFolhaPrevia.qryReinf.sql.Clear;
      Result := False;
      if pTipoSQL = 0 then
      begin
        sSQL := ' SELECT C.IDRUBRICA' + ' FROM CONJUNTORUBXRUB C' + ' INNER JOIN CM.CONJUNTORUBRICA CR ON C.IDCONJUNTORUBRICA = CR.IDCONJUNTORUBRICA' + ' WHERE CR.CODIGO = ' + QuotedStr(pRefReinf);
        dtmFolhaPrevia.qryReinf.sql.add(sSQL);
      end
      else
      begin
        sSQL := ' SELECT C.IDRUBRICA' + ' FROM CONJUNTORUBXRUB C' + ' INNER JOIN CM.CONJUNTORUBRICA CR ON C.IDCONJUNTORUBRICA = CR.IDCONJUNTORUBRICA' + ' WHERE CR.CODIGO = ANY(' + pRefReinf + ')';
        dtmFolhaPrevia.qryReinf.sql.add(sSQL);
      end;
      
      dtmFolhaPrevia.qryReinf.Open;
      Result := dtmFolhaPrevia.qryReinf.RecordCount > 0;
    except
      Result := False;
    end;
  end;

  function ProcessaRubricasREINF(qryTipoREINF: twwquery; pGrupoREINF: string;
                                 pFontePagadora, pPlanoContabil: integer;
                                 pValor : Real;
                                 aTipo: integer;
                                 pCodNaturezaReinf: integer;
                                 aIdProcJud: integer = 0
                                 ): Boolean;
  var
    lbErro: boolean;
    sAuxTipoREINF, sSQL: string;
  begin
    lbErro := False;
    try
      try
        if pFontePagadora = 2 then
          sSQL := 'IDREFREINF = '+ QuotedStr(pGrupoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(pFontePagadora)
        else
          if pPlanoContabil > 0 then
            sSQL := 'IDREFREINF = '+ QuotedStr(pGrupoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(pFontePagadora) + ' AND IDPLANOPREVCONTABIL = ' + IntToStr(pPlanoContabil)
          else
            sSQL := 'IDREFREINF = '+ QuotedStr(pGrupoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(pFontePagadora);


        qryTipoREINF.Filtered := False;
        qryTipoREINF.Filter := sSQL;
        qryTipoREINF.Filtered := True;

        if not (qryTipoREINF.IsEmpty) then
        begin
          if InsereBasePagamentoReinf(qryTipoREINF.FieldByName('IDTIPOREINF').AsInteger, pValor, aTipo, pCodNaturezaReinf, aIdProcJud) then
          begin
            bErroInserePrevia := True;
          end;
        end
        else
        begin
          // Falta Parametrização pGrupoREINF
        end;
      except
        lbErro := True;
      end;
    finally
      Result := lbErro;
    end;  
  end;

