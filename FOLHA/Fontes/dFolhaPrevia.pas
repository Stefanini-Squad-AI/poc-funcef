      begin
                  if ListaPessoasComRRA.IndexOf(qryAux2.FieldByName('IDPESSOA').AsString) = -1 then // Felipe A. Santos - SOL 258357/17801 PPM 1083052
                     ListaPessoasComRRA.Add(qryAux2.FieldByName('IDPESSOA').AsString);

                  // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - início
                  if ListaBeneficiosComRRA.IndexOf(qryAux2.FieldByName('IDBENEFICIO').AsString) = -1 then
                     ListaBeneficiosComRRA.Add(qryAux2.FieldByName('IDBENEFICIO').AsString);
                  // Felipe A. Santos - SOL 258357/17801 PPM 1083052 - fim

