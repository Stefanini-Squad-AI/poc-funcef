procedure TdtmFolhaPrevia.ObtemQueryRubricaIndividual(aqry: twwquery;
  aidfundacao, aidtitular, aidpessoa: integer; asmescobranca, asmesinicio,
  asmesfim: string);
var ssql: string;
begin
  if copy(asmesinicio, 6, 2) = '13' then
    asmesinicio := asmescobranca;

  if copy(asmesfim, 6, 2) = '13' then
    asmesfim := asmescobranca;

  ssql:=
//    'SELECT MAX(RI.ULTMESPREPARO) OVER () AS ANOMESINI, NVL(DECODE(ri.Idplanocontabil,28,2,74,74,2,2,66,66,19,66,75,74),0) IDPLANOPREV, '+_clinefeed+ //SOL 129510 - Ádler Souza // SOL 254564 PPM 801622
    'SELECT NVL(MAX(RI.ULTMESPREPARO) OVER (),to_char(ADD_MONTHS('+' TO_DATE('+quotedstr(formatdatetime('dd/mm/yyyy', dtmFolhaPrevia.DataPagamento))+',''DD/MM/YYYY''),-1 ),''YYYY/MM'')) AS ANOMESINI, '+_clinefeed+
           ' NVL(DECODE(ri.Idplanocontabil,28,2,74,74,2,2,66,66,19,66,75,74),0) IDPLANOPREV, '+_clinefeed+ //SOL 129510 - Ádler Souza // SOL 254564 PPM 801622 // SOL 257453 PPM 959219
           'NVL(PFAV.TIPO, '' '') AS TIPO, '+_clinefeed+
           'RI.IDPESSOA,         RI.IDEMPRESA,         RI.CODPORTFORMA, '+_clinefeed+
           'RI.IDRUBRICA, NVL(RI.NUMOCORRENCIAS,0) AS NUMOCORRENCIAS, '+_clinefeed+
           'RI.IDRUBRICA13,      RI.IDRUBRICAPROVENTO13, '+_clinefeed+
           'RI.IDFAVORECIDO,     NVL(RI.IDREGRACALCULO,0) IDREGRACALCULO, '+_clinefeed+
           'RI.VALORRUBRICA,     RI.ANOMESINICIO, '+_clinefeed+
           'RI.FLGPERMANENTE,    RI.PARCELAS, '+_clinefeed+
           'RI.FLGPENSAOALIM,    RI.SEQRUBRICAINDIV, '+_clinefeed+
           'RI.DATAINICIO,       RI.DATAFINAL, '+_clinefeed+
           'RI.RUBRICAPROVENTOPA, '+_clinefeed+
           'NVL(RI.FLGUSAABONO,0) FLGUSAABONO, '+_clinefeed+
           'NVL(RI.FLGANTECIPABONO,0) FLGANTECIPABONO, '+_clinefeed+
           'NVL(RI.FLGANTECIPAABONOINSS,0) FLGANTECIPAABONOINSS, '+_clinefeed+ //BRUNO AZEVEDO SOL 140976 KINTANA 888346
           'DECODE(RI.FLGPERMANENTE,0,RI.ANOMESREF,'+quotedstr(asmescobranca)+') AS ANOMESREF, '+_clinefeed+

           //MARCIO DENILSON SOL 136748 KINTANA 821023
           'RI.ANOMESREF AS ANOMESREFORIGINAL, '+_clinefeed+
           'RI.IDMOTIVO, '+_clinefeed+
            //MARCIO DENILSON SOL 136748 KINTANA 821023

           'RI.NUMOCORRENCIAS AS NUMOCORPARCIAL, '+_clinefeed+
           'DECODE(RI.FLGBASEPA,1,1,PD.FLGDESCPENSAO) AS FLGDESCPENSAO, '+_clinefeed+
           'PFI.DATANASC, PFI.NUMDEPIRRF, PD.FLGIRRF, /*PD.FLGSALFAMILIA,*/ '+_clinefeed+   // edilaine - SOL 191668 / KTN 1820235
           'NVL(RXE.FLGSALFAMILIA,0) FLGSALFAMILIA, '+_clinefeed+   // edilaine - SOL 191668 / KTN 1820235
           'NVL(PD.TIPOBASEDESCONTO,5) AS TIPOBASEDESCONTO, '+_clinefeed+
           'PD.FLGCOMPOESALPART, PD.FLGCOMPOESALBENEF, '+_clinefeed+
           'NVL(PD.NUMPRIORIDADEFB,0) AS NUMPRIORIDADE, NVL(PD.CODIRRFDARF, '' '') AS CODIRRFDARF, '+_clinefeed+
           'NVL(PD.DESCPARCIAL, 0) AS DESCPARCIAL, '+_clinefeed+
           'PD.FLGESPECIAL, '+_clinefeed+
           'PD.FLGDESCONTO, PD.CODPROVDESC, '+_clinefeed+
           'PD.PRAZO AS PRAZORUB, '+_clinefeed+
           'DECODE(PD.FLGDESCONTO,2,''K'',DECODE(PD.FLGESPECIAL,0,''Y'',''W'')) FLGTIPODESC, '+_clinefeed+
           'DECODE(PD.FLGDESCONTO,2,RI.VALORRUBRICA,DECODE(PD.FLGESPECIAL,0,0,RI.VALORRUBRICA)) VALORINFO, '+_clinefeed+
           'RI.FLGCALCULACPMF, PD.CODFONTEPAGADORA, '+_clinefeed+
           'NVL(RI.ULTMESPREPARO, ''0000/00'') AS ULTMESPREPARO, RI.FLGCALCULACPMF, '+_clinefeed+
           'RI.NUMPROCINSS, '+_clinefeed+
           'RI.IDSEQINTERNOFB, '+_clinefeed+
           'NVL(PD.FLGRUBLEGAL,0) AS FLGRUBLEGAL, '+_clinefeed+
           'RI.FLGCONTROLASALDO, '+_clinefeed+
           'RI.VLRSALDOINICIAL, '+_clinefeed+
           'RI.FLGRETROACAO, '+
           'NVL(RI.IDPLANOCONTABIL,0) AS IDPLANOCONTABIL, '+
           'RI.VLRTOTALPROC '+_clinefeed+
           ' , PD.FLGMARGEM '+_clinefeed+ //Renato Visoni SOL 131523 KINTANA 750021
           ' , RI.MESCOMPREEM '+_clinefeed+ // SOL 140042 Kintana 900220
           ' , RI.RELACAODEPEN '+_clinefeed+ // Rodrigo Ramos - SIG35762 - 05/09/2017
           ', PD.FLGRRA '+_clinefeed+ // Felipe A. Santos - SOL 258357/17801 PPM 1083052
           ', PD.FLGEXCLUICONTRIBPA ' + _clinefeed+ //Osni Cavalcante - SIG 58950.59454
           ', RI.IDPROCJUD ' + _clinefeed +  // Alterado por FHBS - 01/08/2018 - SIG70586
           ', PD.FLGNAOPAGAFAVOREC    ' + _clinefeed +  //edilaine - SIG53825
           ', RI.IDPERFILINVEST    ' + _clinefeed +  //Andre Imakawa - SIG 101623       
    'FROM RUBRICAINDIV RI, PROVDESC PD, PESSOAFISICA PFI, PESSOA PFAV, VW_RUBXEVENTO RXE '+_clinefeed+    // edilaine - SOL 191668 / KTN 1820235 (VW_RUBXEVENTO RXE)
    'WHERE (RI.IDPESSOA = '+inttostr(aidpessoa)+') '+_clinefeed+
    'AND (RI.IDTITULAR = '+inttostr(aidtitular)+') '+_clinefeed+
    'AND (RI.IDEMPRESA = '+inttostr(aidfundacao)+') '+_clinefeed+
    'AND (RI.FLGTPRUBMANUT = ''1'') '+_clinefeed+
    'AND ((RI.FLGPERMANENTE = 1) OR ((RI.FLGPERMANENTE = 0) '+_clinefeed+
    'AND ((TO_CHAR(RI.DATAFINAL,''YYYY/MM'') >= '+quotedstr(asmesinicio)+') OR (RI.DATAFINAL IS NULL)) '+_clinefeed+
    'AND (RI.NUMOCORRENCIAS < RI.PARCELAS))) '+_clinefeed+   // SOL 124222 - KTN 628526
    'AND (PD.IDPROVENTO = RI.IDRUBRICA) '+_clinefeed+
    'AND (PD.IDPROVENTO = RXE.IDPROVENTO(+)) '+_clinefeed+    // edilaine - SOL 191668 / KTN 1820235
    'AND (PFI.IDPESSOA = RI.IDPESSOA) '+_clinefeed+
    'AND (PFAV.IDPESSOA(+) = RI.IDFAVORECIDO) '+_clinefeed+
    'AND (RI.FLGDESATIVADO IS NULL OR RI.FLGDESATIVADO = 0) '+_clinefeed+
    'AND (RI.ULTMESPREPARO IS NULL OR RI.ULTMESPREPARO < '+quotedstr(asmescobranca)+') '+_clinefeed;

  //Renato Visoni SOL 138157 Kintana 840763
  if bFolhaResgate then begin
    ssql := ssql + ' AND( NVL(RI.FLGRUBRICARESGATE,0) = 1) ';
  end else begin
    ssql := ssql + ' AND( NVL(RI.FLGRUBRICARESGATE,0) = 0) ';
  end;
  //Renato Visoni SOL 138157 Kintana 840763

  if SistemaFolha.FlgForcaDataFinalRubIndiv then
    ssql:=ssql+
      'AND ((TO_CHAR(RI.DATAFINAL,''YYYY/MM'') >= '+quotedstr(asmescobranca)+') OR (RI.DATAFINAL IS NULL)) '+_clinefeed;

  if asmescobranca > asmesfim then
    ssql:=ssql+
      'AND ((TO_CHAR(RI.DATAINICIO,''YYYY/MM'') <= '+quotedstr(asmescobranca)+') OR (RI.DATAINICIO IS NULL)) '+_clinefeed+
      'AND (RI.ULTMESPREPARO IS NULL OR RI.ULTMESPREPARO < '+quotedstr(asmescobranca)+') '+_clinefeed
  else
    ssql:=ssql+
      'AND ((TO_CHAR(RI.DATAINICIO,''YYYY/MM'') <= '+quotedstr(asmesfim)+') OR (RI.DATAINICIO IS NULL)) '+_clinefeed+
      'AND (RI.ULTMESPREPARO IS NULL OR RI.ULTMESPREPARO < '+quotedstr(asmesfim)+') '+_clinefeed;

  ssql:=ssql+
//    'ORDER BY PD.FLGDESCONTO,  PD.FLGRUBLEGAL, PD.FLGMARGEM ,PD.NUMPRIORIDADEFB, RI.SEQRUBRICAINDIV, FLGPENSAOALIM, IDREGRACALCULO '; //Renato Visoni SOL 131523 KINTANA 750021 //Everson TIBERO
    'ORDER BY PD.FLGDESCONTO,  PD.FLGRUBLEGAL, PD.FLGMARGEM ,PD.NUMPRIORIDADEFB, RI.SEQRUBRICAINDIV, RI.FLGPENSAOALIM, RI.IDREGRACALCULO '; //Renato Visoni SOL 131523 KINTANA 750021   //Everson TIBERO

  FazQuery(aqry, ssql);
end;

