// Andre Imakawa - SIG 97490 - Inicio
procedure TdtmFolhaPrevia.CorrigeBitributacaoExcessoDebito2(alstobjrubrica: tstringlist);
var
   objrub : tobjrubrica;
   objIN1343 : TObjIN1343;
   lii : Integer;
   ListaIN1343: TStringList;
   rValor,rSaldo, rSaldoInicial: Real;
   bPossuiINExcesso, bINExcesso: Boolean;

   auxSql, sValor, sSaldo : String;
   QryIN1343         : TwwQuery;
   QryUpdateHistBitri  : TwwQuery;

begin
  try
    bPossuiINExcesso := False;
    bINExcesso := False;
    ListaIN1343:= Tstringlist.create;

    //objIN1343  := TObjIN1343.Create;
    for lii:=0 to alstobjrubrica.count-1 do
    begin

      objrub:=(alstobjrubrica.objects[lii] as tobjrubrica);

      if objrub.iIdhstbitributacao > 0 then
      begin
        if objrub.rValorprovento <> objrub.rvalorrecebido then
          bPossuiINExcesso := True;
          
        if objrub.iflgdesconto = 1 then
        begin

          if objrub.rValorprovento <> 0 then
          begin
            rSaldo := objrub.rvalorrecebido - objrub.rValorprovento;
          end
          else
          begin
            rSaldo := objrub.rvalorrecebido;
          end;
          objIN1343  := TObjIN1343.Create;
          objIN1343.Idhstbitributacao := objrub.iIdhstbitributacao;
          objIN1343.ValorProvento := objrub.rValorprovento;
          objIN1343.ValorRecebido := objrub.rvalorrecebido;
          objIN1343.Saldo := rSaldo;
          objIN1343.FlgDesconto := objrub.iflgdesconto;
          ListaIN1343.AddObject(IntToStr(objrub.iIdhstbitributacao), objIN1343);

        end;
      end;

    end;

    if bPossuiINExcesso then
    begin
      //ListaIN1343.Sort;
      ListaIN1343.Sorted :=  True;

      for lii:=0 to ListaIN1343.count-1 do
      begin
        objIN1343:=(ListaIN1343.objects[lii] as tobjIN1343);

        if lii = 0  then
        begin
          auxSql := 'SELECT H.SALDO FROM CM.HSTBITRIBUTACAO H WHERE H.IDHSTBITRIBUTACAO = '+inttostr(objIN1343.Idhstbitributacao);
          QryIN1343 := TwwQuery.Create(nil);                  //edilaine WO19556
          QryIN1343.DataBaseName := 'BaseDados';
          QryUpdateHistBitri := TwwQuery.Create(nil);         //edilaine WO19556
          QryUpdateHistBitri.DataBaseName := 'BaseDados';

          QryIN1343.close;
          QryIN1343.SQL.clear;
          QryIN1343.SQL.Add(auxSql);
          QryIN1343.Open;

          if not (QryIN1343.IsEmpty) then
            rSaldoInicial := QryIN1343.fieldbyname('SALDO').AsFloat - objIN1343.ValorRecebido;
        end;

        if objIN1343.ValorProvento <> objIN1343.ValorRecebido then
        begin
          bINExcesso := True;
          rSaldoInicial := rSaldoInicial + objIN1343.ValorProvento;
          if rSaldoInicial < 0 then
            rSaldoInicial := 0;
          auxSql := ' UPDATE CM.HSTBITRIBUTACAO H ' + #13#10 +
                    ' SET  H.VALOR = ' + OraNumero(FloatToStr(objIN1343.ValorProvento )) +#13#10 +
                    '     ,H.SALDO = '+ OraNumero(FloatToStr(rSaldoInicial)) +#13#10 +
                    '  WHERE H.IDHSTBITRIBUTACAO  = ' +inttostr(objIN1343.Idhstbitributacao);
          QryUpdateHistBitri.close;
          QryUpdateHistBitri.SQL.clear;
          QryUpdateHistBitri.SQL.Add(auxSql);
          QryUpdateHistBitri.ExecSQL;
        end
        else
        begin
          rSaldoInicial := rSaldoInicial + objIN1343.ValorProvento;
          if bINExcesso then
          begin
            auxSql := ' UPDATE CM.HSTBITRIBUTACAO H ' + #13#10 +
                      ' SET  H.VALOR = ' + OraNumero(FloatToStr(objIN1343.ValorProvento )) +#13#10 +
                      '     ,H.SALDO = '+ OraNumero(FloatToStr(rSaldoInicial)) +#13#10 +
                      '  WHERE H.IDHSTBITRIBUTACAO  = ' +inttostr(objIN1343.Idhstbitributacao);

            QryUpdateHistBitri.close;
            QryUpdateHistBitri.SQL.clear;
            QryUpdateHistBitri.SQL.Add(auxSql);
            QryUpdateHistBitri.ExecSQL;
          end;
        end;


      end;
    end;

    try
      if assigned(ListaIN1343) then
      begin
        for lii:=0 to ListaIN1343.count-1 do
        begin
          objIN1343:=(ListaIN1343.objects[lii] as TObjIN1343);
          FreeAndNil(objIN1343);   //objIN1343.free;     //edilaine WO19556
        end;
        ListaIN1343.clear;
      end;
    except
    end;

  finally
    if bPossuiINExcesso then
    begin
      FreeAndNil(QryIN1343);
      FreeAndNil(QryUpdateHistBitri);
    end;                             
    FreeAndNil(ListaIN1343);
  end;
end;
// Andre Imakawa - SIG 97490 - Fim

