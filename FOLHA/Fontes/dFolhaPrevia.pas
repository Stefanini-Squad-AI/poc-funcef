        if objrub.smes = dtmFolhaPrevia.MesAbono then
        begin
          if (bTemAbonoNormal) or (copy(objrub.smes,6,2)='13') then //Renato Visoni SOL 103638 / Kintana 462855  //CONTROLA SE REGISTROS DE ABONO SÃO NORMAIS E NÃO APENAS DE REVISÃO
            ExecutaRegra(1); //base abono
        end
        else
          ExecutaRegra(0); //base normal
      end
      else
      begin
      // SIG 42619 Inicio
      { Apos a mudança do metodo de inclusão da ação judicial, saindo da RubricaIndiv e passando a ser com base na TMPDESC, o sistema
        não carregava a Base do IR Funcef, para a correção foi criado a verificação abaixo para os FLGTIPODESC 'J' ação judicial.
        Como o processo é chamado em dois pontos diferente (com pensão e sem pensão alimenticia)
        foi tratado pontualmente para os dois casos.
      }
        if (objrub.iorigem = 1) and (objrub.iflgdesconto = 0) and
           (not(aflgPA) and(objrub.iflgPA = 0)) and  (objrub.sflgtipodesc = 'J') then
        begin
           objrub.rValorprovento:=objrub.rvalorrecebido;
           ClassificaRubricaBase(
             objrub,
             0//objrub.rvalorrecebido
             );
        end
        else
        begin
           if (objrub.iorigem = 1) and (objrub.iflgdesconto = 0) and
              ((aflgPA) and(objrub.iflgPA = 1))  and  (objrub.sflgtipodesc = 'J') then
           begin
               objrub.rValorprovento:=objrub.rvalorrecebido;
               ClassificaRubricaBase(
                 objrub,
                 0//objrub.rvalorrecebido
                 );
           end;
        end;
        // SIG 42619 Final
        if (objrub.iorigem = 2) and (objrub.rvalorrecebido = 0) and
           (objrub.iidregracalculo = 0) then
        begin
          if (objrub.sflgtipodesc <> 'K') and (objrub.sflgtipodesc <> 'W') and
             (objrub.iflgdesconto < 2) then
            objrub.rvalorrecebido:=objrub.rvalorcalculo;
          if objrub.iflgdesconto = 0 then
          begin
            objrub.rValorprovento:=objrub.rvalorrecebido;
            ClassificaRubricaBase(
              objrub,
              objrub.rvalorrecebido
              );
          end;
        end;
      end;
    end;
  end;
end;

function TdtmFolhaPrevia.BuscaRubricaContribuicaoAcaoGanha(
  aiidplanoprev, aiidrubrica: integer): integer;
var lsmsg: string;
begin
  if FazQuery(qryAux3, 'SELECT IDRUBACJUD AS IDRUB '+
                       'FROM CONTPREV '+
                       'WHERE IDPLANOPREV = '+inttostr(aiidplanoprev)+' '+
                       'AND IDRUBRICA = '+inttostr(aiidrubrica)) then
  begin
    result:=qryAux3.fieldbyname('IDRUB').asinteger;
    lsmsg:='Rubrica de desconto de contribuição em ação judicial'; 
  end
  else
    if FazQuery(qryAux3, 'SELECT IDRUBATRACJUD AS IDRUB '+
                         'FROM CONTPREV '+
                         'WHERE IDPLANOPREV = '+inttostr(aiidplanoprev)+' '+
                         'AND IDRUBRICAATRASO = '+inttostr(aiidrubrica)) then
    begin
      result:=qryAux3.fieldbyname('IDRUB').asinteger;
      lsmsg:='Rubrica de desconto de contribuição com atraso em ação judicial'; 
    end
    else
      if FazQuery(qryAux3, 'SELECT IDRUB13ACJUD AS IDRUB '+
                           'FROM CONTPREV '+
                           'WHERE IDPLANOPREV = '+inttostr(aiidplanoprev)+' '+
                           'AND IDRUBDECTERC = '+inttostr(aiidrubrica)) then
      begin
        result:=qryAux3.fieldbyname('IDRUB').asinteger;
        lsmsg:='Rubrica de desconto de contribuição sobre abono anual em ação judicial'; 
      end
      else
        if FazQuery(qryAux3, 'SELECT IDRUBDEVACJUD AS IDRUB '+
                             'FROM CONTPREV '+
                             'WHERE IDPLANOPREV = '+inttostr(aiidplanoprev)+' '+
                             'AND IDRUBRICADEVOLUC = '+inttostr(aiidrubrica)) then
        begin
          result:=qryAux3.fieldbyname('IDRUB').asinteger;
          lsmsg:='Rubrica de devolução de contribuição em ação judicial'; 
        end
        else
          if FazQuery(qryAux3, 'SELECT NVL(IDRUB13DEVACJUD,IDRUBDECTERCDEVOL) AS IDRUB '+
                               'FROM CONTPREV '+
                               'WHERE IDPLANOPREV = '+inttostr(aiidplanoprev)+' '+
                               'AND IDRUBDECTERCDEVOL = '+inttostr(aiidrubrica)) then
          begin
            result:=qryAux3.fieldbyname('IDRUB').asinteger;
            lsmsg:='Rubrica de devolução de contribuição sobre abono anual em ação judicial'; 
          end
          else
          begin
            result:=0;
            lsmsg:='Não identificado vínculo da rubrica com uma contribuição';
          end;
  if result = 0 then
  begin
    dtmFolhaPrevia.qryAux3.close; // SOL 242740 PPM 575822
    dtmFolhaPrevia.ExibeMensagem(
      'Erro de parametrização. Rubrica referência: '+inttostr(aiidrubrica));
    dtmFolhaPrevia.ExibeMensagemSemRecebedor(lsmsg);
    result:=aiidrubrica;
  end;
end;

procedure TobjRecebedor.VerificaPortadorConsignatario(aiidfavorecido,
  aicodportforma: integer);
var lii, liidpessoa, licodportforma: integer;
begin
  if not bconsignatario then
    for lii:=0 to lstfavorecidos.count-1 do
    begin
      liidpessoa:=strtoint(Piece(lstFavorecidos[lii],';',1));
      licodportforma:=strtoint(Piece(lstFavorecidos[lii],';',2));
      if aiidfavorecido = liidpessoa then
      begin
        if aicodportforma <> licodportforma then
        begin
          //MOTIVO 1 DE BLOQUEIO DA PREVIA: DUPLICIDADE DE PORTADOR FORMA DE PA
          ibloqueiaprevia:=1;
          break;
        end;
      end;
    end;
end;

procedure TobjRecebedor.ProcessaRubrica;
 var lik, lij, liidmotivo, liocorparcial, lii : integer;
     lsmes,
     lsdatainicio,
     lsdatafinal,
     lsmesini,
     lsmesfim,
     sdttmpdesc  : string;
     lbinsere    : boolean;
     liddesconto,
     iIdRubrica,
     iIdRubProventoPA : integer;
     //CODIGO DE DARF PARA PROVENTO
     scoddarf: string;
     rvalorjud, rvalornormal: real;

  procedure InsereRubricaIndividual(aitipobase: integer);
  //BRUNO AZEVEDO SOL 135233 KINTANA 806340
  var
     sNumProcINSS: String;
     bOk: Boolean;
     sMesCompreemb: String;
     sCodProvDesc_Aux: string; // Andre Imakawa SIG 75244
  //BRUNO AZEVEDO SOL 135233 KINTANA 806340
  begin

    //BRUNO AZEVEDO SOL 135233 KINTANA 806340
    bOk := True;
    // SOL 242740 PPM 575822
    with dtmFolhaPrevia.qryNumProcINSS do begin
      Close;
      Sql.Clear;
      Sql.Add('   SELECT B.NUMPROCINSS  ');
      Sql.Add('     FROM BENEFBFCIARIO B  ');
      Sql.Add('    WHERE B.FONTEPAGADORA = 2  ');
      Sql.Add('      AND B.IDTPPAGTOBENEFIC = 1  ');
      Sql.Add('      AND B.IDPESSOA = :IDPESSOA   ');
      Sql.Add('      AND B.IDTITULAR = :IDTITULAR ');
      Sql.Add('      AND B.IDSITBENEFICIO <= 3   ');
      Sql.Add('    ORDER BY B.IDSITBENEFICIO ASC  ');
      ParamByName('IdPessoa').AsInteger  := dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idpessoa').asinteger;
      ParamByName('IdTitular').AsInteger := iidtitular;
      // SOL 242740 PPM 575822
      Open;
      sNumProcINSS := '';
      if (RecordCount > 0) then begin
        sNumProcINSS := FieldByName('NUMPROCINSS').AsString;
      end else begin
        if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asinteger = 2) then begin
          dtmFolhaPrevia.ExibeMensagem('Número de benefício de INSS não encontrado.');
          bOk := False;
        end;
      end;
      dtmFolhaPrevia.qryNumProcINSS.close; // SOL 242740 PPM 575822
    end;
    //BRUNO AZEVEDO SOL 135233 KINTANA 806340

    with dtmFolhaPrevia.qryNumProcINSS do begin
      Close;
      Sql.Clear;
      Sql.Add('SELECT DISTINCT hst.idpessoa, hst.idtitular, hst.fontepagadora, pa.mes '); // SOL 213511 - KTN 2040087
      Sql.Add('  FROM hstbenefbfciario hst, Paramantecipabono pa');
      Sql.Add(' WHERE hst.idpessoa = :IDPESSOA');
      Sql.Add('  AND hst.idtitular = :IDTITULAR');
      Sql.Add('  AND hst.mes = :MES');
      Sql.Add('  AND pa.mes = hst.mes');
      Sql.Add('  AND pa.idbeneficio = hst.idbeneficio');
      ParamByName('IdPessoa').AsInteger  := dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idpessoa').asinteger;
      ParamByName('IdTitular').AsInteger := iidtitular;

      // Andre Imakawa - SIG 39480 - Inicio
      if (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('flgpermanente').asinteger = 0) then
        ParamByName('MES').AsString        := formatdatetime('yyyy/mm',dtmFolhaPrevia.DataPagamento)
      else
        ParamByName('MES').AsString        := dtmFolhaPrevia.qryRubricaIndividual.FieldByName('AnoMesRef').AsString;
      // Andre Imakawa - SIG 39480 - Fim
      
      Open;
    end;

    if (bOk) then begin //BRUNO AZEVEDO SOL 135233 KINTANA 806340
      lbinsere:=false;
      if ((aitipobase in [0,2]) and //TRATA REGRESSIVA TIPO = 2
          (lstMesRefProv[lii] >
           dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ULTMESPREPARO').asstring))
         or
         ((aitipobase = 1) and
          ((//not dtmfolhaprevia.TemAntecipacaoAbono and //BRUNO AZEVEDO COMENTADO SOL 174082 KINTANA 1570356
            //BRUNO AZEVEDO INICIO 13º SOL 153417 KINTANA 1279467
            (
            // Andre Imakawa - SIG 99499 - Inicio
            ((dtmFolhaPrevia.qryRubricaIndividual.FieldByName('flgusaabono').asinteger = 1) and
            (((Copy(dtmFolhaPrevia.qryRubricaIndividual.FieldByName('AnoMesRef').asString,6,2) = prmMesAbonoFund) and (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 1)) or
            (Copy(dtmFolhaPrevia.qryRubricaIndividual.FieldByName('AnoMesRef').asString,6,2) = prmMesAbonoINSS) and (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 2))
            // Andre Imakawa - SIG 99499 - Fim
            ) or
              (Copy(dtmFolhaPrevia.qryRubricaIndividual.FieldByName('AnoMesRef').asString,6,2) = '13'))) // Renato Visoni SOL 103638 / Kintana 462855
            //BRUNO AZEVEDO INICIO 13º SOL 153417 KINTANA 1279467
            or
           //BRUNO AZEVEDO SOL 140976 KINTANA 888346
           (//dtmfolhaprevia.TemAntecipacaoAbono and //BRUNO AZEVEDO COMENTADO SOL 174082 KINTANA 1570356
            (((dtmFolhaPrevia.qryNumProcINSS.FieldByName('FontePagadora').AsString = '2') and (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('FLGANTECIPAABONOINSS').asinteger = 1)) or

            //BRUNO AZEVEDO INICIO 13º SOL 153417 KINTANA 1279467
            //((dtmFolhaPrevia.qryNumProcINSS.FieldByName('FontePagadora').AsString <> '2') and (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('flgantecipabono').asinteger = 1)))
            ((dtmFolhaPrevia.qryNumProcINSS.FieldByName('FontePagadora').AsString = '1') and (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('flgantecipabono').asinteger = 1)))

            //BRUNO AZEVEDO FIM13º SOL 153417 KINTANA 1279467
            )
            or
            // Andre Imakawa - SIG 32022 - Inicio
            ((dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('flgpermanente').asinteger = 0) and
              (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('flgusaabono').asinteger = 1) and
               // Andre Imakawa - SIG 99499 - Inicio
               //(copy(dtmFolhaPrevia.MesCobranca,6,2) = dtmFolhaPrevia.qryPrevia.FieldByName('MESPGABONO').asString) and
               (((Copy(dtmFolhaPrevia.MesCobranca,6,2) = prmMesAbonoFund) and (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 1)) or  // Andre Imakawa - SIG 104025
                 (Copy(dtmFolhaPrevia.MesCobranca,6,2) = prmMesAbonoINSS) and (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asInteger = 2)) and // Andre Imakawa - SIG 104025
               // Andre Imakawa - SIG 99499 - Fim
               (copy(lstMesRefProv[lii],6,2) = '13' ))
            // Andre Imakawa - SIG 32022 - Fim
            )
           //BRUNO AZEVEDO SOL 140976 KINTANA 888346
          ) then
      begin
        //SE MES ABONO E RUBRICA NAO ENTRA PARA ABONO INIBIR
        if dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('flgpermanente').asinteger = 0 then
        begin
            // if dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('parcelas').asinteger > liocorparcial then   // FIM - SOL:123797  - Daniel Begnami
            lbinsere:=true;
          liocorparcial:=liocorparcial+1;
        end
        else
          lbinsere:=true;
      end;

      //INSERIR NA LISTA DE FAVORECIDOS PARA QUALQUER
      //   TIPO DE RUBRICA INDIVIDUAL
      if (SistemaFolha.FlgEfetuaPagtoFavOutros = 1) and
         lbinsere and
         (not dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idfavorecido').isnull) and
         (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idfavorecido').asinteger > 0) and
         (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('flgnaopagafavorec').asinteger = 0) then     //edilaine - SIG53825
      begin

          VerificaPortadorConsignatario(
            dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idfavorecido').asinteger,
            dtmFolhaPrevia.qryRubricaIndividual.FieldByName('codportforma').asinteger);
          if (ibloqueiaprevia = 0) then
            lstFavorecidos.add(
               inttostr(dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idfavorecido').asinteger)+';'+
               inttostr(dtmFolhaPrevia.qryRubricaIndividual.FieldByName('codportforma').asinteger));

      end;

      //INCLUI RUBRICA INDIVIDUAL DE PA APENAS UMA VEZ COM MÊS
      // DE REFERENCIA O ÚLTIMO MÊS.
      if dtmFolhaPrevia.qryRubricaIndividual.FieldByName('flgpensaoalim').asinteger = 1 then
      begin
        { Testa se é uma folha de abono ou antecipação de abono para atribuir a     }
        { rubrica de desconto do recebedor e a rubrica de provento do consignatário }
        if (aitipobase = 1) then
        begin
          if not dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubrica13').isnull then
            iIdRubrica:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubrica13').asinteger
          else
          begin
            if SistemaFolha.IdRubConsigDescAbono > 0 then
              iIdRubrica:=SistemaFolha.IdRubConsigDescAbono
            else
              iIdRubrica:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubrica').asinteger;
          end;
          if not dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubricaprovento13').isnull then
            iIdRubProventoPA:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubricaprovento13').asinteger
          else
          begin
            if SistemaFolha.IdRubConsigDescAbono > 0 then
              iIdRubProventoPA:=SistemaFolha.IdRubConsigCredAbono
            else
              iIdRubProventoPA:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('rubricaproventopa').asinteger;
          end;
        end
        else
        begin
          iIdRubrica       := dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubrica').asinteger;
          iIdRubProventoPA := dtmFolhaPrevia.qryRubricaIndividual.FieldByName('rubricaproventopa').asinteger
        End;

        // Andre Imakawa - SIG 90244 - Inicio
        if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('flgnaopagafavorec').asinteger = 1) then
          iIdRubProventoPA := 0;
        // Andre Imakawa - SIG 90244 - Fim

        if (SistemaFolha.FlgEfetuaPagtoFavOutros = 0) and
           lbinsere and
           (not dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idfavorecido').isnull) and
           (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idfavorecido').asinteger > 0) and
           (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('flgnaopagafavorec').asinteger = 0) then     //edilaine - SIG53825
        begin
          VerificaPortadorConsignatario(
            dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idfavorecido').asinteger,
            dtmFolhaPrevia.qryRubricaIndividual.FieldByName('codportforma').asinteger);
          if (ibloqueiaprevia = 0) then
            lstFavorecidos.add(
               inttostr(dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idfavorecido').asinteger)+';'+
               inttostr(dtmFolhaPrevia.qryRubricaIndividual.FieldByName('codportforma').asinteger));
        end;


       //MARCIO DENILSON SOL 136748 KINTANA 821023
       if ( (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('IDMOTIVO').asinteger = 3051) and
             (not dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESREFORIGINAL').IsNull) and
             (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESREFORIGINAL').AsString <> '')
           ) then
          lsmes:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESREFORIGINAL').asstring
        Else //MARCIO DENILSON SOL 136748 KINTANA 821023

        if (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('flgpermanente').asinteger = 0) and
           ((dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('parcelas').asinteger = 1) or
            (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('parcelas').asinteger > 1) and
            (SistemaFolha.MantemMesRefConstanteRB = 1)) and
           (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESREF').asstring <> '') then
          lsmes:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESREF').asstring
        else
          if (aitipobase = 1) then
            lsmes:=dtmFolhaPrevia.MesAbono
          else
          begin
            if (dtmFolhaPrevia.qryNumProcINSS.FieldByName('mes').AsString = lstMesRefProv[lii]) and // SOL 213511 - KTN 2040087
               //((dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('Flgantecipabono').asstring = '1') or  // SOL 213511 - KTN 2040087  //  SOL 213876 KTN 2041157
               (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('flgantecipaabonoinss').asstring = '1') // SOL 213511 - KTN 2040087
            then
               lsmes:=copy(dtmFolhaPrevia.MesAbono,1,5)+'13'
               //lsmes:=dtmFolhaPrevia.MesAbono
            else
            if sUltMesRefReal < dtmFolhaPrevia.MesCobranca then
              lsmes:=sUltMesRefReal
            else
              lsmes:=dtmFolhaPrevia.MesCobranca;
          end;
      end
      else
      begin
        //CPrev - 26840 - Inicio
        if (aitipobase = 1) then
        begin
          //iIdRubrica:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubrica').asinteger;
          if not dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubrica13').isnull then
            iIdRubrica := dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubrica13').asinteger
          ELSE
        iIdRubrica:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubrica').asinteger;

          //iIdRubProventoPA:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('rubricaproventopa').asinteger;
          if not dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubricaprovento13').isnull then
            iIdRubProventoPA:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubricaprovento13').asinteger
          else
        iIdRubProventoPA:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('rubricaproventopa').asinteger;
        End
        Else
        Begin
        iIdRubrica:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('idrubrica').asinteger;
        iIdRubProventoPA:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('rubricaproventopa').asinteger;
        End;
        //CPrev - 26840 - Fim

        //MARCIO DENILSON SOL 136748 KINTANA 821023
        if ( (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('IDMOTIVO').asinteger = 3051) and
             (not dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESREFORIGINAL').IsNull) and
             (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESREFORIGINAL').AsString <> '')
           ) then
          lsmes:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESREFORIGINAL').asstring
        Else //MARCIO DENILSON SOL 136748 KINTANA 821023

        if (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('flgpermanente').asinteger = 0) and
           ((dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('parcelas').asinteger = 1) or
            (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('parcelas').asinteger > 1) and
            (SistemaFolha.MantemMesRefConstanteRB = 1)) and
           (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESREF').asstring <> '') then
          lsmes:=dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('ANOMESREF').asstring
        else
        if (dtmFolhaPrevia.qryNumProcINSS.FieldByName('mes').AsString = lstMesRefProv[lii]) and   // SOL 213511 - KTN 2040087
               //((dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('Flgantecipabono').asstring = '1') or // SOL 213511 - KTN 2040087   // SOL 213876 KTN 2041157
               (dtmFolhaPrevia.qryRubricaIndividual.fieldbyname('flgantecipaabonoinss').asstring = '1') // SOL 213511 - KTN 2040087
           then  // xavier 311
           begin
             lsmes:=copy(lstMesRefProv[lii],1,5)+'13';
         //    //lsmes:=lstMesRefProv[lii];
           end
        else
          lsmes:=lstMesRefProv[lii];
      end;

      if lbinsere then
      begin
        try

          //TRATA REGRESSIVA TIPO = 2
          if (aitipobase = 2) then
            scoddarf:='5565'
          else
            scoddarf:=dtmFolhaPrevia.qryRubricaIndividual.FieldByName('codirrfdarf').asstring;

          //BRUNO AZEVEDO SOL 140042/6601
          {sMesCompreemb := '';
          if (dtmFolhaPrevia.qryRubricaIndividual.FieldByName('CODFONTEPAGADORA').asinteger = 2) then begin
            sMesCompreemb := dtmFolhaPrevia.qryRubricaIndividual.FieldByName('MESCOMPREEM').asstring;
