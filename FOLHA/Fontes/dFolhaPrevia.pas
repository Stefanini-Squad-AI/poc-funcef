          'SELECT H.VALOR, H.FLGTIPO, A.IDRUBDEVOLUCAO, A.IDRUBNORMAL, '+_clinefeed+
          '       B.IDRUBRICACORATRASORRA, B.IDRUBRICACORDEVOLUCAORRA, H.MESREFERENCIA, B.IDBENEFICIO ' +_clinefeed+ // Felipe A. Santos - SOL 258357/17801 PPM 1083052
