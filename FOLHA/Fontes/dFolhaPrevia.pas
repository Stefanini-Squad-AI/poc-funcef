procedure TdtmFolhaPrevia.CorrigeBitributacaoExcessoDebito(
  aobjrub: tobjrubrica; pidtitular: Integer);
var
   auxSql : String;
   QryProvdesc         : TwwQuery;
   QryUpdateHistBitri  : TwwQuery;
begin
 try
