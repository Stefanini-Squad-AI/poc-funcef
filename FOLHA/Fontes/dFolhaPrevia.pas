procedure TdtmFolhaPrevia.BuscaRubricasDescontosLegais;
begin
  if FazQuery(qryAux3, 'SELECT CR.IDRUBRICA       '+
                       '  FROM CONJUNTORUBXRUB CR '+
                       '  JOIN CONJUNTORUBRICA CJ '+
                       '    ON CJ.IDCONJUNTORUBRICA = CR.IDCONJUNTORUBRICA '+
                       ' WHERE CJ.CODIGO = ''RUBLEGAIS'' ') then
  begin
    while not dtmFolhaPrevia.qryAux3.eof do
    begin
      if dtmFolhaPrevia.lstRubDescLegal.IndexOf( dtmFolhaPrevia.qryAux3.Fields[0].AsString ) < 0 then
         dtmFolhaPrevia.lstRubDescLegal.Add( dtmFolhaPrevia.qryAux3.Fields[0].AsString );

      dtmFolhaPrevia.qryAux3.next;
    end;
  end;
  dtmFolhaPrevia.qryAux3.close;
end;


function TobjRecebedor.BuscaValorTotalRubricas(iFontePagadora : integer;
                                               lSomaFontes : boolean = false) : double;      //edilaine WO33925
var
  ind : integer;
  objTipoRub : TobjRubrica;
begin
  result := 0;

  for ind := 0 to lstRubricas.count-1 do
  begin
    objTipoRub := (lstRubricas.Objects[ind] As TobjRubrica);
    if dtmFolhaPrevia.lstRubDescLegal.IndexOf( IntToStr(objTipoRub.iidrubrica) ) >= 0 then
    begin
      if (objTipoRub.rValorRecebido > 0) and ((objTipoRub.iFontePagadora = iFontePagadora) or (lSomaFontes)) and  //edilaine WO33925
         (objTipoRub.iflgirrf = 1) then     //edilaine WO31036
         result := result + objTipoRub.rValorRecebido;
    end;
  end;
end;
