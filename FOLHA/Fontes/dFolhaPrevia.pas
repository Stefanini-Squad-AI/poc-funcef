                if (queryperfil.FieldByName('IDPERFIL').AsString = '0') then
                   dtmFolhaPrevia.ExibeMensagem('Erro inserir Prévia, perfil de investimento não localizado. Mês Ref. = '+smes+' | Pessoa: '+IntToStr(iIDPESSOA)+'  Titular: '+IntToStr(iIDTITULAR)+'  Plano: '+IntToStr(iIDPLANOPREV))
