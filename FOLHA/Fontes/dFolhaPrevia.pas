function TdtmFolhaPrevia.DeterminaTipoMargem(aobjrub : TobjRubrica) : integer;
begin
  if objRecebedor.iidtitular = qryPrevia.fieldbyname('idtitular').asinteger then
  begin
    if objRecebedor.iidbeneficiobase = 0 then
    begin
      objRecebedor.iidbeneficiobase:=qryPrevia.FieldByName('idbeneficio').asinteger;
      objrecebedor.icodmoedabase:=qryPrevia.fieldbyname('indicereajbenef').asinteger;

    end
    else
      if (qryPrevia.FieldByName('TIPOBENEFICIO').asinteger in
          [0,1,2,3,4,7,8,10,11,12]) and
         //APENAS PARA SUPLEMENTAÇÃO DA FUNDAÇÃO
         (qryPrevia.FieldByName('FLGREFERENCIA').asinteger = 0) then

	if objRecebedor.iidbeneficiobase <> qryPrevia.FieldByName('idbeneficio').asinteger then
        begin
          objRecebedor.iidbeneficiobase:=qryPrevia.FieldByName('idbeneficio').asinteger;
          objrecebedor.ifontepgbase:=qryPrevia.FieldByName('fontepagadora').asinteger;
          objrecebedor.icodmoedabase:=qryPrevia.fieldbyname('indicereajbenef').asinteger;
        end;

    // Andre Imakawa - SIG 85861 - Inicio
    if (qryPrevia.FieldByName('fontepagadora').asinteger = 2) and (objRecebedor.iidbeneficiobaseINSS = 0) then
      objRecebedor.iidbeneficiobaseINSS:=qryPrevia.FieldByName('idbeneficio').asinteger;
    // Andre Imakawa - SIG 85861 - Fim
  end;

  if (qryPrevia.FieldByName('FlgReferencia').asinteger = 0) and
     //(objrecebedor.sTpModalidade = 'CD') and //SOL 257943 PPM 970494 // Andre Imakawa - SIG 25129
     (qryPrevia.FieldByName('TPMODALIDADE').asString = 'CD') and // Andre Imakawa - SIG 25129
     ((qryPrevia.FieldByName('TIPOOPCAOIR').AsInteger = 2) or          //edilaine - SIG71773
      (qryPrevia.FieldByName('FLGPORTADO').AsInteger = 1) and          //edilaine - SIG71773
      (qryPrevia.FieldByName('FLGIRREGRESSIVO').AsInteger = 1)) then   //edilaine - SIG71773
  begin
    if copy(dtmfolhaprevia.objetorubrica.smes,6,2) = '13' then
      result:=6
    else
      if trim(aobjrub.scodirrfdarfori) = '3223' then
        result:=7
      else
        result:=5;
  end
  else
  if (qryPrevia.FieldByName('FlgReferencia').asinteger = 0) and
     (objrecebedor.sTpModalidade = 'CD') and //SOL 257943 PPM 970494
     ((qryPrevia.FieldByName('TIPOOPCAOIR').AsInteger <> 2) and        //edilaine - SIG71773
      (qryPrevia.FieldByName('FLGPORTADO').AsInteger = 1) and          //edilaine - SIG71773
      (qryPrevia.FieldByName('FLGIRREGRESSIVO').AsInteger = 0)) and    //edilaine - SIG71773
     (trim(aobjrub.scodirrfdarf) = '3223') then
  begin
    result:=8;
  end
  else
  begin
    If copy(dtmfolhaprevia.objetorubrica.smes,6,2) = '13' then
    begin
      if (qryPrevia.FieldByName('FlgReferencia').asinteger = 1) then
      begin
        if (qryPrevia.FieldByName('FlgPagaInss').asinteger = 1) then
          result:=4;
      end
      else
        result := 3;
    end
    else
      If trim(aobjrub.scodirrfdarf) <> '' Then
      Begin
        //If Trim(aobjrub.scodirrfdarf) = '3223' Then
        If (Trim(aobjrub.scodirrfdarf) = '3223') or (Trim(aobjrub.scodirrfdarf) = '3556') Then // SOL 248327 PPM 668845
          result := 1
        Else
          if (qryPrevia.FieldByName('FlgReferencia').asinteger = 1) then
          begin
            if (qryPrevia.FieldByName('FlgPagaInss').asinteger = 1) then
              result:=2
            else
              result:=9;
          end
          else
            result:=0;
      end
      else
        result:=0;
  end;
end;

procedure TobjRecebedor.AlocaBase(asnomebase: string; aiindice: integer;
  var aobjBase: tObjBase; aobjrub: tObjRubrica;
  arvalorrubrica: real;
  flgbitrib: boolean = false); // SOL 218360 - KTN 2049283
  Var
    lbBenefIsento: Boolean; // Andre Imakawa - SIG 49800-60759
begin
  if not Assigned(aobjBase) then
    aobjbase:=Tobjbase.create(asnomebase, aiindice, aobjrub.scodirrfdarf);

  if aobjrub.sflgtipodesc = 'B' then
  begin
    if aobjbase.MultiPlano then
    begin
      aobjbase.PlanoPrev:=self.iidplanoprevglobal;
      aobjbase.PlanoContabil:=self.iidplanocontabilglobal;
      aobjbase.PlanoOrigem:=self.iidplanoorigemglobal;  // Andre Imakawa - SIG 66634
    end
    else
    begin
      if (aobjbase.PlanoPrev <> aobjrub.iidplanoprev) or
         (aobjbase.PlanoContabil <> aobjrub.iidplanocontabil) then
      begin
        if (aobjbase.PlanoPrev <> 0) then
          aobjbase.MultiPlano:=true;
        aobjbase.PlanoPrev:=aobjrub.iidplanoprev;
        aobjbase.PlanoContabil:=aobjrub.iidplanocontabil;
        aobjbase.PlanoOrigem:=aobjrub.iidplanoorigem;  // Andre Imakawa - SIG 66634
      end;
    end;
  end;

