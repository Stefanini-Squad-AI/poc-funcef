// Andre Imakawa - SIG 99651 - Inicio
function TdtmFolhaPrevia.fn_RetornaNaturezaReinf(pidplanoprev, pidpessoa,
  pidtitular, pidrubrica, pidbeneficio, pfontepagadora: integer; pDatapagamento: tdatetime): boolean;
  var sp_NatInformeReinf : TwwStoredProc;
begin

  Result := false;
  sp_NatInformeReinf := TwwStoredProc.Create( dtmFolhaPrevia );
  try
   sp_NatInformeReinf.DatabaseName   := dtmBaseDados.dbBaseDados.DataBaseName;
   sp_NatInformeReinf.StoredProcName := 'SP_FB_RETORNA_NATUREZA_REINF';
   sp_NatInformeReinf.Params.CreateParam( ftInteger, 'PIDPLANOPREV'   , ptInput).AsInteger;
   sp_NatInformeReinf.Params.CreateParam( ftInteger, 'PIDPESSOA'      , ptInput).AsInteger;
   sp_NatInformeReinf.Params.CreateParam( ftInteger, 'PIDTITULAR'     , ptInput).AsInteger;
   sp_NatInformeReinf.Params.CreateParam( ftInteger, 'PIDRUBRICA'     , ptInput).AsInteger;
   sp_NatInformeReinf.Params.CreateParam( ftInteger, 'PIDBENEFICIO'   , ptInput).AsInteger;
   sp_NatInformeReinf.Params.CreateParam( ftInteger, 'PFONTEPAGADORA' , ptInput).AsInteger;
   sp_NatInformeReinf.Params.CreateParam( ftdatetime,'PDATAPAGAMENTO' , ptInput).AsDateTime;

   sp_NatInformeReinf.Params.CreateParam(  ftInteger,  'SCODNATUREZAREINF'  , ptOutput).AsInteger;


   sp_NatInformeReinf.parambyName('PIDPLANOPREV').Asinteger      := pidplanoprev;
   sp_NatInformeReinf.parambyName('PIDPESSOA').Asinteger         := pidpessoa;
   sp_NatInformeReinf.parambyName('PIDTITULAR').Asinteger        := pidtitular;
   sp_NatInformeReinf.parambyName('PIDRUBRICA').Asinteger        := pidrubrica;
   sp_NatInformeReinf.parambyName('PFONTEPAGADORA').Asinteger    := pfontepagadora;
   sp_NatInformeReinf.parambyName('PDATAPAGAMENTO').AsDatetime   := pDatapagamento;
   if pidbeneficio > 0 then
      sp_NatInformeReinf.parambyName('PIDBENEFICIO').Asinteger      := pidbeneficio
   else
      sp_NatInformeReinf.parambyName('PIDBENEFICIO').clear;

   sp_NatInformeReinf.Prepare;
   sp_NatInformeReinf.ExecProc;

   dtmFolhaPrevia.scodNatRendimentoReinf := sp_NatInformeReinf.parambyName('SCODNATUREZAREINF').AsInteger;

   Result := true;

  finally
    FreeAndNil(sp_NatInformeReinf);
  end;

end;
