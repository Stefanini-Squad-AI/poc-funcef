        sSQL := ' SELECT TR.IDREFREINF, TR.TIPOREGISTRO FROM CM.TIPOREINF TR '        + #13#10 +
                ' WHERE TR.FLGATIVO = 1 '                                             + #13#10 +
                ' AND EXISTS(SELECT 1 FROM CM.TIPOREINF_GRUPORUBRICA TRG '            + #13#10 +
                ' WHERE TR.IDREFREINF = TRG.IDREFREINF AND TRG.FLGATIVO = 1  '        + #13#10 +
                '   AND TRG.IDREFREINF = ANY ('+ sFiltroTipoREINF + ')'               + #13#10 +
                '   AND TRG.ROTINA_PREVIA IS NULL )'   + #13#10 +
                ' GROUP BY TR.IDREFREINF, TR.TIPOREGISTRO '                           + #13#10 +
                ' ORDER BY TR.IDREFREINF ';


        queryReinfGrupo.SQL.Add(sSQL);
        queryReinfGrupo.open;

        queryGrupoRubrica.close;
        queryGrupoRubrica.sql.Clear;

        sSQL := ' SELECT TRG.IDREFREINF, TRG.IDGRUPORUBRICA FROM CM.TIPOREINF_GRUPORUBRICA TRG WHERE TRG.FLGATIVO = 1';

        queryGrupoRubrica.SQL.Add(sSQL);
        queryGrupoRubrica.open;

        if (not (queryReinfGrupo.IsEmpty)) and (not(queryGrupoRubrica.IsEmpty)) then
        begin

          for lii_Tipo := 0 to queryReinfGrupo.RecordCount - 1 do
          begin
            SetLength(arVlRePlanNaoSald,4);
            SetLength(arVlRePlanSald,4);
            SetLength(arVlReb,4);
            SetLength(arVlINSS,4);
            SetLength(arVlNP,4);


            sAuxTipoREINF := queryReinfGrupo.FieldByName('IDREFREINF').AsString;
            iTipoRegistro := queryReinfGrupo.FieldByName('TIPOREGISTRO').Asinteger;

            if iTipoRegistro = 0 then
            begin
              sTipoREINFExigSusp := 'REINFSUSP';
              sFiltroTipoREINFIdade := 'REINFIDADE';
              sFiltroTipoREINFDepen := 'REINFDEP';
              lVlIdade := aVlIdade;
              lVlDepen := aVlDepen;
            end
            else
            begin
              sTipoREINFExigSusp := 'REINFSUSP13';
              sFiltroTipoREINFIdade := 'REINFIDADE13';
              sFiltroTipoREINFDepen := 'REINFDEP13';
              lVlIdade := aVlIdade13;
              lVlDepen := aVlDepen13;
            end;

            for lii := 0 to lstRubricas.count - 1 do
            begin
              objrub := (lstRubricas.objects[lii] as tobjrubrica);

              if iTipoRegistro = 0 then
              begin
                if (copy(objrub.smes, 6, 2) = '13') then
                  continue;
              end
              else
              begin
                if (copy(objrub.smes, 6, 2) <> '13') then
                  continue;

                //edilaine WO14701 : inicio
                if (dtmFolhaPrevia.qryReinf.locate('IDRUBRICA', objrub.iidrubrica, [])) then
                  continue;
                //edilaine WO14701 : fim
              end;

              if (objrub.iFlgGravou = 1) and
                 (objrub.iCodNaturezaReinf = pCodNaturezaReinf) and
                 (objrub.rvalorprovento > 0) and
                 (objrub.iFlgRRA <> 1) and      //Andre Imakawa - WO2546-2645-2706
                 (objrub.iflgdesconto <> 2) and  //Andre Imakawa - WO2546-2645-2706
                 //(((iTipoRegistro = 0) and (objrub.iflgdesconto=0))or           //Andre Imakawa - WO2546-2645-2706
                 //((iTipoRegistro = 1) and(objrub.iflgdesconto in [0, 1]))) and  //Andre Imakawa - WO2546-2645-2706

                 {(((bMolestiaGrave)and(objrub.iflgdesconto=0))
                   or
                   (not(bMolestiaGrave)and(objrub.iflgdesconto in [0, 1]))) and}

                 (queryGrupoRubrica.locate('IDREFREINF;IDGRUPORUBRICA', VarArrayOf([sAuxTipoREINF, objrub.iIdGrupoRubrica]), []))


                 then
              begin

                if (objrub.iflgdesconto = 1) or (objrub.iflgdesconto = 2) then
                  lrsinal := -1
                else
                  lrsinal := 1;

                if objrub.ifontepagadora = 2 then
                begin
                  arVlINSS[iTipoRegistro] := arVlINSS[iTipoRegistro] + (lrsinal * objrub.rvalorprovento);
                end
                else
                begin
                  case objrub.iidplanocontabil of
                    2:  begin
                          arVlRePlanNaoSald[iTipoRegistro] := arVlRePlanNaoSald[iTipoRegistro] + (lrsinal * objrub.rvalorprovento)
                        end;
                    28: begin
                          arVlRePlanSald[iTipoRegistro] := arVlRePlanSald[iTipoRegistro] + (lrsinal * objrub.rvalorprovento);
                        end;
                    66: begin
                          arVlReb[iTipoRegistro] := arVlReb[iTipoRegistro] + (lrsinal * objrub.rvalorprovento);
                        end;
                    74: begin
                          arVlNP[iTipoRegistro] := arVlNP[iTipoRegistro] + (lrsinal * objrub.rvalorprovento);
                        end;
                  end;
                end;

              end;

            end;

            for liiPlano := 0 to 4 do
            begin

              lVlSusp := 0;
              lVlGravar := 0;
              case liiPlano of
                // FUNCEF - REPLAN NAO SALDADO
                0 : begin
                      lVlGravar   :=  arVlRePlanNaoSald[iTipoRegistro];

                      if lVlGravar = 0 then
                        continue;

                      iFontePagadora := 1;
                      iPlanoPrev := 2;
                      iPlanoPrevContab := iPlanoPrev;
                    end;
                // FUNCEF - REPLAN SALDADO
                1 : begin
                      lVlGravar   :=  arVlRePlanSald[iTipoRegistro];

                      if lVlGravar = 0 then
                        continue;

                      iFontePagadora := 1;
                      iPlanoPrev := 2;
                      iPlanoPrevContab := 28;
                    end;
                // FUNCEF - REB
                2 : begin
                      lVlGravar   :=  arVlReb[iTipoRegistro];

                      if lVlGravar = 0 then
                        continue;

                      iFontePagadora := 1;
                      iPlanoPrev := 66;
                      iPlanoPrevContab := iPlanoPrev;
                    end;
                // FUNCEF - NOVO PLANO
                3 : begin
                      lVlGravar   :=  arVlNP[iTipoRegistro];

                      if lVlGravar = 0 then
                        continue;

                      iFontePagadora := 1;
                      iPlanoPrev := 74;
                      iPlanoPrevContab := iPlanoPrev;
                    end;
                // INSS
                4 : begin
                      lVlGravar   :=  arVlINSS[iTipoRegistro];

                      if lVlGravar = 0 then
                        continue;

                      iFontePagadora := 2;
                    end;

              end;

              // Andre Imakawa - WO3011 - Inicio
              lbProgressivo := True;
              if assigned(lstPlanos) and (iFontePagadora = 1) then
              begin
                liPlanolista := lstPlanos.indexof(inttostr(iPlanoPrev));
                if (liPlanolista >=0)  then
                begin
                  objplano:=(lstPlanos.objects[liPlanolista] as tobjplano);
                  if objPlano.OpcaoIR = 2 then
                    lbProgressivo := False;
                end;
              end;
              // Andre Imakawa - WO3011 - Fim

              // Abatimento da Idade
              if (lVlGravar > 0) and (lVlIdade > 0) and not(bMolestiaGrave) and
                 not(dtmFolhaPrevia.bFolhaResgate) and (MoraNoBrasil) and // Andre Imakawa - WO1861
                 (lbProgressivo) then // Andre Imakawa - WO3011
              begin
                if lVlGravar >= lVlIdade then
                begin
                  lVlGravar := lVlGravar - lVlIdade;
                  if ProcessaRubricasREINF(qryTipoREINF, sFiltroTipoREINFIdade, iFontePagadora, iPlanoPrevContab, lVlIdade, 1, pCodNaturezaReinf) then
                  begin
                    lbErro := True;
                  end;
                  if iTipoRegistro = 0 then
                    aVlIdade := 0
                  else
                    aVlIdade13 := 0;
                  lVlIdade := 0;
                end
                else
                begin
                  lVlIdade := lVlIdade  - lVlGravar;

                  if iTipoRegistro = 0 then
                    aVlIdade := lVlIdade
                  else
                    aVlIdade13 := lVlIdade;

                  if ProcessaRubricasREINF(qryTipoREINF, sFiltroTipoREINFIdade, iFontePagadora, iPlanoPrevContab, lVlGravar, 1, pCodNaturezaReinf) then
                  begin
                    lbErro := True;
                  end;
                  lVlGravar := 0;
                  Continue;
                end;
              end;

              // Lançamento valor Dependente
              if (lVlDepen > 0) and (lVlGravar > 0) and not(bMolestiaGrave) and
                 not(dtmFolhaPrevia.bFolhaResgate) and (MoraNoBrasil) and
                 (lbProgressivo) then
              begin
                if lVlGravar >= lVlDepen then
                begin
                  if ProcessaRubricasREINF(qryTipoREINF, sFiltroTipoREINFDepen, iFontePagadora, iPlanoPrevContab, lVlDepen, 1, pCodNaturezaReinf) then
                  begin
                    lbErro := True;
                  end;
                  if iTipoRegistro = 0 then
                    aVlDepen := 0
                  else
                    aVlDepen13 := 0;
                  lVlDepen := 0;

                end
                else
                begin
                  lVlDepen := lVlDepen  - lVlGravar;

                  if iTipoRegistro = 0 then
                    aVlDepen := lVlDepen
                  else
                    aVlDepen13 := lVlDepen;

                  if ProcessaRubricasREINF(qryTipoREINF, sFiltroTipoREINFDepen, iFontePagadora, iPlanoPrevContab, lVlGravar, 1, pCodNaturezaReinf) then
                  begin
                    lbErro := True;
                  end;

                end;
              end;



              // Transferencia para Exigibilidade Suspensa
              //if (lVlGravar > 0) and (bPossuiAcaoBitrib) and not(bMolestiaGrave) and (iFontePagadora = 1) then
              //if (lVlGravar <> 0) and not(bMolestiaGrave) and (iFontePagadora = 1) then    // Andre Imakawa - WO 4662
              if (lVlGravar <> 0) and not(bMolestiaGrave) and (iFontePagadora = 1) and       // Andre Imakawa - WO 4662
                (lbProgressivo) then                                                         // Andre Imakawa - WO 4662
              begin
                if assigned(lstAcaoJudicial) then
                  lVlSuspTot := 0;  // edilaine WO23052
                  for liAcao:=0 to lstAcaoJudicial.count-1 do
                  begin
                    lVlSusp := 0;
                    //lVlSuspTot := 0;  // Andre Imakawa - WO3861     edilaine WO23052
                    objAcaoJudicial:=(lstAcaoJudicial.objects[liAcao] as tobjAcaoJudicial);
                    liIdProcJud := objAcaoJudicial.iIdProcJud;
                    case objAcaoJudicial.iTipo of
                      //WO23262 - leandro - inicio
                      0:
                        begin
                          lVlSusp := lVlGravar ;
                          lVlGravar :=  0;
                        end;
                      //WO23262 - leandro - fim
                      1:
                        begin
                          if objAcaoJudicial.iSitProcesso = 0 then         //WO18754 leandro
                          begin                                            //WO18754 leandro
                          if objAcaoJudicial.rPercaAcao > 0 then
                            lVlSusp := TruncaMoeda(lVlGravar * (objAcaoJudicial.rPercaAcao/100));

                            lVlGravar := TruncaMoeda(lVlGravar - lVlSusp); //WO18754 leandro
                          end;                                             //WO18754 leandro
                        end;
                      2:
                        begin
                          //leandro wo15216 - inicio
                          if objAcaoJudicial.iFlgAcaoEqua = 0 then
                            lVlSusp := lVlGravar
                          else
                            lVlSusp := 0;
                          //leandro wo15216 - fim
                        end;
                    end;

                    lVlSuspTot := lVlSuspTot + lVlSusp; // Andre Imakawa - WO3861

                    if lVlSusp > 0 then
                      if ProcessaRubricasREINF(qryTipoREINF, sTipoREINFExigSusp, iFontePagadora, iPlanoPrevContab, lVlSusp, 1, pCodNaturezaReinf, liIdProcJud) then
                      begin
                        lbErro := True;
                      end;

                  end;

                {
                lVlSusp := TruncaMoeda(lVlGravar * rPercAcaoBitrib);
                if rpercacjudganha = 1 then
                  lVlGravar := 0
                else
                  lVlGravar := TruncaMoeda(lVlGravar - lVlSusp);
                }
              end;

              //Lançamento da Exigibilidade Suspensa
              {
              if lVlSusp > 0 then
              begin
                if ProcessaRubricasREINF(qryTipoREINF, sTipoREINFExigSusp, iFontePagadora, iPlanoPrevContab, lVlSusp, 1, pCodNaturezaReinf) then
                begin
                  lbErro := True;
                end;
              end;
              }

              // Lançamento do Rendimento Tributavel / Molestia Grave
              //if (lVlGravar <> 0) and (lVlGravar > lVlSuspTot) then  // Andre Imakawa - WO3861
              if (lVlGravar <> 0) and (lVlGravar >= lVlSuspTot) then   // Arnaldo WO7681 / WO4303
                if ProcessaRubricasREINF(qryTipoREINF, sAuxTipoREINF, iFontePagadora, iPlanoPrevContab, lVlGravar, 1, pCodNaturezaReinf) then
                  begin
                    lbErro := True;
                  end;

            end;


            SetLength(arVlRePlanNaoSald,0);
            SetLength(arVlRePlanSald,0);
            SetLength(arVlReb,0);
            SetLength(arVlINSS,0);
            SetLength(arVlNP,0);

            queryReinfGrupo.next;
          end;

        end;

      except
        lbErro := True;
      end;
    finally
      FreeAndNil(arVlRePlanNaoSald);
      FreeAndNil(arVlRePlanSald);
      FreeAndNil(arVlReb);
      FreeAndNil(arVlNP);
      FreeAndNil(arVlINSS);
      FreeAndNil(queryReinfGrupo);// Andre Imakawa - SIG 135627
      FreeAndNil(queryGrupoRubrica);// Andre Imakawa - SIG 135627
      Result := lbErro;
    end
  end;

  function ProcessaRubricasREINFContribuicao(qryTipoREINF: twwquery; pGrupoREINF: string;
                                            pCodNaturezaReinf:Integer): Boolean;
  var
    lii, liiTipo, liTpRub,  liiPlano: Integer;
    lTpProv, lTPDesc: Integer;
    objrub: tobjrubrica;
    iPlanoPrev, iPlanoPrevContab, iFontePagadora: integer;
    lrsinal: Real;
    lbErro: boolean;
    sSQL, sAuxTipoREINF: string;
    lVlGravar: Real;
    arVlINSS, arVlRePlanNaoSald, arVlRePlanSald, arVlReb, arVlNP: array of Real;
    liIdProcJud, liAcao : integer;        //edilaine WO22891
    objAcaoJudicial : tobjAcaoJudicial;   //edilaine WO22891
  begin
    try
      lbErro := False;

      try
        SetLength(arVlRePlanNaoSald,4);
        SetLength(arVlRePlanSald,4);
        SetLength(arVlReb,4);
        SetLength(arVlINSS,4);
        SetLength(arVlNP,4);

        //carrega rubricas de adiantamento de abono  //edilaine WO14701
        CarregaCdsReinf('REINFABADT');               //edilaine WO14701
        
        //edilaine WO22891 : inicio
        liIdProcJud := 0;
        if (pGrupoREINF = 'REINFCONTRIBEQUA') then
        begin
          if assigned(lstAcaoJudicial) then
            for liAcao:=0 to lstAcaoJudicial.count-1 do
            begin
              objAcaoJudicial:=(lstAcaoJudicial.objects[liAcao] as tobjAcaoJudicial);
              if objAcaoJudicial.iFlgAcaoEqua = 1 then
              begin
                liIdProcJud := objAcaoJudicial.iIdProcJud;
                break;
              end;
            end;
        end;
        //edilaine WO22891 : fim
        for lii := 0 to lstRubricas.count - 1 do
        begin
          objrub := (lstRubricas.objects[lii] as tobjrubrica);

          //edilaine WO14701 : inicio
          //if (objrub.iusaabono <> 1) or (dtmFolhaPrevia.qryReinf.locate('IDRUBRICA', objrub.iidrubrica, [])) then
          if (copy(objrub.smes, 6, 2) = '13') and                                                                //edilaine WO17263
             (objrub.iusaabono <> 1) or (dtmFolhaPrevia.qryReinf.locate('IDRUBRICA', objrub.iidrubrica, [])) then
             continue;
          //edilaine WO14701 : fim

          if (objrub.iFlgGravou = 1) and
             (objrub.iCodNaturezaReinf = pCodNaturezaReinf) and
             (objrub.sflgtipodesc = 'P') and
             (((pGrupoREINF = 'REINFCONTRIBEQUA') and
             (dtmFolhaPrevia.qryRubricaEqua.locate('IDRUBRICA', objrub.iidrubrica, [])))
             or
             ((pGrupoREINF = 'REINFCONTRIB') and
             not(dtmFolhaPrevia.qryRubricaEqua.locate('IDRUBRICA', objrub.iidrubrica, []))))
             then
          begin
            if (copy(objrub.smes, 6, 2) <> '13') then
            begin
              if objrub.iflgdesconto = 0 then
              begin
                lrsinal := -1;
                liTpRub := 0;
              end
              else
              begin
                lrsinal := 1;
                liTpRub := 1;
              end;
            end
            else
            begin
              if objrub.iflgdesconto = 0 then
              begin
                lrsinal := -1;
                liTpRub := 2;
              end
              else
              begin
                lrsinal := 1;
                liTpRub := 3;
              end;
            end;


            if objrub.ifontepagadora = 2 then
            begin
              arVlINSS[liTpRub] := arVlINSS[liTpRub] + (lrsinal * objrub.rvalorprovento);
            end
            else
            begin
              case objrub.iidplanocontabil of
                2:  begin
                      arVlRePlanNaoSald[liTpRub] := arVlRePlanNaoSald[liTpRub] + (lrsinal * objrub.rvalorprovento)
                    end;
                28: begin
                      arVlRePlanSald[liTpRub] := arVlRePlanSald[liTpRub] + (lrsinal * objrub.rvalorprovento);
                    end;
                66: begin
                      arVlReb[liTpRub] := arVlReb[liTpRub] + (lrsinal * objrub.rvalorprovento);
                    end;
                74: begin
                      arVlNP[liTpRub] := arVlNP[liTpRub] + (lrsinal * objrub.rvalorprovento);
                    end;
              end;
            end;

          end;

        end;

        // 0 - Normal | 1 - Abono
        for liiTipo := 0 to 1 do
        begin

          if liiTipo = 0 then
          begin
            sAuxTipoREINF := pGrupoREINF;
            lTpProv := 0;
            lTPDesc := 1;
          end
          else
          begin
            sAuxTipoREINF := pGrupoREINF + '13';
            lTpProv := 2;
            lTPDesc := 3;
          end;

          for liiPlano := 0 to 4 do
          begin
            case liiPlano of
              // FUNCEF - REPLAN NAO SALDADO
              0 : begin
                    lVlGravar :=  arVlRePlanNaoSald[lTpProv] + arVlRePlanNaoSald[lTPDesc];
                    if lVlGravar = 0 then
                      Continue;
                    iFontePagadora := 1;
                    iPlanoPrev := 2;
                    iPlanoPrevContab := iPlanoPrev;
                  end;
              // FUNCEF - REPLAN SALDADO
              1 : begin
                    lVlGravar :=  arVlRePlanSald[lTpProv] + arVlRePlanSald[lTPDesc];
                    if lVlGravar = 0 then
                      Continue;
                    iFontePagadora := 1;
                    iPlanoPrev := 2;
                    iPlanoPrevContab := 28;
                  end;
              // FUNCEF - REB
              2 : begin
                    lVlGravar :=  arVlReb[lTpProv] + arVlReb[lTPDesc];
                    if lVlGravar = 0 then
                      Continue;
                    iFontePagadora := 1;
                    iPlanoPrev := 66;
                    iPlanoPrevContab := iPlanoPrev;
                  end;
              // FUNCEF - NOVO PLANO
              3 : begin
                    lVlGravar :=  arVlNP[lTpProv] + arVlNP[lTPDesc];
                    if lVlGravar = 0 then
                      Continue;
                    iFontePagadora := 1;
                    iPlanoPrev := 74;
                    iPlanoPrevContab := iPlanoPrev;
                  end;
              // INSS
              4 : begin
                    lVlGravar :=  arVlINSS[lTpProv] + arVlINSS[lTPDesc];
                    if lVlGravar = 0 then
                      Continue;
                    iFontePagadora := 2;
                  end;
            end;

            if lVlGravar <> 0 then
            begin
              //if ProcessaRubricasREINF(qryTipoREINF, sAuxTipoREINF, iFontePagadora, iPlanoPrevContab, lVlGravar, 1, pCodNaturezaReinf) then               //edilaine WO22891
              if ProcessaRubricasREINF(qryTipoREINF, sAuxTipoREINF, iFontePagadora, iPlanoPrevContab, lVlGravar, 1, pCodNaturezaReinf, liIdProcJud) then    //edilaine WO22891
              begin
                lbErro := True;
              end;
            end;


          end;


        end;
      except

      end;

    finally
      SetLength(arVlRePlanNaoSald,0);
      SetLength(arVlRePlanSald,0);
      SetLength(arVlReb,0);
      SetLength(arVlINSS,0);
      SetLength(arVlNP,0);

      FreeAndNil(arVlRePlanNaoSald);
      FreeAndNil(arVlRePlanSald);
      FreeAndNil(arVlReb);
      FreeAndNil(arVlNP);
      FreeAndNil(arVlINSS);
    end;

  end;

  function ProcessaRubricasREINFPA(qryTipoREINF: twwquery; pCodNaturezaReinf: integer; pGrupoREINF: string): Boolean;
  var
    lii, liTipo, liContadorPlano, liFontePagadora, liPlanoContabil: Integer;
    objrub: tobjrubrica;
    objPlano: tobjPlano;
    lrsinal: Real;
    lbErro: boolean;
    sAuxTipoREINF: string;
    iTipoRegistro, iFontePagadora, iPlanoPrev, iPlanoPrevContab: integer;
    lVlGravar, lValor: real;
    queryGrupoRubrica: TwwQuery; //Andre Imakawa - WO4324
    sSQL: String;                //Andre Imakawa - WO4324
  begin
    lbErro := False;
    try
      queryGrupoRubrica   := TwwQuery.Create(Nil); //Andre Imakawa - WO4324
      try
        //Andre Imakawa - WO4324 - Inicio
        queryGrupoRubrica.DataBaseName := 'BaseDados';

        queryGrupoRubrica.close;
        queryGrupoRubrica.sql.Clear;

        sSQL := ' SELECT TRG.IDGRUPORUBRICA FROM CM.TIPOREINF_GRUPORUBRICA TRG WHERE TRG.FLGATIVO = 1 AND TRG.IDREFREINF = ' + QuotedStr(pGrupoREINF) ;

        queryGrupoRubrica.SQL.Add(sSQL);
        queryGrupoRubrica.open;
        //Andre Imakawa - WO4324 - Fim
        
        liContadorPlano := 0;
        for liFontePagadora := 1 to 2 do
        begin

          for liContadorPlano := 0 to lstPlanos.count - 1 do
          begin
            objPlano := (lstPlanos.objects[liContadorPlano] as tobjplano);
            liPlanoContabil := objPlano.PlanoContabil;

            for liTipo := 0 to 1 do
            begin
              lValor   :=0;
              for lii := 0 to lstRubricas.count - 1 do
              begin
                objrub := (lstRubricas.objects[lii] as tobjrubrica);

                if (objrub.iFlgGravou = 1)
                  and (((liTipo=0) and ((copy(objrub.smes, 6, 2) <> '13'))) or ((liTipo=1) and ((copy(objrub.smes, 6, 2) = '13'))))
                  and (objrub.ifontepagadora = liFontePagadora)
                  and (objPlano.PlanoPrev = objrub.iidplanoprev)
                  and (objrub.iCodNaturezaReinf = pCodNaturezaReinf)
                  and (objrub.iflgdesconto in [0, 1])
                  and (objrub.rvalorprovento > 0)
                  and (queryGrupoRubrica.locate('IDGRUPORUBRICA', objrub.iIdGrupoRubrica, [])) //Andre Imakawa - WO4324
                  and(((pGrupoREINF = 'REINFPAPAG') and (objrub.iflgpa = 1)
                       and (objrub.sflgtipodesc = 'Y')
                       and not(bconsignatario))
                       or
                      ((pGrupoREINF = 'REINFPAREC')
                      and (objrub.sflgtipodesc = 'Q') ))

                  then
                begin

                  if objrub.iflgdesconto = 0 then
                    if (pGrupoREINF = 'REINFPAPAG') then
                      lrsinal := -1
                    else
                      lrsinal := 1
                  else
                    if (pGrupoREINF = 'REINFPAPAG') then
                      lrsinal := 1
                    else
                      lrsinal := -1;

                  lValor := lValor + (TruncaMoeda(objrub.rValorprovento) * lrsinal);
                end;
              end;

              if lValor <> 0 then
              begin
                if liTipo = 0 then
                  sAuxTipoREINF := pGrupoREINF
                else
