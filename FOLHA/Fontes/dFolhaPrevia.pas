                 (objrub.iCodNaturezaReinf = pCodNaturezaReinf) and
                 //(objrub.sflgtipodesc = 'I') and                                                  // Andre Imakawa - WO 5170
                 ((objrub.sflgtipodesc = 'I') or                                                    // Andre Imakawa - WO 5170
                 (queryGrupoRubrica.locate('IDRUBRICA', objrub.iidrubrica, []))) and                // Andre Imakawa - WO 5170 // Andre Imakawa - WO 6431
                 (((objPlano.OpcaoIR <> 2) and (objrub.ifontepagadora = 1)) or                       // Andre Imakawa - WO4625
                 (objrub.ifontepagadora = 2)) and
                 (objrub.iFlgRRA <> 1) and  //Andre Imakawa - WO2546-2645-2706
                 not(dtmFolhaPrevia.qryReinf.locate('IDRUBRICA', objrub.iidrubrica, []))and
                 (objrub.iflgdesconto in [0, 1]) then
              begin

                if (copy(objrub.smes, 6, 2) = '13') then
                  sAuxTipoREINF := 'REINFIRPRO13'
                else
                  sAuxTipoREINF := 'REINFIRPRO';

                if objrub.iflgdesconto = 1 then
                  lrsinal := 1
                else
                  lrsinal := -1;

                qryTipoREINF.Filtered := False;
                if objrub.ifontepagadora = 2 then
                  qryTipoREINF.Filter := 'IDREFREINF = ' + QuotedStr(sAuxTipoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(objrub.ifontepagadora)
                else
                  qryTipoREINF.Filter := 'IDREFREINF = ' + QuotedStr(sAuxTipoREINF) + ' AND CODFONTEPAGADORA = ' + IntToStr(objrub.ifontepagadora) + ' AND IDPLANOPREVCONTABIL = ' + IntToStr(objrub.iidplanocontabil);
                qryTipoREINF.Filtered := True;

                if not (qryTipoREINF.IsEmpty) then
                begin
                  if InsereBasePagamentoReinf(qryTipoREINF.FieldByName('IDTIPOREINF').AsInteger, (lrsinal * objrub.rvalorprovento), 1, pCodNaturezaReinf) then
                  begin
                    lbErro := True;
                  end;
                end
                else
                begin
                  // Falta Parametrização REINF04 // sAuxTipoREINF
                end;

              end;
            end;
          end;

        end;

      except
        lbErro := True;
      end;
    finally
      Result := lbErro;
      FreeAndNil(queryGrupoRubrica);    // Andre Imakawa - WO 5170
    end
  end;

