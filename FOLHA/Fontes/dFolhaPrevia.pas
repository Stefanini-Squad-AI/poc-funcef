  sSQL : String;
  iFlgResgate: Integer;
begin
  iFlgResgate := 0;
  pResgateParcelado := 0;
  
  sSQL := ' SELECT CASE WHEN FLGRESGATE = 1 OR FLGRESGATEPARCELADO = 1 THEN 1 ELSE 0 END FLGRESGATE, '  +
          '        FLGRESGATEPARCELADO ' +               // Andre Imakawa - SIG 26149
          ' FROM CTRLINTERFACE WHERE IDLOTE = :IDLOTE '; // Andre Imakawa - SIG 26149

   Try
     With TwwQuery.Create(nil) do          //edilaine WO19556
       begin
         DataBaseName := dtmBaseDados.dbBaseDados.DataBaseName;
         SQL.Add(sSQL);
         ParamByName('IDLOTE').AsInteger   := piIdLote;
         Open;
         if not IsEmpty then
         begin
          iFlgResgate := FieldByName('FLGRESGATE').AsInteger;
