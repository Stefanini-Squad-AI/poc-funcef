function TobjRecebedor.RetornaPMPUltMesProcessado(piIDPessoa, piIdTitular,
  piIDPlanoPrev: Integer): Real;
var
  sSQL : String;
  //BRUNO AZEVEDO SOL 252458 KINTANA 754788
  sDataUltPagto: String;
  //BRUNO AZEVEDO SOL 252458 KINTANA 754788
begin

   //BRUNO AZEVEDO SOL 252458 KINTANA 754788 - CARREGAR A ÚLTIMA DATA DE PAGAMENTO
   sSQL :='SELECT DATAPAGAMENTO'
//        +'   FROM BASEDEPAGAMENTOPREVIA' //SOL 207789 KINTANA 2029238
        +'   FROM BASEDEPAGAMENTO' //SOL 207789 KINTANA 2029238
        +'  WHERE IDPESSOA =' + IntToStr( piIDPessoa )
        +'    AND IDTITULAR =' + IntToStr( piIdTitular )
        +'    AND DATAPAGAMENTO < To_DATE(' +QuotedStr(DateToStr(dtmFolhaPrevia.DataPagamento))+ ' )' // André Imakawa - SIG 41892
       // +'  ORDER BY IDBASEPGTOPREVIA DESC'; //SOL 207789 KINTANA 2029238
        +'  ORDER BY idbasepgto DESC';

   with TwwQuery.Create(nil) do       //edilaine WO19556
   begin
     DataBaseName := dtmBaseDados.dbBaseDados.DataBaseName;

     SQL.Add(sSQL);
     Open;
     First;

     sDataUltPagto := (FieldByName('DATAPAGAMENTO').AsString);

     Close;
     Free;
   end;
   //BRUNO AZEVEDO SOL 252458 KINTANA 754788

   //BRUNO AZEVEDO SOL 252458 KINTANA 754788 - NÃO ESTAVA FAZENDO O CÁLCULO COM A DIB CONFORME PEDE ESPECIFICAÇÃO.
   if sDataUltPagto <> '' then  //SIG20805
      result := (dtmFolhaPrevia.DataPagamento - StrToDate(sDataUltPagto)) / 365
   else
   begin
         dtmFolhaPrevia.ExibeMensagem('Mensagem de erro : Ao processar o segundo pagamento não foi encontrado registro na base de pagamento para o processamento anterior.');
         dtmFolhaPrevia.ExibeMensagemSemRecebedor('---------------------------------------------------------------');
         result := 0;
   end;
    {  end;
   end;}
   //result := (dtmFolhaPrevia.DataPagamento -  dtmFolhaPrevia.qryPrevia.fieldbyname('DATAFINAL').AsDateTime) / 365;
   //BRUNO AZEVEDO SOL 252458 KINTANA 754788

   sSQL :='SELECT PRAZOMEDIOPONDERADO'
        //+'  FROM BASEDEPAGAMENTOEFETIVACAO' //SOL 207789 KINTANA 2029238
        +'  FROM BASEDEPAGAMENTO' //SOL 207789 KINTANA 2029238
        +' WHERE IDPESSOA =' + IntToStr( piIDPessoa )
        +'   AND IDTITULAR =' + IntToStr( piIdTitular )
        +' ORDER BY idbasepgto DESC';

