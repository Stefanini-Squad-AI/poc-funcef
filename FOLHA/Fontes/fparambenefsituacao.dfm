  object qryBeneficio: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDBENEFICIO, NOME AS BENEFICIO '
      'FROM BENEFICIO ORDER BY NOME')
    ValidateWithMask = True
    Left = 172
    Top = 161
  end
  object qryPatrocinadora: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT PE.IDPESSOA, PE.NOME'
      'FROM PESSOA PE, PATRO PA'
      'WHERE  PE.IDPESSOA = PA.IDPESSOA'
      'ORDER BY PE.NOME'
      ' ')
    ValidateWithMask = True
    Left = 396
    Top = 25
  end
