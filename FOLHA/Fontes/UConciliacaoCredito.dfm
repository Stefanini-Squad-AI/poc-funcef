    Top = 59
  end
  object qryConvenio: TwwQuery
    CachedUpdates = True
    AutoRefresh = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT DISTINCT P.CODPORTFORMA, lpad(to_char(P.CODPORTFORMA),3,'#39 +
        '0'#39') ||'#39' - '#39'|| P.DESCRICAO AS DESCRICAO,'
      ' RPAD(p.numempresabanco,6,'#39'0'#39') AS numempresabanco'
      'FROM PORTADORFORMA  P'
      
        'INNER JOIN HSTFOLHABENEFCAP H ON (H.CODPORTFORMA = P.CODPORTFORM' +
        'A)'
      'WHERE H.IDHSTFOLHABENEF = :IDHSTFOLHABENEF'
      'ORDER BY CODPORTFORMA'
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 393
    Top = 59
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDHSTFOLHABENEF'
        ParamType = ptUnknown
      end>
  end
