  object SqlCamposIndiv: TCMSqlParams
    SQL.Strings = (
      'SELECT C.DESCRICAOEVENTO,'
      '       d1.coddocumento AS NUMEROAP,'
      '       D1.Datavencto As DataVenctoAP,'
      '       d.coddocumento AS NUMEROAR,'
      '       D.Datavencto As DataVenctoAR,'
      
        '       To_date(H.DATAREGULARIZACAO, '#39'DD/MM/RRRR'#39') AS DATAREGULAR' +
        'IZACAO,'
      '       H.TIPOREGULARIZACAO,'
      '       H.NUMBANCO,'
      '       H.NUMAGENCIA,'
      '       H.CONTABANCARIA,'
      '       H.OBSERVACAO,'
      '       C.CODIGORETORNO,'
      '       H.ARQUIVOREGULARIZACAO  AS ARQUIVO,'
      '       H.EXTENSAOARQUIVO,'
      '       H.NOMEARQUIVO,'
      '       H.IDHSTREGULARIZACAOFOLHA,'
      '       A.IDPESSOA,'
      '       A.IDTITULAR     '
      '       FROM HSTREGULARIZACAOFOLHA H'
      ' INNER JOIN ARQUIVODERETORNOCAIXA A'
      '    ON (H.IDARQUIVORETORNOCAIXA = A.IDARQUIVORETORNOCAIXA)'
      ' INNER JOIN BASEDEPAGAMENTO B'
      '    ON (B.IDBASEPGTO = A.IDBASEPGTO AND'
      '       B.IDHSTFOLHABENEF = A.IDHSTFOLHABENEF)'
      ' INNER JOIN PORTADORFORMA P'
      '    ON (P.CODPORTFORMA = B.CODPORTFORMA)'
      ' INNER JOIN CADASTROEVENTOSDEREGULARIZACAO C'
      
        '    ON (C.IDCADEVENTOSDEREGULARIZACAO = H.IDCADEVENTOSDEREGULARI' +
        'ZACAO)'
      
        '  left outer join documento d on (d.coddocumento = h.coddocument' +
        'ocar)    '
      
        ' left outer join documento d1 on (d1.coddocumento = h.coddocumen' +
        'tocap)'
      '  WHERE A.IDARQUIVORETORNOCAIXA = :IDARQUIVORETORNOCAIXA'
      ' AND  B.IDHSTFOLHABENEF = :IDHSTFOLHABENEF'
      'ORDER BY   H.TRGDTINCLUSAO  DESC, H.DATAREGULARIZACAO DESC'
      ' '
      ' '
      ' ')
    ClientDataSet = CdsDadosIndividuais
    Left = 705
    Top = 136
  end
