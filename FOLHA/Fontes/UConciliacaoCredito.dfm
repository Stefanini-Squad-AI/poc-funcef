  object QryBasePagamento: TwwQuery
    Tag = 5
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDBASEPGTO,'
      '       IDTITULAR,'
      '       IDPESSOA,'
      '       MATRICULA,'
      '       DATAPAGAMENTO,'
      '       MES,'
      '       MESCOBRANCA,'
      '       PRAZOMEDIOPONDERADO,'
      '       PERCENTUALIRREGRESSIVO,'
      '       BASECALCIRREGRESSIVO,'
      '       VLRIRREGRESSIVO,'
      '       VLRBRUTO,'
      '       VLRDESCONTO,'
      '       VLRLIQUIDO,'
      '       TIPOFOLHA,'
      '       FLGRISCO,'
      '       FLGEFETIVADO,'
      '       IDHSTFOLHABENEF,'
      '       TRGUSERINCLUSAO,'
      '       TRGDTINCLUSAO,'
      '       TRGUSERALTERACAO,'
      '       TRGDTALTERACAO,'
      '       FLGISENTOIRRF,'
      '       FLGMOLESTIAGRAVE,'
      '       DATAINICIOMOLESTIA,'
      '       DATAFIMMOLESTIA,'
      '       NUMPROCINSS,'
      '       FLGSOMAIRSUPINSS,'
      '       NUMDEPIRRF,'
      '       NUMBANCO,'
      '       NUMAGENCIA,'
      '       CONTACORRENTE,'
      '       DATANASC,'
      '       CODPORTFORMA,'
      '       NUMDOCUMENTO,'
      '       IRINFORMATIVO,'
      '       IRINFORMATIVO13,'
      '       IRCOMPENSADO,'
      '       IRCOMPENSADO13,'
      '       MARGEMCONSIGNAVEL,'
      '       RENDABASE,'
      '       MARGEMREAL,'
      '       IDLOTE'
      '  FROM CM.BASEDEPAGAMENTO'
      ' WHERE IDHSTFOLHABENEF = :IDHSTFOLHABENEF'
      '   AND CODPORTFORMA = :CODPORTADORFORMA'
      '   AND (IDTITULAR||'#39','#39'||IDPESSOA) = :TITULARPESSOA'
