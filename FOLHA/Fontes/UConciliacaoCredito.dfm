        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'IDPESSOA'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'IDTITULAR'
        ParamType = ptInput
      end>
  end
