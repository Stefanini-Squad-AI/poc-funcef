  object sqlRelatorios: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT COUNT(1) OVER() AS QTDE, SUM(B.VLRLIQUIDO) OVER() VALORTO' +
        'TAL, B.MATRICULA, B.NUMDOCUMENTO, B.VLRLIQUIDO, '#39'CRÉDITO'#39' AS TIP' +
        'OOPERACAO,'
      
        '       A.DATAPAGAMENTO, P.DESCRICAO, C.DESCRICAOEVENTO, 0 AS QTD' +
        'EMENSAGEM,'
      '       B.NUMBANCO, B.NUMAGENCIA, B.CONTACORRENTE'
      '  FROM HSTREGULARIZACAOFOLHA H'
      ' INNER JOIN ARQUIVODERETORNOCAIXA A'
      '    ON (H.IDARQUIVORETORNOCAIXA = A.IDARQUIVORETORNOCAIXA)'
      ' INNER JOIN BASEDEPAGAMENTO B'
      '    ON (B.IDBASEPGTO = A.IDBASEPGTO AND'
      '       B.IDHSTFOLHABENEF = A.IDHSTFOLHABENEF)'
      ' INNER JOIN PORTADORFORMA P'
      '    ON (P.CODPORTFORMA = B.CODPORTFORMA)'
      ' INNER JOIN CADASTROEVENTOSDEREGULARIZACAO C'
      
        '    ON (C.IDCADEVENTOSDEREGULARIZACAO = H.IDCADEVENTOSDEREGULARI' +
        'ZACAO)'
      ' INNER JOIN EXTRATOINSTREL ER '
      '    ON (ER.IDPESSOA = B.IDPESSOA AND ER.IDPLANO = B.IDTITULAR)'
      ' WHERE A.FLGINCONSISTENCIA = 0 '
      ' ')
    ControlType.Strings = (
      'SELECIONADO;CheckBox;S;N')
    ValidateWithMask = True
    Left = 968
    Top = 442
