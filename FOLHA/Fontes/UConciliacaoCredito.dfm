  object qryVersaoFolha: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT H.IDHSTFOLHABENEF,'
      '       H.IDHSTFOLHABENEF || '#39' - '#39' || H.HISTORICO AS DESCRICAO'
      '       , TO_CHAR(H.DATAPREVPAGTO,'#39'YYYYMM'#39') AS ANOMES'
      '  FROM HSTFOLHABENEF H'
      ' WHERE EXISTS (SELECT 1'
      '          FROM HSTFOLHABENEFCAP HBC'
      '         WHERE (HBC.IDHSTFOLHABENEF = H.IDHSTFOLHABENEF))'
      '   AND  TO_CHAR(H.DATAPREVPAGTO,'#39'YYYY/MM'#39') = :MESREFERENCIA'
      ' ORDER BY H.IDHSTFOLHABENEF'
      ''
      ' ')
    ValidateWithMask = True
    Left = 265
    Top = 59
    ParamData = <
      item
        DataType = ftString
        Name = 'MESREFERENCIA'
        ParamType = ptInput
        Value = #39#39
      end>
  end
