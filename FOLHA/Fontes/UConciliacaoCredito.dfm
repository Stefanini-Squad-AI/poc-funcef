  object SqlCampos: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT 0 AS SELECIONAR,'
      '       A.MATRICULA,'
      
        '       substr(regexp_replace(LPAD(A.Cpf, 11, '#39'0'#39'), '#39'([0-9]{3})([' +
        '0-9]{3})([0-9]{3})([0-9]{2})'#39','#39'\1.\2.\3-\4'#39'),1,20) AS Cpf,'
      '       a.Nome,'
      '       A.BANCO,'
      '       A.Agenciabancaria AGENCIA,'
      '       A.Contabancaria AS CONTABANCARIA,'
      '       TO_CHAR(B.VLRLIQUIDO) AS VALORPAGAMENTO,'
      
        '       '#39'R$ '#39'||trim(TO_CHAR(B.VLRLIQUIDO, '#39'999g999g990d00'#39')) AS V' +
        'ALORPAGAMENTOAUX,'
      '       TO_CHAR(A.Valorpagamento) AS VALORCREDITADO,'
      
        '       '#39'R$ '#39'||trim(TO_CHAR(A.Valorpagamento, '#39'999g999g990d00'#39')) ' +
        'AS VALORCREDITADOAUX,'
      '       A.Datapagamento AS DATAPAGAMENTO,'
      '       A.FLGINCONSISTENCIA,'
      '       nvl(c.codigoretorno,c1.codigoretorno) AS SITPAGAMENTO,'
      
        '       nvl(c.descricaoevento,c1.descricaoevento) AS DESCSITPAGAM' +
        'ENTO,'
      '       a.idarquivoretornocaixa,'
      '       b.idpessoa,'
      '      --SIG69309 -INICIO'
      '      (select count(1)'
      '                   from HSTREGULARIZACAOFOLHA hh'
      '                  inner join CADASTROEVENTOSDEREGULARIZACAO cc'
      '                     on (hh.idcadeventosderegularizacao ='
      '                        cc.idcadeventosderegularizacao)'
      '                  inner join ARQUIVODERETORNOCAIXA aa'
      
        '                     on (aa.IDARQUIVORETORNOCAIXA = hh.IDARQUIVO' +
        'RETORNOCAIXA)'
      '                  inner join BASEDEPAGAMENTO bb'
      '                     on (aa.Idbasepgto = bB.Idbasepgto and'
      
        '                        Aa.Idhstfolhabenef = Bb.IDHSTFOLHABENEF ' +
        'and'
      '                        Aa.Idpessoa = Bb.idPessoa and'
      '                        Aa.idTitular = Bb.IdTitular)'
      '                  where bb.codportforma = b.codportforma'
      '                    and aa.idhstfolhabenef = a.idhstfolhabenef'
      
        '                    and Aa.IDARQUIVORETORNOCAIXA = a.idarquivore' +
        'tornocaixa'
      '                    and cc.flgdesativado = 0'
      
        '                    and cc.codigoretorno = '#39'00'#39') AS REGULARIZADO' +
        ' '
      '    --SIG69309 -FIM'
      ''
      '  FROM cm.Arquivoderetornocaixa A'
      
        ' left outer join (SELECT h.idcadeventosderegularizacao,h.idarqui' +
        'voretornocaixa'
      '                  FROM hstregularizacaofolha h'
      
        '                  Where (H.IDHSTREGULARIZACAOFOLHA = (SELECT MAX' +
        ' (IDHSTREGULARIZACAOFOLHA)'
      
        '                                                      FROM HSTRE' +
        'GULARIZACAOFOLHA H1'
      
        '                                                      where h.id' +
        'arquivoretornocaixa = h1.idarquivoretornocaixa))) h on (a.idarqu' +
        'ivoretornocaixa = h.idarquivoretornocaixa)'
      ' left outer join BASEDEPAGAMENTO b'
      '    on (b.idbasepgto = a.idbasepgto and'
      
        '       b.idhstfolhabenef = a.idhstfolhabenef and b.idpessoa = a.' +
        'idpessoa and'
      '       b.idtitular = a.idtitular)'
      
        ' left outer join CADASTROEVENTOSDEREGULARIZACAO c on (c.idcadeve' +
        'ntosderegularizacao = h.idcadeventosderegularizacao)'
      
        ' left outer join CADASTROEVENTOSDEREGULARIZACAO c1 on (c1.codigo' +
        'retorno = a.codigoretornoarquivo and c1.flgdesativado = 0)'
      'where  b.idpessoa > 0'
      'AND   a.IDHSTFOLHABENEF = :IDHSTFOLHABENEF'
      'AND   B.CODPORTFORMA    = :CODPORTFORMA'
      'and   ((b.IDPESSOA       = :IDPESSOA) or (:IDPESSOA is null))'
      
        'AND B.IDLOTE IN (SELECT IDLOTE FROM LOTEXHSTFOLHABENEF L WHERE L' +
        '.IDHSTFOLHABENEF = :IDHSTFOLHABENEF)   --SIG69309'
      'ORDER BY A.MATRICULA'
      ''
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ClientDataSet = CdsDadosRetornoCaixa
    Left = 585
    Top = 104
  end
