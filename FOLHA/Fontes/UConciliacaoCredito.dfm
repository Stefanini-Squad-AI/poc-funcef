  object QryEventoReg: TwwQuery
    Tag = 5
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT  A.FLGINCONSISTENCIA,C.CODIGORETORNO, UPPER(C.DESCRICAOEV' +
        'ENTO) AS DESCRICAOEVENTO'
      '  FROM ARQUIVODERETORNOCAIXA          A,'
      '       HSTREGULARIZACAOFOLHA          H,'
      '       CADASTROEVENTOSDEREGULARIZACAO C'
      
        ' WHERE C.IDCADEVENTOSDEREGULARIZACAO = H.IDCADEVENTOSDEREGULARIZ' +
        'ACAO'
      '   AND A.IDARQUIVORETORNOCAIXA = H.IDARQUIVORETORNOCAIXA'
      '   AND A.IDBASEPGTO      = :IDBASEPGTO'
      '   AND A.IDHSTFOLHABENEF = :IDHSTFOLHABENEF'
      '   AND A.IDPESSOA        = :IDPESSOA'
      '   AND A.IDTITULAR       = :IDTITULAR'
      'ORDER BY H.DATAREGULARIZACAO   DESC , H.TRGDTINCLUSAO  DESC')
    ControlType.Strings = (
      'FLGCONTAPREF;CheckBox;1;0')
    ValidateWithMask = True
    Left = 797
    Top = 118
    ParamData = <
      item
        DataType = ftString
        Name = 'IDBASEPGTO'
        ParamType = ptInput
      end
      item
        DataType = ftString
