  object sqlTipoDesemb: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  TRD.CODTIPRECDES,'
      '  TRD.RECPAG,'
      '  TRD.PLACONTACREDITO,'
      '  TRD.PLANO,'
      '  TRD.PLACONTA,'
      '  TRD.DESCRICAO,'
      '  TRD.ANASINT,'
      '  TRD.FLGOBRIGARESERVA,'
      '  TRD.FLGCALCULAIMPOSTO,'
      '  TRD.HITCODHIST'
      ''
      'FROM'
      '  TIPORECEBDESEMB TRD'
      ''
      'WHERE'
      '      TRD.ANASINT   = '#39'A'#39
      '  AND TRD.RECPAG    = '#39'P'#39
      '  AND TRD.ATIVO    <> '#39'N'#39
      '  AND TRD.IDPESSOA  = :PIDPESSOA'
      ''
      'ORDER BY'
      '  TRD.DESCRICAO')
    ClientDataSet = cdsTipoDesemb
    Left = 40
    Top = 8
  end
