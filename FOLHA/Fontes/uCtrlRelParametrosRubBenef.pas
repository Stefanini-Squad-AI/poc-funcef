unit uCtrlRelParametrosRubBenef;

interface

Uses SysUtils, uCmControlObject, uCmDbObject, uCmClientDataSet, uCmTypes;

Type
  TCtrlRelParametrosRubBenef = class(TCmControlObject)
  private
  protected
  public
    function BuscaDadosRelatorio: Olevariant;
  published
end;

implementation

{ TCtrlRelParametrosRubBenef }

uses uConstFolha;

function TCtrlRelParametrosRubBenef.BuscaDadosRelatorio: Olevariant;
var sSql : string;
begin
  ssql:=
    'SELECT PL.NOME, B.NOME, RUBB.DESCRICAO, RUBB.IDPLANOPREV, RUBB.IDBENEFICIO, '+_clinefeed+
    '       P.IDPROVENTO AS CODINTERNO, '+_clinefeed+
    '       P.CODPROVDESC AS CODEXTERNO, '+_clinefeed+
    '       NVL(P.DESCRICAO,''NÃO PARAMETRIZADA'') AS DESCRICAO, '+_clinefeed+
    '       DECODE(P.IDPROVENTO,NULL,'', '+_clinefeed+
    '         DECODE(P.FLGESPECIAL,0, '+_clinefeed+
    '           DECODE(P.FLGDESCONTO, '+_clinefeed+
    '             0,''Provento'', '+_clinefeed+
    '             1,''Desconto'', '+_clinefeed+
    '               ''Informativa''),''Informativa'')) AS TIPO, '+_clinefeed+
    '       DECODE(P.IDPROVENTO,NULL,'', '+_clinefeed+
    '         DECODE(P.FLGIRRF,1,''Incide IR'',''Não Incide IR'')) AS FLGIRRF, '+_clinefeed+
    '       DECODE(P.IDPROVENTO,NULL,'', '+_clinefeed+
    '         P.CODIRRFDARF) AS NATUREZA, '+_clinefeed+
    '       DECODE(P.IDPROVENTO,NULL,'', '+_clinefeed+
    '         I.NOMEINFORME) AS INFORME '+_clinefeed+
    'FROM ( '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBRICA AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA NORMAL'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBRICAATRASO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE ATRASO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBADIANT AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE ADIANTAMENTO PROVISÓRIO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBATRACJUD AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE ATRASO DE AÇÃO JUDICIAL'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBACJUD AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA NORMAL DE AÇÃO JUDICIAL'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBRICAREVISAO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE REVISÃO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBATRREVISAO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE ATRASO DE REVISÃO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBATRREVACJUD AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE ATRASO DE REVISÃO AÇÃO JUDICIAL'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBREVACJUD AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE REVISÃO AÇÃO JUDICIAL'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBDEVOLUCAO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE DEVOLUÇÃO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBDEVOLADIANT AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE DEVOLUÇÃO DE ADIANTAMENTO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBDEVACJUD AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE DEVOLUÇÃO AÇÃO JUDICIAL'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBDEVREVISAO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE DEVOLUÇÃO DE REVISÃO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBDEVREVACJUD AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE DEVOLUÇÃO DE REVISÃO AÇÃO JUDICIAL'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBABONO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE ABONO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBATRASOABONO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA ATRASO ABONO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBACERTOABONO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA ATRASO DE ANTECIPAÇÃO DE ABONO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBANTECABONO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA ANTECIPAÇÃO DE ABONO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUB13ACJUD AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE ABONO AÇÃO JUDICIAL'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBATR13ACJUD AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA ATRASO ABONO AÇÃO JUDICIAL'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBDEVANTABONO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DEVOLUÇÃO DE ANTECIPAÇÃO DE ABONO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBDEVOLABONO AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE DEVOLUÇÃO ABONO'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    'UNION '+_clinefeed+
    'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBDEV13ACJUD AS IDRUBRICA, ''PARÂMETRO PARA RUBRICA DE DEVOLUÇÃO ABONO AÇÃO JUDICIAL'' AS DESCRICAO '+_clinefeed+
    'FROM BENEFPLANPREV '+_clinefeed+
    ') RUBB, PLANPREV PL, BENEFICIO B, PROVDESC P, INFORME I '+_clinefeed+
    'WHERE RUBB.IDPLANOPREV = PL.IDPLANOPREV '+_clinefeed+
    'AND RUBB.IDBENEFICIO = B.IDBENEFICIO '+_clinefeed+
    'AND RUBB.IDRUBRICA = P.IDPROVENTO(+) '+_clinefeed+
    'AND P.IDINFORME = I.IDINFORME(+) '+_clinefeed+
    'ORDER BY PL.NOME, B.NOME, RUBB.DESCRICAO '+_clinefeed;

  result := GetDataPacket(sSql);
end;

end.


