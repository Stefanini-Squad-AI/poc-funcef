  object qryDelete: TwwQuery
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'DELETE FROM RUBRICAINDIV '
      ' WHERE IDPESSOA = :IDPESSOA'
      '   AND SEQRUBRICAINDIV = :SEQRUBRICAINDIV'
      '   AND IDRUBRICA = :IDRUBRICA')
    ValidateWithMask = True
    Left = 7
    Top = 81
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDPESSOA'
        ParamType = ptInput
      end
      item
        DataType = ftFloat
        Name = 'SEQRUBRICAINDIV'
        ParamType = ptInput
      end
      item
        DataType = ftFloat
        Name = 'IDRUBRICA'
        ParamType = ptInput
      end>
  end
  object qryAux: TwwQuery
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'SELECT IDRUBRICA FROM RUBRICAINDIV '
      ' WHERE IDPESSOA = :IDPESSOA'
      '   AND SEQRUBRICAINDIV = :SEQRUBRICAINDIV'
      '   AND IDRUBRICA = :IDRUBRICA')
    ValidateWithMask = True
    Left = 64
    Top = 72
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDPESSOA'
        ParamType = ptInput
      end
      item
        DataType = ftFloat
        Name = 'SEQRUBRICAINDIV'
        ParamType = ptInput
      end
      item
        DataType = ftFloat
        Name = 'IDRUBRICA'
        ParamType = ptInput
      end>
  end
