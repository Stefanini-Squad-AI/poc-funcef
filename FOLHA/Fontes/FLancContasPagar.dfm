  object SqlFormaPag: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   CODFORMA,'
      '   RECPAG,'
      '   DESCRICAO'
      'FROM '
      '   FORMARECPAG '
      'WHERE '
      '   (RECPAG = :RECPAG) AND'
      '   (IDPESSOA = :IDPESSOA)'
      ' ')
    ClientDataSet = CdsFormaPag
    Left = 556
    Top = 102
  end
