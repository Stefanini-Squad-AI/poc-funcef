  object SQLTipoRD: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   CODTIPRECDES, RECPAG, DESCRICAO'
      'FROM'
      '   TIPORECEBDESEMB'
      'WHERE'
      '            ( IDPESSOA = :PIDPESSOA )'
      '   AND ( RECPAG     = :RECPAG )'
      '   AND ( ANASINT    = '#39'A'#39' )'
      '   AND ( ATIVO         = '#39'S'#39' )'
      'ORDER BY'
      '   DESCRICAO'
      ' ')
    ClientDataSet = CdsTipoRD
    Left = 348
    Top = 65535
  end
