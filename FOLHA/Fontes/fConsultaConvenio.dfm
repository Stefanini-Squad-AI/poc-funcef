  object qryLote: TwwQuery
    DatabaseName = 'BaseDados'
    DataSource = dsFav
    SQL.Strings = (
      
        'SELECT PL.IDFUNDACAO, PL.IDPROCCONV, PL.IDLOTE, PL.IDLAYOUT, PL.' +
        'IDFAVORECIDO,'
      
        '       PL.IDRUBRICA, PL.TOTALIMPORTADO, PL.TOTALNAOPROC, PL.TOTA' +
        'LPROCINTEG,'
      
        '       PL.TOTALPROCPARC, PL.VALORIMPORTADO, PL.VALORNAOPROC, PL.' +
        'VALORPROCINTEG,'
      '       PL.VALORPROCPARC, PL.FLGTIPOCONVENIO, PL.FLGTRATARESIDUO,'
      
        '       PL.IDLOTEEXCESSO, PL.CODDOCUMENTO, PL.IDLOTE||'#39'-'#39'||C.DESC' +
        'RICAO AS DESCRLOTE,'
      
        '       PL.IDRUBRICA||'#39'-'#39'|| DECODE(PRM.FLGUSACODRUBEXT, 0, P.DESC' +
        'RICAO, P.DESCRPROVDESC) AS  DESCRRUB'
      
        'FROM PROCCONVENIOLOTE PL, PARAMAPREV PRM, PROVDESC P, CTRLINTERF' +
        'ACE C'
      'WHERE PL.IDPROCCONV = :IDPROCCONV'
      'AND PL.IDFAVORECIDO = :IDFAVORECIDO'
      'AND C.IDLOTE = PL.IDLOTE'
      'AND P.IDPROVENTO = PL.IDRUBRICA'
      'ORDER BY P.DESCRICAO'
      ''
      ''
      ''
      ''
      ' ')
    ValidateWithMask = True
    Left = 498
    Top = 142
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDPROCCONV'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'IDFAVORECIDO'
        ParamType = ptUnknown
      end>
    object qryLoteDESCRLOTE: TStringField
      DisplayLabel = 'Lote de Importação'
      DisplayWidth = 46
      FieldName = 'DESCRLOTE'
      Origin = 'BASEDADOS.PROCCONVENIOLOTE.IDLOTE'
      Size = 241
    end
    object qryLoteDESCRRUB: TStringField
      DisplayLabel = 'Rubrica'
      DisplayWidth = 41
