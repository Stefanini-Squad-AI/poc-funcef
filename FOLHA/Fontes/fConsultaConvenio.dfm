  object qryFav: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT DISTINCT PC.DESCRICAO, PC.IDPROCCONV, PC.MES, PD.IDFAVORE' +
        'CIDO, P.NOME'
      'FROM PROCCONVENIODOC PD, PROCESSOCONVENIO PC, PESSOA P'
      'WHERE PD.IDFAVORECIDO = :PIDFAVORECIDO'
      'AND PC.IDPROCCONV = PD.IDPROCCONV'
      'AND PD.IDFAVORECIDO = P.IDPESSOA'
      'ORDER BY PC.MES DESC'
      ' '
      ' ')
    ValidateWithMask = True
    Left = 498
    Top = 14
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDFAVORECIDO'
