  object qryDoc: TwwQuery
    DatabaseName = 'BaseDados'
    DataSource = dsFav
    SQL.Strings = (
      
        'SELECT PD.IDFUNDACAO, PD.IDPROCCONV, PD.IDFAVORECIDO, PD.CODDOCU' +
        'MENTO,'
      
        '       PD.DATAPAGAMENTO, PD.VALORLIQUIDO, PD.VALOREFETIVO, D.NOD' +
        'OCUMENTO'
      'FROM PROCCONVENIODOC PD, DOCUMENTO D'
      'WHERE PD.IDPROCCONV = :IDPROCCONV'
      'AND PD.IDFAVORECIDO = :IDFAVORECIDO'
      'AND D.CODDOCUMENTO = PD.CODDOCUMENTO'
      'ORDER BY PD.DATAPAGAMENTO'
      ''
      ' '
      ' ')
    ValidateWithMask = True
    Left = 682
    Top = 310
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDPROCCONV'
        ParamType = ptUnknown
      end
