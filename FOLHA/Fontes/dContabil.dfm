        'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBRICAREVISAO  AS IDRUBRICA,' +
        ' '#39'IDRUBRICAREVISAO'#39'  AS NOME, 0 AS ABONO, 0 AS ACAO, 0 AS PROVIS' +
