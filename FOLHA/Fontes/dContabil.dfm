  object updContasContab: TUpdateSQL
    ModifySQL.Strings = (
      'update DUAL'
      'set'
      '  IDPLANOPREV = :IDPLANOPREV,'
      '  CODCENTROCUSTOD = :CODCENTROCUSTOD,'
      '  CODCENTROCUSTOC = :CODCENTROCUSTOC,'
      '  CODCENTRORESPON = :CODCENTRORESPON,'
      '  CODSUBCONTA = :CODSUBCONTA,'
      '  CODTIPRECDES = :CODTIPRECDES,'
      '  CODTIPDOC = :CODTIPDOC,'
      '  PLANO = :PLANO,'
      '  PLACONTAC = :PLACONTAC,'
      '  PLACONTAD = :PLACONTAD,'
      '  IDEMPRESA = :IDEMPRESA,'
      '  TIPCODIGO = :TIPCODIGO,'
      '  UNIDNEGOC = :UNIDNEGOC,'
      '  NOMEPLANOPREV = :NOMEPLANOPREV,'
      '  CODDESEMBIRRF = :CODDESEMBIRRF'
      'where'
      '  IDPLANOPREV = :OLD_IDPLANOPREV and'
      '  CODCENTROCUSTOD = :OLD_CODCENTROCUSTOD and'
      '  CODCENTROCUSTOC = :OLD_CODCENTROCUSTOC and'
      '  CODCENTRORESPON = :OLD_CODCENTRORESPON and'
      '  CODSUBCONTA = :OLD_CODSUBCONTA and'
      '  CODTIPRECDES = :OLD_CODTIPRECDES and'
      '  CODTIPDOC = :OLD_CODTIPDOC and'
      '  PLANO = :OLD_PLANO and'
      '  PLACONTAC = :OLD_PLACONTAC and'
      '  PLACONTAD = :OLD_PLACONTAD and'
      '  IDEMPRESA = :OLD_IDEMPRESA and'
      '  TIPCODIGO = :OLD_TIPCODIGO and'
      '  UNIDNEGOC = :OLD_UNIDNEGOC and'
      '  NOMEPLANOPREV = :OLD_NOMEPLANOPREV and'
      '  CODDESEMBIRRF = :OLD_CODDESEMBIRRF')
    InsertSQL.Strings = (
      'insert into DUAL'
      
        '  (IDPLANOPREV, CODCENTROCUSTOD, CODCENTROCUSTOC, CODCENTRORESPO' +
        'N, CODSUBCONTA, '
      
        '   CODTIPRECDES, CODTIPDOC, PLANO, PLACONTAC, PLACONTAD, IDEMPRE' +
        'SA, TIPCODIGO, '
      '   UNIDNEGOC, NOMEPLANOPREV, CODDESEMBIRRF)'
      'values'
      
        '  (:IDPLANOPREV, :CODCENTROCUSTOD, :CODCENTROCUSTOC, :CODCENTROR' +
        'ESPON, '
      
        '   :CODSUBCONTA, :CODTIPRECDES, :CODTIPDOC, :PLANO, :PLACONTAC, ' +
        ':PLACONTAD, '
      
        '   :IDEMPRESA, :TIPCODIGO, :UNIDNEGOC, :NOMEPLANOPREV, :CODDESEM' +
        'BIRRF)')
    DeleteSQL.Strings = (
      'delete from DUAL'
      'where'
      '  IDPLANOPREV = :OLD_IDPLANOPREV and'
      '  CODCENTROCUSTOD = :OLD_CODCENTROCUSTOD and'
      '  CODCENTROCUSTOC = :OLD_CODCENTROCUSTOC and'
      '  CODCENTRORESPON = :OLD_CODCENTRORESPON and'
      '  CODSUBCONTA = :OLD_CODSUBCONTA and'
      '  CODTIPRECDES = :OLD_CODTIPRECDES and'
      '  CODTIPDOC = :OLD_CODTIPDOC and'
      '  PLANO = :OLD_PLANO and'
      '  PLACONTAC = :OLD_PLACONTAC and'
      '  PLACONTAD = :OLD_PLACONTAD and'
      '  IDEMPRESA = :OLD_IDEMPRESA and'
      '  TIPCODIGO = :OLD_TIPCODIGO and'
      '  UNIDNEGOC = :OLD_UNIDNEGOC and'
      '  NOMEPLANOPREV = :OLD_NOMEPLANOPREV and'
      '  CODDESEMBIRRF = :OLD_CODDESEMBIRRF')
    Left = 44
    Top = 77
  end
