  object qryRubBeneficio: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT IDPLANOPREV, IDRUBRICA, NOME, ABONO, ACAO, PROVISORIO, ID' +
        'BENEFICIO FROM ('
      
        'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBABONO        AS IDRUBRICA,' +
        ' '#39'IDRUBABONO'#39'        AS NOME, 1 AS ABONO, 0 AS ACAO, 0 AS PROVIS' +
        'ORIO FROM BENEFPLANPREV UNION'
      
        'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBABONOFIM     AS IDRUBRICA,' +
        ' '#39'IDRUBABONOFIM'#39'     AS NOME, 1 AS ABONO, 0 AS ACAO, 0 AS PROVIS' +
        'ORIO FROM BENEFPLANPREV UNION'
      
        'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBDEVOLUCAO    AS IDRUBRICA,' +
        ' '#39'IDRUBDEVOLUCAO'#39'    AS NOME, 0 AS ABONO, 0 AS ACAO, 0 AS PROVIS' +
        'ORIO FROM BENEFPLANPREV UNION'
      
        'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBRICADIF      AS IDRUBRICA,' +
        ' '#39'IDRUBRICADIF'#39'      AS NOME, 0 AS ABONO, 0 AS ACAO, 0 AS PROVIS' +
        'ORIO FROM BENEFPLANPREV UNION'
      
        'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBRICACORRECAO AS IDRUBRICA,' +
        ' '#39'IDRUBRICACORRECAO'#39' AS NOME, 0 AS ABONO, 0 AS ACAO, 0 AS PROVIS' +
        'ORIO FROM BENEFPLANPREV UNION'
      
        'SELECT IDPLANOPREV, IDBENEFICIO, IDRUBRICAATRASO   AS IDRUBRICA,' +
        ' '#39'IDRUBRICAATRASO'#39'   AS NOME, 0 AS ABONO, 0 AS ACAO, 0 AS PROVIS' +
