      '       0                    IDRUBRICA,'
      '       '#39'Z'#39'                  ORIGEMRUB,'
      '       '#39'123456789012345678'#39' PLACONTAC,'
      '       '#39'123456789012345678'#39' PLACONTAD,'
      '       '#39'1234567890'#39'         CODCENTROCUSTOD,'
      '       '#39'1234567890'#39'         CODCENTROCUSTOC,'
      '       '#39'1234567890'#39'         CODCENTRORESPON,'
      '       '#39'12345'#39'              CODSUBCONTA,'
      '       '#39'123456789012345'#39'    CODTIPRECDES,'
      '       '#39'1234567890'#39'         CODTIPDOC,'
      '       '#39'123456789012345678'#39' PLANO,'
      '       '#39'1234567890'#39'         IDEMPRESA,'
