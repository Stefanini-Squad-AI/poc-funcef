  object qryContaBeneficio: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT DECODE(BPPAT.IDPESSJUR,       NULL, 0, BPPAT.IDPESSJUR) I' +
        'DPESSJUR,'
      '       BPREV.IDPLANOPREV,'
      '       BPREV.IDBENEFICIO,'
      '       BPREV.IDEMPRESAPROP,'
      '       PPPAT.PLACONTALIQFLHBEN,'
      '       BPREV.IDRUBRICA,'
      '       BPREV.IDRUBABONO,'
      '       BPREV.IDRUBRICAATRASO,'
      '       BPREV.IDRUBDEVOLUCAO,'
      
        '       DECODE(PATRO.CODSUBCONTA,     NULL, PPPAT.CODSUBCONTA,   ' +
        '  PATRO.CODSUBCONTA)     SUBCONTALIQFLHBEN,'
      
        '       DECODE(BPPAT.CODCENTROCUSTOD, NULL, BPREV.CODCENTROCUSTOD' +
        ', BPPAT.CODCENTROCUSTOD) CODCENTROCUSTOD,'
      
        '       DECODE(BPPAT.CODCENTROCUSTOC, NULL, BPREV.CODCENTROCUSTOC' +
        ', BPPAT.CODCENTROCUSTOC) CODCENTROCUSTOC,'
      
        '       DECODE(BPPAT.CODCENTRORESPON, NULL, BPREV.CODCENTRORESPON' +
        ', BPPAT.CODCENTRORESPON) CODCENTRORESPON,'
      
        '       DECODE(BPPAT.CODSUBCONTA,     NULL, BPREV.CODSUBCONTA,   ' +
        '  BPPAT.CODSUBCONTA)     CODSUBCONTA,'
      
        '       DECODE(BPPAT.CODTIPRECDES,    NULL, BPREV.CODTIPRECDES,  ' +
        '  BPPAT.CODTIPRECDES)    CODTIPRECDES,'
      
        '       DECODE(BPPAT.CODTIPDOC,       NULL, BPREV.CODTIPDOC,     ' +
        '  BPPAT.CODTIPDOC)       CODTIPDOC,'
      
        '       DECODE(BPPAT.PLANO,           NULL, BPREV.PLANO,         ' +
        '  BPPAT.PLANO)           PLANO,'
      
        '       DECODE(BPPAT.PLACONTAC,       NULL, BPREV.PLACONTAC,     ' +
        '  BPPAT.PLACONTAC)       PLACONTAC,'
      
        '       DECODE(BPPAT.PLACONTAD,       NULL, BPREV.PLACONTAD,     ' +
        '  BPPAT.PLACONTAD)       PLACONTAD,'
      
        '       DECODE(BPPAT.IDEMPRESA,       NULL, BPREV.IDEMPRESA,     ' +
        '  BPPAT.IDEMPRESA)       IDEMPRESA,'
      
        '       DECODE(BPPAT.TIPCODIGO,       NULL, BPREV.TIPCODIGO,     ' +
        '  BPPAT.TIPCODIGO)       TIPCODIGO,'
      
        '       DECODE(BPPAT.UNIDNEGOC,       NULL, BPREV.UNIDNEGOC,     ' +
        '  BPPAT.UNIDNEGOC)       UNIDNEGOC,'
      '       P.NOME NOMEPLANO, B.NOME NOMEBENBEFICIO'
      'FROM PATRO,'
      '     PLANPREVPATRO PPPAT,'
      '     BENEFPLANPREV BPREV,'
      '     BENEFPLANPATRO BPPAT,'
      '     BENEFICIO B,'
      '     PLANPREV P'
      'WHERE PATRO.IDPESSOA = PPPAT.IDPESSJUR'
      'AND PPPAT.IDPLANOPREV = BPREV.IDPLANOPREV'
      'AND BPREV.IDPLANOPREV = BPPAT.IDPLANOPREV(+)'
      'AND BPREV.IDBENEFICIO = BPPAT.IDBENEFICIO(+)'
      'AND PPPAT.IDPESSJUR = BPPAT.IDPESSJUR'
      'AND B.IDBENEFICIO = BPREV.IDBENEFICIO'
      'AND P.IDPLANOPREV = PPPAT.IDPLANOPREV'
      'ORDER BY BPPAT.IDPESSJUR, IDPLANOPREV, IDBENEFICIO,'
      
        '         BPREV.IDRUBRICA, BPREV.IDRUBABONO, BPREV.IDRUBRICAATRAS' +
        'O, BPREV.IDRUBDEVOLUCAO'
      '')
    ValidateWithMask = True
    Left = 462
    Top = 99
  end
  object qryContaContrib: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT DECODE(CPPAT.IDPESSJUR,         NULL, 0,                 ' +
        '      CPPAT.IDPESSJUR)         IDPESSJUR,'
      '       CPREV.IDPLANOPREV,'
      '       CPREV.IDCONTRIBUICAO,'
      '       CPREV.IDRUBRICA,'
      '       CPREV.IDRUBRICAATRASO,'
      '       CPREV.IDRUBRICADEVOLUC,'
      '       CPREV.IDRUBDECTERC,'
      '       CPREV.IDRUBDECTERCDEVOL,'
      '       CPREV.IDRUBDECTERCATRA,'
      
        '       DECODE(CPPAT.PLANO,             NULL, CPREV.PLANO,       ' +
        '      CPPAT.PLANO)             PLANO,'
      
        '       DECODE(CPPAT.PLACONTAC,         NULL, CPREV.PLACONTAC,   ' +
        '      CPPAT.PLACONTAC)         PLACONTAC,'
      
        '       DECODE(CPPAT.PLACONTAD,         NULL, CPREV.PLACONTAD,   ' +
        '      CPPAT.PLACONTAD)         PLACONTAD,'
      
        '       DECODE(CPPAT.CODCENTROCUSTOC,   NULL, CPREV.CODCENTROCUST' +
        'OC,   CPPAT.CODCENTROCUSTOC)   CODCENTROCUSTOC,'
      
        '       DECODE(CPPAT.CODCENTROCUSTOD,   NULL, CPREV.CODCENTROCUST' +
        'OD,   CPPAT.CODCENTROCUSTOD)   CODCENTROCUSTOD,'
      
        '       DECODE(CPPAT.IDEMPRESA,         NULL, CPREV.IDEMPRESA,   ' +
        '      CPPAT.IDEMPRESA)         IDEMPRESA,'
      
        '       DECODE(CPPAT.UNIDNEGOC,         NULL, CPREV.UNIDNEGOC,   ' +
        '      CPPAT.UNIDNEGOC)         UNIDNEGOC,'
      
        '       DECODE(CPPAT.CODCENTRORESPON,   NULL, CPREV.IDEMPRESAPROP' +
        ',     CPPAT.CODCENTRORESPON)   CODCENTRORESPON,'
      
        '       DECODE(CPPAT.IDEMPRESAPROP,     NULL, CPREV.CODCENTRORESP' +
        'ON,   CPPAT.IDEMPRESAPROP)     IDEMPRESAPROP,'
      
        '       DECODE(CPPAT.CODSUBCONTA,       NULL, CPREV.CODSUBCONTA, ' +
        '      CPPAT.CODSUBCONTA)       CODSUBCONTA,'
      
        '       DECODE(CPPAT.CODALTERADORJUROS, NULL, CPREV.CODALTERADORC' +
        'ORR,  CPPAT.CODALTERADORJUROS) CODALTERADORJUROS,'
      
        '       DECODE(CPPAT.CODALTERADORCORR,  NULL, CPREV.CODALTERADORJ' +
        'UROS, CPPAT.CODALTERADORCORR)  CODALTERADORCORR,'
      
        '       DECODE(CPPAT.RECPAG,            NULL, CPREV.RECPAG,      ' +
        '      CPPAT.RECPAG)            RECPAG,'
      
        '       DECODE(CPPAT.CODTIPRECDES,      NULL, CPREV.CODTIPRECDES,' +
        '      CPPAT.CODTIPRECDES)      CODTIPRECDES,'
      
        '       DECODE(CPPAT.TIPCODIGO,         NULL, CPREV.TIPCODIGO,   ' +
        '      CPPAT.TIPCODIGO)         TIPCODIGO,'
      
        '       DECODE(CPPAT.CODTIPDOC,         NULL, CPREV.CODTIPDOC,   ' +
        '      CPPAT.CODTIPDOC)         CODTIPDOC,'
      
        '       DECODE(CPPAT.CODPORTFORMA,      NULL, CPREV.CODPORTFORMA,' +
        '      CPPAT.CODPORTFORMA)      CODPORTFORMA,'
      
        '       DECODE(CPPAT.PLANO13,           NULL, CPREV.PLANO13,     ' +
        '      CPPAT.PLANO13)           PLANO13,'
      
        '       DECODE(CPPAT.PLACONTAC13,       NULL, CPREV.PLACONTAC13, ' +
        '      CPPAT.PLACONTAC13)       PLACONTAC13,'
      
        '       DECODE(CPPAT.PLACONTAD13,       NULL, CPREV.PLACONTAD13, ' +
        '      CPPAT.PLACONTAD13)       PLACONTAD13,'
      
        '       DECODE(CPPAT.CODCENTROCUSTOC13, NULL, CPREV.CODCENTROCUST' +
        'OC13, CPPAT.CODCENTROCUSTOC13) CODCENTROCUSTOC13,'
      
        '       DECODE(CPPAT.CODCENTROCUSTOD13, NULL, CPREV.CODCENTROCUST' +
        'OD13, CPPAT.CODCENTROCUSTOD13) CODCENTROCUSTOD13,'
      
        '       DECODE(CPPAT.IDEMPRESA13,       NULL, CPREV.IDEMPRESA13, ' +
        '      CPPAT.IDEMPRESA13)       IDEMPRESA13,'
      
        '       DECODE(CPPAT.UNIDNEGOC13,       NULL, CPREV.UNIDNEGOC13, ' +
        '      CPPAT.UNIDNEGOC13)       UNIDNEGOC13,'
      
        '       DECODE(CPPAT.CODCENTRORESPON13, NULL, CPREV.IDEMPRESAPROP' +
        '13,   CPPAT.CODCENTRORESPON13) CODCENTRORESPON13,'
      
        '       DECODE(CPPAT.IDEMPRESAPROP13,   NULL, CPREV.CODCENTRORESP' +
        'ON13, CPPAT.IDEMPRESAPROP13)   IDEMPRESAPROP13,'
      
        '       DECODE(CPPAT.CODSUBCONTA13,     NULL, CPREV.CODSUBCONTA13' +
        ',     CPPAT.CODSUBCONTA13)     CODSUBCONTA13,'
      
        '       DECODE(CPPAT.CODALTERAJUROS13,  NULL, CPREV.CODALTERACORR' +
        '13,   CPPAT.CODALTERAJUROS13)  CODALTERAJUROS13,'
      
        '       DECODE(CPPAT.CODALTERACORR13,   NULL, CPREV.CODALTERAJURO' +
        'S13,  CPPAT.CODALTERACORR13)   CODALTERACORR13,'
      
        '       DECODE(CPPAT.RECPAG13,          NULL, CPREV.RECPAG13,    ' +
        '      CPPAT.RECPAG13)          RECPAG13,'
      
        '       DECODE(CPPAT.CODTIPRECDES13,    NULL, CPREV.CODTIPRECDES1' +
        '3,    CPPAT.CODTIPRECDES13)    CODTIPRECDES13,'
      
        '       DECODE(CPPAT.TIPCODIGO13,       NULL, CPREV.TIPCODIGO13, ' +
        '      CPPAT.TIPCODIGO13)       TIPCODIGO13,'
      
        '       DECODE(CPPAT.CODTIPDOC13,       NULL, CPREV.CODTIPDOC13, ' +
        '      CPPAT.CODTIPDOC13)       CODTIPDOC13,'
      
        '       DECODE(CPPAT.CODPORTFORMA13,    NULL, CPREV.CODPORTFORMA1' +
        '3,    CPPAT.CODPORTFORMA13)    CODPORTFORMA13,'
      
        '       DECODE(CPPAT.CODTIPDESEMBCAR,   NULL, CPREV.CODTIPDESEMBC' +
        'AR,   CPPAT.CODTIPDESEMBCAR)   CODTIPDESEMBCAR,'
      
        '       DECODE(CPPAT.RECPAGDEVOL,       NULL, CPREV.RECPAGDEVOL, ' +
        '      CPPAT.RECPAGDEVOL)       RECPAGDEVOL,'
      '       P.NOME NOMEPLANO, C.NOME NOMECONTRIBUICAO'
      
        'FROM CONTPLANPATRO CPPAT, CONTPREV CPREV, CONTRIBUICAO C, PLANPR' +
        'EV P'
      'WHERE CPPAT.IDPLANOPREV(+) = CPREV.IDPLANOPREV'
      'AND CPPAT.IDCONTRIBUICAO(+) = CPREV.IDCONTRIBUICAO'
      'AND C.IDCONTRIBUICAO = CPREV.IDCONTRIBUICAO'
      'AND P.IDPLANOPREV = CPREV.IDPLANOPREV'
      'AND CPREV.FLGINTERNO = '#39'AS'#39
      'AND CPREV.FLGPAGADOR = '#39'C'#39
      'ORDER BY IDPESSJUR, CPREV.IDPLANOPREV, CPREV.IDCONTRIBUICAO'
      '')
    ValidateWithMask = True
    Left = 462
    Top = 51
  end
  object qryContaGeral: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT RPL.IDPESSJUR,'
      '       RPL.IDPLANOPREV,'
      '       RPL.IDRUBRICA,'
      '       RPL.CODCENTROCUSTOD,'
      '       RPL.UNIDNEGOC,'
      '       RPL.IDEMPRESAPROP,'
      '       RPL.IDEMPRESA,'
      '       RPL.CODTIPRECDES,'
      '       RPL.IDPESSOA,'
      '       RPL.CODCENTROCUSTOC,'
      '       RPL.RECPAG,'
      '       RPL.PLACONTAD,'
      '       RPL.PLANO,'
      '       RPL.PLACONTAC,'
      '       RPL.CODPORTFORMA,'
      '       RPL.CODCENTRORESPON,'
      
        '       DECODE(PRM.FLGUSACODRUBEXT, 0, P.DESCRICAO, P.DESCRPROVDE' +
        'SC) AS DESCRICAO,'
      '       P.FLGDESCONTO,'
      '       RPL.CODTIPRECDESFAV,'
      '       P.FLGOBRIGAFAVOREC,'
      '       RPL.CODSUBCONTA'
      'FROM RUBRICAXPLANO RPL, PARAMAPREV PRM, PROVDESC P'
      'WHERE P.IDPROVENTO = RPL.IDRUBRICA'
      'ORDER BY IDPESSJUR, IDPLANOPREV, IDRUBRICA'
      ' '
      ' ')
    ValidateWithMask = True
    Left = 462
    Top = 3
  end
  object qryBenCF_N1: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDPESSJUR,'
      '       IDPLANOPREV,'
      '       IDBENEFICIO,'
      '       PLACONTAC AS PLALIQ,'
      '       NVL(PLACONTACABN,PLACONTAC) AS PLALIQ13,'
      '       NVL(PLACONTACPROVADT,PLACONTAC) AS PLALIQADT,'
      '       CODCENTROCUSTOC AS CCUSTOLIQ,'
      '       NVL(CODCENTROCUSTOCA,CODCENTROCUSTOC) AS CCUSTOLIQ13,'
      '       NVL(PLACONTADEVOL, PLACONTAD) AS PLACONTADEVOL,'
      '       PLACONTAD AS PLADESPBEN,'
      '       NVL(PLACONTADABN,PLACONTAD) AS PLADESPBEN13,'
      '       NVL(PLACONTADPROVADT,PLACONTAD) AS PLADESPBENADT,'
      '       NVL(PLACTAACJUD,PLACONTAD) AS PLACTAACJUD,'
      '       NVL(PLACTAACJUD13,PLACONTAD) AS PLACTAACJUD13,'
      '   '#9'   PLACONTACPROVIS,'
      '       PLACONTADPROVIS,'
      '       CODCCUSTOCPROVIS,'
      #9'      CODCCUSTODPROVIS,'
      '       CODCENTROCUSTOD AS CCUSTOBEN,'
      '       NVL(CODCENTROCUSTODA, CODCENTROCUSTOD) AS CCUSTOBEN13,'
      '       CODSUBCONTA,'
      '       NVL(CODSUBCONTAABN,CODSUBCONTA) AS CODSUBCONTAABN,'
      '       CODTIPRECDES,'
      '       NVL(CODTIPRECDESABN,CODTIPRECDES) AS CODTIPRECDESABN,'
      '       NVL(CODTIPRECDESADT,CODTIPRECDES) AS CODTIPRECDESADT,'
      '       CODCENTRORESPON,'
      
        '       NVL(CODCENTRORESPONA,CODCENTRORESPON) AS CODCENTRORESPONA' +
        ','
      '       UNIDNEGOC,'
      '       NVL(UNIDNEGOCABN,UNIDNEGOC) AS UNIDNEGOCABN'
      'FROM BENEFPLANPATRO'
      'ORDER BY IDPESSJUR, IDPLANOPREV, IDBENEFICIO'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 38
    Top = 139
  end
  object qryConCF_N1: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDPESSJUR,'
      '       IDPLANOPREV,'
      '       IDCONTRIBUICAO,'
      '       PLACONTAC,'
      '       NVL(PLACONTAC13,PLACONTAC) AS PLACONTAC13,'
      '       NVL(PLACONTACPROVADT,PLACONTAC) AS PLACONTACPROVADT,'
      '       CODCENTROCUSTOC,'
      
        '       NVL(CODCENTROCUSTOC13,CODCENTROCUSTOC) AS CODCENTROCUSTOC' +
        '13,'
      
        '       NVL(CODCCUSTOCPROVAD,CODCENTROCUSTOC) AS CODCCUSTOCPROVAD' +
        ','
      '       PLACONTAD,'
      '       NVL(PLACONTAD13,PLACONTAD) AS PLACONTAD13,'
      '       NVL(PLACONTADPROVADT,PLACONTAD) AS PLACONTADPROVADT,'
      '       NVL(PLACTAACJUD,PLACONTAD) AS PLACTAACJUD,'
      
        '       NVL(PLACTAACJUD13,NVL(PLACTAACJUD,PLACONTAD)) AS PLACTAAC' +
        'JUD13,'
      '   '#9'   PLACONTACPROVIS,'
      '       PLACONTADPROVIS,'
