#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = SistJurCons.exe ModFol.exe CmRHObj50.bpl CMCompoRH.bpl CMFBOBJ50.bpl \
  CMFolhaObjMT.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

SistJurCons.exe: ..\..\..\SistJurCons\Fontes\SistJurCons.dpr
  $(DCC)

ModFol.exe: ..\..\..\ModFol\Fontes\ModFol.dpr
  $(DCC)

CmRHObj50.bpl: ..\..\..\CmRHObj50\Package\CmRHObj50.dpk
  $(DCC)

CMCompoRH.bpl: ..\..\..\CmCompoRH\Package\CMCompoRH.dpk
  $(DCC)

CMFBOBJ50.bpl: ..\..\CMFbObj50\Package\CMFBOBJ50.dpk
  $(DCC)

CMFolhaObjMT.bpl: CMFolhaObjMT.dpk
  $(DCC)


