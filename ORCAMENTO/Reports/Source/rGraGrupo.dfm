  inherited CrmRptCM: TCmRptManager
    BeforePrint = CrmRptCMBeforePrint
    Report = rpGraGrupo
    LabelEmpresa = lblEmpresa
    LabelSistema = ppLabel108
  end
  object sqlGraGrupo: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  G.NOMEGRUPOORCAMEN, :SALDO'
      'FROM'
      '  SALDOORCADO S, GRUPOORCAMEN G, CONTASORCAMEN C'
      'WHERE                                                  '
      '  (S.EXERCICIO = :EXERCICIO) AND'
      '  (S.IDPESSOA = :IDPESSOA) AND'
      '  ((C.FLGATIVA = '#39'A'#39') OR (C.FLGATIVA IS NULL)) AND'
      '  (S.PERIODO BETWEEN :PERIODOINI AND :PERIODOFIM) AND'
      '  (S.IDCONTAORCAMEN = C.IDCONTAORCAMEN) AND'
      '  (S.IDPLANOORCAMEN = C.IDPLANOORCAMEN) AND'
      '  (C.IDGRUPOORCAMEN = G.IDGRUPOORCAMEN)'
      '  :IDPLANO'
      '  :IDPATRO'
      '  :CENTCUST'
      'GROUP BY'
      '  G.NOMEGRUPOORCAMEN'
      ''
      ' '
      ' '
      ' ')
    OnFormartParam = sqlGraGrupoFormartParam
    ClientDataSet = cdsGraGrupo
    Left = 8
    Top = 48
  end
