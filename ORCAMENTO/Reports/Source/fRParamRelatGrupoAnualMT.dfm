  end
  object sqlPatro: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   PA.IDPESSOA, PE.NOME'
      'FROM'
      '   PESSOA PE,'
      '   PATRO PA'
      'WHERE'
      '   (PA.IDPESSOA = PE.IDPESSOA)'
      'ORDER BY'
      '   PE.NOME')
    ClientDataSet = cdsPatro
    Left = 713
    Top = 168
