  object cdsExercicio: TCMClientDataSet
    Aggregates = <>
    Params = <>
    ProviderName = 'Dsp'
    Left = 72
    Top = 32
  end
  object sqlExercicio: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT '
      '   EXERCICIO '
      'FROM '
      '   PERIODOORCAMEN '
      'WHERE'
      '   IDPESSOA =:IDPESSOA'
      'ORDER BY '
      '   EXERCICIO')
    ClientDataSet = cdsExercicio
    Left = 24
    Top = 32
  end
  object cdsPeriodoIni: TCMClientDataSet
    Aggregates = <>
    Params = <>
    ProviderName = 'Dsp'
    Left = 224
    Top = 32
  end
  object sqlPeriodoIni: TCMSqlParams
    SQL.Strings = (
      'SELECT  '
      '   PERIODO, NOMEPERIODO,'
      '   DATAFIMPERIODO, DATAINIPERIODO'
      'FROM '
      '   PERIODOORCAMEN '
      'WHERE'
      '   (IDPESSOA =:IDPESSOA) AND '
      '   (EXERCICIO=:EXERCICIO)'
      'ORDER BY '
      '   PERIODO')
    ClientDataSet = cdsPeriodoIni
    Left = 192
    Top = 32
  end
  object cdsRelatorio: TCMClientDataSet
    Aggregates = <>
    Params = <>
    ProviderName = 'Dsp'
    Left = 144
    Top = 72
  end
  object sqlRelatorio: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   IDRELATORC, NOMERELATORC, NOMECOMPRELATORC,'
      '   SEQUENCIA, FLGIMPRIMENEG '
      'FROM '
      '   RELATORC '
      'ORDER BY '
      '  NOMERELATORC')
    ClientDataSet = cdsRelatorio
    Left = 112
    Top = 72
  end
  object cdsLayout: TCMClientDataSet
    Aggregates = <>
    Params = <>
    ProviderName = 'Dsp'
    Left = 96
    Top = 112
  end
  object sqlLayout: TCMSqlParams
    SQL.Strings = (
      'SELECT '
      '   IDDESENHOORC, IDRELATORC, NOMELAYOUT, '
      '   FLGTIPOLAYOUT, IDREPORTS, ORIGEMCM '
      'FROM '
      '   DESENHOORC '
      'WHERE '
      '   (IDRELATORC =:IDRELATORC)  '
      'ORDER BY '
      '   NOMELAYOUT')
    ClientDataSet = cdsLayout
    Left = 64
    Top = 112
  end
end
