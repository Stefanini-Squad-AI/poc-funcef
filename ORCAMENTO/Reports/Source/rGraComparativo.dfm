  object sqlGraComparativo: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      
        '   SUM(VLRORCADO) AS VLRORCADO, SUM(VLRREALIZADO) AS VLRREALIZAD' +
        'O, PERIODO        '
      'FROM                                                 '
      '   SALDOORCADO                                       '
      'WHERE                                                '
      '   (EXERCICIO = :EXERCICIO) AND'
      '   (IDPESSOA = :IDPESSOA) AND'
      '   :CONTA'
      '   (PERIODO BETWEEN :PERIODOINI AND :PERIODOFIM)'
      'GROUP BY PERIODO'
      ''
      ' ')
    OnFormartParam = sqlGraComparativoFormartParam
    ClientDataSet = cdsGraComparativo
    Left = 16
    Top = 48
  end
