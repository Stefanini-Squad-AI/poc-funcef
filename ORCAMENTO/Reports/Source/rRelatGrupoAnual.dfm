  object sqlPeriodos: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '  PERIODO, NOMEPERIODO, DATAINIPERIODO, DATAFIMPERIODO'
      'FROM'
      '  PERIODOORCAMEN'
      'WHERE'
      '  (IDPESSOA = :IDPESSOA) AND'
      '  (EXERCICIO = :EXERCICIO) AND'
      ' ( PERIODO BETWEEN :PERIODOINICAL AND :PERIODOFINAL)'
      'ORDER BY'
      '  PERIODO')
    ClientDataSet = cdsPeriodos
    Left = 40
    Top = 376
  end
