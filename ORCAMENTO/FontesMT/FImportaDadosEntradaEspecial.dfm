        Font.Style = [fsBold]
        Lines.Strings = (
          ''
          '             COLUNA           CAMPO'
          
            '             ------------'#9'    ----------------------------------' +
            '-------'
          
            '             A '#9'                      Código do grupo orçamentár' +
            'io (CODIGO)'
          '             B '#9'                      Período (NUMERICO)'
          '             C '#9'                      Plano previdenciário (ID)'
          '             D '#9'                      Patrocinadora (ID)'
          '             E '#9'                      Atividade/Projeto (CODIGO)'
          
            '             F'#9'                      Sobrescrever ('#39'S'#39' - SIM ou ' +
            #39'N'#39' - NÃO)'
          '             G '#9'                      Critério para rateio (ID)'
          
            '             H '#9'                      Valor total para rateio (N' +
            'UMERICO)'
          '             I '#9'                      Centro de custo (CODIGO)'
          '             J                         Programa (CODIGO)'
          
            '             K                         Tipo de Despesa (CODIGO) ' +
            '                  '
          
            '             L                         Fornecedores/Sub-Despesas' +
            '(ID)'
          '* Primeira Linha deverá conter o nome da coluna')
        ParentFont = False
        ReadOnly = True
        TabOrder = 0
      end
    end
