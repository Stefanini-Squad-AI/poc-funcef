  object qryConta: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   CO.IDCONTAORCAMEN,'
      '   CO.NOMECONTAORCAMEN,'
      '   CR.NOME'
      'FROM'
      '   CONTASORCAMEN CO,'
      '   CENTRESPON    CR'
      'WHERE'
      '       CO.IDPLANOORCAMEN  =:PIDPLANOORCAMEN'
      '   AND CO.IDGRUPOORCAMEN  =:PIDGRUPOORCAMEN'
      '   AND CR.CODCENTRORESPON = CO.CODCENTRORESPON'
      '   :PARAMETRO1'
      '   :PARAMETRO2'
      '   :PARAMETRO3'
      '   :PARAMETRO4'
      'ORDER BY'
      '   CO.NOMECONTAORCAMEN'
      ' '
      ' ')
    ValidateWithMask = True
    Left = 57
    Top = 197
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDPLANOORCAMEN'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PIDGRUPOORCAMEN'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'PARAMETRO1'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'PARAMETRO2'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'PARAMETRO3'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'PARAMETRO4'
        ParamType = ptInput
      end>
