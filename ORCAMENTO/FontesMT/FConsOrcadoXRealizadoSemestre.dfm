  object qryGrupo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   IDGRUPOORCAMEN,'
      '   NOMEGRUPOORCAMEN,'
      '   CODGRUPOORC'
      'FROM'
      '   GRUPOORCAMEN'
      'WHERE'
      '      :PIDGRUPOORCAMEN IS NULL'
      '   OR IDGRUPOORCAMEN   =:PIDGRUPOORCAMEN'
      'ORDER BY'
      '   CODGRUPOORC')
    ValidateWithMask = True
    Left = 57
    Top = 245
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDGRUPOORCAMEN'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PIDGRUPOORCAMEN'
        ParamType = ptInput
      end>
    object qryGrupoIDGRUPOORCAMEN: TFloatField
      FieldName = 'IDGRUPOORCAMEN'
      Origin = 'BASEDADOS.GRUPOORCAMEN.IDGRUPOORCAMEN'
    end
    object qryGrupoNOMEGRUPOORCAMEN: TStringField
      FieldName = 'NOMEGRUPOORCAMEN'
      Origin = 'BASEDADOS.GRUPOORCAMEN.NOMEGRUPOORCAMEN'
      Size = 60
    end
    object qryGrupoCODGRUPOORC: TStringField
      FieldName = 'CODGRUPOORC'
      Origin = 'BASEDADOS.GRUPOORCAMEN.CODGRUPOORC'
      FixedChar = True
      Size = 10
    end
  end
  object qrySaldo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   ROUND(SUM(NVL(VLRREALIZADO, 0)), 2) AS VLRREALIZADO,'
      '   ROUND(SUM(NVL(VLRORCADO, 0)), 2)    AS VLRORCADO'
      'FROM'
      '   SALDOORCADO'
      'WHERE'
      '       IDPESSOA       =:PIDEMPRESAPROP'
      '   AND IDPLANOORCAMEN =:PIDPLANOORCAMEN'
      '   AND IDCONTAORCAMEN =:PIDCONTAORCAMEN'
      '   AND PERIODO        =:PPERIODO'
      '   AND EXERCICIO      =:PEXERCICIO')
    ValidateWithMask = True
    Left = 57
    Top = 293
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDEMPRESAPROP'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PIDPLANOORCAMEN'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'PIDCONTAORCAMEN'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'PPERIODO'
        ParamType = ptInput
