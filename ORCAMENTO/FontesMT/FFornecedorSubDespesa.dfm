  object qryCCusto: TCMSqlParams
    SQL.Strings = (
      'select CODCENTROCUSTO, '
      
        '           trim(NOME) || decode(STATUSGRUPOCDC,'#39'S'#39','#39' *'#39','#39#39') || d' +
        'ecode(ATIVO, '#39'S'#39', '#39#39', '#39' (Inativo)'#39') as NOME'
      '           from CENTCUST '
      '           order by NOME,CODCENTROCUSTO')
    ClientDataSet = cdsCCustoSel
    Left = 512
    Top = 281
  end
