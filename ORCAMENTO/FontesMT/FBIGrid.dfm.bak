  object sqlDxGrid: TCMSqlParams
    SQL.Strings = (
      'SELECT /*+ OPTIMIZER_MODE RULE */'
      '   PE.NOME EMPRESA'
      '  ,TO_CHAR( SO.DATAREFERENCIA, '#39'MM/YYYY'#39' ) DATAREFERENCIA'
      '  ,CC.NOME CCNOME'
      '  ,UN.NOME UNNOME'
      '  ,GO.NOMEGRUPOORCAMEN'
      '  ,PP.NOME PPNOME'
      '  ,PT.NOME PRNOME'
      '  ,SUM( SO.VLRREALIZADO ) VLRREALIZADO'
      '  ,SUM( SO.VLRORCADO ) VLRORCADO'
      '  ,SUM( SO.VLRRESERVADO ) VLRRESERVADO'
      '  ,SUM( SO.VLRCOMPROMETIDO ) VLRCOMPROMETIDO'
      'FROM'
      '   SALDOORCADO SO'
      '  ,CONTASORCAMEN CO'
      '  ,CENTCUST CC'
      '  ,UNIDNEGOCIO UN'
      '  ,GRUPOORCAMEN GO'
      '  ,PLANPREVCONTABIL PP'
      '  ,( SELECT'
      '      PA.IDPESSOA,'
      '      PE.NOME'
      '    FROM'
      '      PATRO PA,'
      '      PESSOA PE'
      '    WHERE'
      '      PA.IDPESSOA = -1   AND'
      '      PE.IDPESSOA = PA.IDPESSOA ) PT'
      '  ,PESSOA PE'
      'WHERE'
      '      ( PE.IDPESSOA       = -1 )'
      '  AND ( CO.IDPESSOA       = PE.IDPESSOA (+) )'
      '  AND ( CO.IDGRUPOORCAMEN = GO.IDGRUPOORCAMEN (+) )'
      '  AND ( CO.CODCENTROCUSTO = CC.CODCENTROCUSTO (+) )'
      '  AND ( CO.IDPLANOPREV    = PP.IDPLANOPREV (+) )'
      '  AND ( CO.UNIDNEGOC      = UN.UNIDNEGOC (+) )'
      '  AND ( CO.IDPATRO        = PT.IDPESSOA (+) )'
      '  AND ( SO.IDPLANOORCAMEN  = CO.IDPLANOORCAMEN )'
      '  AND ( SO.IDCONTAORCAMEN = CO.IDCONTAORCAMEN )'
      '  AND ( SO.DATAREFERENCIA >= '#39'01/01/2002'#39' )'
      '  AND ( SO.DATAREFERENCIA <= '#39'01/10/2002'#39' )'
      'GROUP BY'
      '   PE.NOME'
      '  ,TO_CHAR( SO.DATAREFERENCIA, '#39'MM/YYYY'#39' )'
      '  ,CC.NOME'
      '  ,UN.NOME'
      '  ,GO.NOMEGRUPOORCAMEN'
      '  ,PP.NOME'
      '  ,PT.NOME')
    ClientDataSet = cdsDxGrid
    Left = 531
    Top = 136
  end
