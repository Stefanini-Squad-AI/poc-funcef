  object QryFIelds: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT ('#39'                                                 '#39') AS ' +
        'CAMPO, (0) TAMANHO, '
      
        '               ('#39'                                               ' +
        '  '#39') AS TIPODADO, '
      
        '               ('#39'                                               ' +
        '  '#39') AS MASCARA'
      'FROM DUAL')
    UpdateObject = UpdFields
    ValidateWithMask = True
    Left = 124
    Top = 100
  end
