  object QryConsultas: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT '
      '   TEMPLATE'
      'FROM '
      '  DATAVIEW'
      'WHERE '
      '  IDDATAVIEW = :PIDDATAVIEW AND'
      '  ORIGEMCMDV = :PORIGEMCMDV')
    ValidateWithMask = True
    Left = 124
    Top = 284
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PIDDATAVIEW'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'PORIGEMCMDV'
        ParamType = ptUnknown
      end>
  end
