  object sqlContaOrc: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   COR.IDCONTAORCAMEN,'
      '   COR.IDGRUPOORCAMEN,'
      '   GOR.CODGRUPOORC'
      'FROM'
      '   CONTASORCAMEN COR,'
      '   GRUPOORCAMEN  GOR'
      'WHERE'
      '       COR.IDPESSOA       =:PIDPESSOA'
      '   AND COR.IDCONTAORCAMEN =:PIDCONTAORCAMEN'
      '   AND COR.IDPLANOORCAMEN =:PIDPLANOORCAMEN'
      '   AND COR.IDGRUPOORCAMEN = GOR.IDGRUPOORCAMEN')
    ClientDataSet = cdsContaOrc
    Left = 592
    Top = 304
  end
