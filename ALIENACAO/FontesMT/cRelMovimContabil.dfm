  object sqlTipoImovel: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '    TRIM(CODTIPIMOVEL) AS CODTIPIMOVEL,'
      '    DESCTIPOIMOVEL'
      'FROM'
      '    TIPOIMOVEL'
      'WHERE'
      '    FLGTIPOINTERNO IS NOT NULL')
    ClientDataSet = cdsTipoImovel
    Left = 480
    Top = 200
  end
