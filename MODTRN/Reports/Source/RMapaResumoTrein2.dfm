  object sqlGrupo: TCMSqlParams
    SQL.Strings = (
      'SELECT DISTINCT'
      '  G.DESCGRPTREIN'
      'FROM'
      '  CARGO C, GRPTREIN G'
      'WHERE'
      '  (C.CODGRPTREIN = G.CODGRPTREIN)'
      'ORDER BY'
      '  UPPER(G.DESCGRPTREIN)'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ClientDataSet = CdsGrupo
