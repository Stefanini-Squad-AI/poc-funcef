  object CMSqlParams2: TCMSqlParams
    SQL.Strings = (
      'SELECT RXP.IDUSUARIO,     '
      '                       P.NOME AS NOME,'
      '                  RXP.IDGRPRESPON,  '
      '                  USU.NOMEUSUARIO,   '
      '                  RXP.FLGSUBSTITUTO,'
      '                 RXP.FLGAVISORAD '
      '           FROM RADRESPONXGRP RXP,  '
      '                USUARIOSISTEMA USU , PESSOA P '
      '           WHERE '
      '            (RXP.IDUSUARIO = USU.IDUSUARIO) AND'
      '            (P.IDPESSOA = USU.IDUSUARIO)'
      '           ORDER BY USU.NOMEUSUARIO  ')
    ClientDataSet = cdsDet
    Left = 585
    Top = 15
  end
  object CMSqlParams1: TCMSqlParams
    SQL.Strings = (
      'SELECT USU.IDUSUARIO, '
      '                 USU.NOMEUSUARIO,    P.NOME AS NOME'
      '          FROM USUARIOSISTEMA USU , PESSOA P'
      '          WHERE NOT EXISTS (SELECT X.IDUSUARIO '
      #9'            '#9'     FROM RADRESPONXGRP X '
      #9'                   '
      
        '                              WHERE (X.IDUSUARIO = USU.IDUSUARIO' +
        ') ) '
      'AND    (P.IDPESSOA = USU.IDUSUARIO)'
      '          ORDER BY USU.NOMEUSUARIO ')
    ClientDataSet = cdsUsuDisp
    Left = 377
    Top = 15
  end
