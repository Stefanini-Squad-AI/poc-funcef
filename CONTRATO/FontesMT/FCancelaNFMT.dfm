  object spTeste: TCMSqlParams
    SQL.Strings = (
      'SELECT    '
      '   C.NOMECONTRATO,    '
      '   PS.RAZAOSOCIAL,    '
      '   P.DATAVENCPARCELA,    '
      '   P.NUMNOTAFISCAL,    '
      '   '#39'N'#39' AS CANCELANOTA '
      'FROM    '
      '   CONTRATOCONTR C,    '
      
        '   (SELECT        IDCONTRATO,        DATAVENCPARCELA,        NUM' +
        'NOTAFISCAL     '
      '    FROM        PARCELAREALCONTR P     '
      
        #9'WHERE        (IDPESSOA = -1)        AND (NUMNOTAFISCAL = -1)   ' +
        '  '
      #9'GROUP BY IDCONTRATO,DATAVENCPARCELA,P.NUMNOTAFISCAL) P,     '
      #9'PESSOA PS '
      'WHERE    '
      '   (C.IDPESSOA = -1) AND    '
      '   (C.IDCONTRATO = P.IDCONTRATO) AND    '
      '   (C.IDFORCLI = PS.IDPESSOA) '
      'ORDER BY C.IDCONTRATO, P.DATAVENCPARCELA  ')
    ClientDataSet = cdsNotasFiscais
    Left = 328
    Top = 7
  end
end
