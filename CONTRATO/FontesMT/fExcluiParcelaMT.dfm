  object CMSqlParams1: TCMSqlParams
    SQL.Strings = (
      'SELECT 0 AS CHKBOX,'
      '       P.IDCONTRATO, P.IDPARCELA, P.IDITEM, P.IDOBJETO,'
      '       P.PLNCODIGO, P.CODDOCUMENTO,'
      '       P.DATAVENCPARCELA, P.VLRMOEDACORRENTE,'
      '       C.NOMECONTRATO, O.NOMEOBJETO, I.NOME_ITEM,'
      '       DECODE(D.COMPLDOCUMENTO, NULL, TO_CHAR(D.NODOCUMENTO),'
      
        '              TO_CHAR(D.NODOCUMENTO) || '#39'/'#39' || D.COMPLDOCUMENTO)' +
        ' AS NODOCUMENTO'
      
        '  FROM PARCELAREALCONTR P, CONTRATOCONTR C, DOCUMENTO D, OBJETOC' +
        'ONTRATUAL O, ITEMCONTRATUAL I'
      ' WHERE P.IDMEDICAO IS NULL'
      '   AND P.IDCONTRATO = C.IDCONTRATO'
      '   AND P.IDOBJETO   = O.IDOBJETO'
      '   AND P.IDITEM     = I.IDITEM'
      '   AND P.CODDOCUMENTO = D.CODDOCUMENTO')
    Left = 477
    Top = 181
  end
end
