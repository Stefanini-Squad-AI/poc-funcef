  object spTeste: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   ROWNUM AS NUMLINHA,'
      '   C.IDCONTRATO,'
      '   C.IDFORCLI,'
      '   C.NOMECONTRATO,'
      '   C.CODCONTRATOEMPR,'
      '   C.TIPOCONTRATO,'
      '   C.VALORBASECONTRATO,'
      '   C.DATAPREVENCERRA,'
      '   C.DATABASECONTRATO,'
      '   C.DATAASSINATURA,'
      '   C.DESCRICAOCONTRATO,'
      '   C.OBSERVACAO ,'
      '   C.FLGFIMCONTRATO,'
      '   C.AVISO,'
      '   OXI.*,'
      '   O.*,'
      '   I.*'
      'FROM'
      '   CONTRATOCONTR C,'
      '   OBJETOSXITEMCONTR OXI,'
      '   OBJETOCONTRATUAL O,'
      '   ITEMCONTRATUAL I'
      'WHERE'
      '   (C.IDPESSOA = 1) AND'
      '   (C.IDCONTRATO = OXI.IDCONTRATO(+)) AND'
      '   (OXI.IDOBJETO = O.IDOBJETO(+)) AND'
      '   (OXI.IDITEM = I.IDITEM(+)) AND'
      '   ((C.IDCONTRATO IN (SELECT IDCONTRATO FROM CONTRATOUSUARIO'
      '                      WHERE (IDUSUARIO = 1))) OR'
      '   NOT EXISTS(SELECT C1.IDCONTRATO'
      '              FROM CONTRATOUSUARIO C1'
      '              WHERE (C1.IDCONTRATO = C.IDCONTRATO)))'
      'ORDER BY C.NOMECONTRATO,I.IDITEM,O.IDOBJETO')
    ClientDataSet = cdsContratos
    Left = 336
    Top = 16
  end
