  object qryItem: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '   O.NOMEOBJETO,'
      '   I.NOME_ITEM,'
      '   I.IDITEM,'
      '   I.TIPOCOBRANCA,'
      '   DECODE(OXI.IDCONTRATO,NULL,0,1) AS EXTRA'
      'FROM'
      '   OBJETOCONTRATUAL O,'
      '   ITEMCONTRATUAL I,'
      '   OBJETOXITEM  OI,'
      '   OBJETOSXITEMCONTR OXI'
      'WHERE'
      '   OI.IDOBJETO = O.IDOBJETO'
      '   AND OI.IDITEM = I.IDITEM'
      '   AND OI.IDOBJETO = :IDOBJETO'
      '   AND OI.IDOBJETO = OXI.IDOBJETO(+)'
      '   AND OI.IDITEM   = OXI.IDITEM(+)'
      'ORDER BY O.NOMEOBJETO,I.NOME_ITEM'
      ' '
      ' '
      ' ')
