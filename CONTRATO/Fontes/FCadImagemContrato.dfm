  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update imagenscontrato'
      'set'
      '  IDIMAGEM = :IDIMAGEM,'
      '  IDCONTRATO = :IDCONTRATO,'
      '  PAGINA = :PAGINA,'
      '  EXTENSAO = :EXTENSAO'
      'where'
      '  IDIMAGEM = :OLD_IDIMAGEM and'
      '  IDCONTRATO = :OLD_IDCONTRATO')
    InsertSQL.Strings = (
      'insert into imagenscontrato'
      '  (IDIMAGEM, IDCONTRATO, PAGINA, EXTENSAO)'
      'values'
      '  (:IDIMAGEM, :IDCONTRATO, :PAGINA, :EXTENSAO)')
    DeleteSQL.Strings = (
      'delete from imagenscontrato'
      'where'
      '  IDIMAGEM = :OLD_IDIMAGEM and'
      '  IDCONTRATO = :OLD_IDCONTRATO')
    Left = 296
    Top = 96
  end
