  inherited qry: TwwQuery
    SQL.Strings = (
      'SELECT IDPROJETO,NOMEPROJETO,UNIDNEGOC,'
      'DESCRICAOPROJETO,IDPESSOA,DATAINICIOPROJETO,'
      'DATAFIMPROJETO'
      'FROM'
      'PROJETO'
      'WHERE'
      '(IDPROJETO = :IDPROJETO)'
      'AND (IDPESSOA = :IDPESSOA)')
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPROJETO'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
