  inherited upd: TUpdateSQL
    ModifySQL.Strings = (
      'update PROJETO'
      'set'
      '  IDPROJETO = :IDPROJETO,'
      '  NOMEPROJETO = :NOMEPROJETO,'
      '  UNIDNEGOC = :UNIDNEGOC,'
      '  DESCRICAOPROJETO = :DESCRICAOPROJETO,'
      '  IDPESSOA = :IDPESSOA,'
      '  DATAINICIOPROJETO = :DATAINICIOPROJETO,'
      '  DATAFIMPROJETO = :DATAFIMPROJETO'
      'where'
      '  IDPROJETO = :OLD_IDPROJETO')
    InsertSQL.Strings = (
      'insert into PROJETO'
      
        '  (IDPROJETO, NOMEPROJETO, UNIDNEGOC, DESCRICAOPROJETO, IDPESSOA' +
        ', DATAINICIOPROJETO, '
      '   DATAFIMPROJETO)'
      'values'
      
        '  (:IDPROJETO, :NOMEPROJETO, :UNIDNEGOC, :DESCRICAOPROJETO, :IDP' +
        'ESSOA, '
      '   :DATAINICIOPROJETO, :DATAFIMPROJETO)')
    DeleteSQL.Strings = (
      'delete from PROJETO'
      'where'
      '  IDPROJETO = :OLD_IDPROJETO')
  end
