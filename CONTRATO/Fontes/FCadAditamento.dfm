  object UpdateAditamento: TUpdateSQL
    ModifySQL.Strings = (
      'update ADITAMENTO'
      'set'
      '  IDCONTRATO = :IDCONTRATO,'
      '  IDADITAMENTO = :IDADITAMENTO,'
      '  DATAASSADITAMENTO = :DATAASSADITAMENTO,'
      '  DESCADITAMENTO = :DESCADITAMENTO,'
      '  FLGVIRTUAL = :FLGVIRTUAL,'
      '  CODADITAMENTO = :CODADITAMENTO'
      'where'
      '  IDCONTRATO = :OLD_IDCONTRATO')
    InsertSQL.Strings = (
      'insert into ADITAMENTO'
      '  (IDCONTRATO, IDADITAMENTO, DATAASSADITAMENTO, DESCADITAMENTO, '
      'FLGVIRTUAL, '
      '   CODADITAMENTO)'
      'values'
      '  (:IDCONTRATO, :IDADITAMENTO, :DATAASSADITAMENTO, '
      ':DESCADITAMENTO, :FLGVIRTUAL, '
      '   :CODADITAMENTO)')
    DeleteSQL.Strings = (
      'delete from ADITAMENTO'
      'where'
      '  IDCONTRATO = :OLD_IDCONTRATO')
    Left = 375
    Top = 4
  end
