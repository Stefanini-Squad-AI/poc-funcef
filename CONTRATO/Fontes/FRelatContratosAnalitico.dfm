  object qryRateio: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT CC.CODCENTROCUSTO, CC.NOME '
      'FROM CENTCUST CC, USCCUSTO US'
      'WHERE CC.CODCENTROCUSTO = US.CODCENTROCUSTO'
      'AND US.IDUSUARIO = :IDUSUARIO'
      'ORDER BY CC.NOME')
    ValidateWithMask = True
    Left = 225
    Top = 181
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDUSUARIO'
        ParamType = ptUnknown
      end>
    object qryRateioNOME: TStringField
      DisplayLabel = 'Centro de Custo'
      DisplayWidth = 30
      FieldName = 'NOME'
      Origin = 'BASEDADOS.CENTCUST.NOME'
      Size = 30
    end
