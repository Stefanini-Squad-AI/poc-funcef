<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Erro.master.cs" Inherits="FUNCEF.Planus.WebEmprestimo.Web.Paginas.Mestre.Erro" %>
<%@ Import Namespace="System.Reflection" %>
<%@ Import Namespace="FUNCEF.Planus.GlobalWeb.Web.Componentes.Utilidades" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta http-equiv="X-UA-Compatible" content="IE=EmulateIE7" />
    <title>
        <glw:TituloNavegador runat="server" />
    </title>
    <glw:ReferenciaScript runat="server" scriptUrl="~/Scripts/nucleo-novo.js" />
    <link rel="Stylesheet" href="~/CssDinamico/EstilosDinamicos.aspx" type="text/css" />
    <meta http-equiv="pragma" content="no-cache" />
    <meta http-equiv="expires" content="-1" />
    <base target="_self" />
    <asp:ContentPlaceHolder ID="ConteudoAdicionalHead" runat="server">
    </asp:ContentPlaceHolder>
    <script language="javascript" type="text/javascript">
    
    //Tratamento para Popups e Modais.
    if(mensagemErro != undefined) {
        if(window.dialogArguments != undefined) {
            alert(mensagemErro);
            window.close();
        }
        else {
            try {
                if(window.opener) {
                    try {
                        if(window.opener.opener) {
                            alert(mensagemErro);
                            window.close();
                        }
                    }
                    catch(e) {
                    }
                } 
            }
            catch(e) {
            }
        }
    }
    
    </script>
</head>
<body>
    <form id="form1" runat="server">
    <table cellspacing="0" cellpadding="0" class="tabelaTopo" border="0">
        <tr>
            <td width="10%" align="left" valign="top">
                &nbsp;&nbsp;<glw:ImagemConfiguravel runat="server" tagImagem="logoTopoCabecalho" />
            </td>
            <td align="left" valign="top" width="30%" style="padding-top: 15px;">
                <span style="color: rgb(82,106,142); font: Arial; font-weight: bolder; font-size: 28pt">
                    Web Empréstimo </span>
                <br />
                <span style="color: rgb(82,106,142); font: Arial; font-weight: bolder; font-size: 12pt">
                    Versão
                    <wep:VersaoAplicacao runat="server" />
                </span>
            </td>
            <td align="right" valign="middle" width="50%" style="padding-right: 20px; vertical-align: middle;">
                &nbsp;&nbsp; <span class="dadosCabecalho">
                    <%= UtilidadeSistema.codificarHTML(HttpUtility.HtmlDecode(contextoSistema.ambiente)) %>
                    -
                    <%= DateTime.Now.ToString("dd/MM/yyyy hh:mm:ss") %>
                </span>
            </td>
            <td align="right" width="10%" style="padding-top: 0;">
                <div>
                    <glw:ImagemConfiguravel runat="server" tagImagem="planusCabecalho" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                &nbsp;
            </td>
        </tr>
    </table>
    <br />
    <table cellpadding="0" cellspacing="0" align="center" class="tabelaCorpoPrincipal">
        <tr>
            <td>
                <asp:ContentPlaceHolder ID="EspacoTituloPagina" runat="server">
                </asp:ContentPlaceHolder>
            </td>
        </tr>
        <tr>
            <td>
                <table class="tabelaConteudo" cellpadding="0" cellspacing="0">
                    <tr>
                        <td style="padding: 10px 5px 10px 5px;">
                            <asp:ContentPlaceHolder ID="ConteudoFormulario" runat="server">
                            </asp:ContentPlaceHolder>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 7px 20px 5px 0px; border-top: dashed 1px rgb(215, 215, 215);
                            text-align: right;">
                            <asp:ContentPlaceHolder ID="ConteudoBotoesAcao" runat="server">
                            </asp:ContentPlaceHolder>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    </form>
</body>
</html>
