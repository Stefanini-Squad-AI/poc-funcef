<%@ Master Language="C#" MasterPageFile="~/Paginas/Mestre/Mestre.Master" AutoEventWireup="true"
    CodeBehind="FormularioMestre.master.cs" Inherits="FUNCEF.Planus.WebEmprestimo.Web.Paginas.Mestre.FormularioMestre" %>

<asp:Content ContentPlaceHolderID="ConteudoAdicionalHead" runat="server">
    <asp:ContentPlaceHolder ID="ConteudoAdicionalHeadFormulario" runat="server">
    </asp:ContentPlaceHolder>
</asp:Content>
<asp:Content ContentPlaceHolderID="ConteudoPrincipal" runat="server">
    <asp:ScriptManagerProxy ID="ScriptManagerProxy1" runat="server">
    </asp:ScriptManagerProxy>
    <table cellpadding="0" cellspacing="0" align="center" class="tabelaCorpoPrincipal">
        <tr>
            <td>
                <asp:ContentPlaceHolder ID="EspacoTituloPagina" runat="server">
                </asp:ContentPlaceHolder>
            </td>
        </tr>
        <tr>
            <td>
                <table class="tabelaConteudo" cellpadding="0" cellspacing="0">
                    <tr>
                        <td style="padding: 10px 5px 10px 5px;">
                            <asp:ContentPlaceHolder ID="ConteudoFormulario" runat="server">
                            </asp:ContentPlaceHolder>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 7px 20px 5px 0px; border-top: dashed 1px rgb(215, 215, 215);
                            text-align: right;">
                            <asp:ContentPlaceHolder ID="ConteudoBotoesAcao" runat="server">
                            </asp:ContentPlaceHolder>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    <br />
</asp:Content>
