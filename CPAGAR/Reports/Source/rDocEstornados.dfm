  inherited CrmRptCM: TCmRptManager
    BeforePrint = CrmRptCMBeforePrint
    DataBaseName = 'BaseDados'
    Report = rptDocEstorno
  end
  object SqlDocEstorno: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '       D.CODDOCUMENTO,'
      '       D.IDFORCLI, -- ID PESSOA QUE PAGARÁ/RECEBERÁ O DOCUMENTO'
      '       S.SALDO,'
      '       D.IDPESSOA,D.NODOCUMENTO, L.datalancto, D.DATAPROGRAMADA,'
      '       D.DATAVENCTO,D.RECPAG,P.RAZAOSOCIAL AS NOME,'
      '       TD.DESCRICAO AS TIPODOC'
      ''
      
        'FROM DOCUMENTO D, PESSOA P,  TIPODOCRECPAG TD, VWSALDODOC S, LAN' +
        'CTODOCUM L'
      'WHERE (1=2)')
    ClientDataSet = CdsDocEstorno
    Left = 48
    Top = 208
  end
