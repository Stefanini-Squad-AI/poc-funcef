  object CdsPortadorForma: TCMClientDataSet
    Aggregates = <>
    Params = <>
    Left = 714
    Top = 91
  end
  object sqlPortadorForma: TCMSqlParams
    SQL.Strings = (
      'SELECT PO.CODPORTFORMA,'
      '             PO.DESCRICAO'
      '  FROM PORTADORFORMA PO'
      ' WHERE PO.RECPAG = '#39'P'#39
      '   AND NVL(PO.FLGATIVO, '#39'S'#39') = '#39'S'#39
      ' ORDER BY PO.DESCRICAO')
    ClientDataSet = CdsPortadorForma
    Left = 714
    Top = 77
  end
  object sqlSelecionar: TCMSqlParams
    SQL.Strings = (
      'SELECT '#39' '#39' AS SELECIONAR, '
      '       D.NUMAPGR, '
      '       D.NODOCUMENTO, '
      '       P.RAZAOSOCIAL, '
      '       D.DATAPROGRAMADA, '
      '       (SELECT SUM(DECODE(LANC.DEBCRE, '#39'D'#39', '
      
        '                   DECODE(DOC.RECPAG, '#39'R'#39', LANC.VALOR, LANC.VALO' +
        'R * -1), '
      
        '                   DECODE(DOC.RECPAG, '#39'R'#39', LANC.VALOR * -1, LANC' +
        '.VALOR))) AS VALOR '
      '          FROM LANCTODOCUM LANC '
      
        '          JOIN DOCUMENTO DOC ON DOC.CODDOCUMENTO = LANC.CODDOCUM' +
        'ENTO '
      '         WHERE D.CODDOCUMENTO = LANC.CODDOCUMENTO) VALOR,'
      '       D.IDFORCLI,'
      '       D.CODDOCUMENTO'
      '  FROM CM.DOCUMENTO D '
      '  JOIN CM.PESSOA P ON P.IDPESSOA = D.IDFORCLI '
      ' WHERE NVL(D.EMISBLOQ, '#39'N'#39') = '#39'N'#39' '
      '   AND D.STATUS = 0 '
      '   AND D.CODGRUPOCNAB IS NULL '
      '   AND D.IDFORCLI = -1'
      '   AND D.CODPORTFORMA = -1'
      '   AND D.DATAPROGRAMADA = '#39'01/01/1899'#39
      ' ORDER BY D.NUMAPGR')
    ClientDataSet = Cds
    Left = 698
    Top = 65530
  end
