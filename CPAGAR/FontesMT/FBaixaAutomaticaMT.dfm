  object SqlSel: TCMSqlParams
    SQL.Strings = (
      
        'SELECT DISTINCT LOTEPAGTO.NUMLOTE,PF.DESCRICAO, LOTEPAGTO.DATAEM' +
        'ISSAO,'
      
        '                LOTEPAGTO.FAVORECIDO, LOTEPAGTO.NUMCHQBORDERO, L' +
        'OTEPAGTO.CODPORTFORMA, SUM(LOTEX.VALOR), LOTEPAGTO.PLNCODIGO'
      'FROM LotePagto,LOTEXDOCUM LOTEX, DOCUMENTO DOC, PortadorForma PF'
      'WHERE 1=2'
      'GROUP BY LOTEPAGTO.NUMLOTE,PF.DESCRICAO, LOTEPAGTO.DATAEMISSAO,'
      
        '                LOTEPAGTO.FAVORECIDO, LOTEPAGTO.NUMCHQBORDERO, L' +
        'OTEPAGTO.CODPORTFORMA, LOTEPAGTO.PLNCODIGO'
      'ORDER BY LOTEPAGTO.NUMLOTE')
    ClientDataSet = CdsSel
    Left = 197
    Top = 269
  end
