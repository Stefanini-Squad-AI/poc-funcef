  object sqlPortConta: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      
        '  DECODE(NVL(PC.FLGSTATUS, '#39'A'#39'), '#39'A'#39','#39#39', '#39'O Portador Conta '#39' || ' +
        'PC.DESCRICAO || '#39' está inativo'#39') AS MENSAGEM'
      'FROM'
      '  PORTADORFORMA PF, PORTADORCONTA PC'
      'WHERE'
      '  ( PF.CODPORTADOR = PC.CODPORTADOR ) AND'
      '  ( PF.CODPORTFORMA = :IDPORTAFORMA ) AND'
      '  ( PF.IDPESSOA = :IDPESSOA )')
    ClientDataSet = cdsPortconta
    Left = 581
    Top = 53
  end
