  object CmpSelLotePagto: TCmParamReport
    Caption = 'Seleção de Lotes Para Baixa Automática'
    DataBaseName = 'BaseDados'
    Params = <
      item
        Caption = 'Contas/Caixas x Forma Pagamento'
        Controle = tcLookupCombo
        TipodeDado = tdInteger
        LookupSettings.SQL.Strings = (
          'SELECT '
          '   DESCRICAO,'
          '   CODPORTFORMA, '
          '   DMAIS, '
          '   LANCAFINANC, '
          '   PLANO, '
          '   PLACONTA,  '
          '   PLACONTACONTABCHQ, '
          '   PLANOCONTABCHQ, '
          '   FLGCONTABEMISCHQ '
          'FROM '
          '   PORTADORFORMA '
          'WHERE '
          '   RECPAG = '#39'P'#39' AND '
          '   PORTADORFORMA.IDPESSOA = 1 AND'
          '   NVL(FLGENCCONTAS, '#39'N'#39') = '#39'N'#39' AND'
          '   NVL(FLGATIVO, '#39'S'#39') = '#39'S'#39
          'ORDER BY '
          '   DESCRICAO')
