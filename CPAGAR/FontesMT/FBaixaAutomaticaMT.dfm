  object SQLDocXPortForma: TCMSqlParams
    SQL.Strings = (
      'SELECT'
      '   DESCRICAO,'
      '   CODPORTFORMA,'
      '   DMAIS,'
      '   LANCAFINANC,'
      '   PLANO,'
      '   PLACONTA,'
      '   PLACONTACONTABCHQ,'
      '   PLANOCONTABCHQ,'
      '   FLGCONTABEMISCHQ'
      'FROM'
      '   PORTADORFORMA'
      'WHERE'
      '   CODPORTFORMA = :CODPORTFORMA'
      '   AND NVL(FLGATIVO, '#39'S'#39') = '#39'S'#39)
    ClientDataSet = CdsDocXPortForma
    Left = 677
    Top = 61
  end
