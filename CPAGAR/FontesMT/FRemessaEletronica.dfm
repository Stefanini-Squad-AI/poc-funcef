  object qryMovListaFavorecidos: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SessionName = 'Default'
    DataSource = dsMovRemessa
    SQL.Strings = (
      'SELECT DX.CODDOCUMENTO,'
      '       DX.IDDOCUMENTOXPESSOAS,'
      '       DX.IDFORCLI,'
      '       DX.RAZAOSOCIAL,'
      '       DX.NUMDOCUMENTO,'
      '       -- Paulo Nobre - WO33342 - Inicio'
      
        '       CAST(CM.FN_FORMATACPFCNPJ(DX.NUMDOCUMENTO) AS VARCHAR2(18' +
        ')) AS CPF_CNPJ_MASC,'
      '/*       CAST(CASE'
      '       WHEN LENGTH (TRIM(DX.NUMDOCUMENTO)) = 11 THEN'
      
        '         regexp_replace(LPAD(TRIM(DX.NUMDOCUMENTO), 11, '#39'0'#39'), '#39'(' +
        '[0-9]{3})([0-9]{3})([0-9]{3})([0-9]{2})'#39','#39'\1.\2.\3-\4'#39')'
      '       WHEN LENGTH (TRIM(DX.NUMDOCUMENTO)) = 14 THEN'
      
        '         regexp_replace(LPAD(TRIM(DX.NUMDOCUMENTO), 14, '#39'0'#39'), '#39'(' +
        '[0-9]{2})([0-9]{3})([0-9]{3})([0-9]{4})([0-9]{2})'#39','#39'\1.\2.\3/\4-' +
        '\5'#39')'
      '       WHEN DX.NUMDOCUMENTO IS NULL THEN'
      '         NULL'
      '       END AS VARCHAR2(18)) CPF_CNPJ_MASC,     */'
      '       -- Paulo Nobre - WO33342 - Fim       '
      '       DX.IDCBANCARIA,'
      '       DX.NUMBANCO,'
      '       DX.NUMAGENCIA,'
      '       NVL(DX.NUMOPERACAO, 0) NUMOPERACAO,'
      '       DX.NUMCONTA,'
      '       DX.TIPOCONTA,'
      '       DX.VALOR,'
      '       DX.FLGIMPORTADO'
      '  FROM DOCUMENTOXPESSOAS DX'
      
        ' WHERE (DX.CODDOCUMENTO IS NULL OR DX.CODDOCUMENTO =:CODDOCUMENT' +
        'O)'
      
        '   AND NOT EXISTS(SELECT 1 FROM ARQUIVOXDOCUM AD WHERE AD.ID_DOC' +
        '_CODBARRAS_PESSOAS = DX.IDDOCUMENTOXPESSOAS)'
      ' ORDER BY DX.FLGIMPORTADO, DX.RAZAOSOCIAL, DX.VALOR'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    UpdateObject = updMovListaFavorecidos
    ValidateWithMask = True
    Left = 399
    Top = 362
    ParamData = <
      item
        DataType = ftFloat
        Name = 'CODDOCUMENTO'
        ParamType = ptUnknown
      end>
