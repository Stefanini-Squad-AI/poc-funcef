  object qryAp_Agrupada: TwwQuery
    CachedUpdates = True
    AfterScroll = qryAp_AgrupadaAfterScroll
    DatabaseName = 'BaseDados'
    SessionName = 'Default'
    DataSource = dsMovRemessa
    SQL.Strings = (
      'SELECT -1 CODDOCUMENTO,'
      '       D.CODGRUPOCNAB,'
      '       D.CODFORMA,'
      '       D.IDFORCLI,'
      '       D.IDCBANCARIA,'
      '       D.NUMLEITCODBARRAS,'
      '       CAST(CASE LENGTH(D.NUMLEITCODBARRAS)'
      '         WHEN 47 THEN'
      
        '           REGEXP_REPLACE(D.NUMLEITCODBARRAS, '#39'([0-9]{5})([0-9]{' +
        '5})([0-9]{5})([0-9]{6})([0-9]{5})([0-9]{6})([0-9]{1})([0-9]{14})' +
        #39', '#39'\1.\2 \3.\4 \5.\6 \7 \8'#39')'
      '         WHEN 48 THEN'
      
        '           REGEXP_REPLACE(D.NUMLEITCODBARRAS, '#39'([0-9]{11})([0-9]' +
        '{1})([0-9]{11})([0-9]{1})([0-9]{11})([0-9]{1})([0-9]{11})([0-9]{' +
        '1})'#39', '#39'\1-\2 \3-\4 \5-\6 \7-\8'#39')'
      '         ELSE'
      '           D.NUMLEITCODBARRAS'
      '       END AS VARCHAR2(250)) COD_BARRAS_MASC,'
      '       D.CODPORTFORMA'
      'FROM DOCUMENTO D'
      'WHERE (D.CODGRUPOCNAB =:CODGRUPOCNAB)')
    UpdateObject = updAp_Agrupada
