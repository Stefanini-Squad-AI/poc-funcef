  object qryMovArqPendDet: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SessionName = 'Default'
    DataSource = dsMovArqPendente
    SQL.Strings = (
      
        'SELECT DECODE(AX.TIPO, 1, D1.NUMAPGR, 2, D2.NUMAPGR, 3, D3.NUMAP' +
        'GR, 4, D4.NUMAPGR) NUM_AP,'
      
        '       DECODE(AX.TIPO, 1, D1.NODOCUMENTO, 2, D2.NODOCUMENTO, 3, ' +
        'D3.NODOCUMENTO, 4, D4.NODOCUMENTO) NODOCUMENTO,'
      
        '       DECODE(AX.TIPO, 1, D1.DATAPROGRAMADA, 2, D2.DATAPROGRAMAD' +
        'A, 3, D3.DATAPROGRAMADA, 4, D4.DATAPROGRAMADA) DATAPROGRAMADA,'
      '       AX.VALOR,'
      
        '       CAST(CM.FN_FORMATACPFCNPJ(DECODE(AX.TIPO, 1, D1.NUMDOCUME' +
        'NTO, 2, D2.NUMDOCUMENTO, 3, D3.NUMDOCUMENTO, 4, D4.NUMDOCUMENTO)' +
        ') AS VARCHAR2(18)) AS CPF_CNPJ_MASC,'
      
        '       DECODE(AX.TIPO, 1, D1.RAZAOSOCIAL, 2, D2.RAZAOSOCIAL, 3, ' +
        'D3.RAZAOSOCIAL, 4, D4.RAZAOSOCIAL) RAZAOSOCIAL,'
      '       DECODE( '
      
        '       DECODE(AX.TIPO, '#39'1'#39', D1.FLGPERMITETITULOSPAGTO, '#39'2'#39', D2.F' +
        'LGPERMITETITULOSPAGTO, '#39'3'#39', D3.FLGPERMITETITULOSPAGTO, '#39'4'#39', D4.F' +
        'LGPERMITETITULOSPAGTO), '#39'S'#39', '#39' - '#39','
      
        '       REGEXP_REPLACE(DECODE(AX.TIPO, 1, D1.NUMBANCO, 2, D2.NUMB' +
        'ANCO, 4, D4.NUMBANCO), '#39'\D'#39')) NUM_BANCO,'
      '       DECODE( '
      
        '       DECODE(AX.TIPO, 1, D1.FLGPERMITETITULOSPAGTO, 2, D2.FLGPE' +
        'RMITETITULOSPAGTO, 3, D3.FLGPERMITETITULOSPAGTO, 4, D4.FLGPERMIT' +
        'ETITULOSPAGTO), '#39'S'#39', '#39' - '#39','
      '       CASE AX.TIPO '
      '         WHEN '#39'1'#39' THEN'
      '           CASE'
      '             WHEN INSTR(D1.MASCARAAGENCIA, '#39'-'#39') = 0 THEN '
      '               REGEXP_REPLACE(D1.NUMAGENCIA, '#39'\W'#39')'
      '             ELSE '
      
        '               SUBSTR(REGEXP_REPLACE(D1.NUMAGENCIA, '#39'\W'#39'), 0, IN' +
        'STR(TRIM(D1.MASCARAAGENCIA), '#39'-'#39')-1) ||'#39'-'#39'||'
      
        '               SUBSTR(REGEXP_REPLACE(D1.NUMAGENCIA, '#39'\W'#39'), INSTR' +
        '(TRIM(D1.MASCARAAGENCIA), '#39'-'#39'), 1)'
      '           END '
      '         WHEN '#39'2'#39' THEN'
      '           CASE D2.FLGIMPORTADO'
      '             WHEN '#39'N'#39' THEN'
      '               CASE'
      '                 WHEN INSTR(D2.MASCARAAGENCIA, '#39'-'#39') = 0 THEN'
      '                   REGEXP_REPLACE(D2.NUMAGENCIA, '#39'\W'#39') '
      '                 ELSE'
      
        '                   SUBSTR(REGEXP_REPLACE(D2.NUMAGENCIA, '#39'\W'#39'), 0' +
        ', INSTR(TRIM(D2.MASCARAAGENCIA), '#39'-'#39')-1) ||'#39'-'#39'||'
      
        '                   SUBSTR(REGEXP_REPLACE(D2.NUMAGENCIA, '#39'\W'#39'), I' +
        'NSTR(TRIM(D2.MASCARAAGENCIA), '#39'-'#39'), 1)'
      '               END'
      '             WHEN '#39'S'#39' THEN'
      '               REGEXP_REPLACE(D2.NUMAGENCIA, '#39'\s'#39')'
      '           END'
      '         WHEN '#39'4'#39' THEN'
      '          CASE'
      '            WHEN INSTR(D4.MASCARAAGENCIA, '#39'-'#39') = 0 THEN'
      '              REGEXP_REPLACE(D4.NUMAGENCIA, '#39'\W'#39')'
      '            ELSE'
      
        '              SUBSTR(REGEXP_REPLACE(D4.NUMAGENCIA, '#39'\W'#39'), 0, INS' +
        'TR(TRIM(D4.MASCARAAGENCIA), '#39'-'#39')-1) ||'#39'-'#39'|| '
      
        '              SUBSTR(REGEXP_REPLACE(D4.NUMAGENCIA, '#39'\W'#39'), INSTR(' +
        'TRIM(D4.MASCARAAGENCIA), '#39'-'#39'), 1) '
      '          END '
      '       END) NUM_AGENCIA,'
      '       DECODE( '
      
        '       DECODE(AX.TIPO, 1, D1.FLGPERMITETITULOSPAGTO, 2, D2.FLGPE' +
        'RMITETITULOSPAGTO, 3, D3.FLGPERMITETITULOSPAGTO, 4, D4.FLGPERMIT' +
        'ETITULOSPAGTO), '#39'S'#39', '#39' - '#39', '
      '       CASE AX.TIPO '
      '         WHEN '#39'1'#39' THEN'
      '           CASE '
      '             WHEN INSTR(D1.MASCARACC, '#39'-'#39') = 0 THEN '
      '               REGEXP_REPLACE(D1.CONTACORRENTE, '#39'\W'#39') '
      '             ELSE'
      
        '               SUBSTR(REGEXP_REPLACE(D1.CONTACORRENTE, '#39'\W'#39'), 0,' +
        ' INSTR(TRIM(D1.MASCARACC), '#39'-'#39')-1) ||'#39'-'#39'|| '
      
        '               SUBSTR(REGEXP_REPLACE(D1.CONTACORRENTE, '#39'\W'#39'), IN' +
        'STR(TRIM(D1.MASCARACC), '#39'-'#39'), 1) '
      '           END '
      '         WHEN '#39'2'#39' THEN'
      '           CASE D2.FLGIMPORTADO '
      '             WHEN '#39'N'#39' THEN '
      '               CASE '
      '                 WHEN INSTR(D2.MASCARACC, '#39'-'#39') = 0 THEN'
      '                   REGEXP_REPLACE(D2.CONTACORRENTE, '#39'\W'#39') '
      '                 ELSE '
      
        '                   SUBSTR(REGEXP_REPLACE(D2.CONTACORRENTE, '#39'\W'#39')' +
        ', 0, INSTR(TRIM(D2.MASCARACC), '#39'-'#39')-1) ||'#39'-'#39'|| '
      
        '                   SUBSTR(REGEXP_REPLACE(D2.CONTACORRENTE, '#39'\W'#39')' +
        ', INSTR(TRIM(D2.MASCARACC), '#39'-'#39'))'
      '               END '
      '             WHEN '#39'S'#39' THEN '
      '               REGEXP_REPLACE(D2.CONTACORRENTE, '#39'\s'#39') '
      '           END'
      '         WHEN '#39'4'#39' THEN '
      '          CASE '
      '            WHEN INSTR(D4.MASCARACC, '#39'-'#39') = 0 THEN '
      '              REGEXP_REPLACE(D4.CONTACORRENTE, '#39'\W'#39')'
      '            ELSE '
      
        '              SUBSTR(REGEXP_REPLACE(D4.CONTACORRENTE, '#39'\W'#39'), 0, ' +
        'INSTR(TRIM(D4.MASCARACC), '#39'-'#39')-1) ||'#39'-'#39'|| '
      
        '              SUBSTR(REGEXP_REPLACE(D4.CONTACORRENTE, '#39'\W'#39'), INS' +
        'TR(TRIM(D4.MASCARACC), '#39'-'#39'), 1) '
      '          END'
      '       END) NUM_CONTA, '
      '       DECODE( '
      
        '       DECODE(AX.TIPO, 1, D1.FLGPERMITETITULOSPAGTO, 2, D2.FLGPE' +
        'RMITETITULOSPAGTO, 3, D3.FLGPERMITETITULOSPAGTO, 4, D4.FLGPERMIT' +
        'ETITULOSPAGTO), '#39'N'#39', '#39' - '#39', '
      '       CAST('
      '       CASE AX.TIPO '
      '         WHEN '#39'1'#39' THEN '
      
        '           CASE LENGTH(REGEXP_REPLACE(D1.NUMLEITCODBARRAS, '#39'\D'#39')' +
        ') '
      '             WHEN 47 THEN'
      
        '               REGEXP_REPLACE(REGEXP_REPLACE(D1.NUMLEITCODBARRAS' +
        ', '#39'\D'#39'), '#39'([0-9]{5})([0-9]{5})([0-9]{5})([0-9]{6})([0-9]{5})([0-' +
        '9]{6})([0-9]{1})([0-9]{14})'#39', '#39'\1.\2 \3.\4 \5.\6 \7 \8'#39') '
      '             WHEN 48 THEN '
      
        '               REGEXP_REPLACE(REGEXP_REPLACE(D1.NUMLEITCODBARRAS' +
        ', '#39'\D'#39'), '#39'([0-9]{11})([0-9]{1})([0-9]{11})([0-9]{1})([0-9]{11})(' +
        '[0-9]{1})([0-9]{11})([0-9]{1})'#39', '#39'\1-\2 \3-\4 \5-\6 \7-\8'#39') '
      '             ELSE'
      '               REGEXP_REPLACE(D1.NUMLEITCODBARRAS, '#39'\D'#39') '
      '           END '
      '         WHEN '#39'3'#39' THEN '
      '           CASE LENGTH(REGEXP_REPLACE(D3.NUMCODBARRAS, '#39'\D'#39'))'
      '             WHEN 47 THEN '
      
        '               REGEXP_REPLACE(REGEXP_REPLACE(D3.NUMCODBARRAS, '#39'\' +
        'D'#39'), '#39'([0-9]{5})([0-9]{5})([0-9]{5})([0-9]{6})([0-9]{5})([0-9]{6' +
        '})([0-9]{1})([0-9]{14})'#39', '#39'\1.\2 \3.\4 \5.\6 \7 \8'#39') '
      '             WHEN 48 THEN '
      
        '               REGEXP_REPLACE(REGEXP_REPLACE(D3.NUMCODBARRAS, '#39'\' +
        'D'#39'), '#39'([0-9]{11})([0-9]{1})([0-9]{11})([0-9]{1})([0-9]{11})([0-9' +
        ']{1})([0-9]{11})([0-9]{1})'#39', '#39'\1-\2 \3-\4 \5-\6 \7-\8'#39')'
      '             ELSE '
      '               REGEXP_REPLACE(D3.NUMCODBARRAS, '#39'\D'#39') '
      '           END '
      '         WHEN '#39'4'#39' THEN'
      
        '          CASE LENGTH(REGEXP_REPLACE(D4.NUMLEITCODBARRAS, '#39'\D'#39'))' +
        ' '
      '            WHEN 47 THEN '
      
        '              REGEXP_REPLACE(REGEXP_REPLACE(D4.NUMLEITCODBARRAS,' +
        ' '#39'\D'#39'), '#39'([0-9]{5})([0-9]{5})([0-9]{5})([0-9]{6})([0-9]{5})([0-9' +
        ']{6})([0-9]{1})([0-9]{14})'#39', '#39'\1.\2 \3.\4 \5.\6 \7 \8'#39') '
      '            WHEN 48 THEN'
      
        '              REGEXP_REPLACE(REGEXP_REPLACE(D4.NUMLEITCODBARRAS,' +
        ' '#39'\D'#39'), '#39'([0-9]{11})([0-9]{1})([0-9]{11})([0-9]{1})([0-9]{11})([' +
        '0-9]{1})([0-9]{11})([0-9]{1})'#39', '#39'\1-\2 \3-\4 \5-\6 \7-\8'#39') '
      '            ELSE '
      '              REGEXP_REPLACE(D4.NUMLEITCODBARRAS, '#39'\D'#39') '
      '          END'
      '       END AS VARCHAR2(100))) COD_BARRAS_MASC, '
      
        '       DECODE(AX.TIPO, 1, D1.FORMA_PAGTO, 2, D2.FORMA_PAGTO, 3, ' +
        'D3.FORMA_PAGTO, 4, D4.FORMA_PAGTO) FORMA_PAGTO, '
      
        '       DECODE(DECODE(AX.TIPO, 1, D1.STATUS, 2, D2.STATUS, 3, D3.' +
        'STATUS, 4, D4.STATUS), 2, '#39'Baixado'#39', '#39'Aberto'#39') STATUS, '
      '       AX.CODFORMA,'
      '       CAST(LPAD(AP.NSA, 6, '#39'0'#39') AS VARCHAR2(6)) NSA, '
      '       AX.IDARQUIVOPAGTO, '
      '       decode(ax.tipo, 4, '#39'AP Agrupada'#39', '
      '       (SELECT DISTINCT L2.HISTORICOCOMPL HISTORICO'
      '          FROM LANCTODOCUM L2 '
      '         WHERE L2.OPERACAO = 2 '
      
        '           AND ((L2.CODDOCUMENTO = D1.CODDOCUMENTO and ax.tipo =' +
        ' 1) or '
      
        '                (L2.CODDOCUMENTO = D2.CODDOCUMENTO and ax.tipo =' +
        ' 2) or'
      
        '                (L2.CODDOCUMENTO = D3.CODDOCUMENTO and ax.tipo =' +
        ' 3))) ) HIST  '
      '       , PO.DESCRICAO CONVENIO '
      '       , AP.USUGERACAOARQTXT '
      '       , CASE WHEN ax.tipo = 4 THEN '#39'COFIN'#39
      '           ELSE (select distinct cri.nome '
      '                   from rateiodocum ri '
      
        '                   join centrespon cri on ri.codcentrorespon = c' +
        'ri.codcentrorespon '
      
        '                  where ((ri.coddocumento = d1.coddocumento and ' +
        'ax.tipo = 1) or'
      
        '                         (ri.coddocumento = d2.coddocumento and ' +
        'ax.tipo = 2) or '
      
        '                 (ri.coddocumento = d3.coddocumento and ax.tipo ' +
        '= 3))) '
      '         END AS CENT_RESPON '
      '  FROM ARQUIVOXDOCUM AX'
      
        '  JOIN ARQUIVOPAGTO AP ON AP.IDARQUIVOPAGTO = AX.IDARQUIVOPAGTO ' +
        '    '
      '  JOIN CM.PORTADORFORMA PO ON PO.CODPORTFORMA = AP.CODPORTFORMA '
      '  LEFT JOIN ( '
      
        'SELECT DI1.CODDOCUMENTO, DI1.NUMAPGR, DI1.NODOCUMENTO, DI1.DATAP' +
        'ROGRAMADA, DI1.STATUS, P.NUMDOCUMENTO, P.RAZAOSOCIAL,'
      
        '       CONTA.MASCARAAGENCIA, CONTA.MASCARACC, CONTA.NUMBANCO, CO' +
        'NTA.NUMAGENCIA, CONTA.CONTACORRENTE, '
      
        '       FO.DESCRICAO FORMA_PAGTO, NVL(FO.FLGPERMITETITULOSPAGTO, ' +
        #39'N'#39') FLGPERMITETITULOSPAGTO, DI1.NUMLEITCODBARRAS '
      '  FROM DOCUMENTO DI1 '
      '  JOIN FORMARECPAG FO ON FO.CODFORMA = DI1.CODFORMA'
      '  JOIN PESSOA P ON P.IDPESSOA = DI1.IDFORCLI '
      '  LEFT JOIN ('
      
        'SELECT C.IDCBANCARIA, B.MASCARAAGENCIA, B.MASCARACC, B.NUMBANCO,' +
        ' A.NUMAGENCIA, C.CONTACORRENTE'
      '  FROM CONTABANCARIA C'
      '  JOIN AGENCIABANCARIA A ON C.IDAGENCIA = A.IDPESSOA '
      
        '  JOIN BANCO B ON B.IDPESSOA = A.IDBANCO) CONTA ON CONTA.IDCBANC' +
        'ARIA = DI1.IDCBANCARIA'
      
        '            ) D1 ON D1.CODDOCUMENTO = AX.ID_DOC_CODBARRAS_PESSOA' +
        'S AND AX.TIPO = 1 '
      '  LEFT JOIN ('
      
        'SELECT DI2.CODDOCUMENTO, DP.IDDOCUMENTOXPESSOAS, DI2.NUMAPGR, DI' +
        '2.NODOCUMENTO, DI2.DATAPROGRAMADA, DI2.STATUS, NVL(DP.NUMDOCUMEN' +
        'TO, TRIM(PE.NUMDOCUMENTO)) AS NUMDOCUMENTO, DP.RAZAOSOCIAL,'
      
        '       MANUAL.MASCARAAGENCIA, MANUAL.MASCARACC, DP.NUMBANCO, DP.' +
        'NUMAGENCIA,      '
      
        '       CASE                                                     ' +
        '                 '
      
        '          WHEN LENGTH(DP.NUMOPERACAO) >= 3 THEN (DP.NUMOPERACAO ' +
        '|| DP.NUMCONTA)'
      
        '        '#9'ELSE DP.NUMCONTA                                       ' +
        '                '
      
        '       END CONTACORRENTE,                                       ' +
        '                 '
      
        '       FO.DESCRICAO FORMA_PAGTO, NVL(FO.FLGPERMITETITULOSPAGTO, ' +
        #39'N'#39') FLGPERMITETITULOSPAGTO, DP.FLGIMPORTADO '
      '  FROM DOCUMENTO DI2'
      '  JOIN FORMARECPAG FO ON FO.CODFORMA = DI2.CODFORMA '
      
        '  JOIN DOCUMENTOXPESSOAS DP ON DI2.CODDOCUMENTO = DP.CODDOCUMENT' +
        'O '
      '  LEFT JOIN PESSOA PE ON PE.IDPESSOA = DP.IDFORCLI '
      '  LEFT JOIN (SELECT B.MASCARACC,'
      '                    B.MASCARAAGENCIA, '
      '                    C.IDCBANCARIA '
      '               FROM CONTABANCARIA C '
      
        '               JOIN AGENCIABANCARIA A ON C.IDAGENCIA = A.IDPESSO' +
        'A'
      
        '               JOIN BANCO B ON B.IDPESSOA = A.IDBANCO) MANUAL ON' +
        ' MANUAL.IDCBANCARIA = DP.IDCBANCARIA '
      
        '            ) D2 ON D2.IDDOCUMENTOXPESSOAS = AX.ID_DOC_CODBARRAS' +
        '_PESSOAS AND AX.TIPO = 2 '
      '  LEFT JOIN ( '
      
        'SELECT DI3.CODDOCUMENTO, DC.IDDOCUMENTOXCODBARRAS, DI3.NUMAPGR, ' +
        'DI3.NODOCUMENTO, DI3.DATAPROGRAMADA, DC.DTPAGTO, DI3.STATUS,'
      
        '       NVL(DC.NUMDOCUMENTO, P3.NUMDOCUMENTO) NUMDOCUMENTO, P3.RA' +
        'ZAOSOCIAL, '
      
        '       DC.NUMCODBARRAS, FO.DESCRICAO FORMA_PAGTO, NVL(FO.FLGPERM' +
        'ITETITULOSPAGTO, '#39'N'#39') FLGPERMITETITULOSPAGTO'
      '  FROM DOCUMENTO DI3 '
      '  JOIN FORMARECPAG FO ON FO.CODFORMA = DI3.CODFORMA'
      
        '  JOIN DOCUMENTOXCODBARRAS DC ON DI3.CODDOCUMENTO = DC.CODDOCUME' +
        'NTO '
      '  JOIN PESSOA P3 ON P3.IDPESSOA = DI3.IDFORCLI '
      
        '            ) D3 ON D3.IDDOCUMENTOXCODBARRAS = AX.ID_DOC_CODBARR' +
        'AS_PESSOAS AND AX.TIPO = 3 '
      '  LEFT JOIN ('
      
        'SELECT DI4.CODGRUPOCNAB, DI4.NUMAPGR, DI4.NODOCUMENTO, DI4.DATAP' +
        'ROGRAMADA, '
      
        '       DI4.STATUS, P.NUMDOCUMENTO, P.RAZAOSOCIAL, CONTA.MASCARAA' +
        'GENCIA, '
      '       CONTA.MASCARACC, CONTA.NUMBANCO, CONTA.NUMAGENCIA, '
      '       CONTA.CONTACORRENTE, FO.DESCRICAO FORMA_PAGTO,'
      
        '       NVL(FO.FLGPERMITETITULOSPAGTO, '#39'N'#39') FLGPERMITETITULOSPAGT' +
        'O, '
      '       DI4.NUMLEITCODBARRAS '
      '  FROM DOCUMENTO DI4 '
      '  JOIN FORMARECPAG FO ON FO.CODFORMA = DI4.CODFORMA'
      '  JOIN PESSOA P ON P.IDPESSOA = DI4.IDFORCLI '
      
        '  LEFT JOIN ( SELECT C.IDCBANCARIA, B.MASCARAAGENCIA, B.MASCARAC' +
        'C, '
      '                     B.NUMBANCO, A.NUMAGENCIA, C.CONTACORRENTE '
      '                FROM CONTABANCARIA C'
      
        '                JOIN AGENCIABANCARIA A ON C.IDAGENCIA = A.IDPESS' +
        'OA '
      
        '                JOIN BANCO B ON B.IDPESSOA = A.IDBANCO ) CONTA O' +
        'N CONTA.IDCBANCARIA = DI4.IDCBANCARIA '
      
        ' GROUP BY DI4.CODGRUPOCNAB, DI4.NUMAPGR, DI4.NODOCUMENTO, DI4.DA' +
        'TAPROGRAMADA, '
      
        '          DI4.STATUS, P.NUMDOCUMENTO, P.RAZAOSOCIAL, CONTA.MASCA' +
        'RAAGENCIA,'
      '          CONTA.MASCARACC, CONTA.NUMBANCO, CONTA.NUMAGENCIA, '
      '          CONTA.CONTACORRENTE, FO.DESCRICAO, '
      
        '          NVL(FO.FLGPERMITETITULOSPAGTO, '#39'N'#39'), DI4.NUMLEITCODBAR' +
        'RAS '
      
        '             ) D4 ON D4.CODGRUPOCNAB = AX.ID_DOC_CODBARRAS_PESSO' +
        'AS AND AX.TIPO = 4'
      ' WHERE AX.IDARQUIVOPAGTO = :IDARQUIVOPAGTO '
      ' ORDER BY DATAPROGRAMADA, RAZAOSOCIAL, VALOR, FORMA_PAGTO '
      '')
    ValidateWithMask = True
    Left = 667
    Top = 519
    ParamData = <
      item
        DataType = ftFloat
        Name = 'IDARQUIVOPAGTO'
        ParamType = ptUnknown
      end>
    object qryMovArqPendDetNUM_AP: TFloatField
      Alignment = taLeftJustify
      DisplayLabel = 'Nº AP'
      DisplayWidth = 8
      FieldName = 'NUM_AP'
    end
    object qryMovArqPendDetNODOCUMENTO: TFloatField
      Alignment = taLeftJustify
      DisplayLabel = 'Nº Documento'
      DisplayWidth = 11
      FieldName = 'NODOCUMENTO'
    end
    object qryMovArqPendDetDATAPROGRAMADA: TDateTimeField
      DisplayLabel = 'Dt.Programada'
      DisplayWidth = 14
      FieldName = 'DATAPROGRAMADA'
    end
    object qryMovArqPendDetVALOR: TFloatField
      DisplayLabel = 'Valor'
