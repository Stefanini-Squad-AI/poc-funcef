  object SqlMovArqGerado: TCMSqlParams
    SQL.Strings = (
      'SELECT AP.IDARQUIVOPAGTO,'
      '       AP.CODPORTFORMA,'
      '       CAST(LPAD(AP.NSA, 6, '#39'0'#39')  AS VARCHAR2(6)) AS NSA,'
      '       AP.VLRTOTAL,'
      '       AP.TRGDTINCLUSAO DT_PREPARO,'
      
        '       DECODE(TRIM(U.NOMEUSUARIO), '#39'CM'#39', AP.TRGUSERINCLUSAO, U.N' +
        'OMEUSUARIO) USU_PREPARO,'
      '       AP.DTGERACAOARQTXT,'
      '       AP.USUGERACAOARQTXT,'
      '       AP.NOMEARQTXT,'
      '       AP.DTFINALIZAARQTXT,'
      '       AP.USUFINALIZAARQTXT,'
      '       AP.DTCANCELAARQTXT,'
      '       AP.USUCANCELAARQTXT,'
      '       P.DESCRICAO AS NOME_CONVENIO,'
      '       AP.FLGENVIADO,'
      '       P.PATHARQUIVOREM,'
      '       P.PATHARQUIVORET,'
      '       P.PATHARQUIVOSEGURANCA,'
      '       P.PATHARQUIVOBACKUP,'
      
        '       DECODE((SELECT DISTINCT DECODE(AR.TIPO, 1, D1.STATUS, 2, ' +
        'D2.STATUS, 3, D3.STATUS) STATUS'
      '                 FROM ARQUIVOXDOCUM AR'
      '                 LEFT JOIN (SELECT DI1.CODDOCUMENTO, DI1.STATUS'
      
        '                              FROM DOCUMENTO DI1) D1 ON D1.CODDO' +
        'CUMENTO = AR.ID_DOC_CODBARRAS_PESSOAS AND AR.TIPO = 1'
      
        '                 LEFT JOIN (SELECT DP.IDDOCUMENTOXPESSOAS, DI2.S' +
        'TATUS'
      '                              FROM DOCUMENTO DI2'
      
        '                              JOIN DOCUMENTOXPESSOAS DP ON DP.CO' +
        'DDOCUMENTO = DI2.CODDOCUMENTO'
      
        '                           ) D2 ON D2.IDDOCUMENTOXPESSOAS = AR.I' +
        'D_DOC_CODBARRAS_PESSOAS AND AR.TIPO = 2'
      
        '                 LEFT JOIN (SELECT DC.IDDOCUMENTOXCODBARRAS, DI3' +
        '.STATUS, DC.CODDOCUMENTO'
      '                              FROM DOCUMENTO DI3'
      
        '                              JOIN DOCUMENTOXCODBARRAS DC ON DC.' +
        'CODDOCUMENTO = DI3.CODDOCUMENTO'
      
        '                           ) D3 ON D3.IDDOCUMENTOXCODBARRAS = AR' +
        '.ID_DOC_CODBARRAS_PESSOAS AND AR.TIPO = 3'
      
