  object qryMovRetorno: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SessionName = 'Default'
    SQL.Strings = (
      'SELECT DS1.*,'
      '       CASE WHEN NVL(DS1.OCORRENCIA_RET, '#39'00'#39') IN ('#39'00'#39', '#39'BD'#39')'
      '            THEN '#39'NÃO'#39
      '            ELSE '#39'SIM'#39
      '       END TEVE_OCORRENCIA'
      'FROM (SELECT AX.IDARQUIVOPAGTO,'
      '       AP.CODPORTFORMA,'
      '       CAST(LPAD(AP.NSA, 6, '#39'0'#39')  AS VARCHAR2(6)) AS NSA,'
      
        '       DECODE(AX.TIPO, 1, D1.NUMAPGR, 2, D2.NUMAPGR, 3, D3.NUMAP' +
        'GR) NUM_AP,'
      
        '       DECODE(AX.TIPO, 1, D1.NODOCUMENTO, 2, D2.NODOCUMENTO, 3, ' +
        'D3.NODOCUMENTO) NODOCUMENTO,'
      
        '       DECODE(AX.TIPO, 1, D1.DATAPROGRAMADA, 2, D2.DATAPROGRAMAD' +
        'A, 3, D3.DTPAGTO) DATAPROGRAMADA,'
      '       AX.VALOR,'
      
        '       CAST(CASE LENGTH(TRIM(DECODE(AX.TIPO, 1, D1.NUMDOCUMENTO,' +
        ' 2, D2.NUMDOCUMENTO, 3, D3.NUMDOCUMENTO)))'
      '         WHEN 11 THEN'
      
        '           regexp_replace(LPAD(TRIM(DECODE(AX.TIPO, 1, D1.NUMDOC' +
        'UMENTO, 2, D2.NUMDOCUMENTO, 3, D3.NUMDOCUMENTO)), 11, '#39'0'#39'), '#39'([0' +
        '-9]{3})([0-9]{3})([0-9]{3})([0-9]{2})'#39','#39'\1.\2.\3-\4'#39')'
      '         WHEN 14 THEN'
      
        '           regexp_replace(LPAD(TRIM(DECODE(AX.TIPO, 1, D1.NUMDOC' +
        'UMENTO, 2, D2.NUMDOCUMENTO, 3, D3.NUMDOCUMENTO)), 14, '#39'0'#39'), '#39'([0' +
        '-9]{2})([0-9]{3})([0-9]{3})([0-9]{4})([0-9]{2})'#39','#39'\1.\2.\3/\4-\5' +
        #39')'
      '       END AS VARCHAR2(18)) AS CPF_CNPJ_MASC,'
      
        '       DECODE(AX.TIPO, 1, D1.RAZAOSOCIAL, 2, D2.RAZAOSOCIAL, 3, ' +
        'D3.RAZAOSOCIAL) RAZAOSOCIAL,'
      
        '       DECODE(AX.TIPO, 1, D1.FORMA_PAGTO, 2, D2.FORMA_PAGTO, 3, ' +
        'D3.FORMA_PAGTO) FORMA_PAGTO,'
      '       AX.DATA_EFETIVACAO,'
      '       AX.VALOR_EFETIVADO,'
      '       AX.OCORRENCIA_RET,'
      '       CAST(OC1.DESCRICAO ||'
      '       NVL2(OC2.DESCRICAO, '#39' / '#39'||OC2.DESCRICAO, '#39#39') ||'
      '       NVL2(OC3.DESCRICAO, '#39' / '#39'||OC3.DESCRICAO, '#39#39') ||'
      '       NVL2(OC4.DESCRICAO, '#39' / '#39'||OC4.DESCRICAO, '#39#39') ||'
      
        '       NVL2(OC5.DESCRICAO, '#39' / '#39'||OC5.DESCRICAO, '#39#39') AS VARCHAR2' +
        '(250)) DESC_OCORRENCIA,/*Podem registrar até 5 ocorrências*/'
      '       AX.AUTENTICACAO,'
      
        '       DECODE(DECODE(AX.TIPO, 1, D1.STATUS, 2, D2.STATUS, 3, D3.' +
        'STATUS), 2, '#39'Baixado'#39', '#39'Aberto'#39') STATUS,'
      '       PO.DESCRICAO NOME_CONVENIO'
      '  FROM ARQUIVOPAGTO AP'
      '  JOIN PORTADORFORMA PO ON PO.CODPORTFORMA = AP.CODPORTFORMA'
      '  JOIN ARQUIVOXDOCUM AX ON AP.IDARQUIVOPAGTO = AX.IDARQUIVOPAGTO'
      
        '  LEFT JOIN CODIGOSCNAB OC1 ON OC1.IDMODELOSCNAB = 62 AND OC1.CO' +
        'DIGO = SUBSTR(AX.OCORRENCIA_RET, 0, 2)'
      
        '  LEFT JOIN CODIGOSCNAB OC2 ON OC2.IDMODELOSCNAB = 62 AND OC2.CO' +
        'DIGO = SUBSTR(AX.OCORRENCIA_RET, 3, 2)'
      
        '  LEFT JOIN CODIGOSCNAB OC3 ON OC3.IDMODELOSCNAB = 62 AND OC3.CO' +
        'DIGO = SUBSTR(AX.OCORRENCIA_RET, 5, 2)'
      
        '  LEFT JOIN CODIGOSCNAB OC4 ON OC4.IDMODELOSCNAB = 62 AND OC4.CO' +
        'DIGO = SUBSTR(AX.OCORRENCIA_RET, 7, 2)'
      
        '  LEFT JOIN CODIGOSCNAB OC5 ON OC5.IDMODELOSCNAB = 62 AND OC5.CO' +
        'DIGO = SUBSTR(AX.OCORRENCIA_RET, 9, 2)/*Podem registrar até 5 oc' +
        'orrências*/'
      '  LEFT JOIN ('
      
        'SELECT DI1.CODDOCUMENTO, DI1.NUMAPGR, DI1.NODOCUMENTO, DI1.DATAP' +
        'ROGRAMADA, DI1.STATUS, P.NUMDOCUMENTO, P.RAZAOSOCIAL,'
      
        '       B.MASCARAAGENCIA, B.MASCARACC, B.NUMBANCO, A.NUMAGENCIA, ' +
        'C.CONTACORRENTE, FO.DESCRICAO FORMA_PAGTO'
      '  FROM DOCUMENTO DI1'
      '  JOIN FORMARECPAG FO ON FO.CODFORMA = DI1.CODFORMA'
      '  JOIN PESSOA P ON P.IDPESSOA = DI1.IDFORCLI'
      '  LEFT JOIN CONTABANCARIA C ON C.IDCBANCARIA = DI1.IDCBANCARIA'
      '  LEFT JOIN AGENCIABANCARIA A ON C.IDAGENCIA = A.IDPESSOA'
      '  LEFT JOIN BANCO B ON B.IDPESSOA = A.IDBANCO'
      
        '            ) D1 ON D1.CODDOCUMENTO = AX.ID_DOC_CODBARRAS_PESSOA' +
        'S AND AX.TIPO = 1'
      '  LEFT JOIN ('
      
        'SELECT DP.IDDOCUMENTOXPESSOAS, DI2.NUMAPGR, DI2.NODOCUMENTO, DI2' +
        '.DATAPROGRAMADA, DI2.STATUS, DP.NUMDOCUMENTO, DP.RAZAOSOCIAL,'
      
        '       MANUAL.MASCARAAGENCIA, MANUAL.MASCARACC, DP.NUMBANCO, DP.' +
        'NUMAGENCIA, DP.NUMOPERACAO || DP.NUMCONTA CONTACORRENTE,'
      '       FO.DESCRICAO FORMA_PAGTO, DP.FLGIMPORTADO'
      '  FROM DOCUMENTO DI2'
      '  JOIN FORMARECPAG FO ON FO.CODFORMA = DI2.CODFORMA'
      
        '  JOIN DOCUMENTOXPESSOAS DP ON DI2.CODDOCUMENTO = DP.CODDOCUMENT' +
        'O'
      '  LEFT JOIN (SELECT B.MASCARACC,'
      '                    B.MASCARAAGENCIA,'
      '                    C.IDCBANCARIA'
      '                    FROM CONTABANCARIA C'
      
        '                    JOIN AGENCIABANCARIA A ON C.IDAGENCIA = A.ID' +
        'PESSOA'
      
        '                    JOIN BANCO B ON B.IDPESSOA = A.IDBANCO) MANU' +
        'AL ON MANUAL.IDCBANCARIA = DP.IDCBANCARIA'
      
        '            ) D2 ON D2.IDDOCUMENTOXPESSOAS = AX.ID_DOC_CODBARRAS' +
        '_PESSOAS AND AX.TIPO = 2'
      '  LEFT JOIN ('
      
        'SELECT DC.IDDOCUMENTOXCODBARRAS, DI3.NUMAPGR, DI3.NODOCUMENTO, D' +
        'C.DTPAGTO, DI3.STATUS,'
      
        '       NVL(DC.NUMDOCUMENTO, P3.NUMDOCUMENTO) NUMDOCUMENTO, P3.RA' +
        'ZAOSOCIAL,'
      '       DC.NUMCODBARRAS, FO.DESCRICAO FORMA_PAGTO'
      '  FROM DOCUMENTO DI3'
      '  JOIN FORMARECPAG FO ON FO.CODFORMA = DI3.CODFORMA'
      
        '  JOIN DOCUMENTOXCODBARRAS DC ON DI3.CODDOCUMENTO = DC.CODDOCUME' +
        'NTO'
      '  JOIN PESSOA P3 ON P3.IDPESSOA = DI3.IDFORCLI'
      
        '            ) D3 ON D3.IDDOCUMENTOXCODBARRAS = AX.ID_DOC_CODBARR' +
        'AS_PESSOAS AND AX.TIPO = 3'
      'WHERE AX.IDARQUIVOPAGTO =:IDARQUIVOPAGTO) DS1'
      
        'ORDER BY TEVE_OCORRENCIA DESC, DS1.DATAPROGRAMADA, DS1.FORMA_PAG' +
        'TO, DS1.RAZAOSOCIAL'
      ''
      ''
      ''
      ''
      ''
