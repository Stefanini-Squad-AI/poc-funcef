  object updDARF: TUpdateSQL
    ModifySQL.Strings = (
      'update CM.DARF'
      'SET '
      '  IDPESSOA = :IDPESSOA, '
      '  CODNATUREZA = :CODNATUREZA, '
      '  NUMDOCUMENTO = :NUMDOCUMENTO, '
      '  DATAFINALAPURACAO = :DATAFINALAPURACAO, '
      '  DATAVENCDARF = :DATAVENCDARF, '
      '  VLRIRRF = :VLRIRRF, '
      '  VLRMULTA = :VLRMULTA, '
      '  VLRJUROS = :VLRJUROS, '
      '  VLRTOTAL = :VLRTOTAL, '
      '  FLGIMPRESSO = :FLGIMPRESSO'
      'where'
      '  IDDARF = :IDDARF'
      '  and '
      '  CODDOCUMENTO = :CODDOCUMENTO')
    InsertSQL.Strings = (
      'insert into CM.DARF'
      
        '  (IDDARF, IDPESSOA, CODDOCUMENTO, CODNATUREZA, NUMDOCUMENTO, DA' +
        'TAFINALAPURACAO, '
      
        '   DATAVENCDARF, VLRIRRF, VLRMULTA, VLRJUROS, VLRTOTAL, FLGIMPRE' +
        'SSO)'
      'values'
      
        '  (:IDDARF, :IDPESSOA, :CODDOCUMENTO, :CODNATUREZA, :NUMDOCUMENT' +
        'O, :DATAFINALAPURACAO, '
      
        '   :DATAVENCDARF, :VLRIRRF, :VLRMULTA, :VLRJUROS, :VLRTOTAL, :FL' +
        'GIMPRESSO)')
    DeleteSQL.Strings = (
      'delete from CM.DARF'
      'where'
      '  IDDARF = :OLD_IDDARF'
      '  and '
      '  CODDOCUMENTO = :OLD_CODDOCUMENTO')
