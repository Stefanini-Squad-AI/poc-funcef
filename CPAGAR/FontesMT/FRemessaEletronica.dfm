  object updINSS: TUpdateSQL
    ModifySQL.Strings = (
      'update CM.DOCINSS'
      'SET '
      '  CODIGOPGTO = :CODIGOPGTO, '
      '  COMPETENCIA = :COMPETENCIA, '
      '  FLGIMPRESSO = :FLGIMPRESSO, '
      '  DATAVENCTO = :DATAVENCTO, '
      '  VLRDESCONTO = :VLRDESCONTO, '
      '  VLRMULTA = :VLRMULTA, '
      '  VLRJUROS = :VLRJUROS, '
      '  VLRTOTAL = :VLRTOTAL, '
      '  VLRINSS = :VLRINSS, '
      '  IDBENEFINSS = :IDBENEFINSS, '
      '  VLROUTRAS_ENTIDADES = :VLROUTRAS_ENTIDADES'
      'where'
      '  CODDOCINSS = :CODDOCINSS')
    InsertSQL.Strings = (
      'insert into CM.DOCINSS'
      
        '  (CODDOCINSS, CODIGOPGTO, COMPETENCIA, FLGIMPRESSO, IDDOCINSS, ' +
        'DATAVENCTO, '
      
        '   VLRDESCONTO, VLRMULTA, VLRJUROS, VLRTOTAL, VLRINSS, IDBENEFIN' +
        'SS, VLROUTRAS_ENTIDADES)'
      'values'
      
        '  (:CODDOCINSS, :CODIGOPGTO, :COMPETENCIA, :FLGIMPRESSO, :IDDOCI' +
        'NSS, :DATAVENCTO, '
      
        '   :VLRDESCONTO, :VLRMULTA, :VLRJUROS, :VLRTOTAL, :VLRINSS, :IDB' +
        'ENEFINSS, :VLROUTRAS_ENTIDADES)')
    DeleteSQL.Strings = (
      'delete from CM.DOCINSS'
      'where'
      '  CODDOCINSS = :OLD_CODDOCINSS')
    Left = 154
    Top = 263
  end
