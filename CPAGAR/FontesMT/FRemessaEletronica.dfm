    SQL.Strings = (
      
        'SELECT PF.CODPORTFORMA, PF.DESCRICAO, PF.PATHARQUIVOREM, PF.NUME' +
        'MPRESABANCO'
      'FROM PORTADORFORMA PF'
      'WHERE PF.RECPAG = '#39'P'#39
      '      AND PF.FLGARQUIVO = '#39'S'#39
      'ORDER BY PF.DESCRICAO'
      ''
      ' '
      ' '
