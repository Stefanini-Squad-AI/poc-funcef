  object qryINSS: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SessionName = 'Default'
    DataSource = dsMovRemessa
    RequestLive = True
    SQL.Strings = (
      'SELECT D.CODDOCINSS, D.CODIGOPGTO,'
      #9'   REGEXP_REPLACE(D.COMPETENCIA, '#39'\D'#39') COMPETENCIA,'
      #9'   D.FLGIMPRESSO, D.IDDOCINSS, D.DATAVENCTO, '
      #9'   D.VLRDESCONTO, D.VLRMULTA, D.VLRJUROS, '
      #9'   D.VLRTOTAL, D.VLRINSS, '
      #9'   D.IDBENEFINSS, D.VLROUTRAS_ENTIDADES,'
      '     NVL(FR.FLGPAGTOAUTONOMO, 0) AS FLGPAGTOAUTONOMO,'
      
        '       CASE WHEN NVL(FR.FLGPAGTOAUTONOMO, 0) = 1 THEN PJ.RAZAOSO' +
        'CIAL'
      '            ELSE P.RAZAOSOCIAL'
      '        END AS RAZAOSOCIAL,'
      
        '       CASE WHEN NVL(FR.FLGPAGTOAUTONOMO, 0) = 1 THEN PJ.NUMDOCU' +
        'MENTO'
      '            ELSE P.NUMDOCUMENTO'
      '        END AS NUMDOCUMENTO'
      '  FROM CM.DOCINSS D'
      '  JOIN CM.DOCUMENTO DO ON DO.CODDOCUMENTO =  D.CODDOCINSS '
      '  LEFT JOIN CM.FORMARECPAG FR ON FR.CODFORMA = DO.CODFORMA'
      '  JOIN CM.PESSOA PJ ON PJ.IDPESSOA = DO.IDEMPRESA '
      '  LEFT JOIN CM.PESSOA P ON P.IDPESSOA = D.IDBENEFINSS'
      ' WHERE D.CODDOCINSS = :CODDOCUMENTO')
    UpdateObject = updINSS
    ValidateWithMask = True
    Left = 158
    Top = 168
    ParamData = <
      item
        DataType = ftFloat
        Name = 'CODDOCUMENTO'
        ParamType = ptInputOutput
      end>
