  object updMovListaFavorecidos: TUpdateSQL
    ModifySQL.Strings = (
      'update DOCUMENTOXPESSOAS'
      'set'
      '  CODDOCUMENTO = :CODDOCUMENTO,'
      '  IDDOCUMENTOXPESSOAS = :IDDOCUMENTOXPESSOAS,'
      '  IDFORCLI = :IDFORCLI,'
      '  RAZAOSOCIAL = :RAZAOSOCIAL,'
      '  NUMDOCUMENTO = :NUMDOCUMENTO,'
      '  IDCBANCARIA = :IDCBANCARIA,'
      '  NUMBANCO = :NUMBANCO,'
      '  NUMAGENCIA = :NUMAGENCIA,'
      '  NUMOPERACAO = :NUMOPERACAO,'
      '  NUMCONTA = :NUMCONTA,'
      '  TIPOCONTA = :TIPOCONTA,'
      '  VALOR = :VALOR,'
      '  FLGIMPORTADO = :FLGIMPORTADO'
      'where'
      '  CODDOCUMENTO = :OLD_CODDOCUMENTO and'
      '  IDDOCUMENTOXPESSOAS = :OLD_IDDOCUMENTOXPESSOAS'
      ' ')
    InsertSQL.Strings = (
      'insert into DOCUMENTOXPESSOAS'
      
        '  (CODDOCUMENTO, IDDOCUMENTOXPESSOAS, IDFORCLI, RAZAOSOCIAL, NUM' +
        'DOCUMENTO, '
      
        '   IDCBANCARIA, NUMBANCO, NUMAGENCIA, NUMOPERACAO, NUMCONTA, TIP' +
        'OCONTA, '
      '   VALOR, FLGIMPORTADO)'
      'values'
      
        '  (:CODDOCUMENTO, :IDDOCUMENTOXPESSOAS, :IDFORCLI, :RAZAOSOCIAL,' +
        ' :NUMDOCUMENTO, '
      
        '   :IDCBANCARIA, :NUMBANCO, :NUMAGENCIA, :NUMOPERACAO, :NUMCONTA' +
        ', :TIPOCONTA,'
      '   :VALOR, :FLGIMPORTADO)'
      ' '
      ' ')
    DeleteSQL.Strings = (
      'delete from DOCUMENTOXPESSOAS'
      'where'
      '  CODDOCUMENTO = :OLD_CODDOCUMENTO and'
      '  IDDOCUMENTOXPESSOAS = :OLD_IDDOCUMENTOXPESSOAS')
    Left = 399
    Top = 464
  end
  object qryContaBancaria: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT B.NUMBANCO,'
      '       A.NUMAGENCIA,'
      '       C.CONTACORRENTE NUMCONTA,'
      '       C.IDPESSOA,'
      '       C.IDCBANCARIA,'
      '       C.TIPOCONTA'
      '  FROM CONTABANCARIA C'
      '  JOIN AGENCIABANCARIA A ON C.IDAGENCIA = A.IDPESSOA'
      '  JOIN BANCO B ON B.IDPESSOA = A.IDBANCO'
      'WHERE C.IDPESSOA=:IDPESSOA'
      '      AND C.FLGCONTAPREF = 1'
      '      AND C.TIPOCONTA <> '#39'0'#39
      '      AND C.FLGCONTAINATIVA = '#39'N'#39
      ''
      ''
      ''
      ''
      ''
      '')
    ControlType.Strings = (
      'MARCADO;CheckBox;Sim;Não')
    ValidateWithMask = True
    Left = 633
    Top = 113
    ParamData = <
      item
        DataType = ftSmallint
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
    object qryContaBancariaNUMBANCO: TStringField
