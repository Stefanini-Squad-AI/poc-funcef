  object SQLMovRemessa: TCMSqlParams
    SQL.Strings = (
      'SELECT '#39'S'#39' MARCADO,'
      '       D.CODDOCUMENTO,'
      '       D.CODGRUPOCNAB,'
      '       D.IDMODULO,'
      '       D.CODFORMA,'
      '       D.CODPORTFORMA,'
      '       D.NUMAPGR NUM_AP,'
      '       D.NODOCUMENTO NUM_DOC,'
      '       P.IDPESSOA IDFORCLI,'
      '       P.NUMDOCUMENTO,'
      '       CAST(CASE'
      '          WHEN P.TIPO = '#39'F'#39' THEN'
      
        '            regexp_replace(LPAD(TRIM(P.NUMDOCUMENTO), 11, '#39'0'#39'), ' +
        #39'([0-9]{3})([0-9]{3})([0-9]{3})([0-9]{2})'#39','#39'\1.\2.\3-\4'#39')'
      '          WHEN LENGTH (TRIM(P.NUMDOCUMENTO)) = 14 THEN'
      
        '            regexp_replace(LPAD(TRIM(P.NUMDOCUMENTO), 14, '#39'0'#39'), ' +
        #39'([0-9]{2})([0-9]{3})([0-9]{3})([0-9]{4})([0-9]{2})'#39','#39'\1.\2.\3/\' +
        '4-\5'#39')'
      '          WHEN P.NUMDOCUMENTO IS NULL THEN'
      '            NULL'
      '      END AS VARCHAR2(18)) CPF_CNPJ_MASC,'
      '--      P.TIPO,'
      '      P.RAZAOSOCIAL,'
      '     (SELECT SUM(DECODE(LANC.DEBCRE, '#39'D'#39','
      
        '                DECODE(DOC.RECPAG, '#39'R'#39', LANC.VALOR, LANC.VALOR *' +
        ' -1),'
      
        '               DECODE(DOC.RECPAG, '#39'R'#39', LANC.VALOR * -1, LANC.VAL' +
        'OR))) AS VALOR'
      '      FROM LANCTODOCUM LANC'
      '      JOIN DOCUMENTO DOC ON DOC.CODDOCUMENTO = LANC.CODDOCUMENTO'
      '           WHERE D.CODDOCUMENTO = LANC.CODDOCUMENTO) VALOR,'
      '      P1.DESCRICAO AS NOME_CONVENIO,'
      '      D.DATAPROGRAMADA,'
      '      D.DATAVENCTO,'
      '      '#39#39' AS VERSAO_FOLHA,'
      '      -1 AS IDHSTFOLHABENEF,'
      '      FO.DESCRICAO FORMA_PAGTO,'
      '      FO.FLGPERMITELISTAFAVORECIDO,'
      '      FO.FLGPERMITETITULOSPAGTO,'
      '      CAST(RPAD('#39' '#39', 250, '#39' '#39') AS VARCHAR2(250)) AS MSGERRO'
      '      , NVL(FO.FLGPAGTOAUTONOMO, 0) AS FLGPAGTOAUTONOMO'
      '      , NVL(FO.TIPOFORMA, -1) AS TIPOFORMA'
      
        '      , NVL(FO.FLGPERMITELISTAFAVORECIDO, '#39'N'#39') AS FLGPERMITELIST' +
        'AFAVORECIDO'
      
        '      , NVL(FO.FLGPERMITETITULOSPAGTO, '#39'N'#39') AS FLGPERMITETITULOS' +
        'PAGTO'
      'FROM DOCUMENTO D'
      'JOIN PESSOA P ON P.IDPESSOA = D.IDFORCLI'
      
        'JOIN LANCTODOCUM L ON L.CODDOCUMENTO = D.CODDOCUMENTO AND L.OPER' +
        'ACAO = 2'
      
        'JOIN FORMARECPAG FO ON FO.CODFORMA = D.CODFORMA AND FO.RECPAG = ' +
        'D.RECPAG'
      'JOIN PORTADORFORMA P1 ON P1.CODPORTFORMA = D.CODPORTFORMA'
      'WHERE D.RECPAG = '#39'P'#39
      '  AND D.STATUS NOT IN (1, 2)'
      '  AND NOT EXISTS (SELECT 1'
      '                    FROM ARQUIVOPAGTO AP'
      
        '                    JOIN ARQUIVOXDOCUM AXD ON AXD.IDARQUIVOPAGTO' +
        ' = AP.IDARQUIVOPAGTO'
      
        '                    LEFT JOIN DOCUMENTOXPESSOAS DP ON DP.IDDOCUM' +
        'ENTOXPESSOAS = AXD.ID_DOC_CODBARRAS_PESSOAS AND AXD.TIPO = 2'
      
        '                    LEFT JOIN DOCUMENTOXCODBARRAS DC ON DC.IDDOC' +
        'UMENTOXCODBARRAS = AXD.ID_DOC_CODBARRAS_PESSOAS AND AXD.TIPO = 3'
      '                   WHERE AP.FLGENVIADO IN ('#39'N'#39', '#39'S'#39')'
      
        '                     AND DECODE(AXD.TIPO, 1, AXD.ID_DOC_CODBARRA' +
        'S_PESSOAS, 2, DP.CODDOCUMENTO, 3, DC.CODDOCUMENTO) = D.CODDOCUME' +
        'NTO)'
      '  AND D.CODPORTFORMA = -1'
      '  AND D.DATAPROGRAMADA >= TO_DATE('#39'01/03/2016'#39','#39'DD/MM/YYYY'#39')'
      '  AND D.DATAPROGRAMADA <= TO_DATE('#39'10/06/2016'#39','#39'DD/MM/YYYY'#39')'
      
        'ORDER BY D.DATAPROGRAMADA, FO.DESCRICAO, P.RAZAOSOCIAL, D.NODOCU' +
        'MENTO'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ' '
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    ClientDataSet = cdsMovRemessa
    Left = 532
    Top = 465
  end
