  object SqlMovBaixa: TCMSqlParams
    SQL.Strings = (
      'SELECT AR.IDARQUIVOPAGTO,'
      '       AR.IDARQUIVOPAGTO NUMARQUIVO,'
      '       PO.DESCRICAO AS DSC_CONVENIO,'
      
        '       DECODE(AR.TIPO, 1, D1.CODDOCUMENTO, 2, D2.CODDOCUMENTO, 3' +
        ', D3.CODDOCUMENTO) CODDOCUMENTO,'
      
        '       DECODE(AR.TIPO, 1, D1.IDFORCLI, 2, D2.IDFORCLI, 3, D3.IDF' +
        'ORCLI) IDFORCLI,'
      
        '       DECODE(AR.TIPO, 1, D1.CODTIPDOC, 2, D2.CODTIPDOC, 3, D3.C' +
        'ODTIPDOC) CODTIPDOC,'
      
        '       DECODE(AR.TIPO, 1, D1.DATAPROGRAMADA, 2, D2.DATAPROGRAMAD' +
        'A, 3, D3.DATAPROGRAMADA) DATAPROGRAMADA,'
      
        '       DECODE(AR.TIPO, 1, D1.IDMODULO, 2, D2.IDMODULO, 3, D3.IDM' +
        'ODULO) IDMODULO,'
      
        '       DECODE(AR.TIPO, 1, D1.OPERACAO, 2, D2.OPERACAO, 3, D3.OPE' +
        'RACAO) OPERACAO,'
      '       AR.VALOR,'
      
        '       DECODE(AR.TIPO, 1, D1.NUMLANCTO, 2, D2.NUMLANCTO, 3, D3.N' +
        'UMLANCTO) NUMLANCTO,'
      '       '#39'D'#39' DEBCRE,'
      
        '       DECODE(AR.TIPO, 1, D1.NODOCUMENTO, 2, D2.NODOCUMENTO, 3, ' +
        'D3.NODOCUMENTO) NODOCUMENTO,'
      
        '       DECODE(AR.TIPO, 1, D1.COMPLDOCUMENTO, 2, D2.COMPLDOCUMENT' +
        'O, 3, D3.COMPLDOCUMENTO) COMPLDOCUMENTO,'
      '       DECODE(AR.TIPO, 1, D1.NOME, 2, D2.NOME, 3, D3.NOME) NOME'
      '  FROM ARQUIVOPAGTO AP'
      '  JOIN ARQUIVOXDOCUM AR ON AR.IDARQUIVOPAGTO = AP.IDARQUIVOPAGTO'
      '  JOIN PORTADORFORMA PO ON PO.CODPORTFORMA = AP.CODPORTFORMA'
      '  LEFT JOIN ('
      
        'SELECT DI1.CODDOCUMENTO, DI1.IDFORCLI, DI1.CODTIPDOC, DI1.DATAPR' +
        'OGRAMADA, DI1.IDMODULO, DI1.OPERACAO, L.NUMLANCTO,'
      
        '       DI1.NODOCUMENTO, DI1.COMPLDOCUMENTO, NVL(P.RAZAOSOCIAL, P' +
        '.NOME) NOME, DI1.STATUS'
      '  FROM DOCUMENTO DI1'
      '  JOIN LANCTODOCUM L ON L.CODDOCUMENTO = DI1.CODDOCUMENTO'
      '  JOIN PESSOA P ON P.IDPESSOA = DI1.IDFORCLI'
      
        'WHERE L.OPERACAO = 2) D1 ON D1.CODDOCUMENTO = AR.ID_DOC_CODBARRA' +
        'S_PESSOAS AND AR.TIPO = 1'
      '  LEFT JOIN ('
      
        'SELECT DI2.CODDOCUMENTO, DP.IDDOCUMENTOXPESSOAS, NVL(DP.IDFORCLI' +
        ', DI2.IDFORCLI) IDFORCLI, DI2.CODTIPDOC, DI2.DATAPROGRAMADA,'
      
        '       DI2.IDMODULO, DI2.OPERACAO, L.NUMLANCTO, DI2.NODOCUMENTO,' +
        ' DI2.COMPLDOCUMENTO, NVL(P.RAZAOSOCIAL, P.NOME) NOME, DI2.STATUS'
      '  FROM DOCUMENTO DI2'
      
        '  JOIN DOCUMENTOXPESSOAS DP ON DP.CODDOCUMENTO = DI2.CODDOCUMENT' +
        'O'
      '  JOIN LANCTODOCUM L ON L.CODDOCUMENTO = DI2.CODDOCUMENTO'
      '  JOIN PESSOA P ON P.IDPESSOA = NVL(DP.IDFORCLI, DI2.IDFORCLI)'
      
        'WHERE L.OPERACAO = 2) D2 ON D2.IDDOCUMENTOXPESSOAS = AR.ID_DOC_C' +
        'ODBARRAS_PESSOAS AND AR.TIPO = 2'
      '  LEFT JOIN ('
      
        'SELECT DI3.CODDOCUMENTO, DC.IDDOCUMENTOXCODBARRAS, DI3.IDFORCLI,' +
        ' DI3.CODTIPDOC, DC.DTPAGTO DATAPROGRAMADA, DI3.IDMODULO,'
      
        '       DI3.OPERACAO, L.NUMLANCTO, DI3.NODOCUMENTO, DI3.COMPLDOCU' +
        'MENTO, NVL(P.RAZAOSOCIAL, P.NOME) NOME, DI3.STATUS'
      '  FROM DOCUMENTO DI3'
      
        '  JOIN DOCUMENTOXCODBARRAS DC ON DC.CODDOCUMENTO = DI3.CODDOCUME' +
        'NTO'
      '  JOIN LANCTODOCUM L ON L.CODDOCUMENTO = DI3.CODDOCUMENTO'
      '  JOIN PESSOA P ON P.IDPESSOA = DI3.IDFORCLI'
      
        'WHERE L.OPERACAO = 2) D3 ON D3.IDDOCUMENTOXCODBARRAS = AR.ID_DOC' +
        '_CODBARRAS_PESSOAS AND AR.TIPO = 3'
      
        'WHERE DECODE(AR.TIPO, 1, D1.STATUS, 2, D2.STATUS, 3, D3.STATUS) ' +
        '<> 2'
      '   AND (AR.OCORRENCIA_RET = '#39'00'#39' OR AR.OCORRENCIA_RET = '#39'BD'#39')'
      '   AND AR.IDARQUIVOPAGTO = -1'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      '')
    ClientDataSet = cdsMovBaixa
    Left = 629
    Top = 171
  end
  object qryBancoFUNCEF: TwwQuery
    DatabaseName = 'BaseDados'
    ParamCheck = False
    SQL.Strings = (
      'select TRIM(B.NUMBANCO) NUMBANCO,'
      '       CASE'
      '         WHEN INSTR(B.MASCARAAGENCIA, '#39'-'#39') = 0 THEN'
      '           TRIM(REGEXP_REPLACE(A.NUMAGENCIA, '#39'\W'#39'))'
      '         ELSE'
      
        '           SUBSTR(TRIM(REGEXP_REPLACE(A.NUMAGENCIA, '#39'\W'#39')), 0, I' +
        'NSTR(TRIM(B.MASCARAAGENCIA), '#39'-'#39')-1) ||'#39'-'#39'||'
      
        '           SUBSTR(TRIM(REGEXP_REPLACE(A.NUMAGENCIA, '#39'\W'#39')), INST' +
        'R(TRIM(B.MASCARAAGENCIA), '#39'-'#39'), 1)'
      '       END NUMAGENCIA,'
      '       CASE'
      '         WHEN INSTR(B.MASCARACC, '#39'-'#39') = 0 THEN'
      '           TRIM(REGEXP_REPLACE(PC.NOCONTACORR, '#39'\W'#39'))'
      '         ELSE'
      
        '           SUBSTR(TRIM(REGEXP_REPLACE(PC.NOCONTACORR, '#39'\W'#39')), 0,' +
        ' INSTR(TRIM(B.MASCARACC), '#39'-'#39')-1) ||'#39'-'#39'||'
      
        '           SUBSTR(TRIM(REGEXP_REPLACE(PC.NOCONTACORR, '#39'\W'#39')), IN' +
        'STR(TRIM(B.MASCARACC), '#39'-'#39'), 1)'
      '       END CONTACORRENTE,'
      '       PB.RAZAOSOCIAL NOME_BANCO,'
      '       PA.RAZAOSOCIAL NOME_AGENCIA'
      '  from cm.portadorforma pf'
      '  join cm.portadorconta pc on pc.codportador = pf.codportador'
      '  join cm.banco b on b.idpessoa = pc.idbanco'
      
        '  join cm.agenciabancaria a on a.idbanco = b.idpessoa and a.idpe' +
        'ssoa = pc.idagencia'
      '  join cm.pessoa pb on pb.idpessoa = b.idpessoa'
      '  join cm.pessoa pa on pa.idpessoa = a.idpessoa'
      ' where pf.codportforma = :codportforma')
    PictureMasks.Strings = (
      'VALORDESPESAADM'#9'###,###,#00.00'#9'T'#9'T'
      'VALORDESPESAAPAGAR'#9'###,###,#00.00'#9'T'#9'T')
    ValidateWithMask = False
    Left = 1087
    Top = 66
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codportforma'
        ParamType = ptUnknown
      end>
    object qryBancoFUNCEFNUMBANCO: TStringField
      FieldName = 'NUMBANCO'
      Origin = 'BASEDADOS.BANCO.NUMBANCO'
      Size = 10
    end
    object qryBancoFUNCEFNUMAGENCIA: TStringField
      FieldName = 'NUMAGENCIA'
      Origin = 'BASEDADOS.AGENCIABANCARIA.NUMAGENCIA'
      FixedChar = True
      Size = 15
    end
    object qryBancoFUNCEFCONTACORRENTE: TStringField
      FieldName = 'CONTACORRENTE'
      Origin = 'BASEDADOS.CONTABANCARIA.CONTACORRENTE'
