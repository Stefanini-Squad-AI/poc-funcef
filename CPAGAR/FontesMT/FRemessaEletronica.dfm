  object qryTotaisRetorno: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SessionName = 'Default'
    SQL.Strings = (
      'SELECT VLR_PREVISTO,'
      '       NVL(VLR_EFETIVADO, 0) VLR_EFETIVADO,'
      '       VLR_PREVISTO - NVL(VLR_EFETIVADO, 0) VLR_NAO_EFETIVADO'
      '  FROM ('
      'SELECT (SELECT SUM(P.VALOR) VALOR_PREVISTO'
      '          FROM ARQUIVOXDOCUM P'
      
        '            JOIN ARQUIVOPAGTO A ON A.IDARQUIVOPAGTO = P.IDARQUIV' +
        'OPAGTO'
      '         WHERE A.IDARQUIVOPAGTO = :IDARQUIVOPAGTO) VLR_PREVISTO,'
      '       (SELECT SUM(NVL(EFET.VALOR_EFETIVADO, 0)) VALOR_EFET'
      '          FROM ARQUIVOXDOCUM EFET'
      
        '          JOIN ARQUIVOPAGTO AP ON AP.IDARQUIVOPAGTO = EFET.IDARQ' +
        'UIVOPAGTO'
      '         WHERE AP.IDARQUIVOPAGTO = :IDARQUIVOPAGTO '
      
        '           AND NVL(EFET.OCORRENCIA_RET, '#39'00'#39') IN ('#39'00'#39')) VLR_EFE' +
        'TIVADO'
      '  FROM DUAL)'
      ''
      ''
      '')
    ValidateWithMask = True
    Left = 955
    Top = 168
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDARQUIVOPAGTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDARQUIVOPAGTO'
        ParamType = ptUnknown
      end>
    object qryTotaisRetornoVLR_PREVISTO: TFloatField
      FieldName = 'VLR_PREVISTO'
      DisplayFormat = '###,###,##0.00'
    end
    object qryTotaisRetornoVLR_EFETIVADO: TFloatField
      FieldName = 'VLR_EFETIVADO'
      DisplayFormat = '###,###,##0.00'
    end
    object qryTotaisRetornoVLR_NAO_EFETIVADO: TFloatField
      FieldName = 'VLR_NAO_EFETIVADO'
      DisplayFormat = '###,###,##0.00'
    end
  end
