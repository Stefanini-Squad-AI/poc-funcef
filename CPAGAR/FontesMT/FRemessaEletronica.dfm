  object qryMovTitulos: TwwQuery
    CachedUpdates = True
    DatabaseName = 'BaseDados'
    SessionName = 'Default'
    DataSource = dsMovRemessa
    SQL.Strings = (
      'SELECT DXB.CODDOCUMENTO,'
      '       DXB.IDDOCUMENTOXCODBARRAS,'
      '       DXB.NUMCODBARRAS,'
      '       CAST(CASE LENGTH(DXB.NUMCODBARRAS)'
      '         WHEN 47 THEN'
      
        '           REGEXP_REPLACE(DXB.NUMCODBARRAS, '#39'([0-9]{5})([0-9]{5}' +
        ')([0-9]{5})([0-9]{6})([0-9]{5})([0-9]{6})([0-9]{1})([0-9]{14})'#39',' +
        ' '#39'\1.\2 \3.\4 \5.\6 \7 \8'#39')'
      '         WHEN 48 THEN'
      
        '           REGEXP_REPLACE(DXB.NUMCODBARRAS, '#39'([0-9]{11})([0-9]{1' +
        '})([0-9]{11})([0-9]{1})([0-9]{11})([0-9]{1})([0-9]{11})([0-9]{1}' +
        ')'#39', '#39'\1-\2 \3-\4 \5-\6 \7-\8'#39')'
      '         ELSE'
      '           DXB.NUMCODBARRAS'
      '       END AS VARCHAR2(250)) COD_BARRAS_MASC,'
      '       DXB.VLRPAGTO,'
      '       DXB.DTPAGTO,'
      '       DXB.FLGTIPOCODBARRAS,'
      
        '       DECODE(DXB.FLGTIPOCODBARRAS, '#39'F'#39', '#39'Ficha de Compensação'#39',' +
        ' '#39'A'#39', '#39'Arrecadação'#39') TIPOCODBARRA,'
      '       DXB.NUMDOCUMENTO,'
      '       -- Paulo Nobre - WO33342 - Inicio'
      
        '       CAST(CM.FN_FORMATACPFCNPJ(DXB.NUMDOCUMENTO) AS VARCHAR2(1' +
        '8)) AS CPF_CNPJ_MASC,'
      '/*       CAST(CASE'
      '          WHEN LENGTH (TRIM(DXB.NUMDOCUMENTO)) = 11 THEN'
      
        '            regexp_replace(LPAD(TRIM(DXB.NUMDOCUMENTO), 11, '#39'0'#39')' +
        ', '#39'([0-9]{3})([0-9]{3})([0-9]{3})([0-9]{2})'#39','#39'\1.\2.\3-\4'#39')'
      '          WHEN LENGTH (TRIM(DXB.NUMDOCUMENTO)) = 14 THEN'
      
        '            regexp_replace(LPAD(TRIM(DXB.NUMDOCUMENTO), 14, '#39'0'#39')' +
        ', '#39'([0-9]{2})([0-9]{3})([0-9]{3})([0-9]{4})([0-9]{2})'#39','#39'\1.\2.\3' +
        '/\4-\5'#39')'
      '          WHEN DXB.NUMDOCUMENTO IS NULL THEN'
      '            NULL'
      '       END AS VARCHAR2(18)) CPF_CNPJ_MASC,    */'
      '       -- Paulo Nobre - WO33342 - Fim'
      '       DXB.FLGIMPORTADO'
      '  FROM DOCUMENTOXCODBARRAS DXB'
      'WHERE DXB.CODDOCUMENTO = :CODDOCUMENTO'
      'ORDER BY DXB.DTPAGTO, TIPOCODBARRA, DXB.VLRPAGTO'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    UpdateObject = updMovTitulos
    ValidateWithMask = True
    Left = 256
    Top = 386
