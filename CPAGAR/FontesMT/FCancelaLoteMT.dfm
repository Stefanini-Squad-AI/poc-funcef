    SQL.Strings = (
      'SELECT'
      '  LOTEPAGTO.NUMLOTE, LOTEPAGTO.CODLANCFINANC,'
      '  LOTEPAGTO.IDUSUARIOINCLUSAO,LOTEPAGTO.DATAEMISSAO,'
      '  LOTEPAGTO.NUMCHQBORDERO,LOTEPAGTO.FAVORECIDO,'
      
