  object qryDoUsuario: TwwQuery
    DatabaseName = 'BaseDados'
    RequestLive = True
    SQL.Strings = (
      'SELECT R.TEMPLATE'
      'FROM   REPORTS R'
      'WHERE  R.IDREPORTS = :IDREPORTS'
      'AND    R.ORIGEMCM  = :ORIGEMCM')
    ValidateWithMask = True
    Left = 352
    Top = 32
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDREPORTS'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'ORIGEMCM'
        ParamType = ptUnknown
      end>
