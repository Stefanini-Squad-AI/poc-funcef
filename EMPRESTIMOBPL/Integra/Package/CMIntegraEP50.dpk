package CMIntegraEP50;

{$R *.RES}
{$R CMINTEGRAEP50_RES.RES}

{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  CMRegra50MT,
  CMRegra50,
  CmCompo50,
  CmBack50,
  CMTotalPrev50,
  CMCapCarObj50;

contains
  DDividaEP in '..\Source\DDividaEP.pas' {dtmDividaEP: TDataModule},
  dEmptmo in '..\Source\dEmptmo.pas' {dtmEmptmo: TDataModule},
  DIntegraEmptmo in '..\Source\DIntegraEmptmo.pas' {dtmIntegraEmptmo: TDataModule},
  DLookEmptmo in '..\Source\DLookEmptmo.pas' {dtmLookEmptmo: TDataModule},
  dMS in '..\Source\dMS.pas' {dtmMS: TDataModule},
  dCalcEmptmo in '..\Source\dCalcEmptmo.pas' {dtmCalcEmptmo: TDataModule},
  UTypesEmptmo in '..\Source\UTypesEmptmo.pas',
  UFuncoesEmptmo in '..\Source\UFuncoesEmptmo.pas',
  UIntegraReceb in '..\Source\UIntegraReceb.pas',
  UCalcEmptmo in '..\Source\UCalcEmptmo.pas',
  FEsperaEP in '..\Source\FEsperaEP.pas' {frmEsperaEP},
  uIntegraEP in '..\Source\uIntegraEP.pas',
  UIntegraEmptmo in '..\Source\UIntegraEmptmo.pas',
  dAtualizacaoDiaria in '..\Source\dAtualizacaoDiaria.pas' {dtmAtualizacaoDiaria: TDataModule},
  DRelatoriosUsu in '..\Source\DRelatoriosUsu.pas' {dtmRelatoriosUsu},
  uCtrlMetodosEmptmo in '..\Source\uCtrlMetodosEmptmo.pas';

end.
