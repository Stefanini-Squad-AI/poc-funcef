  object qryPlano: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDPLANOPREV, NOME'
      'FROM PLANPREV'
      
        'WHERE  IDPLANOPREV IN (SELECT PLP.IDPLANOPREV FROM PLANPREVPATRO' +
        ' PLP, PATRO PT'
