  object qryPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT PESSOA.IDPESSOA,    PESSOA.NOME,'
      '       PATRO.FLGANO13'
      'FROM PESSOA,PATRO'
      'WHERE PESSOA.IDPESSOA=PATRO.IDPESSOA'
      'AND   PATRO.IDFUNDACAO =:IDFUNDACAO'
      'ORDER BY NOME'
      ' ')
    ValidateWithMask = True
    Left = 228
    Top = 407
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDFUNDACAO'
        ParamType = ptUnknown
      end>
  end
  object qryFilialOrig: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  PE.NOME, PE.IDPESSOA'
      'FROM'
      '  PESSOA PE, FILIALPESSOA FP'
      'WHERE'
      '  (PE.IDPESSOA = FP.IDFILIALPESSOA) AND'
      '  (PE.IDGRUPO  = :IDPESSOA)'
      ''
      ' ')
    ValidateWithMask = True
    Left = 31
    Top = 407
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
  end
  object qrySitFunc: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDSITFUNC, DESCRICAO, TIPOSIT'
      'FROM SITFUNC'
      ' ')
    ValidateWithMask = True
    Left = 105
    Top = 407
  end
  object qryContrato: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  IDDOCUMENTO,'
      '  NOMEDOCUMENTO'
      'FROM TIPODOCPESSOA'
      'WHERE (FISICAJURIDICA = '#39'J'#39')')
    ValidateWithMask = True
    Left = 6
    Top = 407
  end
  object qryFilialDest: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      ' PE.NOME,'
      ' PE.IDPESSOA'
      'FROM'
      ' PESSOA PE,'
      ' FILIALPESSOA FP'
      'WHERE (PE.IDPESSOA = FP.IDFILIALPESSOA)'
      '  AND (PE.IDGRUPO  = :IDPESSOA)'
      '')
    ValidateWithMask = True
    Left = 203
    Top = 407
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
  end
  object qryPart: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '  PV.IDPESSJUR,'
      '  PV.IDPESSOA,'
      '  PV.IDPLANOPREV,'
      '  PV.IDSITPART,'
      '  PV.SEQPROPOSTA,'
      '  PV.IDSITPLANOPREV,'
      '  PV.REQUERIMENTODATA,'
      '  PV.INSCRICAONUMERO,'
      '  PV.INSCRICAODATA,'
      '  PV.INSCRICAOTIPO,'
      '  PV.SALINSCRICAO,'
      '  PV.DATAINICIOASSIST,'
      '  PV.SALPARTICIPACAO,'
      '  PV.SALMANTIDO,'
      '  PV.SALVINCULADO,'
      '  PV.VALORCALCINSS,'
      '  PV.DATACANCELAMENTO,'
      '  PV.DATAINICIOMANUT,'
      '  PV.DATAFIMASSIST,'
      '  PV.FLGDEVEEMPRESTIMO,'
      '  PV.FLGDEVEASSISTENC,'
      '  PV.FLGDEVEPREVIDENC,'
      '  PV.VALORINFINSS,'
      '  PV.DATAINICIOSITTEMP,'
      '  PV.DATAFIMSITTEMP,'
      '  PV.SALAUXDOENCA,'
      '  PV.FLGSALVIRTBENEF,'
      '  PV.FLGDESATIVADO,'
      '  PV.DTINICIOINSC,'
      '  PV.TEMPOAFASTADO,'
