  object qryHistRubSal: TwwQuery
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'SELECT SUM(VALORPROVENTO) AS RENDA'
      '  FROM HISTRUBSAL'
      ' WHERE IDPESSOA = :IDPESSOA'
      '   AND IDRUBRICA = :IDRUBRICA'
      '   AND MES = (SELECT MAX(MES) '
