  object qryColsExcel: TwwQuery
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'SELECT LPAD('#39' '#39', 50, '#39' '#39') AS NOMECOMPLETO,'
      '       LPAD('#39' '#39', 30, '#39' '#39') AS NOMEREDUZIDO,'
      '       LPAD('#39' '#39', 12, '#39' '#39') AS CPF,'
      '       LPAD('#39' '#39', 12, '#39' '#39') AS PIS,'
      '       LPAD('#39' '#39', 12, '#39' '#39') AS CARTEIRATRABALHO,'
      '       LPAD('#39' '#39', 13, '#39' '#39') AS DATANASC,'
      '       LPAD('#39' '#39', 30, '#39' '#39') AS CIDADENASCIMENTO,'
      '       LPAD('#39' '#39', 10, '#39' '#39') AS UFNASCIMENTO,'
      '       LPAD('#39' '#39', 10, '#39' '#39') AS DESCESTCIVIL,'
      '       LPAD('#39' '#39', 30, '#39' '#39') AS NOMECONJUGE,'
      '       LPAD('#39' '#39', 40, '#39' '#39') AS NOMEPAI,'
      '       LPAD('#39' '#39', 40, '#39' '#39') AS NOMEMAE,'
      '       LPAD('#39' '#39', 12, '#39' '#39') AS SEXO,'
      '       LPAD('#39' '#39', 15, '#39' '#39') AS RG,'
      '       LPAD('#39' '#39', 15, '#39' '#39') AS ORGAO,'
      '       LPAD('#39' '#39', 8, '#39' '#39') AS ESTADOEMISSAO,'
      '       LPAD('#39' '#39', 15, '#39' '#39') AS DATAEMISSAO,'
      '       LPAD('#39' '#39', 25, '#39' '#39') AS CARGO,'
      '       LPAD('#39' '#39', 15, '#39' '#39') AS DATAADMISSAO,'
      '       LPAD('#39' '#39', 60, '#39' '#39') AS ENDERECO,'
      '       LPAD('#39' '#39', 30, '#39' '#39') AS BAIRRO,'
      '       LPAD('#39' '#39', 30, '#39' '#39') AS CIDADE,'
      '       LPAD('#39' '#39', 5, '#39' '#39') AS UF,  '
      '       LPAD('#39' '#39', 10, '#39' '#39') AS CEP,  '
      '       LPAD('#39' '#39', 5, '#39' '#39') AS DDD,  '
      '       LPAD('#39' '#39', 15, '#39' '#39') AS TELEFONE,'
      '       LPAD('#39' '#39', 60, '#39' '#39') AS EMAIL,'
      '       LPAD('#39' '#39', 11, '#39' '#39') AS DESCGRINSTR,'
      '       LPAD('#39' '#39', 20, '#39' '#39') AS RENDAVALOR,'
      '       LPAD('#39' '#39', 10, '#39' '#39') AS BANCO,'
      '       LPAD('#39' '#39', 10, '#39' '#39') AS AGENCIA,'
      '       LPAD('#39' '#39', 14, '#39' '#39') AS CONTA,'
      '       LPAD('#39' '#39', 10, '#39' '#39') AS DV'
      '  FROM DUAL'
      ' WHERE 1 = 2')
    ValidateWithMask = True
    Left = 384
    Top = 256
