  object qryDados: TwwQuery
    CachedUpdates = True
    AfterPost = qryDadosAfterPost
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      'SELECT 0 AS SEL,'
      '       PF.IDPESSOA,'
      '       LPAD('#39' '#39', 15, '#39' '#39') AS MATRICULA,'
      '       0 AS NUMSEQUENCIA,'
      '       P.NUMDOCUMENTO AS CPF,'
      '       P.NOME AS NOMECOMPLETO,'
      '       LPAD('#39' '#39', 33, '#39' '#39') AS NOMEREDUZIDO,'
      '       LPAD('#39' '#39', 30, '#39' '#39') AS PIS,'
      '       LPAD('#39' '#39', 30, '#39' '#39') AS CARTEIRATRABALHO,'
      '       PF.DATANASC,'
      '       LPAD('#39' '#39', 50, '#39' '#39') AS CIDADENASCIMENTO,'
      '       LPAD('#39' '#39', 2, '#39' '#39') AS UFNASCIMENTO,'
      '       DECODE(PF.ESTCIVIL, '#39'S'#39', '#39'1'#39', '
      '                           '#39'C'#39', '#39'3'#39', '
      '                           '#39'D'#39', '#39'5'#39', '
      '                           '#39'E'#39', '#39'5'#39', '
      '                           '#39'J'#39', '#39'6'#39', '
      '                           '#39'V'#39', '#39'7'#39', '
      '                           '#39'P'#39', '#39'6'#39') ESTCIVIL,'
      '       '
      '       LPAD('#39' '#39', 40, '#39' '#39') AS DESCESTCIVIL,'
      '       LPAD('#39' '#39', 60, '#39' '#39') AS NOMECONJUGE,'
      '       PF.NOMEPAI,'
      '       PF.NOMEMAE,'
      '       DECODE(PF.SEXO,'#39'F'#39','#39'1'#39','
      '                      '#39'M'#39','#39'2'#39') AS SEXO,'
      '       LPAD('#39' '#39', 30, '#39' '#39') AS RG,'
      '       LPAD('#39' '#39', 30, '#39' '#39') AS ORGAO,'
      '       LPAD('#39' '#39', 2, '#39' '#39') AS ESTADOEMISSAO,'
      '       LPAD('#39' '#39', 15, '#39' '#39') AS DATAEMISSAO,'
      '       LPAD('#39' '#39', 40, '#39' '#39') AS CARGO,'
      '       LPAD('#39' '#39', 20, '#39' '#39') AS DATAADMISSAO,'
      '       0 AS IDCARGOEXT,'
      '       LPAD('#39' '#39', 100, '#39' '#39') AS ENDERECO,'
      '       LPAD('#39' '#39', 100, '#39' '#39') AS BAIRRO,'
      '       LPAD('#39' '#39', 50, '#39' '#39') AS CIDADE,'
      '       LPAD('#39' '#39', 2, '#39' '#39') AS UF,  '
      '       LPAD('#39' '#39', 15, '#39' '#39') AS CEP,  '
      '       LPAD('#39' '#39', 3, '#39' '#39') AS DDD,  '
      '       LPAD('#39' '#39', 15, '#39' '#39') AS TELEFONE,'
      '       P.EMAIL,'
      '       PF.IDGRINSTR,'
      '       LPAD('#39' '#39', 30, '#39' '#39') AS DESCGRINSTR,'
      '       0 AS RENDAVALOR,'
      '       LPAD('#39' '#39', 3, '#39' '#39') AS BANCO,'
      '       LPAD('#39' '#39', 4, '#39' '#39') AS AGENCIA,'
      '       LPAD('#39' '#39', 11, '#39' '#39') AS CONTA,'
      '       LPAD('#39' '#39', 2, '#39' '#39') AS DV,'
      '       LPAD('#39' '#39', 118, '#39' '#39') AS MOTIVORECUSA'
      '   FROM PESSOAFISICA PF, PESSOA P'
      ' WHERE (PF.FLGSOLICITACONTASALARIO = :FLGSOLICITACONTASALARIO) '
      '   AND (PF.DTSOLICITACONTASALARIO IS NULL)'
      '   AND (PF.IDPESSOA = P.IDPESSOA)'
      'ORDER BY IDPESSOA')
    UpdateObject = updDados
    ControlType.Strings = (
      'SEL;CheckBox;1;0')
    ValidateWithMask = True
    Left = 368
    Top = 184
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'FLGSOLICITACONTASALARIO'
        ParamType = ptUnknown
      end>
