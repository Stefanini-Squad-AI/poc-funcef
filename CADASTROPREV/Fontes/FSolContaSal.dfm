  object qryValContaSal: TwwQuery
    DatabaseName = 'BASEDADOS'
    SQL.Strings = (
      ''
      'SELECT * FROM '
      '(SELECT C.*, SUBSTR(CONTACORRENTE, 1, 3) CONTA'
      '          FROM CONTABANCARIA C'
      '               WHERE IDPESSOA =:IDPESSOA)'
      'WHERE CONTA = '#39'037'#39)
    ValidateWithMask = True
    Left = 472
    Top = 344
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
  end
