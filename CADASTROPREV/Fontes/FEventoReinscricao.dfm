  object qryEvento: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT EP.FLGEFETIVADO, EG.IDEVENTOGERADOR, EP.DATAEVENTO,'
      '       EP.IDSITPARTNOVO, EP.IDSITPLANONOVO, EP.IDSITFUNCNOVO,'
      '       SPART.FLGINTERNO, ELP.DATAADMISSAO,'
      '       SPART.DESCRICAO  AS NOMESITPART,'
      '       SPLANO.DESCRICAO AS NOMESITPLANO,'
      '       SFUNC.DESCRICAO  AS NOMESITFUNC,'
      '       SPARTANT.DESCRICAO  AS NOMESITPARTANT,'
      '       SPLANOANT.DESCRICAO AS NOMESITPLANOANT,'
      '       SFUNCANT.DESCRICAO  AS NOMESITFUNCANT'
      'FROM   EVENTOGERADOR EG, EVENTOSPREV EP, SITPART SPART,'
      '       SITPLANOPREV SPLANO, SITFUNC SFUNC,'
      '       SITPART SPARTANT, ELEGPATRO ELP,'
      '       SITPLANOPREV SPLANOANT, SITFUNC SFUNCANT'
      'WHERE (EG.FLGINTERNO      = :FLGINTERNO)'
      'AND   (EG.IDEVENTOGERADOR = EP.IDEVENTOGERADOR)'
      'AND   (EP.SEQPROPOSTA     = :SEQPROPOSTA)'
      'AND   (EP.IDPESSJUR       = :IDPESSJUR)'
      'AND   (EP.IDPLANOPREV     = :IDPLANOPREV)'
      'AND   (EP.IDPESSOA        = :IDPESSOA)'
      'AND   (ELP.IDPESSJUR      = EP.IDPESSJUR)'
      'AND   (ELP.IDPESSOA       = EP.IDPESSOA)'
      'AND   (EP.IDSITFUNCNOVO   = SFUNC.IDSITFUNC)'
      'AND   (EP.IDSITPARTNOVO   = SPART.IDSITPART)'
      'AND   (EP.IDSITPLANONOVO  = SPLANO.IDSITPLANOPREV)'
      'AND   (EP.IDSITFUNCATUAL  = SFUNCANT.IDSITFUNC)'
      'AND   (EP.IDSITPARTATUAL  = SPARTANT.IDSITPART)'
      'AND   (EP.IDSITPLANOATUAL = SPLANOANT.IDSITPLANOPREV)'
      ' ')
    ValidateWithMask = True
    Left = 372
    Top = 65520
    ParamData = <
      item
        DataType = ftString
        Name = 'FLGINTERNO'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'SEQPROPOSTA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
  end
  object qryPatro: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT P.IDPESSOA, P.NOME, PA.IDREGRAMATRICULA'
      'FROM  PESSOA P, PATRO PA, PLANPREVPATRO PL'
      'WHERE P.IDPESSOA     = PA.IDPESSOA'
      'AND   P.IDPESSOA     = PL.IDPESSJUR'
      'AND   PL.IDPLANOPREV = :IDPLANOPREV'
      'ORDER BY P.NOME'
      '')
    ValidateWithMask = True
    Left = 186
    Top = 428
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end>
  end
  object qryHstContribPrev: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT HST.NUMRECEBIMENTO,HST.MESREFERENCIA,HST.MESCOBRANCA,HST.' +
        'IDMOTIVO,'
      
        '       HST.IDPESSJUR,HST.IDPESSOA,HST.IDPLANOPREV,HST.IDCONTRIBU' +
        'ICAO,HST.SEQPROPOSTA,'
      
        '       HST.CODPORTFORMA,HST.DATAFINAL,HST.DATAINICIO,HST.DATAPRE' +
        'VISAORECE,'
      
        '       HST.DATARECEBIMENTO,HST.FLGCALCRESERVA,HST.FLGDESCFOLHA,H' +
        'ST.FLGSITFUNDACAO,'
      
        '       HST.IDLOTE,HST.IDREGRACALCULO,HST.PARCELA,HST.SITRECEBIME' +
        'NTO,HST.TIPO,'
      
        '       HST.VALORCALCULADO,HST.VALORESPERADO,HST.VALOROP1,HST.VAL' +
        'OROP2,HST.VALOROP3,'
      '       HST.FLGEVENTO,  HST.VALORRECEBIDO, HST.FLGINTEVENTO,'
      '       C.NOME, HST.FOLHAORIGEM'
      'FROM   HSTCONTRIBPREV HST, CONTRIBUICAO C'
      'WHERE  HST.MESCOBRANCA   >  :MESCOBRANCA'
      'AND    HST.IDPESSOA      = :IDPESSOA'
      'AND    HST.IDPESSJUR     = :IDPESSJUR'
      'AND    HST.IDPLANOPREV   = :IDPLANOPREV'
      'AND    HST.SEQPROPOSTA   = :SEQPROPOSTA'
      'AND    HST.IDCONTRIBUICAO = C.IDCONTRIBUICAO'
      'ORDER BY HST.MESREFERENCIA, HST.IDCONTRIBUICAO'
      ''
      ' '
      ' ')
    ValidateWithMask = True
    Left = 568
    Top = 30
    ParamData = <
      item
        DataType = ftString
        Name = 'MESCOBRANCA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'SEQPROPOSTA'
        ParamType = ptUnknown
      end>
  end
  object qryMostraContribuicao: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT EL.NIVEL, EL.IDCARGOEXT, PF.DATANASC, PF.SEXO, EL.DATAADM' +
        'ISSAO, PP.INSCRICAODATA,'
      
        '       EL.TEMPOSERVANTERIOR, PP.SALPARTICIPACAO, EL.VALORBASE1, ' +
        'EL.VALORBASE2, EL.VALORBASE3, '
      
        '       CP.IDCONTRIBUICAO, CB.NOME, CP.QTDEPARCELAS, CT.NUMOPCOES' +
        ', TP.NOME AS PERIODICIDADE,'
      '       CT.NOMEVALORBASE1, CT.NOMEVALORBASE2, CT.NOMEVALORBASE3'
      
        'FROM PESSOAFISICA PF, ELEGPATRO EL, PARTPREVPLAN PP, CONTRIBPREV' +
        'PARTP CP, '
      '     TPPERIODICIDADE TP, CONTPREV CT, CONTRIBUICAO CB'
      'WHERE EL.IDPESSOA          = :IDPESSOA'
      '  AND EL.IDPESSJUR         = :IDPESSJUR'
      '  AND PF.IDPESSOA          = EL.IDPESSOA'
      '  AND PP.IDPESSOA          = EL.IDPESSOA'
      '  AND PP.IDPESSJUR         = EL.IDPESSJUR'
      '  AND PP.IDPLANOPREV       = :IDPLANOPREV'
      '  AND CP.IDPESSOA          = EL.IDPESSOA'
      '  AND CP.IDPESSJUR         = EL.IDPESSJUR'
      '  AND CP.IDPLANOPREV       = PP.IDPLANOPREV'
      '  AND CP.SEQPROPOSTA       = PP.SEQPROPOSTA'
      '  AND CP.IDCONTRIBUICAO    = CP.IDCONTRIBUICAO'
      '  AND CP.IDCONTRIBUICAO    = CB.IDCONTRIBUICAO'
      '  AND CP.FLGCOBRA          = 1'
      '  AND CT.IDCONTRIBUICAO    = CP.IDCONTRIBUICAO'
      '  AND CT.IDPLANOPREV       = PP.IDPLANOPREV'
      '  AND CP.IDTPPERIODICIDADE = TP.IDTPPERIODICIDADE'
      ' '
      ' ')
    ValidateWithMask = True
    Left = 392
    Top = 30
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end>
  end
