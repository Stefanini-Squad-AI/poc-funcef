  object QryPlano: TQuery
    AfterScroll = QryPlanoAfterScroll
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      
        'SELECT PPP.IDPESSJUR, PPP.IDPLANOPREV, PR.NOME, PPP.IDSITPLANOPR' +
        'EV,'
      'ppp.inscricaodata'
      ' '
      ' FROM PARTPREVPLAN PPP, PLANPREV PR'
      ' WHERE PPP.IDPESSOA = :IDPESSOA'
      '   AND PPP.IDPLANOPREV = PR.IDPLANOPREV'
      '   AND PPP.IDPLANOPREV IN (66,74)'
      '   AND PPP.IDSITPLANOPREV =  1'
      '  AND ROWNUM = 1')
    Left = 336
    Top = 96
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end>
  end
  object dsPlano: TDataSource
    DataSet = QryPlano
    Left = 352
    Top = 8
  end
  object qryContribuicao: TQuery
    AfterScroll = qryContribuicaoAfterScroll
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT CTP.ROWID,C.IDCONTRIBUICAO, C.NOME, CTP.VALORBASE1,'
      '  CTP.IDPESSJUR'
      '  FROM CONTRIBPREVPARTP CTP, CONTRIBUICAO C'
      ' WHERE CTP.IDPESSJUR   =:IDPESSJUR'
      '   AND CTP.IDPESSOA    =:IDPESSOA'
      '   AND C.IDCONTRIBUICAO IN (1,21)'
      '   AND CTP.IDPLANOPREV =:IDPLANOPREV'
      '   AND CTP.IDCONTRIBUICAO = C.IDCONTRIBUICAO'
      ' ')
    Left = 336
    Top = 152
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'IDPESSJUR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IDPLANOPREV'
        ParamType = ptUnknown
      end>
  end
  object dsContribuicao: TDataSource
    DataSet = qryContribuicao
    Left = 432
    Top = 88
  end
