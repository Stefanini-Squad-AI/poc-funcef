  object qryLookBeneficio: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT   DISTINCT'
      '   B.IDBENEFICIO, B.IDEVENTOGERADOR, B.CODNATUREZA,'
      '   B.IDTPPAGTOBENEFIC, B.NOME,'
      '   B.FLGDESTBENEF, B.FLGBENEFOBRIGATO,'
      '   B.CODBENEFICIO, B.NUMORDEMEVENTO,'
      '   B.FLGRESGATE, B.FLGBENEFTEMP, B.FLGBENEFPROV,'
      '   B.FLGPECULIO, B.CODBENEFSPC'
      'FROM'
      '   BENEFICIO B, PLANPREVPATRO P, BENEFPLANPREV BP'
      'WHERE'
      '   ( NOT B.TIPOBENEFICIO = 99 )    AND'
      '   ( B.IDBENEFICIO = BP.IDBENEFICIO ) AND'
      '   ( P.IDPLANOPREV = BP.IDPLANOPREV ) AND'
      '   ( B.IDBENEFICIO IN (SELECT  BP.IDBENEFICIO'
      
        '                          FROM    BENEFPLANPREV BP, PLANPREVPATR' +
        'O PLP, PATRO P'
      '                          WHERE   P.IDFUNDACAO  = :IDFUNDACAO'
      '                          AND     PLP.IDPESSJUR = P.IDPESSOA'
      
        '                          AND     BP.IDPLANOPREV = PLP.IDPLANOPR' +
        'EV'
      '                          ) )'
      'ORDER BY  NOME'
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 144
    Top = 137
    ParamData = <
      item
        DataType = ftInteger
        Name = 'IDFUNDACAO'
        ParamType = ptUnknown
      end>
