  object qrySQL: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT  DISTINCT(B.IDPESSOA), B.IDPESSJUR, B.IDTITULAR,'
      '        P.NOME, P.NUMDOCUMENTO AS CPF, E.MATRICULA,'
      '        EP.LOGRADOURO, EP.NUMERO, EP.COMPLEMENTO,'
      '        EP.BAIRRO, EP.CEP, EP.CIDADE, EP.CODESTADO,'
      '        EP.IDPAIS,  PF.DATANASC,'
      '        TO_CHAR(PF.DATANASC, '#39'DD/MM'#39') AS ANIVERSARIO,'
      '        DECODE(ND.NUMDEPEND,NULL,0,ND.NUMDEPEND) AS NUMDEPEND,'
      
        '        TRIM(TO_CHAR(TO_NUMBER(SUBSTR(E.MATRICULA,1,(INSTR(E.MAT' +
        'RICULA,'#39'-'#39',1)-1))),'#39'0009999999'#39'))||'
      #9'TRIM(TO_CHAR(ND.NUMDEPEND,'#39'009'#39'))||'
      
        '        TRIM(TO_CHAR(PF.DATANASC,'#39'DDMMYYYY'#39'))||:COMPLEMENTO AS C' +
        'ODIGO_DE_BARRAS,'
      '        '#39'  '#39' AS CONTATO'
      'FROM BENEFBFCIARIO B, PESSOA P, ELEGPATRO E, PESSOAFISICA PF,'
      '    (SELECT  P.IDPESSOA, E.LOGRADOURO, E.NUMERO,'
      '             E.COMPLEMENTO, E.CEP, E.BAIRRO,'
      
        '             C.NOME CIDADE, ES.NOMEESTADO ESTADO, PA.NOMEPAIS PA' +
        'IS,'
      '             PA.IDPAIS, ES.IDESTADO, ES.CODESTADO'
      '     FROM  PESSOA P, ENDPESS E, CIDADES C, ESTADO ES, PAIS PA'
      '     WHERE (P.IDPESSOA = E.IDPESSOA)'
      '       AND ((P.IDENDCORRESP IS NOT NULL)     OR'
      '            (P.IDENDCOMERCIAL IS NOT NULL)   OR'
      '            (P.IDENDENTREGA IS NOT NULL)     OR'
      '            (P.IDENDRESIDENCIAL IS NOT NULL) OR'
      '            (P.IDENDCOBRANCA IS NOT NULL))'
      '       AND  (E.IDCIDADES = C.IDCIDADES)'
      '       AND  (C.IDESTADO = ES.IDESTADO)'
      '       AND  (PA.IDPAIS = ES.IDPAIS)) EP,'
      '    (SELECT IDTITULAR, COUNT(*) AS NUMDEPEND'
      '     FROM DEPENTIT'
      '     WHERE IDTITULAR <> IDPESSOA'
      '     GROUP BY IDTITULAR ) ND'
      'WHERE (P.IDPESSOA  = B.IDPESSOA)'
      '  AND (B.IDSITBENEFICIO = 1 )'
      '  AND (B.IDTITULAR = E.IDPESSOA)'
      '  AND (P.IDPESSOA  = PF.IDPESSOA)'
      '  AND (P.IDPESSOA  = EP.IDPESSOA)'
      '  AND (B.IDPESSJUR = 4 )'
      '  AND (B.IDTITULAR = ND.IDTITULAR(+))'
      ''
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 496
    Top = 184
    ParamData = <
      item
        DataType = ftString
        Name = 'COMPLEMENTO'
        ParamType = ptUnknown
      end>
