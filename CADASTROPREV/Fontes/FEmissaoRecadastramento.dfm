    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT DISTINCT(B.IDPESSOA), B.IDPESSJUR, B.IDTITULAR,'
      
        '       P.NOME, P.RAZAOSOCIAL AS NOMEFANTASIA, P.NUMDOCUMENTO AS ' +
        'CPF,      '
      
        '       E.MATRICULA,  EP.LOGRADOURO, EP.NUMERO, EP.COMPLEMENTO,  ' +
        '    '
      
        '       EP.BAIRRO, EP.CEP, EP.CIDADE, EP.IDPAIS, EP.IDESTADO, EP.' +
        'CODESTADO, '
      
        '       PF.DATANASC, TO_CHAR(PF.DATANASC, '#39'DD/MM'#39') AS ANIVERSARIO' +
        ', B.IDBENEFICIO, EP.IDENDERECO,      '
      '       BN.NOME AS BENEFICIO,  ND.NUMDEPEND, '#39'  '#39' AS CONTATO    '
      'FROM   BENEFBFCIARIO B, '
      '       PESSOA P, '
      '       ELEGPATRO E, '
      '       PESSOAFISICA PF, '
      '       BENEFICIO BN,      '
      
        '       ( SELECT P.IDPESSOA, E.LOGRADOURO, E.NUMERO, E.COMPLEMENT' +
        'O, E.CEP, E.IDENDERECO,        '
      
        '                E.BAIRRO, C.NOME CIDADE, ES.NOMEESTADO ESTADO, P' +
        'A.NOMEPAIS PAIS, ES.IDESTADO, ES.CODESTADO,        '
      
        #9#9'PA.IDPAIS FROM PESSOA P, ENDPESS E, CIDADES C, ESTADO ES, PAIS' +
        ' PA        '
      #9' WHERE (P.IDPESSOA = E.IDPESSOA) AND'#9'       '
      #9'       (E.IDCIDADES = C.IDCIDADES) AND '
      #9'       (C.IDESTADO = ES.IDESTADO) AND        '
      #9'       (PA.IDPAIS = ES.IDPAIS) ) EP,      '
      '       ( SELECT IDTITULAR, COUNT(*) AS NUMDEPEND        '
      '         FROM DEPENTIT                                  '
      #9' WHERE IDTITULAR <> IDPESSOA                    '
      #9' GROUP BY IDTITULAR ) ND'
      ' WHERE '
      '     ( B.IDPESSJUR = 1111760 ) '
      ' AND '
      
        '     ( B.IDSITBENEFICIO = 1 ) AND      ( B.IDPESSOA = EP.IDPESSO' +
        'A ) AND      ( B.IDPESSOA = PF.IDPESSOA ) AND      ( B.IDPESSOA ' +
        '= P.IDPESSOA ) AND      ( B.IDTITULAR = E.IDPESSOA ) AND      ( ' +
        'B.IDPESSJUR = E.IDPESSJUR ) AND      ( B.IDBENEFICIO = BN.IDBENE' +
        'FICIO ) AND      ( NOT BN.TIPOBENEFICIO = 99 )'
      ' AND (P.IDENDRESIDENCIAL = EP.IDENDERECO) '
      ' ORDER BY P.NOME'
      ''
      ''
      ' '
      ' '
      ' ')
    ValidateWithMask = True
    Left = 312
    Top = 92
