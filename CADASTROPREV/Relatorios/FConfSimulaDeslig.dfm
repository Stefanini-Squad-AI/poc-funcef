  object qryExtSimDeslig: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT'
      '       137.59 AS AUTOPAT_VALOR_CONTRIB_ATUAL_1, '
      
        '       '#39'CD - BÁSICA DOS BENEFS PROGS - ATIVO'#39' AS AUTOPAT_NOME_CO' +
        'NTRIB_ATUAL_1, '
      '       137.59 AS AUTOPAT_VALOR_CONTRIB_ATUAL_2, '
      
        '       '#39'CD - NORMAL DE ADMINISTRAÇÃO'#39' AS AUTOPAT_NOME_CONTRIB_AT' +
        'UAL_3, '
      '       42.79 AS AUTOPAT_VALOR_CONTRIB_ATUAL_3, '
      
        '       '#39'CD - NORMAL DE BENEFÍCIOS PROG '#39' AS AUTOPAT_NOME_CONTRIB' +
        '_ATUAL_2, '
      '       2500 AS AUTOPAT_SALMANUT, '
      '       '#39' '#39' AS DIFERIMENTO_QTD_COTAS_1, '
      '       1.5 AS DIFERIMENTO_VLR_COTA_1, '
      '       '#39' '#39' AS DIFERIMENTO_SALDO_1, '
      
        '       '#39'REVERSÃO DAS PARCELAS DA CPI - DIFERIMENTO'#39' AS DIFERIMEN' +
        'TO_NOME_RESERVA_1, '
      '       '#39'10114'#39' AS DIFERIMENTO_CODHIERARQUIA_1, '
      '       1691.38 AS RESGATE_116, '
      '       84054.58 AS RESGATE_91, '
      '       50000 AS PORTABILIDADE_222, '
      '       '#39'SERGIO AZAMBUJA DE BEM'#39' AS NOMEPARTICIPANTE, '
