  object qryModulo: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT IDMODULO, NOMEMODULO, DESCRICAOMODULO'
      'FROM   MODULO'
      'ORDER BY NOMEMODULO')
    ValidateWithMask = True
    Left = 714
    Top = 48
  end
  object qryOperacoes: TwwQuery
    DatabaseName = 'BaseDados'
    SQL.Strings = (
      'SELECT U.NOMEUSUARIO, M.NOMEMODULO, L.DATA, L.DESCOPERACAO'
      'FROM   LOGTOTALPREV L, USUARIOSISTEMA U, MODULO M'
      'WHERE  L.IDMODULO = M.IDMODULO'
      'AND    L.IDUSUARIO = U.IDUSUARIO'
      'AND   L.IDLOGTOTALPREV = -1')
    ValidateWithMask = True
    Left = 714
    Top = 105
  end
  object dsOperacoes: TwwDataSource
    AutoEdit = False
    DataSet = qryOperacoes
    Left = 714
    Top = 225
  end
