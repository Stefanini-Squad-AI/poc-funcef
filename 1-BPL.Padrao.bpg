#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = CMResource50.bpl CmSql50.bpl CMAdd50.bpl CMCompo50.bpl CMOld50.bpl \
  CmParser50.bpl CMBussines50.bpl CMCrypto.bpl CMForms50.bpl CMRad50.bpl \
  CMPrincipal50.bpl CMExperts.bpl CmRelatsOld50.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------


CMResource50.bpl: CM\CMResource50\Package\CMResource50.dpk
  $(DCC)

CmSql50.bpl: CM\CmSql\Package\CmSql50.dpk
  $(DCC)

CMAdd50.bpl: CM\ComponentesXT\CMAdd50\Package\CMAdd50.dpk
  $(DCC)

CMCompo50.bpl: CM\componentescm\package\CMCompo50.dpk
  $(DCC)

CMOld50.bpl: CM\ComponentesCMOld\Package\CMOld50.dpk
  $(DCC)

CmParser50.bpl: CM\Parser\Package\CmParser50.dpk
  $(DCC)

CMBussines50.bpl: CM\CmBussines\Package\CMBussines50.dpk
  $(DCC)

CMExperts.bpl: CM\CMExperts\Package\CMExperts.dpk
  $(DCC)

CMCrypto.bpl: CMCRYPTO\CMCrypto.dpk
  $(DCC)

CMPrincipal50.bpl: CM\Forms\Package\CMPrincipal50.dpk
  $(DCC)

CMForms50.bpl: CM\Forms\Package\CMForms50.dpk
  $(DCC)

CMRad50.bpl: CM\CMRad50\Package\CMRad50.dpk
  $(DCC)

CmRelatsOld50.bpl: CM\Relats\Package\CmRelatsOld50.dpk
  $(DCC)


